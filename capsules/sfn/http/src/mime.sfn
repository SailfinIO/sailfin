// sfn/http — filename-extension → media-type table.
//
// Static assets are the one place the server cannot infer a `Content-Type`
// from the call site: `html_response` knows what it is holding, but a file
// read off disk is just bytes plus a name. This maps the name's extension
// onto a media type so `static_file` can label what it serves.
//
// Two properties are deliberate.
//
// **The fallback is `application/octet-stream`, never a guess.** An unknown
// extension served as `text/plain` invites the browser to sniff, and a
// sniffed type is how an uploaded `.dat` becomes executable script in the
// origin's context. Octet-stream is the type that means "bytes, do not
// interpret", and it is the safe answer to "I do not know".
//
// **`charset=utf-8` rides on the text types only.** A charset parameter on
// `image/png` is meaningless, and on `text/html` its absence is what lets a
// browser fall back to a locale-dependent encoding — the classic mojibake
// and the older UTF-7 XSS vector. Sailfin source and `string` are UTF-8, so
// declaring it is always honest here.
import { ascii_lowercase } from "sfn/strings";

// `_ext_of(path)` — the lowercased extension after the final `.`, with no
// dot, or `""` when the basename carries none.
//
// The `.` must come after the last `/`, or `"/a.b/plain"` would take `.b`
// off the *directory* and label an extensionless file as HTML. A leading-dot
// basename (`.gitignore`) is a name, not an extension, so a `.` at position
// 0 of the basename yields `""`.
fn _ext_of(path: string) -> string {
    let mut slash = -1;
    let mut dot = -1;
    let mut i = 0;
    loop {
        if i >= path.length { break; }
        let ch = grapheme_at(path, i);
        if strings_equal(ch, "/") {
            slash = i;
            dot = -1;
        }
        if strings_equal(ch, ".") { dot = i; }
        i = i + 1;
    }
    if dot < 0 { return ""; }
    if dot == slash + 1 { return ""; }
    return ascii_lowercase(substring(path, dot + 1, path.length));
}

// `content_type_for_path(path)` — the full `Content-Type` header *value*
// (media type plus any charset parameter) for `path`'s extension.
//
// The list is the set a static site actually ships, not an exhaustive IANA
// mirror: markup, styles, scripts, data, images, fonts, media, archives.
// Anything absent gets the octet-stream fallback above.
fn content_type_for_path(path: string) -> string {
    let ext = _ext_of(path);

    // Markup, styles, scripts.
    if strings_equal(ext, "html") || strings_equal(ext, "htm") {
        return "text/html; charset=utf-8";
    }
    if strings_equal(ext, "css") { return "text/css; charset=utf-8"; }
    if strings_equal(ext, "js") || strings_equal(ext, "mjs") {
        return "text/javascript; charset=utf-8";
    }

    // Data and text.
    if strings_equal(ext, "json") { return "application/json; charset=utf-8"; }
    if strings_equal(ext, "map") { return "application/json; charset=utf-8"; }
    if strings_equal(ext, "webmanifest") {
        return "application/manifest+json; charset=utf-8";
    }
    if strings_equal(ext, "xml") { return "application/xml; charset=utf-8"; }
    if strings_equal(ext, "txt") { return "text/plain; charset=utf-8"; }
    if strings_equal(ext, "md") { return "text/markdown; charset=utf-8"; }
    if strings_equal(ext, "csv") { return "text/csv; charset=utf-8"; }

    // Images. SVG is markup, so it carries a charset like the text types —
    // and is the one image type a browser will execute script from, which is
    // why a host serving untrusted uploads should not serve it from an
    // origin that matters.
    if strings_equal(ext, "svg") { return "image/svg+xml; charset=utf-8"; }
    if strings_equal(ext, "png") { return "image/png"; }
    if strings_equal(ext, "jpg") || strings_equal(ext, "jpeg") {
        return "image/jpeg";
    }
    if strings_equal(ext, "gif") { return "image/gif"; }
    if strings_equal(ext, "webp") { return "image/webp"; }
    if strings_equal(ext, "avif") { return "image/avif"; }
    if strings_equal(ext, "ico") { return "image/x-icon"; }
    if strings_equal(ext, "bmp") { return "image/bmp"; }

    // Fonts. `.eot` is deliberately absent — it is IE-only and dead.
    if strings_equal(ext, "woff") { return "font/woff"; }
    if strings_equal(ext, "woff2") { return "font/woff2"; }
    if strings_equal(ext, "ttf") { return "font/ttf"; }
    if strings_equal(ext, "otf") { return "font/otf"; }

    // Media.
    if strings_equal(ext, "mp4") { return "video/mp4"; }
    if strings_equal(ext, "webm") { return "video/webm"; }
    if strings_equal(ext, "mp3") { return "audio/mpeg"; }
    if strings_equal(ext, "ogg") { return "audio/ogg"; }
    if strings_equal(ext, "wav") { return "audio/wav"; }

    // Documents and archives.
    if strings_equal(ext, "pdf") { return "application/pdf"; }
    if strings_equal(ext, "zip") { return "application/zip"; }
    if strings_equal(ext, "gz") { return "application/gzip"; }
    if strings_equal(ext, "wasm") { return "application/wasm"; }

    return "application/octet-stream";
}

// `is_text_media_type(value)` — true when `value`'s media type is one this
// module labels UTF-8 text. Read by `static_file` to decide whether a body
// may cross the `string` boundary or must travel as raw bytes.
fn is_text_media_type(value: string) -> boolean {
    let lower = ascii_lowercase(value);
    let mut n = lower.length;
    let semi = find_char(lower, ";", 0);
    if semi >= 0 { n = semi; }
    let media = substring(lower, 0, n);

    if media.length >= 5 && strings_equal(substring(media, 0, 5), "text/") {
        return true;
    }
    if strings_equal(media, "application/json") { return true; }
    if strings_equal(media, "application/xml") { return true; }
    if strings_equal(media, "application/manifest+json") { return true; }
    if strings_equal(media, "image/svg+xml") { return true; }
    return false;
}
