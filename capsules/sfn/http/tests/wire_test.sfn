// Tests for the sfn/http wire layer (Wave 1 of epic #1321):
// parse_request / serialize_response / header / query_param.
//
// Pure parse/serialize coverage — no runtime, socket, or serve path is
// exercised here (that is Wave 2). Serialization is asserted by exact
// string equality because the output is deterministic.
import {
    Request,
    Response,
    bytes_response,
    header,
    html_escape,
    html_response,
    html_response_with_status,
    not_found,
    parse_request,
    parse_response,
    query_param,
    reason_phrase,
    redirect,
    response,
    response_body_length,
    serialize_head,
    serialize_response,
    text_response
} from "../src/mod";
// `keep_alive_requested` is an internal wire helper (not part of the public
// barrel); imported directly for unit coverage, like `server.sfn` does.
import { keep_alive_requested } from "../src/wire";

test "parse_request: GET request line, path, query, and headers" {
    let raw = "GET /search?q=sail&n=2 HTTP/1.1\r\nHost: localhost\r\nAccept: */*\r\n\r\n";
    let req = parse_request(raw);
    assert strings_equal(req.method, "GET");
    assert strings_equal(req.path, "/search");
    assert strings_equal(req.query, "q=sail&n=2");
    assert strings_equal(req.body, "");
    assert req.headers.length == 2;
    assert strings_equal(req.headers[0], "Host: localhost");
    assert strings_equal(req.headers[1], "Accept: */*");
}

test "parse_request: POST carries the body after the blank line" {
    let raw = "POST /submit HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\nhello";
    let req = parse_request(raw);
    assert strings_equal(req.method, "POST");
    assert strings_equal(req.path, "/submit");
    assert strings_equal(req.query, "");
    assert strings_equal(req.body, "hello");
    assert req.headers.length == 2;
}

test "parse_request: bare path with no query yields an empty query" {
    let req = parse_request("GET / HTTP/1.1\r\n\r\n");
    assert strings_equal(req.path, "/");
    assert strings_equal(req.query, "");
    assert req.headers.length == 0;
}

test "parse_response: status code, headers, and body (client twin)" {
    let raw = "HTTP/1.1 403 Forbidden\r\nX-Reason: nope\r\nContent-Length: 6\r\nConnection: close\r\n\r\ndenied";
    let rsp = parse_response(raw);
    assert rsp.status == 403;
    assert rsp.headers.length == 3;
    assert strings_equal(rsp.headers[0], "X-Reason: nope");
    assert strings_equal(rsp.headers[1], "Content-Length: 6");
    assert strings_equal(rsp.body, "denied");
}

test "parse_response: 200 with empty body" {
    let rsp = parse_response("HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
    assert rsp.status == 200;
    assert strings_equal(rsp.body, "");
    assert rsp.headers.length == 2;
}

test "parse_response: empty input yields a status-0 failure Response" {
    let rsp = parse_response("");
    assert rsp.status == 0;
    assert rsp.headers.length == 0;
    assert strings_equal(rsp.body, "");
}

test "serialize_response: status line, custom header, framing (exact bytes)" {
    let rsp = Response {
        status: 404,
        headers: ["X-Custom: yes"],
        body: "nope"
    };
    let out = serialize_response(rsp);
    let expected = "HTTP/1.1 404 Not Found\r\nX-Custom: yes\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 4\r\nConnection: close\r\n\r\nnope";
    assert strings_equal(out, expected);
}

test "serialize_response: drops headers carrying CR or LF (injection guard)" {
    let rsp = Response {
        status: 200,
        headers: ["Evil: a\r\nInjected: b"],
        body: "hi"
    };
    let out = serialize_response(rsp);
    let expected = "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi";
    assert strings_equal(out, expected);
}

test "serialize_response: drops user-supplied framing headers (smuggling guard)" {
    // User-supplied Content-Length / Connection / Transfer-Encoding must not
    // reach the wire — the serializer owns framing. The case-insensitive,
    // OWS-padded copies below are all dropped; X-Keep survives.
    let rsp = Response {
        status: 200,
        headers: ["content-length: 999", "Connection: keep-alive", "Transfer-Encoding: chunked", "X-Keep: yes"],
        body: "abc"
    };
    let out = serialize_response(rsp);
    let expected = "HTTP/1.1 200 OK\r\nX-Keep: yes\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc";
    assert strings_equal(out, expected);
}

test "serialize_response: keep_alive=true emits Connection: keep-alive (#1711)" {
    // The serializer no longer hard-codes `Connection: close` — when keep-alive
    // is negotiated it emits `Connection: keep-alive` instead.
    let rsp = Response {
        status: 200,
        headers: ["X-Custom: yes"],
        body: "ok"
    };
    let out = serialize_response(rsp, true);
    let expected = "HTTP/1.1 200 OK\r\nX-Custom: yes\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nok";
    assert strings_equal(out, expected);
}

test "serialize_response: keep_alive=false matches the default close framing (#1711)" {
    // Passing false explicitly is byte-identical to the zero-arg default — the
    // close-path regression stays intact.
    let rsp = Response { status: 200, headers: [], body: "x" };
    assert strings_equal(serialize_response(rsp, false), serialize_response(rsp));
    assert strings_equal(serialize_response(rsp, false), "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 1\r\nConnection: close\r\n\r\nx");
}

test "keep_alive_requested: HTTP/1.1 default is keep-alive, Connection: close opts out (#1711)" {
    // No Connection header → HTTP/1.1 default keep-alive.
    let plain = parse_request("GET / HTTP/1.1\r\nHost: x\r\n\r\n");
    assert keep_alive_requested(plain);
    // Explicit keep-alive.
    let keep = parse_request("GET / HTTP/1.1\r\nHost: x\r\nConnection: keep-alive\r\n\r\n");
    assert keep_alive_requested(keep);
    // Explicit close (any casing) opts out.
    let close = parse_request("GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
    assert ! keep_alive_requested(close);
    let close_uc = parse_request("GET / HTTP/1.1\r\nHost: x\r\nConnection: CLOSE\r\n\r\n");
    assert ! keep_alive_requested(close_uc);
}

test "reason_phrase: known codes mapped, unknown falls back to Status" {
    assert strings_equal(reason_phrase(200), "OK");
    assert strings_equal(reason_phrase(500), "Internal Server Error");
    assert strings_equal(reason_phrase(599), "Status");
}

test "header: case-insensitive lookup returns the trimmed value" {
    let req = parse_request("GET / HTTP/1.1\r\nHost:   example.com  \r\nX-Token: abc\r\n\r\n");
    let host = header(req, "HOST");
    assert host != null;
    if host != null { assert strings_equal(host, "example.com"); }
    let token = header(req, "x-token");
    assert token != null;
    if token != null { assert strings_equal(token, "abc"); }
    assert header(req, "x-missing") == null;
}

test "query_param: keyed lookup, valueless key, and absent key" {
    let req = parse_request("GET /p?a=1&flag&b=two HTTP/1.1\r\n\r\n");
    let a = query_param(req, "a");
    assert a != null;
    if a != null { assert strings_equal(a, "1"); }
    let b = query_param(req, "b");
    assert b != null;
    if b != null { assert strings_equal(b, "two"); }
    let flag = query_param(req, "flag");
    assert flag != null;
    if flag != null { assert strings_equal(flag, ""); }
    assert query_param(req, "missing") == null;
}

test "not_found: default body and 404 status" {
    let rsp = not_found();
    assert rsp.status == 404;
    assert strings_equal(rsp.body, "Not Found");
}

// ── content-type defaulting ───────────────────────────────────────
test "serialize_response: a caller's own Content-Type is not doubled" {
    // The default must yield to an explicit type, or every JSON response
    // would carry two conflicting Content-Type headers.
    let rsp = Response {
        status: 200,
        headers: ["Content-Type: application/json"],
        body: "{}"
    };
    let out = serialize_response(rsp);
    let expected = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}";
    assert strings_equal(out, expected);
}

test "serialize_response: a caller's lowercase Content-Type also suppresses the default" {
    // Header names are case-insensitive on the wire, so `content-type:` is
    // the same header and must not produce a second one.
    let rsp = Response {
        status: 200,
        headers: ["content-type: text/csv"],
        body: "a,b"
    };
    let out = serialize_response(rsp);
    assert strings_equal(out, "HTTP/1.1 200 OK\r\ncontent-type: text/csv\r\nContent-Length: 3\r\nConnection: close\r\n\r\na,b");
}

test "serialize_response: a bodiless response carries no Content-Type" {
    // A type on an empty body is a claim about bytes that were never sent.
    let rsp = Response { status: 204, headers: [], body: "" };
    let out = serialize_response(rsp);
    assert strings_equal(out, "HTTP/1.1 204 No Content\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
}

// ── response builders ─────────────────────────────────────────────
test "html_response: declares markup and a charset" {
    let out = serialize_response(html_response("<h1>hi</h1>"));
    let expected = "HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: 11\r\nConnection: close\r\n\r\n<h1>hi</h1>";
    assert strings_equal(out, expected);
}

test "html_response_with_status: carries markup under a chosen status" {
    let rsp = html_response_with_status(404, "<p>gone</p>");
    assert rsp.status == 404;
    assert strings_equal(rsp.headers[0], "Content-Type: text/html; charset=utf-8");
}

test "text_response: is plain text, and matches the bare default on the wire" {
    // `response()` defaults to the same type, so the two agree byte for
    // byte — `text_response` exists to say so at the call site.
    assert strings_equal(serialize_response(text_response("hi")), serialize_response(response("hi")));
}

test "redirect: is a bodiless 302 with a Location" {
    let out = serialize_response(redirect("/login"));
    assert strings_equal(out, "HTTP/1.1 302 Found\r\nLocation: /login\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
}

test "redirect: a permanent redirect is opt-in" {
    let rsp = redirect("/new", 301);
    assert rsp.status == 301;
}

test "redirect: a CRLF in the location is refused outright" {
    // The header would be dropped by the injection guard, leaving a 302
    // with nowhere to go — a redirect that silently does nothing is worse
    // than one that reports a fault.
    let rsp = redirect("/a\r\nX-Evil: 1");
    assert rsp.status == 500;
    assert rsp.headers.length == 0;
}

// ── escaping ──────────────────────────────────────────────────────
test "html_escape: escapes the five markup-significant characters" {
    assert strings_equal(html_escape("<script>"), "&lt;script&gt;");
    assert strings_equal(html_escape("a\"b"), "a&quot;b");
    assert strings_equal(html_escape("a'b"), "a&#39;b");
    assert strings_equal(html_escape("plain"), "plain");
}

test "html_escape: the ampersand is escaped once, not twice" {
    // Escaping `&` last would re-enter the entities the other four just
    // produced and render `<` as `&amp;lt;`.
    assert strings_equal(html_escape("&"), "&amp;");
    assert strings_equal(html_escape("a&<b"), "a&amp;&lt;b");
    assert strings_equal(html_escape("&amp;"), "&amp;amp;");
}

test "html_escape: neutralises an attribute breakout" {
    let escaped = html_escape("\" onerror=\"alert(1)");
    assert strings_equal(escaped, "&quot; onerror=&quot;alert(1)");
}

// ── binary bodies ─────────────────────────────────────────────────
test "response_body_length: the byte range wins over the string body" {
    // A caller setting `body_addr` leaves `body` empty; reading the string's
    // length would state a Content-Length of 0 for a real asset.
    let rsp = bytes_response(200, "image/png", 4096, 1234);
    assert response_body_length(rsp) == 1234;

    let text = response("hello");
    assert response_body_length(text) == 5;
}

test "serialize_head: states the binary length and appends no body" {
    // The head is text and ends at the blank line; the bytes are copied
    // after it by the server trampoline, which is why this must not try to
    // concatenate them.
    let rsp = bytes_response(200, "image/png", 4096, 1234);
    let head = serialize_head(rsp);
    let expected = "HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: 1234\r\nConnection: close\r\n\r\n";
    assert strings_equal(head, expected);
}

test "serialize_head: a text response's head is its serialization minus the body" {
    let rsp = response("hello");
    assert strings_equal(serialize_head(rsp) + "hello", serialize_response(rsp));
}
