// capsules/sfn/test/src/external_c_oracle.sfn
//
// Optional external C compiler oracle (SFN-1107).
//
// C-harness and differential tests sometimes need a host C compiler to
// compile a small harness or ask LLVM's optimizer a comparison question.
// That compiler is a test oracle only: it is not an Assemble or Link provider
// for Sailfin's production build, bootstrap, package, or runtime paths.
//
// `SAILFIN_TEST_C_COMPILER` is the explicit override. When it is unset,
// Darwin resolves Apple clang through the active Xcode / Command Line Tools
// selection with `/usr/bin/xcrun`; other hosts probe `clang` on `PATH`.
// Darwin also materializes `SDKROOT` through the same `xcrun` contract when
// the parent did not already provide one. Every oracle subprocess inherits
// the complete parent environment, so platform SDK and toolchain inputs are
// never lost to a file-local PATH/HOME/TMPDIR allowlist.
//
// The result is deliberately optional. `external_c_oracle()` lets tests
// inspect availability; `require_external_c_oracle()` turns absence or a
// deterministically poisoned override into a real test skip; and
// `run_external_c_oracle(args)` is the normal boundary for invocation.
import { trim } from "sfn/strings";

import { host_is_windows } from "./fixtures";
import { skip } from "./skip";

// ExternalCOracle describes the resolved optional compiler and its child environment.
struct ExternalCOracle {
    available: boolean;
    compiler: string;
    environment: string[];
    unavailable_reason: string;
}

fn _host_is_darwin() -> boolean ![io] {
    let host_override = env.get("SAILFIN_HOST_OS");
    if host_override.length > 0 { return host_override == "Darwin"; }
    return fs.exists("/System/Library/CoreServices");
}

fn _env_key_matches(entry: string, name: string) -> boolean {
    let prefix = name + "=";
    if entry.length < prefix.length { return false; }
    return substring(entry, 0, prefix.length) == prefix;
}

fn _set_environment(entries: string[], name: string, value: string) -> string[] {
    let mut out: string[] = [];
    let mut replaced = false;
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        if _env_key_matches(entries[i], name) {
            if !replaced {
                out.push(name + "=" + value);
                replaced = true;
            }
        } else { out.push(entries[i]); }
        i += 1;
    }
    if !replaced { out.push(name + "=" + value); }
    return out;
}

fn _capture_first_line(argv: string[], child_env: string[]) -> string ![io] {
    let exit = process.run_capture(argv, child_env);
    let out = trim(process.capture_take_stdout());
    let _err = process.capture_take_stderr();
    if exit != 0 { return ""; }
    return out;
}

// Can the oracle actually COMPILE, as opposed to merely launch (SFN-1114)?
//
// `--version` alone was the whole probe, and it answers a weaker question than
// the callers ask. The gap was observed on a native Windows host: clang 22 ran
// fine and reported `Target: x86_64-pc-windows-msvc`, then failed on a bare
// `#include <stdlib.h>`, because a Windows SDK 10.0.26100 `ucrt/stdlib.h`
// declared an anonymous `_LDOUBLE` struct that clang rejected. Nothing in the
// toolchain was missing and nothing Sailfin does is wrong; the two vendored
// halves of a host C toolchain can simply disagree. Sailfin's own build never
// notices, because it uses clang as an assembler and linker over emitted IR
// and includes no libc headers at all.
//
// State it as an instance, not a standing property of that clang or that SDK:
// the same host later compiled the probe cleanly with an unchanged clang
// version, so the disagreement is a moving target between vendored halves
// rather than a fixed pairing anyone can pin. That is the argument FOR probing
// capability instead of hardcoding a known-bad version.
//
// So the probe compiles a translation unit that includes the two headers every
// harness here uses. `-fsyntax-only` keeps it to a parse — no object, no link,
// no temp binary to clean up beyond the source. A host that fails this cannot
// serve as an oracle, and the honest outcome is the documented voluntary skip
// rather than a link error attributed to the test under measurement.
//
// Deliberately conservative: a healthy host compiles this trivially, so this
// cannot start silently skipping a real regression on Linux or macOS CI. If it
// ever does skip there, the toolchain is broken and that is worth knowing.
fn _oracle_can_compile(compiler: string, child_env: string[]) -> boolean ![io] {
    let dir = fs.mkdtemp("sfn-c-oracle-probe-");
    if dir.length == 0 { return false; }
    let probe = dir + "/probe.c";
    fs.writeFile(probe, "#include <stdlib.h>\n#include <stdio.h>\nint main(void) { return 0; }\n");
    let exit = process.run_capture([compiler, "-fsyntax-only", probe], child_env);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if fs.exists(probe) { fs.deleteFile(probe); }
    return exit == 0;
}

// Does the resolved compiler exist and start? The weaker of the two halves of
// availability; `_oracle_can_compile` above is the other.
fn _launches(compiler: string, child_env: string[]) -> boolean ![io] {
    if compiler.length == 0 { return false; }
    let exit = process.run_capture([compiler, "--version"], child_env);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    return exit == 0;
}

fn _is_oracle_available(compiler: string, child_env: string[]) -> boolean ![io] {
    if !_launches(compiler, child_env) { return false; }
    return _oracle_can_compile(compiler, child_env);
}

// external_c_oracle resolves the optional external C test oracle and its
// complete child environment without skipping or failing the test itself.
fn external_c_oracle() -> ExternalCOracle ![io] {
    let mut child_env = process.environ();
    let configured = env.get("SAILFIN_TEST_C_COMPILER");
    let darwin = _host_is_darwin();

    let mut compiler = configured;
    if compiler.length == 0 {
        if darwin {
            compiler = _capture_first_line(["/usr/bin/xcrun", "--find", "clang"], child_env);
        } else { compiler = "clang"; }
    }

    if darwin && env.get("SDKROOT").length == 0 {
        let sdkroot = _capture_first_line(["/usr/bin/xcrun", "--show-sdk-path"], child_env);
        if sdkroot.length > 0 {
            child_env = _set_environment(child_env, "SDKROOT", sdkroot);
        }
    }

    if !_is_oracle_available(compiler, child_env) {
        let mut reason = "optional external C test oracle is unavailable";
        // Which of the two failures happened, so the skip line is actionable.
        // "not found on PATH" for a compiler that launched fine and simply
        // cannot parse its own libc headers sends the reader looking for a
        // missing install that is not missing (SFN-1114).
        let launches = _launches(compiler, child_env);
        if configured.length > 0 {
            reason = reason + ": SAILFIN_TEST_C_COMPILER=" + configured;
        } else if darwin && !launches {
            reason = reason + ": Apple clang was not resolved by /usr/bin/xcrun";
        } else if !launches {
            reason = reason + ": clang was not found on PATH";
        }
        if launches {
            reason = reason + ": `" + compiler
                + "` runs but cannot compile a translation unit including <stdlib.h>/<stdio.h>"
                + " — the host C toolchain and its SDK headers disagree";
        }
        return ExternalCOracle {
            available: false,
            compiler: compiler,
            environment: child_env,
            unavailable_reason: reason
        };
    }

    return ExternalCOracle {
        available: true,
        compiler: compiler,
        environment: child_env,
        unavailable_reason: ""
    };
}

// require_external_c_oracle resolves the oracle or records an explicit
// voluntary test skip. `skip` does not return; the fallback return only
// satisfies the function's static shape.
fn require_external_c_oracle() -> ExternalCOracle ![io] {
    let oracle = external_c_oracle();
    if !oracle.available { skip(oracle.unavailable_reason); }
    return oracle;
}

// The link flags this host needs to reach libm from a C oracle harness, to be
// spliced into an oracle argv instead of a hard-coded `-lm` (SFN-1114).
//
// `-lm` is a POSIX spelling with no MSVC counterpart: the Microsoft CRT has no
// separate math library, so `libm.a`'s contents live in the same `libcmt.lib`
// the linker already pulls in and `lld-link` fails with
// `could not open 'm.lib': no such file or directory`. The right flag on that
// host is therefore no flag at all, which is why this returns an ARRAY — an
// empty one is the answer, and a function returning a single string could not
// express it without a sentinel every caller would have to strip.
//
// Keyed on the HOST, not on the build target. The harness is compiled by the
// host C compiler to run on this machine, so a cross-build's `--target` is not
// what decides which CRT it links against.
//
// The host probe lives in `./fixtures.sfn` so the capsule carries exactly one
// copy of the rule; see `host_is_windows` there for why it mirrors
// `build_host_os` rather than importing it.
fn c_math_link_flags() -> string[] ![io] {
    if host_is_windows() {
        let none: string[] = [];
        return none;
    }
    return ["-lm"];
}

// The link flags this host needs for POSIX threads in a C oracle harness, to
// be spliced into an oracle argv instead of a hard-coded `-lpthread`
// (SFN-1114). Win32 threads live in the CRT/kernel32, not a separate pthread
// library, so `-lpthread` fails there the same way `-lm` does; the answer on
// that host is again the empty list.
//
// Keyed on the HOST for the same reason as `c_math_link_flags`: the harness
// is compiled by the host C compiler to run on this machine.
fn c_thread_link_flags() -> string[] ![io] {
    if host_is_windows() {
        let none: string[] = [];
        return none;
    }
    return ["-lpthread"];
}

// run_external_c_oracle runs the optional oracle with `args` appended after
// its resolved executable. Callers consume stdout/stderr through the ordinary
// `process.capture_take_*` builtins, matching `process.run_capture`'s idiom.
fn run_external_c_oracle(args: string[]) -> int ![io] {
    let oracle = require_external_c_oracle();
    let mut argv: string[] = [oracle.compiler];
    let mut i: int = 0;
    loop {
        if i >= args.length { break; }
        argv.push(args[i]);
        i += 1;
    }
    return process.run_capture(argv, oracle.environment);
}
