// sfn/test — the path to the `sfn` binary under test (SFN-977).
//
// Every test that drives the compiler as a subprocess has to name the
// binary to spawn. Before this module there were 318 places that decided
// how — 317 byte-identical private `_sfn_bin()` copies (315 under
// `compiler/tests/`, plus `capsules/sfn/test/tests/child_diag_test.sfn` and
// `capsules/sfn/bench/tests/sample_run_test.sfn`), each of them this:
//
//     fn _sfn_bin() -> string ![io] {
//         let configured = env.get("SAILFIN_BIN");
//         if configured.length > 0 { return configured; }
//         return "build/bin/sfn";
//     }
//
// and the 318th, a differently-named twin inside this very capsule
// (`_resolve_sfn_bin` in `compile_assert.sfn`), which many of those copies'
// doc comments cited as the original they were "mirroring" — a shared
// helper that had in fact never been exported. This module is that export,
// and `sfn_bin_path` is now the only definition of it in the tree. Counts
// are stated here and nowhere else; other sites refer to this module rather
// than restating them.
//
// WHY THE DUPLICATION MATTERED, beyond tidiness: the fallback literal is
// POSIX-only. On a Windows host the self-host writes `build/bin/sfn.exe`
// (`host_exe_name`, `compiler/src/build/target.sfn`), so every one of those
// copies looked for a file the build never produced. The suite was
// unrunnable on Windows one hand-copied line at a time, which is the slice
// of SFN-938 this closes.
// ---------------------------------------------------------------------------
// True when the *host* we are running on names executables with `.exe`.
//
// This deliberately mirrors `build_host_os()` in
// `compiler/src/build/target.sfn` probe for probe, including the
// `SAILFIN_HOST_OS` override and the order of the filesystem markers. The
// agreement is load-bearing rather than cosmetic: the compiler decides what
// to *name* the binary it writes, and this decides what name to *look for*.
// If the two resolvers ever disagree, the test hunts for a file the build
// did not write — the exact failure this module exists to remove — so the
// duplicated logic is the lesser evil.
//
// It cannot simply call `host_exe_name`. That function lives in
// `compiler/src/build/target.sfn`, inside the `sfn/compiler` capsule, which
// is `kind = "binary"` and is never linked as a library; `sfn/test` is a
// narrow-stdlib library that the compiler's own tests consume, so importing
// the driver here would invert the dependency and trip the role split
// `compiler/tests/unit/compiler_capsule_boundary_test.sfn` ratchets.
//
// Exported (rather than file-private) so `scratch.sfn`'s `scratch_root`
// (SFN-978) can share this probe instead of duplicating its body.
fn _host_is_windows() -> boolean ![io] {
    let host_override = env.get("SAILFIN_HOST_OS");
    if host_override.length > 0 { return host_override == "Windows"; }
    if fs.exists("/proc/self/status") { return false; }
    if fs.exists("/System/Library/CoreServices") { return false; }
    return env.get("SystemRoot").length > 0;
}

// The `sfn` binary a test should spawn.
//
// `SAILFIN_BIN` wins verbatim when set, with no suffix conditioning: CI legs
// and the pooled runner point tests at one specific build, and appending to
// an explicit override would defeat the point of having one. Callers that
// set it are expected to name the file that exists.
//
// Only the fallback is host-conditioned, so on POSIX this returns
// `"build/bin/sfn"` — byte-identical to the copies it replaces.
//
// The override-first ORDER is load-bearing, not just tidy. `.github/`'s
// Linux leg that sets `SAILFIN_HOST_OS: Windows` to exercise the
// Windows-host seam runs tests that call this, and they stay green only
// because the pool seeds `SAILFIN_BIN` (`_pool_child_env` in
// `cli/commands/test/pool.sfn`, `_test_exec_env` in `.../exec.sfn`) so this
// returns before `_host_is_windows()` is ever consulted. Stop seeding it and
// that leg starts hunting `build/bin/sfn.exe` on a Linux runner.
fn sfn_bin_path() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    if _host_is_windows() { return "build/bin/sfn.exe"; }
    return "build/bin/sfn";
}

// `realpath(path, resolved)` with `resolved = null` has libc allocate the
// resolved buffer; `_cwd` below calls it as `realpath(".", null)`. On a
// native Windows host this resolves against
// `runtime/sfn/platform/realpath_windows.sfn` (over `_fullpath`), appended
// for the Windows target by `target_condition_runtime_sfn_sources`
// (`compiler/src/build/target.sfn`) — the same sibling-module treatment
// `compiler/src/build/fs.sfn:57` documents for its own inline copy of this
// extern. This is the sanctioned way to get the cwd without a shell; do not
// "fix" `_cwd` below into a `pwd` shellout.
extern fn realpath(path: *u8, resolved: *u8) -> *u8;

// The current working directory, mirroring `_cwd_cmd` in
// `compiler/src/build/fs.sfn:184-190`: `realpath(".", null)` first, `PWD`
// only as a fallback (it is shell-maintained, so it is absent under a
// non-shell parent and on native Windows), and `"."` as the terminus rather
// than fabricating a root. Duplicated rather than imported — `sfn/test` is
// a narrow-stdlib library and cannot depend on the `sfn/compiler` binary
// capsule, the same capsule-boundary constraint documented above this file
// at lines 41-46.
fn _cwd() -> string ![io] {
    let resolved: *u8 = realpath("." as *u8, null);
    if resolved as i64 != 0 { return resolved as string; }
    let pwd = env.get("PWD");
    if pwd.length > 0 { return pwd; }
    return ".";
}

// True iff `path` is already absolute and needs no cwd prefix.
//
// Structural, not host-conditioned: this asks what `path` looks like, not
// what host we are running on, because `SAILFIN_BIN` may name a path in
// either shape regardless of the host `sfn_bin_abs_path` itself runs on
// (for example a Linux-hosted CI leg pointing at a Windows build artifact).
// Deliberately does NOT route through `_host_is_windows()`.
//
// Recognizes a leading `/` or `\`, a drive prefix (`C:\...` or `C:/...`),
// and a UNC prefix (`\\server\share\...`). Semantics should agree with
// `path_root_prefix_len`/`is_absolute_path` in
// `compiler/src/string_utils.sfn` (SFN-704) — that module is this one's
// driver-side twin, duplicated here rather than imported for the same
// capsule-boundary reason as `_cwd` above.
fn _is_absolute_bin_path(path: string) -> boolean {
    if path.length == 0 { return false; }
    // A leading `\` already covers UNC (`\\server\share\...`) — its
    // second `\` never needs its own check.
    if path[0] == "/" || path[0] == "\\" { return true; }
    if path.length >= 2 && path[1] == ":" {
        let code = char_code(path[0]);
        let is_letter = (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
        if is_letter { return true; }
    }
    return false;
}

// `sfn_bin_path()`, absolutized against the cwd when it is relative.
//
// Every test that drives the compiler under test as a child of a DIFFERENT
// cwd (a scratch repo, a nested `sfn` invocation) needs the binary path
// absolutized first — a relative `sfn_bin_path()` would not resolve there.
// This is the single definition of a resolver that 15 e2e tests under
// `compiler/tests/e2e/` had each hand-copied as a private `_sfn_bin_abs()`,
// every copy guarding absoluteness with a POSIX-only `bin[0] == "/"` check
// that misclassifies a Windows drive path (`C:\...`) as relative (SFN-995).
//
// Joins with `/`, never `\`, to keep POSIX output byte-identical to the 15
// copies being replaced — Win32 accepts both separators in every file API,
// the argument `runtime/sfn/platform/realpath_windows.sfn:43-49` makes at
// length.
fn sfn_bin_abs_path() -> string ![io] {
    let bin = sfn_bin_path();
    if _is_absolute_bin_path(bin) { return bin; }
    return _cwd() + "/" + bin;
}
