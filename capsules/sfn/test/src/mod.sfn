// sfn/test — Test assertion helpers and utilities for Sailfin.
//
// Provides rich assertion functions that print diagnostic messages on failure,
// showing both expected and actual values. These complement the built-in
// `assert` keyword with more descriptive failure output.
//
// Requires ![io] for diagnostic printing on failure.
//
// Two API tiers (per `docs/proposals/0010-test-infra.md` §3.3, which also
// states the condition for collapsing them into one):
//
//   1. Legacy `assert_*` — `![io]`. Prints diagnostics on mismatch via
//      `print.err`, then `assert false` to fail the test.
//   2. `pure_assert_*` — `![pure]`. Returns an `AssertFailure` record
//      with `present == true` on mismatch — a hand-rolled
//      `Result<(), AssertFailure>` predating that type. `Result<T, E>`
//      has since shipped (SFEP-0012), so the fold is pending. The capsule
//      body never prints; consumers (a hand-rolled `if r.present
//      { assert false; }`, or the shipped `expect_*` matchers) decide
//      how to surface the failure. This lets a test calling only
//      `pure_assert_*` stay `![pure]` even though the capsule manifest
//      keeps `required = ["io"]` for the legacy tier.
//
// Both tiers collapse into a single generic `assert_eq` parameterized
// over the caller's effect row when row-polymorphic effects ship
// post-1.0. Until then, `pure_assert_*` is the production-ready
// interim — see issue #370; SFEP-0010 §3.3.
import { find } from "sfn/strings";

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------
// Integer formatting goes through the runtime intrinsic `number_to_string`,
// which already renders integers via `%.15g` (no trailing `.0`). The
// previous file-local `_number_to_string` duplicated that with a slow
// integer-only fallback; removing it keeps a single formatter for both
// int and float assertion diagnostics.
fn _bool_to_string(value: boolean) -> string {
    if value { return "true"; }
    return "false";
}

fn _abs(x: float) -> float {
    // `x` is a float, so the negation must use a float literal: a bare `0`
    // is an int literal, and Sailfin rejects int/float mixing in arithmetic
    // (strict scalar coercion, spec §06-types). Write `0.0` so the operand
    // kinds match (issue #1954).
    if x < 0.0 { return 0.0 - x; }
    return x;
}

// ---------------------------------------------------------------------------
// Equality assertions
// ---------------------------------------------------------------------------
fn assert_eq(actual: float, expected: float, label: string) ![io] {
    if actual == expected { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: " + number_to_string(expected));
    print.err("  actual:   " + number_to_string(actual));
    assert false;
}

fn assert_ne(actual: float, expected: float, label: string) ![io] {
    if actual != expected { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected not: " + number_to_string(expected));
    print.err("  actual:       " + number_to_string(actual));
    assert false;
}

fn assert_str_eq(actual: string, expected: string, label: string) ![io] {
    if actual == expected { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: \"" + expected + "\"");
    print.err("  actual:   \"" + actual + "\"");
    assert false;
}

fn assert_str_ne(actual: string, expected: string, label: string) ![io] {
    if actual != expected { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected not: \"" + expected + "\"");
    print.err("  actual:       \"" + actual + "\"");
    assert false;
}

fn assert_bool_eq(actual: boolean, expected: boolean, label: string) ![io] {
    if actual == expected { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: " + _bool_to_string(expected));
    print.err("  actual:   " + _bool_to_string(actual));
    assert false;
}

// ---------------------------------------------------------------------------
// Comparison assertions
// ---------------------------------------------------------------------------
fn assert_gt(actual: float, threshold: float, label: string) ![io] {
    if actual > threshold { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: > " + number_to_string(threshold));
    print.err("  actual:     " + number_to_string(actual));
    assert false;
}

fn assert_gte(actual: float, threshold: float, label: string) ![io] {
    if actual >= threshold { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: >= " + number_to_string(threshold));
    print.err("  actual:      " + number_to_string(actual));
    assert false;
}

fn assert_lt(actual: float, threshold: float, label: string) ![io] {
    if actual < threshold { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: < " + number_to_string(threshold));
    print.err("  actual:     " + number_to_string(actual));
    assert false;
}

fn assert_lte(actual: float, threshold: float, label: string) ![io] {
    if actual <= threshold { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: <= " + number_to_string(threshold));
    print.err("  actual:      " + number_to_string(actual));
    assert false;
}

// ---------------------------------------------------------------------------
// String content assertions
// ---------------------------------------------------------------------------
fn assert_contains(haystack: string, needle: string, label: string) ![io] {
    if find(haystack, needle, 0) >= 0 { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected to contain: \"" + needle + "\"");
    print.err("  actual:              \"" + haystack + "\"");
    assert false;
}

fn assert_not_contains(haystack: string, needle: string, label: string) ![io] {
    if find(haystack, needle, 0) < 0 { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected not to contain: \"" + needle + "\"");
    print.err("  actual:                  \"" + haystack + "\"");
    assert false;
}

fn assert_starts_with(text: string, prefix: string, label: string) ![io] {
    if prefix.length <= text.length {
        if substring(text, 0, prefix.length) == prefix { return; }
    }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected to start with: \"" + prefix + "\"");
    print.err("  actual:                 \"" + text + "\"");
    assert false;
}

fn assert_ends_with(text: string, suffix: string, label: string) ![io] {
    if suffix.length <= text.length {
        let start = text.length - suffix.length;
        if substring(text, start, text.length) == suffix { return; }
    }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected to end with: \"" + suffix + "\"");
    print.err("  actual:               \"" + text + "\"");
    assert false;
}

// ---------------------------------------------------------------------------
// Approximate equality (for floating-point / tolerance comparisons)
// ---------------------------------------------------------------------------
fn assert_approx(actual: float, expected: float, tolerance: float, label: string) ![io] {
    let diff = _abs(actual - expected);
    if diff <= tolerance { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: " + number_to_string(expected) + " +/- "
        + number_to_string(tolerance));
    print.err("  actual:   " + number_to_string(actual));
    assert false;
}

// ---------------------------------------------------------------------------
// Array length assertions
// ---------------------------------------------------------------------------
fn assert_length(actual_length: int, expected_length: int, label: string) ![io] {
    if actual_length == expected_length { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected length: " + number_to_string(expected_length));
    print.err("  actual length:   " + number_to_string(actual_length));
    assert false;
}

fn assert_empty(actual_length: int, label: string) ![io] {
    if actual_length == 0 { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected empty (length 0)");
    print.err("  actual length: " + number_to_string(actual_length));
    assert false;
}

fn assert_not_empty(actual_length: int, label: string) ![io] {
    if actual_length > 0 { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected non-empty (length > 0)");
    print.err("  actual length: 0");
    assert false;
}

// ---------------------------------------------------------------------------
// Boolean assertions
// ---------------------------------------------------------------------------
fn assert_true(value: boolean, label: string) ![io] {
    if value { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: true");
    print.err("  actual:   false");
    assert false;
}

fn assert_false(value: boolean, label: string) ![io] {
    if !value { return; }
    print.err("ASSERTION FAILED: " + label);
    print.err("  expected: false");
    print.err("  actual:   true");
    assert false;
}

// ---------------------------------------------------------------------------
// Pure-effect assertions (issue #370; SFEP-0010 §3.3)
// ---------------------------------------------------------------------------
//
// The `pure_assert_*` family returns an `AssertFailure` record instead
// of printing. Each helper is `![pure]` so a `![pure]` test calling
// only these functions stays `![pure]` end-to-end. The capsule
// manifest still declares `required = ["io"]` because the legacy tier
// above (`assert_eq`, `assert_str_eq`, etc.) needs `print.err`; that
// surface describes what the capsule's *own* functions can do, not
// what every caller must declare.
//
// `AssertFailure` mirrors the shape used by P2 in
// `compiler/src/cli_commands.sfn` (issue #364). The `present` field
// is the discriminator: `present == false` is the "Ok(())" case,
// `present == true` carries the diagnostic. When `Result<T, E>`
// lands (1.0 critical-path Phase 1), the helpers move to
// `Result<(), AssertFailure>` — `present == false` maps to `Ok(())`
// and `present == true` to `Err(failure)` with no shape change.
// At that point the duplicate definition here and in `cli_commands.sfn`
// folds into a shared module.
//
// `file` / `line` / `col` stay empty / 0 today: Sailfin lacks
// `__file__` / `__line__` macros, and a plain `fn` body cannot reach
// out for the call-site span. 1.4's `expect()` matcher is parsed
// directly and can attach those fields. Until then, `message` carries
// the `label` plus a stringified expected/actual pair so a manual
// `if r.present { assert false; }` consumer still gets actionable
// output through P2's structured failure record.
struct AssertFailure {
    present: boolean;
    file: string;
    line: int;
    col: int;
    message: string;
}

fn _pure_ok() -> AssertFailure {
    return AssertFailure {
        present: false,
        file: "",
        line: 0,
        col: 0,
        message: ""
    };
}

fn _pure_fail(message: string) -> AssertFailure {
    return AssertFailure {
        present: true,
        file: "",
        line: 0,
        col: 0,
        message: message
    };
}

fn pure_assert_eq_int(actual: int, expected: int, label: string) -> AssertFailure ![pure] {
    if actual == expected { return _pure_ok(); }
    let message = "ASSERTION FAILED: " + label + "; expected: "
        + number_to_string(expected)
        + "; actual: "
        + number_to_string(actual);
    return _pure_fail(message);
}

fn pure_assert_eq_string(actual: string, expected: string, label: string) -> AssertFailure ![pure] {
    if actual == expected { return _pure_ok(); }
    let message = "ASSERTION FAILED: " + label + "; expected: \"" + expected
        + "\""
        + "; actual: \""
        + actual
        + "\"";
    return _pure_fail(message);
}

fn pure_assert_eq_float(actual: float, expected: float, tolerance: float, label: string) -> AssertFailure ![pure] {
    let diff = _abs(actual - expected);
    if diff <= tolerance { return _pure_ok(); }
    // The runtime's `%.15g`-format `number_to_string` is the single
    // formatter used across every numeric assertion in this module:
    // it renders integer-shaped inputs without a trailing `.0` and
    // preserves useful precision for fractional inputs. Issue #846
    // removed the file-local `_number_to_string` int-only fallback
    // — there is now no asymmetry between the int and float paths.
    let message = "ASSERTION FAILED: " + label + "; expected: "
        + number_to_string(expected)
        + " +/- "
        + number_to_string(tolerance)
        + "; actual: "
        + number_to_string(actual);
    return _pure_fail(message);
}

fn pure_assert_eq_bool(actual: boolean, expected: boolean, label: string) -> AssertFailure ![pure] {
    if actual == expected { return _pure_ok(); }
    let message = "ASSERTION FAILED: " + label + "; expected: "
        + _bool_to_string(expected)
        + "; actual: "
        + _bool_to_string(actual);
    return _pure_fail(message);
}

fn pure_assert_true(value: boolean, label: string) -> AssertFailure ![pure] {
    if value { return _pure_ok(); }
    let message = "ASSERTION FAILED: " + label
        + "; expected: true; actual: false";
    return _pure_fail(message);
}

fn pure_assert_false(value: boolean, label: string) -> AssertFailure ![pure] {
    if !value { return _pure_ok(); }
    let message = "ASSERTION FAILED: " + label
        + "; expected: false; actual: true";
    return _pure_fail(message);
}

// ---------------------------------------------------------------------------
// `expect()` matchers (issue #847; SFEP-0010 §3.2)
// ---------------------------------------------------------------------------
// The matcher surface lives in `expect.sfn` (the per-type `expect_*`
// entry points) and `matcher.sfn` (the `MatchResult` core + comparison/
// containment logic). This barrel re-exports their public surface so
// consumers import everything from `sfn/test`. The legacy `assert_*` and
// `pure_assert_*` tiers above are retained unchanged (deprecation is
// Phase 3 / issue 3.3).
//
// Matchers are free functions (not a fluent `expect(x).to_be(y)` builder):
// the fluent method form needs cross-module struct-method dispatch, which
// is currently miscompiled (a method's `self` is passed incorrectly across
// a module boundary). Free functions pass arguments correctly across
// modules, so the matcher behavior ships now; the fluent sugar is a
// follow-up once that compiler ABI bug is fixed. See `expect.sfn`.
export { MatchResult, match_fail, match_ok } from "./matcher";

export {
    expect_contains_int_array,
    expect_contains_str,
    expect_eq_bool,
    expect_eq_bool_array,
    expect_eq_int,
    expect_eq_int_array,
    expect_eq_str,
    expect_eq_str_array,
    expect_to_throw,
    expect_to_throw_with
} from "./expect";

// ---------------------------------------------------------------------------
// Snapshot / golden-file matcher (issue #977; SFEP-0010 §3.2)
// ---------------------------------------------------------------------------
// `expect_snapshot(actual, key)` is the `![io]` entry point: write on
// first run / `--update-snapshots`, compare thereafter. `snapshot_match_in`
// is the testable core with the directory + update flag passed explicitly.
// See `snapshot.sfn`.
export { expect_snapshot, snapshot_match_in } from "./snapshot";

// ---------------------------------------------------------------------------
// Compile-as-test assertions (issue #974; SFEP-0010 §3.2)
// ---------------------------------------------------------------------------
// `assert_compiles` / `assert_does_not_compile` shell out to the
// shipped `sfn check --json` via `process.run_capture` and parse the
// `sailfin-check/1` envelope with `sfn/json`. Both are `![io]` and
// return a `MatchResult`. See `compile_assert.sfn`.
export { CompileExpect, assert_compiles, assert_does_not_compile } from "./compile_assert";

// ---------------------------------------------------------------------------
// Scoped fixtures (issue #979; SFEP-0010 §3.2)
// ---------------------------------------------------------------------------
// `with_tmp_dir(body)` creates a temp dir, runs the (possibly capturing)
// `body` closure against it, and recursively removes the tree on scope
// exit — including the throwing path — via a pure-Sailfin `rm -rf` over the
// `fs.*` intrinsics (mirroring `sfn/fs::remove_all` from #976; see the note
// in `fixtures.sfn` for why it does not import that capsule).
//
// `with_env(args, env, body)` (issue #1166) is the concurrency-safe
// successor to the dropped process-global `with_env`: it runs `args` as a
// subprocess under a scoped `os::Env` via `os::run_capture` and threads the
// captured `ProcessOutput` to `body`, never mutating the parent `environ`.
// `with_cwd(args, env, cwd, body)` (issue #1168) is its cwd-scoping
// companion: it runs the child in `cwd` via the same `os::run_capture`
// (#1167 per-child cwd), with no process-global `chdir`. See `fixtures.sfn`.
// `clean_runner_env(nested_scratch)` / `nested_runner_scratch(label)`
// (SFN-401) build a clean top-level child environment for an e2e test that
// spawns a *nested* `sfn test`/`sfn build`/`sfn run`: they strip the per-child
// pool-orchestration keys the parent runner set (which otherwise bind the
// nested run to the parent's private state under `--jobs N>1`) and re-point
// `SAILFIN_TEST_SCRATCH` at an isolated subdir. See `fixtures.sfn`.
// `clean_runner_env_without(nested_scratch, also_strip)` (SFN-1114) is the
// same thing plus a caller-named strip list, for a helper that goes on to push
// its own value for a key the outer environment may also carry — `getenv`
// returns the first match, so an inherited entry would shadow the push.
export {
    // `bash_path(path)` (SFN-1151) is the explicit Win32-to-MSYS bridge for
    // fixtures that intentionally validate Bash scripts. Callers retain the
    // native spelling for Win32 filesystem APIs and child cwd parameters.
    bash_path,
    clean_runner_env,
    clean_runner_env_without,
    // `host_is_windows()` (SFN-1114) is for a test whose EXPECTED VALUE differs
    // by host — the errno accessor the emitter picks, a C harness's link flags.
    // A test that merely needs platform-shaped INPUT should force it with the
    // `SAILFIN_TARGET_OS` override instead, so the assertion runs everywhere.
    git_bash_path,
    host_is_windows,
    nested_runner_scratch,
    with_cwd,
    with_env,
    with_tmp_dir
} from "./fixtures";

// ---------------------------------------------------------------------------
// Child-process failure diagnostics (SFN-87 / #1726, SFN-1115)
// ---------------------------------------------------------------------------
// `report_child_failure(tag, exit, out, err)` prints a failed child's exit
// code and captured stdout/stderr to stderr, and is a no-op on success — so
// a call site stays a single unconditional line before its `assert exit ==
// 0`. Each stream is clipped to `SAILFIN_TEST_CHILD_DIAG_BYTES` bytes
// (default 8192, `0` = unlimited) keeping head and tail, so a heavily-failing
// run cannot bury the tier log. `report_child_failure_pending(tag, exit)` is
// the borrow-free form: it *drains* both captured streams (taking ownership,
// like the `let _o`/`let _e` pair it replaces) before forwarding to
// `report_child_failure`, so it must not be used where a caller still needs
// the streams afterwards — use `report_child_failure` directly and bind
// `out`/`err` first in that case. See `child_diag.sfn`.
export { report_child_failure, report_child_failure_pending } from "./child_diag";

// ---------------------------------------------------------------------------
// Host tool-presence probing (SFN-840)
// ---------------------------------------------------------------------------
// `tool_present(tool)` answers "is this external tool on the host's `PATH`"
// without spawning a shell, replacing the `sh -c "command -v <tool>"` probe
// that fifteen e2e files each carried a private copy of (and that cannot work
// on a native Windows host). `first_present_tool(candidates)` returns the
// first that resolves — the `timeout` / `gtimeout` shape.
//
// These live in `tool_probe.sfn` rather than `process_control.sfn` because
// that module states, and keeps, the invariant that it calls no `process.*`
// builtin directly — every operation there goes through `sfn/os`'s typed
// handle. The probe deliberately uses the runtime builtin, whose documented
// spawn-failure codes are what make it a faithful `command -v`. See
// `tool_probe.sfn`.
//
// `symbol_reader()` is the `first_present_tool` instantiation for the host's
// symbol reader (`llvm-nm` / `nm` / `llvm-nm-18`, SFN-1114).
export { first_present_tool, symbol_reader, tool_present } from "./tool_probe";

// ---------------------------------------------------------------------------
// Optional external C test oracle (SFN-1107)
// ---------------------------------------------------------------------------
// This boundary is exclusively for C-harness and differential-oracle tests.
// It resolves an explicit `SAILFIN_TEST_C_COMPILER` first, selects Apple
// clang through the active Xcode/Command Line Tools contract on Darwin, and
// preserves the complete host environment (including SDK inputs). Missing or
// poisoned compilers become voluntary skips through
// `require_external_c_oracle` / `run_external_c_oracle`; no production build,
// bootstrap, runtime, package, or link path may import this helper.
export {
    ExternalCOracle,
    c_math_link_flags,
    c_thread_link_flags,
    external_c_oracle,
    require_external_c_oracle,
    run_external_c_oracle
} from "./external_c_oracle";

// ---------------------------------------------------------------------------
// The binary under test (SFN-977)
// ---------------------------------------------------------------------------
// `sfn_bin_path()` is the `sfn` binary a test should spawn: `SAILFIN_BIN`
// verbatim when set, else the self-host output path conditioned on the host's
// executable suffix. It is the single definition of a resolver that 315 test
// files under `compiler/tests/` had each hand-copied as a private
// `_sfn_bin()`, none of them `.exe`-aware, and that `compile_assert.sfn` also
// carried privately as `_resolve_sfn_bin` — the helper those copies' comments
// claimed to mirror but which was never exported.
//
// It lives in its own module rather than joining `tool_probe.sfn` because that
// module answers "is some external tool on `PATH`" by executing it, while this
// one names a specific file this repo builds and never spawns anything. See
// `sfn_bin.sfn` for why the host-suffix logic is duplicated from the driver
// instead of imported.
export { sfn_bin_path } from "./sfn_bin";

// `sfn_bin_abs_path()` is `sfn_bin_path()` absolutized against the cwd via
// `realpath`, for a test that drives the compiler under test from a
// DIFFERENT cwd (a scratch repo, a nested `sfn` invocation). It is the
// single definition of a resolver that 15 e2e tests under
// `compiler/tests/e2e/` had each hand-copied as a private `_sfn_bin_abs()`,
// every copy guarding absoluteness with a POSIX-only `bin[0] == "/"` check
// that misclassifies a Windows drive path (`C:\...`) as relative, and most
// shelling out to `pwd` besides (SFN-995). See `sfn_bin.sfn` for the
// `realpath`-over-shellout rationale.
export { sfn_bin_abs_path } from "./sfn_bin";

// ---------------------------------------------------------------------------
// The scratch directory a test should use (SFN-978)
// ---------------------------------------------------------------------------
// `scratch_root()` is the scratch directory a test should write temp files
// under: `SAILFIN_TEST_SCRATCH` verbatim when set, else the host-conditioned
// `default_scratch_dir()` — `TEMP`/`TMP`/`"."` on Windows, `TMPDIR`/`"/tmp"`
// on POSIX. It is the single definition of a fallback that 230 test files
// under `compiler/tests/` had each hand-copied as the POSIX-only literal
// `"/tmp"`, unrunnable on a native Windows host. See `scratch.sfn`.
export { default_scratch_dir, scratch_root, sfn_source_literal } from "./scratch";

// ---------------------------------------------------------------------------
// Voluntary test skips (SFN-815)
// ---------------------------------------------------------------------------
// `skip(reason)` records the running test as skipped rather than passed, and
// is the required way to gate a test on a missing tool, an offline network, or
// an unsupported platform. It replaces the `assert true; return;` idiom, which
// reports `pass` and so makes a dormant test indistinguishable from a working
// one — the mechanism that hid SFN-807 for a full release cycle. It does not
// return: the skip leaves the body by unwinding, because the harness reports an
// unconditional pass for any body that returns normally. See `skip.sfn`.
export { skip } from "./skip";

// ---------------------------------------------------------------------------
// Process-lifetime control (SFEP-0010 §3.2)
// ---------------------------------------------------------------------------
// The fixtures above spawn a child and wait for it to finish. These tear one
// down on demand, which is what tests previously had to reach for a shell to
// do — a `timeout <secs>` argv vehicle (behind a `command -v` probe, skipping
// the test when neither `timeout` nor `gtimeout` was installed) and a
// `process.run(["sleep", "0.5"])` fork per poll tick.
//
// Bounded running itself is NOT re-exported here: `os::run_bounded` and
// `os::drain_to_exit` own the deadline, the stdout/stderr demux, the
// kill-on-expiry and the single reap, and a test that just wants a child under
// a deadline should call `os::run_bounded` directly. A second `run_bounded` in
// this capsule would be an ambiguity at every call site importing both.
//
// What ships here is the test-structure half. `with_background` is the scoped
// fixture for a blocking server: it kills and reaps on scope exit including the
// throwing path, so a failing assertion can no longer orphan one — a guarantee
// `sfn/os`'s spawn/kill/drain primitives do not themselves provide.
// `wait_until` polls a readiness probe against a wall-clock budget using the
// prelude's in-process `sleep`. `stop_background` returns `os::ProcessDrain`;
// import that type from `sfn/os` when a call site needs to name it. See
// `process_control.sfn`.
export {
    Background,
    describe_outcome,
    start_background,
    stop_background,
    wait_until,
    with_background
} from "./process_control";

// The shared Sailfin-native child used by managed-process tests. The helper
// builds it in runner-owned scratch and returns an absolute `.exe`-aware path.
export { process_fixture_bin } from "./process_fixture";
