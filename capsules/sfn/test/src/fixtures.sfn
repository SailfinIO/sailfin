// sfn/test — Scoped test fixtures (issue #979; SFEP-0010 §3.2).
//
// A scoped fixture sets up a resource, runs a body closure, and tears the
// resource down on scope exit — including when the body throws. The body
// is an ordinary closure that may capture the enclosing test's locals
// (M1.5 closures-with-capture, #687 emission + #689 dispatch).
//
// Three scoped fixtures ship here, all built on per-child control so they
// are safe under the (future) parallel test runner:
//
//   * `with_tmp_dir` — create a temp dir, run the body, remove the tree on
//     scope exit (including the throwing path).
//   * `with_env` (#1166) — run a subprocess under a scoped `os::Env`.
//   * `with_cwd` (#1168) — run a subprocess in a scoped working directory.
//
// The originally-proposed `with_env` / `with_cwd` fixtures were going to
// mutate *process-global* state (`setenv(3)` / `chdir(2)`) and restore it.
// Both are unsound under structured concurrency: `chdir(2)` sets a
// per-*process* cwd and `setenv(3)` mutates a shared, non-thread-safe
// `environ`, so a process-global fixture corrupts sibling tasks the moment
// the runner goes parallel. The shipped shape is per-child instead: the
// scoped environment / cwd is applied to a *single* spawned child via
// `os::run_capture(args, env, cwd)` (#1167), and the parent process is never
// read or written. See each helper's doc comment below.
//
// Teardown delegates to `sfn/fs::remove_all` (#976) — a pure-Sailfin
// `rm -rf` composed from the `fs.*` runtime intrinsics
// (`deleteFile` / `exists` / `listDirectory` / `removeDirectory`). No new
// C runtime surface is introduced.
import { remove_all } from "sfn/fs";
import { Env, ProcessOutput, run_capture } from "sfn/os";
import { find, replace, to_lower } from "sfn/strings";

// Create a fresh temporary directory, hand its absolute path to `body`,
// and recursively remove the whole tree on scope exit — on both the
// normal-return and the throwing path. Returns whatever `body` returns.
//
// `body` may be a capturing lambda; it closes over the enclosing test's
// locals. The parameter is typed `fn(string) -> int` (no `![io]` row):
// the effect checker attributes a lambda body's effects to the scope that
// *defines* the lambda, so an `![io]` test that builds the closure already
// accounts for any io inside it — the fn-type itself carries no effect row.
// (`-> int` is the interim return shape shared with the `expect_to_throw`
// thunks; a body that produces nothing returns `0`. A generic result type
// waits on generics.)
//
// The directory is created with `fs.mkdtemp("sfn-test-")`, so it is unique
// per call and lives under `$TMPDIR` (or `/tmp`). On the error path the
// directory is removed first, then the original error is re-thrown so the
// failing test still fails with its own message.
//
// `fs.mkdtemp` returns an empty string on failure; we refuse to proceed in
// that case rather than hand `body` an empty path (which would resolve
// relative to the cwd) and then remove it. Fail loud instead.
fn with_tmp_dir(body: fn (string) -> int) -> int ![io] {
    let dir = fs.mkdtemp("sfn-test-");
    if dir.length == 0 {
        throw "with_tmp_dir: mkdtemp failed to create a temporary directory";
    }
    try {
        let result = body(dir);
        let _ = remove_all(dir);
        return result;
    } catch (e) {
        let _ = remove_all(dir);
        throw e;
    }
}

// Run `args` as a subprocess under the scoped environment `env`, hand the
// captured `ProcessOutput` to `body`, and return whatever `body` returns.
//
// This is the concurrency-safe successor to the dropped process-global
// `with_env` / `with_cwd` fixtures (see the note at the top of this file
// for why those were rejected). Rather than mutating the shared, non
// thread-safe `environ` with `setenv(3)` — which corrupts sibling tasks
// the moment the test runner goes parallel — the scoped environment is
// applied to a *single* child via `os::run_capture(args, env)`. The
// parent process environment is never read or written, so the scoping is
// confined to that one child and concurrent tests are unaffected.
//
// Build `env` with the typed `os::Env` constructors:
//
//   * `env_empty()` — a child with NO environment at all (an empty `Env`
//     means "empty", not "inherit").
//   * `env_from_current()` — a snapshot of the parent's environment to
//     inherit from; layer overrides on top with `env_set(e, name, value)`.
//
// `body` is an ordinary closure that may capture the enclosing test's
// locals (single capture; see `fixtures_test.sfn`). It is typed
// `fn(ProcessOutput) -> int` with no `![io]` row, for the same reason
// `with_tmp_dir`'s body is: the effect checker attributes a lambda body's
// effects to the scope that *defines* the lambda, so an `![io]` test that
// builds the closure already accounts for any io inside it — the fn-type
// itself carries no effect row. (`-> int` is the interim return shape
// shared with `with_tmp_dir`; a generic result type waits on generics.)
//
// Unlike `with_tmp_dir` there is no teardown step: a scoped child env owns
// no host resource to release — the override lived only in the child's
// `environ`, which dies with the child.
fn with_env(args: string[], env: Env, body: fn (ProcessOutput) -> int) -> int ![io] {
    // `""` cwd inherits the parent's working directory (#1167); a
    // cwd-aware `with_env`/`with_cwd` ergonomic wrapper is the
    // companion follow-up, not this change.
    let out = run_capture(args, env, "");
    return body(out);
}

// Run `args` as a subprocess in the working directory `cwd` under the
// scoped environment `env`, hand the captured `ProcessOutput` to `body`,
// and return whatever `body` returns.
//
// This is the cwd-scoping companion to `with_env`: the concurrency-safe
// successor to the dropped process-global `with_cwd` fixture (see the note
// at the top of this file). Rather than calling `chdir(2)` — which sets a
// per-*process* working directory and so corrupts sibling tasks the moment
// the test runner goes parallel — the directory is applied to a *single*
// child via `os::run_capture(args, env, cwd)` (#1167), which runs the child
// in `cwd` with `posix_spawn_file_actions_addchdir_np` and never touches the
// parent's cwd. Concurrent tests are unaffected.
//
// `cwd` is typically the absolute path handed to a `with_tmp_dir` body, so
// the two compose: open a temp dir, then run a child inside it. An empty
// `cwd` inherits the parent's working directory (identical to `with_env`);
// pass a non-empty absolute path to scope it. In-process (non-subprocess)
// cwd scoping is not offered — there is no per-thread cwd, so in-process
// tests must use absolute paths.
//
// `body`, the `Env` constructors, the no-`![io]`-row fn-type, and the
// `-> int` interim return shape are all exactly as documented for `with_env`
// above. Like `with_env`, there is no teardown: a scoped cwd owns no host
// resource — it is just an argument to the child spawn.
fn with_cwd(args: string[], env: Env, cwd: string, body: fn (ProcessOutput) -> int) -> int ![io] {
    let out = run_capture(args, env, cwd);
    return body(out);
}

// ---------------------------------------------------------------------------
// Clean environment for a nested `sfn test` (SFN-401)
// ---------------------------------------------------------------------------
// An e2e test that spawns a NESTED `sfn test` (or `sfn build` / `sfn run`) as
// a subprocess must hand it a clean TOP-LEVEL environment: it inherits the
// ambient environment (PATH/HOME/TMPDIR + toolchain vars its clang/linker
// need) but NONE of the per-child orchestration keys the *parent* pool set on
// us. Inheriting those binds the nested run to the parent's private state and
// breaks it in pool-only, platform-flaky ways that evade local serial runs —
// three separate symptoms bit one e2e in SFN-17 / PR #2411: the nested runner
// adopts the parent's `SAILFIN_TEST_SCRATCH` and clobbers its harness-IPC
// files, emits as a JSON subframe under `SAILFIN_TEST_JSON_SUBFRAME` (routing
// its `summary` off stdout), and binds the nested build to the parent's shared
// runtime object cache + stamp nonce via `SAILFIN_TEST_RUNTIME_OBJDIR` /
// `SAILFIN_TEST_RUNTIME_STAMP`.
// The per-child environment keys the parallel test pool injects on every
// spawned test process. This list MUST mirror the set stripped and re-added by
// `_pool_child_env` in `compiler/src/cli/commands/test/pool.sfn` — a capsule
// cannot import compiler-internal modules, so this is a deliberate paired
// copy. When a new pool key is added to `_pool_child_env`, add it here too
// so a nested runner keeps inheriting a clean environment.
fn _pool_managed_keys() -> string[] {
    return ["SAILFIN_TEST_SCRATCH", "SAILFIN_TEST_RUNTIME_OBJDIR", "SAILFIN_TEST_RUNTIME_STAMP", "SAILFIN_UPDATE_SNAPSHOTS", "SAILFIN_TEST_JSON_SUBFRAME", "SAILFIN_TEST_FRAME_TIMING",];
}

// Caller-override keys a nested runner must receive only from the caller's
// explicit push, never from the outer process's own environment (SFN-925).
// Unlike `_pool_managed_keys`, these are not pool-injected orchestration
// state — they are host/target overrides (SFN-617's Windows-host seam) that
// a caller sets deliberately. Kept as a separate list rather than folded into
// `_pool_managed_keys` because that function's contract is pinned to mirror
// `_pool_child_env` in `compiler/src/cli/commands/test/pool.sfn` (see the
// comment above it); these keys are never pool-injected, so they don't belong
// in that mirror.
fn _caller_override_keys() -> string[] {
    return ["SAILFIN_TARGET_OS", "SAILFIN_HOST_OS"];
}

// True when `entry` ("KEY=VALUE") carries one of `keys`. Matched by exact
// `KEY=` prefix so a value that merely contains the substring is unaffected.
fn _matches_any_key(entry: string, keys: string[]) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= keys.length { break; }
        if find(entry, keys[i] + "=", 0) == 0 { return true; }
        i += 1;
    }
    return false;
}

// True when `entry` carries one of the pool-managed keys.
fn _is_pool_managed(entry: string) -> boolean {
    return _matches_any_key(entry, _pool_managed_keys());
}

// True when `entry` carries one of the caller-override keys.
fn _is_caller_override(entry: string) -> boolean {
    return _matches_any_key(entry, _caller_override_keys());
}

// Mint an isolated per-invocation scratch path for a nested runner. When the
// outer pool set our own `SAILFIN_TEST_SCRATCH`, the nested scratch is a subdir
// of it — it stays under the runner-managed tree and is unique per test file
// (the pool's scratch is per-file), and stays warm across a file's sequential
// nested runs. Otherwise (a standalone run with no runner) a fresh temp dir is
// minted. `label` distinguishes multiple nested spawns within one test file;
// pass a stable, file-specific name (e.g. `"lifecycle-hook"`).
fn nested_runner_scratch(label: string) -> string ![io] {
    let outer = env.get("SAILFIN_TEST_SCRATCH");
    if outer.length > 0 { return outer + "/" + label; }
    return fs.mkdtemp("sfn-nested-runner-");
}

// True when the test process is running on a Windows host (SFN-1114).
//
// For a test whose EXPECTED VALUE differs by host — the errno accessor the
// emitter picks, the link flags a C harness needs — as opposed to one that
// merely needs a platform-shaped input, which belongs in a `SAILFIN_TARGET_OS`
// override instead. Reach for the override first: a forced target asserts the
// same thing on every runner, while this predicate makes an assertion that
// only one platform ever evaluates.
//
// Mirrors `build_host_os`'s Windows rungs rather than importing them: a capsule
// cannot import compiler-internal modules, so this is a deliberate paired copy,
// the same arrangement `_pool_managed_keys` documents above. `NUL` backstops
// the environment variable for the reason SFN-1114 exists — a child spawned
// with a curated envp need not carry `SystemRoot`, and test helpers run inside
// exactly such children. Deliberately has no POSIX-vs-Darwin split: no caller
// has needed one, and a three-way answer invites a two-way `if` that silently
// files Darwin under Linux.
fn host_is_windows() -> boolean ![io] {
    if env.get("SystemRoot").length > 0 { return true; }
    return fs.exists("NUL");
}

// Translate a host-native path into the spelling expected by Bash-backed
// fixtures. Git Bash consumes MSYS drive paths (`/c/work/...`), while the
// native test runner and its filesystem/process APIs produce Win32 paths
// (`C:\\work\\...`). Keep this bridge explicit at each shell boundary: a
// native child cwd still needs the Win32 spelling, and POSIX hosts need no
// translation at all.
//
// This deliberately does not invoke `bash` or `cygpath`. Shell-provider
// selection is a separate fixture concern, and launching the wrong `bash`
// (notably the Windows WSL app alias) merely to translate an argv path would
// make the bridge circular. Drive-rooted paths are the form emitted by the
// Windows runner; relative paths are separator-normalized and remain relative.
fn bash_path(path: string) -> string ![io] {
    if !host_is_windows() { return path; }
    let normalized = replace(path, "\\", "/");
    if normalized.length >= 3 && normalized[1] == ":" && normalized[2] == "/" {
        return "/" + to_lower(normalized[0]) + substring(normalized, 2, normalized.length);
    }
    return normalized;
}

// The Bash executable for fixtures that intentionally validate repository
// shell scripts. Native Windows exposes a WSL `bash.exe` application alias,
// so PATH lookup cannot distinguish the MSYS provider that consumes the
// `/c/...` paths `bash_path` emits. Resolve the two Git for Windows install
// roots explicitly and fail closed with `""` when neither exists. POSIX
// keeps the historical bare-name lookup and its byte-identical contract.
fn git_bash_path() -> string ![io] {
    if !host_is_windows() { return "bash"; }
    let program_files = env.get("ProgramFiles");
    if program_files.length > 0 {
        let system = program_files + "\\Git\\bin\\bash.exe";
        if fs.exists(system) { return system; }
    }
    let local_app_data = env.get("LOCALAPPDATA");
    if local_app_data.length > 0 {
        let user = local_app_data + "\\Programs\\Git\\bin\\bash.exe";
        if fs.exists(user) { return user; }
    }
    return "";
}

// Build a clean top-level child environment for spawning a nested `sfn test`
// (or `sfn build` / `sfn run`) subprocess. Returns `process.environ()` with
// every pool-managed key (see `_pool_managed_keys`) and every caller-override
// key (see `_caller_override_keys`) stripped, and `SAILFIN_TEST_SCRATCH`
// re-pointed at `nested_scratch` — an isolated dir the caller owns, typically
// from `nested_runner_scratch(...)`. Pass an empty `nested_scratch` to strip
// the pool keys without re-adding a scratch. Callers that deliberately want an
// otherwise-managed key (e.g. a nested build binding its own
// `SAILFIN_TEST_RUNTIME_OBJDIR`, or a test threading its own trace flag) push
// it onto the returned array.
//
// `SAILFIN_TARGET_OS` / `SAILFIN_HOST_OS` are always stripped, even though
// they are not pool-managed, so a caller's push is the ONLY occurrence in the
// child's envp (SFN-925). `_process_build_cstr_argv`
// (`runtime/sfn/process.sfn`) emits every entry verbatim, and `env.get`
// resolves via libc `getenv()`, which returns the first match — so leaving
// the outer process's own value in place would silently defeat a caller's
// push with a duplicate-keyed envp. The deliberate consequence: a nested
// child no longer inherits the outer target/host unless the caller passes it
// explicitly. That is the intended contract — an inherited target was never
// reliable, only accidentally right when it happened to agree with the one
// the caller wanted.
//
// Use with the raw `process.run_capture(argv, env)` builtin the e2e tests
// call.
fn clean_runner_env(nested_scratch: string) -> string[] ![io] {
    let none: string[] = [];
    return clean_runner_env_without(nested_scratch, none);
}

// `clean_runner_env` plus a caller-supplied strip list, for a test that pushes
// its own value for a key the outer environment may also carry (SFN-1114).
//
// This exists because of the first-match rule `clean_runner_env` documents
// above: `env.get` resolves through libc `getenv`, which returns the FIRST
// matching entry, so an inherited `KEY=old` earlier in the array silently
// defeats a caller's later `KEY=new` push. `_caller_override_keys` hard-codes
// the two keys SFN-925 found this way; every other seam a test invents — a
// probe-only toggle, a fixture registry URL, a forced HOME — has the same
// exposure and no fixed list can anticipate it. Naming the keys at the push
// site keeps the strip and the push in one place, where they cannot drift.
//
// Pass the bare key names, no `=`. A key absent from the environment costs a
// scan and nothing else, so over-listing is safe and under-listing is the
// failure — when in doubt, name every key the helper goes on to push.
fn clean_runner_env_without(nested_scratch: string, also_strip: string[]) -> string[] ![io] {
    let all = process.environ();
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= all.length { break; }
        let entry = all[i];
        if !_is_pool_managed(entry) && !_is_caller_override(entry) && !_matches_any_key(entry, also_strip) {
            out.push(entry);
        }
        i += 1;
    }
    if nested_scratch.length > 0 {
        out.push("SAILFIN_TEST_SCRATCH=" + nested_scratch);
    }
    return out;
}
