// Tests for `sfn_bin_abs_path` (SFN-995).
//
// Same constraint as `sfn_bin_test.sfn`: the helper reads process env
// (through `sfn_bin_path()`) and the cwd it resolves against, and there is
// no in-process env/cwd mutation in the prelude, so each case writes a tiny
// fixture that prints `sfn_bin_abs_path()`, builds it, then runs the
// compiled binary as a real subprocess under a scoped `os::Env` and cwd via
// `with_cwd`, and asserts on the captured stdout.
//
// The fixture is written under `build/sailfin` (inside the repo tree),
// deliberately NOT honoring `SAILFIN_TEST_SCRATCH`. Stated first-hand
// rather than by citing `sfn_bin_test.sfn`, which makes the OPPOSITE
// choice: that sibling honors the override and its comment justifies only
// its in-tree *fallback*. The reason here is resolution, not scratch
// hygiene — a fixture inside the tree resolves
// `import { ... } from "sfn/test"` against the `capsule.toml` found by
// walking up from the source file, so it always sees the working tree's
// own copy of this capsule. A fixture under an out-of-tree scratch dir has
// no manifest above it and falls back to whatever stdlib copy the compiler
// under test carries bundled, which for a newly added export is not
// necessarily this one.
//
// `_abs_path` then absolutizes the directory so the built binary is a
// valid `args[0]` under a DIFFERENT `with_cwd` cwd too.
import { ProcessOutput, env_from_current, env_set } from "sfn/os";
import { trim } from "sfn/strings";

import { sfn_bin_path, with_cwd } from "../src/mod";

// Unlike `sfn_bin_test.sfn`'s `_scratch_dir`, this does not honor
// `SAILFIN_TEST_SCRATCH` — see the file header for why the fixture must
// stay inside the repo tree regardless of the ambient scratch override.
fn _scratch_dir() -> string ![io] {
    let dir = "build/sailfin";
    fs.createDirectory(dir, true);
    return dir;
}

// `realpath(path, resolved)` with `resolved = null` has libc allocate the
// resolved buffer. Declared directly rather than imported: a capsule test
// cannot reach into `compiler/src` (capsule-boundary rule), and this
// mirrors `sfn_bin.sfn`'s own inline declaration, needed there for the same
// SFN-635 no-cross-module-extern reason.
extern fn realpath(path: *u8, resolved: *u8) -> *u8;

// The test process's own cwd, needed here (and only here, for test setup)
// to predict what a child that inherits it will resolve `.` to, and to
// absolutize `_scratch_dir()` when it falls back to the relative literal.
// Not a stand-in for `sfn_bin_abs_path` under test — that function is
// exercised exclusively through the compiled fixture below.
//
// `realpath(".", null)` rather than a `pwd` shellout (SFN-995): a Git-Bash
// `pwd` prints the POSIX-mount spelling (`/c/Users/...`) on a native
// Windows host, a path style `_cwd()` under test (`sfn_bin.sfn:101-107`)
// never produces — its own `realpath`-based resolution returns a
// Win32-native path — so the two would never compare equal here regardless
// of which case is being asserted. Mirrors `_cwd()`'s exact body so the
// value computed for the assertion is produced by the same primitive as
// the code under test, `PWD`-fallback included.
fn _repo_root() -> string ![io] {
    let resolved: *u8 = realpath("." as *u8, null);
    if resolved as i64 != 0 { return resolved as string; }
    let pwd = env.get("PWD");
    if pwd.length > 0 { return pwd; }
    return ".";
}

// `_scratch_dir()` always returns the relative in-tree literal, so this is
// unconditional. Deliberately carries no `path[0] == "/"` branch: that is
// the POSIX-only check `sfn_bin_abs_path` exists to retire, and a dead copy
// of it here would be the first step of exactly the regrowth SFN-977 saw.
fn _abs_path(path: string) -> string ![io] {
    return _repo_root() + "/" + path;
}

// A fresh marker-file path for `tag`, used to ferry the child's stdout out
// of the `with_cwd` body closure — the closure returns `int`, not a string
// (same idiom `sfn_bin_test.sfn` uses).
fn _marker(tag: string) -> string ![io] {
    let dir = _scratch_dir();
    let path = dir + "/sfn-bin-abs-marker-" + tag + ".txt";
    if fs.exists(path) { fs.deleteFile(path); }
    return path;
}

// Source for a fixture that prints `sfn_bin_abs_path()` on one line.
fn _fixture_src() -> string {
    return "import { sfn_bin_abs_path } from \"sfn/test\";\n\nfn main() ![io] {\n"
        + "    print(sfn_bin_abs_path());\n"
        + "}\n";
}

// Build the fixture, then run the compiled binary under `host_os` /
// `bin_override` with `run_cwd` as the child's working directory (empty
// inherits the parent's, matching `with_cwd`'s own contract), and return
// the trimmed stdout the child printed.
fn _probe_bin_abs_path(tag: string, host_os: string, bin_override: string, run_cwd: string) -> string ![io] {
    let abs_dir = _abs_path(_scratch_dir());
    let src = abs_dir + "/sfn-bin-abs-probe-" + tag + ".sfn";
    let binpath = abs_dir + "/sfn-bin-abs-probe-" + tag;
    let marker = _marker(tag);
    fs.writeFile(src, _fixture_src());

    // Build under the AMBIENT environment, never the scoped one below —
    // see `sfn_bin_test.sfn` for why the build and run steps use two
    // different environments.
    let build_exit = process.run_capture([sfn_bin_path(), "build", "-o", binpath, src], process.environ());
    let _build_stdout = process.capture_take_stdout();
    let _build_stderr = process.capture_take_stderr();
    assert build_exit == 0;

    let scoped = env_set(env_set(env_from_current(), "SAILFIN_HOST_OS", host_os), "SAILFIN_BIN", bin_override);
    let run_exit = with_cwd([binpath], scoped, run_cwd, fn (out: ProcessOutput) -> int {
        fs.writeFile(marker, out.stdout);
        return out.exit;
    });
    fs.deleteFile(src);
    fs.deleteFile(binpath);
    assert run_exit == 0;
    let result = trim(fs.readFile(marker));
    fs.deleteFile(marker);
    return result;
}

// 1. A POSIX-absolute `SAILFIN_BIN` passes through unchanged — no cwd
//    prefix, even though the child ran with the ambient (inherited) cwd.
test "sfn_bin_abs: an absolute POSIX SAILFIN_BIN passes through unchanged" ![io] {
    let out = _probe_bin_abs_path("posix-abs", "Linux", "/custom/path/to/sfn", "");
    assert out == "/custom/path/to/sfn";
}

// 2. A Windows drive-absolute path with backslashes passes through
//    unchanged — the bug this module fixes: the 15 hand-copied
//    `_sfn_bin_abs()` resolvers checked only `bin[0] == "/"` and would have
//    misclassified this as relative and prefixed it with the POSIX cwd.
test "sfn_bin_abs: a Windows drive-absolute path with backslashes passes through unchanged" ![io] {
    let out = _probe_bin_abs_path("win-backslash", "Linux", "C:\\custom\\path\\sfn.exe", "");
    assert out == "C:\\custom\\path\\sfn.exe";
}

// 3. A Windows drive-absolute path with forward slashes passes through
//    unchanged.
test "sfn_bin_abs: a Windows drive-absolute path with forward slashes passes through unchanged" ![io] {
    let out = _probe_bin_abs_path("win-forwardslash", "Linux", "C:/custom/path/sfn.exe", "");
    assert out == "C:/custom/path/sfn.exe";
}

// 4. A UNC path passes through unchanged.
test "sfn_bin_abs: a UNC path passes through unchanged" ![io] {
    let out = _probe_bin_abs_path("unc", "Linux", "\\\\srv\\share\\sfn.exe", "");
    assert out == "\\\\srv\\share\\sfn.exe";
}

// 5. No `SAILFIN_BIN` override, so `sfn_bin_path()` falls back to the
//    relative POSIX literal `build/bin/sfn`, which gets prefixed with the
//    cwd the child actually ran in — here the inherited cwd, i.e. this test
//    process's own `_repo_root()`.
test "sfn_bin_abs: a relative bin path is prefixed with the cwd it resolves in" ![io] {
    let repo_root = _repo_root();
    let out = _probe_bin_abs_path("relative-cwd", "Linux", "", "");
    assert out == repo_root + "/build/bin/sfn";
}

// 6. `SAILFIN_BIN` set to an absolute Windows path passes through unchanged
//    regardless of which cwd the child actually ran in. Test 2 already
//    covers the passthrough itself under the inherited cwd; this adds only
//    that a shifted cwd does not change it. Test 7 below is the case that
//    actually discriminates between candidate `_cwd()` implementations.
test "sfn_bin_abs: SAILFIN_BIN set to an absolute Windows path passes through unchanged regardless of cwd" ![io] {
    let different_cwd = _abs_path(_scratch_dir());
    let out = _probe_bin_abs_path("win-abs-separate-cwd", "Linux", "C:\\other\\sfn.exe", different_cwd);
    assert out == "C:\\other\\sfn.exe";
}

// 7. The discriminating case: a RELATIVE bin under a SHIFTED cwd.
//
//    This is what pins `_cwd()`'s `realpath(".")`-before-`PWD` order, which
//    `sfn_bin.sfn` calls load-bearing and which nothing else here exercises.
//    Test 5 runs with the inherited cwd, where the parent's `PWD` and
//    `realpath(".")` necessarily agree, so it cannot tell the two apart.
//    Here they diverge: `with_cwd` scopes the child's env from
//    `env_from_current()` (`capsules/sfn/test/src/fixtures.sfn:133-136`),
//    which carries the PARENT's `PWD`, while the child actually runs in
//    `different_cwd`. A `PWD`-first `_cwd()` would answer with the repo
//    root and fail this assertion; a `realpath(".")`-first one answers with
//    the directory the child is really in.
//
//    (`_repo_root()` mirrors `_cwd()`'s `realpath(".")`-first body exactly
//    now, rather than a `pwd` shellout's logical answer, so the two agree
//    even under a symlinked checkout — SFN-995: a Git-Bash `pwd` returns
//    the wrong path STYLE on a native Windows host, a divergence no
//    checkout topology could paper over. This test's discriminating power
//    comes entirely from the SHIFTED cwd `with_cwd` places the child in.)
test "sfn_bin_abs: a relative bin path resolves against the child's real cwd, not the inherited PWD" ![io] {
    let different_cwd = _abs_path(_scratch_dir());
    let out = _probe_bin_abs_path("relative-different-cwd", "Linux", "", different_cwd);
    assert out == different_cwd + "/build/bin/sfn";
}
