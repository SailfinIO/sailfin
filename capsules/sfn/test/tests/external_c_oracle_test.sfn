// capsules/sfn/test/tests/external_c_oracle_test.sfn
//
// Contract coverage for SFN-1107's optional external C test oracle.
import { contains, starts_with } from "sfn/strings";
import { external_c_oracle, skip } from "sfn/test";

fn _flat_env_value(entries: string[], name: string) -> string {
    let prefix = name + "=";
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let entry = entries[i];
        if entry.length >= prefix.length && substring(entry, 0, prefix.length) == prefix {
            return substring(entry, prefix.length, entry.length);
        }
        i += 1;
    }
    return "";
}

test "external C oracle: returns a coherent available or unavailable result" ![io] {
    let oracle = external_c_oracle();
    if oracle.available {
        assert oracle.compiler.length > 0;
        assert oracle.unavailable_reason.length == 0;
    } else {
        assert oracle.unavailable_reason.length > 0;
        assert contains(oracle.unavailable_reason, "optional external C test oracle");
    }
}

test "external C oracle: preserves the complete parent environment" ![io] {
    let oracle = external_c_oracle();
    let parent_path = env.get("PATH");
    if parent_path.length > 0 {
        assert _flat_env_value(oracle.environment, "PATH") == parent_path;
    }
    let parent_home = env.get("HOME");
    if parent_home.length > 0 {
        assert _flat_env_value(oracle.environment, "HOME") == parent_home;
    }
}

test "Darwin external C oracle: uses Apple discovery and carries SDKROOT" ![io] {
    if !fs.exists("/System/Library/CoreServices") {
        skip("Darwin-only Apple toolchain contract");
    }
    if env.get("SAILFIN_TEST_C_COMPILER").length > 0 {
        skip("explicit SAILFIN_TEST_C_COMPILER overrides Apple discovery");
    }
    let oracle = external_c_oracle();
    if !oracle.available { skip(oracle.unavailable_reason); }
    assert starts_with(oracle.compiler, "/");
    assert _flat_env_value(oracle.environment, "SDKROOT").length > 0;
}
