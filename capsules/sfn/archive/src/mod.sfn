// sfn/archive — in-process `.tar.gz` reading and writing.
//
// Retires the external `tar` binary from the Sailfin toolchain. A stock Windows
// host ships no `tar`, so `sfn toolchain install` could not unpack a seed there
// at all; that is the bootstrap gap this capsule closes (SFN-753 → SFN-493).
//
// Design: `docs/proposals/0071-archive-targz.md` (SFEP-0071).
//
// Layering, innermost first — each layer depends only on those above it, so a
// future `.zip` container reuses `crc32` and `deflate` unchanged:
//
//   bytes    — the libc-backed byte buffer
//   error    — `ArchiveError`, the capsule's single failure type
//   crc32    — RFC 1952 checksum
//   gzip     — RFC 1952 container framing
//   inflate  — RFC 1951 decompression          (SFN-896)
//   deflate  — RFC 1951 compression            (SFN-897)
//   ustar    — POSIX.1-1988 header format      (SFN-898 read / SFN-899 write)
//   tar_read — the extractor and its path guard (SFN-898)
export { ArchiveError, ArchiveErrorKind } from "./error";

// RFC 1952 §8 CRC-32 — one-shot plus the incremental update the gzip reader
// needs to checksum a decompressed stream in chunks (SFEP-0071 §3.4).
// `ByteBuf`/`ByteCursor` stay capsule-internal (SFEP-0071 §3.3) — no caller
// outside this capsule constructs one.
export {
    crc32,
    crc32_init,
    crc32_update,
    crc32_finish
} from "./crc32";

export { GzipHeader, GzipHeaderResult, gzip_parse_header } from "./gzip";

// RFC 1951 decompression — stored, fixed-Huffman, and dynamic-Huffman
// blocks. Pure, like `crc32`/`gzip_parse_header` above (SFEP-0071 §3.4).
export { inflate_all } from "./inflate";
