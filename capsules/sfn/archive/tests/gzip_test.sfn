// capsules/sfn/archive/tests/gzip_test.sfn
//
// RFC 1952 §2.3 header framing (SFEP-0071 §8.1): the FLG
// matrix with each optional field present alone and in combination, plus
// the two hard-error cases a reader must reject before ever touching a
// deflate decoder — bad magic and an unsupported compression method.
//
// The write-side tests below (SFN-897) exist because nothing else in this
// capsule ever validates a gzip *trailer*: `gzip_parse_header` stops once it
// finds the deflate stream's start, and `inflate_all` stops at BFINAL and
// never looks at the bytes after it. A byte-order slip in CRC-32 or ISIZE is
// therefore invisible to every test that only round-trips through our own
// reader — it would surface only under `gzip -t`, GNU tar, or Python
// `tarfile`, on a user's machine, holding a release artifact. So the header
// bytes are pinned literally and the trailer is checked against an
// independently computed CRC-32/ISIZE, never against whatever the writer
// itself produced.
import {
    ByteBuf,
    ByteCursor,
    bytes_cursor,
    bytes_free,
    bytes_from_int_array,
    bytes_get,
    bytes_len
} from "../src/bytes";
import { crc32 } from "../src/crc32";
import { DeflateOptions, DeflateStrategy } from "../src/deflate";
import { ArchiveError, ArchiveErrorKind } from "../src/error";
import {
    GzipHeader,
    GzipHeaderResult,
    gzip_parse_header,
    gzip_write_all
} from "../src/gzip";
import { inflate_all } from "../src/inflate";

let _FLG_FHCRC: int = 2;
let _FLG_FEXTRA: int = 4;
let _FLG_FNAME: int = 8;
let _FLG_FCOMMENT: int = 16;

// "a.txt\0" — an arbitrary short FNAME payload, including its terminator.
fn _fname_bytes() -> int[] {
    return [97, 46, 116, 120, 116, 0,];
}

// "hi\0" — an arbitrary short FCOMMENT payload, including its terminator.
fn _fcomment_bytes() -> int[] {
    return [104, 105, 0,];
}

fn _push_all(dst: int[], src: int[]) -> void {
    let mut i: int = 0;
    loop {
        if i >= src.length { break; }
        dst.push(src[i]);
        i += 1;
    }
}

// Trailing bytes standing in for "the deflate stream" — this phase never
// inflates them, so any fixed marker works. Parsing must leave `body`
// pointing exactly at the first one (222 == 0xDE).
fn _body_marker() -> int[] {
    return [222, 173, 190, 239,];
}

// The fixed 10-byte RFC 1952 header: magic (0x1f, 0x8b), CM = 8 (deflate),
// FLG, a zero MTIME (unexamined by this phase), XFL = 0, OS = 255
// (unknown). `sfn fmt` does not round-trip a per-element trailing comment
// inside a multi-line array literal cleanly, so the field meanings are
// documented here instead of inline on the array below.
fn _fixed_header(flg: int) -> int[] {
    return [31, 139, 8, flg, 0, 0, 0, 0, 0, 255,];
}

// Assemble a full RFC 1952 header: the fixed 10 bytes, then FEXTRA, FNAME,
// FCOMMENT, FHCRC in that order (only the ones set in `flg`), then the
// body marker.
fn _gzip_stream(flg: int) -> int[] {
    let mut out: int[] = _fixed_header(flg);
    if (flg & _FLG_FEXTRA) != 0 {
        // XLEN = 3, then 3 arbitrary extra-field bytes.
        _push_all(out, [3, 0, 9, 9, 9,]);
    }
    if (flg & _FLG_FNAME) != 0 { _push_all(out, _fname_bytes()); }
    if (flg & _FLG_FCOMMENT) != 0 { _push_all(out, _fcomment_bytes()); }
    if (flg & _FLG_FHCRC) != 0 {
        _push_all(out, [1, 2,]);
    }
    _push_all(out, _body_marker());
    return out;
}

// A zeroed placeholder, returned only from the "should be unreachable"
// branches below — `assert false` fails the test before a caller could
// ever observe this value.
fn _dummy_result() -> GzipHeaderResult {
    return GzipHeaderResult {
        header: GzipHeader {
            mtime: 0,
            xfl: 0,
            os: 0,
            fname: "",
            fcomment: "",
            has_extra: false,
            has_crc16: false
        },
        body: ByteCursor { addr: 0, len: 0, pos: 0 }
    };
}

// A parsed header plus the still-live `ByteBuf` it was parsed from. Freeing
// is left to the caller (see `_assert_parses` below) so `result.body.addr`
// stays valid for the whole assertion block instead of dangling before the
// caller ever reads it.
struct _ParsedGzip {
    result: GzipHeaderResult;
    buf: ByteBuf;
}

// Parse `arr` and hand the successful result — plus the backing buffer it
// points into — to the caller. The caller reads `result`, then frees `buf`
// itself once done. Asserts failure (rather than returning it) on a parse
// error, since every caller here expects success.
fn _assert_parses(arr: int[]) -> _ParsedGzip {
    let parsed_buf = bytes_from_int_array(arr);
    match parsed_buf {
        Result.Ok { value }
        : {
            let owned_buf: ByteBuf = value;
            let parsed = gzip_parse_header(bytes_cursor(owned_buf));
            match parsed {
                Result.Ok { value }
                : return _ParsedGzip { result: value, buf: owned_buf },
                Result.Err { error }
                : {
                    assert false;
                    return _ParsedGzip {
                        result: _dummy_result(),
                        buf: owned_buf
                    };
                }
            }
        },
        Result.Err { error }
        : {
            assert false;
            return _ParsedGzip {
                result: _dummy_result(),
                buf: ByteBuf { addr: 0, len: 0, cap: 0 }
            };
        }
    }
}

test "archive gzip: minimal header (no optional fields)" {
    let parsed = _assert_parses(_gzip_stream(0));
    let result = parsed.result;
    assert result.header.fname == "";
    assert result.header.fcomment == "";
    assert result.header.has_extra == false;
    assert result.header.has_crc16 == false;
    assert result.body.pos == 10;
    bytes_free(parsed.buf);
}

test "archive gzip: FNAME alone" {
    let parsed = _assert_parses(_gzip_stream(_FLG_FNAME));
    let result = parsed.result;
    assert result.header.fname == "a.txt";
    assert result.header.fcomment == "";
    assert result.body.pos == 10 + _fname_bytes().length;
    bytes_free(parsed.buf);
}

test "archive gzip: FCOMMENT alone" {
    let parsed = _assert_parses(_gzip_stream(_FLG_FCOMMENT));
    let result = parsed.result;
    assert result.header.fname == "";
    assert result.header.fcomment == "hi";
    assert result.body.pos == 10 + _fcomment_bytes().length;
    bytes_free(parsed.buf);
}

test "archive gzip: FEXTRA alone" {
    let parsed = _assert_parses(_gzip_stream(_FLG_FEXTRA));
    let result = parsed.result;
    assert result.header.has_extra == true;
    // 10 (fixed header) + 2 (XLEN) + 3 (extra field bytes).
    assert result.body.pos == 15;
    bytes_free(parsed.buf);
}

test "archive gzip: FHCRC alone" {
    let parsed = _assert_parses(_gzip_stream(_FLG_FHCRC));
    let result = parsed.result;
    assert result.header.has_crc16 == true;
    assert result.body.pos == 12;
    bytes_free(parsed.buf);
}

test "archive gzip: FEXTRA + FNAME + FCOMMENT + FHCRC combined" {
    let flg = _FLG_FEXTRA | _FLG_FNAME | _FLG_FCOMMENT | _FLG_FHCRC;
    let parsed = _assert_parses(_gzip_stream(flg));
    let result = parsed.result;
    assert result.header.has_extra == true;
    assert result.header.fname == "a.txt";
    assert result.header.fcomment == "hi";
    assert result.header.has_crc16 == true;
    let expected = 10 + 5 + _fname_bytes().length + _fcomment_bytes().length + 2;
    assert result.body.pos == expected;
    bytes_free(parsed.buf);
}

test "archive gzip: bad magic is rejected" {
    let mut arr = _gzip_stream(0);
    arr[0] = 0;
    let buf = bytes_from_int_array(arr);
    match buf {
        Result.Ok { value }
        : {
            let parsed = gzip_parse_header(bytes_cursor(value));
            bytes_free(value);
            match parsed {
                Result.Ok { value }
                : {
                    assert false;
                },
                Result.Err { error }
                : {
                    assert error.kind == ArchiveErrorKind.BadMagic;
                }
            }
        },
        Result.Err { error }
        : {
            assert false;
        }
    }
}

test "archive gzip: a non-deflate compression method is rejected" {
    let mut arr = _gzip_stream(0);
    arr[2] = 9;  // anything other than 8 (deflate)
    let buf = bytes_from_int_array(arr);
    match buf {
        Result.Ok { value }
        : {
            let parsed = gzip_parse_header(bytes_cursor(value));
            bytes_free(value);
            match parsed {
                Result.Ok { value }
                : {
                    assert false;
                },
                Result.Err { error }
                : {
                    assert error.kind == ArchiveErrorKind.UnsupportedFeature;
                }
            }
        },
        Result.Err { error }
        : {
            assert false;
        }
    }
}

test "archive gzip: a reserved FLG bit is rejected" {
    let mut arr = _gzip_stream(0);
    arr[3] = 32;  // FLG bit 5 (reserved; RFC 1952 §2.3.1.2)
    let buf = bytes_from_int_array(arr);
    match buf {
        Result.Ok { value }
        : {
            let parsed = gzip_parse_header(bytes_cursor(value));
            bytes_free(value);
            match parsed {
                Result.Ok { value }
                : {
                    assert false;
                },
                Result.Err { error }
                : {
                    assert error.kind == ArchiveErrorKind.UnsupportedFeature;
                }
            }
        },
        Result.Err { error }
        : {
            assert false;
        }
    }
}

test "archive gzip: a header truncated before FNAME's terminator errors rather than reading past the buffer" {
    let full = _gzip_stream(_FLG_FNAME);
    // Cut the stream inside the FNAME field, well before its NUL and well
    // before the body marker that would otherwise mask an over-read.
    let cut: int[] = [full[0], full[1], full[2], full[3], full[4], full[5], full[6], full[7], full[8], full[9], full[10],];
    let buf = bytes_from_int_array(cut);
    match buf {
        Result.Ok { value }
        : {
            let parsed = gzip_parse_header(bytes_cursor(value));
            bytes_free(value);
            match parsed {
                Result.Ok { value }
                : {
                    assert false;
                },
                Result.Err { error }
                : {
                    assert error.kind == ArchiveErrorKind.Truncated;
                }
            }
        },
        Result.Err { error }
        : {
            assert false;
        }
    }
}

// ---------------------------------------------------------------------
// Writing (SFN-897): see the file header for why the header bytes are
// pinned literally and the trailer is checked independently of the writer.
fn _gen_payload(n: int) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= n { break; }
        out.push((i * 7 + 3) % 256);
        i += 1;
    }
    return out;
}

fn _assert_get(buf: ByteBuf, idx: int) -> int {
    let got = bytes_get(buf, idx);
    match got {
        Result.Ok { value }
        : return value,
        Result.Err { error }
        : {
            assert false;
            return 0;
        }
    }
}

// The owned input buffer plus the `gzip_write_all` output built from it —
// both stay live so a test can read the trailer bytes AND independently
// recompute CRC-32/ISIZE from the same input. The caller frees both.
struct _WrittenGzip {
    input: ByteBuf;
    output: ByteBuf;
}

fn _assert_gzip_write(data: int[]) -> _WrittenGzip {
    let src_buf = bytes_from_int_array(data);
    match src_buf {
        Result.Ok { value }
        : {
            let owned: ByteBuf = value;
            let cursor: ByteCursor = bytes_cursor(owned);
            let opts = DeflateOptions { strategy: DeflateStrategy.Fixed };
            let written = gzip_write_all(cursor, opts);
            match written {
                Result.Ok { value }
                : {
                    return _WrittenGzip { input: owned, output: value };
                },
                Result.Err { error }
                : {
                    assert false;
                    return _WrittenGzip { input: owned, output: owned };
                }
            }
        },
        Result.Err { error }
        : {
            assert false;
            return _WrittenGzip {
                input: ByteBuf { addr: 0, len: 0, cap: 0 },
                output: ByteBuf { addr: 0, len: 0, cap: 0 }
            };
        }
    }
}

// RFC 1952 §2.3: magic (0x1f, 0x8b), CM=8 (deflate), FLG=0 (no optional
// fields), then the SFEP-0071 §3.7 reproducibility pins — MTIME=0 (4
// zero bytes), XFL=0, OS=255 (unknown) — checked byte-for-byte, not just
// "parses" (`gzip_parse_header` alone cannot tell a wrong OS byte from a
// right one; only a literal pin can).
test "archive gzip: gzip_write_all pins the fixed 10-byte header literally" {
    let data: int[] = _gen_payload(300);
    let w = _assert_gzip_write(data);
    let expected_header: int[] = [31, 139, 8, 0, 0, 0, 0, 0, 0, 255,];
    assert bytes_len(w.output) >= 10;
    let mut i: int = 0;
    loop {
        if i >= 10 { break; }
        assert _assert_get(w.output, i) == expected_header[i];
        i += 1;
    }
    bytes_free(w.output);
    bytes_free(w.input);
}

// The end-to-end claim this capsule exists to make: a member written by
// `gzip_write_all` is a valid gzip stream our own reader accepts, and it
// decompresses back to the exact input bytes.
test "archive gzip: gzip_write_all round-trips through gzip_parse_header and inflate_all" {
    let data: int[] = _gen_payload(5000);
    let w = _assert_gzip_write(data);
    let parsed = gzip_parse_header(bytes_cursor(w.output));
    match parsed {
        Result.Ok { value }
        : {
            let decompressed = inflate_all(value.body, data.length + 1024);
            match decompressed {
                Result.Ok { value }
                : {
                    assert bytes_len(value) == data.length;
                    let mut i: int = 0;
                    let mut all_match: boolean = true;
                    loop {
                        if i >= data.length { break; }
                        if _assert_get(value, i) != data[i] {
                            all_match = false;
                        }
                        i += 1;
                    }
                    assert all_match;
                    bytes_free(value);
                },
                Result.Err { error }
                : {
                    assert false;
                }
            }
        },
        Result.Err { error }
        : {
            assert false;
        }
    }
    bytes_free(w.output);
    bytes_free(w.input);
}

// The trailer, checked against values computed independently of
// `gzip_write_all` itself — a byte-order slip in either field would pass
// every other test in this suite (neither `gzip_parse_header` nor
// `inflate_all` ever look at the trailer) and surface only under a real
// gzip reader, on a release artifact. 70000 bytes spans two deflate blocks
// (SFEP-0071 §3.9's 65535-byte chunking), so ISIZE also covers the
// multi-block case.
test "archive gzip: gzip_write_all trailer matches an independently computed CRC-32 and ISIZE" {
    let data: int[] = _gen_payload(70000);
    let w = _assert_gzip_write(data);
    let expected_crc: int = crc32(bytes_cursor(w.input));
    let expected_isize: int = data.length & 4294967295;
    let n: int = bytes_len(w.output);
    let got_crc: int = _assert_get(w.output, n - 8) | (_assert_get(w.output, n - 7) << 8) | (_assert_get(w.output, n - 6) << 16) | (_assert_get(w.output, n - 5) << 24);
    let got_isize: int = _assert_get(w.output, n - 4) | (_assert_get(w.output, n - 3) << 8) | (_assert_get(w.output, n - 2) << 16) | (_assert_get(w.output, n - 1) << 24);
    assert got_crc == expected_crc;
    assert got_isize == expected_isize;
    bytes_free(w.output);
    bytes_free(w.input);
}
