// capsules/sfn/crypto/src/trust_store.sfn
//
// System trust-store loading (SFN-340, design: SFEP-0048 Phase C) — the set
// of certificates `x509_verify_chain` is willing to terminate a path at.
// Locating and reading a platform CA bundle is the one part of the trust
// decision that touches the filesystem, so it is isolated in this module and
// nowhere else.
//
// The effect boundary follows `rand.sfn`, the capsule's existing precedent:
// the effect sits on the function, not the manifest. `trust_store_from_pem` is
// pure and carries the whole decode-and-parse path, so it is what the tests
// exercise; only `trust_store_load`/`trust_store_load_from` declare `![io]`,
// and they add no capsule dependency because `fs.*` and `env.*` are
// compiler-provided globals. `sfn/crypto`'s `[capabilities] required` stays
// `[]`, matching how `random_bytes` already carries `![rand]` under the same
// empty manifest — a caller that only wants SHA-256 inherits no filesystem
// requirement. Note `required = []` also disables the E0403 capsule/effect
// cross-check outright rather than asserting "no effects" (SFN-764), so it
// documents nothing on its own; the honest capability surface is the
// per-function effect annotations and `docs/status.md`'s `sfn/crypto` row.
import { ptr_off } from "./bits";
import { pem_certificates_to_der } from "./pem";
import { X509Certificate, x509_parse } from "./x509";

struct TrustStore {
    ok: boolean;
    error: string;
    source: string;  // the path the anchors were read from; "" when built from memory
    anchors: X509Certificate[];
    // PEM blocks that did not parse as certificates and were dropped. Skipping
    // an anchor can only ever shrink the set of things this process trusts, so
    // a partially-unreadable bundle degrades toward rejecting chains, never
    // toward accepting them — which is why a malformed entry is skipped and
    // counted rather than failing the whole load. A caller that wants a strict
    // bundle asserts `skipped == 0`.
    skipped: int;
}

fn _store_err(message: string) -> TrustStore {
    let empty: X509Certificate[] = [];
    return TrustStore {
        ok: false,
        error: message,
        source: "",
        anchors: empty,
        skipped: 0
    };
}

// Environment overrides, consulted in this order before any built-in location.
//
// `SAILFIN_TLS_CAFILE` comes first because it is the name the existing
// OpenSSL-backed runtime already honours (`runtime/sfn/platform/tls.sfn`), so
// a program configured against today's stack keeps its custom CA when SFN-341
// swaps those bodies onto this one. Dropping it would silently downgrade such
// a program to the system bundle — a trust change, made invisibly.
// `SSL_CERT_FILE` follows as the ecosystem-standard name OpenSSL and curl use.
fn trust_store_env_vars() -> string[] {
    return ["SAILFIN_TLS_CAFILE", "SSL_CERT_FILE"];
}

// Well-known CA-bundle locations, in probe order:
//
//   /etc/ssl/certs/ca-certificates.crt      Debian, Ubuntu, Alpine
//   /etc/pki/tls/certs/ca-bundle.crt        RHEL, Fedora, CentOS
//   /etc/ssl/ca-bundle.pem                  openSUSE
//   /etc/pki/tls/cacert.pem                 older RHEL
//   /etc/ssl/cert.pem                       macOS, FreeBSD, Alpine
//   /opt/homebrew/etc/openssl@3/cert.pem    Homebrew, Apple silicon
//   /usr/local/etc/openssl@3/cert.pem       Homebrew, Intel
//
// macOS is the honest caveat: the real system trust store is the Keychain,
// which is not a file and is not readable through this path. `/etc/ssl/cert.pem`
// exists on macOS and is what the bundled LibreSSL and Homebrew OpenSSL builds
// ship, but it does not reflect Keychain trust decisions — user-added or
// administratively-revoked anchors will not be seen. A macOS caller that needs
// Keychain fidelity must supply anchors explicitly via `trust_store_from_pem`.
// Reading the Keychain would need a Security.framework binding, which is
// outside SFEP-0048's chosen cut.
//
// The annotations live above rather than inline deliberately: `sfn fmt`
// collapses a multi-line array literal onto one line and folds any trailing
// `//` comment into it, commenting out every element that follows and leaving
// source that does not parse. Inline them again once SFN-763 is fixed.
fn trust_store_default_paths() -> string[] {
    return ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/ca-bundle.pem", "/etc/pki/tls/cacert.pem", "/etc/ssl/cert.pem", "/opt/homebrew/etc/openssl@3/cert.pem", "/usr/local/etc/openssl@3/cert.pem"];
}

// Parse raw DER certificate blobs into trust anchors. Pure: this is the whole
// parse-and-account path, shared by every producer of anchors in this module,
// and it is what the tests exercise.
//
// DER is the seam because it is the narrowest thing every source of trust
// already speaks: `x509_parse` takes exactly one raw DER blob, and a platform
// trust store hands out DER blobs directly (SFN-808). Sharing the tail is what
// makes a certificate from a platform store and one decoded out of a PEM
// bundle subject to byte-for-byte identical parsing and `skipped` accounting —
// a second inlined copy of this loop would be free to drift.
fn trust_store_from_der_blocks(blocks: int[][]) -> TrustStore {
    if blocks.length == 0 {
        return _store_err("trust_store: no CERTIFICATE blocks in bundle");
    }

    let mut anchors: X509Certificate[] = [];
    let mut skipped: int = 0;
    let mut i: int = 0;
    loop {
        if i >= blocks.length { break; }
        let candidate: X509Certificate = x509_parse(blocks[i]);
        if candidate.ok { anchors.push(candidate); } else { skipped += 1; }
        i += 1;
    }

    if anchors.length == 0 {
        return _store_err("trust_store: no certificate in bundle parsed");
    }

    return TrustStore {
        ok: true,
        error: "",
        source: "",
        anchors: anchors,
        skipped: skipped
    };
}

// Parse a PEM CA bundle into trust anchors. Pure: PEM decode, then the shared
// DER tail above.
fn trust_store_from_pem(pem: string) -> TrustStore {
    return trust_store_from_der_blocks(pem_certificates_to_der(pem));
}

// ── Platform trust store (SFN-808) ─────────────────────────────────────────
//
// Runtime ABI. `sfn_cert_roots_blob()` is defined in
// `runtime/sfn/platform/cert_roots.sfn` (POSIX) or, for a Windows target,
// `cert_roots_windows.sfn` swapped in by `target_condition_runtime_sfn_sources`
// — and linked into every binary via `runtime/capsule.toml` `sfn-sources`.
// This module reaches it by the same symbol-name-only extern pattern `rand.sfn`
// uses for `sfn_rand_fill`, which is what keeps the Windows-only Crypt32
// externs out of this file: an unconditional Win32 extern here would fail every
// Linux and macOS link, because both COFF and ELF resolve all external
// references before dead-stripping (SFN-649). Externs carry no effect (E0804);
// the `![io]` gate stays on `trust_store_load` below.
//
// Full blob layout is documented in `cert_roots_windows.sfn`:
//
//    0 : i64 count        number of records
//    8 : i64 total_bytes  size of the allocation, header and slack included
//   16 : records          { i64 der_len, der_len bytes, zero pad to 8 }
extern fn sfn_cert_roots_blob() -> *u8;

extern fn free(ptr: *u8) -> void;

// Result of one platform trust-store enumeration.
struct PlatformRoots {
    // Whether this host HAS an enumerable platform trust store. False on
    // POSIX, where the trust store is a file and `trust_store_default_paths()`
    // is the real mechanism — so a false here is not a failure and the caller
    // must fall through to the path probe. True with an empty `blocks` is a
    // genuine failure: the platform claims a store and it produced nothing.
    present: boolean;
    blocks: int[][];
}

// The `source` a store enumerated from the platform reports. Windows is the
// only platform that produces a blob today (POSIX returns null and falls
// through to a real path, which is what its `source` shows), so this names
// the Windows store rather than a generic placeholder — a diagnostic that
// says where the trust actually came from is worth more than one that is
// portable in the abstract.
fn _platform_store_name() -> string { return "windows-system-root-store"; }

// Upper bound on a platform-roots blob, used only to reject a corrupt header.
// A 4096-certificate store — already far above any real one — runs to roughly
// 8 MiB, so 32 MiB cannot exclude a legitimate store while still keeping a
// nonsense `total_bytes` from walking the decoder off the end of the
// allocation. Every other bound below is derived from `total_bytes`, so this
// is the one value that has to be sanity-checked rather than trusted.
fn _roots_max_blob_bytes() -> int { return 33554432; }

// Decode the runtime's platform-roots blob into DER blocks. Never partially
// trusts a malformed blob: any inconsistency stops the walk, so a truncated
// or corrupt buffer yields fewer anchors and therefore rejects more chains.
fn _platform_root_blocks() -> PlatformRoots {
    let empty: int[][] = [];
    let blob: *u8 = sfn_cert_roots_blob();
    if blob as i64 == 0 {
        return PlatformRoots { present: false, blocks: empty };
    }

    let count: int = sailfin_intrinsic_pointer_read_i64(blob) as int;
    let total: int = sailfin_intrinsic_pointer_read_i64(ptr_off(blob, 8)) as int;
    if count < 0 || total < 16 || total > _roots_max_blob_bytes() {
        // A header this shape means the producer is broken, not that the host
        // has no store — so it stays `present` and fails closed loudly at the
        // caller rather than silently degrading to the CA-bundle path probe.
        free(blob);
        return PlatformRoots { present: true, blocks: empty };
    }

    let mut out: int[][] = [];
    let mut off: int = 16;
    let mut n: int = 0;
    loop {
        if n >= count { break; }
        if off + 8 > total { break; }
        let der_len: int = sailfin_intrinsic_pointer_read_i64(ptr_off(blob, off as i64)) as int;
        off += 8;
        if der_len <= 0 { break; }
        if off + der_len > total { break; }

        let mut der: int[] = [];
        let mut b: int = 0;
        loop {
            if b >= der_len { break; }
            // Sailfin has no byte-width load, so each byte comes out of a
            // 4-byte read masked to its low octet — the `random_bytes`
            // pattern. The producer's 8 bytes of trailing slack are what keep
            // the read at the final byte in bounds.
            der.push((sailfin_intrinsic_pointer_read_i32(ptr_off(blob, (off + b) as i64)) as int) & 255);
            b += 1;
        }
        out.push(der);

        off += der_len;
        // Records are padded so the next `i64` length field stays 8-aligned.
        let rem: int = off % 8;
        if rem != 0 { off += 8 - rem; }
        n += 1;
    }

    free(blob);
    return PlatformRoots { present: true, blocks: out };
}

// Read and parse a CA bundle from an explicit path. `![io]`.
fn trust_store_load_from(path: string) -> TrustStore ![io] {
    if path.length == 0 {
        return _store_err("trust_store: empty bundle path");
    }
    if !fs.exists(path) {
        return _store_err("trust_store: no CA bundle at " + path);
    }
    let pem: string = fs.readFile(path);
    if pem.length == 0 {
        return _store_err("trust_store: CA bundle is empty at " + path);
    }

    let store: TrustStore = trust_store_from_pem(pem);
    if !store.ok { return _store_err(store.error + " (" + path + ")"); }
    return TrustStore {
        ok: true,
        error: "",
        source: path,
        anchors: store.anchors,
        skipped: store.skipped
    };
}

// Locate and load the platform CA bundle: the first environment override in
// `trust_store_env_vars()` that is set, otherwise the first readable entry in
// `trust_store_default_paths()`. `![io]`.
//
// Fail-closed: when no bundle is found this returns a failed store rather than
// an empty one, and `x509_verify_chain` rejects an empty anchor set anyway —
// there is no path on which a missing trust store degrades into trusting
// everything.
fn trust_store_load() -> TrustStore ![io] {
    let overrides: string[] = trust_store_env_vars();
    let mut v: int = 0;
    loop {
        if v >= overrides.length { break; }
        let override_path: string = env.get(overrides[v]);
        if override_path.length > 0 {
            // The first override that is *set* wins outright, even if it does
            // not resolve: an explicit override that fails is an error, never a
            // silent fallback to the system bundle. A caller who pointed at a
            // private CA must not be quietly handed the public one instead.
            return trust_store_load_from(override_path);
        }
        v += 1;
    }

    // The platform store, when the host has one, is authoritative and is
    // consulted BEFORE the path probe — it is the live OS trust decision, fed
    // by the vendor update channel and enterprise policy, where a bundle file
    // is a snapshot of one. It sits after the overrides so an operator who
    // named a private CA still wins outright.
    //
    // Fail closed and loudly when the platform claims a store but yields
    // nothing: on a host with a platform store there is no CA-bundle file to
    // fall through to, so continuing to the probe below would end at the same
    // generic "no readable CA bundle" error with the real cause — the store
    // failed to open, or enumerated no usable certificate — erased. A host
    // with no platform store at all reports `present: false` and skips this
    // block entirely, which is what keeps POSIX behaviour unchanged.
    let platform: PlatformRoots = _platform_root_blocks();
    if platform.present {
        if platform.blocks.length == 0 {
            return _store_err("trust_store: platform trust store is unreadable or empty ("
                + _platform_store_name()
                + ")");
        }
        let platform_store: TrustStore = trust_store_from_der_blocks(platform.blocks);
        if !platform_store.ok {
            return _store_err(platform_store.error + " (" + _platform_store_name()
                + ")");
        }
        return TrustStore {
            ok: true,
            error: "",
            source: _platform_store_name(),
            anchors: platform_store.anchors,
            skipped: platform_store.skipped
        };
    }

    let paths: string[] = trust_store_default_paths();
    let mut i: int = 0;
    loop {
        if i >= paths.length { break; }
        if fs.exists(paths[i]) {
            let store: TrustStore = trust_store_load_from(paths[i]);
            if store.ok { return store; }
        }
        i += 1;
    }
    return _store_err("trust_store: no readable CA bundle in any known location");
}

export {
    TrustStore,
    trust_store_from_der_blocks,
    trust_store_from_pem,
    trust_store_load,
    trust_store_load_from,
    trust_store_default_paths,
    trust_store_env_vars
};
