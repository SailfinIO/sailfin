// capsules/sfn/crypto/src/pem.sfn
//
// Binary-safe PEM decoding, originally for the TLS 1.3 server certificate
// chain (SFN-654, SFEP-0048 Phase B) and now also for the system CA trust
// store (`trust_store.sfn`). The two callers differ by an order of magnitude
// in legitimate block count, which is why the block bound is a parameter
// rather than a module constant — applying the chain bound to a bundle
// refused every real trust store (SFN-807).
//
// It exists separately from `mod.sfn`'s
// `base64_decode` because that one returns a `string` and collapses to the
// "" sentinel on any decoded 0x00 byte — and DER routinely contains them —
// so it cannot represent a certificate chain.
//
// Operates on `int[]` byte arrays (never `string`) for the decoded output,
// mirroring `tls13_handshake_codec.sfn`'s wire-codec convention. Every
// function here fails closed: malformed or truncated input returns `[]`
// rather than a best-effort partial decode.
// Map a single standard-alphabet base64 byte to its 6-bit value, or -1 if
// `code` is not an alphabet character (`=` padding included).
fn _pem_base64_sextet(code: int) -> int {
    // Callers pass a single byte value, 0-255: Sailfin string indexing is
    // byte-oriented, matching `bits.sfn::string_to_bytes`. A multi-byte UTF-8
    // character therefore arrives one byte at a time, and every continuation
    // byte is outside the alphabet, so it is rejected.
    if code >= 65 && code <= 90 { return code - 65; }
    if code >= 97 && code <= 122 { return code - 97 + 26; }
    if code >= 48 && code <= 57 { return code - 48 + 52; }
    if code == 43 { return 62; }
    if code == 47 { return 63; }
    return -1;
}

// Decode strict RFC 4648 base64 into bytes, including embedded 0x00 bytes.
// The strict padding rules (`=` legal only in the final quad; `X=Y=`
// rejected; the low bits under padding must be zero) match
// `_eds_base64_bytes` in `ed25519_sign.sfn`. The contrast is against
// `mod.sfn::base64_decode`, which returns a `string` and cannot carry DER's
// 0x00 bytes — this function returns binary-safe `int[]` instead.
//
// Takes the body as already-extracted byte values rather than a `string`
// because building that string was quadratic: `+` on strings allocates and
// copies the whole accumulated left side per character
// (`runtime/sfn/string.sfn::sfn_str_concat`) out of an arena nothing rewinds
// on this path, so a ~2.7 KB base64 body cost ~3.6 MB of copying and the same
// again in unreclaimed arena. Across a 152-certificate system bundle that was
// ~190 MB per load, measured — roughly 40 HTTPS handshakes under the 8 GiB
// self-cap before the process died (SFN-807). An `int[]` push is amortised
// O(1), so the scan is linear in the block and allocates once per growth.
fn _pem_base64_bytes(codes: int[]) -> int[] {
    if codes.length == 0 || (codes.length & 3) != 0 { return []; }
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= codes.length { break; }
        let d0: int = _pem_base64_sextet(codes[i]);
        let d1: int = _pem_base64_sextet(codes[i + 1]);
        if d0 < 0 || d1 < 0 { return []; }

        // 61 is `=`; the alphabet check above already rejected every other
        // non-alphabet byte.
        let c2: int = codes[i + 2];
        let c3: int = codes[i + 3];
        let pad2: bool = c2 == 61;
        let pad3: bool = c3 == 61;
        if (pad2 || pad3) && i + 4 != codes.length { return []; }
        if pad2 && !pad3 { return []; }
        out.push(((d0 << 2) | (d1 >> 4)) & 255);

        if pad2 {
            if (d1 & 15) != 0 { return []; }
        } else {
            let d2: int = _pem_base64_sextet(c2);
            if d2 < 0 { return []; }
            out.push(((d1 << 4) | (d2 >> 2)) & 255);
            if pad3 {
                if (d2 & 3) != 0 { return []; }
            } else {
                let d3: int = _pem_base64_sextet(c3);
                if d3 < 0 { return []; }
                out.push(((d2 << 6) | d3) & 255);
            }
        }
        i += 4;
    }
    return out;
}

fn _pem_is_ascii_space(c: string) -> bool {
    let code: int = char_code(c) & 255;
    return code == 9 || code == 10 || code == 13 || code == 32;
}

fn _pem_matches_at(input: string, start: int, expected: string) -> bool {
    if start < 0 || start + expected.length > input.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= expected.length { break; }
        if input[start + i] != expected[i] { return false; }
        i += 1;
    }
    return true;
}

// The largest single decoded block this module accepts. A certificate this
// large is not one the record layer will put on the wire, and an unbounded
// decode is an attacker-sized allocation.
fn _pem_max_block_bytes() -> int { return 65535; }

// The largest number of blocks a *chain* PEM (the wire certificate chain,
// SFN-654) may declare — the default this module applies through
// `pem_decode_blocks`. Guards the scan loop against an adversarial file with
// unbounded BEGIN/END pairs.
//
// This bound is a chain bound, not a universal one. A caller whose legitimate
// input is larger passes its own through `pem_decode_blocks_with_limits`;
// applying this one to a system CA bundle silently refused every real trust
// store (SFN-807), so that policy now lives with its owner in
// `trust_store.sfn` rather than here.
fn _pem_max_blocks() -> int { return 16; }

// The ceiling no caller of `pem_decode_blocks_with_limits` can raise. The
// per-block bound above is a default a caller may override; this one is the
// module's own guard, so a consumer cannot pass a huge `max_blocks` and
// remove it. Sized well above the largest legitimate caller (a trust store's
// 512) and far below anything that would make the scan unbounded.
fn _pem_absolute_max_blocks() -> int { return 4096; }

// Extract every `-----BEGIN <label>-----` … `-----END <label>-----` block in
// `pem`, in order, and base64-decode each to DER bytes. Text between blocks
// (and before the first / after the last) is ignored — real chain files
// carry human-readable subject/issuer preambles between certificates. LF and
// CRLF line endings and ASCII whitespace inside the body are accepted.
//
// Returns `[]` (empty outer array) fail-closed if any block is malformed: a
// BEGIN with no matching END, a base64 body with an invalid character or bad
// padding, an empty decoded block, more than `max_blocks` blocks, a
// `max_blocks` below 1, or any single decoded block exceeding
// `_pem_max_block_bytes()`.
//
// `[]` is therefore ambiguous across those causes. A caller that reports the
// failure to a human wants `pem_count_blocks` to tell "none present" from
// "more than the bound admits" (SFN-807).
fn pem_decode_blocks_with_limits(pem: string, label: string, max_blocks: int) -> int[][] {
    let none: int[][] = [];
    if max_blocks < 1 { return none; }
    // The bound is caller-supplied but not caller-removable: this is a public
    // entry point, and a consumer passing a huge `max_blocks` would otherwise
    // delete the guard the module documents above. Clamping keeps "the policy
    // lives with the caller" without letting the caller opt out of a ceiling.
    let mut bound: int = max_blocks;
    if bound > _pem_absolute_max_blocks() {
        bound = _pem_absolute_max_blocks();
    }
    let header: string = "-----BEGIN " + label + "-----";
    let footer: string = "-----END " + label + "-----";

    let mut blocks: int[][] = [];
    let mut cursor: int = 0;
    loop {
        if cursor >= pem.length { break; }
        if !_pem_matches_at(pem, cursor, header) {
            cursor += 1;
            continue;
        }
        if blocks.length >= bound { return none; }

        cursor += header.length;
        let mut codes: int[] = [];
        let mut found_footer: bool = false;
        loop {
            if cursor >= pem.length { break; }
            if _pem_matches_at(pem, cursor, footer) {
                found_footer = true;
                cursor += footer.length;
                break;
            }
            if _pem_is_ascii_space(pem[cursor]) { cursor += 1; } else {
                // A base64-encoded block this large decodes past
                // `_pem_max_block_bytes()`; stop collecting before that
                // happens, so the per-block work stays bounded too and not
                // merely the block count.
                if codes.length > (_pem_max_block_bytes() + 2) / 3 * 4 {
                    return none;
                }
                codes.push(char_code(pem[cursor]) & 255);
                cursor += 1;
            }
        }
        if !found_footer { return none; }

        let decoded: int[] = _pem_base64_bytes(codes);
        if decoded.length < 1 || decoded.length > _pem_max_block_bytes() {
            return none;
        }
        blocks.push(decoded);
    }

    return blocks;
}

// `pem_decode_blocks` under this module's chain bound — the shape every
// pre-SFN-807 caller already had, unchanged.
fn pem_decode_blocks(pem: string, label: string) -> int[][] {
    return pem_decode_blocks_with_limits(pem, label, _pem_max_blocks());
}

// Count `-----BEGIN <label>-----` headers without decoding any body. A decode
// returning `[]` is ambiguous — no blocks, a malformed block, and more blocks
// than the bound admits all produce it — and a caller reporting the failure
// needs to tell those apart (SFN-807).
fn pem_count_blocks(pem: string, label: string) -> int {
    let header: string = "-----BEGIN " + label + "-----";
    let mut count: int = 0;
    let mut cursor: int = 0;
    loop {
        if cursor >= pem.length { break; }
        if _pem_matches_at(pem, cursor, header) {
            count += 1;
            cursor += header.length;
        } else { cursor += 1; }
    }
    return count;
}

// Thin wrapper over `pem_decode_blocks` for the `CERTIFICATE` label — the
// server certificate chain PEM format (RFC 7468 §5.1).
fn pem_certificates_to_der(pem: string) -> int[][] {
    return pem_decode_blocks(pem, "CERTIFICATE");
}

// `pem_certificates_to_der` under a caller-supplied block bound, for an input
// legitimately larger than a wire chain — a system CA bundle is the motivating
// case (SFN-807).
fn pem_certificates_to_der_with_limits(pem: string, max_blocks: int) -> int[][] {
    return pem_decode_blocks_with_limits(pem, "CERTIFICATE", max_blocks);
}

export {
    pem_certificates_to_der,
    pem_certificates_to_der_with_limits,
    pem_count_blocks,
    pem_decode_blocks,
    pem_decode_blocks_with_limits
};
