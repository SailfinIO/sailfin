// capsules/sfn/crypto/src/sha384.sfn
//
// SHA-384 (FIPS 180-4) implemented in pure Sailfin as SHA-512 truncated to
// 384 bits with a different initial state. The shared 64-bit limb core
// (SFEP-0048 §3.3 item 4) lives in `sha512.sfn`.
import { sha512_state, sha512_word_hex } from "./sha512";

// The FIPS 180-4 §5.3.4 SHA-384 initial state H[0..7], as [hi, lo] decimal
// limb pairs (hex literals are unavailable in Sailfin source).
fn sha384_iv() -> int[][] {
    return [[3418070365, 3238371032], [1654270250, 914150663], [2438529370, 812702999], [355462360, 4144912697], [1731405415, 4290775857], [2394180231, 1750603025], [3675008525, 1694076839], [1203062813, 3204075428],];
}

fn sha384_hex(data: string) -> string {
    // Compute the SHA-384 digest of `data` (byte-oriented over raw UTF-8
    // bytes, matching `sha384sum`) and return the bare 96-character
    // lowercase hex string.
    let mut bytes: int[] = [];
    let mut bi: int = 0;
    loop {
        if bi >= data.length { break; }
        bytes.push(char_code(data[bi]) & 255);
        bi += 1;
    }

    let h: int[][] = sha512_state(bytes, sha384_iv());

    // SHA-384 truncates to the first 6 of the 8 state words.
    return sha512_word_hex(h[0][0], h[0][1]) + sha512_word_hex(h[1][0], h[1][1])
        + sha512_word_hex(h[2][0], h[2][1])
        + sha512_word_hex(h[3][0], h[3][1])
        + sha512_word_hex(h[4][0], h[4][1])
        + sha512_word_hex(h[5][0], h[5][1]);
}

export { sha384_hex };
