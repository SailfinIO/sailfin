    load_u32_be,
    store_u32_be,
    load_u32_le,
    store_u32_le
} from "./bits";

export { chacha20_block, chacha20_xor } from "./chacha20";

// X25519 (Curve25519 ECDH, RFC 7748) — the TLS 1.3 key-exchange primitive,
// over 16 x 16-bit limbs (SFEP-0048 §6.4 as amended by the SFN-335 design
// note, docs/proposals/design-notes/sfn-335-x25519-limb-strategy.md).
export { x25519, x25519_base, x25519_is_zero } from "./x25519";

// RSA signature verification over the 26-bit Montgomery bignum core in
// src/bignum.sfn (SFEP-0048 Phase C as amended, and the limb selection in
// docs/proposals/design-notes/sfn-653-p256-rsa-bigint-strategy.md), in both
// modes the trust path needs: RSASSA-PKCS1-v1_5 (RFC 8017 §8.2.2) for X.509
// certificate signatures, and RSASSA-PSS (RFC 8017 §8.1.2) for TLS 1.3
// CertificateVerify, which RFC 8446 §4.2.3 forbids the v1.5 schemes in. The PSS
// entry points fix the salt length at the digest length, the only length the
// TLS 1.3 `rsa_pss_rsae_*` / `rsa_pss_pss_*` schemes permit.
//
// The bignum layer stays capsule-internal; both modes share `_rsa_public_op`
// inside src/rsa.sfn rather than reaching through this surface.
export {
    rsa_pkcs1_v1_5_verify_sha256,
    rsa_pkcs1_v1_5_verify_sha384,
    rsa_pss_verify_sha256,
    rsa_pss_verify_sha384
} from "./rsa";

// ECDSA over NIST P-256 with SHA-256 (FIPS 186-4), verification only. The
// digest entry point is the one an X.509 chain verifier wants, since it hashes
// the tbsCertificate itself; the message entry point is the `ecdsa-with-SHA256`
// profile.
//
// The P-256 field, scalar, and point layer stays capsule-internal in
// src/p256.sfn, for the same reason the bignum layer does: it is arithmetic
// this capsule's verifiers share, not a surface to build on. Signing is absent
// by design — see the src/ecdsa.sfn header.
export { ecdsa_p256_verify_digest, ecdsa_p256_verify_sha256 } from "./ecdsa";

// Minimal DER/ASN.1 reader — definite-length TLV walk over the subset X.509
