// sfn/crypto — Cryptographic hashing, encoding, and signature functions.
//
// Provides SHA-256 and SHA-512 hashing (data integrity, checksums,
// content-addressable storage), base64 encode/decode, and Ed25519 signing and
// verification (RFC 8032). No effects required — pure computation.
import { hex_byte, string_to_bytes } from "./bits";
import { hmac_sha256_bytes, sha256_bytes } from "./hkdf";

export { ed25519_verify, ed25519_verify_utf8 } from "./ed25519";

export {
    ed25519_seed_from_pkcs8_der,
    ed25519_seed_from_pkcs8_pem,
    ed25519_sign
} from "./ed25519_sign";

// Binary-safe PEM decoding for a TLS 1.3 server certificate chain (SFN-654,
// SFEP-0048 Phase B) — separate from `base64_decode` below, which cannot
// represent a decoded 0x00 byte.
export { pem_certificates_to_der, pem_decode_blocks } from "./pem";

export { sha1_hex } from "./sha1";

export { sha384_hex } from "./sha384";

export { sha512, sha512_hex } from "./sha512";

export { hmac_sha256_bytes, hkdf_sha256_extract, hkdf_sha256_expand } from "./hkdf";

// TLS 1.3 key schedule (RFC 8446 §7.1) — HKDF-Expand-Label / Derive-Secret and
