// X.509 certificate structure parse, validity-window classification, and RFC
// 6125 hostname matching (SFEP-0048 Phase C, SFN-504). Inspection only: nothing
// here verifies a signature, builds a chain, or enforces basicConstraints /
// keyUsage. Trust decisions belong to the chain verifier, not this surface.
export {
    X509Certificate,
    X509Extension,
    x509_oid_common_name,
