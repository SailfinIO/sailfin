// capsules/sfn/crypto/src/x509_verify.sfn
//
// X.509 certification-path validation (SFN-340, design: SFEP-0048 Phase C):
// the trust decision SFN-504's parser deliberately withheld. Given an
// end-entity certificate, an unordered bag of candidate intermediates, and a
// set of trust anchors, decide whether a path exists from the leaf to an
// anchor on which every signature verifies and every CA constraint holds.
// Encoding and path rules: RFC 5280 (4.1.1.2, 4.2.1.9, 6.1).
//
// Fail-closed is the whole point of this module. Every exit that is not a
// fully verified path is a rejection carrying a distinguishable code, and a
// signature algorithm this capsule cannot verify rejects the link rather than
// skipping it — an unrecognised algorithm is never treated as acceptable.
//
// **`ok: true` is not an authentication result.** It answers exactly one
// question — does a path exist from this leaf to a configured anchor on which
// every signature verifies and every constraint this module enforces holds. It
// does NOT say the certificate belongs to the host you are talking to: no
// hostname is matched here (that is `x509_hostname_matches`, and a caller that
// skips it has authenticated nothing), no revocation is checked (no OCSP, no
// CRL), and extendedKeyUsage is enforced on the leaf only, not nested down the
// path. A caller wiring this into a TLS client owes the hostname check
// separately.
//
// Pure computation: this module reads no ambient time and performs no I/O.
// The caller owns `![clock]` and supplies one Unix-millisecond snapshot,
// mirroring `x509_validity_at` (SFN-504); locating and reading a platform CA
// bundle is `trust_store.sfn`'s job. That is what keeps `sfn/crypto`'s
// `[capabilities] required` empty through this addition.
import { hex_byte } from "./bits";
import {
    DerBytesResult,
    DerIntResult,
    DerLimits,
    DerOutcome,
    DerTextResult,
    DerTlv,
    der_check_structure,
    der_context_number,
    der_default_limits,
    der_first_child,
    der_integer_bytes,
    der_integer_small,
    der_is_constructed,
    der_is_context,
    der_next_sibling,
    der_oid_string,
    der_read_tlv,
    der_tag_null,
    der_tag_oid,
    der_tag_sequence
} from "./der";
import { ecdsa_p256_verify_sha256, ecdsa_p384_verify_sha384 } from "./ecdsa";
import { ed25519_verify } from "./ed25519";
import {
    rsa_pkcs1_v1_5_verify_sha256,
    rsa_pkcs1_v1_5_verify_sha384,
    rsa_pss_verify_sha256,
    rsa_pss_verify_sha384
} from "./rsa";
import {
    X509Certificate,
    X509Extension,
    X509NameSubtree,
    x509_dns_constraint_matches,
    x509_key_usage_key_cert_sign,
    x509_name_form_dns_name,
    x509_name_form_ip_address,
    x509_oid_basic_constraints,
    x509_oid_ecdsa_p256_sha256,
    x509_oid_ed25519,
    x509_oid_eku_server_auth,
    x509_oid_extended_key_usage,
    x509_oid_key_usage,
    x509_oid_name_constraints,
    x509_oid_rsa_encryption,
    x509_oid_subject_alt_name,
    x509_validity_at,
    x509_validity_expired,
    x509_validity_in_window,
    x509_validity_not_yet_valid
} from "./x509";

// ── Signature-algorithm OIDs this module dispatches on ──
// Ed25519 and ecdsa-with-SHA256 are re-used from x509.sfn; the RSA signature
// OIDs live here because x509.sfn only needed the key-algorithm OID.
fn x509_verify_oid_sha256_rsa() -> string { return "1.2.840.113549.1.1.11"; }

fn x509_verify_oid_sha384_rsa() -> string { return "1.2.840.113549.1.1.12"; }

// ecdsa-with-SHA384 (RFC 5758 §3.2). It lives here rather than in x509.sfn for
// the same reason the RSA signature OIDs do: x509.sfn only needed the
// key-algorithm OID, and this one is dispatched on nowhere else.
fn x509_verify_oid_ecdsa_p384_sha384() -> string {
    return "1.2.840.10045.4.3.3";
}

// id-RSASSA-PSS (RFC 4055 3.1). Unlike every other signature OID this module
// dispatches on, a PSS AlgorithmIdentifier is not self-describing: the hash,
// the mask generation function and the salt length live in the `parameters`
// field, so the one OID names a whole family of profiles. `rsa_pss_verify_*`
// implements exactly one member of that family — MGF1 over the signature
// hash, salt length equal to the digest length — which is why the parameters
// are parsed and matched rather than assumed. Verifying under assumed
// parameters would report a profile as checked that was never checked, the
// precise way a signature check becomes decorative (SFN-824).
fn x509_verify_oid_rsassa_pss() -> string { return "1.2.840.113549.1.1.10"; }

// id-mgf1 (RFC 4055 2.1), the only mask generation function defined for PSS,
// and the two SHA-2 digest OIDs whose profiles this capsule can verify.
fn _x509_verify_oid_mgf1() -> string { return "1.2.840.113549.1.1.8"; }

fn _x509_verify_oid_sha256() -> string { return "2.16.840.1.101.3.4.2.1"; }

fn _x509_verify_oid_sha384() -> string { return "2.16.840.1.101.3.4.2.2"; }

// id-ecPublicKey. Note this OID identifies the key *type* only: P-256 and
// P-384 keys carry the same one and differ solely in the algorithm
// parameters, which x509.sfn does not expose. Curve agreement is therefore
// enforced downstream, and by more than one mechanism — worth spelling out,
// because the obvious argument is not the complete one:
//
//   * a MISMATCHED NIST curve is caught by the SEC1 length check of whichever
//     verifier the signature OID selected: `ecdsa-with-SHA256` routes to
//     `_p256_point_decode`, which requires exactly 65/33 bytes, and
//     `ecdsa-with-SHA384` routes to `_p384_point_decode`, which requires
//     exactly 97/49 bytes. A P-384 key under a SHA-256 signature and a P-256
//     key under a SHA-384 signature therefore both fail on width;
//   * a SAME-SIZED foreign curve (secp256k1 or brainpoolP256r1 against P-256,
//     brainpoolP384r1 against P-384) passes that length check, and is rejected
//     instead by the on-curve test and the `x >= p` coordinate check in the
//     selected curve's decoder.
//
// The length check alone would not be sufficient, so do not simplify this to
// "the length check handles it". Note also what this does NOT check: the
// namedCurve OID in the SPKI parameters is still not parsed, so the signature
// algorithm alone selects the arithmetic. That is sound only because the two
// mechanisms above reject every disagreement; it is not a claim that the
// certificate's declared curve was honoured (SFN-811).
fn x509_verify_oid_ec_public_key() -> string { return "1.2.840.10045.2.1"; }

// ── Outcome codes. Stable strings so a caller (and a test) can distinguish
// every rejection class without matching on prose. ──
fn x509_verify_ok() -> string { return "ok"; }

fn x509_verify_err_bad_input() -> string { return "bad-input"; }

fn x509_verify_err_no_anchor() -> string { return "no-anchor"; }

fn x509_verify_err_bad_signature() -> string { return "bad-signature"; }

fn x509_verify_err_unsupported_algorithm() -> string {
    return "unsupported-algorithm";
}

fn x509_verify_err_algorithm_mismatch() -> string {
    return "algorithm-mismatch";
}

fn x509_verify_err_expired() -> string { return "expired"; }

fn x509_verify_err_not_yet_valid() -> string { return "not-yet-valid"; }

fn x509_verify_err_not_a_ca() -> string { return "not-a-ca"; }

fn x509_verify_err_path_len_exceeded() -> string { return "path-len-exceeded"; }

fn x509_verify_err_eku() -> string { return "eku"; }

fn x509_verify_err_path_too_long() -> string { return "path-too-long"; }

fn x509_verify_err_unrecognized_critical_extension() -> string {
    return "unrecognized-critical-extension";
}

// RFC 5280 §4.2.1.10, enforced whether or not the extension is marked
// critical (SFN-765). `name_constraint_unsupported` is distinct from a
// generic parse failure: the certificate parsed fine, but one of its
// subtrees names a GeneralName form this module cannot enforce, and silently
// ignoring that form would be the fail-open bug this code exists to avoid.
fn x509_verify_err_name_constraint() -> string { return "name-constraint"; }

fn x509_verify_err_name_constraint_unsupported() -> string {
    return "name-constraint-unsupported";
}

// Not produced by `x509_verify_chain`, which deliberately does not look at
// names. It belongs to this family so that a caller composing chain building
// with `x509_hostname_matches` — `hs_client_verify_peer` is the one in tree —
// can report both outcomes through a single `X509ChainResult.code`.
fn x509_verify_err_hostname_mismatch() -> string { return "hostname-mismatch"; }

struct X509VerifyOptions {
    now_ms: int;  // caller-supplied Unix-millisecond snapshot; the caller owns ![clock]
    max_depth: int;  // maximum intermediates between leaf and anchor; <= 0 selects the default
    require_server_auth: boolean;  // enforce EKU serverAuth on the leaf when the extension is present
}

fn x509_verify_default_max_depth() -> int { return 8; }

// Server-authentication defaults: a TLS client is the only consumer in the
// SFEP-0048 cut, so serverAuth enforcement is on unless a caller opts out.
fn x509_verify_options(now_ms: int) -> X509VerifyOptions {
    return X509VerifyOptions {
        now_ms: now_ms,
        max_depth: x509_verify_default_max_depth(),
        require_server_auth: true
    };
}

struct X509ChainResult {
    ok: boolean;
    code: string;  // x509_verify_ok() on success, otherwise one of the error codes
    error: string;  // human-readable detail; never the thing a caller branches on
    depth: int;  // intermediates between leaf and anchor; 0 when the anchor issued the leaf
    anchor_subject_cn: string;  // "" on failure
}

fn _chain_err(code: string, message: string) -> X509ChainResult {
    return X509ChainResult {
        ok: false,
        code: code,
        error: message,
        depth: 0,
        anchor_subject_cn: ""
    };
}

// Maximum characters of a certificate-supplied OID rendered into a
// diagnostic. `der_oid_string` (der.sfn:399) builds the dotted form only from
// decoded integers joined by ".", so it can never carry raw certificate bytes
// — but its length is bounded only by the certificate size, so a crafted run
// of single-byte arcs would otherwise render megabytes into an error string.
// 64 characters holds every registered signature-algorithm OID with room over.
fn _x509_verify_max_oid_text() -> int { return 64; }

fn _is_oid_char(c: string) -> boolean {
    if c == "." { return true; }
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5"
        || c == "6"
        || c == "7"
        || c == "8"
        || c == "9";
}

// Render an untrusted OID for a diagnostic. The parser already guarantees
// dotted decimal, so re-checking the character set is defence in depth: it
// keeps a future parser change from turning this into a byte-echo path.
// Bounded and total — never returns certificate-controlled length or bytes.
fn _oid_for_message(oid: string) -> string {
    if oid.length == 0 { return "(absent)"; }
    let mut limit: int = oid.length;
    let mut truncated: boolean = false;
    if limit > _x509_verify_max_oid_text() {
        limit = _x509_verify_max_oid_text();
        truncated = true;
    }
    let mut i: int = 0;
    loop {
        if i >= limit { break; }
        if !_is_oid_char(char_at(oid, i)) { return "(malformed)"; }
        i += 1;
    }
    if truncated { return substring(oid, 0, limit) + "..."; }
    return oid;
}

// Four dispatch arms accept a signature OID but cannot pair it with the
// issuer's key algorithm. Both OIDs belong in the text: either one alone
// leaves the reader guessing which side of the pair was the problem.
fn _pair_detail(algorithm: string, issuer_spki_algorithm: string) -> string {
    return "x509_verify: signature algorithm " + _oid_for_message(algorithm)
        + " does not pair with issuer key algorithm "
        + _oid_for_message(issuer_spki_algorithm);
}

fn _bytes_to_hex(bytes: int[]) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= bytes.length { break; }
        out = out + hex_byte(bytes[i] & 255);
        i += 1;
    }
    return out;
}

fn _eq_bytes(a: int[], b: int[]) -> boolean {
    if a.length != b.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= a.length { break; }
        if (a[i] & 255) != (b[i] & 255) { return false; }
        i += 1;
    }
    return true;
}

// ── RSA SubjectPublicKeyInfo ──
struct RsaPublicKey {
    ok: boolean;
    error: string;
    modulus: int[];  // big-endian; a DER INTEGER sign octet is left in place, which rsa.sfn tolerates
    exponent: int;
}

// RSAPublicKey ::= SEQUENCE { modulus INTEGER, publicExponent INTEGER }
// (RFC 8017 A.1.1), carried as the SPKI subjectPublicKey BIT STRING content.
// That inner DER is not covered by the certificate-level structure guard, so
// it is re-checked here before being walked — the same caution x509.sfn's
// `X509Extension.value_der` comment records for extension bodies.
fn x509_rsa_public_key_from_spki(spki_key: int[]) -> RsaPublicKey {
    let limits: DerLimits = der_default_limits();
    let guard: DerOutcome = der_check_structure(spki_key, limits);
    if !guard.ok {
        return RsaPublicKey {
            ok: false,
            error: guard.error,
            modulus: [],
            exponent: 0
        };
    }

    let outer: DerTlv = der_read_tlv(spki_key, 0, spki_key.length);
    if !outer.ok {
        return RsaPublicKey {
            ok: false,
            error: outer.error,
            modulus: [],
            exponent: 0
        };
    }
    if outer.tag != der_tag_sequence() {
        return RsaPublicKey {
            ok: false,
            error: "x509_verify: expected RSAPublicKey SEQUENCE",
            modulus: [],
            exponent: 0
        };
    }
    if outer.end_off != spki_key.length {
        return RsaPublicKey {
            ok: false,
            error: "x509_verify: trailing data after RSAPublicKey",
            modulus: [],
            exponent: 0
        };
    }

    let modulus_tlv: DerTlv = der_first_child(spki_key, outer);
    if !modulus_tlv.ok {
        return RsaPublicKey {
            ok: false,
            error: modulus_tlv.error,
            modulus: [],
            exponent: 0
        };
    }
    let modulus_res: DerBytesResult = der_integer_bytes(spki_key, modulus_tlv);
    if !modulus_res.ok {
        return RsaPublicKey {
            ok: false,
            error: modulus_res.error,
            modulus: [],
            exponent: 0
        };
    }
    // `der_integer_bytes` returns the content octets verbatim, sign included,
    // so a DER-negative modulus (high bit set on the leading octet, no 0x00
    // sign byte) would otherwise be read as a positive number of the same
    // bits. Reject it here rather than reinterpret it — the same call
    // `_ecdsa_scalar` makes for scalars.
    if modulus_res.value.length > 0 && (modulus_res.value[0] & 128) != 0 {
        return RsaPublicKey {
            ok: false,
            error: "x509_verify: RSA modulus is a negative DER integer",
            modulus: [],
            exponent: 0
        };
    }

    let exponent_tlv: DerTlv = der_next_sibling(spki_key, outer, modulus_tlv);
    if !exponent_tlv.ok {
        return RsaPublicKey {
            ok: false,
            error: exponent_tlv.error,
            modulus: [],
            exponent: 0
        };
    }
    let exponent_res: DerIntResult = der_integer_small(spki_key, exponent_tlv);
    if !exponent_res.ok {
        return RsaPublicKey {
            ok: false,
            error: exponent_res.error,
            modulus: [],
            exponent: 0
        };
    }
    if exponent_tlv.end_off != outer.end_off {
        return RsaPublicKey {
            ok: false,
            error: "x509_verify: unexpected trailing field in RSAPublicKey",
            modulus: [],
            exponent: 0
        };
    }

    return RsaPublicKey {
        ok: true,
        error: "",
        modulus: modulus_res.value,
        exponent: exponent_res.value
    };
}

// ── RSASSA-PSS parameter matching (RFC 4055 3.1) ──
//
//   RSASSA-PSS-params ::= SEQUENCE {
//       hashAlgorithm    [0] HashAlgorithm    DEFAULT sha1,
//       maskGenAlgorithm [1] MaskGenAlgorithm DEFAULT mgf1SHA1,
//       saltLength       [2] INTEGER          DEFAULT 20,
//       trailerField     [3] TrailerField     DEFAULT trailerFieldBC }
//
// The result of matching a certificate's parameters against the single
// profile family `rsa_pss_verify_sha256`/`_sha384` implement. `sha384`
// selects the verifier; `reason` is non-empty exactly when `ok` is false and
// names the parameter that disqualified the certificate. Every `reason` is a
// fixed string chosen here, never bytes echoed from the certificate, so it is
// safe to put in a diagnostic without the sanitising `_oid_for_message` takes.
struct _PssProfile {
    ok: boolean;
    reason: string;
    sha384: boolean;
}

fn _pss_reject(reason: string) -> _PssProfile {
    return _PssProfile { ok: false, reason: reason, sha384: false };
}

fn _pss_text_err() -> DerTextResult {
    return DerTextResult {
        ok: false,
        error: "x509_verify: malformed RSASSA-PSS parameters",
        value: ""
    };
}

// Parse a `HashAlgorithm` AlgorithmIdentifier filling exactly `[off, end)`
// and return its algorithm OID. RFC 4055 2.1 wants the SHA-2 identifiers to
// carry a NULL parameters field, but absent is also in the wild; both are
// accepted and anything else is refused, because a parameter we did not read
// is a parameter we did not check.
fn _pss_hash_oid(buf: int[], off: int, end: int) -> DerTextResult {
    let seq: DerTlv = der_read_tlv(buf, off, end);
    if !seq.ok { return _pss_text_err(); }
    if seq.tag != der_tag_sequence() { return _pss_text_err(); }
    if seq.end_off != end { return _pss_text_err(); }
    let oid_tlv: DerTlv = der_read_tlv(buf, seq.content_off, seq.end_off);
    if !oid_tlv.ok { return _pss_text_err(); }
    if oid_tlv.tag != der_tag_oid() { return _pss_text_err(); }
    if oid_tlv.end_off != seq.end_off {
        let param: DerTlv = der_read_tlv(buf, oid_tlv.end_off, seq.end_off);
        if !param.ok { return _pss_text_err(); }
        if param.tag != der_tag_null() { return _pss_text_err(); }
        if param.content_len != 0 { return _pss_text_err(); }
        if param.end_off != seq.end_off { return _pss_text_err(); }
    }
    return der_oid_string(buf, oid_tlv);
}

// Decide whether `params` — the signature AlgorithmIdentifier's `parameters`
// field verbatim — names a profile this capsule can actually verify.
//
// Fail-closed in both directions: an unparseable or unsupported profile is
// rejected, and so is a *defaulted* one — for the three fields whose default
// is the SHA-1 profile. RFC 4055 3.1 defaults hashAlgorithm to sha1,
// maskGenAlgorithm to mgf1SHA1 and saltLength to 20, so omitting any of those
// is not "unspecified" but a concrete SHA-1 declaration this capsule does not
// implement and must not silently read as SHA-256.
//
// trailerField is the deliberate exception: its default, trailerFieldBC(1),
// is the only value RFC 4055 defines and the one this capsule supports, and
// X.690 11.5 requires DER to *omit* a component equal to its DEFAULT — so
// every conforming PSS certificate omits [3]. Requiring it present would
// reject every one of them.
fn _pss_profile(params: int[]) -> _PssProfile {
    if params.length == 0 {
        return _pss_reject("absent parameters default to SHA-1 (RFC 4055 3.1)");
    }
    let seq: DerTlv = der_read_tlv(params, 0, params.length);
    if !seq.ok { return _pss_reject("malformed parameters"); }
    if seq.tag != der_tag_sequence() {
        return _pss_reject("malformed parameters");
    }
    if seq.end_off != params.length {
        return _pss_reject("malformed parameters");
    }

    let mut hash_oid: string = "";
    let mut mgf_hash_oid: string = "";
    let mut salt_length: int = -1;
    let mut trailer_field: int = 1;
    let mut highest: int = -1;

    let mut child: DerTlv = der_first_child(params, seq);
    loop {
        if !child.ok {
            // der_next_sibling signals exhaustion with ok:false and an empty
            // error, which is not a parse failure.
            if child.error.length != 0 {
                return _pss_reject("malformed parameters");
            }
            break;
        }
        // RFC 4055's ASN.1 module is DEFINITIONS EXPLICIT TAGS, so each of
        // [0]-[3] is a constructed wrapper around one inner TLV. Accepting the
        // primitive form (0x80-0x83) would be accepting a non-DER encoding
        // this parser then goes on to describe as EXPLICIT.
        if !der_is_context(child.tag) || !der_is_constructed(child.tag) {
            return _pss_reject("malformed parameters");
        }
        let number: int = der_context_number(child.tag);
        // The fields are OPTIONAL, so any may be omitted, but DER admits each
        // at most once and only in ascending tag order. Enforcing that stops
        // a second [2] from overwriting the salt length the first one set.
        if number <= highest { return _pss_reject("malformed parameters"); }
        highest = number;

        if number == 0 {
            let hash_res: DerTextResult = _pss_hash_oid(params, child.content_off, child.end_off);
            if !hash_res.ok {
                return _pss_reject("malformed hash algorithm");
            }
            hash_oid = hash_res.value;
        } else {
            if number == 1 {
                let mgf_seq: DerTlv = der_read_tlv(params, child.content_off, child.end_off);
                if !mgf_seq.ok {
                    return _pss_reject("malformed mask generation function");
                }
                if mgf_seq.tag != der_tag_sequence() {
                    return _pss_reject("malformed mask generation function");
                }
                if mgf_seq.end_off != child.end_off {
                    return _pss_reject("malformed mask generation function");
                }
                let mgf_oid_tlv: DerTlv = der_read_tlv(params, mgf_seq.content_off, mgf_seq.end_off);
                if !mgf_oid_tlv.ok {
                    return _pss_reject("malformed mask generation function");
                }
                if mgf_oid_tlv.tag != der_tag_oid() {
                    return _pss_reject("malformed mask generation function");
                }
                let mgf_oid_res: DerTextResult = der_oid_string(params, mgf_oid_tlv);
                if !mgf_oid_res.ok {
                    return _pss_reject("malformed mask generation function");
                }
                if mgf_oid_res.value != _x509_verify_oid_mgf1() {
                    return _pss_reject("mask generation function is not MGF1");
                }
                // MGF1's own parameters are its hash AlgorithmIdentifier, and
                // they are not optional here: an absent one would again mean
                // SHA-1 by default.
                let mgf_hash_res: DerTextResult = _pss_hash_oid(params, mgf_oid_tlv.end_off, mgf_seq.end_off);
                if !mgf_hash_res.ok {
                    return _pss_reject("malformed MGF1 hash algorithm");
                }
                mgf_hash_oid = mgf_hash_res.value;
            } else {
                if number == 2 {
                    let salt_tlv: DerTlv = der_read_tlv(params, child.content_off, child.end_off);
                    if !salt_tlv.ok {
                        return _pss_reject("malformed salt length");
                    }
                    if salt_tlv.end_off != child.end_off {
                        return _pss_reject("malformed salt length");
                    }
                    let salt_res: DerIntResult = der_integer_small(params, salt_tlv);
                    if !salt_res.ok {
                        return _pss_reject("malformed salt length");
                    }
                    salt_length = salt_res.value;
                } else {
                    if number == 3 {
                        let trailer_tlv: DerTlv = der_read_tlv(params, child.content_off, child.end_off);
                        if !trailer_tlv.ok {
                            return _pss_reject("malformed trailer field");
                        }
                        if trailer_tlv.end_off != child.end_off {
                            return _pss_reject("malformed trailer field");
                        }
                        let trailer_res: DerIntResult = der_integer_small(params, trailer_tlv);
                        if !trailer_res.ok {
                            return _pss_reject("malformed trailer field");
                        }
                        trailer_field = trailer_res.value;
                    } else {
                        return _pss_reject("unrecognised parameter field");
                    }
                }
            }
        }
        child = der_next_sibling(params, seq, child);
    }

    if hash_oid.length == 0 {
        return _pss_reject("hash algorithm defaults to SHA-1 (RFC 4055 3.1)");
    }
    if mgf_hash_oid.length == 0 {
        return _pss_reject("mask generation function defaults to MGF1-SHA-1 (RFC 4055 3.1)");
    }
    if salt_length < 0 {
        return _pss_reject("salt length defaults to 20 (RFC 4055 3.1)");
    }
    // trailerFieldBC(1) is the only value RFC 4055 defines, and the 0xbc
    // trailer is the one `_emsa_pss_verify` checks for.
    if trailer_field != 1 { return _pss_reject("unsupported trailer field"); }
    if mgf_hash_oid != hash_oid {
        return _pss_reject("MGF1 hash differs from the signature hash");
    }
    if hash_oid == _x509_verify_oid_sha256() {
        if salt_length != 32 {
            return _pss_reject("salt length is not the SHA-256 digest length");
        }
        return _PssProfile { ok: true, reason: "", sha384: false };
    }
    if hash_oid == _x509_verify_oid_sha384() {
        if salt_length != 48 {
            return _pss_reject("salt length is not the SHA-384 digest length");
        }
        return _PssProfile { ok: true, reason: "", sha384: true };
    }
    return _pss_reject("unsupported hash algorithm");
}

// A link rejection plus, when the reason is algorithm-specific, the text that
// names the algorithm. `detail` is "" whenever the generic chain message is
// already the whole story.
struct _LinkVerdict {
    code: string;  // "" when the signature is good
    detail: string;
}

fn _link_ok() -> _LinkVerdict {
    return _LinkVerdict { code: "", detail: "" };
}

fn _link_err(code: string, detail: string) -> _LinkVerdict {
    return _LinkVerdict { code: code, detail: detail };
}

// Verify `subject`'s signature under `issuer`'s public key. Returns a
// `_LinkVerdict` whose `code` is "" when the signature is good, otherwise the
// rejection code (and, for an algorithm-specific rejection, the OID detail).
// The signed input is always the subject's tbsCertificate TLV verbatim (RFC
// 5280 4.1.1.3).
fn _verify_link(issuer: X509Certificate, subject: X509Certificate) -> _LinkVerdict {
    // RFC 5280 4.1.1.2: the outer signatureAlgorithm MUST equal the inner
    // tbsCertificate.signature. A mismatch is a signature-substitution
    // attempt, not a parse quirk.
    if subject.signature_algorithm != subject.signature_algorithm_outer {
        return _link_err(x509_verify_err_algorithm_mismatch(), "");
    }
    if subject.tbs_der.length == 0 || subject.signature_value.length == 0 {
        return _link_err(x509_verify_err_bad_signature(), "");
    }

    let algorithm: string = subject.signature_algorithm;

    if algorithm == x509_oid_ed25519() {
        if issuer.spki_algorithm != x509_oid_ed25519() {
            return _link_err(x509_verify_err_unsupported_algorithm(), _pair_detail(algorithm, issuer.spki_algorithm));
        }
        if issuer.spki_key.length != 32 {
            return _link_err(x509_verify_err_bad_signature(), "");
        }
        if subject.signature_value.length != 64 {
            return _link_err(x509_verify_err_bad_signature(), "");
        }
        let ed_ok: boolean = ed25519_verify(_bytes_to_hex(issuer.spki_key), subject.tbs_der, _bytes_to_hex(subject.signature_value));
        if ed_ok { return _link_ok(); }
        return _link_err(x509_verify_err_bad_signature(), "");
    }

    if algorithm == x509_oid_ecdsa_p256_sha256() {
        if issuer.spki_algorithm != x509_verify_oid_ec_public_key() {
            return _link_err(x509_verify_err_unsupported_algorithm(), _pair_detail(algorithm, issuer.spki_algorithm));
        }
        let ec_ok: boolean = ecdsa_p256_verify_sha256(issuer.spki_key, subject.tbs_der, subject.signature_value);
        if ec_ok { return _link_ok(); }
        return _link_err(x509_verify_err_bad_signature(), "");
    }

    if algorithm == x509_verify_oid_ecdsa_p384_sha384() {
        if issuer.spki_algorithm != x509_verify_oid_ec_public_key() {
            return _link_err(x509_verify_err_unsupported_algorithm(), _pair_detail(algorithm, issuer.spki_algorithm));
        }
        let ec384_ok: boolean = ecdsa_p384_verify_sha384(issuer.spki_key, subject.tbs_der, subject.signature_value);
        if ec384_ok { return _link_ok(); }
        return _link_err(x509_verify_err_bad_signature(), "");
    }

    if algorithm == x509_verify_oid_sha256_rsa() || algorithm == x509_verify_oid_sha384_rsa() {
        if issuer.spki_algorithm != x509_oid_rsa_encryption() {
            return _link_err(x509_verify_err_unsupported_algorithm(), _pair_detail(algorithm, issuer.spki_algorithm));
        }
        let key: RsaPublicKey = x509_rsa_public_key_from_spki(issuer.spki_key);
        if !key.ok {
            return _link_err(x509_verify_err_bad_signature(), "");
        }

        let mut rsa_ok: boolean = false;
        if algorithm == x509_verify_oid_sha256_rsa() {
            rsa_ok = rsa_pkcs1_v1_5_verify_sha256(key.modulus, key.exponent, subject.tbs_der, subject.signature_value);
        } else {
            rsa_ok = rsa_pkcs1_v1_5_verify_sha384(key.modulus, key.exponent, subject.tbs_der, subject.signature_value);
        }
        if rsa_ok { return _link_ok(); }
        return _link_err(x509_verify_err_bad_signature(), "");
    }

    if algorithm == x509_verify_oid_rsassa_pss() {
        if issuer.spki_algorithm != x509_oid_rsa_encryption() {
            return _link_err(x509_verify_err_unsupported_algorithm(), _pair_detail(algorithm, issuer.spki_algorithm));
        }
        // RFC 5280 4.1.1.2 requires the outer signatureAlgorithm to equal the
        // inner tbsCertificate.signature, and for PSS that has to include the
        // parameters: the OID-only check above passes even when the two
        // copies declare different hashes, which would let the unsigned outer
        // copy advertise the profile we verify while the signed inner copy
        // declared another. The check is scoped to PSS deliberately — for the
        // other algorithms the parameters are absent-or-NULL and the two
        // encodings are both seen in the wild, so comparing bytes there would
        // reject certificates that are not actually inconsistent (SFN-824).
        if !_eq_bytes(subject.signature_algorithm_params, subject.signature_algorithm_params_outer) {
            return _link_err(x509_verify_err_algorithm_mismatch(), "");
        }
        let profile: _PssProfile = _pss_profile(subject.signature_algorithm_params);
        if !profile.ok {
            return _link_err(x509_verify_err_unsupported_algorithm(), "x509_verify: unsupported RSASSA-PSS parameters: "
                + profile.reason);
        }
        let pss_key: RsaPublicKey = x509_rsa_public_key_from_spki(issuer.spki_key);
        if !pss_key.ok {
            return _link_err(x509_verify_err_bad_signature(), "");
        }
        let mut pss_ok: boolean = false;
        if profile.sha384 {
            pss_ok = rsa_pss_verify_sha384(pss_key.modulus, pss_key.exponent, subject.tbs_der, subject.signature_value);
        } else {
            pss_ok = rsa_pss_verify_sha256(pss_key.modulus, pss_key.exponent, subject.tbs_der, subject.signature_value);
        }
        if pss_ok { return _link_ok(); }
        return _link_err(x509_verify_err_bad_signature(), "");
    }

    // Everything else — ecdsa-with-SHA512 and the P-521 curve it
    // accompanies, sha1WithRSA, DSA — rejects the link,
    // naming the OID so the rejection is distinguishable from every other
    // unsupported-algorithm case (SFN-823). Skipping an unverifiable link is
    // how a chain verifier silently becomes decorative.
    return _link_err(x509_verify_err_unsupported_algorithm(), "x509_verify: unsupported certificate signature algorithm "
        + _oid_for_message(algorithm));
}

// "" when the certificate is inside its validity window at `now_ms`.
fn _window_code(cert: X509Certificate, now_ms: int) -> string {
    let state: int = x509_validity_at(cert, now_ms);
    if state == x509_validity_in_window() { return ""; }
    if state == x509_validity_expired() { return x509_verify_err_expired(); }
    if state == x509_validity_not_yet_valid() {
        return x509_verify_err_not_yet_valid();
    }
    return x509_verify_err_bad_input();
}

// "" when every extension `cert` marks CRITICAL is one this module actually
// processes. RFC 5280 6.1.3(f): a critical extension the validator does not
// recognise MUST reject the certificate.
//
// This is the difference between ignoring a constraint and honouring it. A
// technically-constrained sub-CA carries critical `nameConstraints`
// (2.5.29.30) permitting, say, only `corp.example`; a validator that skips the
// extension because it does not implement name constraints has silently
// promoted a constrained CA into an unconstrained one, and it will happily
// verify that CA's certificate for any name on the internet. The same reading
// applies to critical `policyConstraints` and `inhibitAnyPolicy`.
//
// So the recognised set is exactly what this module enforces, and it is
// deliberately short. Adding an OID here is a claim that the code below
// actually acts on it — never a way to quiet a rejection. `nameConstraints`
// is enforced only for its dNSName and iPAddress subtrees (SFN-765): every
// other GeneralName form a subtree names is rejected by
// `_name_constraints_code`, not silently ignored, so listing the OID as
// recognised here does not widen what actually passes.
fn _critical_extensions_code(cert: X509Certificate) -> string {
    let mut i: int = 0;
    loop {
        if i >= cert.extensions.length { break; }
        let extension: X509Extension = cert.extensions[i];
        if extension.critical {
            let oid: string = extension.oid;
            let recognized: boolean = oid == x509_oid_basic_constraints() || oid == x509_oid_key_usage()
                || oid == x509_oid_extended_key_usage()
                || oid == x509_oid_subject_alt_name()
                || oid == x509_oid_name_constraints();
            if !recognized {
                return x509_verify_err_unrecognized_critical_extension();
            }
        }
        i += 1;
    }
    return "";
}

// Note this applies to anchors too, so an anchor asserting basicConstraints
// CA:FALSE is refused as an issuer. That is correct for path validation and is
// *not* certificate pinning: pinning a self-signed end-entity certificate is a
// different trust model and is not implemented here. The common self-signed
// case still works, because `openssl req -x509` supplies critical
// basicConstraints CA:TRUE by default — verified against the fixture shape
// `compiler/tests/e2e/tls_loopback_test.sfn:195` generates. A caller that
// genuinely wants leaf pinning wants a different entry point, not a relaxation
// of this one.
//
// "" when `cert` may act as an issuer over `below` intermediates beneath it.
// RFC 5280 4.2.1.9: basicConstraints CA MUST be asserted, keyUsage — when
// present — MUST include keyCertSign, and pathLenConstraint bounds the
// intermediates that may follow this certificate toward the leaf.
//
// Known strictness, deliberate: RFC 5280 6.1.4 excludes *self-issued*
// intermediates (subject == issuer, the CA key-rollover shape) from that
// count, and `below` here counts every intermediate. So a path padded with a
// self-issued CA can be rejected where the RFC would admit it. The error is
// one-directional — it can only reject a chain, never accept one — which is
// the side to be wrong on, and correcting it means loosening security code,
// which is not worth doing without a fixture that exercises the rollover
// shape. Fold that in with such a fixture, not on its own.
fn _ca_code(cert: X509Certificate, below: int) -> string {
    if !cert.has_basic_constraints || !cert.is_ca {
        return x509_verify_err_not_a_ca();
    }
    if cert.has_key_usage {
        if (cert.key_usage_bits & x509_key_usage_key_cert_sign()) == 0 {
            return x509_verify_err_not_a_ca();
        }
    }
    if cert.path_len_constraint >= 0 {
        if cert.path_len_constraint < below {
            return x509_verify_err_path_len_exceeded();
        }
    }
    return "";
}

fn _has_server_auth_eku(cert: X509Certificate) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= cert.extended_key_usages.length { break; }
        if cert.extended_key_usages[i] == x509_oid_eku_server_auth() {
            return true;
        }
        i += 1;
    }
    return false;
}

// `addr` (4 or 16 bytes) is inside `subtree`'s address/mask pair (RFC 4632
// CIDR shape, `2 * addr.length` bytes: address followed by the same-length
// mask). A mismatched family — an IPv6 SAN against an IPv4-only subtree, or
// the reverse — never matches; that is deliberate, not an oversight the two
// address families are simply incomparable, not a wider-than-intended
// permission (SFN-765).
fn _ip_in_subtree(addr: int[], subtree: int[]) -> boolean {
    if subtree.length != 2 * addr.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= addr.length { break; }
        let mask_byte: int = subtree[addr.length + i] & 255;
        let addr_byte: int = (addr[i] & 255) & mask_byte;
        let subtree_byte: int = (subtree[i] & 255) & mask_byte;
        if addr_byte != subtree_byte { return false; }
        i += 1;
    }
    return true;
}

// "" when every certificate in `below` satisfies `issuer`'s nameConstraints
// (RFC 5280 §4.2.1.10). `below[0]` is the leaf; `below` holds every
// certificate already accepted underneath `issuer` on this path, so the
// constraint is checked against the whole subtree it governs, not only the
// certificate `issuer` directly signed (decision 5: per-chain, not
// per-certificate).
//
// Excluded is checked first and is absolute: a name inside an excluded
// subtree is rejected regardless of what permittedSubtrees says (decision 1).
// Permitted is checked per form and only when `issuer` actually asserts a
// permittedSubtrees entry of that form — `perm_has_dns`/`perm_has_ip` below —
// so a CA that constrains only DNS names does not accidentally forbid every
// IP address it never mentioned.
//
// Every subtree naming a form other than dNSName or iPAddress rejects the
// whole chain, critical or not (decision 2): silently accepting an
// unimplemented form in `excludedSubtrees` is the fail-open version of this
// bug, and `_critical_extensions_code` no longer catches it once
// nameConstraints is a recognised critical extension.
fn _name_constraints_code(issuer: X509Certificate, below: X509Certificate[]) -> string {
    if !issuer.has_name_constraints { return ""; }

    let mut si: int = 0;
    loop {
        if si >= issuer.name_constraints_permitted.length { break; }
        let form: int = issuer.name_constraints_permitted[si].form;
        if form != x509_name_form_dns_name() && form != x509_name_form_ip_address() {
            return x509_verify_err_name_constraint_unsupported();
        }
        si += 1;
    }
    si = 0;
    loop {
        if si >= issuer.name_constraints_excluded.length { break; }
        let form: int = issuer.name_constraints_excluded[si].form;
        if form != x509_name_form_dns_name() && form != x509_name_form_ip_address() {
            return x509_verify_err_name_constraint_unsupported();
        }
        si += 1;
    }

    let mut perm_has_dns: boolean = false;
    let mut perm_has_ip: boolean = false;
    si = 0;
    loop {
        if si >= issuer.name_constraints_permitted.length { break; }
        let subtree: X509NameSubtree = issuer.name_constraints_permitted[si];
        if subtree.form == x509_name_form_dns_name() { perm_has_dns = true; }
        if subtree.form == x509_name_form_ip_address() { perm_has_ip = true; }
        si += 1;
    }

    let mut k: int = 0;
    loop {
        if k >= below.length { break; }
        let c: X509Certificate = below[k];

        let mut ni: int = 0;
        loop {
            if ni >= c.dns_names.length { break; }
            let name: string = c.dns_names[ni];
            let mut ei: int = 0;
            loop {
                if ei >= issuer.name_constraints_excluded.length { break; }
                let excl: X509NameSubtree = issuer.name_constraints_excluded[ei];
                if excl.form == x509_name_form_dns_name() {
                    if x509_dns_constraint_matches(excl.dns, name, true) {
                        return x509_verify_err_name_constraint();
                    }
                }
                ei += 1;
            }
            if perm_has_dns {
                let mut matched: boolean = false;
                let mut pi: int = 0;
                loop {
                    if pi >= issuer.name_constraints_permitted.length { break; }
                    let perm: X509NameSubtree = issuer.name_constraints_permitted[pi];
                    if perm.form == x509_name_form_dns_name() {
                        if x509_dns_constraint_matches(perm.dns, name, false) {
                            matched = true;
                            break;
                        }
                    }
                    pi += 1;
                }
                if !matched { return x509_verify_err_name_constraint(); }
            }
            ni += 1;
        }

        let mut ai: int = 0;
        loop {
            if ai >= c.ip_addresses.length { break; }
            let addr: int[] = c.ip_addresses[ai].bytes;
            let mut ei2: int = 0;
            loop {
                if ei2 >= issuer.name_constraints_excluded.length { break; }
                let excl2: X509NameSubtree = issuer.name_constraints_excluded[ei2];
                if excl2.form == x509_name_form_ip_address() {
                    if _ip_in_subtree(addr, excl2.ip) {
                        return x509_verify_err_name_constraint();
                    }
                }
                ei2 += 1;
            }
            if perm_has_ip {
                let mut matched2: boolean = false;
                let mut pi2: int = 0;
                loop {
                    if pi2 >= issuer.name_constraints_permitted.length { break; }
                    let perm2: X509NameSubtree = issuer.name_constraints_permitted[pi2];
                    if perm2.form == x509_name_form_ip_address() {
                        if _ip_in_subtree(addr, perm2.ip) {
                            matched2 = true;
                            break;
                        }
                    }
                    pi2 += 1;
                }
                if !matched2 { return x509_verify_err_name_constraint(); }
            }
            ai += 1;
        }

        k += 1;
    }
    return "";
}

struct _IssuerSearch {
    index: int;  // -1 when no candidate was accepted
    reason: string;  // "" when no candidate even matched by name
    detail: string;  // "" unless `reason` carries algorithm-specific context
}

// Find a certificate in `candidates` that may issue `subject`, skipping any
// index already consumed. A candidate must match by issuer/subject name,
// satisfy the CA constraints, be inside its validity window, actually have
// signed `subject`, and satisfy its own nameConstraints against `path` —
// checked in that order so the reported reason is the most specific one.
// Requiring the signature before accepting a candidate is what makes this
// greedy walk safe without backtracking. `path` is every certificate already
// accepted below `subject`, index 0 = leaf, ascending — this is what lets a
// single call check nameConstraints against the whole path a candidate would
// become issuer over, not only `subject` itself.
fn _find_issuer(candidates: X509Certificate[], used: boolean[], subject: X509Certificate, below: int, now_ms: int, path: X509Certificate[]) -> _IssuerSearch {
    let mut reason: string = "";
    let mut detail: string = "";
    let mut i: int = 0;
    loop {
        if i >= candidates.length { break; }
        if used.length > i && used[i] {
            i += 1;
            continue;
        }
        let candidate: X509Certificate = candidates[i];
        if !candidate.ok || !_eq_bytes(candidate.subject_der, subject.issuer_der) {
            i += 1;
            continue;
        }

        let critical: string = _critical_extensions_code(candidate);
        if critical != "" {
            if reason == "" {
                reason = critical;
                detail = "";
            }
            i += 1;
            continue;
        }
        let ca: string = _ca_code(candidate, below);
        if ca != "" {
            if reason == "" {
                reason = ca;
                detail = "";
            }
            i += 1;
            continue;
        }
        let window: string = _window_code(candidate, now_ms);
        if window != "" {
            if reason == "" {
                reason = window;
                detail = "";
            }
            i += 1;
            continue;
        }
        let link: _LinkVerdict = _verify_link(candidate, subject);
        if link.code != "" {
            if reason == "" {
                reason = link.code;
                detail = link.detail;
            }
            i += 1;
            continue;
        }
        let nc: string = _name_constraints_code(candidate, path);
        if nc != "" {
            if reason == "" {
                reason = nc;
                detail = "";
            }
            i += 1;
            continue;
        }
        return _IssuerSearch { index: i, reason: "", detail: "" };
    }
    return _IssuerSearch { index: -1, reason: reason, detail: detail };
}

// Decide whether `leaf` chains to one of `anchors`, optionally through
// `intermediates`. `intermediates` is an unordered bag: order is irrelevant
// and certificates belonging to no path are ignored, so a peer-supplied list
// may be shuffled or padded. `anchors` are trusted a priori, but their own
// validity windows and CA constraints are still enforced — an expired root
// rejects rather than passing on the strength of being configured.
fn x509_verify_chain(leaf: X509Certificate, intermediates: X509Certificate[], anchors: X509Certificate[], options: X509VerifyOptions) -> X509ChainResult {
    if !leaf.ok {
        return _chain_err(x509_verify_err_bad_input(), "x509_verify: leaf did not parse");
    }
    if anchors.length == 0 {
        return _chain_err(x509_verify_err_no_anchor(), "x509_verify: trust store is empty");
    }

    let mut max_depth: int = options.max_depth;
    if max_depth <= 0 { max_depth = x509_verify_default_max_depth(); }

    let leaf_critical: string = _critical_extensions_code(leaf);
    if leaf_critical != "" {
        return _chain_err(leaf_critical, "x509_verify: leaf asserts a critical extension this module does not process");
    }

    // RFC 5280 §4.2.1.10 permits nameConstraints only in CA certificates; a
    // leaf is never a CA in this module's model (`_ca_code`), so a leaf
    // asserting the extension is non-conforming regardless of what it says.
    if leaf.has_name_constraints {
        return _chain_err(x509_verify_err_name_constraint(), "x509_verify: leaf asserts nameConstraints, which RFC 5280 permits only in CA certificates");
    }

    let leaf_window: string = _window_code(leaf, options.now_ms);
    if leaf_window != "" {
        return _chain_err(leaf_window, "x509_verify: leaf is outside its validity window");
    }

    if options.require_server_auth {
        if leaf.has_extended_key_usage && !_has_server_auth_eku(leaf) {
            return _chain_err(x509_verify_err_eku(), "x509_verify: leaf extendedKeyUsage does not permit server authentication");
        }
    }

    let mut used: boolean[] = [];
    let mut u: int = 0;
    loop {
        if u >= intermediates.length { break; }
        used.push(false);
        u += 1;
    }

    let mut current: X509Certificate = leaf;
    let mut depth: int = 0;
    // Every certificate already accepted below `current`, index 0 = leaf,
    // ascending. Threaded into `_find_issuer` so nameConstraints checks
    // against the whole path a candidate would become issuer over, not only
    // `current` itself (SFN-765).
    let mut path: X509Certificate[] = [leaf];

    // Each turn consumes one intermediate, so `intermediates.length + 1` turns
    // is a hard bound even before `max_depth` applies — the walk cannot cycle.
    let mut turns: int = 0;
    loop {
        if turns > intermediates.length {
            return _chain_err(x509_verify_err_path_too_long(), "x509_verify: no path to a trust anchor within the certificate bag");
        }
        turns += 1;

        // Prefer terminating at an anchor over extending through an
        // intermediate, so a cross-signed intermediate cannot lengthen a path
        // that a configured root already closes.
        let anchor_hit: _IssuerSearch = _find_issuer(anchors, [], current, depth, options.now_ms, path);
        if anchor_hit.index >= 0 {
            let anchor: X509Certificate = anchors[anchor_hit.index];
            return X509ChainResult {
                ok: true,
                code: x509_verify_ok(),
                error: "",
                depth: depth,
                anchor_subject_cn: anchor.subject_cn
            };
        }

        if depth >= max_depth {
            return _chain_err(x509_verify_err_path_too_long(), "x509_verify: certification path exceeds the configured depth");
        }

        let inter_hit: _IssuerSearch = _find_issuer(intermediates, used, current, depth, options.now_ms, path);
        if inter_hit.index < 0 {
            // No candidate anywhere could issue `current`. Report the most
            // specific reason either search produced; a bare name miss in both
            // means the chain simply does not reach the trust store.
            let mut reason: string = anchor_hit.reason;
            let mut reason_detail: string = anchor_hit.detail;
            if reason == "" {
                reason = inter_hit.reason;
                reason_detail = inter_hit.detail;
            }
            if reason == "" {
                return _chain_err(x509_verify_err_no_anchor(), "x509_verify: no path from the leaf to a trust anchor");
            }
            if reason_detail != "" {
                return _chain_err(reason, reason_detail);
            }
            return _chain_err(reason, "x509_verify: certification path rejected");
        }

        used[inter_hit.index] = true;
        current = intermediates[inter_hit.index];
        path.push(current);
        depth += 1;
    }
}

export {
    X509ChainResult,
    X509VerifyOptions,
    RsaPublicKey,
