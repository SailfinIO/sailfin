// capsules/sfn/crypto/src/x509.sfn
//
// This module parses X.509 certificates and answers structural questions
// about them. It performs no signature verification and no chain validation.
// Extensions including basicConstraints, keyUsage and extendedKeyUsage are
// parsed and exposed but never enforced. Trust decisions belong to SFN-340.
// Design: SFEP-0048 Phase C; encoding rules: RFC 5280.
import { ascii_lowercase, split } from "sfn/strings";

import {
    DerLimits,
    DerTextResult,
    DerTlv,
    der_ascii_text,
    der_bit_string_bytes,
    der_bit_string_unused,
    der_boolean,
    der_check_structure,
    der_context_number,
    der_default_limits,
    der_integer_bytes,
    der_integer_small,
    der_is_context,
    der_octet_string_bytes,
    der_oid_string,
    der_read_tlv,
    der_tag_bit_string,
    der_tag_boolean,
    der_tag_integer,
    der_tag_octet_string,
    der_tag_oid,
    der_tag_sequence,
    der_tag_set,
    der_time_millis
} from "./der";

// ── Well-known OIDs ──
fn x509_oid_common_name() -> string { return "2.5.4.3"; }

fn x509_oid_subject_alt_name() -> string { return "2.5.29.17"; }

fn x509_oid_basic_constraints() -> string { return "2.5.29.19"; }

fn x509_oid_key_usage() -> string { return "2.5.29.15"; }

fn x509_oid_extended_key_usage() -> string { return "2.5.29.37"; }

fn x509_oid_ed25519() -> string { return "1.3.101.112"; }

fn x509_oid_ecdsa_p256_sha256() -> string { return "1.2.840.10045.4.3.2"; }

fn x509_oid_rsa_encryption() -> string { return "1.2.840.113549.1.1.1"; }

fn x509_oid_eku_server_auth() -> string { return "1.3.6.1.5.5.7.3.1"; }

fn x509_oid_eku_client_auth() -> string { return "1.3.6.1.5.5.7.3.2"; }

fn x509_oid_name_constraints() -> string { return "2.5.29.30"; }

// GeneralName context-tag numbers this module decodes inside nameConstraints
// subtrees (RFC 5280 §4.2.1.10). Every other GeneralName form is recorded with
// `form` set to its context number and empty `dns`/`ip`; the verifier is the
// one that rejects an unsupported form (SFN-765).
fn x509_name_form_dns_name() -> int { return 2; }

fn x509_name_form_ip_address() -> int { return 7; }

// RFC 5280 profiles a handful of extensions; real certificates carry well under
// 20. The cap bounds both the duplicate-OID scan (which is linear per extension,
// so quadratic overall) and the memory held by `extensions`, neither of which
// max_input_len bounds usefully on its own (SFN-504).
fn _max_extensions() -> int { return 64; }

// ── tbsCertificate context-specific tags. The two 130s are genuinely
// different types in different containers (subjectUniqueID vs. a GeneralName
// dNSName); two names for the same octet is the point (SFN-504). ──
fn _tag_version() -> int {
    return 160;
}  // [0] EXPLICIT Version, constructed

fn _tag_issuer_unique_id() -> int {
    return 129;
}  // [1] IMPLICIT, primitive

fn _tag_subject_unique_id() -> int {
    return 130;
}  // [2] IMPLICIT, primitive

fn _tag_extensions() -> int {
    return 163;
}  // [3] EXPLICIT Extensions, constructed

fn _tag_dns_name() -> int {
    return 130;
}  // [2] IMPLICIT IA5String in GeneralName

fn _tag_ip_address() -> int {
    return 135;
}  // [7] IMPLICIT OCTET STRING in GeneralName, primitive

// nameConstraints GeneralSubtrees wrappers (RFC 5280 §4.2.1.10): both are
// IMPLICIT constructed, [0] permittedSubtrees and [1] excludedSubtrees.
fn _tag_nc_permitted() -> int { return 160; }

fn _tag_nc_excluded() -> int { return 161; }

// ── KeyUsage bit accessors (RFC 5280 §4.2.1.3). Reported, never enforced. ──
fn x509_key_usage_digital_signature() -> int { return 1; }

fn x509_key_usage_non_repudiation() -> int { return 2; }

fn x509_key_usage_key_encipherment() -> int { return 4; }

fn x509_key_usage_data_encipherment() -> int { return 8; }

fn x509_key_usage_key_agreement() -> int { return 16; }

fn x509_key_usage_key_cert_sign() -> int { return 32; }

fn x509_key_usage_crl_sign() -> int { return 64; }

fn x509_key_usage_encipher_only() -> int { return 128; }

fn x509_key_usage_decipher_only() -> int { return 256; }

// RFC 5280 profiles a handful of subtrees per list; real technically-
// constrained CAs carry well under this. The cap bounds the memory a crafted
// certificate can force `name_constraints_permitted`/`_excluded` to hold,
// mirroring `_max_extensions()` (SFN-765).
fn _max_name_subtrees() -> int { return 64; }

// A SAN iPAddress GeneralName. Wrapped rather than a bare `int[]` so
// `X509Certificate.ip_addresses` is an array-of-struct, not `int[][]`, which
// Sailfin structs cannot hold directly (SFN-765).
struct X509IpAddress {
    bytes: int[];
}

// One `GeneralSubtree.base` from a nameConstraints extension (RFC 5280
// §4.2.1.10). `form` is the GeneralName context-tag number
// (`x509_name_form_dns_name()`/`x509_name_form_ip_address()`), or -1 for a
// base that was not a context-tagged GeneralName at all. A form this parser
// does not decode is recorded with empty `dns`/`ip` rather than a parse
// failure — a non-critical nameConstraints extension asserting an
// unsupported form must not break parsing; the verifier rejects it instead.
struct X509NameSubtree {
    form: int;
    dns: string;
    ip: int[];
}

struct X509Extension {
    oid: string;  // dotted decimal
    critical: boolean;
    // extnValue OCTET STRING content, verbatim. der_check_structure's depth
    // cap does not cover this: x509_parse_with_limits runs it once over the
    // whole certificate before parsing begins, and this DER is only skipped
    // over there since extensions are read as opaque OCTET STRING content. A
    // caller walking this inner DER should run der_check_structure on it
    // first (SFN-504).
    value_der: int[];
}

struct X509Certificate {
    ok: boolean;
    error: string;

    version: int;  // 1, 2 or 3; 1 when the [0] EXPLICIT Version is absent
    serial: int[];  // INTEGER content bytes, big-endian, opaque
    signature_algorithm: string;  // tbsCertificate.signature algorithm OID
    signature_algorithm_outer: string;  // Certificate.signatureAlgorithm OID
    // The AlgorithmIdentifier `parameters` field of each of the two signature
    // AlgorithmIdentifiers, verbatim (identifier and length octets included),
    // empty when the field is absent. RSASSA-PSS carries its hash, mask-gen
    // function and salt length here (RFC 4055 3.1), so a verifier that reads
    // only the OID cannot know which profile it is being asked to check —
    // hence both are retained rather than stepped over (SFN-824). Opaque to
    // this module: parsed, never interpreted here.
    signature_algorithm_params: int[];
    signature_algorithm_params_outer: int[];
    // tbsCertificate TLV verbatim, identifier and length octets included: the
    // exact byte range a certificate signature is computed over (RFC 5280
    // 4.1.1.3). Exposed, never checked here.
    tbs_der: int[];
    signature_value: int[];  // signatureValue BIT STRING content, unused-bits octet removed
    issuer_der: int[];  // the issuer Name TLV verbatim, header included
    subject_der: int[];  // the subject Name TLV verbatim, header included
    issuer_cn: string;  // last commonName attribute, "" when absent
    subject_cn: string;
    not_before_ms: int;  // signed Unix milliseconds
    not_after_ms: int;
    spki_algorithm: string;  // SubjectPublicKeyInfo algorithm OID
    spki_key: int[];  // subjectPublicKey BIT STRING, unused-bits octet removed
    dns_names: string[];  // SAN dNSName entries, verbatim (not case-folded)
    ip_addresses: X509IpAddress[];  // SAN iPAddress entries, verbatim
    has_basic_constraints: boolean;
    is_ca: boolean;  // parsed, never enforced
    path_len_constraint: int;  // -1 when absent
    has_key_usage: boolean;
    key_usage_bits: int;  // parsed, never enforced
    has_extended_key_usage: boolean;
    extended_key_usages: string[];  // dotted OIDs, parsed, never enforced
    has_name_constraints: boolean;
    name_constraints_permitted: X509NameSubtree[];  // parsed, enforced by x509_verify.sfn
    name_constraints_excluded: X509NameSubtree[];
    extensions: X509Extension[];  // every extension in wire order
}

// A fully-populated failed certificate. There is no struct update syntax, and
// callers read every field unconditionally, so a failure path must still
// spell out empty/0/-1/"" defaults rather than leaving a field unset.
fn _failed(message: string) -> X509Certificate {
    return X509Certificate {
        ok: false,
        error: message,
        version: 0,
        serial: [],
        signature_algorithm: "",
        signature_algorithm_outer: "",
        signature_algorithm_params: [],
        signature_algorithm_params_outer: [],
        tbs_der: [],
        signature_value: [],
        issuer_der: [],
        subject_der: [],
        issuer_cn: "",
        subject_cn: "",
        not_before_ms: 0,
        not_after_ms: 0,
        spki_algorithm: "",
        spki_key: [],
        dns_names: [],
        ip_addresses: [],
        has_basic_constraints: false,
        is_ca: false,
        path_len_constraint: -1,
        has_key_usage: false,
        key_usage_bits: 0,
        has_extended_key_usage: false,
        extended_key_usages: [],
        has_name_constraints: false,
        name_constraints_permitted: [],
        name_constraints_excluded: [],
        extensions: []
    };
}

fn _text_err(message: string) -> DerTextResult {
    return DerTextResult { ok: false, error: message, value: "" };
}

fn _text_ok(value: string) -> DerTextResult {
    return DerTextResult { ok: true, error: "", value: value };
}

// Extract `len` bytes starting at `off`, verbatim. `.slice()` is a no-op stub
// (runtime/sfn/array.sfn:463); der.sfn's copy of this helper is module-
// private, so x509.sfn hand-rolls its own (precedent: tls13_handshake_codec.sfn
// `_slice`).
fn _slice(buf: int[], off: int, len: int) -> int[] {
    let empty: int[] = [];
    if off < 0 || len < 0 || off + len > buf.length { return empty; }
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= len { break; }
        out.push(buf[off + i] & 255);
        i += 1;
    }
    return out;
}

// Render one byte as a printable-ASCII character. Sailfin string indexing is
// byte-oriented, so this 95-character table (bytes [32, 126]) doubles as a
// byte-to-character map. Used only for subjectAltName dNSName rendering,
// which validates its own byte range ([33, 126]) before calling this.
fn _byte_to_char(b: int) -> string {
    let table: string = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    return table[b - 32];
}

// The last commonName attribute value in a Name, ASCII-rendered. "" when the
// Name carries no commonName. A Name is a SEQUENCE OF RelativeDistinguishedName
// (SET OF AttributeTypeAndValue), RFC 5280 §4.1.2.4.
fn _name_common_name(buf: int[], name: DerTlv) -> DerTextResult {
    if !name.ok { return _text_err(name.error); }
    if name.tag != der_tag_sequence() {
        return _text_err("x509: expected Name SEQUENCE");
    }
    let mut cn: string = "";
    let mut rdn_cur: int = name.content_off;
    let rdn_end: int = name.end_off;
    loop {
        if rdn_cur >= rdn_end { break; }
        let rdn: DerTlv = der_read_tlv(buf, rdn_cur, rdn_end);
        if !rdn.ok { return _text_err(rdn.error); }
        if rdn.end_off <= rdn_cur {
            return _text_err("x509: parser made no progress");
        }
        if rdn.tag != der_tag_set() {
            return _text_err("x509: expected RelativeDistinguishedName SET");
        }
        let mut atv_cur: int = rdn.content_off;
        let atv_end: int = rdn.end_off;
        loop {
            if atv_cur >= atv_end { break; }
            let atv: DerTlv = der_read_tlv(buf, atv_cur, atv_end);
            if !atv.ok { return _text_err(atv.error); }
            if atv.end_off <= atv_cur {
                return _text_err("x509: parser made no progress");
            }
            if atv.tag != der_tag_sequence() {
                return _text_err("x509: expected AttributeTypeAndValue SEQUENCE");
            }
            let type_tlv: DerTlv = der_read_tlv(buf, atv.content_off, atv.end_off);
            if !type_tlv.ok { return _text_err(type_tlv.error); }
            let type_res = der_oid_string(buf, type_tlv);
            if !type_res.ok { return _text_err(type_res.error); }
            // AttributeTypeAndValue ::= SEQUENCE { type, value } has fixed
            // arity — exactly these two children, unlike its RDN SET and Name
            // SEQUENCE OF parents, which legitimately hold many (SFN-504).
            let value_tlv: DerTlv = der_read_tlv(buf, type_tlv.end_off, atv.end_off);
            if !value_tlv.ok { return _text_err(value_tlv.error); }
            if value_tlv.end_off != atv.end_off {
                return _text_err("x509: unexpected trailing data in name attribute");
            }
            if strings_equal(type_res.value, x509_oid_common_name()) {
                // A non-ASCII commonName is not a parse failure: commonName is
                // not used for any decision here (RFC 6125 §6.4.4, see
                // x509_hostname_matches), so record "" and keep walking rather
                // than fail the whole certificate.
                let rendered = der_ascii_text(buf, value_tlv);
                if rendered.ok { cn = rendered.value; } else { cn = ""; }
            }
            atv_cur = atv.end_off;
        }
        rdn_cur = rdn.end_off;
    }
    return _text_ok(cn);
}

// ── nameConstraints (RFC 5280 §4.2.1.10) ──
struct _SubtreesResult {
    ok: boolean;
    error: string;
    value: X509NameSubtree[];
}

fn _subtrees_err(message: string) -> _SubtreesResult {
    let empty: X509NameSubtree[] = [];
    return _SubtreesResult { ok: false, error: message, value: empty };
}

struct _SubtreeResult {
    ok: boolean;
    error: string;
    value: X509NameSubtree;
}

fn _subtree_err(message: string) -> _SubtreeResult {
    let empty_ip: int[] = [];
    return _SubtreeResult {
        ok: false,
        error: message,
        value: X509NameSubtree { form: -1, dns: "", ip: empty_ip }
    };
}

// Mask octets form a contiguous high-bit prefix (RFC 4632 CIDR shape) when,
// read most-significant-bit first, every 1 bit precedes every 0 bit. A
// non-contiguous mask makes `_ip_in_subtree`'s bitwise comparison ambiguous,
// so it is rejected at parse time rather than matched loosely (SFN-765).
fn _mask_is_contiguous(mask: int[]) -> boolean {
    let mut seen_zero: boolean = false;
    let mut i: int = 0;
    loop {
        if i >= mask.length { break; }
        let byte_val: int = mask[i] & 255;
        let mut bit: int = 7;
        loop {
            if bit < 0 { break; }
            let is_one: boolean = (byte_val & (1 << bit)) != 0;
            if is_one {
                if seen_zero { return false; }
            } else { seen_zero = true; }
            bit -= 1;
        }
        i += 1;
    }
    return true;
}

// Decode a `GeneralSubtree.base` GeneralName. dNSName and iPAddress are the
// only forms this module enforces; every other form is recorded with its
// context number (or -1 when it is not context-tagged at all) and empty
// `dns`/`ip` — a parse-time success, since a non-critical nameConstraints
// asserting an unsupported form must not break parsing. The verifier is what
// rejects it (SFN-765).
fn _decode_general_name_base(buf: int[], base: DerTlv) -> _SubtreeResult {
    if base.tag == _tag_dns_name() {
        if base.content_len == 0 {
            return _subtree_err("x509: nameConstraints dNSName subtree must not be empty");
        }
        let mut name: string = "";
        let mut k: int = 0;
        loop {
            if k >= base.content_len { break; }
            let b: int = buf[base.content_off + k] & 255;
            if b < 33 || b > 126 {
                return _subtree_err("x509: nameConstraints dNSName contains a non-printable byte");
            }
            name = name + _byte_to_char(b);
            k += 1;
        }
        // A leading or trailing "." (or an internal empty label, "a..b")
        // parses as a well-formed IA5String but produces an empty label once
        // split, and `x509_dns_constraint_matches` fails closed on an empty
        // label unconditionally — including on the excluded side, where that
        // silently drops the exclusion instead of enforcing it (SFN-765
        // review F1: both OpenSSL and Go honour the leading-dot form; this
        // parser does not implement that semantic, so it refuses the subtree
        // outright rather than accept a value the matcher can never use).
        let labels: string[] = split(name, ".");
        let mut li: int = 0;
        loop {
            if li >= labels.length { break; }
            if labels[li].length == 0 {
                return _subtree_err("x509: nameConstraints dNSName subtree has an empty label");
            }
            li += 1;
        }
        let empty_ip: int[] = [];
        return _SubtreeResult {
            ok: true,
            error: "",
            value: X509NameSubtree {
                form: x509_name_form_dns_name(),
                dns: name,
                ip: empty_ip
            }
        };
    }
    if base.tag == _tag_ip_address() {
        if base.content_len != 8 && base.content_len != 32 {
            return _subtree_err("x509: nameConstraints iPAddress subtree has an invalid length");
        }
        let half: int = base.content_len / 2;
        let mask: int[] = _slice(buf, base.content_off + half, half);
        if !_mask_is_contiguous(mask) {
            return _subtree_err("x509: nameConstraints iPAddress subtree mask is not contiguous");
        }
        let addr_and_mask: int[] = _slice(buf, base.content_off, base.content_len);
        return _SubtreeResult {
            ok: true,
            error: "",
            value: X509NameSubtree {
                form: x509_name_form_ip_address(),
                dns: "",
                ip: addr_and_mask
            }
        };
    }
    let mut form: int = -1;
    if der_is_context(base.tag) {
        let number: int = der_context_number(base.tag);
        // Reaching this fallback with a context number that coincides with a
        // form this module supports (2 or 7) means the encoding did not
        // match `_tag_dns_name()`/`_tag_ip_address()` above — e.g. a
        // constructed `0xA2`/`0xA7` instead of the IMPLICIT primitive DER
        // requires — so it is not a value this parser knows how to decode.
        // Recording `number` here would set a supported-looking `form` on a
        // subtree whose `dns`/`ip` is empty, which the verifier's scan reads
        // as usable and silently fails to match — the fail-open SFN-765
        // review F2 exists to close. Leaving `form = -1` keeps `form ∈ {2,
        // 7}` an invariant that the value is actually usable.
        if number != x509_name_form_dns_name() && number != x509_name_form_ip_address() {
            form = number;
        }
    }
    let empty_ip2: int[] = [];
    return _SubtreeResult {
        ok: true,
        error: "",
        value: X509NameSubtree { form: form, dns: "", ip: empty_ip2 }
    };
}

// Decode one permittedSubtrees/excludedSubtrees GeneralSubtrees list.
// `wrap` is the IMPLICIT constructed [0]/[1] wrapper; its children are
// `GeneralSubtree ::= SEQUENCE { base GeneralName, minimum [0] DEFAULT 0,
// maximum [1] OPTIONAL }`. Any element after `base` is a parse failure: DER's
// default-encoding rule already forbids an encoded `minimum` of 0, so any
// presence of either is non-conforming (RFC 5280 §4.2.1.10).
fn _general_subtrees(buf: int[], wrap: DerTlv) -> _SubtreesResult {
    let mut out: X509NameSubtree[] = [];
    let mut cur: int = wrap.content_off;
    let end: int = wrap.end_off;
    loop {
        if cur >= end { break; }
        let gs: DerTlv = der_read_tlv(buf, cur, end);
        if !gs.ok { return _subtrees_err(gs.error); }
        if gs.end_off <= cur {
            return _subtrees_err("x509: parser made no progress");
        }
        if gs.tag != der_tag_sequence() {
            return _subtrees_err("x509: unexpected nameConstraints field");
        }
        if out.length >= _max_name_subtrees() {
            return _subtrees_err("x509: too many nameConstraints subtrees");
        }
        let base_tlv: DerTlv = der_read_tlv(buf, gs.content_off, gs.end_off);
        if !base_tlv.ok { return _subtrees_err(base_tlv.error); }
        if base_tlv.end_off != gs.end_off {
            return _subtrees_err("x509: nameConstraints minimum/maximum is not permitted");
        }
        let subtree_res: _SubtreeResult = _decode_general_name_base(buf, base_tlv);
        if !subtree_res.ok { return _subtrees_err(subtree_res.error); }
        out.push(subtree_res.value);
        cur = gs.end_off;
    }
    if out.length == 0 {
        return _subtrees_err("x509: nameConstraints GeneralSubtrees must not be empty");
    }
    return _SubtreesResult { ok: true, error: "", value: out };
}

fn x509_parse(der: int[]) -> X509Certificate {
    return x509_parse_with_limits(der, der_default_limits());
}

fn x509_parse_with_limits(der: int[], limits: DerLimits) -> X509Certificate {
    let guard = der_check_structure(der, limits);
    if !guard.ok { return _failed(guard.error); }

    let outer: DerTlv = der_read_tlv(der, 0, der.length);
    if !outer.ok { return _failed(outer.error); }
    if outer.tag != der_tag_sequence() {
        return _failed("x509: expected certificate SEQUENCE");
    }
    if outer.end_off != der.length {
        return _failed("x509: trailing data after certificate");
    }

    // Certificate ::= SEQUENCE { tbsCertificate, signatureAlgorithm, signatureValue }
    let tbs: DerTlv = der_read_tlv(der, outer.content_off, outer.end_off);
    if !tbs.ok { return _failed(tbs.error); }
    if tbs.tag != der_tag_sequence() {
        return _failed("x509: expected tbsCertificate SEQUENCE");
    }
    let sig_alg_outer: DerTlv = der_read_tlv(der, tbs.end_off, outer.end_off);
    if !sig_alg_outer.ok { return _failed(sig_alg_outer.error); }
    if sig_alg_outer.tag != der_tag_sequence() {
        return _failed("x509: expected signatureAlgorithm SEQUENCE");
    }
    let sig_value: DerTlv = der_read_tlv(der, sig_alg_outer.end_off, outer.end_off);
    if !sig_value.ok { return _failed(sig_value.error); }
    if sig_value.tag != der_tag_bit_string() {
        return _failed("x509: expected signatureValue BIT STRING");
    }
    if sig_value.end_off != outer.end_off {
        return _failed("x509: unexpected trailing field in certificate");
    }

    let outer_alg_oid_tlv: DerTlv = der_read_tlv(der, sig_alg_outer.content_off, sig_alg_outer.end_off);
    if !outer_alg_oid_tlv.ok { return _failed(outer_alg_oid_tlv.error); }
    let outer_alg_res = der_oid_string(der, outer_alg_oid_tlv);
    if !outer_alg_res.ok { return _failed(outer_alg_res.error); }
    let signature_algorithm_outer: string = outer_alg_res.value;
    let signature_algorithm_params_outer: int[] = _slice(der, outer_alg_oid_tlv.end_off, sig_alg_outer.end_off - outer_alg_oid_tlv.end_off);

    let tbs_der: int[] = _slice(der, outer.content_off, tbs.end_off - outer.content_off);

    let sig_unused_res = der_bit_string_unused(der, sig_value);
    if !sig_unused_res.ok { return _failed(sig_unused_res.error); }
    if sig_unused_res.value != 0 {
        return _failed("x509: signature value is not byte-aligned");
    }
    let sig_bytes_res = der_bit_string_bytes(der, sig_value);
    if !sig_bytes_res.ok { return _failed(sig_bytes_res.error); }
    let signature_value: int[] = sig_bytes_res.value;

    // The signature is exposed above but never checked here: this module still
    // makes no trust decision (SFN-340 owns chain verification).
    let tbs_end: int = tbs.end_off;
    let mut cur: int = tbs.content_off;

    // optional [0] EXPLICIT Version
    let mut version: int = 1;
    let mut peek: DerTlv = der_read_tlv(der, cur, tbs_end);
    if !peek.ok { return _failed(peek.error); }
    if peek.tag == _tag_version() {
        let v_child: DerTlv = der_read_tlv(der, peek.content_off, peek.end_off);
        if !v_child.ok { return _failed(v_child.error); }
        let v_int = der_integer_small(der, v_child);
        if !v_int.ok { return _failed(v_int.error); }
        version = v_int.value + 1;
        if version < 1 || version > 3 {
            return _failed("x509: unsupported certificate version");
        }
        if v_child.end_off != peek.end_off {
            return _failed("x509: unexpected trailing data in version");
        }
        cur = peek.end_off;
        peek = der_read_tlv(der, cur, tbs_end);
        if !peek.ok { return _failed(peek.error); }
    }

    // serialNumber INTEGER
    if peek.tag != der_tag_integer() {
        return _failed("x509: unexpected tbsCertificate field");
    }
    let serial_res = der_integer_bytes(der, peek);
    if !serial_res.ok { return _failed(serial_res.error); }
    let serial: int[] = serial_res.value;
    cur = peek.end_off;

    // signature AlgorithmIdentifier SEQUENCE
    peek = der_read_tlv(der, cur, tbs_end);
    if !peek.ok { return _failed(peek.error); }
    if peek.tag != der_tag_sequence() {
        return _failed("x509: unexpected tbsCertificate field");
    }
    let sig_oid_tlv: DerTlv = der_read_tlv(der, peek.content_off, peek.end_off);
    if !sig_oid_tlv.ok { return _failed(sig_oid_tlv.error); }
    let sig_oid_res = der_oid_string(der, sig_oid_tlv);
    if !sig_oid_res.ok { return _failed(sig_oid_res.error); }
    let signature_algorithm: string = sig_oid_res.value;
    let signature_algorithm_params: int[] = _slice(der, sig_oid_tlv.end_off, peek.end_off - sig_oid_tlv.end_off);
    cur = peek.end_off;

    // issuer Name
    peek = der_read_tlv(der, cur, tbs_end);
    if !peek.ok { return _failed(peek.error); }
    if peek.tag != der_tag_sequence() {
        return _failed("x509: unexpected tbsCertificate field");
    }
    let issuer_der: int[] = _slice(der, cur, peek.end_off - cur);
    let issuer_cn_res = _name_common_name(der, peek);
    if !issuer_cn_res.ok { return _failed(issuer_cn_res.error); }
    let issuer_cn: string = issuer_cn_res.value;
    cur = peek.end_off;

    // validity SEQUENCE { notBefore, notAfter }
    peek = der_read_tlv(der, cur, tbs_end);
    if !peek.ok { return _failed(peek.error); }
    if peek.tag != der_tag_sequence() {
        return _failed("x509: unexpected tbsCertificate field");
    }
    let v_end: int = peek.end_off;
    let nb_tlv: DerTlv = der_read_tlv(der, peek.content_off, v_end);
    if !nb_tlv.ok { return _failed(nb_tlv.error); }
    let nb_res = der_time_millis(der, nb_tlv);
    if !nb_res.ok { return _failed(nb_res.error); }
    let not_before_ms: int = nb_res.value;
    let na_tlv: DerTlv = der_read_tlv(der, nb_tlv.end_off, v_end);
    if !na_tlv.ok { return _failed(na_tlv.error); }
    let na_res = der_time_millis(der, na_tlv);
    if !na_res.ok { return _failed(na_res.error); }
    let not_after_ms: int = na_res.value;
    if not_after_ms < not_before_ms {
        return _failed("x509: validity window ends before it begins");
    }
    if na_tlv.end_off != v_end {
        return _failed("x509: unexpected trailing data in validity");
    }
    cur = peek.end_off;

    // subject Name
    peek = der_read_tlv(der, cur, tbs_end);
    if !peek.ok { return _failed(peek.error); }
    if peek.tag != der_tag_sequence() {
        return _failed("x509: unexpected tbsCertificate field");
    }
    let subject_der: int[] = _slice(der, cur, peek.end_off - cur);
    let subject_cn_res = _name_common_name(der, peek);
    if !subject_cn_res.ok { return _failed(subject_cn_res.error); }
    let subject_cn: string = subject_cn_res.value;
    cur = peek.end_off;

    // subjectPublicKeyInfo SEQUENCE { algorithm, subjectPublicKey }
    peek = der_read_tlv(der, cur, tbs_end);
    if !peek.ok { return _failed(peek.error); }
    if peek.tag != der_tag_sequence() {
        return _failed("x509: unexpected tbsCertificate field");
    }
    let spki_end: int = peek.end_off;
    let spki_alg_outer: DerTlv = der_read_tlv(der, peek.content_off, spki_end);
    if !spki_alg_outer.ok { return _failed(spki_alg_outer.error); }
    if spki_alg_outer.tag != der_tag_sequence() {
        return _failed("x509: expected SubjectPublicKeyInfo algorithm SEQUENCE");
    }
    let spki_oid_tlv: DerTlv = der_read_tlv(der, spki_alg_outer.content_off, spki_alg_outer.end_off);
    if !spki_oid_tlv.ok { return _failed(spki_oid_tlv.error); }
    let spki_oid_res = der_oid_string(der, spki_oid_tlv);
    if !spki_oid_res.ok { return _failed(spki_oid_res.error); }
    let spki_algorithm: string = spki_oid_res.value;
    let spki_bits_tlv: DerTlv = der_read_tlv(der, spki_alg_outer.end_off, spki_end);
    if !spki_bits_tlv.ok { return _failed(spki_bits_tlv.error); }
    if spki_bits_tlv.tag != der_tag_bit_string() {
        return _failed("x509: expected subjectPublicKey BIT STRING");
    }
    let spki_unused_res = der_bit_string_unused(der, spki_bits_tlv);
    if !spki_unused_res.ok { return _failed(spki_unused_res.error); }
    if spki_unused_res.value != 0 {
        return _failed("x509: subject public key is not byte-aligned");
    }
    let spki_key_res = der_bit_string_bytes(der, spki_bits_tlv);
    if !spki_key_res.ok { return _failed(spki_key_res.error); }
    let spki_key: int[] = spki_key_res.value;
    if spki_bits_tlv.end_off != spki_end {
        return _failed("x509: unexpected trailing data in subjectPublicKeyInfo");
    }
    cur = peek.end_off;

    // Remaining optional fields, in order: [1]/[2] IMPLICIT unique IDs
    // (skipped, not exposed) and [3] EXPLICIT Extensions.
    let mut has_basic_constraints: boolean = false;
    let mut is_ca: boolean = false;
    let mut path_len_constraint: int = -1;
    let mut has_key_usage: boolean = false;
    let mut key_usage_bits_val: int = 0;
    let mut has_extended_key_usage: boolean = false;
    let mut extended_key_usages: string[] = [];
    let mut dns_names: string[] = [];
    let mut ip_addresses: X509IpAddress[] = [];
    let mut has_name_constraints: boolean = false;
    let mut name_constraints_permitted: X509NameSubtree[] = [];
    let mut name_constraints_excluded: X509NameSubtree[] = [];
    let mut extensions: X509Extension[] = [];
    let mut seen_oids: string[] = [];

    // A monotonic stage counter enforces both the field order and that each
    // optional trailing field appears at most once, so a crafted second `[3]`
    // Extensions block cannot smuggle a second, attacker-chosen
    // subjectAltName past this loop (SFN-504).
    let mut stage: int = 1;

    loop {
        if cur >= tbs_end { break; }
        let field: DerTlv = der_read_tlv(der, cur, tbs_end);
        if !field.ok { return _failed(field.error); }
        if field.end_off <= cur {
            return _failed("x509: parser made no progress");
        }
        if field.tag == _tag_issuer_unique_id() {
            if stage > 1 {
                return _failed("x509: unexpected tbsCertificate field");
            }
            stage = 2;
            cur = field.end_off;
            continue;
        }
        if field.tag == _tag_subject_unique_id() {
            if stage > 2 {
                return _failed("x509: unexpected tbsCertificate field");
            }
            stage = 3;
            cur = field.end_off;
            continue;
        }
        if field.tag != _tag_extensions() {
            return _failed("x509: unexpected tbsCertificate field");
        }
        if stage > 3 {
            return _failed("x509: unexpected tbsCertificate field");
        }
        stage = 4;

        // [3] EXPLICIT Extensions ::= SEQUENCE OF Extension
        let ext_seq: DerTlv = der_read_tlv(der, field.content_off, field.end_off);
        if !ext_seq.ok { return _failed(ext_seq.error); }
        if ext_seq.tag != der_tag_sequence() {
            return _failed("x509: expected Extensions SEQUENCE");
        }
        if ext_seq.end_off != field.end_off {
            return _failed("x509: unexpected trailing data in extensions");
        }
        let mut ext_cur: int = ext_seq.content_off;
        let ext_end: int = ext_seq.end_off;
        loop {
            if ext_cur >= ext_end { break; }
            let ext_tlv: DerTlv = der_read_tlv(der, ext_cur, ext_end);
            if !ext_tlv.ok { return _failed(ext_tlv.error); }
            if ext_tlv.end_off <= ext_cur {
                return _failed("x509: parser made no progress");
            }
            if ext_tlv.tag != der_tag_sequence() {
                return _failed("x509: unexpected extension field");
            }

            // Extension ::= SEQUENCE { extnID OID, critical BOOLEAN DEFAULT
            // FALSE, extnValue OCTET STRING }
            let e_end: int = ext_tlv.end_off;
            let oid_tlv: DerTlv = der_read_tlv(der, ext_tlv.content_off, e_end);
            if !oid_tlv.ok { return _failed(oid_tlv.error); }
            let oid_res = der_oid_string(der, oid_tlv);
            if !oid_res.ok { return _failed(oid_res.error); }
            let oid: string = oid_res.value;

            // Checked before the dedup scan and before the push below, so
            // neither the O(n) scan nor the `extensions`/`seen_oids` arrays
            // can be driven past the cap (SFN-504).
            if extensions.length >= _max_extensions() {
                return _failed("x509: too many extensions");
            }

            // RFC 5280 §4.2: a certificate MUST NOT include more than one
            // instance of a particular extension. This generalizes over every
            // extension, not only the four this parser interprets below.
            let mut dup: boolean = false;
            let mut si: int = 0;
            loop {
                if si >= seen_oids.length { break; }
                if strings_equal(seen_oids[si], oid) {
                    dup = true;
                    break;
                }
                si += 1;
            }
            if dup { return _failed("x509: duplicate extension"); }
            seen_oids.push(oid);

            let mut critical: boolean = false;
            let mut value_peek: DerTlv = der_read_tlv(der, oid_tlv.end_off, e_end);
            if !value_peek.ok { return _failed(value_peek.error); }
            if value_peek.tag == der_tag_boolean() {
                let critical_res = der_boolean(der, value_peek);
                if !critical_res.ok { return _failed(critical_res.error); }
                critical = critical_res.value;
                value_peek = der_read_tlv(der, value_peek.end_off, e_end);
                if !value_peek.ok { return _failed(value_peek.error); }
            }
            if value_peek.tag != der_tag_octet_string() {
                return _failed("x509: unexpected extension field");
            }
            let value_res = der_octet_string_bytes(der, value_peek);
            if !value_res.ok { return _failed(value_res.error); }
            let value_der: int[] = value_res.value;
            if value_peek.end_off != e_end {
                return _failed("x509: unexpected trailing data in extension");
            }

            extensions.push(X509Extension {
                oid: oid, critical: critical, value_der: value_der
            });

            if strings_equal(oid, x509_oid_subject_alt_name()) {
                let gn_seq: DerTlv = der_read_tlv(value_der, 0, value_der.length);
                if !gn_seq.ok { return _failed(gn_seq.error); }
                if gn_seq.tag != der_tag_sequence() {
                    return _failed("x509: unexpected subjectAltName field");
                }
                if gn_seq.end_off != value_der.length {
                    return _failed("x509: unexpected trailing data in extension value");
                }
                let mut gn_cur: int = gn_seq.content_off;
                let gn_end: int = gn_seq.end_off;
                loop {
                    if gn_cur >= gn_end { break; }
                    let gn_tlv: DerTlv = der_read_tlv(value_der, gn_cur, gn_end);
                    if !gn_tlv.ok { return _failed(gn_tlv.error); }
                    if gn_tlv.end_off <= gn_cur {
                        return _failed("x509: parser made no progress");
                    }
                    if gn_tlv.tag == _tag_dns_name() {
                        // [2] IMPLICIT IA5String dNSName, primitive.
                        let mut name: string = "";
                        let mut k: int = 0;
                        loop {
                            if k >= gn_tlv.content_len { break; }
                            let b: int = value_der[gn_tlv.content_off + k] & 255;
                            if b < 33 || b > 126 {
                                return _failed("x509: subjectAltName dNSName contains a non-printable byte");
                            }
                            name = name + _byte_to_char(b);
                            k += 1;
                        }
                        dns_names.push(name);
                    } else if gn_tlv.tag == _tag_ip_address() {
                        // [7] IMPLICIT OCTET STRING iPAddress, primitive: an
                        // IPv4 (4 octets) or IPv6 (16 octets) address, nothing
                        // else (RFC 5280 §4.2.1.6).
                        if gn_tlv.content_len != 4 && gn_tlv.content_len != 16 {
                            return _failed("x509: subjectAltName iPAddress has an invalid length");
                        }
                        ip_addresses.push(X509IpAddress {
                            bytes: _slice(value_der, gn_tlv.content_off, gn_tlv.content_len)
                        });
                    }
                    // Any other GeneralName tag (rfc822Name, otherName, ...)
                    // is out of scope: skipped, not an error.
                    gn_cur = gn_tlv.end_off;
                }
            } else if strings_equal(oid, x509_oid_basic_constraints()) {
                has_basic_constraints = true;
                let bc_seq: DerTlv = der_read_tlv(value_der, 0, value_der.length);
                if !bc_seq.ok { return _failed(bc_seq.error); }
                if bc_seq.tag != der_tag_sequence() {
                    return _failed("x509: unexpected basicConstraints field");
                }
                if bc_seq.end_off != value_der.length {
                    return _failed("x509: unexpected trailing data in extension value");
                }
                let mut bc_cur: int = bc_seq.content_off;
                let bc_end: int = bc_seq.end_off;
                if bc_cur < bc_end {
                    let bc_peek: DerTlv = der_read_tlv(value_der, bc_cur, bc_end);
                    if !bc_peek.ok { return _failed(bc_peek.error); }
                    if bc_peek.tag == der_tag_boolean() {
                        let ca_res = der_boolean(value_der, bc_peek);
                        if !ca_res.ok { return _failed(ca_res.error); }
                        is_ca = ca_res.value;
                        bc_cur = bc_peek.end_off;
                    }
                }
                if bc_cur < bc_end {
                    let pl_peek: DerTlv = der_read_tlv(value_der, bc_cur, bc_end);
                    if !pl_peek.ok { return _failed(pl_peek.error); }
                    if pl_peek.tag == der_tag_integer() {
                        let pl_res = der_integer_small(value_der, pl_peek);
                        if !pl_res.ok { return _failed(pl_res.error); }
                        path_len_constraint = pl_res.value;
                    }
                }
            } else if strings_equal(oid, x509_oid_key_usage()) {
                has_key_usage = true;
                let ku_tlv: DerTlv = der_read_tlv(value_der, 0, value_der.length);
                if !ku_tlv.ok { return _failed(ku_tlv.error); }
                if ku_tlv.end_off != value_der.length {
                    return _failed("x509: unexpected trailing data in extension value");
                }
                let ku_bytes_res = der_bit_string_bytes(value_der, ku_tlv);
                if !ku_bytes_res.ok { return _failed(ku_bytes_res.error); }
                let ku_unused_res = der_bit_string_unused(value_der, ku_tlv);
                if !ku_unused_res.ok {
                    return _failed(ku_unused_res.error);
                }
                let ku_bytes: int[] = ku_bytes_res.value;
                let total_bits: int = 8 * ku_bytes.length - ku_unused_res.value;
                let mut bits: int = 0;
                let mut i: int = 0;
                loop {
                    if i >= total_bits { break; }
                    if i >= 9 {
                        break;
                    }  // ignore bits at or past index 9
                    let byte_idx: int = i / 8;
                    let bit_idx: int = 7 - (i % 8);
                    let byte_val: int = ku_bytes[byte_idx] & 255;
                    if (byte_val & (1 << bit_idx)) != 0 {
                        bits = bits | (1 << i);
                    }
                    i += 1;
                }
                key_usage_bits_val = bits;
            } else if strings_equal(oid, x509_oid_extended_key_usage()) {
                has_extended_key_usage = true;
                let eku_seq: DerTlv = der_read_tlv(value_der, 0, value_der.length);
                if !eku_seq.ok { return _failed(eku_seq.error); }
                if eku_seq.tag != der_tag_sequence() {
                    return _failed("x509: unexpected extendedKeyUsage field");
                }
                if eku_seq.end_off != value_der.length {
                    return _failed("x509: unexpected trailing data in extension value");
                }
                let mut eku_cur: int = eku_seq.content_off;
                let eku_end: int = eku_seq.end_off;
                loop {
                    if eku_cur >= eku_end { break; }
                    let eku_tlv: DerTlv = der_read_tlv(value_der, eku_cur, eku_end);
                    if !eku_tlv.ok { return _failed(eku_tlv.error); }
                    if eku_tlv.end_off <= eku_cur {
                        return _failed("x509: parser made no progress");
                    }
                    let eku_oid_res = der_oid_string(value_der, eku_tlv);
                    if !eku_oid_res.ok {
                        return _failed(eku_oid_res.error);
                    }
                    extended_key_usages.push(eku_oid_res.value);
                    eku_cur = eku_tlv.end_off;
                }
            } else if strings_equal(oid, x509_oid_name_constraints()) {
                // extnValue's inner DER is not covered by the certificate-
                // level structure guard (X509Extension.value_der comment
                // above), so it is re-checked here before being walked.
                let nc_guard = der_check_structure(value_der, limits);
                if !nc_guard.ok { return _failed(nc_guard.error); }
                let nc_seq: DerTlv = der_read_tlv(value_der, 0, value_der.length);
                if !nc_seq.ok { return _failed(nc_seq.error); }
                if nc_seq.tag != der_tag_sequence() {
                    return _failed("x509: unexpected nameConstraints field");
                }
                if nc_seq.end_off != value_der.length {
                    return _failed("x509: unexpected nameConstraints field");
                }
                has_name_constraints = true;
                let mut nc_cur: int = nc_seq.content_off;
                let nc_end: int = nc_seq.end_off;
                let mut nc_stage: int = 0;  // 0 = start, 1 = saw permitted, 2 = saw excluded
                let mut saw_permitted: boolean = false;
                let mut saw_excluded: boolean = false;
                loop {
                    if nc_cur >= nc_end { break; }
                    let gs_wrap: DerTlv = der_read_tlv(value_der, nc_cur, nc_end);
                    if !gs_wrap.ok { return _failed(gs_wrap.error); }
                    if gs_wrap.end_off <= nc_cur {
                        return _failed("x509: parser made no progress");
                    }
                    if gs_wrap.tag == _tag_nc_permitted() {
                        if nc_stage > 0 {
                            return _failed("x509: unexpected nameConstraints field");
                        }
                        nc_stage = 1;
                        saw_permitted = true;
                        let permitted_res = _general_subtrees(value_der, gs_wrap);
                        if !permitted_res.ok {
                            return _failed(permitted_res.error);
                        }
                        name_constraints_permitted = permitted_res.value;
                    } else if gs_wrap.tag == _tag_nc_excluded() {
                        if nc_stage > 1 {
                            return _failed("x509: unexpected nameConstraints field");
                        }
                        nc_stage = 2;
                        saw_excluded = true;
                        let excluded_res = _general_subtrees(value_der, gs_wrap);
                        if !excluded_res.ok {
                            return _failed(excluded_res.error);
                        }
                        name_constraints_excluded = excluded_res.value;
                    } else {
                        return _failed("x509: unexpected nameConstraints field");
                    }
                    nc_cur = gs_wrap.end_off;
                }
                // RFC 5280 §4.2.1.10 requires at least one of the two lists;
                // an extension asserting neither constrains nothing and is
                // non-conforming.
                if !saw_permitted && !saw_excluded {
                    return _failed("x509: nameConstraints must assert at least one subtree list");
                }
            }

            ext_cur = ext_tlv.end_off;
        }

        cur = field.end_off;
    }

    return X509Certificate {
        ok: true,
        error: "",
        version: version,
        serial: serial,
        signature_algorithm: signature_algorithm,
        signature_algorithm_outer: signature_algorithm_outer,
        signature_algorithm_params: signature_algorithm_params,
        signature_algorithm_params_outer: signature_algorithm_params_outer,
        tbs_der: tbs_der,
        signature_value: signature_value,
        issuer_der: issuer_der,
        subject_der: subject_der,
        issuer_cn: issuer_cn,
        subject_cn: subject_cn,
        not_before_ms: not_before_ms,
        not_after_ms: not_after_ms,
        spki_algorithm: spki_algorithm,
        spki_key: spki_key,
        dns_names: dns_names,
        ip_addresses: ip_addresses,
        has_basic_constraints: has_basic_constraints,
        is_ca: is_ca,
        path_len_constraint: path_len_constraint,
        has_key_usage: has_key_usage,
        key_usage_bits: key_usage_bits_val,
        has_extended_key_usage: has_extended_key_usage,
        extended_key_usages: extended_key_usages,
        has_name_constraints: has_name_constraints,
        name_constraints_permitted: name_constraints_permitted,
        name_constraints_excluded: name_constraints_excluded,
        extensions: extensions
    };
}

// ── Validity classification (RFC 5280 §4.1.2.5, both bounds inclusive) ──
fn x509_validity_unknown() -> int {
    return 0;
}  // the certificate did not parse

fn x509_validity_in_window() -> int { return 1; }

fn x509_validity_not_yet_valid() -> int { return 2; }

fn x509_validity_expired() -> int { return 3; }

// Classify a certificate's validity window against a caller-supplied Unix
// millisecond snapshot. Pure: this module never reads ambient time, so
// sfn/crypto stays effect-free and classification stays deterministic. The
// caller owns ![clock], handles the fallible read, and passes one snapshot.
// This is a window comparison, not a trust decision (SFN-504).
fn x509_validity_at(cert: X509Certificate, unix_millis: int) -> int {
    if !cert.ok { return x509_validity_unknown(); }
    if unix_millis < cert.not_before_ms {
        return x509_validity_not_yet_valid();
    }
    if unix_millis > cert.not_after_ms { return x509_validity_expired(); }
    return x509_validity_in_window();
}

// ── Hostname matching (RFC 6125 §6.4.3) ──
// ASCII-lowercase `name`, then strip one trailing "." if present, so a
// trailing-dot FQDN compares equal to its dotless form.
fn _normalize_name(name: string) -> string {
    let lowered: string = ascii_lowercase(name);
    if lowered.length > 0 && strings_equal(lowered[lowered.length - 1], ".") {
        return _strip_last_char(lowered);
    }
    return lowered;
}

// `s` with its final character removed. Used to strip one trailing "." from
// a lowercased FQDN.
fn _strip_last_char(s: string) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= s.length - 1 { break; }
        out = out + s[i];
        i += 1;
    }
    return out;
}

fn _contains_star(s: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= s.length { break; }
        if char_code(s[i]) == 42 { return true; }
        i += 1;
    }
    return false;
}

fn _label_bytes_valid(label: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= label.length { break; }
        let b: int = char_code(label[i]);
        if b < 33 || b > 126 { return false; }
        i += 1;
    }
    return true;
}

// Does `presented` (a SAN dNSName, possibly wildcarded) satisfy a
// nameConstraints dNSName `subtree` (RFC 5280 §4.2.1.10)? Matching is
// suffix-based: `subtree` matches `presented` when `presented` has at least
// as many labels and every one of `subtree`'s labels equals the label in the
// same right-aligned position.
//
// `allow_wildcard_label` governs only a label that lands in that aligned
// window: when true, a `presented` label of exactly "*" there also counts as
// equal. Callers pass `true` when testing an EXCLUDED subtree and `false` for
// a PERMITTED one — `*.corp.example` can resolve to an excluded
// `evil.corp.example`, so exclusion must treat the wildcard as covering
// anything; permission must not let a wildcard buy coverage it was never
// granted (SFN-765).
//
// This reads as two ad-hoc rules but is one: a presented `*.corp.example`
// denotes the *set* `{x.corp.example}`, and a nameConstraints subtree is
// itself a set of names. Exclusion must reject on any overlap with that set
// — a single member inside the excluded set is enough — so the wildcard is
// honoured; permission must require the whole set to be contained in the
// permitted set, so a wildcard cannot buy membership it was not granted.
// Both call sites fall out of that single reading. Neither RFC settles this
// by citation — RFC 5280 §4.2.1.10 speaks of names, not patterns, and RFC
// 6125 §6.4.3 scopes itself to identity matching — so treat this as a
// derivation from set semantics, not a rule either RFC states. One
// consequence worth naming: `allow_wildcard_label` is honoured at *any*
// label position inside the aligned window, not only where a subtree label
// would make it meaningful, so a malformed presented name like
// `foo.*.example` can over-reject against a matching excluded subtree —
// harmless, since a SAN entry that is not a well-formed hostname
// authenticates nothing regardless of this function's answer.
fn x509_dns_constraint_matches(subtree: string, presented: string, allow_wildcard_label: boolean) -> boolean {
    let s: string = _normalize_name(subtree);
    let p: string = _normalize_name(presented);
    if s.length == 0 || p.length == 0 { return false; }

    let s_labels: string[] = split(s, ".");
    let p_labels: string[] = split(p, ".");
    if p_labels.length < s_labels.length { return false; }

    let mut i: int = 0;
    loop {
        if i >= s_labels.length { break; }
        if s_labels[i].length == 0 { return false; }
        if !_label_bytes_valid(s_labels[i]) { return false; }
        i += 1;
    }
    i = 0;
    loop {
        if i >= p_labels.length { break; }
        if p_labels[i].length == 0 { return false; }
        if !_label_bytes_valid(p_labels[i]) { return false; }
        i += 1;
    }

    let offset: int = p_labels.length - s_labels.length;
    i = 0;
    loop {
        if i >= s_labels.length { break; }
        let s_label: string = s_labels[i];
        let p_label: string = p_labels[offset + i];
        if !strings_equal(s_label, p_label) {
            let wildcard_match: boolean = allow_wildcard_label && strings_equal(p_label, "*");
            if !wildcard_match { return false; }
        }
        i += 1;
    }
    return true;
}

// Does one presented dNSName pattern match `hostname`? RFC 6125 §6.4.3, with
// a deliberate narrowing: a leftmost-only, whole-label wildcard, refused
// below three labels, never a partial label (SFN-504).
fn x509_dns_name_matches(pattern: string, hostname: string) -> boolean {
    let p: string = _normalize_name(pattern);
    let h: string = _normalize_name(hostname);
    if p.length == 0 || h.length == 0 { return false; }
    // A queried name is never itself a pattern.
    if _contains_star(h) { return false; }

    let p_labels: string[] = split(p, ".");
    let h_labels: string[] = split(h, ".");

    let mut i: int = 0;
    loop {
        if i >= p_labels.length { break; }
        if p_labels[i].length == 0 { return false; }
        if !_label_bytes_valid(p_labels[i]) { return false; }
        i += 1;
    }
    i = 0;
    loop {
        if i >= h_labels.length { break; }
        if h_labels[i].length == 0 { return false; }
        if !_label_bytes_valid(h_labels[i]) { return false; }
        i += 1;
    }

    if !_contains_star(p) {
        if p_labels.length != h_labels.length { return false; }
        i = 0;
        loop {
            if i >= p_labels.length { break; }
            if !strings_equal(p_labels[i], h_labels[i]) { return false; }
            i += 1;
        }
        return true;
    }

    // Wildcard form. The "*" must appear only in label 0, and label 0 must be
    // exactly "*". RFC 6125 §6.4.3 permits a partial-label wildcard
    // (f*.example.com); we refuse it here as a deliberate narrowing choice,
    // not an oversight — do not "fix" this back to RFC 6125's permissive
    // partial-label form (SFN-504).
    if !strings_equal(p_labels[0], "*") { return false; }
    i = 1;
    loop {
        if i >= p_labels.length { break; }
        if _contains_star(p_labels[i]) { return false; }
        i += 1;
    }
    // Require at least three labels, which refuses a bare "*" and a
    // single-label wildcard like "*.com". It does NOT refuse a multi-label
    // public suffix: "*.co.uk" still matches "victim.co.uk". Closing that
    // needs a public-suffix list, which is deliberately out of scope here —
    // the same line browsers and rustls draw, leaving multi-label suffixes to
    // CA issuance policy (SFN-504).
    if p_labels.length < 3 { return false; }
    if p_labels.length != h_labels.length { return false; }
    if h_labels[0].length == 0 { return false; }

    i = 1;
    loop {
        if i >= p_labels.length { break; }
        if !strings_equal(p_labels[i], h_labels[i]) { return false; }
        i += 1;
    }
    return true;
}

// Does `hostname` match this certificate's SAN dNSName entries? SAN-only:
// commonName is deliberately not consulted, per RFC 6125 §6.4.4 (SFN-504).
// This reports a name match only — it is not an authentication result.
fn x509_hostname_matches(cert: X509Certificate, hostname: string) -> boolean {
    if !cert.ok { return false; }
    let mut i: int = 0;
    loop {
        if i >= cert.dns_names.length { break; }
        if x509_dns_name_matches(cert.dns_names[i], hostname) { return true; }
        i += 1;
    }
    return false;
}

