// aes_sbox.sfn
//
// The AES S-box as a table-free bitsliced circuit, per the SFN-339 design gate
// (docs/proposals/design-notes/sfn-339-aes-gcm-strategy.md, section 3).
//
// There is deliberately no 256-entry table here, and no array index derived
// from a secret byte: a table lookup on key or plaintext material leaks
// through the data cache. Instead the S-box is computed as
//
//     sbox(x) = affine(inv(x)),  inv(x) = x^254 in GF(2^8)
//
// over the AES field polynomial x^8 + x^4 + x^3 + x + 1. inv(0) = 0 falls out
// of 0^254 = 0, which is the S-box's defined behaviour at zero, so there is no
// special case and therefore no branch.
//
// Bitsliced representation: a group of up to 32 bytes is held as 8 words, one
// per bit position. Word j, bit k is bit j of byte k. Every operation below is
// therefore lane-independent bitwise work on 32 independent bytes at once,
// which is what makes an inversion-based S-box affordable.
//
// Everything in the inversion chain works on slots of one caller-owned
// workspace array rather than returning fresh int[] values. That is not
// premature tuning: the returning form allocated roughly 300 arrays per
// two-block AES call, which measured 0.2 MB/s at -O2 with a 5.4 GB peak RSS
// on a 5 MB benchmark — allocation-bound by a wide margin, and close enough
// to the 8 GiB toolchain memory cap to be a robustness problem rather than
// only a slow one. A slot base is a compile-time constant, never a secret, so
// the indexing carries no timing signal.
//
// Words are masked 32-bit values, so `>>` (LLVM `ashr`) behaves as a logical
// shift; see bits.sfn's rotl32/rotr32 precondition for the same requirement.
// Workspace slot bases. Each slot holds one 8-word bit-plane vector except
// _sb_p, the 15-coefficient carryless-product scratch.
fn _sb_a() -> int { return 0; }

fn _sb_x2() -> int { return 8; }

fn _sb_x3() -> int { return 16; }

fn _sb_x12() -> int { return 24; }

fn _sb_x14() -> int { return 32; }

fn _sb_x15() -> int { return 40; }

fn _sb_t() -> int { return 48; }

fn _sb_p() -> int { return 56; }

// Total workspace length: the product scratch plus its 15 coefficients.
fn sbox_work_len() -> int { return 71; }

// Allocate one S-box workspace. A caller encrypting many blocks allocates this
// once and reuses it across every round of every block.
fn sbox_work() -> int[] {
    let mut w: int[] = [];
    let mut i: int = 0;
    while i < sbox_work_len() {
        w.push(0);
        i += 1;
    }
    return w;
}

// Reduce the carryless product in the scratch slot modulo the AES field
// polynomial x^8 + x^4 + x^3 + x + 1, then copy the eight surviving
// coefficients to slot `d`. For k >= 8, x^k = x^(k-4) + x^(k-5) + x^(k-7) +
// x^(k-8), applied from the top down so a coefficient pushed into another
// position >= 8 is still reduced.
fn _gf_reduce(w: int[], d: int) -> void {
    let p: int = _sb_p();
    let mut k: int = 14;
    while k >= 8 {
        let h: int = w[p + k];
        w[p + k - 4] = w[p + k - 4] ^ h;
        w[p + k - 5] = w[p + k - 5] ^ h;
        w[p + k - 7] = w[p + k - 7] ^ h;
        w[p + k - 8] = w[p + k - 8] ^ h;
        w[p + k] = 0;
        k -= 1;
    }
    let mut j: int = 0;
    while j < 8 {
        w[d + j] = w[p + j];
        j += 1;
    }
}

// Bitsliced GF(2^8) multiply: w[d] = w[a] * w[b]. The product is built in the
// scratch slot before `d` is written, so `d` may alias `a` or `b`.
fn _gf_mul(w: int[], d: int, a: int, b: int) -> void {
    let p: int = _sb_p();
    let mut k: int = 0;
    while k < 15 {
        w[p + k] = 0;
        k += 1;
    }
    let mut i: int = 0;
    while i < 8 {
        let ai: int = w[a + i];
        let mut j: int = 0;
        while j < 8 {
            w[p + i + j] = w[p + i + j] ^ (ai & w[b + j]);
            j += 1;
        }
        i += 1;
    }
    _gf_reduce(w, d);
}

// Bitsliced GF(2^8) squaring: w[d] = w[a]^2. In characteristic 2 squaring is
// linear (Frobenius): (sum a_i x^i)^2 = sum a_i x^(2i), so the carryless
// product is the input spread over the even coefficients — a bit permutation,
// not a multiply. This is why the seven squarings in the inversion chain are
// nearly free. `d` may alias `a`.
fn _gf_sqr(w: int[], d: int, a: int) -> void {
    let p: int = _sb_p();
    let mut k: int = 0;
    while k < 15 {
        w[p + k] = 0;
        k += 1;
    }
    let mut i: int = 0;
    while i < 8 {
        w[p + 2 * i] = w[a + i];
        i += 1;
    }
    _gf_reduce(w, d);
}

// The AES affine map (FIPS-197 section 5.1.1), in place on slot `d`:
//
//   b'_i = b_i ^ b_(i+4) ^ b_(i+5) ^ b_(i+6) ^ b_(i+7) ^ c_i,  c = 0x63
//
// with index sums mod 8. 0x63 has bits 0, 1, 5 and 6 set, so those four words
// are additionally complemented. The eight inputs are snapshotted first
// because every output reads five of them.
fn _gf_affine(w: int[], d: int) -> void {
    let ones: int = 4294967295;
    let b0: int = w[d];
    let b1: int = w[d + 1];
    let b2: int = w[d + 2];
    let b3: int = w[d + 3];
    let b4: int = w[d + 4];
    let b5: int = w[d + 5];
    let b6: int = w[d + 6];
    let b7: int = w[d + 7];

    w[d] = b0 ^ b4 ^ b5 ^ b6 ^ b7 ^ ones;
    w[d + 1] = b1 ^ b5 ^ b6 ^ b7 ^ b0 ^ ones;
    w[d + 2] = b2 ^ b6 ^ b7 ^ b0 ^ b1;
    w[d + 3] = b3 ^ b7 ^ b0 ^ b1 ^ b2;
    w[d + 4] = b4 ^ b0 ^ b1 ^ b2 ^ b3;
    w[d + 5] = b5 ^ b1 ^ b2 ^ b3 ^ b4 ^ ones;
    w[d + 6] = b6 ^ b2 ^ b3 ^ b4 ^ b5 ^ ones;
    w[d + 7] = b7 ^ b3 ^ b4 ^ b5 ^ b6;
}

// Multiplicative inverse in GF(2^8) as x^254, in place on the _sb_a slot, via
// an addition chain costing 7 squarings and 4 multiplies:
//
//   x^2 -> x^3 -> x^6 -> x^12 -> x^14, x^15 -> x^240 -> x^254
//
// x^254 = x^(-1) for x != 0 because the multiplicative group has order 255,
// and 0^254 = 0 supplies the S-box's value at zero with no branch. The design
// note budgeted six multiplies; four suffice because x^14 and x^15 share the
// x^12 prefix.
fn _gf_inv_a(w: int[]) -> void {
    let a: int = _sb_a();
    let x2: int = _sb_x2();
    let x3: int = _sb_x3();
    let x12: int = _sb_x12();
    let x14: int = _sb_x14();
    let x15: int = _sb_x15();
    let t: int = _sb_t();

    _gf_sqr(w, x2, a);
    _gf_mul(w, x3, x2, a);
    _gf_sqr(w, t, x3);
    _gf_sqr(w, x12, t);
    _gf_mul(w, x14, x12, x2);
    _gf_mul(w, x15, x12, x3);
    _gf_sqr(w, t, x15);
    _gf_sqr(w, t, t);
    _gf_sqr(w, t, t);
    _gf_sqr(w, t, t);
    _gf_mul(w, a, t, x14);
}

// Bitslice n bytes of `bytes` starting at `off` into 8 bit-plane words.
// Caller guarantees n <= 32 and off + n <= bytes.length. Lanes at or above n
// stay zero; they are never read back, so the garbage the S-box produces in
// them (sbox(0) = 0x63) is harmless.
fn bs_slice(bytes: int[], off: int, n: int) -> int[] {
    let mut w: int[] = [0, 0, 0, 0, 0, 0, 0, 0,];
    let mut k: int = 0;
    while k < n {
        let b: int = bytes[off + k] & 255;
        let mut j: int = 0;
        while j < 8 {
            w[j] = w[j] | (((b >> j) & 1) << k);
            j += 1;
        }
        k += 1;
    }
    return w;
}

// Inverse of bs_slice: append lanes 0..n-1 of the bit-plane words to `out` as
// bytes. Caller guarantees n <= 32.
fn bs_unslice(w: int[], out: int[], n: int) -> void {
    let mut k: int = 0;
    while k < n {
        let mut b: int = 0;
        let mut j: int = 0;
        while j < 8 {
            b = b | (((w[j] >> k) & 1) << j);
            j += 1;
        }
        out.push(b);
        k += 1;
    }
}

// Apply the S-box to all 32 lanes of `state`, in place, reusing the caller's
// workspace. This is the form the cipher's round function calls.
fn bs_sbox_with(state: int[], work: int[]) -> void {
    let a: int = _sb_a();
    let mut j: int = 0;
    while j < 8 {
        work[a + j] = state[j];
        j += 1;
    }
    _gf_inv_a(work);
    _gf_affine(work, a);
    j = 0;
    while j < 8 {
        state[j] = work[a + j];
        j += 1;
    }
}

// Apply the S-box with a freshly allocated workspace. For cold callers — the
// key schedule's SubWord and the sbox_bytes wrapper — where one allocation per
// call is irrelevant.
fn bs_sbox(state: int[]) -> void { bs_sbox_with(state, sbox_work()); }

// Byte-oriented convenience wrapper: apply the S-box to up to 32 bytes.
// Returns [] if given more than 32 bytes (fail-closed). Used by the AES key
// schedule's SubWord, which needs only 4 of the 32 lanes — wasting 28 lanes
// costs a few thousand word operations once per key, which is the reason a
// table-free key schedule is affordable at all.
fn sbox_bytes(bytes: int[]) -> int[] {
    let empty: int[] = [];
    if bytes.length > 32 { return empty; }
    let mut w: int[] = bs_slice(bytes, 0, bytes.length);
    bs_sbox(w);
    let mut out: int[] = [];
    bs_unslice(w, out, bytes.length);
    return out;
}

export {
    bs_slice,
    bs_unslice,
    bs_sbox,
    bs_sbox_with,
    sbox_work,
    sbox_work_len,
    sbox_bytes
};
