// ── Known-answer records (RFC 8017 §8.1.2, NIST SigVerPSS_186-3.rsp) ──
test "rsa-pss: NIST record 13 verifies under SHA-256" {
    assert rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_pass_msg()), hexb(_a_pass_sig()));
}

test "rsa-pss: NIST record 46 verifies under a second SHA-256 key" {
    assert rsa_pss_verify_sha256(hexb(_nist_n_b()), _e_b(), hexb(_b_pass_msg()), hexb(_b_pass_sig()));
}

test "rsa-pss: NIST record 72 verifies under a third SHA-256 key" {
    assert rsa_pss_verify_sha256(hexb(_nist_n_c()), _e_c(), hexb(_c_pass_msg()), hexb(_c_pass_sig()));
}

test "rsa-pss: NIST record 22 verifies under SHA-384 with a 48-octet salt" {
    // The SHA-384 entry point is exported, so it carries its own known answer
    // rather than resting on the SHA-256 records and a shared code path. The
    // salt length differs (48, not 32), which is the part a hash-agnostic
    // implementation gets wrong.
    assert rsa_pss_verify_sha384(hexb(_nist_n_d384()), _e_d384(), hexb(_d384_pass_msg()), hexb(_d384_pass_sig()));
}

test "rsa-pss: NIST record 14 rejects a changed message" {
    // Result = F (1 - Message changed)
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_msgchg_msg()), hexb(_a_msgchg_sig()));
}

test "rsa-pss: NIST record 15 rejects a changed signature" {
    // Result = F (3 - Signature changed)
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_sigchg_msg()), hexb(_a_sigchg_sig()));
}

test "rsa-pss: NIST record 20 rejects a changed signature under SHA-384" {
    // Result = F (3 - Signature changed)
    assert ! rsa_pss_verify_sha384(hexb(_nist_n_d384()), _e_d384(), hexb(_d384_sigchg_msg()), hexb(_d384_sigchg_sig()));
}

test "rsa-pss: NIST record 17 rejects a changed public exponent" {
    // Result = F (2 - Public Key e changed). The modulus and signature are a
    // genuine pair; only `e` is wrong, so this exercises the exponentiation
    // rather than any encoding check.
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a_changed(), hexb(_a_echg_msg()), hexb(_a_echg_sig()));
}

test "rsa-pss: NIST record 12 rejects an encoding with the hash moved left" {
    // Result = F (4 - Format of the EM is incorrect - hash moved to left)
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_hashleft_msg()), hexb(_a_hashleft_sig()));
}

test "rsa-pss: NIST record 16 rejects an encoding with the pad terminator removed" {
    // Result = F (5 - Format of the EM is incorrect - 00 on end of pad removed)
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_padzero_msg()), hexb(_a_padzero_sig()));
}

// ── Structural checks, each pinned individually ──
//
// The encoding below is the genuine EM recovered from NIST record 13 by
// computing S^e mod n once, offline. Every case in this section is that EM with
// one property broken, so a case that stops failing means the check it names was
// removed — not that some unrelated check happened to fire.
test "rsa-pss: the recovered NIST encoding verifies at the EM level" {
    // The baseline the forgery cases mutate. Without it, a typo in the shared
    // encoding constant would make every case below vacuously pass.
    assert _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_valid()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: a wrong trailer octet is rejected" {
    // RFC 8017 §9.1.2 step 4. 0xbc changed to 0xbb; nothing else differs.
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_trailer()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: a non-zero leftmost bit is rejected before unmasking" {
    // RFC 8017 §9.1.2 step 6, and the subtlest check in the verifier. emBits is
    // 2047 with emLen 256, so the top bit of EM[0] must already be zero on the
    // encoding as received.
    //
    // This case is precisely the one that distinguishes a correct verifier from
    // a plausible wrong one. Step 9 clears those same bits from DB after
    // unmasking, so an implementation that performs ONLY the step-9 clear and
    // skips the step-6 check still recovers an identical DB from this encoding
    // and ACCEPTS it, because step 9's mask clears the very bit that was set
    // (SFN-658). The forged signature then represents an integer at or above
    // 2^emBits, which no conforming signer can produce.
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_topbit()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: a missing 0x01 delimiter is rejected" {
    // RFC 8017 §9.1.2 step 10. DB's delimiter octet zeroed and the encoding
    // re-masked under the original H, so maskedDB is internally consistent and
    // only the delimiter is wrong.
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_nodelim()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: a non-zero PS octet is rejected" {
    // RFC 8017 §9.1.2 step 10, the half that is easy to omit: the delimiter is
    // still 0x01 and in the right place, but the padding before it carries a
    // set octet. A verifier that searches DB for the first 0x01 instead of
    // requiring PS to be zero accepts this.
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_psdirty()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: a tampered salt fails the H' comparison" {
    // RFC 8017 §9.1.2 steps 12-14. One salt octet flipped and the encoding
    // re-masked, so every structural check still passes and only H' differs.
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_badsalt()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: a mismatched message digest fails the H' comparison" {
    // The genuine encoding against a digest that is one bit different — the
    // tampered-message case reduced to the EM level.
    assert ! _emsa_pss_verify(hexb(_mhash_wrong()), hexb(_em_valid()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: a SHA-256 encoding is rejected when read as SHA-384" {
    // Salt and digest lengths are bound to the hash, so the same octets must not
    // verify under the other scheme.
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_valid()), _em_bits_2048(), _pss_sha384());
}

// ── Malformed input: refused, never a panic ──
test "rsa-pss: an encoding too short for the salt and digest is rejected" {
    // RFC 8017 §9.1.2 step 3: emLen < hLen + sLen + 2 is inconsistent. 65 octets
    // is one below the 66-octet floor for SHA-256.
    let short_em: int[] = _repeat(188, 65);
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), short_em, 519, _pss_sha256());
}

test "rsa-pss: a digest of the wrong length is rejected" {
    let stunted: int[] = _slice(hexb(_mhash_valid()), 0, 31);
    assert ! _emsa_pss_verify(stunted, hexb(_em_valid()), _em_bits_2048(), _pss_sha256());
}

test "rsa-pss: an em_bits inconsistent with the encoding length is rejected" {
    // 8 * emLen - emBits must land in 0..7. A caller that passed a mismatched
    // pair would otherwise compute a nonsensical mask.
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_valid()), 2000, _pss_sha256());
    assert ! _emsa_pss_verify(hexb(_mhash_valid()), hexb(_em_valid()), 2049, _pss_sha256());
}

test "rsa-pss: an empty modulus is rejected" {
    let empty: int[] = [];
    assert ! rsa_pss_verify_sha256(empty, _e_a(), hexb(_a_pass_msg()), hexb(_a_pass_sig()));
}

test "rsa-pss: an all-zero modulus is rejected" {
    let zeros: int[] = _repeat(0, 256);
    assert ! rsa_pss_verify_sha256(zeros, _e_a(), hexb(_a_pass_msg()), hexb(_a_pass_sig()));
}

test "rsa-pss: a signature whose length differs from the modulus is rejected" {
    let truncated: int[] = _slice(hexb(_a_pass_sig()), 0, 255);
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_pass_msg()), truncated);
    let mut overlong: int[] = _slice(hexb(_a_pass_sig()), 0, 256);
    overlong.push(0);
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_pass_msg()), overlong);
}

test "rsa-pss: a signature not less than the modulus is rejected" {
    let saturated: int[] = _repeat(255, 256);
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_pass_msg()), saturated);
}

test "rsa-pss: an out-of-range or even public exponent is rejected" {
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), 2, hexb(_a_pass_msg()), hexb(_a_pass_sig()));
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), 65538, hexb(_a_pass_msg()), hexb(_a_pass_sig()));
}

test "rsa-pss: an empty message and an empty signature are rejected without panicking" {
    let empty: int[] = [];
    assert ! rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), empty, empty);
    assert ! rsa_pss_verify_sha384(hexb(_nist_n_a()), _e_a(), empty, empty);
}

// ── MGF1 and the modulus bit length ──
test "rsa-pss: MGF1 produces the RFC 8017 §B.2.1 counter-mode stream" {
    // 70 octets from a 3-octet seed: not a digest multiple, so this pins both
    // the counter increment and the truncation of the final block.
    let mask: int[] = _mgf1([1, 2, 3], 70, _pss_sha256());
    let expected: int[] = hexb(_mgf1_ref_70());
    assert mask.length == 70;
    assert mask.length == expected.length;
    let mut i: int = 0;
    loop {
        if i >= expected.length { break; }
        assert mask[i] == expected[i];
        i += 1;
    }
}

test "rsa-pss: MGF1 agrees with a direct hash on its first block" {
    // The first block is Hash(seed || 00 00 00 00) with the counter at zero.
    let mask: int[] = _mgf1([1, 2, 3], 32, _pss_sha256());
    let direct: int[] = sha256_bytes([1, 2, 3, 0, 0, 0, 0]);
    let mut i: int = 0;
    loop {
        if i >= 32 { break; }
        assert mask[i] == direct[i];
        i += 1;
    }
}

test "rsa-pss: MGF1 returns nothing for a non-positive length" {
    assert _mgf1([1, 2, 3], 0, _pss_sha256()).length == 0;
    assert _mgf1([1, 2, 3], -1, _pss_sha256()).length == 0;
}

test "rsa-pss: the modulus bit length ignores DER sign padding" {
    // emLen depends on modBits, so a DER INTEGER's leading zero octet must not
    // inflate it by 8 and push the verifier onto the wrong EM alignment. These
    // pass UNSTRIPPED input deliberately: the function strips internally, and
    // asserting only on pre-stripped input would leave that guarantee unpinned.
    assert _rsa_modulus_bits([0, 128, 0]) == 16;
    assert _rsa_modulus_bits([128, 0]) == 16;
    assert _rsa_modulus_bits([1]) == 1;
    assert _rsa_modulus_bits([255, 255]) == 16;
    assert _rsa_modulus_bits(hexb(_nist_n_a())) == 2048;
    let der_padded: int[] = _concat([0], hexb(_nist_n_a()));
    assert _rsa_modulus_bits(der_padded) == 2048;
}

test "rsa-pss: an all-zero or empty octet string has zero bit length" {
    // The fail-closed edge. An all-zero modulus of any length must collapse to
    // 0 rather than to 8 * (length - 1), which is what a version that trusted
    // its caller to have stripped would report.
    let empty: int[] = [];
    assert _rsa_modulus_bits(empty) == 0;
    assert _rsa_modulus_bits([0]) == 0;
    assert _rsa_modulus_bits([0, 0]) == 0;
    assert _rsa_modulus_bits(_repeat(0, 256)) == 0;
}

test "rsa-pss: one 2048-bit verification stays inside the -O0 shard budget" ![clock] {
    // The same hang guard rsa_pkcs1_test.sfn carries, for the same reason and
    // with the same caveats: a 2-second ceiling against a ~13 ms measured cost
    // catches a verify that stops terminating and deliberately does not claim to
    // catch a constant-factor regression. PSS adds MGF1 on top of the modexp,
    // which is a few hundred SHA-256 compressions — immaterial next to the
    // exponentiation.
    let started: Result<int, string> = unix_millis();
    assert _is_ok(started);

    assert rsa_pss_verify_sha256(hexb(_nist_n_a()), _e_a(), hexb(_a_pass_msg()), hexb(_a_pass_sig()));

    let finished: Result<int, string> = unix_millis();
    assert _is_ok(finished);

    assert _ok_value(finished) - _ok_value(started) < 2000;
}

fn _is_ok(result: Result<int, string>) -> bool {
    match result {
        Result.Ok { value } => { return true; },
        Result.Err { error } => { return false; }
    }
}

fn _ok_value(result: Result<int, string>) -> int {
    match result {
        Result.Ok { value } => { return value; },
        Result.Err { error } => { return 0; }
    }
}
