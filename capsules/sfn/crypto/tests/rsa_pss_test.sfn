// capsules/sfn/crypto/tests/rsa_pss_test.sfn
//
// SFN-658: RSASSA-PSS verification (RFC 8017 §8.1.2) — the mode TLS 1.3
// mandates for CertificateVerify, over the bignum core SFN-656 landed.
//
// Vector provenance: NIST CAVP FIPS 186-3 RSA validation archive
// (186-3rsatestvectors.zip, sha256
// 8405aeb3572a4f98ed4b1a3ccb3f2f49e725462dd28ec4759d6a15d88855d19c — the same
// archive rsa_pkcs1_test.sfn draws on), file SigVerPSS_186-3.rsp, group
// [mod = 2048]. Record indices are positions within that group.
//
// Unlike the SigVer15 file, this one's `Result = F` lines DO carry NIST's own
// parenthesized reason text, so the failure reasons named against each record
// below are quoted, not this test's own classification.
//
// Every record used here has SaltLen equal to its digest length — 32 for
// SHA-256, 48 for SHA-384 — which is the only salt length TLS 1.3's
// `rsa_pss_rsae_*` and `rsa_pss_pss_*` schemes permit, and the only one the
// verifier implements. The archive's 3072-bit group uses SaltLen 0 for SHA-256
// and is therefore deliberately not used: those records are valid PSS but not
// valid TLS 1.3, and a verifier that accepted them would be wrong.
//
// Note that NIST's [mod = 2048] group carries a DISTINCT modulus per SHAAlg
// subsection, not one key per group. The SHA-384 records below are under their
// own key, which is why there is a fourth modulus constant.
//
// Cost shape, per design note §6.3
// (docs/proposals/design-notes/sfn-653-p256-rsa-bigint-strategy.md): a 2048-bit
// verification is ~1.19 million primitive operations under -O0, measured at
// 13 ms by rsa_pkcs1_test.sfn. This file caps itself at 10 known-answer records
// — 8 SHA-256 and 2 SHA-384 — rather than transcribing all 18 SHA-256 and 18
// SHA-384 records the group offers. That cap is deliberate and worth stating:
// the remaining records are the same five NIST failure classes under different
// keys, so they add key diversity and nothing else, while each one costs a
// modexp AND a 512-hex-character constant to compile. The 10 chosen records
// cover all five NIST failure classes plus a positive under four distinct keys.
//
// Every structural forgery case below costs no modexp at all. They drive
// `_emsa_pss_verify` — the verifier's actual decision function — with a forged
// encoding recovered once from record 13. That is not merely a cost trick: it
// is what makes each check individually pinned. A test that only asserted
// "rsa_pss_verify_sha256 rejects this signature" could not say WHICH check did
// the rejecting, so a verifier that dropped one check and still rejected via a
// later one would pass. These cases fail if the specific check they name is
// removed.
import { unix_millis } from "sfn/time";

import { sha256_bytes } from "../src/hkdf";
import {
    _emsa_pss_verify,
    _mgf1,
    _pss_sha256,
    _pss_sha384,
    _rsa_modulus_bits,
    rsa_pss_verify_sha256,
    rsa_pss_verify_sha384
} from "../src/rsa";

fn hexb(s: string) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= s.length { break; }
        let hi: int = _hexval(s[i]);
        let lo: int = _hexval(s[i + 1]);
        out.push(((hi << 4) | lo) & 255);
        i += 2;
    }
    return out;
}

fn _hexval(c: string) -> int {
    let code: int = char_code(c) & 255;
    if code >= 48 && code <= 57 { return code - 48; }
    if code >= 97 && code <= 102 { return code - 97 + 10; }
    return 0;
}

fn _repeat(value: int, count: int) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= count { break; }
        out.push(value & 255);
        i += 1;
    }
    return out;
}

fn _concat(a: int[], b: int[]) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= a.length { break; }
        out.push(a[i]);
        i += 1;
    }
    let mut j: int = 0;
    loop {
        if j >= b.length { break; }
        out.push(b[j]);
        j += 1;
    }
    return out;
}

fn _slice(bytes: int[], start: int, end: int) -> int[] {
    let mut out: int[] = [];
    let mut i: int = start;
    loop {
        if i >= end { break; }
        if i >= 0 && i < bytes.length { out.push(bytes[i]); }
        i += 1;
    }
    return out;
}

// The bit length emBits takes for every record here: all four moduli are
// 2048-bit, so emBits is 2047 and emLen is 256 octets with exactly one unused
// leading bit.
fn _em_bits_2048() -> int { return 2047; }

fn _e_a() -> int { return 1107007; }

fn _e_a_changed() -> int { return 3960017; }

fn _e_b() -> int { return 3401103; }

fn _e_c() -> int { return 10831377; }

fn _e_d384() -> int { return 2421183; }

