fn _e_3072() -> int { return 11300273; }

// ── Known-answer verification (the only tests that run a full exponentiation) ──
test "rsa: NIST CAVP SigVer15 mod=2048 SHA-256 accepts a valid signature" {
    assert rsa_pkcs1_v1_5_verify_sha256(hexb(_nist_n_a()), _e_block_a(), hexb(_pass256_msg()), hexb(_pass256_sig()));
}

test "rsa: NIST CAVP SigVer15 mod=2048 SHA-384 accepts a valid signature" {
    assert rsa_pkcs1_v1_5_verify_sha384(hexb(_nist_n_b()), _e_block_b(), hexb(_pass384_msg()), hexb(_pass384_sig()));
}

test "rsa: a tampered message is rejected" {
    // NIST record 15, Result = F. Derived reason: the message was changed, so S
    // still recovers a structurally perfect encoding whose embedded digest does
    // not match. This is the case a verifier that checks padding shape but
    // compares the digest sloppily would pass.
    assert ! rsa_pkcs1_v1_5_verify_sha256(hexb(_nist_n_a()), _e_block_a(), hexb(_fail_msg_msg()), hexb(_fail_msg_sig()));
}

test "rsa: a tampered signature is rejected" {
    // NIST record 17, Result = F. Derived reason: the signature was changed, so
    // S^e is unstructured and matches no encoding at all.
    assert ! rsa_pkcs1_v1_5_verify_sha256(hexb(_nist_n_a()), _e_block_a(), hexb(_fail_sig_msg()), hexb(_fail_sig_sig()));
}

test "rsa: a wrong public exponent is rejected" {
    // NIST record 16, Result = F. Derived reason: the public exponent differs
    // from the one the signature was produced under.
    assert ! rsa_pkcs1_v1_5_verify_sha256(hexb(_nist_n_a()), _e_block_a_changed(), hexb(_fail_key_msg()), hexb(_fail_key_sig()));
}

test "rsa: NIST CAVP SigVer15 mod=3072 SHA-256 accepts a valid signature" {
    // The 119-limb shape. Design note §6.3 item 3 asks for one smoke case at
    // each of 3072 and 4096 bits so those limb counts do not ship untested; this
    // is the 3072 one, and it is a real NIST record rather than a synthetic
    // exponentiation. The 4096 shape is covered by the bignum case below, since
    // SigVer15_186-3.rsp tops out at 3072.
    assert rsa_pkcs1_v1_5_verify_sha256(hexb(_nist_n_3072()), _e_3072(), hexb(_pass3072_msg()), hexb(_pass3072_sig()));
}

test "rsa: a wrong modulus is rejected" {
    // The record-13 signature checked against the *other* key block's modulus.
    // Both are well-formed 2048-bit RSA moduli, so this exercises a real
    // exponentiation that simply lands nowhere near a valid encoding.
    assert ! rsa_pkcs1_v1_5_verify_sha256(hexb(_nist_n_b()), _e_block_a(), hexb(_pass256_msg()), hexb(_pass256_sig()));
}

// ── Forgery resistance ──
//
// These cases drive `_rsa_pkcs1_v1_5_verify_em`, which IS the verifier's
// decision: both public entry points are `_rsa_public_op` followed by exactly
// that call. What is skipped here is only the exponentiation that would have
// produced each forged encoding — a 2048-bit modexp per case, which design note
// §6.3 asks this file not to repeat. The function under test is still the one
// that decides, so a rewrite of it into a padding-walking parser fails these.
fn _pass256_digest() -> int[] {
    return sha256_bytes(hexb(_pass256_msg()));
}

fn _valid_em() -> int[] {
    let built: RsaBytesResult = _emsa_pkcs1_v1_5(_pass256_digest(), _digestinfo_sha256(), 256);
    return built.value;
}

fn _accepts(em: int[]) -> bool {
    return _rsa_pkcs1_v1_5_verify_em(em, _pass256_digest(), _digestinfo_sha256());
}

// Every forgery case is a negative assertion, so a dead fixture — an empty
// `_valid_em()`, or a decision function that rejects everything — would make all
// of them pass while testing nothing. Each case asserts this first, so the guard
// still runs when a single case is selected with `sfn test -k`.
fn _fixture_is_live() -> bool {
    if _valid_em().length != 256 { return false; }
    return _accepts(_valid_em());
}

// Index arithmetic for a 256-octet encoding over a 19-octet SHA-256 DigestInfo
// prefix and a 32-octet digest: 00 01, then PS, then the 00 separator.
fn _ps_len_256() -> int { return 256 - 19 - 32 - 3; }

fn _separator_index() -> int { return 2 + _ps_len_256(); }

test "rsa: the rebuilt encoding matches RFC 8017 section 9.2 octet for octet" {
    let digest: int[] = _pass256_digest();
    let prefix: int[] = _digestinfo_sha256();
    let built: RsaBytesResult = _emsa_pkcs1_v1_5(digest, prefix, 256);
    assert built.ok;

    let em: int[] = built.value;
    assert em.length == 256;
    assert em[0] == 0;
    assert em[1] == 1;

    // PS is all 255 and comfortably longer than the eight-octet floor.
    let ps_len: int = _ps_len_256();
    assert ps_len >= 8;
    let mut i: int = 2;
    loop {
        if i >= 2 + ps_len { break; }
        assert em[i] == 255;
        i += 1;
    }

    assert em[_separator_index()] == 0;

    let mut j: int = 0;
    loop {
        if j >= prefix.length { break; }
        assert em[_separator_index() + 1 + j] == prefix[j];
        j += 1;
    }

    let mut d: int = 0;
    loop {
        if d >= digest.length { break; }
        assert em[_separator_index() + 1 + prefix.length + d] == digest[d];
        d += 1;
    }

    // The decision function accepts the encoding it just rebuilt, which is what
    // makes every negative case below meaningful.
    assert _accepts(em);
}

test "rsa: garbage after the DigestInfo is rejected" {
    // The Bleichenbacher'06 shape: the minimum eight octets of FF padding, the
    // separator, a *genuine* DigestInfo and digest, and then attacker-chosen
    // filler out to the modulus width. A verifier that walks the recovered
    // padding and stops once it has read a well-formed DigestInfo accepts this
    // with no private key involved. This is the single most important case in
    // the file.
    assert _fixture_is_live();

    let digest: int[] = _pass256_digest();
    let mut forged: int[] = _concat(_repeat(0, 1), _repeat(1, 1));
    forged = _concat(forged, _repeat(255, 8));
    forged = _concat(forged, _repeat(0, 1));
    forged = _concat(forged, _digestinfo_sha256());
    forged = _concat(forged, digest);
    forged = _concat(forged, _repeat(171, 256 - forged.length));

    assert forged.length == 256;
    // The forgery really does carry a valid DigestInfo and the correct digest —
    // it is rejected for its padding, not because the hash is wrong.
    assert _rsa_bytes_eq(_slice(forged, 11, 11 + 19 + 32), _concat(_digestinfo_sha256(), digest));
    assert ! _accepts(forged);
}

test "rsa: too-short PS padding is rejected" {
    assert _fixture_is_live();

    let digest: int[] = _pass256_digest();
    let mut forged: int[] = _concat(_repeat(0, 1), _repeat(1, 1));
    forged = _concat(forged, _repeat(255, 7));
    forged = _concat(forged, _repeat(0, 1));
    forged = _concat(forged, _digestinfo_sha256());
    forged = _concat(forged, digest);
    forged = _concat(forged, _repeat(171, 256 - forged.length));

    assert forged.length == 256;
    assert ! _accepts(forged);

    // The encoder also refuses to *emit* a PS shorter than eight octets: for a
    // 19-octet prefix and a 32-octet digest the smallest legal width is 62.
    let too_narrow: RsaBytesResult = _emsa_pkcs1_v1_5(digest, _digestinfo_sha256(), 61);
    assert ! too_narrow.ok;
    let exactly_wide_enough: RsaBytesResult = _emsa_pkcs1_v1_5(digest, _digestinfo_sha256(), 62);
    assert exactly_wide_enough.ok;
    assert exactly_wide_enough.value.length == 62;
    assert exactly_wide_enough.value[2] == 255;
    assert exactly_wide_enough.value[9] == 255;
    assert exactly_wide_enough.value[10] == 0;

    // An encoding narrower than the floor is refused by the decision function
    // too, not merely by the encoder.
    assert ! _accepts(_slice(_valid_em(), 0, 61));
}

test "rsa: a wrong DigestInfo prefix is rejected" {
    // A SHA-384 AlgorithmIdentifier wrapped around a SHA-256 digest: the same
    // length, so only the prefix octets differ.
    assert _fixture_is_live();

    let digest: int[] = _pass256_digest();
    let mut forged: int[] = _concat(_repeat(0, 1), _repeat(1, 1));
    forged = _concat(forged, _repeat(255, _ps_len_256()));
    forged = _concat(forged, _repeat(0, 1));
    forged = _concat(forged, _digestinfo_sha384());
    forged = _concat(forged, digest);

    assert forged.length == 256;
    assert ! _accepts(forged);
}

test "rsa: a missing 00 01 header is rejected" {
    assert _fixture_is_live();
    let em: int[] = _valid_em();

    // Leading octet not 00.
    assert ! _accepts(_with_byte(em, 0, 1));
    // Block type not 01.
    assert ! _accepts(_with_byte(em, 1, 2));
    // The classic "shift everything left by one and pad the tail" attempt.
    let shifted: int[] = _concat(_slice(em, 1, 256), _repeat(0, 1));
    assert shifted.length == 256;
    assert ! _accepts(shifted);
}

test "rsa: a corrupted separator or padding octet is rejected" {
    assert _fixture_is_live();
    let em: int[] = _valid_em();

    // The single 00 between PS and DigestInfo turned into more padding.
    assert ! _accepts(_with_byte(em, _separator_index(), 255));
    // A padding octet that is not FF.
    assert ! _accepts(_with_byte(em, 10, 254));
    // A flipped digest octet, at the very end of the encoding.
    assert ! _accepts(_with_byte(em, 255, em[255] ^ 1));
}

// ── Malformed input fails closed and never panics ──
test "rsa: malformed moduli, lengths, and exponents are refused" {
    let sig: int[] = hexb(_pass256_sig());
    let n_a: int[] = hexb(_nist_n_a());

    // An all-zero modulus. It strips to empty, so this is refused on the
    // length check rather than by the context builder's zero guard; that guard
    // is reached directly in the out-of-range test below.
    let zero: RsaBytesResult = _rsa_public_op(_repeat(0, 256), 65537, sig);
    assert ! zero.ok;

    // Even modulus — a real 2048-bit value with its low bit cleared.
    let even: RsaBytesResult = _rsa_public_op(_with_byte(n_a, 255, n_a[255] & 254), 65537, sig);
    assert ! even.ok;

    // Modulus shorter than the signature.
    let short_modulus: RsaBytesResult = _rsa_public_op(_slice(n_a, 0, 200), 65537, sig);
    assert ! short_modulus.ok;

    // Signature longer than the modulus.
    let long_signature: RsaBytesResult = _rsa_public_op(n_a, 65537, _concat(sig, _repeat(0, 1)));
    assert ! long_signature.ok;

    // Modulus below the supported 1024-bit floor.
    let tiny: RsaBytesResult = _rsa_public_op(_repeat(3, 64), 65537, _repeat(1, 64));
    assert ! tiny.ok;

    // Exponent policy: below 3, even, and wider than a positive 31-bit int.
    let small_modulus: int[] = _small_modulus();
    let sig_small: int[] = _repeat(2, 128);
    assert ! _rsa_public_op(small_modulus, 1, sig_small).ok;
    assert ! _rsa_public_op(small_modulus, 2, sig_small).ok;
    assert ! _rsa_public_op(small_modulus, 4, sig_small).ok;
    assert ! _rsa_public_op(small_modulus, 2147483648, sig_small).ok;

    // Empty everything: the lengths agree at zero, so this reaches the context
    // builder and is refused there rather than indexing off the end.
    let empty: int[] = [];
    assert ! rsa_pkcs1_v1_5_verify_sha256(empty, 65537, empty, empty);
    assert ! rsa_pkcs1_v1_5_verify_sha384(empty, 65537, empty, empty);
}

test "rsa: a signature not less than the modulus is refused" {
    // The modulus itself, reinterpreted as a signature: equal, so out of range.
    let n: int[] = _small_modulus();
    let equal: RsaBytesResult = _rsa_public_op(n, 65537, n);
    assert ! equal.ok;
}

test "rsa: DER sign padding on the modulus is tolerated" {
    // An X.509 RSAPublicKey carries the modulus as a DER INTEGER, which prefixes
    // a 00 octet whenever the top bit is set. Stripping it is what keeps the
    // signature-length check comparing k against k.
    let n_a: int[] = hexb(_nist_n_a());
    let padded: int[] = _concat(_repeat(0, 1), n_a);
    assert padded.length == 257;
    assert _rsa_strip_leading_zeros(padded).length == 256;
    assert _rsa_bytes_eq(_rsa_strip_leading_zeros(padded), n_a);
    assert _rsa_strip_leading_zeros(_repeat(0, 8)).length == 0;
}

test "rsa: out-of-range modulus sizes and signature lengths are refused" {
    // A signature shorter than a well-formed modulus. RFC 8017 §8.2.2 requires
    // exactly k octets; the over-long mirror case is covered above.
    assert ! _rsa_public_op(hexb(_nist_n_a()), 65537, _slice(hexb(_pass256_sig()), 0, 255)).ok;

    // A modulus above the supported 512-byte ceiling, which bounds the quadratic
    // work an untrusted certificate can demand.
    assert ! _rsa_public_op(_synthetic_modulus(520), 65537, _repeat(2, 520)).ok;

    // The context builder's own guards, reached directly because `_rsa_public_op`
    // strips leading zeros and would refuse these on length first.
    assert ! mont_ctx_from_be(_repeat(0, 128)).ok;
    assert ! mont_ctx_from_be(_concat(_repeat(0, 127), _repeat(1, 1))).ok;
    assert ! mont_ctx_from_be(_repeat(0, 0)).ok;
    assert ! mont_ctx_from_be(_synthetic_modulus(513)).ok;
    assert mont_ctx_from_be(_small_modulus()).ok;
}

// ── Bignum arithmetic ──
test "bignum: the Montgomery n0 constant inverts the low limb" {
    // n0_prime is -n[0]^-1 mod 2^26, so n[0] * n0_prime + 1 must vanish mod 2^26
    // for every odd low limb.
    let mut n0: int = 1;
    loop {
        if n0 > 4001 { break; }
        assert((n0 * _mont_n0_prime(n0) + 1) & _bn_limb_mask()) == 0;
        n0 += 2;
    }

    // Design note §4.3 records n0_prime = 1 for the P-256 field prime, whose low
    // 26-bit limb is 2^26 - 1.
    assert _mont_n0_prime(67108863) == 1;
}

test "bignum: big-endian conversion round-trips through 26-bit limbs" {
    let n: int[] = hexb(_nist_n_a());
    let limbs: int = (256 * 8) / 26 + 1;
    assert limbs == 79;
    assert _rsa_bytes_eq(_bn_to_be(_bn_from_be(n, limbs), 256), n);

    // I2OSP pads to the requested width rather than to the magnitude.
    let one: int[] = _bn_from_be(_concat(_repeat(0, 255), _repeat(1, 1)), limbs);
    let wide: int[] = _bn_to_be(one, 256);
    assert wide.length == 256;
    assert wide[0] == 0;
    assert wide[255] == 1;
}

test "bignum: Montgomery exponentiation agrees with plain integer arithmetic" {
    // A cube small enough that the modular reduction is the identity, so the
    // answer is checkable by ordinary arithmetic: 65535^3 = 281462092005375.
    // This catches a wrong n0_prime, a wrong R^2, or a dropped CIOS carry, which
    // design note §9 lists as the primary implementation risk.
    let ctx: MontCtx = mont_ctx_from_be(_small_modulus());
    assert ctx.ok;
    assert ctx.limbs == 40;

    let base: int[] = _bn_from_be(_concat(_repeat(0, 126), _repeat(255, 2)), ctx.limbs);
    let cubed: int[] = _bn_to_be(_modexp_public(base, 3, ctx), 128);
    let expected: int[] = _concat(_repeat(0, 122), [255, 253, 0, 2, 255, 255]);
    assert _rsa_bytes_eq(cubed, expected);

    // Exponent 1 exercises the conversion pair on its own: mont_out(mont_in(x))
    // must be the identity, which is a direct check on R^2.
    assert _rsa_bytes_eq(_bn_to_be(_modexp_public(base, 1, ctx), 128), _concat(_repeat(0, 126), _repeat(255, 2)));
}

test "bignum: the 4096-bit limb shape exponentiates correctly" {
    // 158 limbs, the widest modulus the engine accepts. Same checkable cube as
    // the 1024-bit case: 65535^3 stays far below the modulus, so the reduction
    // is the identity and the answer is verifiable by ordinary arithmetic. This
    // exists so the largest limb count does not ship without ever being run.
    let ctx: MontCtx = mont_ctx_from_be(_synthetic_modulus(512));
    assert ctx.ok;
    assert ctx.limbs == 158;

    let base: int[] = _bn_from_be(_concat(_repeat(0, 510), _repeat(255, 2)), ctx.limbs);
    let cubed: int[] = _bn_to_be(_modexp_public(base, 3, ctx), 512);
    assert _rsa_bytes_eq(cubed, _concat(_repeat(0, 506), [255, 253, 0, 2, 255, 255]));
}

// ── Cost guard ──
fn _is_ok(result: Result<int, string>) -> bool {
    match result {
        Result.Ok { value } => { return true; },
        Result.Err { error } => { return false; }
    }
}

fn _ok_value(result: Result<int, string>) -> int {
    match result {
        Result.Ok { value } => { return value; },
        Result.Err { error } => { return 0; }
    }
}

test "rsa: one 2048-bit verification stays inside the -O0 shard budget" ![clock] {
    // Design note §6.3 sizes a 2048-bit verify at ~1.19 million primitive
    // operations under -O0 and caps the whole fast file at 30 seconds. The
    // measurement that closed that question, taken on the -O0 test binary when
    // this landed: one verify — Montgomery context setup included — is 13 ms.
    // The note's worry does not materialize; this file's wall time is dominated
    // by compiling its vector constants, not by arithmetic.
    //
    // The ceiling is therefore set two orders of magnitude above the measured
    // cost, which makes this a hang guard and nothing finer. It catches a verify
    // that stops terminating — an unbounded exponent scan, a runaway carry loop
    // — and it cannot flake on a loaded or slower runner. It deliberately does
    // NOT claim to catch a constant-factor regression: at 154x headroom, none of
    // the plausible ones would trip it, and tightening the bound far enough to
    // catch them would trade a real property for a flaky one. Guarding the
    // constant factor is a benchmark's job (SFEP-0006), not this file's.
    //
    // `unix_millis` is wall-clock, not monotonic, so an NTP step during the
    // measured window can make the delta meaningless in either direction. That
    // is acceptable here: a spurious *small* delta only fails to catch a hang,
    // and a spurious large one is bounded by the same 2-second ceiling that a
    // real hang would blow past.
    let started: Result<int, string> = unix_millis();
    assert _is_ok(started);

    assert rsa_pkcs1_v1_5_verify_sha256(hexb(_nist_n_a()), _e_block_a(), hexb(_pass256_msg()), hexb(_pass256_sig()));

    let finished: Result<int, string> = unix_millis();
    assert _is_ok(finished);

    let elapsed_ms: int = _ok_value(finished) - _ok_value(started);
    assert elapsed_ms < 2000;
}
