// capsules/sfn/crypto/tests/rsa_pkcs1_test.sfn
//
// SFN-656: RSASSA-PKCS1-v1_5 verification (RFC 8017 §8.2.2) and the 26-bit
// Montgomery bignum core underneath it.
//
// Test-shape constraint, from design note §6.3
// (docs/proposals/design-notes/sfn-653-p256-rsa-bigint-strategy.md): a 2048-bit
// verification is roughly 1.19 million primitive operations under the -O0 test
// build, so the negative cases must NOT each repeat one. They do not. Only the
// six NIST known-answer records and the wrong-modulus case run a full
// exponentiation; every forgery case drives the decision function
// `_rsa_pkcs1_v1_5_verify_em` directly, every malformed-input case is refused by
// a pre-modexp guard, and the arithmetic cases use synthetic moduli.
//
// The forgery cases buy that cheapness by calling `_rsa_pkcs1_v1_5_verify_em`
// — the verifier's actual decision function — with a forged encoding, instead
// of by comparing byte strings. The distinction matters: a test that only
// asserted "this forgery differs from the rebuilt encoding" would hold for any
// implementation, including one rewritten to walk the recovered padding, which
// is precisely the regression these cases exist to catch.
//
// Vector provenance: NIST CAVP FIPS 186-3 RSA validation archive
// (186-3rsatestvectors.zip, sha256
// 8405aeb3572a4f98ed4b1a3ccb3f2f49e725462dd28ec4759d6a15d88855d19c), file
// SigVer15_186-3.rsp, groups [mod = 2048] and [mod = 3072]. Record indices are
// positions within their group.
//
// One honest caveat on those records: this archive's `Result = F` lines carry
// NO parenthesized reason text (unlike the sibling truncated-SHA file), so the
// per-record failure reasons named below are DERIVED structurally — by
// recovering S^e mod n and inspecting the encoding — not quoted from the file.
// Treat the reason labels as this test's own classification. What is quoted
// verbatim from NIST is the only thing the assertions depend on: the P/F verdict.
import { unix_millis } from "sfn/time";

import {
    MontCtx,
    _bn_from_be,
    _bn_limb_mask,
    _bn_to_be,
    _modexp_public,
    _mont_n0_prime,
    mont_ctx_from_be
} from "../src/bignum";
import { sha256_bytes } from "../src/hkdf";
import {
    RsaBytesResult,
    _digestinfo_sha256,
    _digestinfo_sha384,
    _emsa_pkcs1_v1_5,
    _rsa_bytes_eq,
    _rsa_pkcs1_v1_5_verify_em,
    _rsa_public_op,
    _rsa_strip_leading_zeros,
    rsa_pkcs1_v1_5_verify_sha256,
    rsa_pkcs1_v1_5_verify_sha384
} from "../src/rsa";

fn hexb(s: string) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= s.length { break; }
        let hi: int = _hexval(s[i]);
        let lo: int = _hexval(s[i + 1]);
        out.push(((hi << 4) | lo) & 255);
        i += 2;
    }
    return out;
}

fn _hexval(c: string) -> int {
    let code: int = char_code(c) & 255;
    if code >= 48 && code <= 57 { return code - 48; }
    if code >= 97 && code <= 102 { return code - 97 + 10; }
    return 0;
}

// A copy of `bytes` with one octet replaced — the mutation primitive the
// forgery cases use to bend a valid encoding out of shape.
fn _with_byte(bytes: int[], index: int, value: int) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= bytes.length { break; }
        if i == index { out.push(value & 255); } else {
            out.push(bytes[i]);
        }
        i += 1;
    }
    return out;
}

fn _slice(bytes: int[], start: int, end: int) -> int[] {
    let mut out: int[] = [];
    let mut i: int = start;
    loop {
        if i >= end { break; }
        if i >= 0 && i < bytes.length { out.push(bytes[i]); }
        i += 1;
    }
    return out;
}

fn _repeat(value: int, count: int) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= count { break; }
        out.push(value & 255);
        i += 1;
    }
    return out;
}

fn _concat(a: int[], b: int[]) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= a.length { break; }
        out.push(a[i]);
        i += 1;
    }
    let mut j: int = 0;
    loop {
        if j >= b.length { break; }
        out.push(b[j]);
        j += 1;
    }
    return out;
}

// A synthetic odd modulus of the requested octet length, for the rejection and
// raw-arithmetic paths. Its factorization is irrelevant: no test checks a real
// signature against it. It exists so those cases can pick a limb count directly
// — 1024-bit for the cheap ones, 4096-bit to exercise the widest shape — rather
// than paying for a real 2048-bit key they do not need.
fn _synthetic_modulus(len: int) -> int[] {
    let mut n: int[] = [];
    n.push(193);
    let mut i: int = 1;
    loop {
        if i >= len - 1 { break; }
        n.push((i * 7 + 11) & 255);
        i += 1;
    }
    n.push(157);
    return n;
}

fn _small_modulus() -> int[] { return _synthetic_modulus(128); }

// The public exponents attached to the selected records.
fn _e_block_a() -> int { return 4838049; }

fn _e_block_a_changed() -> int { return 477275; }

fn _e_block_b() -> int { return 2762459; }

