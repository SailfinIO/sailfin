// capsules/sfn/crypto/tests/x509_verify_test.sfn
//
// Regression coverage for X.509 certification-path validation (SFN-340,
// design SFEP-0048 Phase C): chain building, signature verification across
// the three certificate-signature algorithms in the chosen cut, CA-constraint
// enforcement, and fail-closed rejection with a distinguishable code.
//
// Every fixture below is a real certificate produced by OpenSSL 3.6.3 and
// cross-checked with `openssl verify` before being embedded, so a positive
// case cannot pass vacuously and a negative case is known to be rejected by
// an independent implementation. The generating commands are recorded above
// the fixture block. There is no network dependency and no ambient clock: a
// fixed Unix-millisecond snapshot is passed into every call.
import { X509Certificate, x509_parse } from "../src/x509";
import {
    X509ChainResult,
    X509VerifyOptions,
    x509_verify_chain,
    x509_verify_default_max_depth,
    x509_verify_err_bad_input,
    x509_verify_err_bad_signature,
    x509_verify_err_eku,
    x509_verify_err_expired,
    x509_verify_err_no_anchor,
    x509_verify_err_not_a_ca,
    x509_verify_err_not_yet_valid,
    x509_verify_err_path_len_exceeded,
    x509_verify_err_path_too_long,
    x509_verify_err_unsupported_algorithm,
    x509_verify_ok,
    x509_verify_options
} from "../src/x509_verify";

// 2026-06-01T00:00:00Z — inside every fixture window except xp_inter, which
// expires 2026-02-01.
fn now_ms() -> int { return 1780272000000; }

// 2025-06-01T00:00:00Z — before every fixture's notBefore.
fn before_ms() -> int { return 1748736000000; }

// 2028-01-01T00:00:00Z — after every leaf's notAfter.
fn after_ms() -> int { return 1830297600000; }

fn hexb(s: string) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        if i >= s.length { break; }
        out.push(((_hexval(s[i]) << 4) | _hexval(s[i + 1])) & 255);
        i += 2;
    }
    return out;
}

fn _hexval(c: string) -> int {
    let code: int = char_code(c) & 255;
    if code >= 48 && code <= 57 { return code - 48; }
    if code >= 97 && code <= 102 { return code - 97 + 10; }
    return 0;
}

fn cert(hex: string) -> X509Certificate { return x509_parse(hexb(hex)); }

// ── Positive paths: one per certificate-signature algorithm in the cut ──
test "x509_verify: an ed25519 chain verifies to its trust anchor" {
    let leaf: X509Certificate = cert(fx_ed_leaf());
    let inter: X509Certificate = cert(fx_ed_inter());
    let root: X509Certificate = cert(fx_ed_root());
    assert leaf.ok && inter.ok && root.ok;

    let result: X509ChainResult = x509_verify_chain(leaf, [inter], [root], x509_verify_options(now_ms()));
    assert result.ok;
    assert result.code == x509_verify_ok();
    assert result.depth == 1;
    assert result.anchor_subject_cn == "Sailfin Test Ed Root";
}

test "x509_verify: an ecdsa-p256 chain verifies to its trust anchor" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_ec_leaf()), [cert(fx_ec_inter())], [cert(fx_ec_root())], x509_verify_options(now_ms()));
    assert result.ok;
    assert result.code == x509_verify_ok();
    assert result.anchor_subject_cn == "Sailfin Test Ec Root";
}

test "x509_verify: an rsa chain verifies to its trust anchor" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_rsa_leaf()), [cert(fx_rsa_inter())], [cert(fx_rsa_root())], x509_verify_options(now_ms()));
    assert result.ok;
    assert result.code == x509_verify_ok();
    assert result.anchor_subject_cn == "Sailfin Test Rsa Root";
}

test "x509_verify: a three-deep chain verifies and reports its depth" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_dp_leaf()), [cert(fx_dp_i1()), cert(fx_dp_i2())], [cert(fx_dp_root())], x509_verify_options(now_ms()));
    assert result.ok;
    assert result.depth == 2;
}

// ── Chain building against a hostile bag ──
test "x509_verify: a reversed intermediate bag still builds" {
    // The bag is presented deepest-first, the opposite of path order.
    let result: X509ChainResult = x509_verify_chain(cert(fx_dp_leaf()), [cert(fx_dp_i1()), cert(fx_dp_i2())], [cert(fx_dp_root())], x509_verify_options(now_ms()));
    let reversed: X509ChainResult = x509_verify_chain(cert(fx_dp_leaf()), [cert(fx_dp_i2()), cert(fx_dp_i1())], [cert(fx_dp_root())], x509_verify_options(now_ms()));
    assert result.ok;
    assert reversed.ok;
    assert reversed.depth == result.depth;
}

test "x509_verify: a bag padded with unrelated certificates still builds" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [cert(fx_other_root()), cert(fx_rsa_inter()), cert(fx_ec_inter()), cert(fx_ed_inter()), cert(fx_pl_i1())], [cert(fx_ed_root())], x509_verify_options(now_ms()));
    assert result.ok;
    assert result.depth == 1;
}

test "x509_verify: extra trust anchors do not disturb the decision" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [cert(fx_ed_inter())], [cert(fx_other_root()), cert(fx_ec_root()), cert(fx_ed_root())], x509_verify_options(now_ms()));
    assert result.ok;
    assert result.anchor_subject_cn == "Sailfin Test Ed Root";
}

// ── Fail-closed rejections, each with a distinguishable code ──
test "x509_verify: a tampered signature is rejected" {
    // Flip one bit of the trailing signature octet. The encoding keeps every
    // length intact, so the certificate still parses and only the signature
    // value differs — the rejection has to come from the verification itself.
    let mut der: int[] = hexb(fx_ed_leaf());
    der[der.length - 1] = (der[der.length - 1] ^ 1) & 255;
    let leaf: X509Certificate = x509_parse(der);
    assert leaf.ok;

    let result: X509ChainResult = x509_verify_chain(leaf, [cert(fx_ed_inter())], [cert(fx_ed_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_bad_signature();
}

test "x509_verify: a tampered signature on an intermediate is rejected" {
    let mut der: int[] = hexb(fx_ed_inter());
    der[der.length - 1] = (der[der.length - 1] ^ 1) & 255;
    let inter: X509Certificate = x509_parse(der);
    assert inter.ok;

    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [inter], [cert(fx_ed_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_bad_signature();
}

test "x509_verify: an expired leaf is rejected" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [cert(fx_ed_inter())], [cert(fx_ed_root())], x509_verify_options(after_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_expired();
}

test "x509_verify: a not-yet-valid leaf is rejected" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [cert(fx_ed_inter())], [cert(fx_ed_root())], x509_verify_options(before_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_not_yet_valid();
}

test "x509_verify: an expired intermediate is rejected even when leaf and root are current" {
    // The window is enforced at every position, not just the leaf: this leaf
    // and this root are both inside their windows at `now_ms`.
    let leaf: X509Certificate = cert(fx_xp_leaf());
    let root: X509Certificate = cert(fx_ed_root());
    assert leaf.not_after_ms > now_ms();
    assert root.not_after_ms > now_ms();

    let result: X509ChainResult = x509_verify_chain(leaf, [cert(fx_xp_inter())], [root], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_expired();
}

test "x509_verify: a chain with no path to an anchor is rejected" {
    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [cert(fx_ed_inter())], [cert(fx_other_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_no_anchor();
}

test "x509_verify: an empty trust store is rejected" {
    let anchors: X509Certificate[] = [];
    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [cert(fx_ed_inter())], anchors, x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_no_anchor();
}

test "x509_verify: a non-CA certificate used as an issuer is rejected" {
    let inter: X509Certificate = cert(fx_nc_inter());
    assert inter.ok;
    assert ! inter.is_ca;

    let result: X509ChainResult = x509_verify_chain(cert(fx_nc_leaf()), [inter], [cert(fx_ed_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_not_a_ca();
}

test "x509_verify: an exceeded pathLenConstraint is rejected" {
    let root: X509Certificate = cert(fx_pl_root());
    assert root.is_ca;
    assert root.path_len_constraint == 0;

    // Two intermediates below a pathlen:0 root is one more than it permits.
    let result: X509ChainResult = x509_verify_chain(cert(fx_pl_leaf()), [cert(fx_pl_i1()), cert(fx_pl_i2())], [root], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_path_len_exceeded();
}

test "x509_verify: an unimplemented signature algorithm rejects the link" {
    // ecdsa-with-SHA384 over P-384. Nothing in the chosen cut can verify it,
    // so the link must reject rather than be skipped.
    let leaf: X509Certificate = cert(fx_u_leaf());
    assert leaf.ok;
    assert leaf.signature_algorithm == "1.2.840.10045.4.3.3";

    let intermediates: X509Certificate[] = [];
    let result: X509ChainResult = x509_verify_chain(leaf, intermediates, [cert(fx_u_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_unsupported_algorithm();
}

test "x509_verify: a leaf whose extendedKeyUsage excludes serverAuth is rejected" {
    let leaf: X509Certificate = cert(fx_ck_leaf());
    assert leaf.ok;
    assert leaf.has_extended_key_usage;

    let result: X509ChainResult = x509_verify_chain(leaf, [cert(fx_ed_inter())], [cert(fx_ed_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_eku();
}

test "x509_verify: the same clientAuth leaf verifies when serverAuth is not required" {
    let mut options: X509VerifyOptions = x509_verify_options(now_ms());
    options.require_server_auth = false;

    let result: X509ChainResult = x509_verify_chain(cert(fx_ck_leaf()), [cert(fx_ed_inter())], [cert(fx_ed_root())], options);
    assert result.ok;
}

test "x509_verify: a leaf that did not parse is rejected as bad input" {
    let garbage: int[] = [48, 130, 1, 2, 3, 4];
    let leaf: X509Certificate = x509_parse(garbage);
    assert ! leaf.ok;

    let intermediates: X509Certificate[] = [];
    let result: X509ChainResult = x509_verify_chain(leaf, intermediates, [cert(fx_ed_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_bad_input();
}

test "x509_verify: a depth cap below the path length is rejected" {
    let mut options: X509VerifyOptions = x509_verify_options(now_ms());
    options.max_depth = 1;

    let result: X509ChainResult = x509_verify_chain(cert(fx_dp_leaf()), [cert(fx_dp_i1()), cert(fx_dp_i2())], [cert(fx_dp_root())], options);
    assert ! result.ok;
    assert result.code == x509_verify_err_path_too_long();
    assert x509_verify_default_max_depth() == 8;
}

test "x509_verify: an anchor cannot substitute for a different chain's root" {
    // The ecdsa root is a perfectly good CA, but it did not issue this
    // intermediate, so no name match exists and the path does not close.
    let result: X509ChainResult = x509_verify_chain(cert(fx_ed_leaf()), [cert(fx_ed_inter())], [cert(fx_ec_root())], x509_verify_options(now_ms()));
    assert ! result.ok;
    assert result.code == x509_verify_err_no_anchor();
}

// ── Fixtures ──
//
// Produced with OpenSSL 3.6.3. Every certificate is generated from a fresh
// key; roots are self-signed with `openssl x509 -req -key`, children with
// `openssl x509 -req -CA <issuer>.pem -CAkey <issuer>.key`, each carrying an
// explicit `-not_before 20260101000000Z` and an `-extfile` holding its
// basicConstraints/keyUsage/extendedKeyUsage/subjectAltName. The private keys
// are discarded: nothing here needs to sign anything at test time.
//
//   ed_*     Ed25519          root(pathlen:1) -> inter(pathlen:0) -> leaf
//   ec_*     ecdsa-with-SHA256, P-256, same shape
//   rsa_*    sha256WithRSAEncryption, 2048-bit, same shape
//   dp_*     Ed25519, three deep: root(pathlen:2) -> i1(pathlen:1) -> i2(pathlen:0) -> leaf
//   nc_*     an issuer with basicConstraints CA:FALSE
//   pl_*     root(pathlen:0) over two intermediates — one more than permitted
//   xp_*     an intermediate expiring 2026-02-01, inside a chain that is otherwise current
//   u_*      P-384 / ecdsa-with-SHA384, an algorithm outside the chosen cut
//   ck_leaf  a leaf whose extendedKeyUsage is clientAuth only
//   other_root  an unrelated trust anchor, for padding and no-path cases
//
// Cross-checked before embedding: `openssl verify` accepts the ed/ec/rsa/dp
// chains and rejects the nc/pl/xp/wrong-anchor ones.
fn fx_ck_leaf() -> string {
    return "";
}

fn fx_dp_i1() -> string {
    return "";
}

fn fx_dp_i2() -> string {
    return "";
}

fn fx_dp_leaf() -> string {
    return "";
}

fn fx_dp_root() -> string {
