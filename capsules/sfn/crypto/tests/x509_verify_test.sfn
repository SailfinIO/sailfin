// ── SFN-823 oversize-OID fixture ──
//
// ov_leaf is `fx_us_leaf` (SFN-811's ecdsa-with-SHA512 fixture) with both the
// tbsCertificate.signature and outer signatureAlgorithm OIDs replaced,
// byte-for-byte identically, by a crafted-but-DER-valid 121-arc OID
// (`2.1.1.1...1`, 241 dotted-decimal characters). It exists only to prove
// `_oid_for_message`'s 64-character bound holds against a hostile OID; only
// the signature-algorithm identifiers were replaced, not the signature
// bytes, and those now-stale signature bytes are never verified, because
// the chosen-cut dispatch falls through to unsupported-algorithm before any
// signature arithmetic runs (SFN-823).
//
// The transformation, reproducible with any DER encoder: in `fx_us_leaf`,
// replace the content of both OBJECT IDENTIFIER elements holding
// `2a8648ce3d040304` (ecdsa-with-SHA512, 8 bytes) with the 120-byte string
// `51` followed by 119 `01` octets — 0x51 encodes arcs 2.1 per X.690 8.19.4
// and each 0x01 is a single-octet arc 1 — then re-encode every enclosing
// length prefix. Both OIDs must change identically or `_verify_link` rejects
// the inner/outer mismatch at x509_verify.sfn before reaching the dispatch.
// No openssl invocation produces this; it is deliberately not a certificate
// any issuer would sign.
fn fx_ov_leaf() -> string {
    return "";
}

// ── SFN-823 pair-mismatch fixture ──
//
// pm_leaf is `fx_ed_leaf` (SFN-340's Ed25519 leaf) with the tbsCertificate
// and outer AlgorithmIdentifiers replaced, byte-for-byte identically, by
// ecdsa-with-SHA256 (`2a8648ce3d040302`, 8 bytes) in place of the Ed25519
// signature OID (`2b6570`, 3 bytes). It exists only to prove `_pair_detail`
// names both OIDs when a supported signature algorithm cannot be paired
// with the issuer's key algorithm; the now-stale Ed25519 signature bytes
// are never verified, because `_verify_link` rejects on the algorithm
// mismatch before any signature arithmetic runs (SFN-823).
//
// The transformation, reproducible with any DER encoder: in `fx_ed_leaf`,
// replace the content of both OBJECT IDENTIFIER elements holding
// `2b6570` (Ed25519, 3 bytes) — the tbsCertificate.signature AlgorithmIdentifier
// and the outer Certificate.signatureAlgorithm AlgorithmIdentifier, but not
// the subjectPublicKeyInfo's own Ed25519 OID, which is left unchanged — with
// `2a8648ce3d040302` (ecdsa-with-SHA256, 8 bytes), then re-encode the two
// enclosing SEQUENCE length prefixes (tbsCertificate and Certificate; each
// grows by 5 bytes per replacement, and neither crosses the 127-byte
// length-of-length boundary). Both OIDs must change identically or
// `_verify_link` rejects the inner/outer mismatch before reaching the
// dispatch. The chain is verified through `fx_ed_inter`, the immediate
// issuer whose SPKI is checked by `_verify_link`; both `fx_ed_inter` and
// `fx_ed_root` are unmodified, so their SPKI stays Ed25519 (`1.3.101.112`)
// and the pairing failure is the only thing under test. No openssl
// invocation produces this; it is deliberately not a certificate any issuer
// would sign.
fn fx_pm_leaf() -> string {
    return "";
}

// ── SFN-823 fixture, repurposed by SFN-824 ──
//
// pss_*  RSASSA-PSS certificate signature: a plain rsaEncryption root signs a
//        leaf whose signature is RSASSA-PSS, so `signature_algorithm` parses
//        as 1.2.840.113549.1.1.10 while the issuer's SPKI stays plain RSA.
//        Its parameters are the supported profile — SHA-256, MGF1-SHA-256,
//        salt 32 — so since SFN-824 wired the PSS OID into the dispatch this
//        pair is the *positive* SHA-256 case, not the unsupported-algorithm
//        rejection it was introduced for. That rejection now rides on the
//        ecdsa-with-SHA512 `fx_us_leaf` instead. Produced with OpenSSL 3.6.3:
//
//   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out pss_root.key
//   openssl req -x509 -new -key pss_root.key -sha256 -subj "/CN=Sailfin Test Pss Root" \
//     -not_before 20260101000000Z -not_after 20360101000000Z \
//     -extensions v3_ca -config <extfile with basicConstraints=critical,CA:TRUE;
//       keyUsage=critical,keyCertSign,cRLSign; subjectKeyIdentifier=hash> \
//     -out pss_root.pem
//   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out pss_leaf.key
//   openssl req -new -key pss_leaf.key -subj "/CN=example.com" -out pss_leaf.csr
//   openssl x509 -req -in pss_leaf.csr -CA pss_root.pem -CAkey pss_root.key -CAcreateserial \
//     -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:digest -sha256 \
//     -not_before 20260101000000Z -not_after 20270101000000Z \
//     -extfile <basicConstraints=critical,CA:FALSE; keyUsage=critical,digitalSignature;
//       extendedKeyUsage=serverAuth; subjectAltName=DNS:example.com,DNS:*.example.com;
//       subjectKeyIdentifier=hash; authorityKeyIdentifier=keyid> \
//     -out pss_leaf.pem
//
// `openssl verify -CAfile pss_root.pem pss_leaf.pem` accepts the pair, so the
// rejection under test is ours and not a malformed certificate.
fn fx_pss_root() -> string {
    return "";
}

fn fx_pss_leaf() -> string {
    return "";
}

// ── SFN-824 fixtures ──
//
// pss_noparams / pss_tampered are synthetic byte-level splices of
// `fx_pss_leaf`, not independent OpenSSL output — OpenSSL will not emit an
// RSASSA-PSS AlgorithmIdentifier with an absent `parameters` field, and a
// signature that fails to verify is by definition not something a signer
// produces.
//
//   pss_noparams  both signature AlgorithmIdentifiers (the signed
//                 tbsCertificate.signature and the outer copy) rewritten from
//                 `SEQUENCE { OID, RSASSA-PSS-params }` to `SEQUENCE { OID }`,
//                 with the tbsCertificate and Certificate length prefixes
//                 recomputed. Both copies are edited so the certificate is
//                 refused for its parameters rather than for the
//                 inner/outer mismatch a one-sided edit would create. Editing
//                 the signed region invalidates the signature, which is
//                 immaterial: the parameter check runs first, and asserting
//                 the parameter code is what pins that ordering.
//   pss_outer_stripped
//                 `fx_pss_leaf` with the RSASSA-PSS-params removed from the
//                 OUTER signatureAlgorithm only, leaving the signed
//                 tbsCertificate — and so the inner copy — byte-identical.
//                 The OID still matches on both sides, so this reaches the
//                 dispatch and is caught by the parameters comparison rather
//                 than by the OID equality check that precedes it.
//   pss_tampered  `fx_pss_leaf` with the low bit of the final signature octet
//                 flipped. Length-preserving, so no prefix changes; the
//                 profile still parses as supported and the failure lands in
//                 the PSS verifier itself.
fn fx_pss_noparams() -> string {
    return "";
}

fn fx_pss_tampered() -> string {
    return "";
}

// pss2_*  A second RSASSA-PSS family carrying the parameter profiles the
//         `fx_pss_*` pair cannot: SHA-384, and three certificates that differ
//         from the supported profile in exactly one parameter. One
//         rsaEncryption root signs all four leaves, and all four leaves share
//         one key and one CSR, so the only variable across them is the
//         `-sigopt` set. Produced with OpenSSL 3.0.13:
//
//   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out root.key
//   openssl req -x509 -new -key root.key -sha256 -days 3650 \
//     -subj "/CN=Sailfin Test Pss2 Root" \
//     -addext basicConstraints=critical,CA:TRUE \
//     -addext keyUsage=critical,keyCertSign,cRLSign \
//     -addext subjectKeyIdentifier=hash -out root.pem
//   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out leaf.key
//   openssl req -new -key leaf.key -subj "/CN=example.com" -out leaf.csr
//   openssl x509 -req -in leaf.csr -CA root.pem -CAkey root.key -CAcreateserial \
//     -extfile leaf.ext -days 365 -sigopt rsa_padding_mode:pss <per-leaf opts> \
//     -out <leaf>.pem
//
//         with leaf.ext holding basicConstraints=critical,CA:FALSE;
//         keyUsage=critical,digitalSignature; extendedKeyUsage=serverAuth;
//         subjectAltName=DNS:example.com,DNS:*.example.com;
//         subjectKeyIdentifier=hash; authorityKeyIdentifier=keyid, and the
//         per-leaf options:
//
//   pss2_256      -sigopt rsa_pss_saltlen:digest -sigopt rsa_mgf1_md:sha256 -sha256
//   pss2_384      -sigopt rsa_pss_saltlen:digest -sigopt rsa_mgf1_md:sha384 -sha384
//   pss2_salt20   -sigopt rsa_pss_saltlen:20     -sigopt rsa_mgf1_md:sha256 -sha256
//   pss2_salt64   -sigopt rsa_pss_saltlen:64     -sigopt rsa_mgf1_md:sha256 -sha256
//   pss2_mgf384   -sigopt rsa_pss_saltlen:digest -sigopt rsa_mgf1_md:sha384 -sha256
//
//         `openssl verify -CAfile root.pem <leaf>.pem` prints OK for all five,
//         including salt20, salt64 and mgf384: those are well-formed RFC 8017
//         encodings that OpenSSL supports and this capsule deliberately does
//         not. Their rejection here is a scope decision, not a claim that the
//         certificates are malformed — which is why they are refused as
//         unsupported parameters rather than as a bad signature.
//
//         This OpenSSL build rejects `-not_before`/`-not_after` on `req`, so
//         the window starts at generation time rather than the 2026-01-01 the
//         older fixtures pin; `pss2_now_ms` exists for that reason.
fn pss2_now_ms() -> int { return 1788220800000; }

fn fx_pss_outer_stripped() -> string {
    return "";
}

fn fx_pss2_512() -> string {
    return "";
}

fn fx_pss2_root() -> string {
