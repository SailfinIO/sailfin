// capsules/sfn/crypto/tests/hkdf_test.sfn
//
// Regression coverage for HKDF-SHA-256 (RFC 5869) and its internal pure
// HMAC-SHA-256: RFC 4231 test case 1 cross-checks the HMAC, and RFC 5869
// test cases 1 and 3 cover extract/expand, including empty salt/info and
// out-of-range length rejection. Also covers the parametrized hash_len=48
// (SHA-384) paths of `hmac_bytes`/`hkdf_extract`/`hkdf_expand` (SFN-849),
// which previously had no execution coverage.
import {
    hkdf_expand,
    hkdf_extract,
    hkdf_sha256_expand,
    hkdf_sha256_extract,
    hmac_bytes,
    hmac_sha256_bytes
} from "../src/hkdf";
import { eq_bytes, hexb } from "./support/hex";

// RFC 4231 test case 1 cross-checks the internal pure HMAC-SHA-256.
test "hmac_sha256_bytes: RFC 4231 test case 1" {
    let key: int[] = hexb("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");  // 20 x 0x0b
    let data: int[] = [72, 105, 32, 84, 104, 101, 114, 101];  // "Hi There"
    let mac: int[] = hmac_sha256_bytes(key, data);
    assert eq_bytes(mac, hexb("b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"));
}

test "hkdf: RFC 5869 test case 1 extract" {
    let ikm: int[] = hexb("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");  // 22 x 0x0b
    let salt: int[] = hexb("000102030405060708090a0b0c");
    let prk: int[] = hkdf_sha256_extract(salt, ikm);
    assert eq_bytes(prk, hexb("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5"));
}

test "hkdf: RFC 5869 test case 1 expand (L=42)" {
    let prk: int[] = hexb("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
    let info: int[] = hexb("f0f1f2f3f4f5f6f7f8f9");
    let okm: int[] = hkdf_sha256_expand(prk, info, 42);
    assert eq_bytes(okm, hexb("3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865"));
}

test "hkdf: RFC 5869 test case 3 (empty salt and info)" {
    let ikm: int[] = hexb("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");  // 22 x 0x0b
    let salt: int[] = [];
    let prk: int[] = hkdf_sha256_extract(salt, ikm);
    assert eq_bytes(prk, hexb("19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04"));
    let info: int[] = [];
    let okm: int[] = hkdf_sha256_expand(prk, info, 42);
    assert eq_bytes(okm, hexb("8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8"));
}

test "hkdf: expand rejects out-of-range length" {
    let prk: int[] = hexb("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
    let info: int[] = [];
    let empty: int[] = hkdf_sha256_expand(prk, info, 0);
    assert empty.length == 0;
}

test "hkdf: expand rejects a PRK shorter than HashLen" {
    let short_prk: int[] = hexb("077709362c2e32df0ddc3f0dc47bba63");  // 16 bytes < 32
    let info: int[] = [];
    let empty: int[] = hkdf_sha256_expand(short_prk, info, 42);
    assert empty.length == 0;
}

// RFC 4231 test case 6: >block-size (128-byte) key branch of hmac_bytes at
// hash_len 48, which had no coverage before SFN-849.
test "hmac_bytes: RFC 4231 test case 6 at hash_len 48 (key longer than the 128-byte block)" {
    let key: int[] = hexb("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");  // 131 x 0xaa
    let data: int[] = hexb("54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374");
    let mac: int[] = hmac_bytes(48, key, data);
    assert eq_bytes(mac, hexb("4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952"));
}

// RFC 4231 test case 7: long key and long data at hash_len 48.
test "hmac_bytes: RFC 4231 test case 7 at hash_len 48 (long key and long data)" {
    let key: int[] = hexb("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");  // 131 x 0xaa
    let data: int[] = hexb("");
    let mac: int[] = hmac_bytes(48, key, data);
    assert eq_bytes(mac, hexb("6617178e941f020d351e2f254e8fd32c602420feb0b8fb9adccebb82461e99c5a678cc31e799176d3860e6110c46523e"));
}

// RFC 5869 has no SHA-384 trace; these vectors are computed per the RFC 5869
// algorithm at hash_len=48, mirroring the convention used for the SHA-384
// vectors in tls13_schedule_test.sfn. L=100 with hash_len=48 gives n=3,
// exercising both the multi-block counter loop and the tail truncation.
test "hkdf: multi-block expand at hash_len 48 (L=100, n=3)" {
    let ikm: int[] = hexb("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");  // 22 x 0x0b
    let salt: int[] = hexb("000102030405060708090a0b0c");
    let prk: int[] = hkdf_extract(48, salt, ikm);
    assert eq_bytes(prk, hexb("704b39990779ce1dc548052c7dc39f303570dd13fb39f7acc564680bef80e8dec70ee9a7e1f3e293ef68eceb072a5ade"));
    let info: int[] = hexb("f0f1f2f3f4f5f6f7f8f9");
    let okm: int[] = hkdf_expand(48, prk, info, 100);
    assert eq_bytes(okm, hexb("9b5097a86038b805309076a44b3a9f38063e25b516dcbf369f394cfab43685f748b6457763e4f0204fc5d95d1da3e62587b22eb8943d0fab6bb631a2fe9df1a68c6ce5d56116a52005b3f122b88b39b7251fcd6c44d3ef25f20ed96802bf1b2c1d98bf74"));
}

// ── Fail-closed on an unsupported hash length (SFN-666 design note 5.2) ──
//
// A hash_len that is neither 32 nor 48 has no ladder here. Without the guard
// `hkdf_expand` would size its counter loop on hash_len while `hmac_bytes`
// returned a 32-byte SHA-256 digest, so the truncation loop would read past
// the end of the accumulated output. These pin the guard on each entry point.
test "hmac_bytes: fails closed on an unsupported hash length" {
    let key: int[] = hexb("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");
    let data: int[] = hexb("4869205468657265");
    assert hmac_bytes(64, key, data).length == 0;
    assert hmac_bytes(20, key, data).length == 0;
    assert hmac_bytes(0, key, data).length == 0;
}

test "hkdf: extract fails closed on an unsupported hash length" {
    let ikm: int[] = hexb("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");
    let salt: int[] = hexb("000102030405060708090a0b0c");
    assert hkdf_extract(64, salt, ikm).length == 0;
    assert hkdf_extract(20, salt, ikm).length == 0;
}

test "hkdf: expand fails closed on an unsupported hash length" {
    let prk: int[] = hexb("704b39990779ce1dc548052c7dc39f303570dd13fb39f7acc564680bef80e8dec70ee9a7e1f3e293ef68eceb072a5ade");
    let info: int[] = hexb("f0f1f2f3f4f5f6f7f8f9");
    assert hkdf_expand(64, prk, info, 64).length == 0;
    assert hkdf_expand(40, prk, info, 40).length == 0;
}

// ── Output-length bounds at both hash lengths ────────────────────────────
//
// The 255 * hash_len cap is the one arithmetic substitution with no vector
// behind it at either instantiation, so a `256 *` typo or a `>=`/`>` slip
// would pass every RFC vector in this file.
test "hkdf: expand accepts the maximum output length and rejects one past it" {
    let prk32: int[] = hexb("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
    let info: int[] = hexb("f0f1f2f3f4f5f6f7f8f9");
    assert hkdf_sha256_expand(prk32, info, 8160).length == 8160;
    assert hkdf_sha256_expand(prk32, info, 8161).length == 0;

    let prk48: int[] = hexb("704b39990779ce1dc548052c7dc39f303570dd13fb39f7acc564680bef80e8dec70ee9a7e1f3e293ef68eceb072a5ade");
    assert hkdf_expand(48, prk48, info, 12240).length == 12240;
    assert hkdf_expand(48, prk48, info, 12241).length == 0;
}

test "hkdf: expand rejects a PRK shorter than hash_len at 48" {
    let short: int[] = hexb("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");  // 32 bytes
    let info: int[] = hexb("f0f1f2f3f4f5f6f7f8f9");
    assert hkdf_expand(48, short, info, 48).length == 0;
}
