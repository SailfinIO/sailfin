// capsules/sfn/crypto/tests/bits_test.sfn
//
// Regression coverage for the sfn/crypto bits module: masking, rotates,
// constant-time byte comparison, big/little-endian word codecs, and the
// strict base64 decoder (SFN-760). The decoder's transitive coverage through
// `pem_test.sfn` and `ed25519_sign_test.sfn` is strong, but this module is
// now where the code lives, so it gets a few direct padding-negative cases
// too.
import {
    mask32,
    rotl32,
    rotr32,
    ct_eq_bytes,
    load_u32_be,
    store_u32_be,
    load_u32_le,
    store_u32_le,
    string_to_bytes,
    strict_base64_bytes
} from "../src/bits";

test "bits: mask32 is 0xffffffff" { assert mask32() == 4294967295; }

test "bits: rotl32 of 1 by 1 is 2" { assert rotl32(1, 1) == 2; }

test "bits: rotl32 wraps the top bit" {
    // 0x80000000 rotated left by 1 == 0x00000001
    assert rotl32(2147483648, 1) == 1;
}

test "bits: rotr32 of 1 by 1 wraps to top bit" {
    // 0x00000001 rotated right by 1 == 0x80000000
    assert rotr32(1, 1) == 2147483648;
}

test "bits: rotl32 then rotr32 is identity" {
    assert rotr32(rotl32(305419896, 7), 7) == 305419896;  // 0x12345678
}

test "bits: ct_eq_bytes equal" {
    assert ct_eq_bytes([1, 2, 3], [1, 2, 3]) == true;
}

test "bits: ct_eq_bytes differ" {
    assert ct_eq_bytes([1, 2, 3], [1, 2, 4]) == false;
}

test "bits: ct_eq_bytes length mismatch" {
    assert ct_eq_bytes([1, 2], [1, 2, 3]) == false;
}

test "bits: ct_eq_bytes empty" {
    let a: int[] = [];
    let b: int[] = [];
    assert ct_eq_bytes(a, b) == true;
}

test "bits: load_u32_be" {
    // 0x12345678
    assert load_u32_be([18, 52, 86, 120], 0) == 305419896;
}

test "bits: store_u32_be round-trips" {
    let mut out: int[] = [];
    store_u32_be(out, 305419896);  // 0x12345678
    assert out.length == 4;
    assert out[0] == 18;
    assert out[1] == 52;
    assert out[2] == 86;
    assert out[3] == 120;
    assert load_u32_be(out, 0) == 305419896;
}

test "bits: load_u32_le" {
    // bytes 78 56 34 12 little-endian == 0x12345678
    assert load_u32_le([120, 86, 52, 18], 0) == 305419896;
}

test "bits: store_u32_le round-trips" {
    let mut out: int[] = [];
    store_u32_le(out, 305419896);
    assert out.length == 4;
    assert out[0] == 120;
    assert load_u32_le(out, 0) == 305419896;
}

// ── strict_base64_bytes padding negatives (mirrors pem_test.sfn) ──────────
test "bits: strict_base64_bytes rejects padding outside the final quad" {
    assert strict_base64_bytes(string_to_bytes("A=B=")).length == 0;
}

test "bits: strict_base64_bytes rejects a single-pad final quad with nonzero low bits" {
    // "QUJ=": d2 = sextet('J') = 9, and 9 & 3 != 0.
    assert strict_base64_bytes(string_to_bytes("QUJ=")).length == 0;
}

test "bits: strict_base64_bytes rejects a double-pad final quad with nonzero low bits" {
    // "AC==": d1 = sextet('C') = 2, and 2 & 15 != 0.
    assert strict_base64_bytes(string_to_bytes("AC==")).length == 0;
}

test "bits: strict_base64_bytes rejects '=' in the first position of a quad" {
    assert strict_base64_bytes(string_to_bytes("=ABC")).length == 0;
}

test "bits: strict_base64_bytes rejects '=' in the second position of a quad" {
    assert strict_base64_bytes(string_to_bytes("A=BC")).length == 0;
}

test "bits: strict_base64_bytes rejects a non-ASCII byte" {
    // U+0141 ('Ł') reaches the decoder as its two UTF-8 bytes 0xC5 0x81;
    // neither is in the base64 alphabet, so it fails closed.
    assert strict_base64_bytes(string_to_bytes("AŁB=")).length == 0;
}
