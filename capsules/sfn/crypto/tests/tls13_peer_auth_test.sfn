// capsules/sfn/crypto/tests/tls13_peer_auth_test.sfn
//
// Regression coverage for `hs_client_recv_certificate_verify`'s scheme
// dispatch (ecdsa_secp256r1_sha256 / rsa_pss_rsae_sha256 / rsa_pss_rsae_sha384
// / ed25519, RFC 8446 §4.2.3) and for `hs_client_verify_peer`, the trust half
// of server authentication that runs after it (SFN-767).
//
// Kept separate from `tls13_handshake_test.sfn`, which stays focused on the
// single RFC 8448 §3 trace — that trace signs with rsa_pss_rsae_sha256, so it
// never exercises the ECDSA or Ed25519 branches, the algorithm/key-type
// mismatch rejections, or the chain-trust step at all.
//
// The ECDSA and Ed25519 fixtures below (certificates and their
// CertificateVerify signatures) were generated with OpenSSL and cross-checked
// independently before being embedded; the RSA-PSS success path is already
// covered end-to-end by the RFC 8448 vector, so it is not duplicated here.
import {
    ClientHandshake,
    hs_client_recv_certificate_verify,
    hs_client_verify_peer,
    hs_state_wait_certificate_verify,
    hs_state_wait_finished
} from "../src/tls13_handshake";
import {
    encode_certificate_verify,
    tls_sigalg_ecdsa_secp256r1_sha256,
    tls_sigalg_ed25519,
    tls_sigalg_rsa_pss_rsae_sha256
} from "../src/tls13_handshake_codec";
import { X509Certificate, x509_parse } from "../src/x509";
import {
    X509ChainResult,
    x509_verify_err_bad_input,
    x509_verify_err_expired,
    x509_verify_err_hostname_mismatch,
    x509_verify_err_no_anchor,
    x509_verify_ok
} from "../src/x509_verify";

// Parse an even-length lowercase hex string into an int[] of bytes.
fn hexb(s: string) -> int[] {
    let mut out: int[] = [];
    let mut i: int = 0;
    loop {
        // `i + 1` rather than `i` so an odd-length literal returns what it
        // parsed instead of indexing past the end and killing the runner —
        // a mistyped vector should fail an assertion, not crash the suite.
        if i + 1 >= s.length { break; }
        let hi: int = _hexval(s[i]);
        let lo: int = _hexval(s[i + 1]);
        out.push(((hi << 4) | lo) & 255);
        i += 2;
    }
    return out;
}

fn _hexval(c: string) -> int {
    let code: int = char_code(c) & 255;
    if code >= 48 && code <= 57 {
        return code - 48;
    }  // '0'-'9'
    if code >= 97 && code <= 102 {
        return code - 97 + 10;
    }  // 'a'-'f'
    return 0;
}

fn eq_bytes(a: int[], b: int[]) -> bool {
    if a.length != b.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= a.length { break; }
        if a[i] != b[i] { return false; }
        i += 1;
    }
    return true;
}

// The fixed 32-byte transcript every CertificateVerify fixture below signs
// over: `tls13_certificate_verify_content` hashes it and prepends the 64
// spaces and context string, reproducing exactly what
// `hs_client_recv_certificate_verify` computes when `hs.transcript` is these
// bytes.
fn fx_transcript() -> int[] {
    return hexb("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
}

// ── EC P-256 leaf (CN=localhost, SAN localhost) ───────────────────
fn fx_ec_leaf() -> string {
    return "";
}

// ECDSA-SHA256 signature (DER Ecdsa-Sig-Value) over `fx_transcript()`'s
// CertificateVerify content, produced with `fx_ec_leaf()`'s private key.
fn fx_ec_signature() -> string {
    return "3046022100f0d53a2d7fc8428f54e2b8dabbdd2bb8aa1f7bc195e8d82d28ab09edb1549d28022100848eaf973a3320a861e49dc580f16741619a37188b09c1e9554335347af38e80";
}

// ── Ed25519 leaf, RFC 8032 §7.1 TEST 1 public key ─────────────────
fn fx_ed_leaf() -> string {
    return "";
}

// Ed25519 signature over `fx_transcript()`'s CertificateVerify content,
// produced with the RFC 8032 TEST 1 private key.
fn fx_ed_signature() -> string {
    return "52a4973548a23dad5176ae41f71930e8a77bcbfca6484fff2ec7cd08e466946fc93e87196b1cc50bf74d20255a283e5f31e6da3805002e1c91f3cdf4ee14310a";
}

// A `ClientHandshake` at WAIT_CERTIFICATE_VERIFY, holding `leaf_hex` as both
// the leaf and the (single-entry) chain, ready for
// `hs_client_recv_certificate_verify`. Every other field is empty/0 — the
// dispatch under test reads only the transcript and the leaf certificate.
fn _cv_handshake(leaf_hex: string) -> ClientHandshake {
    let leaf: int[] = hexb(leaf_hex);
    let empty: int[] = [];
    return ClientHandshake {
        state: hs_state_wait_certificate_verify(),
        transcript: fx_transcript(),
        client_private: empty,
        client_public: empty,
        offered_cipher_suites: empty,
        sent_legacy_session_id: empty,
        cipher_suite: 0,
        group: 0,
        shared_secret: empty,
        early_secret: empty,
        handshake_secret: empty,
        master_secret: empty,
        client_handshake_traffic_secret: empty,
        server_handshake_traffic_secret: empty,
        client_application_traffic_secret: empty,
        server_application_traffic_secret: empty,
        server_leaf_certificate: leaf,
        server_certificate_chain: [leaf],
        server_certificate_verified: false
    };
}

// ── CertificateVerify dispatch: success ────────────────────────────
test "tls13_peer_auth: an ecdsa_secp256r1_sha256 CertificateVerify verifies against the EC leaf" {
    let hs: ClientHandshake = _cv_handshake(fx_ec_leaf());
    let message: int[] = encode_certificate_verify(tls_sigalg_ecdsa_secp256r1_sha256(), hexb(fx_ec_signature()));
    match hs_client_recv_certificate_verify(hs, message) {
        Result.Ok { value } => {
            assert value.server_certificate_verified;
            assert value.state == hs_state_wait_finished();
            // The leaf carried into the returned state is the one that was
            // actually verified against, not a copy or a caller-supplied key.
            assert eq_bytes(value.server_leaf_certificate, hexb(fx_ec_leaf()));
        },
        Result.Err { error } => { assert error.length == 0; }
    }
}

test "tls13_peer_auth: an ed25519 CertificateVerify verifies against the Ed25519 leaf" {
    let hs: ClientHandshake = _cv_handshake(fx_ed_leaf());
    let message: int[] = encode_certificate_verify(tls_sigalg_ed25519(), hexb(fx_ed_signature()));
    match hs_client_recv_certificate_verify(hs, message) {
        Result.Ok { value } => {
            assert value.server_certificate_verified;
            assert value.state == hs_state_wait_finished();
            assert eq_bytes(value.server_leaf_certificate, hexb(fx_ed_leaf()));
        },
        Result.Err { error } => { assert error.length == 0; }
    }
}

// ── CertificateVerify dispatch: algorithm/key-type disagreement ───
test "tls13_peer_auth: rsa_pss_rsae_sha256 against an EC leaf is refused" {
    let hs: ClientHandshake = _cv_handshake(fx_ec_leaf());
    // The scheme names an RSA key; the leaf holds an EC one. The signature
    // bytes are irrelevant — the key-type check must reject before any
    // signature verification runs.
    let message: int[] = encode_certificate_verify(tls_sigalg_rsa_pss_rsae_sha256(), hexb(fx_ec_signature()));
    match hs_client_recv_certificate_verify(hs, message) {
        Result.Ok { value } => { assert false; },
        Result.Err { error } => { assert error.length > 0; }
    }
}

test "tls13_peer_auth: ecdsa_secp256r1_sha256 against an Ed25519 leaf is refused" {
    let hs: ClientHandshake = _cv_handshake(fx_ed_leaf());
    let message: int[] = encode_certificate_verify(tls_sigalg_ecdsa_secp256r1_sha256(), hexb(fx_ed_signature()));
    match hs_client_recv_certificate_verify(hs, message) {
        Result.Ok { value } => { assert false; },
        Result.Err { error } => { assert error.length > 0; }
    }
}

// ── CertificateVerify dispatch: tampered signature ─────────────────
test "tls13_peer_auth: a tampered ECDSA CertificateVerify signature is refused" {
    let hs: ClientHandshake = _cv_handshake(fx_ec_leaf());
    let mut tampered: int[] = hexb(fx_ec_signature());
    tampered[tampered.length - 1] = tampered[tampered.length - 1] ^ 1;
    let message: int[] = encode_certificate_verify(tls_sigalg_ecdsa_secp256r1_sha256(), tampered);
    match hs_client_recv_certificate_verify(hs, message) {
        Result.Ok { value } => { assert false; },
        Result.Err { error } => { assert error.length > 0; }
    }
}

// ── CertificateVerify dispatch: unknown/forbidden scheme ───────────
test "tls13_peer_auth: rsa_pkcs1_sha1 (forbidden by RFC 8446 §4.2.3) is refused" {
    let hs: ClientHandshake = _cv_handshake(fx_ec_leaf());
    let message: int[] = encode_certificate_verify(513, hexb(fx_ec_signature()));  // 0x0201, rsa_pkcs1_sha1
    match hs_client_recv_certificate_verify(hs, message) {
        Result.Ok { value } => { assert false; },
        Result.Err { error } => { assert error.length > 0; }
    }
}

// ── hs_client_verify_peer ──────────────────────────────────────────
// Fixtures copied from x509_verify_test.sfn (SFN-340): the local convention is
// per-file fixtures rather than a shared test-fixture module.
fn now_ms() -> int { return 1780272000000; }

fn before_ms() -> int { return 1748736000000; }

fn after_ms() -> int { return 1830297600000; }

fn fx_ed_inter() -> string {
    return "";
}

fn fx_ed_verify_leaf() -> string {
    return "";
}

fn fx_ed_root() -> string {
    return "";
}

fn fx_other_root() -> string {
    return "";
}

fn _cert(hex: string) -> X509Certificate { return x509_parse(hexb(hex)); }

// A `ClientHandshake` that has already proved possession of the leaf key
// (`server_certificate_verified: true`), carrying the leaf and one
// intermediate — everything `hs_client_verify_peer` needs.
fn _peer_handshake(verified: bool) -> ClientHandshake {
    let leaf: int[] = hexb(fx_ed_verify_leaf());
    let inter: int[] = hexb(fx_ed_inter());
    let empty: int[] = [];
    return ClientHandshake {
        state: hs_state_wait_finished(),
        transcript: empty,
        client_private: empty,
        client_public: empty,
        offered_cipher_suites: empty,
        sent_legacy_session_id: empty,
        cipher_suite: 0,
        group: 0,
        shared_secret: empty,
        early_secret: empty,
        handshake_secret: empty,
        master_secret: empty,
        client_handshake_traffic_secret: empty,
        server_handshake_traffic_secret: empty,
        client_application_traffic_secret: empty,
        server_application_traffic_secret: empty,
        server_leaf_certificate: leaf,
        server_certificate_chain: [leaf, inter],
        server_certificate_verified: verified
    };
}

test "tls13_peer_auth: hs_client_verify_peer succeeds for a trusted, current, matching-name chain" {
    let hs: ClientHandshake = _peer_handshake(true);
    let anchors: X509Certificate[] = [_cert(fx_ed_root())];
    let result: X509ChainResult = hs_client_verify_peer(hs, "example.com", anchors, now_ms());
    assert result.ok;
    assert result.code == x509_verify_ok();
}

test "tls13_peer_auth: hs_client_verify_peer rejects an expired chain" {
    let hs: ClientHandshake = _peer_handshake(true);
    let anchors: X509Certificate[] = [_cert(fx_ed_root())];
    let result: X509ChainResult = hs_client_verify_peer(hs, "example.com", anchors, after_ms());
    assert ! result.ok;
    assert result.code == x509_verify_err_expired();
}

test "tls13_peer_auth: hs_client_verify_peer rejects a hostname the leaf does not cover" {
    let hs: ClientHandshake = _peer_handshake(true);
    let anchors: X509Certificate[] = [_cert(fx_ed_root())];
    let result: X509ChainResult = hs_client_verify_peer(hs, "wrong.example", anchors, now_ms());
    assert ! result.ok;
    // The chain itself is trusted here; only the name fails, and the code must
    // say so rather than reporting the chain as unverifiable.
    assert result.code == x509_verify_err_hostname_mismatch();
}

test "tls13_peer_auth: hs_client_verify_peer rejects an unrecognised anchor" {
    let hs: ClientHandshake = _peer_handshake(true);
    let anchors: X509Certificate[] = [_cert(fx_other_root())];
    let result: X509ChainResult = hs_client_verify_peer(hs, "example.com", anchors, now_ms());
    assert ! result.ok;
    assert result.code == x509_verify_err_no_anchor();
}

// The ordering guarantee: a trusted chain must not be reported for a peer that
// never proved it holds the leaf's private key.
test "tls13_peer_auth: hs_client_verify_peer refuses before key possession is proved" {
    let hs: ClientHandshake = _peer_handshake(false);
    let anchors: X509Certificate[] = [_cert(fx_ed_root())];
    let result: X509ChainResult = hs_client_verify_peer(hs, "example.com", anchors, now_ms());
    assert ! result.ok;
    assert result.code == x509_verify_err_bad_input();
}
