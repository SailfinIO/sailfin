// compiler/capsules/syntax/src/parser/statements/control_flow.sfn
//
// Loop and conditional statement parsing.
import {
    Block,
    Decorator,
    ElseBranch,
    Expression,
    ForClause,
    Statement
} from "../../ast";
import { expression_from_tokens } from "../expressions";
import {
    collect_until,
    consume_keyword,
    find_top_level_identifier,
    identifier_matches,
    parser_advance_raw,
    parser_peek_raw,
    skip_trivia,
    source_span_from_tokens,
    symbol_matches,
    token_slice,
    trim_token_edges
} from "../token_utils";
import { BlockStatementParseResult, Parser } from "../types";
import { parse_block } from "./block";

fn parse_for_statement(parser: Parser, decorators: Decorator[]) -> BlockStatementParseResult {
    let original = parser;
    let mut current = skip_trivia(parser);
    if !identifier_matches(parser_peek_raw(current), "for") {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let for_token = parser_peek_raw(current);
    current = consume_keyword(current, "for");
    let for_span = source_span_from_tokens([for_token]);

    let clause_capture = collect_until(skip_trivia(current), ["{"]);
    current = clause_capture.parser;
    let clause_tokens = trim_token_edges(clause_capture.tokens);
    if clause_tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }

    let in_index = find_top_level_identifier(clause_tokens, "in");
    if in_index == -1 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }

    let target_tokens = trim_token_edges(token_slice(clause_tokens, 0, in_index));
    let iterable_tokens = trim_token_edges(token_slice(clause_tokens, in_index
        + 1, clause_tokens.length));
    let mut _if410: boolean = false;
    if target_tokens.length == 0 { _if410 = true; }
    if iterable_tokens.length == 0 { _if410 = true; }
    if _if410 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }

    let target_expression = expression_from_tokens(target_tokens);
    let iterable_expression = expression_from_tokens(iterable_tokens);
    let clause = ForClause {
        target: target_expression,
        iterable: iterable_expression,
        tokens: clause_tokens
    };

    let body_result = parse_block(current);
    if body_result.block.tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    current = body_result.parser;
    let body = body_result.block;

    current = skip_trivia(current);
    let terminator = parser_peek_raw(current);
    if symbol_matches(terminator, ";") {
        current = parser_advance_raw(current);
    }

    let statement = Statement.ForStatement {
        clause: clause,
        body: body,
        decorators: decorators,
        span: for_span
    };

    return BlockStatementParseResult {
        parser: current,
        statement: statement,
        success: true
    };
}

// `while condition { body }` is syntax sugar for the canonical loop form:
// `loop { if !condition { break; } body }`. Desugaring here keeps every
// downstream pass on the established LoopStatement/IfStatement path. The
// parsed condition remains the operand of the synthetic negation, preserving
// its source spans for type/effect diagnostics, while the original body block
// retains its tokens and text for source-oriented tooling.
fn parse_while_statement(parser: Parser, decorators: Decorator[]) -> BlockStatementParseResult {
    let original = parser;
    let mut current = skip_trivia(parser);
    if !identifier_matches(parser_peek_raw(current), "while") {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let while_token = parser_peek_raw(current);
    current = consume_keyword(current, "while");
    let while_span = source_span_from_tokens([while_token]);

    let condition_capture = collect_until(skip_trivia(current), ["{"]);
    current = condition_capture.parser;
    let condition_tokens = trim_token_edges(condition_capture.tokens);
    if condition_tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let condition = expression_from_tokens(condition_tokens);

    let body_result = parse_block(current);
    if body_result.block.tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    current = body_result.parser;

    let guard = Statement.IfStatement {
        condition: Expression.Unary { operator: "!", operand: condition },
        then_block: Block {
            tokens: [],
            text: "{ break; }",
            statements: [Statement.BreakStatement { span: while_span }]
        },
        else_branch: null,
        decorators: [],
        span: while_span
    };
    let mut statements: Statement[] = [guard];
    let mut body_index: int = 0;
    loop {
        if body_index >= body_result.block.statements.length { break; }
        statements = append_statement(statements, body_result.block.statements[body_index]);
        body_index += 1;
    }
    let desugared_body = Block {
        tokens: body_result.block.tokens,
        text: body_result.block.text,
        statements: statements
    };

    current = skip_trivia(current);
    if symbol_matches(parser_peek_raw(current), ";") {
        current = parser_advance_raw(current);
    }

    return BlockStatementParseResult {
        parser: current,
        statement: Statement.LoopStatement {
            body: desugared_body,
            decorators: decorators,
            span: while_span
        },
        success: true
    };
}

fn parse_loop_statement(parser: Parser, decorators: Decorator[]) -> BlockStatementParseResult {
    let original = parser;
    let mut current = skip_trivia(parser);
    if !identifier_matches(parser_peek_raw(current), "loop") {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let loop_token = parser_peek_raw(current);
    current = consume_keyword(current, "loop");
    let loop_span = source_span_from_tokens([loop_token]);

    let body_result = parse_block(current);
    if body_result.block.tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    current = body_result.parser;

    current = skip_trivia(current);
    let terminator = parser_peek_raw(current);
    if symbol_matches(terminator, ";") {
        current = parser_advance_raw(current);
    }

    let statement = Statement.LoopStatement {
        body: body_result.block,
        decorators: decorators,
        span: loop_span
    };

    return BlockStatementParseResult {
        parser: current,
        statement: statement,
        success: true
    };
}

// Parse `routine { ... }` into a `RoutineStatement` (M4.0, issue #1081).
// Shaped like `parse_loop_statement` since the v0 surface is a bare block
// scope that yields no value. The caller (`parse_block_statement`) has
// already confirmed `routine` is immediately followed by `{`, so the soft
// keyword has committed. The `tokens.length == 0` guard below mirrors the
// one in `parse_loop_statement`: it rejects only a *missing* block (no `{`,
// where `parse_block` returns empty tokens) and is defensive here since the
// dispatch already guarantees the `{`. A present-but-empty `routine {}`
// has non-empty tokens (`{`, `}`) and parses to a `RoutineStatement` with
// an empty body, matching `loop {}`. Nested routine bodies recurse through
// `parse_block`.
fn parse_routine_statement(parser: Parser, decorators: Decorator[]) -> BlockStatementParseResult {
    let original = parser;
    let mut current = skip_trivia(parser);
    if !identifier_matches(parser_peek_raw(current), "routine") {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    current = consume_keyword(current, "routine");

    let body_result = parse_block(current);
    if body_result.block.tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    current = body_result.parser;

    current = skip_trivia(current);
    let terminator = parser_peek_raw(current);
    if symbol_matches(terminator, ";") {
        current = parser_advance_raw(current);
    }

    let statement = Statement.RoutineStatement {
        body: body_result.block,
        decorators: decorators
    };

    return BlockStatementParseResult {
        parser: current,
        statement: statement,
        success: true
    };
}

fn parse_break_statement(parser: Parser) -> BlockStatementParseResult {
    let original = parser;
    let mut current = skip_trivia(parser);
    if !identifier_matches(parser_peek_raw(current), "break") {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let break_token = parser_peek_raw(current);
    current = consume_keyword(current, "break");
    let break_span = source_span_from_tokens([break_token]);

    current = skip_trivia(current);
    let terminator = parser_peek_raw(current);
    if symbol_matches(terminator, ";") {
        current = parser_advance_raw(current);
    }

    return BlockStatementParseResult {
        parser: current,
        statement: Statement.BreakStatement { span: break_span },
        success: true
    };
}

fn parse_continue_statement(parser: Parser) -> BlockStatementParseResult {
    let original = parser;
    let mut current = skip_trivia(parser);
    if !identifier_matches(parser_peek_raw(current), "continue") {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let continue_token = parser_peek_raw(current);
    current = consume_keyword(current, "continue");
    let continue_span = source_span_from_tokens([continue_token]);

    current = skip_trivia(current);
    let terminator = parser_peek_raw(current);
    if symbol_matches(terminator, ";") {
        current = parser_advance_raw(current);
    }

    return BlockStatementParseResult {
        parser: current,
        statement: Statement.ContinueStatement { span: continue_span },
        success: true
    };
}

fn parse_if_statement(parser: Parser, decorators: Decorator[]) -> BlockStatementParseResult {
    let original = parser;
    let mut current = skip_trivia(parser);
    if !identifier_matches(parser_peek_raw(current), "if") {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let if_token = parser_peek_raw(current);
    current = consume_keyword(current, "if");
    let if_span = source_span_from_tokens([if_token]);

    let condition_capture = collect_until(skip_trivia(current), ["{"]);
    current = condition_capture.parser;
    let condition_tokens = trim_token_edges(condition_capture.tokens);
    if condition_tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    let condition_expression = expression_from_tokens(condition_tokens);

    let then_result = parse_block(current);
    if then_result.block.tokens.length == 0 {
        return BlockStatementParseResult {
            parser: original,
            statement: null,
            success: false
        };
    }
    current = then_result.parser;
    let then_block = then_result.block;

    current = skip_trivia(current);
    let mut else_branch: ElseBranch? = null;
    if identifier_matches(parser_peek_raw(current), "else") {
        current = consume_keyword(current, "else");
        current = skip_trivia(current);
        let next_token = parser_peek_raw(current);
        if identifier_matches(next_token, "if") {
            let nested_result = parse_if_statement(current, []);
            if !nested_result.success {
                return BlockStatementParseResult {
                    parser: original,
                    statement: null,
                    success: false
                };
            }
            if nested_result.statement == null {
                return BlockStatementParseResult {
                    parser: original,
                    statement: null,
                    success: false
                };
            }
            current = nested_result.parser;
            else_branch = ElseBranch {
                statement: nested_result.statement,
                body: null
            };
        } else {
            let else_result = parse_block(current);
            if else_result.block.tokens.length == 0 {
                return BlockStatementParseResult {
                    parser: original,
                    statement: null,
                    success: false
                };
            }
            current = else_result.parser;
            else_branch = ElseBranch {
                statement: null,
                body: else_result.block
            };
        }

        current = skip_trivia(current);
        let terminator = parser_peek_raw(current);
        if symbol_matches(terminator, ";") {
            current = parser_advance_raw(current);
        }
    }

    let statement = Statement.IfStatement {
        condition: condition_expression,
        then_block: then_block,
        else_branch: else_branch,
        decorators: decorators,
        span: if_span
    };

    return BlockStatementParseResult {
        parser: current,
        statement: statement,
        success: true
    };
}

fn append_statement(statements: Statement[], statement: Statement) -> Statement[] {
    statements.push(statement);
    return statements;
}
