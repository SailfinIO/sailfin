// compiler/capsules/codegen-llvm/src/lowering/entrypoints_tests_writer.sfn
//
// Test LLVM IR artifact generation.
//
// Single resolver-driven entry point. Threads import-context (manifests
// + native texts) from `prepare_project_capsules_for_test` (in
// `capsule_resolver.sfn`) into `lower_to_llvm_lines_with_parsed_-
// context_for_tests`, so the test source's mangled call sites bind to
// the dependency `.ll` files the resolver produced. The earlier no-
// context wrappers (`write_llvm_ir_for_tests`,
// `write_llvm_ir_for_tests_from_text`) were retired in Stage B PR2's
// A4 deletion alongside `compile_tests_to_llvm_file_with_module` and
// the textual import inliner.
import {
    ImportedModuleContext,
    LayoutManifest,
    NativeArtifact,
    NativeEnum,
    NativeFunction,
    NativeInterface,
    NativeModule,
    NativeStruct,
    ParseNativeResult
} from "sfn/ir";
import {
    parse_native_artifact,
    parse_native_enums_for_import,
    parse_native_functions_for_import,
    parse_native_interfaces_for_import,
    parse_native_structs_for_import
} from "sfn/ir";
import { substring } from "sfn/strings";

import {
    append_function_effect_entry,
    append_unique_effect,
    collect_direct_function_effects,
    collect_function_call_graph,
    collect_runtime_helper_targets,
    find_function_effect_entry,
    propagate_function_effects
} from "../effects";
import { apply_layout_manifest_to_module } from "../imports";
import { LLVMProviderContext, install_llvm_provider_context } from "../lowering_debug_state";
import {
    render_enum_type_definitions,
    render_imported_function_declarations,
    render_runtime_helper_declarations,
    render_struct_type_definitions,
    render_trait_metadata_comments
} from "../rendering";
import {
    collect_exported_symbol_names,
    find_function_by_name,
    render_interface_type_definitions,
    render_vtable_constants,
    render_vtable_type_definitions
} from "../rendering_helpers";
import {
    empty_string_constant_set,
    merge_string_constants,
    render_string_constants
} from "../strings";
import { sanitize_symbol } from "../symbols";
import { build_type_context, fixup_enum_layouts } from "../type_context";
import {
    FunctionEffectEntry,
    LLVMArtifactResult,
    LifetimeRegionMetadata,
    LoweredLLVMLinesResult,
    StringConstant,
    TraitMetadata,
    TypeContext
} from "../types";
import {
    append_string,
    index_of,
    join_with_separator,
    number_to_string,
    string_array_contains
} from "../utils";
import { emit_llvm_function } from "./emission";
import { has_error_diag } from "./lowering_core/diagnostics";
import { lower_to_llvm_lines_with_parsed_context_for_tests } from "./lowering_core/test_harness";
import {
    empty_trait_metadata,
    extend_native_enums,
    extend_native_functions,
    extend_native_interfaces,
    extend_native_structs,
    is_test_module_slug
} from "./lowering_helpers";
import { _join_llvm_lines_linear, concat_native_functions } from "./lowering_helpers_mangling";
import { empty_capability_manifest, flatten_struct_methods } from "./lowering_helpers_structs";
import {
    ensure_intrinsic_declarations,
    extend_string_lines,
    extend_string_lines_checked,
    module_source_filename
} from "./lowering_io";
import { lower_module_bindings_to_globals } from "./module_globals";

fn _failed_test_llvm_artifact(failure_message: string) -> LLVMArtifactResult {
    return LLVMArtifactResult {
        ok: false,
        artifact_name: "test-module.ll",
        artifact_format: "llvm-ir-text",
        lines: [],
        diags: [],
        failure_message: failure_message
    };
}

fn _failed_test_llvm_artifact_from_lowering(failure_message: string, lowered: LoweredLLVMLinesResult) -> LLVMArtifactResult {
    let mut result = _failed_test_llvm_artifact(failure_message);
    result.diags = lowered.diags;
    return result;
}

// Build LLVM IR for tests, threading import-context through from the resolver
// and driver-owned artifact reader. The already-loaded manifests, native texts,
// diagnostics, and canonical module aliases let
// `apply_module_symbol_mangling` rewrite import call sites in the
// test source to the same mangled names the dependency `.ll` files
// define.
fn lower_llvm_for_tests_from_text_with_provider_context(native_text: string, module_name: string, import_context: ImportedModuleContext, provider_context: LLVMProviderContext) -> LLVMArtifactResult {
    install_llvm_provider_context(provider_context);
    if native_text.length == 0 {
        return _failed_test_llvm_artifact("test llvm: empty native text");
    }
    // Structured parser (Phase 4 PR 2). The 0.5.9 seed + PR #229's in-memory
    // lowering handle typed-instruction variants (Let, Return, If, …)
    // correctly across module boundaries, so the prior recovery-parser
    // fallback (which flattened every instruction to Expression(tag→21)) is
    // no longer needed.
    let parse = parse_native_artifact(native_text);
    let dummy_module = NativeModule {
        module_name: module_name,
        artifacts: [NativeArtifact {
            name: module_name, format: "sailfin-native-text", contents: native_text
        }],
        entry_points: [],
        symbol_count: 0
    };
    let lowered_lines = lower_to_llvm_lines_with_parsed_context_for_tests(dummy_module, parse, import_context);
    if lowered_lines.lines.length == 0 {
        return _failed_test_llvm_artifact_from_lowering("test llvm: no lines emitted from native text", lowered_lines);
    }
    // Refuse to return publishable IR when any lowering pass surfaced an error
    // diagnostic (issue #675). The non-test entry points
    // already gate on this before returning a publishable artifact — the test
    // path bypassed the gate, so an error-severity
    // ABI primitive mismatch at a call site (e.g. `number → int`
    // coercion across an `await` boundary) was recorded for presentation but
    // then the partial IR ran the corrupted call anyway.
    // The cause rides out on the artifact and `_publish_llvm_artifact`
    // (`main.sfn`) renders it. Reporting here as well would print every line
    // twice, since the driver drains this pass's trace buffer before printing
    // — the duplicate-report anti-pattern recorded at `main.sfn` (SFN-608).
    if has_error_diag(lowered_lines.diags) {
        return _failed_test_llvm_artifact_from_lowering("", lowered_lines);
    }
    let ir = _join_llvm_lines_linear(lowered_lines.lines);
    if ir.length == 0 {
        return _failed_test_llvm_artifact_from_lowering("test llvm: empty IR after join from native text", lowered_lines);
    }
    return LLVMArtifactResult {
        ok: true,
        artifact_name: "test-module.ll",
        artifact_format: "llvm-ir-text",
        lines: lowered_lines.lines,
        diags: lowered_lines.diags,
        failure_message: ""
    };
}
