// compiler/capsules/codegen-llvm/src/lowering/lowering_phase_imports.sfn
//
// Phase 2 of LLVM lowering: imported-module context gathering.
//
// Extracted from lowering_core/mod.sfn to reduce its per-module compile peak
// RSS — moving the gather loop here removes ~6 sibling-module imports
// (parse_native_*_for_import, apply_layout_manifest_to_module,
// extend_native_functions) from the orchestrator's import set.
import {
    ImplicitSymbol,
    ImportModuleAlias,
    LayoutManifest,
    NativeBinding,
    NativeEnum,
    NativeFunction,
    NativeImport,
    NativeInterface,
    NativeStruct
} from "sfn/ir";
import {
    parse_native_artifact_for_import_with_bindings,
    parse_native_imports_for_import
} from "sfn/ir";

import {
    apply_layout_manifest_to_module,
    resolve_import_module_slug_for_module
} from "../imports";
import { collect_exported_symbol_names, find_function_by_name_or_import } from "../rendering_helpers";
import { string_array_contains } from "../utils";
import {
    extend_native_enums,
    extend_native_functions,
    extend_native_interfaces,
    extend_native_structs,
    extract_module_name_from_native_text
} from "./lowering_helpers";
import { flatten_struct_methods } from "./lowering_helpers_structs";

// Flat-array bundle of everything the imported modules contribute to the
// compile — structs, enums, interfaces, functions, and struct methods.
// Consumed once by lowering_core/mod.sfn's orchestrator, which immediately
// destructures into local variables.  Distinct from the unrelated
// `ImportedModuleContext` in native_ir.sfn (manifests/native_texts/
// diagnostics/module aliases); the two types serve different phases of the
// pipeline.
struct ImportedBinding {
    binding: NativeBinding;
    provider_module: string;
    is_implicit: boolean;
}

struct ImportedModuleSymbols {
    structs: NativeStruct[];
    enums: NativeEnum[];
    interfaces: NativeInterface[];
    functions: NativeFunction[];
    struct_methods: NativeFunction[];
    bindings: ImportedBinding[];
}

fn _implicit_binding_provider(symbols: ImplicitSymbol[], name: string, provider_module: string) -> string {
    let mut index: int = 0;
    loop {
        if index >= symbols.length { break; }
        let symbol = symbols[index];
        if symbol.kind == "value" && symbol.name == name && symbol.provider_module == provider_module {
            return provider_module;
        }
        index += 1;
    }
    return "";
}

// Extract struct methods from applied structs.
fn extract_import_struct_methods(applied_structs: NativeStruct[]) -> NativeFunction[] {
    return flatten_struct_methods(applied_structs);
}

fn _native_text_for_module(native_texts: string[], module_name: string) -> string {
    let mut index: int = 0;
    loop {
        if index >= native_texts.length { break; }
        let text = native_texts[index];
        index += 1;
        if text == null || text.length == 0 { continue; }
        if extract_module_name_from_native_text(text) == module_name {
            return text;
        }
    }
    return "";
}

fn _resolved_import_module(import_path: string, parent_module: string, native_texts: string[], module_aliases: ImportModuleAlias[]) -> string {
    let base = resolve_import_module_slug_for_module(import_path, parent_module);
    let mut index: int = 0;
    loop {
        if index >= module_aliases.length { break; }
        if module_aliases[index].import_slug == base {
            return module_aliases[index].provider_slug;
        }
        index += 1;
    }
    if _native_text_for_module(native_texts, base).length > 0 { return base; }
    let mod_name = base + "/mod";
    if _native_text_for_module(native_texts, mod_name).length > 0 {
        return mod_name;
    }
    return base;
}

// Resolve one imported spelling through its exact provider module and any
// inline re-export aliases. The `(module, symbol)` cycle key prevents loops;
// module scoping prevents an unrelated same-named function from supplying the
// signature (SFN-1302).
fn _provider_function_signature(module_name: string, symbol: string, native_texts: string[], module_aliases: ImportModuleAlias[]) -> NativeFunction? {
    let mut current_module = module_name;
    let mut current_symbol = symbol;
    let mut seen: string[] = [];
    loop {
        let visit_key = current_module + "\n" + current_symbol;
        if string_array_contains(seen, visit_key) { return null; }
        seen.push(visit_key);
        let text = _native_text_for_module(native_texts, current_module);
        if text.length == 0 { return null; }
        let functions = parse_native_artifact_for_import_with_bindings(text).functions;
        let mut function_index: int = 0;
        loop {
            if function_index >= functions.length { break; }
            if functions[function_index].name == current_symbol {
                return functions[function_index];
            }
            function_index += 1;
        }
        let exports = parse_native_imports_for_import(text);
        let mut found = false;
        let mut i: int = 0;
        loop {
            if i >= exports.length { break; }
            let entry = exports[i];
            i += 1;
            if entry == null || entry.kind != "export" || entry.specifiers == null {
                continue;
            }
            let mut j: int = 0;
            loop {
                if j >= entry.specifiers.length { break; }
                let spec = entry.specifiers[j];
                j += 1;
                if spec == null { continue; }
                let mut exported = spec.name;
                if spec.alias != null { exported = spec.alias; }
                if exported != current_symbol { continue; }
                current_symbol = spec.name;
                current_module = _resolved_import_module(entry.module, current_module, native_texts, module_aliases);
                found = true;
                break;
            }
            if found { break; }
        }
        if !found { return null; }
    }
    return null;
}

// Clone each explicit import's provider-scoped signature under its local
// spelling. These entries are resolution-only and are ordered before the
// transitive global function pool by the lowering orchestrator.
fn build_import_alias_signatures(imports: NativeImport[], candidate_functions: NativeFunction[], native_texts: string[], current_module: string, module_aliases: ImportModuleAlias[]) -> NativeFunction[] {
    let mut aliases: NativeFunction[] = [];
    if imports == null { return aliases; }
    let mut i: int = 0;
    loop {
        if i >= imports.length { break; }
        let imp = imports[i];
        i += 1;
        if imp == null { continue; }
        if imp.kind != "import" { continue; }
        let specs = imp.specifiers;
        if specs == null { continue; }
        let mut s: int = 0;
        loop {
            if s >= specs.length { break; }
            let spec = specs[s];
            s += 1;
            if spec == null { continue; }
            let mut alias_name = spec.name;
            if spec.alias != null { alias_name = spec.alias; }
            if alias_name.length == 0 { continue; }
            let provider_module = _resolved_import_module(imp.module, current_module, native_texts, module_aliases);
            let mut entry = _provider_function_signature(provider_module, spec.name, native_texts, module_aliases);
            if entry == null {
                entry = find_function_by_name_or_import(candidate_functions, spec.name);
            }
            if entry == null { continue; }
            let src: NativeFunction = entry;
            aliases.push(NativeFunction {
                name: alias_name, is_async: src.is_async, parameters: src.parameters, return_type: src.return_type, effects: src.effects, decorators: src.decorators, is_extern: src.is_extern, is_variadic: src.is_variadic, instructions: []
            });
        }
    }
    return aliases;
}

// Gather the per-import contribution (structs/enums/interfaces/functions/
// struct-methods/bindings) for the whole import list.  Parses each imported
// `.sfn-asm` text exactly ONCE per loop iteration using
// parse_native_artifact_for_import_with_bindings (the native_ir_api
// wrapper for (false, true)): `include_instructions=false`
// skips function bodies (only headers/params/meta needed for import context)
// and `include_top_level_bindings=true` collects exported `.let`/`.extern-var`
// constants (#1368).  The five per-kind parse calls this replaces all called
// parse_native_artifact_impl internally with (false, false) or (true, true);
// the flag difference for bindings is immaterial because binding lines are
// top-level (current==null), so the include_instructions fast-forward never
// activates for them (#2016, 5-parses→1).  Semantics are byte-for-byte
// preserved, including the intentional drop of apply_layout_manifest_to_module's
// diagnostics field and the parse_native_imports_for_import fast-path scan for
// export-name filtering.
fn gather_imported_module_symbols(safe_imported_native_texts: string[], safe_imported_manifests: LayoutManifest[], implicit_symbols: ImplicitSymbol[]) -> ImportedModuleSymbols {
    let mut imported_structs: NativeStruct[] = [];
    let mut imported_enums: NativeEnum[] = [];
    let mut imported_interfaces: NativeInterface[] = [];
    let mut imported_functions: NativeFunction[] = [];
    let mut imported_struct_methods: NativeFunction[] = [];
    let mut imported_bindings: ImportedBinding[] = [];

    let manifest_count = safe_imported_manifests.length;
    let mut text_index: int = 0;
    loop {
        if text_index >= safe_imported_native_texts.length { break; }
        let native_text = safe_imported_native_texts[text_index];
        let provider_module = extract_module_name_from_native_text(native_text);
        let mut manifest_for_module: LayoutManifest? = null;
        if text_index < manifest_count {
            manifest_for_module = safe_imported_manifests[text_index];
        }
        if native_text.length == 0 {
            if manifest_for_module != null {
                let manifest_only = manifest_for_module;
                imported_structs = extend_native_structs(imported_structs, manifest_only.structs);
                imported_enums = extend_native_enums(imported_enums, manifest_only.enums);
            }
            text_index += 1;
            continue;
        }
        let parsed = parse_native_artifact_for_import_with_bindings(native_text);
        let mut parsed_structs = parsed.structs;
        if parsed_structs == null { parsed_structs = []; }
        let mut parsed_enums = parsed.enums;
        if parsed_enums == null { parsed_enums = []; }
        let applied_import = apply_layout_manifest_to_module(parsed_structs, parsed_enums, manifest_for_module);
        let mut applied_structs = applied_import.structs;
        if applied_structs == null { applied_structs = []; }
        let mut applied_enums = applied_import.enums;
        if applied_enums == null { applied_enums = []; }
        let mut parsed_interfaces = parsed.interfaces;
        if parsed_interfaces == null { parsed_interfaces = []; }
        let mut parsed_functions = parsed.functions;
        if parsed_functions == null { parsed_functions = []; }
        let mut all_bindings = parsed.bindings;
        if all_bindings == null { all_bindings = []; }
        imported_structs = extend_native_structs(imported_structs, applied_structs);
        imported_enums = extend_native_enums(imported_enums, applied_enums);
        imported_interfaces = extend_native_interfaces(imported_interfaces, parsed_interfaces);
        imported_functions = extend_native_functions(imported_functions, parsed_functions);
        let imported_methods = extract_import_struct_methods(applied_structs);
        imported_struct_methods = extend_native_functions(imported_struct_methods, imported_methods);
        let exported_names = collect_exported_symbol_names(parse_native_imports_for_import(native_text));
        let mut bi: int = 0;
        loop {
            if bi >= all_bindings.length { break; }
            let binding = all_bindings[bi];
            bi += 1;
            if binding == null { continue; }
            if binding.name == null { continue; }
            let implicit_provider = _implicit_binding_provider(implicit_symbols, binding.name, provider_module);
            if string_array_contains(exported_names, binding.name)
                || implicit_provider.length > 0 {
                imported_bindings.push(ImportedBinding {
                    binding: binding, provider_module: provider_module, is_implicit: implicit_provider.length > 0
                });
            }
        }
        text_index += 1;
    }

    if safe_imported_native_texts.length < manifest_count {
        let mut manifest_index: int = safe_imported_native_texts.length;
        loop {
            if manifest_index >= manifest_count { break; }
            let leftover_manifest = safe_imported_manifests[manifest_index];
            imported_structs = extend_native_structs(imported_structs, leftover_manifest.structs);
            imported_enums = extend_native_enums(imported_enums, leftover_manifest.enums);
            manifest_index += 1;
        }
    }

    return ImportedModuleSymbols {
        structs: imported_structs,
        enums: imported_enums,
        interfaces: imported_interfaces,
        functions: imported_functions,
        struct_methods: imported_struct_methods,
        bindings: imported_bindings
    };
}

export { ImportedBinding };
