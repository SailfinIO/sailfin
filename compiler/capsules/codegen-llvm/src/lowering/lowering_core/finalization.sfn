// compiler/capsules/codegen-llvm/src/lowering/lowering_core/finalization.sfn
//
// Final LLVM text normalization after lowering and symbol mangling.
import { split, substring } from "sfn/strings";

import {
    index_of,
    join_with_separator,
    number_to_string,
    starts_with,
    string_array_contains,
    trim_text
} from "../../utils";

// Hoist named-function adapter requests out of function bodies and render one
// internal tail-call forwarding definition per materialized symbol. LLVM's
// `musttail` requires identical parameter counts, but this adapter has the
// extra hidden env parameter that the original C-ABI function lacks. The
// `tail` hint remains valid and the e2e `-O2` probe pins frame elimination.
// Markers
// carry `adapter|target|return|tilde-separated-params`. Tilde cannot appear in
// an LLVM type, so imported aggregate signatures cannot corrupt the marker.
fn hoist_named_fn_value_adapters(lines: string[]) -> string[] {
    let hint_prefix = "; fnval_adapter_decl ";
    let mut filtered: string[] = [];
    let mut adapters: string[] = [];
    let mut seen: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= lines.length { break; }
        let line = lines[index];
        let trimmed = trim_text(line);
        if !starts_with(trimmed, hint_prefix) {
            filtered.push(line);
            index += 1;
            continue;
        }
        let payload = substring(trimmed, hint_prefix.length, trimmed.length);
        let parts = split(payload, "|");
        if parts.length == 4 {
            let adapter = parts[0];
            if !string_array_contains(seen, adapter) {
                seen.push(adapter);
                let target = parts[1];
                let return_type = parts[2];
                let mut parameter_types: string[] = [];
                if parts[3].length > 0 {
                    parameter_types = split(parts[3], "~");
                }
                let mut signature: string[] = ["i8* %__fnval_env"];
                let mut call_args: string[] = [];
                let mut parameter_index: int = 0;
                loop {
                    if parameter_index >= parameter_types.length { break; }
                    let arg_name = "%__fnval_arg" + number_to_string(parameter_index);
                    signature.push(parameter_types[parameter_index] + " "
                        + arg_name);
                    call_args.push(parameter_types[parameter_index] + " "
                        + arg_name);
                    parameter_index += 1;
                }
                adapters.push("define internal " + return_type + " @" + adapter
                    + "("
                    + join_with_separator(signature, ", ")
                    + ") {");
                adapters.push("block.entry:");
                let call_text = "tail call " + return_type + " @" + target + "("
                    + join_with_separator(call_args, ", ")
                    + ")";
                if return_type == "void" {
                    adapters.push("  " + call_text);
                    adapters.push("  ret void");
                } else {
                    adapters.push("  %__fnval_result = " + call_text);
                    adapters.push("  ret " + return_type + " %__fnval_result");
                }
                adapters.push("}");
                adapters.push("");
            }
        }
        index += 1;
    }
    if adapters.length == 0 { return lines; }
    filtered.push("");
    let mut adapter_index: int = 0;
    loop {
        if adapter_index >= adapters.length { break; }
        filtered.push(adapters[adapter_index]);
        adapter_index += 1;
    }
    return filtered;
}

// Hoist `; closure_env_type_decl %T = type { ... }` hint comments
// from inside function bodies up to the module preamble (issue #687).
// Each lambda's hint is emitted twice — once at the lambda-site
// alloc and once at the lifted-function load prologue — so the
// dedup table tracks the LLVM type name (`%sfn_closure_env_<N>`)
// and skips duplicates. The hoist inserts the unique decls
// immediately after the `source_filename = "..."` line, which
// guarantees they appear before any function body that references
// the named type.
fn hoist_closure_env_type_decls(lines: string[]) -> string[] {
    let hint_prefix = "; closure_env_type_decl ";
    let mut hoisted: string[] = [];
    let mut seen_names: string[] = [];
    let mut filtered: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= lines.length { break; }
        let line = lines[index];
        let trimmed = trim_text(line);
        if starts_with(trimmed, hint_prefix) {
            let decl_text = trim_text(substring(trimmed, hint_prefix.length, trimmed.length));
            let type_name = _hoist_extract_type_name(decl_text);
            if type_name.length > 0 {
                let mut already: boolean = false;
                let mut _si: int = 0;
                loop {
                    if _si >= seen_names.length { break; }
                    if seen_names[_si] == type_name {
                        already = true;
                        break;
                    }
                    _si += 1;
                }
                if !already {
                    seen_names.push(type_name);
                    hoisted.push(decl_text);
                }
            }
            // Drop the hint line — it has been hoisted (or was a duplicate).
        } else { filtered.push(line); }
        index += 1;
    }
    if hoisted.length == 0 { return lines; }

    // Find the insertion point: the line right after `source_filename = `.
    let mut insert_after: int = -1;
    let mut fi: int = 0;
    loop {
        if fi >= filtered.length { break; }
        if starts_with(trim_text(filtered[fi]), "source_filename = ") {
            insert_after = fi;
            break;
        }
        fi += 1;
    }

    let mut result: string[] = [];
    let mut ri: int = 0;
    loop {
        if ri >= filtered.length { break; }
        result.push(filtered[ri]);
        if ri == insert_after {
            result.push("");
            let mut hi: int = 0;
            loop {
                if hi >= hoisted.length { break; }
                result.push(hoisted[hi]);
                hi += 1;
            }
        }
        ri += 1;
    }
    // Fallback: if we never found a source_filename anchor, prepend.
    if insert_after < 0 {
        let mut prepended: string[] = [];
        let mut hi2: int = 0;
        loop {
            if hi2 >= hoisted.length { break; }
            prepended.push(hoisted[hi2]);
            hi2 += 1;
        }
        prepended.push("");
        let mut _fi2: int = 0;
        loop {
            if _fi2 >= filtered.length { break; }
            prepended.push(filtered[_fi2]);
            _fi2 += 1;
        }
        return prepended;
    }
    return result;
}

// Drop byte-identical module-scope `declare` lines, keeping the first
// occurrence. Only column-0 `declare ` lines are considered — function
// body lines are indented and never match, and `declare` never appears
// inside a `define` body. Deterministic (order-preserving), so the
// stage2==stage3 fixed point is unaffected. See the call site in
// `lower_to_llvm_lines_with_parsed_context` for the clang-vs-LLVM
// duplicate-declare rationale.
fn dedup_module_declare_lines(lines: string[]) -> string[] {
    let mut seen: string[] = [];
    let mut result: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= lines.length { break; }
        let line = lines[index];
        if starts_with(line, "declare ") {
            let mut already: boolean = false;
            let mut _si: int = 0;
            loop {
                if _si >= seen.length { break; }
                if seen[_si] == line {
                    already = true;
                    break;
                }
                _si += 1;
            }
            if !already {
                seen.push(line);
                result.push(line);
            }
        } else { result.push(line); }
        index += 1;
    }
    return result;
}

// SFN-154: append `%Name = type opaque` for every named type referenced by a
// `declare` line that lacks a `%Name = type ...` definition among `lines`.
// A runtime-helper declare can name a struct type (e.g. `%OwnedBuf*` from
// `io.read_fd`) in a module that neither defines nor forward-declares it, which
// clang rejects as `use of undefined type`. LLVM resolves module-scope named
// types independent of textual order, so appending the forward declaration
// after its use is valid. Keys on emitted text only, so it never double-defines
// a type the module already spells out in full (opaque or body).
fn _append_missing_opaque_forward_decls(lines: string[]) -> string[] {
    let mut defined: string[] = [];
    let mut referenced: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "%") {
            let eq = index_of(line, " = type ");
            if eq > 0 {
                let name = substring(line, 0, eq);
                if !string_array_contains(defined, name) {
                    defined.push(name);
                }
            }
        }
        if starts_with(line, "declare ") {
            let mut j: int = 0;
            loop {
                if j >= line.length { break; }
                if substring(line, j, j + 1) == "%" {
                    let mut k: int = j + 1;
                    loop {
                        if k >= line.length { break; }
                        let ch = substring(line, k, k + 1);
                        let mut stop: boolean = false;
                        if ch == "*" { stop = true; }
                        if ch == " " { stop = true; }
                        if ch == "," { stop = true; }
                        if ch == "(" { stop = true; }
                        if ch == ")" { stop = true; }
                        if ch == "}" { stop = true; }
                        if ch == ">" { stop = true; }
                        if stop { break; }
                        k += 1;
                    }
                    if k > j + 1 {
                        let name = substring(line, j, k);
                        if !string_array_contains(referenced, name) {
                            referenced.push(name);
                        }
                    }
                    j = k;
                } else { j += 1; }
            }
        }
        i += 1;
    }
    let mut r: int = 0;
    loop {
        if r >= referenced.length { break; }
        let name = referenced[r];
        if !string_array_contains(defined, name) {
            lines.push(name + " = type opaque");
        }
        r += 1;
    }
    return lines;
}

// Extract `%T` from `%T = type { ... }`. The name spans from the
// leading `%` up to (but not including) the first space.
fn _hoist_extract_type_name(decl: string) -> string {
    let trimmed = trim_text(decl);
    if trimmed.length == 0 { return ""; }
    if trimmed[0] != "%" { return ""; }
    let mut cursor: int = 0;
    let mut name: string = "";
    loop {
        if cursor >= trimmed.length { break; }
        let ch = trimmed[cursor];
        if ch == " " { break; }
        name = name + ch;
        cursor += 1;
    }
    return name;
}
