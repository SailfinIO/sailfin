// compiler/capsules/codegen-llvm/src/lowering/lowering_core/decorator_imports.sfn
//
// Imported decorator discovery for lowering.
import { NativeFunction, NativeImport } from "sfn/ir";

import { string_array_contains } from "../../utils";

// True when an imported function of the given (export) name carries the
// `@decorator` marker (ast.sfn::decorator_marker_name() == "decorator").
// The import parser preserves top-level `.decorator` directives into
// `NativeFunction.decorators` even for signature-only import parses
// (native_ir_api::parse_native_artifact_for_import_with_bindings).
fn _imported_function_is_decorator(imported_functions: NativeFunction[], name: string) -> boolean {
    if imported_functions.length > 100000 { return false; }
    let mut i: int = 0;
    loop {
        if i >= imported_functions.length { break; }
        let entry = imported_functions[i];
        if entry.name == name {
            if string_array_contains(entry.decorators, "decorator") {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

// SFN-72: local (post-alias) names of imported `@decorator`-marked functions,
// so lowering can tell a capsule-resolved decorator from the built-in
// runtime-helper fallback (effects.sfn::collect_function_runtime_helper_targets).
// Gated on the `@decorator` marker (SFEP-0023 §4.2): an imported *non*-
// decorator symbol applied as `@name` must NOT route to the capsule-call
// branch — that would emit a wrong-ABI call to a non-Tier-1 symbol. Only a
// genuinely marked import is a decorator; anything else stays inert.
fn _decorator_import_local_names(imports: NativeImport[], imported_functions: NativeFunction[]) -> string[] {
    let mut names: string[] = [];
    if imports.length > 100000 { return names; }
    let mut i: int = 0;
    loop {
        if i >= imports.length { break; }
        let specs = imports[i].specifiers;
        let mut j: int = 0;
        loop {
            if j >= specs.length { break; }
            let spec = specs[j];
            // The imported symbol's own (export) name carries the marker; the
            // local name (alias if present) is what the decorator is applied as.
            let export_name = spec.name;
            let mut local: string = spec.name;
            if spec.alias != null {
                if spec.alias.length > 0 { local = spec.alias; }
            }
            if _imported_function_is_decorator(imported_functions, export_name) {
                if !string_array_contains(names, local) {
                    names.push(local);
                }
            }
            j += 1;
        }
        i += 1;
    }
    return names;
}
