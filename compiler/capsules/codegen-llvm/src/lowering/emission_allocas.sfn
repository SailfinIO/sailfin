// Entry-block alloca hoisting for LLVM function bodies (SFN-968).
//
// The expression-lowering layer emits `alloca` text straight into the body
// line stream and has no route to the hoisted alloca list that
// `emission.sfn` splices ahead of the body, so those allocas land in
// whatever basic block is current — `then`, `merge`, `loop.body`,
// `afterloop`, `else`. An alloca in a block that executes repeatedly grows
// the stack every iteration and is not reclaimed until the function
// returns; SFN-967 fixed the `match` half of the same defect after it
// produced a SIGSEGV with one frame at 8.0 MiB.
//
// Rather than thread an alloca sink through the ~30 signatures below
// `lower_expression`, the body stream is partitioned once here, as a
// sibling of the `_reorder_phis_to_block_start` post-pass in
// `emission.sfn`.
import { substring } from "sfn/strings";

import {
    extend_string_array,
    index_of,
    starts_with,
    trim_text
} from "../utils";

// SFN-968: locate the first comma in an alloca's type text that is not
// nested inside an aggregate literal (`{i8*, i64}`) or an array/vector type
// (`[592 x i8]`). Only a top-level comma introduces a trailing clause;
// commas below depth zero are part of the type itself. Returns -1 when the
// type carries no trailing clause.
fn _top_level_comma_index(type_text: string) -> int {
    let mut depth: int = 0;
    let mut i: int = 0;
    loop {
        if i >= type_text.length { break; }
        let ch = substring(type_text, i, i + 1);
        if ch == "{" { depth += 1; }
        if ch == "[" { depth += 1; }
        if ch == "<" { depth += 1; }
        if ch == "}" { depth -= 1; }
        if ch == "]" { depth -= 1; }
        if ch == ">" { depth -= 1; }
        if ch == "," {
            if depth == 0 { return i; }
        }
        i += 1;
    }
    return -1;
}

// SFN-968: identify an `alloca` line that is safe to hoist out of a non-entry
// block into the function entry block. Relocation can only widen an alloca's
// dominance region, because a fixed-size alloca references no SSA operand —
// so the question is only whether the allocation is fixed-size.
//
// The discriminator is the trailing clause after the first top-level comma,
// not the presence of a comma anywhere: `alloca {i8*, i64}` (every string
// operand) and `alloca [592 x i8], align 8` (the filesystem intrinsics) are
// both fixed-size and both must hoist. Only LLVM's dynamic form,
// `alloca T, i32 %n`, takes an SSA count operand and must stay where it is.
// This compiler emits no dynamic alloca today, so the check guards a form
// that does not yet occur; it is kept because declining is always safe and
// the cost of getting it wrong later is a stack overflow that -O2 hides.
fn _is_hoistable_alloca_line(line: string) -> boolean {
    let alloca_marker = " = alloca ";
    if line.length == 0 { return false; }
    if substring(line, 0, 1) != " " { return false; }
    let trimmed = trim_text(line);
    if !starts_with(trimmed, "%") { return false; }
    let pos = index_of(trimmed, alloca_marker);
    if pos <= 0 { return false; }
    let name = substring(trimmed, 0, pos);
    if index_of(name, " ") >= 0 { return false; }
    let type_text = substring(trimmed, pos + alloca_marker.length, trimmed.length);
    if type_text.length == 0 { return false; }
    let comma = _top_level_comma_index(type_text);
    if comma >= 0 {
        let trailing = trim_text(substring(type_text, comma + 1, type_text.length));
        if !starts_with(trailing, "align ") { return false; }
    }
    return true;
}

// Collect the hoistable alloca lines from a body line stream, in order.
fn _collect_hoistable_allocas(lines: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if _is_hoistable_alloca_line(line) { out = out.push(line); }
        i += 1;
    }
    return out;
}

// Remove the hoistable alloca lines from a body line stream, in order.
fn _strip_hoistable_allocas(lines: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if !_is_hoistable_alloca_line(line) { out = out.push(line); }
        i += 1;
    }
    return out;
}

// Assemble a function body with every hoistable `alloca` relocated ahead of
// it, so the entry-block splice in `emission.sfn` carries them. `allocas`
// are the lines the block-lowering layer already hoisted correctly; they
// keep their position ahead of anything recovered from the body.
fn hoist_allocas_to_entry(allocas: string[], body_lines: string[]) -> string[] {
    let mut out: string[] = [];
    out = extend_string_array(out, allocas);
    out = extend_string_array(out, _collect_hoistable_allocas(body_lines));
    out = extend_string_array(out, _strip_hoistable_allocas(body_lines));
    return out;
}
