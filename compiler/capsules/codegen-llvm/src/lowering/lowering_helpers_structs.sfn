// compiler/capsules/codegen-llvm/src/lowering/lowering_helpers_structs.sfn
//
// Struct and trait shaping for LLVM lowering: flattening struct methods into
// free functions, building the trait-metadata tables, and the capability
// manifest seed.
//
// Split out of `lowering_helpers_mangling.sfn` (SFN-773). That module had
// grown to the 750-line ceiling enforced by
// `compiler/tests/unit/lowering_line_budget_test.sfn` while holding two
// unrelated concerns: symbol mangling, and this. Neither half is a natural
// home for the other, so the budget was doing real work in flagging it.
//
import {
    NativeFunction,
    NativeInterface,
    NativeParameter,
    NativeStruct
} from "sfn/ir";
import { substring } from "sfn/strings";

import { sanitize_symbol } from "../symbols";
import {
    CapabilityManifest,
    TraitDescriptor,
    TraitImplementationDescriptor,
    TraitMetadata
} from "../types";
import { starts_with, string_array_contains, trim_text } from "../utils";

fn append_native_function(values: NativeFunction[], value: NativeFunction) -> NativeFunction[] {
    let mut out = values;
    if out == null { out = []; }
    out = out.push(value);
    return out;
}

// Discover lowered `<StructName><MethodName>` symbols in imported native text.
fn collect_struct_method_symbols(native_text: string) -> string[] {
    let mut result: string[] = [];
    if native_text.length == 0 { return result; }
    let mut current_struct: string = "";
    let mut scan_pos: int = 0;
    loop {
        if scan_pos >= native_text.length { break; }
        let mut line_end = scan_pos;
        loop {
            if line_end >= native_text.length || native_text[line_end] == "\n" {
                break;
            }
            line_end += 1;
        }
        let line = trim_text(substring(native_text, scan_pos, line_end));
        scan_pos = line_end + 1;
        if starts_with(line, ".struct ") {
            let tail = trim_text(substring(line, 8, line.length));
            let mut end: int = 0;
            loop {
                if end >= tail.length || tail[end] == " " || tail[end] == "<" {
                    break;
                }
                end += 1;
            }
            current_struct = substring(tail, 0, end);
            continue;
        }
        if starts_with(line, ".endstruct") {
            current_struct = "";
            continue;
        }
        if current_struct.length == 0 || !starts_with(line, ".method ") {
            continue;
        }
        let mut tail = trim_text(substring(line, 8, line.length));
        if starts_with(tail, "async ") {
            tail = trim_text(substring(tail, 6, tail.length));
        }
        let mut end: int = 0;
        loop {
            if end >= tail.length || tail[end] == "(" || tail[end] == "<" {
                break;
            }
            end += 1;
        }
        if end >= tail.length { continue; }
        let method_name = trim_text(substring(tail, 0, end));
        if method_name.length == 0 { continue; }
        let symbol = sanitize_symbol(current_struct + method_name);
        if symbol.length > 0 && !string_array_contains(result, symbol) {
            result.push(symbol);
        }
    }
    return result;
}

fn empty_capability_manifest() -> CapabilityManifest {
    return CapabilityManifest { entries: [] };
}

fn build_trait_metadata(interfaces: NativeInterface[], structs: NativeStruct[]) -> TraitMetadata {
    let mut _if275: boolean = false;
    if interfaces.length > 10000 { _if275 = true; }
    if structs.length > 10000 { _if275 = true; }
    if _if275 {
        return TraitMetadata { interfaces: [], implementations: [] };
    }
    let mut interface_descriptors: TraitDescriptor[] = [];
    let mut index: int = 0;
    loop {
        if index >= interfaces.length { break; }
        let interface = interfaces[index];
        let mut updated_interfaces = interface_descriptors;
        updated_interfaces = updated_interfaces.push(TraitDescriptor {
            name: interface.name, type_parameters: interface.type_parameters, signatures: interface.signatures
        });
        interface_descriptors = updated_interfaces;
        index += 1;
    }

    let mut implementation_descriptors: TraitImplementationDescriptor[] = [];
    index = 0;
    loop {
        if index >= structs.length { break; }
        let definition = structs[index];
        let mut impls = definition.implements;
        if impls == null { impls = []; }
        if impls.length > 0 {
            let mut updated_impls = implementation_descriptors;
            updated_impls = updated_impls.push(TraitImplementationDescriptor {
                struct_name: definition.name, interfaces: impls
            });
            implementation_descriptors = updated_impls;
        }
        index += 1;
    }

    return TraitMetadata {
        interfaces: interface_descriptors,
        implementations: implementation_descriptors
    };
}

fn _lhm_is_ident_char(ch: string) -> boolean {
    if ch.length == 0 { return false; }
    if ch >= "a" && ch <= "z" { return true; }
    if ch >= "A" && ch <= "Z" { return true; }
    if ch >= "0" && ch <= "9" { return true; }
    if ch == "_" { return true; }
    return false;
}

// Rewrite every whole-identifier `Self` token in a method type annotation to
// the enclosing struct's concrete name. This is the compiler's `Self`
// desugaring inside a concrete struct method: `Self` denotes the enclosing
// type in every position, exactly as the `self` receiver is already typed to
// `%Struct*`. The walk is identifier-boundary aware so wrappers and suffixes
// resolve (`Self[]`, `&Self`, `Self?`, `mut Self`) while a distinct type such
// as `SelfContained` is left intact. Without this a `Self`-typed non-receiver
// parameter lowers to an opaque `i8*`, corrupting field access on it (#1898).
fn _lhm_resolve_self_annotation(annotation: string, struct_name: string) -> string {
    if annotation == null { return annotation; }
    if annotation.length == 0 { return annotation; }
    let mut result: string = "";
    let mut token: string = "";
    let mut i: int = 0;
    loop {
        if i >= annotation.length { break; }
        let ch = substring(annotation, i, i + 1);
        if _lhm_is_ident_char(ch) { token = token + ch; } else {
            if token.length > 0 {
                if token == "Self" { result = result + struct_name; } else {
                    result = result + token;
                }
                token = "";
            }
            result = result + ch;
        }
        i += 1;
    }
    if token.length > 0 {
        if token == "Self" { result = result + struct_name; } else {
            result = result + token;
        }
    }
    return result;
}

fn flatten_struct_methods(structs: NativeStruct[]) -> NativeFunction[] {
    if structs.length > 100000 { return []; }
    let mut result: NativeFunction[] = [];
    let mut index: int = 0;
    loop {
        if index >= structs.length { break; }
        let definition = structs[index];
        if definition.name == null {
            index += 1;
            continue;
        }
        if definition.name.length == 0 {
            index += 1;
            continue;
        }
        let mut methods = definition.methods;
        if methods == null {
            index += 1;
            continue;
        }
        if methods.length > 100000 {
            index += 1;
            continue;
        }
        let mut method_index: int = 0;
        loop {
            if method_index >= methods.length { break; }
            let method = methods[method_index];
            if method.name == null {
                method_index += 1;
                continue;
            }
            if method.name.length == 0 {
                method_index += 1;
                continue;
            }
            let qualified_name = definition.name + method.name;
            // Rebuild parameters so that the `self` parameter always carries
            // the struct name as its type_annotation.  The ABI corruption in
            // the v0.1.1 seed can leave nested parameter type_annotations as
            // empty strings, producing `define ... @Fn( %self)` in LLVM IR.
            let mut fixed_params: NativeParameter[] = [];
            let mut raw_params = method.parameters;
            if raw_params == null { raw_params = []; }
            let mut pi: int = 0;
            loop {
                if pi >= raw_params.length { break; }
                let p = raw_params[pi];
                let mut p_name = p.name;
                if p_name == null { p_name = ""; }
                let mut p_type = p.type_annotation;
                if p_type == null { p_type = ""; }
                // If this is the self parameter and type is empty, fill it
                // with the struct name so type mapping resolves correctly.
                if p_name == "self" {
                    if p_type.length == 0 { p_type = definition.name; }
                }
                // A `Self`-spelled non-receiver parameter (and nested forms
                // like `Self[]`) denotes the enclosing struct just like the
                // receiver; resolve it to the concrete type so it lowers to
                // `%Struct*` instead of an opaque `i8*` (#1898).
                p_type = _lhm_resolve_self_annotation(p_type, definition.name);
                let fixed_p = NativeParameter {
                    name: p_name,
                    type_annotation: p_type,
                    mutable: p.mutable,
                    default_value: p.default_value,
                    span: p.span
                };
                fixed_params.push(fixed_p);
                pi += 1;
            }
            // Return-position `Self` resolves to the enclosing struct too, so
            // a method declared `-> Self` carries the concrete return type
            // through lowering (#1898).
            let fixed_return = _lhm_resolve_self_annotation(method.return_type, definition.name);
            let qualified = NativeFunction {
                name: qualified_name,
                is_async: method.is_async,
                parameters: fixed_params,
                return_type: fixed_return,
                effects: method.effects,
                decorators: method.decorators,
                instructions: method.instructions,
                is_extern: false,
                is_variadic: method.is_variadic
            };
            result = append_native_function(result, qualified);
            method_index += 1;
        }
        index += 1;
    }
    return result;
}
