// compiler/capsules/codegen-llvm/src/secure_zero.sfn
//
// The `secure_zero` builtin and its LLVM lowering.
// `secure_zero(addr: int, len: int) -> void` writes zero to every byte
// in `[addr, addr + len)` with volatile stores that the optimizer may
// not delete, shorten, merge, or reorder against other volatile
// operations. Like `load_byte` (see `byte_load.sfn`) and the atomic
// builtins (`atomics.sfn`), the reserved name bypasses normal call
// resolution and lowers directly to LLVM instructions:
//
//     secure_zero(addr, len)  →
//       br label %secure_zero_pre_N
//     secure_zero_pre_N:
//       %p = inttoptr i64 <addr> to i8*
//       %a = icmp ne i64 <addr>, 0
//       %b = icmp sgt i64 <len>, 0
//       %g = and i1 %a, %b
//       br i1 %g, label %secure_zero_body_N, label %secure_zero_done_N
//     secure_zero_body_N:
//       %i = phi i64 [ 0, %secure_zero_pre_N ], [ %n, %secure_zero_body_N ]
//       %e = getelementptr i8, i8* %p, i64 %i
//       store volatile i8 0, i8* %e, align 1
//       %n = add i64 %i, 1
//       %c = icmp slt i64 %n, <len>
//       br i1 %c, label %secure_zero_body_N, label %secure_zero_done_N
//     secure_zero_done_N:
//
// Why this exists (SFN-782, design SFEP-0069 §3.6): cryptographic code
// must erase key material with a guarantee stronger than an ordinary
// array overwrite. A non-volatile final store is not a contract — a
// dead-store pass may delete it once it proves the bytes are never read
// again. LLVM's volatile-memory rule is the guarantee: optimizers must
// not change the number of volatile operations performed or their
// ordering relative to other volatile operations.
//
// Byte-store loop, not a platform call: `explicit_bzero` (BSD libcs) and
// `SecureZeroMemory` (Windows) are valid prior art but are rejected as
// the Sailfin ABI (SFEP-0069 §6.2) — they would add availability,
// header, and linkage branches to a guarantee LLVM already expresses
// uniformly. The same IR is normative on Linux, Darwin, and Windows, so
// this lowering has no target leg. Volatile `llvm.memset` is likewise
// rejected for v1 (§6.3): its detailed access behaviour is less
// precisely specified than the volatile-store rule this depends on.
//
// Address-based (not pointer-typed) to match the existing runtime byte
// idiom shared with `load_byte` — `_owned_buf_load_byte(addr: i64)`,
// `_num_put_byte(addr: i64, ...)` — which deliberately passes i64
// addresses to avoid `* u8` pointer-type friction under the seed.
//
// Phi-carried induction variable, not an `alloca` slot: the manual-loop
// precedent in `core_call_emission/filesystem_list.sfn` uses an `alloca`
// accumulator because it cannot name the block its own entry branch
// arrives from. This lowering emits an explicit `secure_zero_pre_N`
// preheader, so both phi incoming edges are statically known. That
// matters for a cleanup primitive: an `alloca` in a body block grows the
// stack once per iteration when `secure_zero` is called inside a loop
// and the `-O0` test pipeline never runs mem2reg.
//
// The loop is entered only when `addr != 0 && len > 0`, so a null
// pointer or a zero/negative length writes nothing (SFN-782 scope:
// zero-length/null safety, exact `[ptr, ptr + len)` range).
import { NativeFunction } from "sfn/ir";

// Mutually recursive with `lower_expression` (which dispatches calls
// back through the secure-zero hook): the same cycle `byte_load.sfn`
// and the atomic builtins rely on.
import { lower_expression } from "./expression_lowering/native/core";
import { format_temp_name } from "./expressions_helpers";
import { trace_log } from "./lowering_debug_state";
import { merge_string_constants } from "./strings";
import {
    ExpressionResult,
    LocalBinding,
    ParameterBinding,
    StringConstant,
    TypeContext
} from "./types";
import { extend_string_array, number_to_string, trim_text } from "./utils";

// Predicate over the reserved `secure_zero` name. Used by the
// pre-resolution dispatch hook in `lower_call_expression` (see
// `core_call_resolution/builtin_dispatch.sfn`) to short-circuit before
// consulting the runtime-helper registry.
fn is_secure_zero_builtin(name: string) -> boolean {
    let trimmed = trim_text(name);
    if trimmed == "secure_zero" { return true; }
    return false;
}

// Lower one `secure_zero` argument as `i64`, threading the accumulated
// lowering state. Returns null in `operand` when the argument failed to
// lower or is not an `i64`; the caller turns that into the E0806 fatal.
fn _lower_secure_zero_argument(label: string, index: int, arguments: string[], bindings: ParameterBinding[], locals: LocalBinding[], temp_index: int, lines: string[], functions: NativeFunction[], context: TypeContext) -> ExpressionResult {
    let mut diagnostics: string[] = [];
    let argument_text = trim_text(arguments[index]);
    let lowered = lower_expression(argument_text, bindings, locals, temp_index, lines, functions, context, "i64");
    diagnostics = extend_string_array(diagnostics, lowered.diagnostics);

    if lowered.operand == null {
        // `[fatal]`, unlike the otherwise-identical `byte_load.sfn` path.
        // `load_byte` yields a value, so a null operand is always caught
        // downstream by the SFN-527/SFN-548 null-operand gates. This
        // primitive is void: null *is* its success result, so the
        // bare-statement path has no null check and this sentinel is the
        // only thing standing between a failed argument lowering and IR
        // that is published, links, runs, and never wipes. Several
        // `lower_expression` failures are themselves non-fatal (e.g. an
        // unresolved array element type), so the path is reachable.
        let diag = "llvm lowering [fatal] [E0806]: secure_zero failed to lower "
            + label
            + " argument";
        trace_log(diag);
        diagnostics.push(diag);
        return ExpressionResult {
            lines: lowered.lines,
            temp_index: lowered.temp_index,
            operand: null,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants
        };
    }

    let operand = lowered.operand;
    let operand_type = trim_text(operand.llvm_type);
    if operand_type != "i64" {
        let diag = "llvm lowering [fatal] [E0806]: secure_zero expects argument "
            + number_to_string(index)
            + " ("
            + label
            + ") of type `int` (i64), got `"
            + operand_type
            + "`";
        trace_log(diag);
        diagnostics.push(diag);
        return ExpressionResult {
            lines: lowered.lines,
            temp_index: lowered.temp_index,
            operand: null,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants
        };
    }

    return ExpressionResult {
        lines: lowered.lines,
        temp_index: lowered.temp_index,
        operand: operand,
        diagnostics: diagnostics,
        string_constants: lowered.string_constants
    };
}

// Lower a `secure_zero(addr, len)` call. Caller has already validated
// that `is_secure_zero_builtin(name)` is true. Lowers both arguments
// through `lower_expression` (as `i64`), then emits the guarded
// volatile byte-store loop documented at the top of this file.
//
// Returns an `ExpressionResult` whose `operand` is null: `secure_zero`
// is a void operation, following `atomic_fence` in `atomics.sfn`. A null
// operand with no diagnostics is the void result convention; a null
// operand with a `[fatal]` diagnostic is the failure convention, and the
// emit-level entrypoints artifact gate refuses to publish IR rather than
// silently dropping the wipe (the #306 contract, as for the atomic and
// byte-load arity gates).
fn lower_secure_zero(name: string, arguments: string[], bindings: ParameterBinding[], locals: LocalBinding[], temp_index: int, lines: string[], functions: NativeFunction[], context: TypeContext) -> ExpressionResult {
    let mut diagnostics: string[] = [];
    let mut current_lines = lines;
    let mut current_temp = temp_index;
    let mut collected_strings: StringConstant[] = [];

    if arguments.length != 2 {
        let diag = "llvm lowering [fatal] [E0806]: secure_zero expects exactly 2 arguments (`int` address, `int` length), got "
            + number_to_string(arguments.length);
        trace_log(diag);
        diagnostics.push(diag);
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: null,
            diagnostics: diagnostics,
            string_constants: collected_strings
        };
    }

    let addr_lowered = _lower_secure_zero_argument("address", 0, arguments, bindings, locals, current_temp, current_lines, functions, context);
    diagnostics = extend_string_array(diagnostics, addr_lowered.diagnostics);
    collected_strings = merge_string_constants(collected_strings, addr_lowered.string_constants);
    current_lines = addr_lowered.lines;
    current_temp = addr_lowered.temp_index;
    if addr_lowered.operand == null {
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: null,
            diagnostics: diagnostics,
            string_constants: collected_strings
        };
    }

    let len_lowered = _lower_secure_zero_argument("length", 1, arguments, bindings, locals, current_temp, current_lines, functions, context);
    diagnostics = extend_string_array(diagnostics, len_lowered.diagnostics);
    collected_strings = merge_string_constants(collected_strings, len_lowered.string_constants);
    current_lines = len_lowered.lines;
    current_temp = len_lowered.temp_index;
    if len_lowered.operand == null {
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: null,
            diagnostics: diagnostics,
            string_constants: collected_strings
        };
    }

    let addr_value = addr_lowered.operand.value;
    let len_value = len_lowered.operand.value;

    // Block labels are unique per call site because `temp_index` rises
    // monotonically across a function's lowering and every `secure_zero`
    // consumes several temps — the same uniqueness `filesystem_list.sfn`
    // derives from its entry temp counter.
    let loop_id = number_to_string(current_temp);
    let pre_label = "secure_zero_pre_" + loop_id;
    let body_label = "secure_zero_body_" + loop_id;
    let done_label = "secure_zero_done_" + loop_id;

    let base_name = format_temp_name(current_temp);
    current_temp += 1;
    let addr_ok_name = format_temp_name(current_temp);
    current_temp += 1;
    let len_ok_name = format_temp_name(current_temp);
    current_temp += 1;
    let guard_name = format_temp_name(current_temp);
    current_temp += 1;
    let index_name = format_temp_name(current_temp);
    current_temp += 1;
    let element_name = format_temp_name(current_temp);
    current_temp += 1;
    let next_name = format_temp_name(current_temp);
    current_temp += 1;
    let repeat_name = format_temp_name(current_temp);
    current_temp += 1;

    // Terminate the incoming block so the preheader is a block the phi
    // below can name as an incoming edge.
    current_lines.push("  br label %" + pre_label);
    current_lines.push("");

    current_lines.push(pre_label + ":");
    current_lines.push("  " + base_name + " = inttoptr i64 " + addr_value
        + " to i8*");
    current_lines.push("  " + addr_ok_name + " = icmp ne i64 " + addr_value
        + ", 0");
    current_lines.push("  " + len_ok_name + " = icmp sgt i64 " + len_value
        + ", 0");
    current_lines.push("  " + guard_name + " = and i1 " + addr_ok_name + ", "
        + len_ok_name);
    current_lines.push("  br i1 " + guard_name + ", label %" + body_label
        + ", label %"
        + done_label);
    current_lines.push("");

    current_lines.push(body_label + ":");
    current_lines.push("  " + index_name + " = phi i64 [ 0, %" + pre_label
        + " ], [ "
        + next_name
        + ", %"
        + body_label
        + " ]");
    current_lines.push("  " + element_name + " = getelementptr i8, i8* "
        + base_name
        + ", i64 "
        + index_name);
    // The store the whole primitive exists for. `volatile` is what the
    // optimizer may not delete, shorten, or merge away (SFEP-0069 §3.6).
    current_lines.push("  store volatile i8 0, i8* " + element_name
        + ", align 1");
    current_lines.push("  " + next_name + " = add i64 " + index_name + ", 1");
    current_lines.push("  " + repeat_name + " = icmp slt i64 " + next_name
        + ", "
        + len_value);
    current_lines.push("  br i1 " + repeat_name + ", label %" + body_label
        + ", label %"
        + done_label);
    current_lines.push("");

    current_lines.push(done_label + ":");

    return ExpressionResult {
        lines: current_lines,
        temp_index: current_temp,
        operand: null,
        diagnostics: diagnostics,
        string_constants: collected_strings
    };
}

export { is_secure_zero_builtin, lower_secure_zero };
