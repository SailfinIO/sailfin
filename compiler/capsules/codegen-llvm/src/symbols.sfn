// compiler/capsules/codegen-llvm/src/symbols.sfn
//
// LLVM symbol-character classification and sanitization. These helpers are
// provider-owned because their accepted character set is part of LLVM naming.
import { char_code_at, substring } from "sfn/strings";

fn is_symbol_char(ch: string) -> boolean {
    if ch.length == 0 { return false; }
    if ch == "_" { return true; }
    // `$` is a legal LLVM identifier character and the monomorphization
    // mangling separator (#1869); admitting it changes only specialized names.
    if ch == "$" { return true; }
    let code = char_code_at(ch, 0);
    let lower_a = char_code_at("a", 0);
    let lower_z = char_code_at("z", 0);
    if code >= lower_a {
        if code <= lower_z { return true; }
    }
    let upper_a = char_code_at("A", 0);
    let upper_z = char_code_at("Z", 0);
    if code >= upper_a {
        if code <= upper_z { return true; }
    }
    let zero = char_code_at("0", 0);
    let nine = char_code_at("9", 0);
    if code >= zero {
        if code <= nine { return true; }
    }
    return false;
}

fn is_llvm_symbol_char(ch: string) -> boolean {
    if ch.length == 0 { return false; }
    if ch == "_" { return true; }
    let code = char_code_at(ch, 0);
    let lower_a = char_code_at("a", 0);
    let lower_z = char_code_at("z", 0);
    if code >= lower_a {
        if code <= lower_z { return true; }
    }
    let upper_a = char_code_at("A", 0);
    let upper_z = char_code_at("Z", 0);
    if code >= upper_a {
        if code <= upper_z { return true; }
    }
    let zero = char_code_at("0", 0);
    let nine = char_code_at("9", 0);
    if code >= zero {
        if code <= nine { return true; }
    }
    return false;
}

fn sanitize_symbol(name: string) -> string {
    if name.length == 0 { return "_"; }
    let mut result: string = "";
    let mut index: int = 0;
    loop {
        if index >= name.length { break; }
        let ch = substring(name, index, index + 1);
        if is_symbol_char(ch) { result = result + ch; }
        index += 1;
    }
    if result.length == 0 { return "_"; }
    let first_code = char_code_at(result, 0);
    let zero = char_code_at("0", 0);
    let nine = char_code_at("9", 0);
    if first_code >= zero {
        if first_code <= nine { result = "_" + result; }
    }
    return result;
}

export { is_llvm_symbol_char, is_symbol_char, sanitize_symbol };
