    lower_to_llvm_ir_from_text_with_provider_context,
    lower_to_llvm_ir_with_provider_context
} from "./lowering/entrypoints";

export { lower_llvm_for_tests_from_text_with_provider_context } from "./lowering/entrypoints_tests_writer";

export { fatal_lowering_diagnostic_lines, has_fatal_lowering_diagnostic } from "./lowering/lowering_core/diagnostics";

export { native_text_passes_lowering_gate } from "./lowering/lowering_core/file_emission";

export { LLVMProviderContext, take_lowering_trace_buffer } from "./lowering_debug_state";

export { runtime_helper_call_names } from "./runtime_helpers/mod";

export { LLVMArtifactResult } from "./types";
