// compiler/capsules/codegen-llvm/src/expression_lowering/native/mem_footprint_lowering.sfn
//
// Target-aware LLVM lowering for the Darwin process memory-footprint
// intrinsic. The Darwin ABI sequence stays isolated from the central call
// emitter so non-Darwin legs cannot acquire platform-only symbols.
import { format_temp_name } from "../../expressions_helpers";
import { fs_platform_leg } from "../../lowering_debug_state";
import { ExpressionResult, LLVMOperand, StringConstant } from "../../types";
import { number_to_string } from "../../utils";

// lower_mem_footprint_intrinsic emits the `proc_pid_rusage` observation on
// Darwin and folds the sentinel to zero on every other target. The Darwin
// `rusage_info_v2` ABI is 160 bytes with `ri_phys_footprint` at byte offset
// 72; the field is loaded only after `proc_pid_rusage` reports success.
fn lower_mem_footprint_intrinsic(temp_index: int, lines: string[], diagnostics: string[], string_constants: StringConstant[]) -> ExpressionResult {
    if fs_platform_leg() != "darwin" {
        let zero = LLVMOperand { llvm_type: "i64", value: "0" };
        return ExpressionResult {
            lines: lines,
            temp_index: temp_index,
            operand: zero,
            diagnostics: diagnostics,
            string_constants: string_constants
        };
    }

    let id = number_to_string(temp_index);
    let mut next_temp = temp_index;
    let buffer = format_temp_name(next_temp);
    next_temp += 1;
    let buffer_ptr = format_temp_name(next_temp);
    next_temp += 1;
    let pid = format_temp_name(next_temp);
    next_temp += 1;
    let status = format_temp_name(next_temp);
    next_temp += 1;
    let succeeded = format_temp_name(next_temp);
    next_temp += 1;
    let footprint_bytes = format_temp_name(next_temp);
    next_temp += 1;
    let footprint_ptr = format_temp_name(next_temp);
    next_temp += 1;
    let footprint = format_temp_name(next_temp);
    next_temp += 1;
    let result = format_temp_name(next_temp);
    next_temp += 1;

    let success_label = "mem_footprint_ok_" + id;
    let failure_label = "mem_footprint_fail_" + id;
    let done_label = "mem_footprint_done_" + id;
    let mut out_lines = lines;
    out_lines.push("  " + buffer + " = alloca [160 x i8], align 8");
    out_lines.push("  " + buffer_ptr
        + " = getelementptr [160 x i8], [160 x i8]* "
        + buffer
        + ", i32 0, i32 0");
    out_lines.push("  " + pid + " = call i32 @getpid()");
    out_lines.push("  " + status + " = call i32 @proc_pid_rusage(i32 " + pid
        + ", i32 2, i8* "
        + buffer_ptr
        + ")");
    out_lines.push("  " + succeeded + " = icmp eq i32 " + status + ", 0");
    out_lines.push("  br i1 " + succeeded + ", label %" + success_label
        + ", label %"
        + failure_label);
    out_lines.push("");
    out_lines.push(success_label + ":");
    out_lines.push("  " + footprint_bytes + " = getelementptr i8, i8* "
        + buffer_ptr
        + ", i64 72");
    out_lines.push("  " + footprint_ptr + " = bitcast i8* " + footprint_bytes
        + " to i64*");
    out_lines.push("  " + footprint + " = load i64, i64* " + footprint_ptr);
    out_lines.push("  br label %" + done_label);
    out_lines.push("");
    out_lines.push(failure_label + ":");
    out_lines.push("  br label %" + done_label);
    out_lines.push("");
    out_lines.push(done_label + ":");
    out_lines.push("  " + result + " = phi i64 [ " + footprint + ", %"
        + success_label
        + " ], [ 0, %"
        + failure_label
        + " ]");

    let operand = LLVMOperand { llvm_type: "i64", value: result };
    return ExpressionResult {
        lines: out_lines,
        temp_index: next_temp,
        operand: operand,
        diagnostics: diagnostics,
        string_constants: string_constants
    };
}

export { lower_mem_footprint_intrinsic };
