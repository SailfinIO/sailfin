// compiler/capsules/codegen-llvm/src/expression_lowering/native/core_call_resolution/signature.sfn
//
// Final call-signature resolution after target and method dispatch.
import { LoweringDiagnostic, NativeFunction } from "sfn/ir";
import { last_index_of_char as find_last_index_of_char, substring } from "sfn/strings";

import { find_prelude_mirror_signature } from "../../../prelude_mirror_signatures";
import { find_function_by_name_or_import } from "../../../rendering_helpers";
import { find_runtime_helper } from "../../../runtime_helpers/mod";
import { find_interface_info_by_name } from "../../../type_context_queries";
import { ends_with_pointer_suffix } from "../../../type_mapping";
import {
    CallSignatureResolution,
    LLVMOperand,
    RuntimeHelperDescriptor,
    TypeContext
} from "../../../types";
import { lowering_warning_diag, trim_text } from "../../../utils";
import { array_pointer_element_type } from "../../arrays";
import { collect_parameter_types } from "../core_helpers";
import { future_pointer_type_for_return_type, map_return_type } from "../core_type_mapping";

// Resolve the function signature for a call target: return type, expected parameter
// types, whether it's a trait dispatch, and the resolved function entry.
fn resolve_call_signature(trimmed_target: string, helper_descriptor: RuntimeHelperDescriptor?, method_operand: LLVMOperand?, is_array_concat: boolean, array_concat_element_type: string, is_closure_dispatch: boolean, closure_return_type: string, closure_parameter_types: string[], functions: NativeFunction[], context: TypeContext) -> CallSignatureResolution {
    let mut result_target = trimmed_target;
    let mut function_entry: NativeFunction? = null;
    // Empty signals "unresolved". `coerce_and_emit_call` emits a fatal
    // diagnostic (`llvm lowering [fatal]: cannot resolve return type ...`)
    // when this stays empty through emission; the emit-level entrypoints
    // LLVM artifact result gate scans for the `[fatal]` sentinel and refuses
    // publication, so the CLI exits non-zero
    // rather than guessing a return type. Pre-issue #306 this defaulted
    // to `i8*`, producing declare/call type mismatches that clang
    // tolerated for unused returns but were structurally malformed.
    let mut llvm_return: string = "";
    let mut expected_params: string[] = [];
    let mut is_trait_dispatch: boolean = false;
    let mut result_diags: LoweringDiagnostic[] = [];
    let mut result_helper = helper_descriptor;

    // Issue #689: closure dispatch carries its own pre-resolved
    // signature (derived from the lifted lambda's signature or a
    // user-supplied `fn(...) -> R` annotation in #688), so the
    // function-entry / helper lookups below are skipped.
    // `expected_params` includes the closure-pair aggregate as the
    // implicit "self" operand (`{i8*, i8*}`), mirroring how trait
    // dispatch prepends the trait object — `coerce_and_emit_call`
    // splits it out before emitting the extractvalue + call.
    if is_closure_dispatch {
        llvm_return = closure_return_type;
        let mut closure_expected: string[] = ["{i8*, i8*}"];
        let mut _cei: int = 0;
        loop {
            if _cei >= closure_parameter_types.length { break; }
            closure_expected.push(closure_parameter_types[_cei]);
            _cei += 1;
        }
        expected_params = closure_expected;
        return CallSignatureResolution {
            trimmed_target: result_target,
            function_entry: null,
            llvm_return: llvm_return,
            expected_params: expected_params,
            is_trait_dispatch: false,
            helper_overridden: false,
            is_closure_dispatch: true,
            diags: result_diags
        };
    }

    if substring(result_target, 0, 16) == "trait_dispatch__" {
        is_trait_dispatch = true;
        let after_prefix = substring(result_target, 16, result_target.length);
        let sep_pos = find_last_index_of_char(after_prefix, "_");
        if sep_pos > 1 {
            // Look for "__" separator (double underscore)
            let mut _td_split: int = -1;
            let mut _td_i: int = 0;
            loop {
                if _td_i >= after_prefix.length { break; }
                if substring(after_prefix, _td_i, _td_i + 2) == "__" {
                    _td_split = _td_i;
                }
                _td_i += 1;
            }
            if _td_split > 0 {
                let interface_name = substring(after_prefix, 0, _td_split);
                let method_name = substring(after_prefix, _td_split + 2, after_prefix.length);
                let interface_info2 = find_interface_info_by_name(context, interface_name);
                if interface_info2 != null {
                    let mut sig_idx: int = 0;
                    loop {
                        if sig_idx >= interface_info2.signatures.length {
                            break;
                        }
                        let sig = interface_info2.signatures[sig_idx];
                        if sig.name == method_name {
                            llvm_return = map_return_type(context, sig.return_type);
                            if llvm_return.length == 0 {
                                result_diags.push(lowering_warning_diag("E1006", "trait `"
                                    + interface_name
                                    + "` method `"
                                    + method_name
                                    + "` has unsupported return type `"
                                    + sig.return_type
                                    + "`", null));
                            }
                            expected_params = ["i8*"];
                            break;
                        }
                        sig_idx += 1;
                    }
                }
            }
        }
    }

    function_entry = find_function_by_name_or_import(functions, result_target);
    if result_helper == null {
        result_helper = find_runtime_helper(result_target);
    }

    let mut helper_overridden: boolean = false;
    if !is_trait_dispatch {
        // Issue #633: when a runtime-helper descriptor and a user-defined
        // function entry (local or imported) both match the call target,
        // the function entry is the source of truth. The registry rows
        // for `target == symbol` mirror clusters
        // (e.g. `number_to_string`, `char_code`, `find_char`) used to
        // win unconditionally, which forced every cross-module call to
        // adopt the registry's hand-typed C ABI signature. That collided
        // with the imported function's actual parameter types whenever
        // a source-level annotation diverged from the registry — flipping
        // `utils.sfn:number_to_string` to `value: int` made the importer
        // emit `(double)` against an `i64`-typed `define` and corrupted
        // `prelude.ll`. Preferring the function entry routes the
        // signature through the import-context interface so a source
        // annotation flip is a pure source change with no registry sync.
        // Method-form calls (`runtime.foo()`), bare calls in capsules
        // that have no user-defined function entry, and other cases
        // where `function_entry` is null continue to use the registry.
        if function_entry != null {
            result_target = function_entry.name;
            if function_entry.is_async {
                let future_return = future_pointer_type_for_return_type(function_entry.return_type);
                if future_return.length == 0 {
                    result_diags.push(lowering_warning_diag("E1006", "async function `"
                        + result_target
                        + "` has unsupported return type `"
                        + function_entry.return_type
                        + "`", null));
                    llvm_return = "i8*";
                } else { llvm_return = future_return; }
                // The underlying Sailfin return type is recovered on the let
                // side via find_function_by_name(functions, target) so `await`
                // can unbox structs — no file IPC needed.
                expected_params = collect_parameter_types(context, function_entry.parameters, result_target);
            } else {
                llvm_return = map_return_type(context, function_entry.return_type);
                if llvm_return.length == 0 {
                    result_diags.push(lowering_warning_diag("E1006", "unsupported return type in call to `"
                        + result_target
                        + "`", null));
                    llvm_return = "i8*";
                }
                expected_params = collect_parameter_types(context, function_entry.parameters, result_target);
            }
            // Signal the caller (lower_call_expression) that the helper
            // descriptor was deferred to the function entry so it can
            // drop its own `helper_descriptor` variable. Clearing
            // `result_helper` locally is insufficient — the outer scope
            // keeps the Phase-1 helper from `resolve_call_method_target`
            // and re-runs `find_runtime_helper(trimmed_target)` whenever
            // it's null, which would otherwise let
            // `coerce_and_emit_call` reapply the helper's
            // `native_signature` / `c_abi_return_type` coercion against
            // the function entry's signature.
            result_helper = null;
            if find_runtime_helper(result_target) != null {
                helper_overridden = true;
            }
        } else if result_helper != null {
            let descriptor = result_helper;
            llvm_return = descriptor.return_type;
            expected_params = descriptor.parameter_types;
        } else {
            // #1780 (SFEP-0035 §3.2): a prelude free function called without
            // importing the prelude (the E0420 implicit-runtime allowance has
            // no emit-layer counterpart, so `function_entry` is null here).
            // Derive its return/parameter shape from the source-typed mirror
            // signature via the same `map_return_type`/`collect_parameter_types`
            // an imported call would use — replacing the hand-typed
            // `runtime_helpers.sfn` mirror rows (removed with this change).
            let mirror_sig = find_prelude_mirror_signature(result_target);
            if mirror_sig != null {
                llvm_return = map_return_type(context, mirror_sig.return_type);
                expected_params = collect_parameter_types(context, mirror_sig.parameters, result_target);
            } else {
                result_diags.push(lowering_warning_diag("E1006", "call to unknown function `"
                    + result_target
                    + "`", null));
            }
        }
    }

    // Concat fixup
    if result_target == "concat" {
        if method_operand != null {
            let receiver = method_operand;
            let receiver_type = trim_text(receiver.llvm_type);
            let element_type = array_pointer_element_type(receiver_type);
            if element_type.length > 0 {
                if !ends_with_pointer_suffix(element_type) {
                    llvm_return = receiver_type;
                    expected_params = [receiver_type, receiver_type];
                    function_entry = null;
                }
            }
        }
    }

    return CallSignatureResolution {
        trimmed_target: result_target,
        function_entry: function_entry,
        llvm_return: llvm_return,
        expected_params: expected_params,
        is_trait_dispatch: is_trait_dispatch,
        helper_overridden: helper_overridden,
        is_closure_dispatch: false,
        diags: result_diags
    };
}

export { resolve_call_signature };
