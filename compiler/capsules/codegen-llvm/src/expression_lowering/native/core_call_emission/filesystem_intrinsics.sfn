// compiler/capsules/codegen-llvm/src/expression_lowering/native/core_call_emission/filesystem_intrinsics.sfn
//
// Simple cross-platform filesystem intrinsic emission.
import { LoweringDiagnostic } from "sfn/ir";

import { format_temp_name } from "../../../expressions_helpers";
import { fs_platform_leg, stat_buf_size_value, stat_st_mode_offset_value } from "../../../lowering_debug_state";
import {
    ExpressionResult,
    LLVMOperand,
    RuntimeHelperDescriptor,
    StringConstant
} from "../../../types";
import { lowering_warning_diag, number_to_string } from "../../../utils";

fn emit_filesystem_intrinsic(helper_descriptor: RuntimeHelperDescriptor, final_operands: LLVMOperand[], current_temp: int, current_lines: string[], diagnostics: string[], diags: LoweringDiagnostic[], collected_string_constants: StringConstant[]) -> ExpressionResult {
    let mut result_lines = current_lines;
    let mut result_temp: int = current_temp;
    let mut result_diagnostics = diagnostics;
    let mut result_diags = diags;
    // Filesystem sentinels (#1308): retire the last platform-divergent C fs
    // symbols by lowering each to a per-target sequence (modeled on
    // `exe_path` above), choosing the host leg via `fs_platform_leg`. Only
    // the host leg's symbol enters the IR, so the Windows cross-build never
    // references a POSIX-only symbol it has no definition for. `mkdtemp` is
    // no longer among these (SFN-993) — it is an ordinary `extern fn` call
    // satisfied at link time on both legs.
    if helper_descriptor != null {
        if helper_descriptor.symbol == "sailfin_intrinsic_fs_symlink" {
            if final_operands.length < 2 {
                let message = "sailfin_intrinsic_fs_symlink requires (target: i8*, link: i8*) operands";
                result_diags.push(lowering_warning_diag("E1006", message, null));
                result_diagnostics.push("llvm lowering: " + message);
            } else {
                let _fs_leg = fs_platform_leg();
                if _fs_leg == "mingw" {
                    // Windows stub: no `symlink` symbol in the IR; always fail.
                    let _fs_stub = LLVMOperand {
                        llvm_type: "i1",
                        value: "false"
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_stub,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                } else {
                    // POSIX (linux/darwin): symlink(target, link) == 0 => true.
                    let _fs_target = final_operands[0].value;
                    let _fs_link = final_operands[1].value;
                    let _fs_rc = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_ok = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    result_lines.push("  " + _fs_rc
                        + " = call i32 @symlink(i8* "
                        + _fs_target
                        + ", i8* "
                        + _fs_link
                        + ")");
                    result_lines.push("  " + _fs_ok + " = icmp eq i32 " + _fs_rc
                        + ", 0");
                    let _fs_operand = LLVMOperand {
                        llvm_type: "i1",
                        value: _fs_ok
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_operand,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                }
            }
        }
    }

    // `read_link(path, buf, size) -> i64` sentinel (SFN-46): the single-hop
    // `readlink(2)` byte count. POSIX legs emit `call i64 @readlink(...)`;
    // the Windows leg is a bare `i64 -1` stub so the MinGW-absent `readlink`
    // symbol never enters the IR. The caller (`sfn_fs_read_link`) owns the
    // buffer and turns a `<= 0` return into `""`.
    if helper_descriptor != null {
        if helper_descriptor.symbol == "sailfin_intrinsic_fs_read_link" {
            if final_operands.length < 3 {
                let message = "sailfin_intrinsic_fs_read_link requires (path: i8*, buf: i8*, size: i64) operands";
                result_diags.push(lowering_warning_diag("E1006", message, null));
                result_diagnostics.push("llvm lowering: " + message);
            } else {
                let _fs_leg = fs_platform_leg();
                if _fs_leg == "mingw" {
                    // Windows stub: no `readlink` symbol in the IR; always fail.
                    let _fs_stub = LLVMOperand {
                        llvm_type: "i64",
                        value: "-1"
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_stub,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                } else {
                    // POSIX (linux/darwin): readlink(path, buf, size).
                    let _fs_path = final_operands[0].value;
                    let _fs_buf = final_operands[1].value;
                    let _fs_size = final_operands[2].value;
                    let _fs_n = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    result_lines.push("  " + _fs_n
                        + " = call i64 @readlink(i8* "
                        + _fs_path
                        + ", i8* "
                        + _fs_buf
                        + ", i64 "
                        + _fs_size
                        + ")");
                    let _fs_operand = LLVMOperand {
                        llvm_type: "i64",
                        value: _fs_n
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_operand,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                }
            }
        }
    }

    // `fs_exists(path) -> bool` sentinel (#1308): POSIX legs `stat(path,
    // &buf) == 0` over a stack `struct stat` buffer (over-allocated via
    // `stat_buf_size_value`); the Windows leg `GetFileAttributesA(path) !=
    // -1` (INVALID_FILE_ATTRIBUTES). Only the host leg's symbol enters the IR.
    if helper_descriptor != null {
        if helper_descriptor.symbol == "sailfin_intrinsic_fs_exists" {
            if final_operands.length < 1 {
                let message = "sailfin_intrinsic_fs_exists requires (path: i8*) operand";
                result_diags.push(lowering_warning_diag("E1006", message, null));
                result_diagnostics.push("llvm lowering: " + message);
            } else {
                let _fs_leg = fs_platform_leg();
                let _fs_path = final_operands[0].value;
                if _fs_leg == "mingw" {
                    let _fs_attr = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_ok = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    result_lines.push("  " + _fs_attr
                        + " = call i32 @GetFileAttributesA(i8* "
                        + _fs_path
                        + ")");
                    result_lines.push("  " + _fs_ok + " = icmp ne i32 "
                        + _fs_attr
                        + ", -1");
                    let _fs_operand = LLVMOperand {
                        llvm_type: "i1",
                        value: _fs_ok
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_operand,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                } else {
                    let _fs_bufsz = number_to_string(stat_buf_size_value());
                    let _fs_buf = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_bufp = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_rc = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_ok = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    result_lines.push("  " + _fs_buf + " = alloca [" + _fs_bufsz
                        + " x i8]");
                    result_lines.push("  " + _fs_bufp + " = getelementptr ["
                        + _fs_bufsz
                        + " x i8], ["
                        + _fs_bufsz
                        + " x i8]* "
                        + _fs_buf
                        + ", i32 0, i32 0");
                    result_lines.push("  " + _fs_rc + " = call i32 @stat(i8* "
                        + _fs_path
                        + ", i8* "
                        + _fs_bufp
                        + ")");
                    result_lines.push("  " + _fs_ok + " = icmp eq i32 " + _fs_rc
                        + ", 0");
                    let _fs_operand = LLVMOperand {
                        llvm_type: "i1",
                        value: _fs_ok
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_operand,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                }
            }
        }
    }

    // `get_perms(path) -> i64` sentinel (#1308): POSIX legs `stat` the path,
    // and on success load `st_mode` at the per-target byte offset
    // (`stat_st_mode_offset_value`), mask the low 12 bits (`& 0o7777`), and
    // zext to i64; a `stat` failure yields -1 via a phi. The Windows leg is
    // a bare `i64 -1` stub. The stat buffer is `align 8` (struct stat's
    // alignment) so the `st_mode` load is naturally aligned.
    if helper_descriptor != null {
        if helper_descriptor.symbol == "sailfin_intrinsic_fs_get_perms" {
            if final_operands.length < 1 {
                let message = "sailfin_intrinsic_fs_get_perms requires (path: i8*) operand";
                result_diags.push(lowering_warning_diag("E1006", message, null));
                result_diagnostics.push("llvm lowering: " + message);
            } else {
                let _fs_leg = fs_platform_leg();
                if _fs_leg == "mingw" {
                    let _fs_stub = LLVMOperand {
                        llvm_type: "i64",
                        value: "-1"
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_stub,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                } else {
                    let _fs_path = final_operands[0].value;
                    let _fs_id = number_to_string(result_temp);
                    let _fs_bufsz = number_to_string(stat_buf_size_value());
                    let _fs_off = number_to_string(stat_st_mode_offset_value());
                    let _fs_buf = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_bufp = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_rc = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_okc = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_modep = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_modepi = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_mode = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_masked = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_mode64 = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_out = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_ok_lbl = "get_perms_ok_" + _fs_id;
                    let _fs_fail_lbl = "get_perms_fail_" + _fs_id;
                    let _fs_done_lbl = "get_perms_done_" + _fs_id;
                    result_lines.push("  " + _fs_buf + " = alloca [" + _fs_bufsz
                        + " x i8], align 8");
                    result_lines.push("  " + _fs_bufp + " = getelementptr ["
                        + _fs_bufsz
                        + " x i8], ["
                        + _fs_bufsz
                        + " x i8]* "
                        + _fs_buf
                        + ", i32 0, i32 0");
                    result_lines.push("  " + _fs_rc + " = call i32 @stat(i8* "
                        + _fs_path
                        + ", i8* "
                        + _fs_bufp
                        + ")");
                    result_lines.push("  " + _fs_okc + " = icmp eq i32 "
                        + _fs_rc
                        + ", 0");
                    result_lines.push("  br i1 " + _fs_okc + ", label %"
                        + _fs_ok_lbl
                        + ", label %"
                        + _fs_fail_lbl);
                    result_lines.push("");
                    result_lines.push(_fs_ok_lbl + ":");
                    result_lines.push("  " + _fs_modep
                        + " = getelementptr i8, i8* "
                        + _fs_bufp
                        + ", i64 "
                        + _fs_off);
                    result_lines.push("  " + _fs_modepi + " = bitcast i8* "
                        + _fs_modep
                        + " to i32*");
                    result_lines.push("  " + _fs_mode + " = load i32, i32* "
                        + _fs_modepi);
                    result_lines.push("  " + _fs_masked + " = and i32 "
                        + _fs_mode
                        + ", 4095");
                    result_lines.push("  " + _fs_mode64 + " = zext i32 "
                        + _fs_masked
                        + " to i64");
                    result_lines.push("  br label %" + _fs_done_lbl);
                    result_lines.push("");
                    result_lines.push(_fs_fail_lbl + ":");
                    result_lines.push("  br label %" + _fs_done_lbl);
                    result_lines.push("");
                    result_lines.push(_fs_done_lbl + ":");
                    result_lines.push("  " + _fs_out + " = phi i64 [ "
                        + _fs_mode64
                        + ", %"
                        + _fs_ok_lbl
                        + " ], [ -1, %"
                        + _fs_fail_lbl
                        + " ]");
                    let _fs_operand = LLVMOperand {
                        llvm_type: "i64",
                        value: _fs_out
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_operand,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                }
            }
        }
    }

    // `is_directory(path) -> bool` sentinel (SFN-755): the non-destructive
    // directory predicate. Both legs answer from a single syscall and
    // never mutate, which is what separates this from the destructive
    // probes (`fs.deleteFile` succeeds only on a file, `fs.removeDirectory`
    // only on an empty directory) that a read-only walk cannot use.
    //
    // POSIX: the same `stat` + `st_mode` load `get_perms` performs, keeping
    // a different field — `st_mode & S_IFMT` (0170000 = 61440) compared
    // against `S_IFDIR` (0040000 = 16384) — where `get_perms` keeps the
    // low 12 permission bits and discards the type. A `stat` failure
    // (missing path, EACCES on a parent) yields `false` via the phi, so a
    // path that cannot be inspected is reported "not a directory" rather
    // than erroring; every consumer treats the predicate as a filter.
    //
    // `stat` FOLLOWS symlinks, so a symlink to a directory answers `true`
    // (`lstat` would answer `false`). That matches `fs.exists`, which is
    // also `stat`-based, and it is the behaviour a tree walker wants:
    // `fs.listDirectory` is `opendir`, which follows too, so the predicate
    // agrees with what the enumeration will actually do.
    //
    // Windows: `GetFileAttributesA` + `FILE_ATTRIBUTE_DIRECTORY` (0x10).
    // The `!= -1` (INVALID_FILE_ATTRIBUTES) guard is load-bearing, not
    // defensive — `-1` is all-bits-set, so the attribute test alone would
    // report a MISSING path as a directory.
    //
    // The `st_mode` load is `i32` on every POSIX target even though Darwin's
    // `mode_t` is 16-bit (`st_dev` i32 at 0, `st_mode` u16 at 4, `st_nlink`
    // u16 at 6), so there the load also pulls `st_nlink` into the high half.
    // That is harmless HERE only because `S_IFMT` (0170000) lives in bits
    // 12-15 — inside the low 16 — exactly as `get_perms`' `& 0o7777` lives
    // in bits 0-11. Both masks are safe by construction, not by accident.
    // Anyone reading a WIDER field out of `st_mode` must narrow the load to
    // `i16` on Darwin first; the read stays in bounds either way
    // (`stat_buf_size_value()` over-allocates at 160 bytes against a 144-byte
    // Darwin `struct stat`).
    if helper_descriptor != null {
        if helper_descriptor.symbol == "sailfin_intrinsic_fs_is_directory" {
            if final_operands.length < 1 {
                let message = "sailfin_intrinsic_fs_is_directory requires (path: i8*) operand";
                result_diags.push(lowering_warning_diag("E1006", message, null));
                result_diagnostics.push("llvm lowering: " + message);
            } else {
                let _fs_leg = fs_platform_leg();
                let _fs_path = final_operands[0].value;
                if _fs_leg == "mingw" {
                    let _fs_attr = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_valid = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_masked = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_isdir = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_out = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    result_lines.push("  " + _fs_attr
                        + " = call i32 @GetFileAttributesA(i8* "
                        + _fs_path
                        + ")");
                    result_lines.push("  " + _fs_valid + " = icmp ne i32 "
                        + _fs_attr
                        + ", -1");
                    result_lines.push("  " + _fs_masked + " = and i32 "
                        + _fs_attr
                        + ", 16");
                    result_lines.push("  " + _fs_isdir + " = icmp ne i32 "
                        + _fs_masked
                        + ", 0");
                    result_lines.push("  " + _fs_out + " = and i1 " + _fs_valid
                        + ", "
                        + _fs_isdir);
                    let _fs_operand = LLVMOperand {
                        llvm_type: "i1",
                        value: _fs_out
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_operand,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                } else {
                    let _fs_id = number_to_string(result_temp);
                    let _fs_bufsz = number_to_string(stat_buf_size_value());
                    let _fs_off = number_to_string(stat_st_mode_offset_value());
                    let _fs_buf = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_bufp = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_rc = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_okc = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_modep = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_modepi = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_mode = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_fmt = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_isdir = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_out = format_temp_name(result_temp);
                    result_temp = result_temp + 1;
                    let _fs_ok_lbl = "is_directory_ok_" + _fs_id;
                    let _fs_fail_lbl = "is_directory_fail_" + _fs_id;
                    let _fs_done_lbl = "is_directory_done_" + _fs_id;
                    result_lines.push("  " + _fs_buf + " = alloca [" + _fs_bufsz
                        + " x i8], align 8");
                    result_lines.push("  " + _fs_bufp + " = getelementptr ["
                        + _fs_bufsz
                        + " x i8], ["
                        + _fs_bufsz
                        + " x i8]* "
                        + _fs_buf
                        + ", i32 0, i32 0");
                    result_lines.push("  " + _fs_rc + " = call i32 @stat(i8* "
                        + _fs_path
                        + ", i8* "
                        + _fs_bufp
                        + ")");
                    result_lines.push("  " + _fs_okc + " = icmp eq i32 "
                        + _fs_rc
                        + ", 0");
                    result_lines.push("  br i1 " + _fs_okc + ", label %"
                        + _fs_ok_lbl
                        + ", label %"
                        + _fs_fail_lbl);
                    result_lines.push("");
                    result_lines.push(_fs_ok_lbl + ":");
                    result_lines.push("  " + _fs_modep
                        + " = getelementptr i8, i8* "
                        + _fs_bufp
                        + ", i64 "
                        + _fs_off);
                    result_lines.push("  " + _fs_modepi + " = bitcast i8* "
                        + _fs_modep
                        + " to i32*");
                    result_lines.push("  " + _fs_mode + " = load i32, i32* "
                        + _fs_modepi);
                    result_lines.push("  " + _fs_fmt + " = and i32 " + _fs_mode
                        + ", 61440");
                    result_lines.push("  " + _fs_isdir + " = icmp eq i32 "
                        + _fs_fmt
                        + ", 16384");
                    result_lines.push("  br label %" + _fs_done_lbl);
                    result_lines.push("");
                    result_lines.push(_fs_fail_lbl + ":");
                    result_lines.push("  br label %" + _fs_done_lbl);
                    result_lines.push("");
                    result_lines.push(_fs_done_lbl + ":");
                    result_lines.push("  " + _fs_out + " = phi i1 [ "
                        + _fs_isdir
                        + ", %"
                        + _fs_ok_lbl
                        + " ], [ false, %"
                        + _fs_fail_lbl
                        + " ]");
                    let _fs_operand = LLVMOperand {
                        llvm_type: "i1",
                        value: _fs_out
                    };
                    return ExpressionResult {
                        lines: result_lines,
                        temp_index: result_temp,
                        operand: _fs_operand,
                        diagnostics: result_diagnostics,
                        string_constants: collected_string_constants,
                        diags: result_diags
                    };
                }
            }
        }
    }

    return ExpressionResult {
        lines: result_lines,
        temp_index: result_temp,
        operand: null,
        diagnostics: result_diagnostics,
        string_constants: collected_string_constants,
        diags: result_diags
    };
}

export { emit_filesystem_intrinsic };
