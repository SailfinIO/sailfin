// compiler/capsules/codegen-llvm/src/expression_lowering/native/core_cast_lowering.sfn
//
// Lowering for `is`/cast expressions and interpolated string literals,
// extracted from core_literals_lowering.sfn to bound per-module emit
// working set. Called by `lower_expression` in ./core.
import { LoweringDiagnostic, NativeFunction } from "sfn/ir";

import { format_temp_name } from "../../expressions_helpers";
import { empty_string_constant_set, merge_string_constants } from "../../strings";
import { find_enum_info_by_llvm_type, resolve_enum_variant_info } from "../../type_context_queries";
import {
    ends_with_pointer_suffix,
    integer_type_is_signed,
    map_type_annotation,
    strip_pointer_suffix
} from "../../type_mapping";
import {
    CastParseResult,
    ExpressionResult,
    LLVMOperand,
    LocalBinding,
    ParameterBinding,
    StringConstant,
    TypeContext
} from "../../types";
import {
    extend_diag_array,
    number_to_string,
    starts_with,
    trim_text
} from "../../utils";
import { lower_expression } from "./core";
import {
    emit_bf16_narrow_from_double,
    emit_bf16_narrow_from_float,
    emit_bf16_widen_to_double,
    emit_bf16_widen_to_float,
    emit_i64_round_to_odd
} from "./core_bf16_lowering";
import { pick_agg_cast_shim_target } from "./core_literals_lowering";
import { emit_comparison_instruction } from "./core_operands/comparisons";
import { coerce_operand_to_type } from "./core_operands/dispatch";
import { integer_llvm_width, is_float_llvm_type, is_integer_llvm_type } from "./core_operands/type_predicates";
import { operand_source_type } from "./core_scopes";
import { coerce_operand_to_string, emit_string_concat, lower_string_literal } from "./core_strings";
import { encode_string_literal_for_sailfin, resolve_interpolation_template } from "./core_text";

// bfloat has no `.bf16` saturating intrinsic on any target — every `bfloat`
// operand is widened to `float` before this is consulted (SFN-609), so a
// `.bf16` name must never be produced here.
fn float_intrinsic_suffix(llvm_type: string) -> string {
    if llvm_type == "half" { return "f16"; }
    if llvm_type == "float" { return "f32"; }
    if llvm_type == "double" { return "f64"; }
    return "";
}

// Lower an `is` type-guard (#1753) to a boolean `i1`. v1 supports a named
// `enum` operand: extract the operand's discriminant tag and `icmp eq` it
// against the target variant's tag — the same discriminant test `match`
// emits (instructions_match_condition.sfn) and that `if <base>.variant ==
// "<V>"` lowers to. The then-branch narrowing of the guarded operand is
// applied separately by `lower_if_instruction` via the `narrowed_variant`
// machinery. A non-enum operand (inline union, primitive, struct) gets a
// clear v1 diagnostic: in-branch narrowing of those surfaces is not yet
// wired (the `narrowed_variant` flow is enum-only), so shipping a boolean
// without the narrowed use would be a half-feature. They are documented
// fast-follows (SFEP-0034 §3.6).
fn lower_is_expression(parse: CastParseResult, bindings: ParameterBinding[], locals: LocalBinding[], temp_index: int, lines: string[], functions: NativeFunction[], context: TypeContext) -> ExpressionResult {
    let mut diagnostics = parse.diagnostics;
    let mut diags: LoweringDiagnostic[] = [];
    let empty_constants = empty_string_constant_set();
    if !parse.success {
        return ExpressionResult {
            lines: lines,
            temp_index: temp_index,
            operand: null,
            diagnostics: diagnostics,
            string_constants: empty_constants,
            diags: diags
        };
    }

    let lowered = lower_expression(parse.value, bindings, locals, temp_index, lines, functions, context, "");
    let mut _ci_is: int = 0;
    loop {
        if _ci_is >= lowered.diagnostics.length { break; }
        diagnostics.push(lowered.diagnostics[_ci_is]);
        _ci_is += 1;
    }
    diags = extend_diag_array(diags, lowered.diags);
    if lowered.operand == null {
        return ExpressionResult {
            lines: lowered.lines,
            temp_index: lowered.temp_index,
            operand: null,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }
    let subject = lowered.operand;
    let mut current_lines = lowered.lines;
    let mut current_temp = lowered.temp_index;

    // Resolve the operand's enum type from its LLVM type (strip a pointer
    // suffix for the boxed-struct ABI), mirroring core_member_lowering.
    let mut candidate = subject.llvm_type;
    if ends_with_pointer_suffix(candidate) {
        let stripped = trim_text(strip_pointer_suffix(candidate));
        if stripped.length > 0 { candidate = stripped; }
    }
    let enum_info = find_enum_info_by_llvm_type(context, candidate);
    if enum_info == null {
        diagnostics.push("llvm lowering: `is` on a non-enum value `" + subject.llvm_type
            + "` is not yet supported; the operand must be a named `enum` type");
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: null,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }
    let variant_info = resolve_enum_variant_info(enum_info, parse.type_annotation);
    if variant_info == null {
        diagnostics.push("llvm lowering: enum `" + enum_info.name
            + "` has no variant `"
            + parse.type_annotation
            + "` for `is`");
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: null,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }

    // Map the tag type and extract/load the discriminant tag (field 0).
    let mut tag_llvm_type: string = "i32";
    if enum_info.tag_type == "i8" { tag_llvm_type = "i8"; }
    if enum_info.tag_type == "i16" { tag_llvm_type = "i16"; }
    if enum_info.tag_type == "i32" { tag_llvm_type = "i32"; }
    if enum_info.tag_type == "i64" { tag_llvm_type = "i64"; }

    let mut tag_temp: string = "";
    if ends_with_pointer_suffix(subject.llvm_type) {
        let tag_ptr_temp = format_temp_name(current_temp);
        current_temp += 1;
        current_lines.push("  " + tag_ptr_temp + " = getelementptr inbounds "
            + enum_info.llvm_name
            + ", "
            + subject.llvm_type
            + " "
            + subject.value
            + ", i32 0, i32 0");
        let load_temp = format_temp_name(current_temp);
        current_temp += 1;
        current_lines.push("  " + load_temp + " = load " + tag_llvm_type + ", "
            + tag_llvm_type
            + "* "
            + tag_ptr_temp);
        tag_temp = load_temp;
    } else {
        let extract_temp = format_temp_name(current_temp);
        current_temp += 1;
        current_lines.push("  " + extract_temp + " = extractvalue " + subject.llvm_type
            + " "
            + subject.value
            + ", 0");
        tag_temp = extract_temp;
    }

    let tag_operand = LLVMOperand {
        llvm_type: tag_llvm_type,
        value: tag_temp
    };
    let variant_tag_operand = LLVMOperand {
        llvm_type: tag_llvm_type,
        value: number_to_string(variant_info.tag)
    };
    let comparison = emit_comparison_instruction("==", tag_operand, variant_tag_operand, current_temp, current_lines, false);
    let mut _cc_is: int = 0;
    loop {
        if _cc_is >= comparison.diagnostics.length { break; }
        diagnostics.push(comparison.diagnostics[_cc_is]);
        _cc_is += 1;
    }
    return ExpressionResult {
        lines: comparison.lines,
        temp_index: comparison.temp_index,
        operand: comparison.operand,
        diagnostics: diagnostics,
        string_constants: lowered.string_constants,
        diags: diags
    };
}

fn lower_cast_expression(parse: CastParseResult, bindings: ParameterBinding[], locals: LocalBinding[], temp_index: int, lines: string[], functions: NativeFunction[], context: TypeContext) -> ExpressionResult {
    let mut diagnostics = parse.diagnostics;
    let mut diags: LoweringDiagnostic[] = [];
    let empty_constants = empty_string_constant_set();
    if !parse.success {
        return ExpressionResult {
            lines: lines,
            temp_index: temp_index,
            operand: null,
            diagnostics: diagnostics,
            string_constants: empty_constants,
            diags: diags
        };
    }
    let target_type = map_type_annotation(parse.type_annotation);
    if target_type.length == 0 {
        diagnostics.push("llvm lowering: unsupported cast target type `" + parse.type_annotation
            + "`");
        return ExpressionResult {
            lines: lines,
            temp_index: temp_index,
            operand: null,
            diagnostics: diagnostics,
            string_constants: empty_constants,
            diags: diags
        };
    }

    let lowered = lower_expression(parse.value, bindings, locals, temp_index, lines, functions, context, "");
    let mut _ci10: int = 0;
    loop {
        if _ci10 >= lowered.diagnostics.length { break; }
        diagnostics.push(lowered.diagnostics[_ci10]);
        _ci10 += 1;
    }
    diags = extend_diag_array(diags, lowered.diags);
    if lowered.operand == null {
        return ExpressionResult {
            lines: lowered.lines,
            temp_index: lowered.temp_index,
            operand: null,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }
    let operand = lowered.operand;
    if operand.llvm_type == target_type {
        return ExpressionResult {
            lines: lowered.lines,
            temp_index: lowered.temp_index,
            operand: operand,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }

    let mut current_lines = lowered.lines;
    let mut current_temp = lowered.temp_index;
    let cast_name = format_temp_name(current_temp);
    current_temp += 1;

    // `as bool` is rejected uniformly — pointer, integer, or float
    // sources should all use a comparison (`x != null`, `x != 0`,
    // `x != 0.0`) rather than a bit-pattern reinterpretation that
    // happens to land in `i1`. Done before the pointer-cast
    // branches so `ptr as bool` doesn't sneak through `ptrtoint`.
    if target_type == "i1" {
        if ends_with_pointer_suffix(operand.llvm_type) {
            diagnostics.push("llvm lowering: cast to `bool` via `as` is rejected;"
                + " use a comparison like `x != null` instead");
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
        if is_integer_llvm_type(operand.llvm_type) {
            diagnostics.push("llvm lowering: cast to `bool` via `as` is rejected;"
                + " use a comparison like `x != 0` instead");
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
        if is_float_llvm_type(operand.llvm_type) {
            diagnostics.push("llvm lowering: cast to `bool` via `as` is rejected;"
                + " use a comparison like `x != 0.0` instead");
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
    }

    // M1.A.2: casts between the `{i8*, i64}` SfnString aggregate and a raw
    // pointer (`string as * u8`, `* u8 as string`). Both directions are
    // handled by the shared coercion shim in core_operands.sfn — the forward
    // direction `extractvalue`s the data pointer, the reverse recovers the
    // length and builds the aggregate. Routed here (before the pointer/int
    // matrix, which cannot model the aggregate) so a single implementation
    // owns the conversion.
    let mut _agg_cast: boolean = false;
    if operand.llvm_type == "{i8*, i64}" {
        if ends_with_pointer_suffix(target_type) { _agg_cast = true; }
    }
    if target_type == "{i8*, i64}" {
        if ends_with_pointer_suffix(operand.llvm_type) { _agg_cast = true; }
    }
    if _agg_cast {
        // Pointer targets narrower than `i8*` need an extra bitcast after the
        // shim hands back the `i8*` data pointer; route via `i8*` first.
        let shim_target = pick_agg_cast_shim_target(operand.llvm_type, target_type);
        let coerced = coerce_operand_to_type(operand, shim_target, current_temp, current_lines, true, null);
        current_lines = coerced.lines;
        current_temp = coerced.temp_index;
        let mut _agg_di: int = 0;
        loop {
            if _agg_di >= coerced.diagnostics.length { break; }
            diagnostics.push(coerced.diagnostics[_agg_di]);
            _agg_di += 1;
        }
        diags = extend_diag_array(diags, coerced.diags);
        if coerced.operand == null {
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
        let mut result_operand: LLVMOperand = coerced.operand;
        if result_operand.llvm_type != target_type {
            let agg_bitcast = format_temp_name(current_temp);
            current_lines.push("  " + agg_bitcast + " = bitcast "
                + result_operand.llvm_type
                + " "
                + result_operand.value
                + " to "
                + target_type);
            current_temp += 1;
            result_operand = LLVMOperand {
                llvm_type: target_type,
                value: agg_bitcast
            };
        }
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: result_operand,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }

    // #1505: an `as string` cast must stringify its operand — the same
    // int/float→string lowering the `${ }` interpolation path uses — rather
    // than fall through to the numeric/pointer matrices below, which have no
    // `i64 → {i8*, i64}` arm and previously emitted a non-fatal
    // "unsupported cast" diagnostic. The null operand that left behind made
    // the binding default to `double 0.0`, so `n as string` silently printed
    // "0". The `{i8*, i64}` identity (operand already a string) returned early
    // above, and pointer→string was consumed by the `_agg_cast` shim, so the
    // operand here is a scalar numeric value. `coerce_operand_to_type` builds
    // the proper `{i8*, i64}` aggregate (number.to_string + length recovery),
    // so the result matches the cast's declared `string` type for both
    // annotated and inferred bindings.
    if target_type == "{i8*, i64}" {
        let str_cast = coerce_operand_to_type(operand, target_type, current_temp, current_lines, true, null);
        let mut _str_di: int = 0;
        loop {
            if _str_di >= str_cast.diagnostics.length { break; }
            diagnostics.push(str_cast.diagnostics[_str_di]);
            _str_di += 1;
        }
        diags = extend_diag_array(diags, str_cast.diags);
        return ExpressionResult {
            lines: str_cast.lines,
            temp_index: str_cast.temp_index,
            operand: str_cast.operand,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }

    if ends_with_pointer_suffix(operand.llvm_type) {
        if ends_with_pointer_suffix(target_type) {
            current_lines.push("  " + cast_name + " = bitcast " + operand.llvm_type
                + " "
                + operand.value
                + " to "
                + target_type);
            let casted = LLVMOperand {
                llvm_type: target_type,
                value: cast_name
            };
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: casted,
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
    }

    if !ends_with_pointer_suffix(operand.llvm_type) {
        if ends_with_pointer_suffix(target_type) {
            if starts_with(operand.llvm_type, "i") {
                current_lines.push("  " + cast_name + " = inttoptr " + operand.llvm_type
                    + " "
                    + operand.value
                    + " to "
                    + target_type);
                let casted = LLVMOperand {
                    llvm_type: target_type,
                    value: cast_name
                };
                return ExpressionResult {
                    lines: current_lines,
                    temp_index: current_temp,
                    operand: casted,
                    diagnostics: diagnostics,
                    string_constants: lowered.string_constants,
                    diags: diags
                };
            }
        }
    }

    if ends_with_pointer_suffix(operand.llvm_type) {
        if !ends_with_pointer_suffix(target_type) {
            if starts_with(target_type, "i") {
                current_lines.push("  " + cast_name + " = ptrtoint " + operand.llvm_type
                    + " "
                    + operand.value
                    + " to "
                    + target_type);
                let casted = LLVMOperand {
                    llvm_type: target_type,
                    value: cast_name
                };
                return ExpressionResult {
                    lines: current_lines,
                    temp_index: current_temp,
                    operand: casted,
                    diagnostics: diagnostics,
                    string_constants: lowered.string_constants,
                    diags: diags
                };
            }
        }
    }

    // Slice D (2026-05-03): numeric `as` cast lowering matrix. See
    // docs/proposals/0025-native-runtime-architecture.md §3.7 (`#396-numeric-types-int--float`). Both sides are non-pointer
    // at this point — pointer cases were handled above and the
    // identity case was filtered earlier.
    //   i1  → int (wider)      → zext      (true → 1, not -1)
    //   i1  → double/float     → uitofp    (true → 1.0, not -1.0)
    //   u*  → int (wider)      → zext
    //   i*  → int (wider)      → sext
    //   i*  → int (narrower)   → trunc     (sign-independent)
    //   u*  → double/float     → uitofp
    //   i*  → double/float     → sitofp
    //   double/float → u*      → llvm.fptoui.sat.*
    //   double/float → i*      → llvm.fptosi.sat.*
    //   float → double         → fpext
    //   double → float         → fptrunc
    //   any  → i1 via `as`     → diagnostic (handled above)
    let operand_is_int = is_integer_llvm_type(operand.llvm_type);
    let operand_is_float = is_float_llvm_type(operand.llvm_type);
    let target_is_int = is_integer_llvm_type(target_type);
    let target_is_float = is_float_llvm_type(target_type);

    // Sign is erased by `map_primitive_type`, so recover the operand's
    // source annotation. The width check below guards against the two
    // mappers disagreeing — `map_type_annotation` here versus whatever
    // computed the binding's `llvm_type` (`map_local_type` for locals,
    // `_binding_llvm_type` for module globals) — and falls back to the
    // signed forms when they do.
    //
    // That reaches an operand spelled as a plain identifier or parameter.
    // A compound operand carries no source annotation on its `LLVMOperand`
    // and still selects the signed forms: aggregates (`s.field as u64`,
    // `xs[i] as u64`, `f() as u64`) and, most commonly, arithmetic
    // (`(a + b) as u64`, `(x << 8) as u32`). Closing that needs the
    // checker's inferred-type tag threaded through expression lowering,
    // which SFEP-0058 §3.3 scopes to the typecheck slice (SFN-501).
    let cast_operand_source_type = operand_source_type(parse.value, bindings, locals);
    let mut operand_is_unsigned: boolean = false;
    if cast_operand_source_type.length > 0 {
        if map_type_annotation(cast_operand_source_type) == operand.llvm_type {
            if !integer_type_is_signed(cast_operand_source_type) {
                operand_is_unsigned = true;
            }
        }
    }
    // `i1` is unsigned for conversion purposes: LLVM reads `true` as -1
    // under the signed forms, so `bool as int` must be 1 and `bool as
    // float` must be 1.0.
    if operand.llvm_type == "i1" { operand_is_unsigned = true; }

    // The cast *target* never loses its sign — `parse.type_annotation` is
    // the source text right of ` as ` — so float→int needs no recovery.
    let mut target_is_unsigned: boolean = false;
    if target_is_int {
        if !integer_type_is_signed(parse.type_annotation) {
            target_is_unsigned = true;
        }
    }

    let mut numeric_op_name: string = "";

    // i64/u64 don't fit f64's 53-bit significand, so a plain `sitofp`/`uitofp`
    // followed by a narrow to bf16 would round twice, which SFEP-0054 §3.4
    // forbids; pre-round the integer to odd on the 2^11 grid so the widen
    // stays a single effective rounding (SFN-609).
    if operand_is_int {
        if target_type == "bfloat" {
            let mut int_source_value: string = operand.value;
            if operand.llvm_type == "i64" {
                let rounded = emit_i64_round_to_odd(operand.value, !operand_is_unsigned, current_temp, current_lines);
                current_lines = rounded.lines;
                current_temp = rounded.temp_index;
                int_source_value = rounded.value;
            }
            let widen_temp = format_temp_name(current_temp);
            current_temp += 1;
            let mut int_widen_op: string = "";
            if operand_is_unsigned { int_widen_op = "uitofp"; }
            if !operand_is_unsigned { int_widen_op = "sitofp"; }
            current_lines.push("  " + widen_temp + " = " + int_widen_op + " "
                + operand.llvm_type
                + " "
                + int_source_value
                + " to double");
            let narrowed = emit_bf16_narrow_from_double(widen_temp, current_temp, current_lines);
            return ExpressionResult {
                lines: narrowed.lines,
                temp_index: narrowed.temp_index,
                operand: LLVMOperand {
                    llvm_type: "bfloat",
                    value: narrowed.value
                },
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
    }

    if operand_is_int {
        if target_is_float {
            if operand_is_unsigned { numeric_op_name = "uitofp"; }
            if !operand_is_unsigned { numeric_op_name = "sitofp"; }
        }
    }
    if operand_is_float {
        if target_is_int {
            // bf16 has no saturating conversion intrinsic on any target;
            // widen losslessly to f32 first and reuse the f32 intrinsic,
            // which preserves the saturating semantics exactly (SFN-609).
            let mut sat_operand_type: string = operand.llvm_type;
            let mut sat_operand_value: string = operand.value;
            if operand.llvm_type == "bfloat" {
                let widened = emit_bf16_widen_to_float(operand.value, current_temp, current_lines);
                current_lines = widened.lines;
                current_temp = widened.temp_index;
                sat_operand_type = "float";
                sat_operand_value = widened.value;
            }
            let mut sat_op = "fptosi";
            if target_is_unsigned { sat_op = "fptoui"; }
            let float_suffix = float_intrinsic_suffix(sat_operand_type);
            if float_suffix.length > 0 {
                let intrinsic = "llvm." + sat_op + ".sat." + target_type + "."
                    + float_suffix;
                current_lines.push("  " + cast_name + " = call " + target_type
                    + " @"
                    + intrinsic
                    + "("
                    + sat_operand_type
                    + " "
                    + sat_operand_value
                    + ")");
                let casted = LLVMOperand {
                    llvm_type: target_type,
                    value: cast_name
                };
                return ExpressionResult {
                    lines: current_lines,
                    temp_index: current_temp,
                    operand: casted,
                    diagnostics: diagnostics,
                    string_constants: lowered.string_constants,
                    diags: diags
                };
            }
        }
    }
    if operand_is_int {
        if target_is_int {
            let src_width = integer_llvm_width(operand.llvm_type);
            let dst_width = integer_llvm_width(target_type);
            if dst_width > src_width {
                if operand_is_unsigned { numeric_op_name = "zext"; }
                if !operand_is_unsigned { numeric_op_name = "sext"; }
            }
            if dst_width < src_width { numeric_op_name = "trunc"; }
        }
    }
    // bfloat has no AArch64 conversion instruction in either direction;
    // substitute the bit-manipulation helpers for every bfloat<->float
    // pairing (SFN-609). half<->bfloat direct casts are deferred SFEP-0054
    // work and fall through to the "unsupported cast" diagnostic below.
    if operand.llvm_type == "bfloat" {
        if target_type == "float" {
            let widened = emit_bf16_widen_to_float(operand.value, current_temp, current_lines);
            return ExpressionResult {
                lines: widened.lines,
                temp_index: widened.temp_index,
                operand: LLVMOperand {
                    llvm_type: "float",
                    value: widened.value
                },
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
        if target_type == "double" {
            let widened = emit_bf16_widen_to_double(operand.value, current_temp, current_lines);
            return ExpressionResult {
                lines: widened.lines,
                temp_index: widened.temp_index,
                operand: LLVMOperand {
                    llvm_type: "double",
                    value: widened.value
                },
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
    }
    if operand.llvm_type == "float" {
        if target_type == "bfloat" {
            let narrowed = emit_bf16_narrow_from_float(operand.value, current_temp, current_lines);
            return ExpressionResult {
                lines: narrowed.lines,
                temp_index: narrowed.temp_index,
                operand: LLVMOperand {
                    llvm_type: "bfloat",
                    value: narrowed.value
                },
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
    }
    if operand.llvm_type == "double" {
        if target_type == "bfloat" {
            let narrowed = emit_bf16_narrow_from_double(operand.value, current_temp, current_lines);
            return ExpressionResult {
                lines: narrowed.lines,
                temp_index: narrowed.temp_index,
                operand: LLVMOperand {
                    llvm_type: "bfloat",
                    value: narrowed.value
                },
                diagnostics: diagnostics,
                string_constants: lowered.string_constants,
                diags: diags
            };
        }
    }

    if operand_is_float {
        if target_is_float {
            if operand.llvm_type == "float" {
                if target_type == "double" { numeric_op_name = "fpext"; }
                if target_type == "half" { numeric_op_name = "fptrunc"; }
            }
            if operand.llvm_type == "double" {
                if target_type == "float" { numeric_op_name = "fptrunc"; }
                if target_type == "half" { numeric_op_name = "fptrunc"; }
            }
            if operand.llvm_type == "half" {
                if target_type == "float" { numeric_op_name = "fpext"; }
                if target_type == "double" { numeric_op_name = "fpext"; }
            }
        }
    }

    if numeric_op_name.length > 0 {
        current_lines.push("  " + cast_name + " = " + numeric_op_name + " "
            + operand.llvm_type
            + " "
            + operand.value
            + " to "
            + target_type);
        let casted = LLVMOperand { llvm_type: target_type, value: cast_name };
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: casted,
            diagnostics: diagnostics,
            string_constants: lowered.string_constants,
            diags: diags
        };
    }

    diagnostics.push("llvm lowering: unsupported cast from `" + operand.llvm_type
        + "` to `"
        + target_type
        + "`");
    return ExpressionResult {
        lines: current_lines,
        temp_index: current_temp,
        operand: null,
        diagnostics: diagnostics,
        string_constants: lowered.string_constants,
        diags: diags
    };
}

fn try_lower_interpolated_string_literal(literal: string, bindings: ParameterBinding[], locals: LocalBinding[], temp_index: int, lines: string[], functions: NativeFunction[], context: TypeContext) -> ExpressionResult? {
    // SFEP-0057: `${ }` is the sole interpolation form. The dispatch (opener
    // detection, raw-inner scan) lives in core_text.
    let parsed = resolve_interpolation_template(literal);
    if !parsed.success { return null; }
    if parsed.expressions.length == 0 { return null; }
    if parsed.parts.length != parsed.expressions.length + 1 { return null; }

    let mut current_lines: string[] = lines;
    let mut current_temp: int = temp_index;
    let mut diagnostics: string[] = [];
    let mut diags: LoweringDiagnostic[] = [];
    let mut collected_string_constants: StringConstant[] = empty_string_constant_set();

    let first_literal = encode_string_literal_for_sailfin(parsed.parts[0]);
    let first = lower_string_literal(first_literal, current_temp, current_lines);
    current_lines = first.lines;
    current_temp = first.temp_index;

    if first.operand == null {
        return ExpressionResult {
            lines: current_lines,
            temp_index: current_temp,
            operand: null,
            diagnostics: diagnostics,
            string_constants: collected_string_constants,
            diags: diags
        };
    }
    let mut current_operand: LLVMOperand = first.operand;

    let mut index: int = 0;
    loop {
        if index >= parsed.expressions.length { break; }

        let expr_text = parsed.expressions[index];
        let lowered_expr = lower_expression(expr_text, bindings, locals, current_temp, current_lines, functions, context, "i8*");
        let mut _ci11: int = 0;
        loop {
            if _ci11 >= lowered_expr.diagnostics.length { break; }
            diagnostics.push(lowered_expr.diagnostics[_ci11]);
            _ci11 += 1;
        }
        diags = extend_diag_array(diags, lowered_expr.diags);
        current_lines = lowered_expr.lines;
        current_temp = lowered_expr.temp_index;
        collected_string_constants = merge_string_constants(collected_string_constants, lowered_expr.string_constants);

        if lowered_expr.operand == null {
            diagnostics.push("llvm lowering: unable to lower interpolated expression `"
                + expr_text
                + "`");
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: collected_string_constants,
                diags: diags
            };
        }

        let coerced = coerce_operand_to_string(lowered_expr.operand, current_temp, current_lines);
        let mut _ci12: int = 0;
        loop {
            if _ci12 >= coerced.diagnostics.length { break; }
            diagnostics.push(coerced.diagnostics[_ci12]);
            _ci12 += 1;
        }
        diags = extend_diag_array(diags, coerced.diags);
        current_lines = coerced.lines;
        current_temp = coerced.temp_index;
        collected_string_constants = merge_string_constants(collected_string_constants, coerced.string_constants);
        if coerced.operand == null {
            // SFN-408: mark fatal so the build aborts loudly with the source
            // expression text as the span surrogate, instead of silently
            // dropping the enclosing `print`/`call` at exit 0.
            diagnostics.push("llvm lowering [fatal]: unable to stringify interpolated expression `"
                + expr_text
                + "`");
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: collected_string_constants,
                diags: diags
            };
        }

        let concat1 = emit_string_concat(current_operand, coerced.operand, current_temp, current_lines);
        let mut _ci13: int = 0;
        loop {
            if _ci13 >= concat1.diagnostics.length { break; }
            diagnostics.push(concat1.diagnostics[_ci13]);
            _ci13 += 1;
        }
        diags = extend_diag_array(diags, concat1.diags);
        current_lines = concat1.lines;
        current_temp = concat1.temp_index;
        if concat1.operand == null {
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: collected_string_constants,
                diags: diags
            };
        }
        current_operand = concat1.operand;

        let part_literal = encode_string_literal_for_sailfin(parsed.parts[index
            + 1]);
        let part_value = lower_string_literal(part_literal, current_temp, current_lines);
        current_lines = part_value.lines;
        current_temp = part_value.temp_index;
        if part_value.operand == null {
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: collected_string_constants,
                diags: diags
            };
        }

        let concat2 = emit_string_concat(current_operand, part_value.operand, current_temp, current_lines);
        let mut _ci14: int = 0;
        loop {
            if _ci14 >= concat2.diagnostics.length { break; }
            diagnostics.push(concat2.diagnostics[_ci14]);
            _ci14 += 1;
        }
        diags = extend_diag_array(diags, concat2.diags);
        current_lines = concat2.lines;
        current_temp = concat2.temp_index;
        if concat2.operand == null {
            return ExpressionResult {
                lines: current_lines,
                temp_index: current_temp,
                operand: null,
                diagnostics: diagnostics,
                string_constants: collected_string_constants,
                diags: diags
            };
        }
        current_operand = concat2.operand;

        index += 1;
    }

    return ExpressionResult {
        lines: current_lines,
        temp_index: current_temp,
        operand: current_operand,
        diagnostics: diagnostics,
        string_constants: collected_string_constants,
        diags: diags
    };
}
