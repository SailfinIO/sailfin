// compiler/capsules/codegen-llvm/src/expression_lowering/native/core_member_helpers.sfn
//
// Inline GEP field access helper extracted from core_member_lowering.sfn
// to keep each function under ~500 .sfn-asm instructions (avoids seed OOM).
import { LoweringDiagnostic } from "sfn/ir";
import { find, substring } from "sfn/strings";

import { find_local_binding } from "../../expressions_bindings";
import { format_temp_name } from "../../expressions_helpers";
import {
    find_struct_field_info,
    find_struct_info_by_name,
    resolve_enum_info_for_literal
} from "../../type_context_queries";
import {
    enum_inst_parse_args,
    enum_inst_substitute_annotation,
    generic_payload_slot_type,
    map_struct_field_annotation
} from "../../type_mapping";
import {
    EnumTypeInfo,
    ExpressionResult,
    LLVMOperand,
    LocalBinding,
    ParameterBinding,
    StringConstant,
    StructFieldInfo,
    TypeContext
} from "../../types";
import { number_to_string, trim_text } from "../../utils";

// Try to resolve a struct field access via in-memory TypeContext when the
// base type is i8* (opaque pointer). Returns an ExpressionResult with the
// loaded field value, or null if resolution fails.
fn lower_inline_gep_field_access(base_name: string, field_name: string, base_operand: LLVMOperand, bindings: ParameterBinding[], locals: LocalBinding[], temp_index: int, lines: string[], diags: LoweringDiagnostic[], string_constants: StringConstant[], context: TypeContext) -> ExpressionResult? {
    let _igep_base = trim_text(base_name);
    let mut _igep_struct: string = "";

    // Check bindings for type annotation
    let mut _igep_bi: int = 0;
    loop {
        if _igep_bi >= bindings.length { break; }
        if bindings[_igep_bi].name == _igep_base {
            _igep_struct = bindings[_igep_bi].type_annotation;
            break;
        }
        _igep_bi += 1;
    }

    // Check locals for type annotation on the base.
    if _igep_struct.length == 0 {
        let _igep_local = find_local_binding(locals, _igep_base);
        if _igep_local != null {
            if _igep_local.type_annotation != null {
                _igep_struct = _igep_local.type_annotation;
            }
        }
    }

    if _igep_struct.length == 0 { return null; }

    // Look up struct in TypeContext
    let info = find_struct_info_by_name(context, _igep_struct);
    if info == null { return null; }
    let field_info = find_struct_field_info(info, field_name);
    if field_info == null { return null; }
    let _igep_llvm = info.llvm_name;
    let _igep_fidx = field_info.index;
    let _igep_ftype = field_info.llvm_type;

    if _igep_llvm.length == 0 { return null; }
    if _igep_ftype.length == 0 { return null; }

    // Emit bitcast + GEP + load
    let mut current_lines = lines;
    let mut current_temp: int = temp_index;
    let _igep_ct1 = format_temp_name(current_temp);
    current_lines.push("  " + _igep_ct1 + " = bitcast i8* " + base_operand.value
        + " to "
        + _igep_llvm
        + "*");
    current_temp += 1;
    let _igep_ct2_name = format_temp_name(current_temp);
    current_lines.push("  " + _igep_ct2_name + " = getelementptr inbounds "
        + _igep_llvm
        + ", "
        + _igep_llvm
        + "* "
        + _igep_ct1
        + ", i32 0, i32 "
        + number_to_string(_igep_fidx));
    current_temp += 1;
    let _igep_ct3 = format_temp_name(current_temp);
    current_lines.push("  " + _igep_ct3 + " = load " + _igep_ftype + ", "
        + _igep_ftype
        + "* "
        + _igep_ct2_name);
    current_temp += 1;
    let _igep_op = LLVMOperand { llvm_type: _igep_ftype, value: _igep_ct3 };
    return ExpressionResult {
        lines: current_lines,
        temp_index: current_temp,
        operand: _igep_op,
        string_constants: string_constants,
        diags: diags
    };
}

// =============================================================================
// Generic enum payload substitution (SFN-772)
// =============================================================================
// The type context maps a `value: T` variant field to the type-erased `%T`,
// which no constructor ever stores: a generic struct payload is heap-boxed and
// the slot holds `%P*`, a scalar is stored inline as its own type. The match
// reader (`lowering/instructions_match_condition.sfn`, #830) substitutes the
// enum's type parameters against the subject's instantiation before mapping;
// direct member access must resolve the same concrete type, or `r.value`
// reads the slot as `%T` while `match r { Ok { value } }` reads it as `%P*`.
// The instantiation arguments of `subject_type_annotation` (`Result<P, string>`
// -> ["P", "string"]) when it names `enum_info`; [] for a monomorphic enum, an
// unrecoverable annotation, or one naming a different enum. The last case
// matters because `enum_info` is looked up from the base operand's LLVM type
// while the annotation comes from the tracked binding — two independent
// recoveries that must agree before positional substitution means anything.
fn enum_payload_inst_args(enum_info: EnumTypeInfo, subject_type_annotation: string) -> string[] {
    if enum_info.type_parameters.length == 0 { return []; }
    let mut subject_name = trim_text(subject_type_annotation);
    let generic_start = find(subject_name, "<", 0);
    if generic_start > 0 {
        subject_name = trim_text(substring(subject_name, 0, generic_start));
    }
    if subject_name != enum_info.name { return []; }
    return enum_inst_parse_args(subject_type_annotation);
}

// `declared` with its type parameters substituted, mapped WITHOUT the
// user-value pointer strip so a boxed struct payload resolves to `%P*` (the
// form the writer stores). Returned unchanged when substitution is a no-op,
// so a substituted field is recognisable by `type_annotation` alone.
fn resolve_generic_payload_field(declared: StructFieldInfo, enum_info: EnumTypeInfo, inst_args: string[]) -> StructFieldInfo {
    if inst_args.length == 0 { return declared; }
    let substituted = enum_inst_substitute_annotation(declared.type_annotation, enum_info.type_parameters, inst_args);
    if substituted == declared.type_annotation { return declared; }
    let mut llvm_type = map_struct_field_annotation(substituted);
    if llvm_type.length == 0 { llvm_type = "i8*"; }
    return StructFieldInfo {
        name: declared.name,
        llvm_type: llvm_type,
        type_annotation: substituted,
        index: declared.index,
        offset: declared.offset
    };
}

// The LLVM type the payload slot holds for a field whose consumer-facing
// (`storage`) type is `storage_type`. They coincide for a substituted struct
// payload (`%P*` IS the boxed pointer) and for a scalar, and diverge only for
// a value aggregate such as the `{i8*, i8*}` closure pair, whose slot holds a
// heap pointer a second load unboxes (SFN-771). The gate is "substitution
// changed the annotation", the same predicate the match reader uses.
fn generic_payload_load_slot_type(storage_type: string, resolved_annotation: string, declared: StructFieldInfo?) -> string {
    if declared == null { return storage_type; }
    if resolved_annotation == declared.type_annotation { return storage_type; }
    return generic_payload_slot_type(storage_type);
}

// SFN-565/SFN-772: a boxed generic enum instantiation (`Result<P, string>`)
// lowers as a type-erased `i8*`, so an `i8*` member-access base whose declared
// annotation names a generic enum is that enum behind the erased pointer, not
// an opaque struct for the dynamic field lookup. Mirrors the match reader's
// recovery of an `i8*` scrutinee (`lowering/instructions_match.sfn`).
fn boxed_generic_enum_info(context: TypeContext, base_type_annotation: string) -> EnumTypeInfo? {
    let trimmed = trim_text(base_type_annotation);
    let generic_start = find(trimmed, "<", 0);
    if generic_start <= 0 { return null; }
    let enum_info = resolve_enum_info_for_literal(context, trim_text(substring(trimmed, 0, generic_start)));
    if enum_info == null { return null; }
    if enum_info.type_parameters.length == 0 { return null; }
    return enum_info;
}

export {
    boxed_generic_enum_info,
    enum_payload_inst_args,
    generic_payload_load_slot_type,
    lower_inline_gep_field_access,
    resolve_generic_payload_field
};
