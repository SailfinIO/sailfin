// compiler/capsules/codegen-llvm/src/expression_lowering/native/core_operands/union_fallback.sfn
//
// Union-target arm of `coerce_general_fallback`: constructs a union value
// by matching the operand against each payload variant. Split out to bound
// per-module emit working set. Returns null if the target is not a union
// or no variant matches — caller falls through to its own tail.
import { LoweringDiagnostic } from "sfn/ir";

import { format_temp_name } from "../../../expressions_helpers";
import { ends_with_pointer_suffix, strip_pointer_suffix } from "../../../type_mapping";
import { CoercionResult, LLVMOperand } from "../../../types";
import { extend_diag_array, starts_with } from "../../../utils";
import { is_union_llvm_type, number_to_string, parse_union_payload_types } from "../core_text";
import {
    RuntimeCallOverrides,
    emit_runtime_call,
    empty_runtime_call_overrides
} from "../runtime_call";
import { coerce_numeric_primitive } from "./numeric_coercion";

fn _coerce_union_target_fallback(operand: LLVMOperand, operand_type: string, target: string, temp_index: int, lines: string[]) -> CoercionResult? {
    let mut current_lines: string[] = lines;
    let mut diagnostics: string[] = [];
    let mut diags: LoweringDiagnostic[] = [];

    if is_union_llvm_type(target) {
        let variants = parse_union_payload_types(target);
        let mut variant_index: int = 0;
        loop {
            if variant_index >= variants.length { break; }
            let variant_type = variants[variant_index];
            let mut has_value: boolean = false;
            let mut value_text: string = "";
            let mut local_lines: string[] = current_lines;
            let mut local_temp: int = temp_index;
            if operand_type == variant_type {
                has_value = true;
                value_text = operand.value;
            } else {
                let variant_numeric = coerce_numeric_primitive(operand, operand_type, variant_type, local_temp, local_lines);
                if variant_numeric != null {
                    let mut _vndi: int = 0;
                    loop {
                        if _vndi >= variant_numeric.diagnostics.length { break; }
                        diagnostics.push(variant_numeric.diagnostics[_vndi]);
                        _vndi += 1;
                    }
                    diags = extend_diag_array(diags, variant_numeric.diags);
                    if variant_numeric.operand != null {
                        local_lines = variant_numeric.lines;
                        local_temp = variant_numeric.temp_index;
                        has_value = true;
                        value_text = variant_numeric.operand.value;
                    }
                }
            }
            if !has_value {
                let mut _elif78: boolean = false;
                if !ends_with_pointer_suffix(operand_type) {
                    if ends_with_pointer_suffix(variant_type) { _elif78 = true; }
                }
                if _elif78 {
                    let expected_value_type = strip_pointer_suffix(variant_type);
                    if expected_value_type == operand_type {
                        // M1.7.2a (#496): union-variant boxing routes
                        // alloc_struct and mark_persistent through `emit_runtime_call`.
                        let size_ptr_temp = format_temp_name(local_temp);
                        let size_temp = format_temp_name(local_temp + 1);
                        let malloc_temp = format_temp_name(local_temp + 2);
                        let typed_ptr_temp = format_temp_name(local_temp + 3);
                        local_lines.push("  " + size_ptr_temp
                            + " = getelementptr "
                            + operand_type
                            + ", "
                            + operand_type
                            + "* null, i32 1");
                        local_lines.push("  " + size_temp + " = ptrtoint "
                            + operand_type
                            + "* "
                            + size_ptr_temp
                            + " to i64");
                        let alloc_size_op_d = LLVMOperand {
                            llvm_type: "i64",
                            value: size_temp
                        };
                        let alloc_overrides_d = RuntimeCallOverrides {
                            parameter_types: [],
                            return_type: "",
                            symbol: "",
                            return_attributes: "noalias",
                            c_abi_return_type: ""
                        };
                        let alloc_operands_d: LLVMOperand[] = [alloc_size_op_d];
                        let alloc_result_d = emit_runtime_call("alloc_struct", alloc_operands_d, alloc_overrides_d, local_temp
                            + 2, local_lines);
                        let mut _alloc_di_d: int = 0;
                        loop {
                            if _alloc_di_d >= alloc_result_d.diagnostics.length {
                                break;
                            }
                            diagnostics.push(alloc_result_d.diagnostics[_alloc_di_d]);
                            _alloc_di_d += 1;
                        }
                        diags = extend_diag_array(diags, alloc_result_d.diags);
                        local_lines = alloc_result_d.lines;
                        local_lines.push("  " + typed_ptr_temp
                            + " = bitcast i8* "
                            + malloc_temp
                            + " to "
                            + operand_type
                            + "*");
                        local_lines.push("  store " + operand_type + " "
                            + operand.value
                            + ", "
                            + operand_type
                            + "* "
                            + typed_ptr_temp);
                        let mp_op_d = LLVMOperand {
                            llvm_type: "i8*",
                            value: malloc_temp
                        };
                        let mp_operands_d: LLVMOperand[] = [mp_op_d];
                        let mp_result_d = emit_runtime_call("mark_persistent", mp_operands_d, empty_runtime_call_overrides(), local_temp
                            + 4, local_lines);
                        let mut _mp_di_d: int = 0;
                        loop {
                            if _mp_di_d >= mp_result_d.diagnostics.length {
                                break;
                            }
                            diagnostics.push(mp_result_d.diagnostics[_mp_di_d]);
                            _mp_di_d += 1;
                        }
                        diags = extend_diag_array(diags, mp_result_d.diags);
                        local_lines = mp_result_d.lines;
                        has_value = true;
                        value_text = typed_ptr_temp;
                        local_temp += 4;
                    }
                } else {
                    let mut _elif86: boolean = false;
                    if variant_type == "i8*" {
                        if !ends_with_pointer_suffix(operand_type) {
                            _elif86 = true;
                        }
                    }
                    if _elif86 {
                        let mut _if89: boolean = false;
                        if starts_with(operand_type, "%") { _if89 = true; }
                        if starts_with(operand_type, "{") { _if89 = true; }
                        if _if89 {
                            // M1.7.2a (#496): union-variant i8* boxing
                            // routes alloc_struct and mark_persistent
                            // through `emit_runtime_call`.
                            let size_ptr_temp = format_temp_name(local_temp);
                            let size_temp = format_temp_name(local_temp + 1);
                            let malloc_temp = format_temp_name(local_temp + 2);
                            let typed_ptr_temp = format_temp_name(local_temp + 3);
                            local_lines.push("  " + size_ptr_temp
                                + " = getelementptr "
                                + operand_type
                                + ", "
                                + operand_type
                                + "* null, i32 1");
                            local_lines.push("  " + size_temp + " = ptrtoint "
                                + operand_type
                                + "* "
                                + size_ptr_temp
                                + " to i64");
                            let alloc_size_op_e = LLVMOperand {
                                llvm_type: "i64",
                                value: size_temp
                            };
                            let alloc_overrides_e = RuntimeCallOverrides {
                                parameter_types: [],
                                return_type: "",
                                symbol: "",
                                return_attributes: "noalias",
                                c_abi_return_type: ""
                            };
                            let alloc_operands_e: LLVMOperand[] = [alloc_size_op_e];
                            let alloc_result_e = emit_runtime_call("alloc_struct", alloc_operands_e, alloc_overrides_e, local_temp
                                + 2, local_lines);
                            let mut _alloc_di_e: int = 0;
                            loop {
                                if _alloc_di_e >= alloc_result_e.diagnostics.length {
                                    break;
                                }
                                diagnostics.push(alloc_result_e.diagnostics[_alloc_di_e]);
                                _alloc_di_e += 1;
                            }
                            diags = extend_diag_array(diags, alloc_result_e.diags);
                            local_lines = alloc_result_e.lines;
                            local_lines.push("  " + typed_ptr_temp
                                + " = bitcast i8* "
                                + malloc_temp
                                + " to "
                                + operand_type
                                + "*");
                            local_lines.push("  store " + operand_type + " "
                                + operand.value
                                + ", "
                                + operand_type
                                + "* "
                                + typed_ptr_temp);
                            let mp_op_e = LLVMOperand {
                                llvm_type: "i8*",
                                value: malloc_temp
                            };
                            let mp_operands_e: LLVMOperand[] = [mp_op_e];
                            let mp_result_e = emit_runtime_call("mark_persistent", mp_operands_e, empty_runtime_call_overrides(), local_temp
                                + 4, local_lines);
                            let mut _mp_di_e: int = 0;
                            loop {
                                if _mp_di_e >= mp_result_e.diagnostics.length {
                                    break;
                                }
                                diagnostics.push(mp_result_e.diagnostics[_mp_di_e]);
                                _mp_di_e += 1;
                            }
                            diags = extend_diag_array(diags, mp_result_e.diags);
                            local_lines = mp_result_e.lines;
                            has_value = true;
                            value_text = malloc_temp;
                            local_temp += 4;
                        }
                    }
                }
            }
            if has_value {
                let tag_temp = format_temp_name(local_temp);
                let union_temp = format_temp_name(local_temp + 1);
                local_lines.push("  " + tag_temp + " = insertvalue " + target
                    + " undef, i32 "
                    + number_to_string(variant_index)
                    + ", 0");
                local_lines.push("  " + union_temp + " = insertvalue " + target
                    + " "
                    + tag_temp
                    + ", "
                    + variant_type
                    + " "
                    + value_text
                    + ", "
                    + number_to_string(variant_index
                    + 1));
                let coerced = LLVMOperand {
                    llvm_type: target,
                    value: union_temp
                };
                return CoercionResult {
                    lines: local_lines,
                    temp_index: local_temp + 2,
                    operand: coerced,
                    diagnostics: diagnostics,
                    diags: diags
                };
            }
            variant_index += 1;
        }
    }

    // No variant matched. Before this arm was split out of
    // `coerce_general_fallback` it shared that function's single
    // `diagnostics` array, so messages accumulated while probing variants
    // survived the fall-through and rode out on whichever later guard
    // returned a result. Returning a bare null here would drop them, so
    // hand them back with a null `operand` — the caller's signal for
    // "no match, but carry these forward".
    if diagnostics.length > 0 {
        return CoercionResult {
            lines: current_lines,
            temp_index: temp_index,
            operand: null,
            diagnostics: diagnostics,
            diags: diags
        };
    }
    return null;
}
