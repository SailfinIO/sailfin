// compiler/capsules/codegen-llvm/src/expression_lowering/native/core_operands/numeric_integer.sfn
//
// Numeric primitive coercion: integer-target arm of `coerce_numeric_primitive`.
import { LoweringDiagnostic } from "sfn/ir";

import { format_temp_name } from "../../../expressions_helpers";
import { CoercionResult, LLVMOperand } from "../../../types";

// Integer-target coercions (i64/i32/i16/i8/i1) split out of
// `coerce_numeric_primitive` to bound per-module emit working set.
// Returns null if the target isn't an integer type or no arm matches —
// caller (`coerce_numeric_primitive`) falls through to the i8* tail.
fn _coerce_numeric_to_integer_target(operand: LLVMOperand, operand_type: string, target: string, temp_index: int, lines: string[]) -> CoercionResult? {
    let mut current_lines: string[] = lines;
    let mut diagnostics: string[] = [];
    let mut diags: LoweringDiagnostic[] = [];

    if target == "i64" {
        if operand_type == "double" {
            let round_temp = format_temp_name(temp_index);
            let convert_temp = format_temp_name(temp_index + 1);
            current_lines.push("  " + round_temp
                + " = call double @round(double "
                + operand.value
                + ")");
            current_lines.push("  " + convert_temp + " = fptosi double "
                + round_temp
                + " to i64");
            let coerced = LLVMOperand {
                llvm_type: "i64",
                value: convert_temp
            };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 2,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i64" {
        if operand_type == "i32" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = sext i32 " + operand.value
                + " to i64");
            let coerced = LLVMOperand { llvm_type: "i64", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i64" {
        if operand_type == "i8" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = sext i8 " + operand.value
                + " to i64");
            let coerced = LLVMOperand { llvm_type: "i64", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i64" {
        if operand_type == "i1" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = zext i1 " + operand.value
                + " to i64");
            let coerced = LLVMOperand { llvm_type: "i64", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i32" {
        if operand_type == "i64" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = trunc i64 " + operand.value
                + " to i32");
            let coerced = LLVMOperand { llvm_type: "i32", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i32" {
        if operand_type == "i8" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = sext i8 " + operand.value
                + " to i32");
            let coerced = LLVMOperand { llvm_type: "i32", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i32" {
        if operand_type == "i1" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = zext i1 " + operand.value
                + " to i32");
            let coerced = LLVMOperand { llvm_type: "i32", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i32" {
        if operand_type == "double" {
            let round_temp = format_temp_name(temp_index);
            let convert_temp = format_temp_name(temp_index + 1);
            current_lines.push("  " + round_temp
                + " = call double @round(double "
                + operand.value
                + ")");
            current_lines.push("  " + convert_temp + " = fptosi double "
                + round_temp
                + " to i32");
            let coerced = LLVMOperand {
                llvm_type: "i32",
                value: convert_temp
            };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 2,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i8" {
        if operand_type == "i64" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = trunc i64 " + operand.value
                + " to i8");
            let coerced = LLVMOperand { llvm_type: "i8", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i8" {
        if operand_type == "i32" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = trunc i32 " + operand.value
                + " to i8");
            let coerced = LLVMOperand { llvm_type: "i8", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i8" {
        if operand_type == "i1" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = zext i1 " + operand.value
                + " to i8");
            let coerced = LLVMOperand { llvm_type: "i8", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i8" {
        if operand_type == "double" {
            let round_temp = format_temp_name(temp_index);
            let convert_temp = format_temp_name(temp_index + 1);
            current_lines.push("  " + round_temp
                + " = call double @round(double "
                + operand.value
                + ")");
            current_lines.push("  " + convert_temp + " = fptosi double "
                + round_temp
                + " to i8");
            let coerced = LLVMOperand { llvm_type: "i8", value: convert_temp };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 2,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i8" {
        if operand_type == "i8*" {
            let char_ptr_temp = format_temp_name(temp_index);
            let char_value_temp = format_temp_name(temp_index + 1);
            current_lines.push("  " + char_ptr_temp
                + " = getelementptr i8, i8* "
                + operand.value
                + ", i64 0");
            current_lines.push("  " + char_value_temp + " = load i8, i8* "
                + char_ptr_temp);
            let coerced = LLVMOperand {
                llvm_type: "i8",
                value: char_value_temp
            };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 2,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    // SFN-571: `i16` had no arm in either direction, so once the call-site
    // mapper resolved an `i16`/`u16` parameter correctly the coercion still
    // failed and `core_call_emission/dispatch.sfn` fell back to pushing the original
    // uncoerced operand. Mirror the `i8` arms above; widening uses `sext` to
    // match the existing narrow-int convention here (the unsigned widening
    // matrix is SFN-503's `as`-cast territory, not the call boundary).
    if target == "i8" {
        if operand_type == "i16" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = trunc i16 " + operand.value
                + " to i8");
            let coerced = LLVMOperand { llvm_type: "i8", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i64" {
        if operand_type == "i16" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = sext i16 " + operand.value
                + " to i64");
            let coerced = LLVMOperand { llvm_type: "i64", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i32" {
        if operand_type == "i16" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = sext i16 " + operand.value
                + " to i32");
            let coerced = LLVMOperand { llvm_type: "i32", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i16" {
        if operand_type == "i64" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = trunc i64 " + operand.value
                + " to i16");
            let coerced = LLVMOperand { llvm_type: "i16", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i16" {
        if operand_type == "i32" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = trunc i32 " + operand.value
                + " to i16");
            let coerced = LLVMOperand { llvm_type: "i16", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i16" {
        if operand_type == "i8" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = sext i8 " + operand.value
                + " to i16");
            let coerced = LLVMOperand { llvm_type: "i16", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i16" {
        if operand_type == "i1" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = zext i1 " + operand.value
                + " to i16");
            let coerced = LLVMOperand { llvm_type: "i16", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i16" {
        if operand_type == "double" {
            let round_temp = format_temp_name(temp_index);
            let convert_temp = format_temp_name(temp_index + 1);
            current_lines.push("  " + round_temp
                + " = call double @round(double "
                + operand.value
                + ")");
            current_lines.push("  " + convert_temp + " = fptosi double "
                + round_temp
                + " to i16");
            let coerced = LLVMOperand {
                llvm_type: "i16",
                value: convert_temp
            };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 2,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i1" {
        if operand_type == "double" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = fcmp one double "
                + operand.value
                + ", 0.0");
            let coerced = LLVMOperand { llvm_type: "i1", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i1" {
        if operand_type == "i64" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = icmp ne i64 " + operand.value
                + ", 0");
            let coerced = LLVMOperand { llvm_type: "i1", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }
    if target == "i1" {
        if operand_type == "i32" {
            let temp_name = format_temp_name(temp_index);
            current_lines.push("  " + temp_name + " = icmp ne i32 " + operand.value
                + ", 0");
            let coerced = LLVMOperand { llvm_type: "i1", value: temp_name };
            return CoercionResult {
                lines: current_lines,
                temp_index: temp_index + 1,
                operand: coerced,
                diagnostics: diagnostics,
                diags: diags
            };
        }
    }

    return null;
}
