// compiler/capsules/codegen-llvm/src/expression_lowering/native/statement_suspension.sfn
//
// Suspension conflict detection for async code and async ABI helpers.
//
// Detects when mutable borrows remain active across `await`/`yield` suspension
// points, and provides future type / spawn symbol mapping for the async runtime.
import { LoweringDiagnostic, NativeSourceSpan } from "sfn/ir";
import { substring } from "sfn/strings";

import { LocalBinding, ParameterBinding } from "../../types";
import {
    is_identifier_part_char,
    lowering_warning_diag,
    matches_keyword,
    starts_with,
    trim_text
} from "../../utils";
import { format_suspension_location } from "./core";
import { unwrap_move_wrapper } from "./statement_type_mapping";

// ---------------------------------------------------------------------------
// Keyword scanning
// ---------------------------------------------------------------------------
fn contains_keyword_outside_strings(value: string, keyword: string) -> boolean {
    if value.length == 0 { return false; }
    let mut index: int = 0;
    let mut in_single: boolean = false;
    let mut in_double: boolean = false;
    let mut escape: boolean = false;
    loop {
        if index >= value.length { break; }
        let ch = substring(value, index, index + 1);
        if in_single {
            if escape { escape = false; } else if ch == "\\" { escape = true; } else if ch == "'" {
                in_single = false;
            }
            index += 1;
            continue;
        }
        if in_double {
            if escape { escape = false; } else if ch == "\\" { escape = true; } else if ch == "\"" {
                in_double = false;
            }
            index += 1;
            continue;
        }
        if ch == "'" {
            in_single = true;
            index += 1;
            continue;
        }
        if ch == "\"" {
            in_double = true;
            index += 1;
            continue;
        }
        if ch == substring(keyword, 0, 1) {
            if index > 0 {
                let previous = substring(value, index - 1, index);
                if is_identifier_part_char(previous) {
                    index += 1;
                    continue;
                }
            }
            if matches_keyword(value, index, keyword) { return true; }
        }
        index += 1;
    }
    return false;
}

fn find_suspension_keyword(expression: string) -> string {
    if contains_keyword_outside_strings(expression, "await") { return "await"; }
    if contains_keyword_outside_strings(expression, "yield") { return "yield"; }
    return "";
}

// ---------------------------------------------------------------------------
// Borrow annotation helpers
// ---------------------------------------------------------------------------
fn is_mutable_borrow_annotation(annotation: string) -> boolean {
    let trimmed = trim_text(annotation);
    if trimmed.length == 0 { return false; }
    let normalized = unwrap_move_wrapper(trimmed);
    if normalized.length == 0 { return false; }
    if substring(normalized, 0, 1) != "&" { return false; }
    let remainder = trim_text(substring(normalized, 1, normalized.length));
    if remainder.length == 0 { return false; }
    if starts_with(remainder, "mut") { return true; }
    return false;
}

fn normalise_borrow_base(raw_base: string) -> string {
    let mut trimmed = trim_text(raw_base);
    loop {
        if trimmed.length == 0 { break; }
        if substring(trimmed, 0, 1) == "*" {
            trimmed = trim_text(substring(trimmed, 1, trimmed.length));
            continue;
        }
        break;
    }
    if trimmed.length >= 2 {
        if substring(trimmed, 0, 1) == "(" {
            if substring(trimmed, trimmed.length - 1, trimmed.length) == ")" {
                let inner = trim_text(substring(trimmed, 1, trimmed.length - 1));
                if inner.length > 0 { return inner; }
            }
        }
    }
    return trimmed;
}

// ---------------------------------------------------------------------------
// Suspension conflict detection
// ---------------------------------------------------------------------------
// One detected conflict, held in the single shape both output channels are
// derived from (SFN-915). `message` is the location-free core; `location` is
// the legacy ` (borrow at L:C-L:C; await at L:C-L:C)` suffix; `span` is the
// same information as a real span for the structured channel. Deriving both
// renderings from one record is what keeps the legacy string byte-identical
// while SFN-539 AC3 moves the location out of the structured message.
struct SuspensionConflict {
    message: string;
    location: string;
    span: NativeSourceSpan?;
}

fn _collect_suspension_conflict_records(keyword: string, locals: LocalBinding[], bindings: ParameterBinding[], function_name: string, suspension_span: NativeSourceSpan?) -> SuspensionConflict[] {
    let mut conflicts: SuspensionConflict[] = [];
    let mut index: int = 0;
    loop {
        if index >= locals.length { break; }
        let local = locals[index];
        if !local.consumed {
            if local.ownership != null {
                let details = local.ownership;
                if details.variant == "Borrow" {
                    if details.mutable {
                        let base_name = normalise_borrow_base(details.base);
                        // The suspension point is where the conflict is
                        // observable, so it is the primary span; the borrow
                        // site stands in when the caller threaded no
                        // statement span. Both remain in `location`.
                        let mut primary: NativeSourceSpan? = suspension_span;
                        if primary == null { primary = details.span; }
                        conflicts.push(SuspensionConflict {
                            message: keyword
                                + " suspends while mutable borrow `"
                                + local.name
                                + "` of `"
                                + base_name
                                + "` remains active in `"
                                + function_name
                                + "`", location: format_suspension_location(keyword, details.span, suspension_span), span: primary
                        });
                    }
                }
            }
        }
        index += 1;
    }
    let mut parameter_index: int = 0;
    loop {
        if parameter_index >= bindings.length { break; }
        let binding = bindings[parameter_index];
        if !binding.consumed {
            if is_mutable_borrow_annotation(binding.type_annotation) {
                let mut primary: NativeSourceSpan? = suspension_span;
                if primary == null { primary = binding.span; }
                conflicts.push(SuspensionConflict {
                    message: keyword
                        + " suspends while mutable borrow parameter `"
                        + binding.name
                        + "` remains active in `"
                        + function_name
                        + "`", location: format_suspension_location(keyword, binding.span, suspension_span), span: primary
                });
            }
        }
        parameter_index += 1;
    }
    return conflicts;
}

fn collect_suspension_conflicts(keyword: string, locals: LocalBinding[], bindings: ParameterBinding[], function_name: string, suspension_span: NativeSourceSpan?) -> string[] {
    let conflicts = _collect_suspension_conflict_records(keyword, locals, bindings, function_name, suspension_span);
    let mut diagnostics: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= conflicts.length { break; }
        let conflict = conflicts[index];
        diagnostics.push("llvm lowering: " + conflict.message + conflict.location);
        index += 1;
    }
    return diagnostics;
}

// The structured twin. These conflicts have never carried `[fatal]`, so they
// stay `warning` severity — promoting them would make the gate SFN-540
// derives from `diags` reject builds the string gate accepts today.
fn collect_suspension_conflict_diags(keyword: string, locals: LocalBinding[], bindings: ParameterBinding[], function_name: string, suspension_span: NativeSourceSpan?) -> LoweringDiagnostic[] {
    let conflicts = _collect_suspension_conflict_records(keyword, locals, bindings, function_name, suspension_span);
    let mut diags: LoweringDiagnostic[] = [];
    let mut index: int = 0;
    loop {
        if index >= conflicts.length { break; }
        let conflict = conflicts[index];
        diags.push(lowering_warning_diag("E1022", conflict.message, conflict.span));
        index += 1;
    }
    return diags;
}

fn detect_suspension_conflicts(expression: string?, locals: LocalBinding[], bindings: ParameterBinding[], function_name: string, suspension_span: NativeSourceSpan?) -> string[] {
    if expression == null { return []; }
    let trimmed = trim_text(expression);
    if trimmed.length == 0 { return []; }
    let keyword = find_suspension_keyword(trimmed);
    if keyword.length == 0 { return []; }
    return collect_suspension_conflicts(keyword, locals, bindings, function_name, suspension_span);
}

fn detect_suspension_conflict_diags(expression: string?, locals: LocalBinding[], bindings: ParameterBinding[], function_name: string, suspension_span: NativeSourceSpan?) -> LoweringDiagnostic[] {
    if expression == null { return []; }
    let trimmed = trim_text(expression);
    if trimmed.length == 0 { return []; }
    let keyword = find_suspension_keyword(trimmed);
    if keyword.length == 0 { return []; }
    return collect_suspension_conflict_diags(keyword, locals, bindings, function_name, suspension_span);
}

// ---------------------------------------------------------------------------
// Async ABI helpers
// ---------------------------------------------------------------------------
fn future_pointer_type_for_return_type(return_type: string) -> string {
    let trimmed = trim_text(return_type);
    let mut _if157: boolean = false;
    if trimmed.length == 0 { _if157 = true; }
    if trimmed == "void" { _if157 = true; }
    if _if157 { return "%SailfinFutureVoid*"; }
    let normalized = unwrap_move_wrapper(trimmed);
    if normalized == "number" {
        return "%SailfinFutureNumber*";
    }  // alias-coverage: Future mapping seam (Slice E.2 follow-up)
    let mut _if157b: boolean = false;
    if normalized == "int" { _if157b = true; }
    if normalized == "i64" { _if157b = true; }
    if normalized == "u64" { _if157b = true; }
    if normalized == "usize" { _if157b = true; }
    if normalized == "isize" { _if157b = true; }
    if _if157b { return "%SailfinFutureInt*"; }
    let mut _if158: boolean = false;
    if normalized == "boolean" { _if158 = true; }
    if normalized == "bool" { _if158 = true; }
    if _if158 { return "%SailfinFutureBool*"; }
    if normalized == "string" { return "%SailfinFutureString*"; }
    // Default: treat unknown/user types as an opaque pointer.
    return "%SailfinFuturePtr*";
}

fn spawn_symbol_for_return_type(return_type: string) -> string {
    let trimmed = trim_text(return_type);
    let mut _if159: boolean = false;
    if trimmed.length == 0 { _if159 = true; }
    if trimmed == "void" { _if159 = true; }
    if _if159 { return "sfn_spawn_void"; }
    let normalized = unwrap_move_wrapper(trimmed);
    if normalized == "number" {
        return "sfn_spawn_number";
    }  // alias-coverage: Future mapping seam (Slice E.2 follow-up)
    let mut _if159b: boolean = false;
    if normalized == "int" { _if159b = true; }
    if normalized == "i64" { _if159b = true; }
    if normalized == "u64" { _if159b = true; }
    if normalized == "usize" { _if159b = true; }
    if normalized == "isize" { _if159b = true; }
    if _if159b { return "sfn_spawn_int"; }
    let mut _if160: boolean = false;
    if normalized == "boolean" { _if160 = true; }
    if normalized == "bool" { _if160 = true; }
    if _if160 { return "sfn_spawn_bool"; }
    if normalized == "string" { return "sfn_spawn_string"; }
    return "sfn_spawn_ptr";
}

fn spawn_ctx_symbol_for_return_type(return_type: string) -> string {
    let trimmed = trim_text(return_type);
    let mut _if161: boolean = false;
    if trimmed.length == 0 { _if161 = true; }
    if trimmed == "void" { _if161 = true; }
    if _if161 { return "sfn_spawn_void_ctx"; }
    let normalized = unwrap_move_wrapper(trimmed);
    if normalized == "number" {
        return "sfn_spawn_number_ctx";
    }  // alias-coverage: Future mapping seam (Slice E.2 follow-up)
    let mut _if161b: boolean = false;
    if normalized == "int" { _if161b = true; }
    if normalized == "i64" { _if161b = true; }
    if normalized == "u64" { _if161b = true; }
    if normalized == "usize" { _if161b = true; }
    if normalized == "isize" { _if161b = true; }
    if _if161b { return "sfn_spawn_int_ctx"; }
    let mut _if162: boolean = false;
    if normalized == "boolean" { _if162 = true; }
    if normalized == "bool" { _if162 = true; }
    if _if162 { return "sfn_spawn_bool_ctx"; }
    if normalized == "string" { return "sfn_spawn_string_ctx"; }
    return "sfn_spawn_ptr_ctx";
}

fn await_symbol_for_future_pointer_type(future_ptr_type: string) -> string {
    if future_ptr_type == "%SailfinFutureNumber*" { return "sfn_await_number"; }
    if future_ptr_type == "%SailfinFutureInt*" { return "sfn_await_int"; }
    if future_ptr_type == "%SailfinFutureBool*" { return "sfn_await_bool"; }
    if future_ptr_type == "%SailfinFutureVoid*" { return "sfn_await_void"; }
    if future_ptr_type == "%SailfinFutureString*" { return "sfn_await_string"; }
    if future_ptr_type == "%SailfinFuturePtr*" { return "sfn_await_ptr"; }
    return "";
}
