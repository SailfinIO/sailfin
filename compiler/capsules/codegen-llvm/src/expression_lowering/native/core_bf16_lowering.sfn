// compiler/capsules/codegen-llvm/src/expression_lowering/native/core_bf16_lowering.sfn
//
// bf16 conversion emission.
//
// LLVM 18's AArch64 backend has no selection pattern for any `bfloat`
// conversion — `fpext bfloat`, `fptrunc … to bfloat`, `sitofp … to bfloat`,
// and `llvm.fptosi.sat.*.bf16` all abort instruction selection with
// "Cannot select" (SFN-609). Plain `load`/`store bfloat` are fine, so the
// carrier type is unaffected; only the conversions have to change.
//
// SFEP-0054 §3.7 authorises exactly this substitution: "The CPU reference may
// call small Sailfin-native bit-conversion helpers when that is required for
// deterministic rounding." The sequences below are emitted unconditionally on
// every target, not gated on the triple — one lowering keeps x86_64 and
// AArch64 bit-identical by construction, and lets the x86-primary CI gate
// exercise the same code the ARM lane runs.
//
// bf16 is bit-identical to the high 16 bits of f32 (same 8-bit exponent, same
// bias 127), so widening is an exact mantissa zero-extend and narrowing is a
// round-to-nearest-ties-to-even on the discarded low half. SFEP-0054 §3.4
// requires narrowing to round *once*, which is why the f64 path rounds to odd
// through f32 rather than rounding twice.
import { format_temp_name } from "../../expressions_helpers";

// A bf16 conversion's emitted lines, the next free temp index, and the SSA
// name holding the result. `llvm_type` is documented per emitter rather than
// carried, since every caller already knows what it asked for.
struct Bf16Emission {
    lines: string[];
    temp_index: int;
    value: string;
}

// bf16 -> f32. Exact for every input: the 8-bit exponent field is shared with
// f32 and the 7-bit mantissa zero-extends, so no value (finite, subnormal,
// infinite, or NaN) is perturbed. Verified exhaustively against `fpext bfloat`
// over all 65,536 bit patterns, NaN payloads included.
//
// Result type: `float`.
fn emit_bf16_widen_to_float(value: string, temp_index: int, lines: string[]) -> Bf16Emission {
    let mut next: int = temp_index;
    let mut current_lines: string[] = lines;

    let as_i16 = format_temp_name(next);
    next += 1;
    let as_i32 = format_temp_name(next);
    next += 1;
    let shifted = format_temp_name(next);
    next += 1;
    let as_float = format_temp_name(next);
    next += 1;

    current_lines.push("  " + as_i16 + " = bitcast bfloat " + value + " to i16");
    current_lines.push("  " + as_i32 + " = zext i16 " + as_i16 + " to i32");
    current_lines.push("  " + shifted + " = shl i32 " + as_i32 + ", 16");
    current_lines.push("  " + as_float + " = bitcast i32 " + shifted
        + " to float");

    return Bf16Emission {
        lines: current_lines,
        temp_index: next,
        value: as_float
    };
}

// bf16 -> f64. The exact widen above followed by an ordinary `fpext float` —
// which AArch64 selects without trouble, since only `bfloat` operands are
// unsupported.
//
// Result type: `double`.
fn emit_bf16_widen_to_double(value: string, temp_index: int, lines: string[]) -> Bf16Emission {
    let widened = emit_bf16_widen_to_float(value, temp_index, lines);
    let mut current_lines: string[] = widened.lines;
    let as_double = format_temp_name(widened.temp_index);
    current_lines.push("  " + as_double + " = fpext float " + widened.value
        + " to double");
    return Bf16Emission {
        lines: current_lines,
        temp_index: widened.temp_index + 1,
        value: as_double
    };
}

// f32 -> bf16, round-to-nearest-ties-to-even.
//
// The rounding is the standard bias add: `bits + 0x7FFF + lsb(bits >> 16)`
// carries a half-way case up only when the retained low bit is already 1,
// which is precisely ties-to-even. NaN is handled separately because the bias
// add can carry a NaN's exponent into infinity; forcing f32's quiet bit
// (0x400000) before the shift keeps a NaN a NaN.
//
// Verified bit-identical to `fptrunc float to bfloat` over 116,080,198
// sampled f32 values.
//
// Result type: `bfloat`.
fn emit_bf16_narrow_from_float(value: string, temp_index: int, lines: string[]) -> Bf16Emission {
    let mut next: int = temp_index;
    let mut current_lines: string[] = lines;

    let bits = format_temp_name(next);
    next += 1;
    let high = format_temp_name(next);
    next += 1;
    let lsb = format_temp_name(next);
    next += 1;
    let bias = format_temp_name(next);
    next += 1;
    let rounded = format_temp_name(next);
    next += 1;
    let rounded_high = format_temp_name(next);
    next += 1;
    let quieted = format_temp_name(next);
    next += 1;
    let quieted_high = format_temp_name(next);
    next += 1;
    let is_nan = format_temp_name(next);
    next += 1;
    let selected = format_temp_name(next);
    next += 1;
    let narrowed = format_temp_name(next);
    next += 1;
    let as_bfloat = format_temp_name(next);
    next += 1;

    current_lines.push("  " + bits + " = bitcast float " + value + " to i32");
    current_lines.push("  " + high + " = lshr i32 " + bits + ", 16");
    current_lines.push("  " + lsb + " = and i32 " + high + ", 1");
    current_lines.push("  " + bias + " = add i32 " + lsb + ", 32767");
    current_lines.push("  " + rounded + " = add i32 " + bits + ", " + bias);
    current_lines.push("  " + rounded_high + " = lshr i32 " + rounded + ", 16");
    current_lines.push("  " + quieted + " = or i32 " + bits + ", 4194304");
    current_lines.push("  " + quieted_high + " = lshr i32 " + quieted + ", 16");
    current_lines.push("  " + is_nan + " = fcmp uno float " + value + ", "
        + value);
    current_lines.push("  " + selected + " = select i1 " + is_nan + ", i32 "
        + quieted_high
        + ", i32 "
        + rounded_high);
    current_lines.push("  " + narrowed + " = trunc i32 " + selected + " to i16");
    current_lines.push("  " + as_bfloat + " = bitcast i16 " + narrowed
        + " to bfloat");

    return Bf16Emission {
        lines: current_lines,
        temp_index: next,
        value: as_bfloat
    };
}

// f64 -> bf16, correctly rounded in a single step.
//
// SFEP-0054 §3.4 requires narrowing to round once; §3.3 rules out rounding
// through an intermediate format because "double rounding can change a
// boundary result". Rounding f64 -> f32 (RNE) -> bf16 (RNE) is measurably
// wrong on ~1.2e-6 of inputs, so the intermediate step rounds to *odd*
// instead: by Boldo-Melquiond, RN_p1(odd_p2(x)) == RN_p1(x) whenever
// p2 >= p1 + 2, and here p2 = 24 (f32) against p1 = 8 (bf16).
//
// Round-to-odd is "take whichever of x's two f32 neighbours has an odd
// significand". `fptrunc` hands back one neighbour for free; the correction
// moves to the other one when the RNE result is even and the conversion lost
// information. The step is `magnitude +/- 1`, not `| 1` — when RNE rounded
// away from zero the odd neighbour is one *below* in magnitude.
//
// The NaN guard reads the pre-correction bits: for a NaN the inexact test is
// true, and the correction could carry magnitude 0x7FFFFFFF to 0x80000000 and
// turn the NaN into -0.0. SFEP-0054 §3.1 leaves NaN payloads outside the
// portable contract, so forwarding the quieted f32 payload is legal.
//
// Verified bit-identical to `fptrunc double to bfloat` over 6,917,525 values,
// including a stratified sweep of every bf16 midpoint and its f64 neighbours.
//
// Result type: `bfloat`.
fn emit_bf16_narrow_from_double(value: string, temp_index: int, lines: string[]) -> Bf16Emission {
    let mut next: int = temp_index;
    let mut current_lines: string[] = lines;

    let narrowed = format_temp_name(next);
    next += 1;
    let widened_back = format_temp_name(next);
    next += 1;
    let bits = format_temp_name(next);
    next += 1;
    let sign = format_temp_name(next);
    next += 1;
    let magnitude = format_temp_name(next);
    next += 1;
    let inexact = format_temp_name(next);
    next += 1;
    let rounded_up = format_temp_name(next);
    next += 1;
    let is_negative = format_temp_name(next);
    next += 1;
    let rounded_away = format_temp_name(next);
    next += 1;
    let step = format_temp_name(next);
    next += 1;
    let neighbour = format_temp_name(next);
    next += 1;
    let low_bit = format_temp_name(next);
    next += 1;
    let is_even = format_temp_name(next);
    next += 1;
    let needs_odd = format_temp_name(next);
    next += 1;
    let magnitude_odd = format_temp_name(next);
    next += 1;
    let odd_bits = format_temp_name(next);
    next += 1;

    // Step 1: hardware RNE narrow to f32, and an exact widen back so the
    // conversion's inexactness and direction can be recovered.
    current_lines.push("  " + narrowed + " = fptrunc double " + value
        + " to float");
    current_lines.push("  " + widened_back + " = fpext float " + narrowed
        + " to double");
    current_lines.push("  " + bits + " = bitcast float " + narrowed + " to i32");
    current_lines.push("  " + sign + " = and i32 " + bits + ", -2147483648");
    current_lines.push("  " + magnitude + " = and i32 " + bits + ", 2147483647");

    // Step 2: correct the f32 intermediate to odd.
    current_lines.push("  " + inexact + " = fcmp une double " + widened_back
        + ", "
        + value);
    current_lines.push("  " + rounded_up + " = fcmp ogt double " + widened_back
        + ", "
        + value);
    current_lines.push("  " + is_negative + " = icmp slt i32 " + bits + ", 0");
    current_lines.push("  " + rounded_away + " = xor i1 " + is_negative + ", "
        + rounded_up);
    current_lines.push("  " + step + " = select i1 " + rounded_away
        + ", i32 -1, i32 1");
    current_lines.push("  " + neighbour + " = add i32 " + magnitude + ", "
        + step);
    current_lines.push("  " + low_bit + " = and i32 " + bits + ", 1");
    current_lines.push("  " + is_even + " = icmp eq i32 " + low_bit + ", 0");
    current_lines.push("  " + needs_odd + " = and i1 " + inexact + ", "
        + is_even);
    current_lines.push("  " + magnitude_odd + " = select i1 " + needs_odd
        + ", i32 "
        + neighbour
        + ", i32 "
        + magnitude);
    current_lines.push("  " + odd_bits + " = or i32 " + sign + ", "
        + magnitude_odd);

    // Step 3: RNE the round-to-odd intermediate down to bf16.
    let high = format_temp_name(next);
    next += 1;
    let lsb = format_temp_name(next);
    next += 1;
    let bias = format_temp_name(next);
    next += 1;
    let biased = format_temp_name(next);
    next += 1;
    let biased_high = format_temp_name(next);
    next += 1;

    current_lines.push("  " + high + " = lshr i32 " + odd_bits + ", 16");
    current_lines.push("  " + lsb + " = and i32 " + high + ", 1");
    current_lines.push("  " + bias + " = add i32 " + lsb + ", 32767");
    current_lines.push("  " + biased + " = add i32 " + odd_bits + ", " + bias);
    current_lines.push("  " + biased_high + " = lshr i32 " + biased + ", 16");

    // Step 4: NaN guard, taken from the pre-correction RNE bits.
    let quieted = format_temp_name(next);
    next += 1;
    let quieted_high = format_temp_name(next);
    next += 1;
    let is_nan = format_temp_name(next);
    next += 1;
    let selected = format_temp_name(next);
    next += 1;
    let truncated = format_temp_name(next);
    next += 1;
    let as_bfloat = format_temp_name(next);
    next += 1;

    current_lines.push("  " + quieted + " = or i32 " + bits + ", 4194304");
    current_lines.push("  " + quieted_high + " = lshr i32 " + quieted + ", 16");
    current_lines.push("  " + is_nan + " = fcmp uno double " + value + ", "
        + value);
    current_lines.push("  " + selected + " = select i1 " + is_nan + ", i32 "
        + quieted_high
        + ", i32 "
        + biased_high);
    current_lines.push("  " + truncated + " = trunc i32 " + selected + " to i16");
    current_lines.push("  " + as_bfloat + " = bitcast i16 " + truncated
        + " to bfloat");

    return Bf16Emission {
        lines: current_lines,
        temp_index: next,
        value: as_bfloat
    };
}

// 64-bit integer -> f64, pre-rounded to odd so the subsequent f64 -> bf16
// narrow stays correctly rounded.
//
// i64/u64 do not fit f64's 53-bit significand, so a plain `sitofp i64 to
// double` rounds, and rounding again into bf16 is a double rounding that
// SFEP-0054 §3.4 forbids. LLVM's own `sitofp i64 to bfloat` has this bug: it
// disagrees with an exact integer oracle on 31 of 4,000,016 sampled values,
// where this sequence agrees on all of them.
//
// Values at or below 2^53 are exact in f64 and pass through untouched; above
// it the magnitude is truncated toward zero at the 2^11 grid with the
// discarded bits OR'd back as a sticky low bit. Round-to-odd composes, so the
// 2^11-grid -> f32 -> bf16 chain is still a single effective rounding.
//
// `narrower_is_signed` selects the sign dance; an unsigned source operates on
// the magnitude directly and the caller finishes with `uitofp`.
//
// Result type: `i64`.
fn emit_i64_round_to_odd(value: string, narrower_is_signed: boolean, temp_index: int, lines: string[]) -> Bf16Emission {
    let mut next: int = temp_index;
    let mut current_lines: string[] = lines;

    let mut magnitude: string = value;
    let mut is_negative: string = "";
    if narrower_is_signed {
        is_negative = format_temp_name(next);
        next += 1;
        let negated = format_temp_name(next);
        next += 1;
        let absolute = format_temp_name(next);
        next += 1;
        current_lines.push("  " + is_negative + " = icmp slt i64 " + value
            + ", 0");
        current_lines.push("  " + negated + " = sub i64 0, " + value);
        current_lines.push("  " + absolute + " = select i1 " + is_negative
            + ", i64 "
            + negated
            + ", i64 "
            + value);
        magnitude = absolute;
    }

    let sticky_bits = format_temp_name(next);
    next += 1;
    let has_sticky = format_temp_name(next);
    next += 1;
    let truncated = format_temp_name(next);
    next += 1;
    let sticky_term = format_temp_name(next);
    next += 1;
    let odd_magnitude = format_temp_name(next);
    next += 1;
    let is_lossy = format_temp_name(next);
    next += 1;
    let corrected = format_temp_name(next);
    next += 1;

    current_lines.push("  " + sticky_bits + " = and i64 " + magnitude + ", 2047");
    current_lines.push("  " + has_sticky + " = icmp ne i64 " + sticky_bits
        + ", 0");
    current_lines.push("  " + truncated + " = and i64 " + magnitude + ", -2048");
    current_lines.push("  " + sticky_term + " = select i1 " + has_sticky
        + ", i64 2048, i64 0");
    current_lines.push("  " + odd_magnitude + " = or i64 " + truncated + ", "
        + sticky_term);
    current_lines.push("  " + is_lossy + " = icmp ugt i64 " + magnitude
        + ", 9007199254740992");
    current_lines.push("  " + corrected + " = select i1 " + is_lossy + ", i64 "
        + odd_magnitude
        + ", i64 "
        + magnitude);

    if !narrower_is_signed {
        return Bf16Emission {
            lines: current_lines,
            temp_index: next,
            value: corrected
        };
    }

    let restored = format_temp_name(next);
    next += 1;
    let signed_result = format_temp_name(next);
    next += 1;
    current_lines.push("  " + restored + " = sub i64 0, " + corrected);
    current_lines.push("  " + signed_result + " = select i1 " + is_negative
        + ", i64 "
        + restored
        + ", i64 "
        + corrected);

    return Bf16Emission {
        lines: current_lines,
        temp_index: next,
        value: signed_result
    };
}

export {
    Bf16Emission,
    emit_bf16_narrow_from_double,
    emit_bf16_narrow_from_float,
    emit_bf16_widen_to_double,
    emit_bf16_widen_to_float,
    emit_i64_round_to_odd
};
