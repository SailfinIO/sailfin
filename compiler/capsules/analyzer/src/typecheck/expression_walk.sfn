// compiler/capsules/analyzer/src/typecheck/expression_walk.sfn
//
// The expression walk: recursive type/scope checking of every expression
// form, dispatching to the per-rule modules for the specific checks.
import { parse_fn_type_text } from "sfn/ir";
import { ends_with, substring } from "sfn/strings";
import {
    Expression,
    SourceSpan,
    Statement,
    TypeAnnotation
} from "sfn/syntax";

import { lookup_imported_function } from "../effect_imports";
import { Diagnostic } from "../typecheck_types";
import {
    check_bare_fn_type_annotation,
    check_malformed_array_annotation,
    check_unknown_type_annotation,
    classify_declared_primitive,
    declared_array_marker
} from "../typecheck_types/annotation_shape_checks";
import { make_nested_fn_capture_diagnostic, make_undefined_function_diagnostic } from "../typecheck_types/declaration_and_statement_checks";
import { make_parse_error_diagnostic } from "../typecheck_types/expr_type_rules";
import { is_builtin_call_name, is_builtin_member_root } from "../typecheck_types/extern_abi";
import { check_named_fn_value_compatibility } from "../typecheck_types/named_fn_values";
import {
    SymbolEntry,
    check_char_literal_raw,
    check_fn_reference_raw,
    check_unanalyzable_raw,
    check_value_if_raw,
    classify_fn_cast,
    clone_bindings,
    find_symbol,
    find_value_symbol,
    is_function_kind,
    make_fn_value_position_diagnostic,
    make_imported_fn_value_diagnostic,
    register_local_symbol
} from "../typecheck_types/symbol_table_and_raw_exprs";
import { trim_text } from "../typecheck_types/text_utils";
import { check_intersection_value_type_annotation, check_object_literal_target } from "../typecheck_types/value_and_object_checks";
import {
    _struct_arithmetic_diagnostics,
    array_arithmetic_diagnostics,
    mixed_arithmetic_diagnostics,
    primitive_method_diagnostics
} from "./arithmetic_rules";
import {
    _value_anchor_span,
    check_array_element_assignment,
    check_array_element_type
} from "./array_element_rules";
import { walk_block_expressions } from "./block_walk";
import {
    call_arity_diagnostics,
    void_argument_diagnostics,
    void_value_diagnostics
} from "./call_signature";
import {
    channel_send_diagnostics,
    check_spawn_target,
    push_spawn_handle_diagnostics
} from "./concurrency_rules";
import {
    TypeckCtx,
    ctx_enter_body,
    ctx_in_callee_position,
    ctx_with_bindings,
    ctx_with_expected_type
} from "./context";
import { unknown_field_diagnostics } from "./field_access";
import { _serve_resolves_to_user_fn } from "./patterns";
import {
    call_argument_type_diagnostics,
    check_expected_primitive_type,
    make_undefined_value_diagnostic,
    serve_argument_type_diagnostics
} from "./primitive_rules";
import {
    _imported_struct_field_expected_type,
    _struct_field_expected_type,
    _struct_name_is_imported,
    _struct_shape_is_resolvable,
    _struct_type_names,
    _without_code
} from "./struct_literal_fn_values";
import { _declared_struct_annotation, _string_list_has } from "./symbols";
import { _is_syscall_name, _syscall_call_diagnostics } from "./syscalls";
import { _conditional_branch_type, check_conditional_types } from "./try_and_conditional";

fn walk_expression(expression: Expression?, ctx: TypeckCtx) -> Diagnostic[] {
    let bindings = ctx.bindings;
    let imports = ctx.imports;
    if expression == null { return []; }
    if expression.variant == "Call" {
        // A bare-identifier callee is a *call target*, not a value
        // reference — do not route it through `walk_expression` (that
        // would trip the E0808 function-as-value check below). It is
        // validated inline for E0420 (undefined function) instead.
        // Non-identifier callees (parenthesized exprs, member access)
        // still recurse.
        let mut diagnostics: Diagnostic[] = [];
        if expression.callee != null {
            if expression.callee.variant != "Identifier" {
                // SFN-543: marked as callee position so the Member arm reads
                // `obj.method()`'s member as a method (E0012's territory)
                // rather than as a missing field (E0015).
                diagnostics = walk_expression(expression.callee, ctx_in_callee_position(ctx));
            }
        }
        // #812: a bare-identifier callee that resolves to neither an
        // in-scope binding (parameter / local / top-level declaration /
        // import-specifier name) nor a builtin envelope name nor an
        // imported free function in the localized effect table is an
        // undefined function — emit E0420 caret-ed at the callee.
        // Member callees (`obj.method()`) never reach this branch: they
        // recurse through the Member arm, which only descends into
        // `.object` and never inspects the member name.
        if expression.callee != null {
            if expression.callee.variant == "Identifier" {
                let callee_name = expression.callee.name;
                if _is_syscall_name(callee_name) {
                    diagnostics = diagnostics.concat(_syscall_call_diagnostics(expression, ctx));
                }
                let callee_entry = find_symbol(bindings, callee_name);
                if callee_entry != null {
                    // Calling a captured enclosing local from a nested fn body
                    // (tagged `"outer_local"`) is an illegal capture, not a
                    // resolved call (SFEP-0042, E0421).
                    if strings_equal(callee_entry.kind, "outer_local") {
                        diagnostics.push(make_nested_fn_capture_diagnostic(callee_name, expression.callee.span));
                    }
                } else {
                    if !is_builtin_call_name(callee_name) {
                        if lookup_imported_function(imports, callee_name) == null {
                            let available = lookup_imported_function(ctx.available_imports, callee_name);
                            let mut provider: string = "";
                            if available != null {
                                provider = available.provider_module;
                            }
                            diagnostics.push(make_undefined_function_diagnostic(callee_name, expression.callee.span, provider));
                        }
                    }
                }
            }
        }
        let mut index: int = 0;
        loop {
            if index >= expression.arguments.length { break; }
            diagnostics = diagnostics.concat(walk_expression(expression.arguments[index], ctx_with_expected_type(ctx, _call_argument_expected_type(expression, index, ctx))));
            // SFN-812: a void call cannot supply an argument. Without this the
            // operand lowers to nothing and the callee reads a fabricated
            // zero — indistinguishable from a legitimate `0`/`""` result.
            diagnostics = diagnostics.concat(void_argument_diagnostics(expression, index, ctx));
            index += 1;
        }
        // SFN-812: reject an argument count the callee cannot accept (E0423).
        // A missing argument is otherwise zero-filled and an extra one
        // dropped, with no diagnostic at any stage.
        diagnostics = diagnostics.concat(call_arity_diagnostics(expression, ctx));
        // `ch.send(v)` on a `Channel<T>`-annotated receiver enforces the
        // element type -> E0815 (#1942). Silent unless the mismatch is
        // certain (see `channel_send_diagnostics`).
        diagnostics = diagnostics.concat(channel_send_diagnostics(expression, bindings));
        // `hs.push(spawn ...)` on an inferred-empty `[]`-tagged receiver ->
        // E0823 (SFN-386). See `push_spawn_handle_diagnostics`.
        diagnostics = diagnostics.concat(push_spawn_handle_diagnostics(expression, bindings));
        // `field.to_uppercase()` on a proven primitive receiver whose method
        // resolves to neither a primitive method descriptor nor a free callable
        // -> E0012 (SFN-385). Silent unless the receiver's primitive kind is
        // known and the method is provably unresolvable (see
        // `primitive_method_diagnostics`), so it rejects exactly the calls the
        // lowerer would fatal on ("callee signature is not known").
        diagnostics = diagnostics.concat(primitive_method_diagnostics(expression, ctx));
        diagnostics = diagnostics.concat(call_argument_type_diagnostics(expression, bindings));
        return diagnostics;
    }
    if expression.variant == "Binary" {
        let child_ctx = ctx_with_expected_type(ctx, null);
        let mut diagnostics = walk_expression(expression.left, child_ctx);
        diagnostics = diagnostics.concat(walk_expression(expression.right, child_ctx));
        // `a + b` mixing a proven `int` and `float` operand -> E0306 (SFN-385).
        // Silent unless both operands' numeric kinds are known and differ, so it
        // rejects exactly the arithmetic the lowerer would fatal on ("ABI
        // primitive mismatch").
        diagnostics = diagnostics.concat(mixed_arithmetic_diagnostics(expression, bindings));
        diagnostics = diagnostics.concat(array_arithmetic_diagnostics(expression, bindings));
        diagnostics = diagnostics.concat(_struct_arithmetic_diagnostics(expression, ctx));
        // SFN-812: `"total: " + print(x)` has no value to concatenate.
        diagnostics = diagnostics.concat(void_value_diagnostics(expression.left, ctx, "an operand of `"
            + expression.operator
            + "`"));
        diagnostics = diagnostics.concat(void_value_diagnostics(expression.right, ctx, "an operand of `"
            + expression.operator
            + "`"));
        return diagnostics;
    }
    if expression.variant == "Unary" {
        // Prefix `*`/`&`/`-`/`!` — recurse into the operand so its diagnostics
        // still fire. In particular, once #1627 Part B structured prefix `&`
        // into `Unary{"&", Identifier(fn)}` (instead of degrading `& fn` to
        // `Raw`), the operand `Identifier` reaches the `Identifier` arm below,
        // which emits E0808 for a function used in value position — preserving
        // the prior `check_fn_reference_raw` `& fn` behavior.
        let mut diagnostics = walk_expression(expression.operand, ctx_with_expected_type(ctx, null));
        // SFN-812: `!print(x)` / `-print(x)` have no value to operate on.
        // `await` is excluded — it takes a task handle, and a void-returning
        // task is a legitimate shape.
        if !strings_equal(expression.operator, "await") {
            diagnostics = diagnostics.concat(void_value_diagnostics(expression.operand, ctx, "an operand of `"
                + expression.operator
                + "`"));
        }
        return diagnostics;
    }
    if expression.variant == "Member" {
        // A bare-identifier member *object* is a receiver / namespace
        // position (`env.get(...)`, `Color.Red`, `process.run(...)`),
        // not a value use — do not route it through the E0808
        // function-as-value check below (a module that both defines
        // `fn env` and calls `env.get` would otherwise false-positive).
        // Non-identifier objects (`foo().bar`, `xs[0].field`) still
        // recurse so nested diagnostics surface.
        if expression.object != null {
            if expression.object.variant == "Identifier" {
                let receiver = expression.object;
                let mut entry = find_value_symbol(bindings, receiver.name);
                if entry == null {
                    entry = find_value_symbol(ctx.top_level, receiver.name);
                }
                if entry != null {
                    if strings_equal(entry.kind, "outer_local") {
                        return [make_nested_fn_capture_diagnostic(receiver.name, receiver.span)];
                    }
                    // SFN-543: the receiver resolved, so its declared type may
                    // prove the member absent -> E0015. In callee position the
                    // member is a method, owned by E0012.
                    if ctx.in_callee_position { return []; }
                    return unknown_field_diagnostics(expression, entry, ctx);
                }
                if is_builtin_member_root(receiver.name) { return []; }
                return [make_undefined_value_diagnostic(receiver.name, receiver.span)];
            }
        }
        return walk_expression(expression.object, ctx_with_expected_type(ctx, null));
    }
    if expression.variant == "Index" {
        let child_ctx = ctx_with_expected_type(ctx, null);
        let mut diagnostics = walk_expression(expression.sequence, child_ctx);
        diagnostics = diagnostics.concat(walk_expression(expression.index, child_ctx));
        return diagnostics;
    }
    if expression.variant == "Array" {
        let mut diagnostics: Diagnostic[] = [];
        let element_expected = _array_element_expected_type(ctx.expected_type);
        let mut index: int = 0;
        loop {
            if index >= expression.elements.length { break; }
            diagnostics = diagnostics.concat(walk_expression(expression.elements[index], ctx_with_expected_type(ctx, element_expected)));
            index += 1;
        }
        return diagnostics;
    }
    if expression.variant == "Object" {
        let mut diagnostics: Diagnostic[] = [];
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            diagnostics = diagnostics.concat(walk_expression(expression.fields[index].value, ctx_with_expected_type(ctx, null)));
            index += 1;
        }
        return diagnostics;
    }
    if expression.variant == "Struct" {
        let mut diagnostics: Diagnostic[] = [];
        let mut struct_name: string = "";
        if expression.type_name.length > 0 {
            struct_name = expression.type_name[expression.type_name.length - 1];
        }
        // A generic struct's field annotation (`_struct_field_expected_type`
        // below) returns the declaration's `T[]` verbatim, and `ctx.type_params`
        // here are the CALLER's, not the struct's — so the type-parameter gate
        // in `_array_element_class` would not fire on an unsubstituted `T[]`.
        // Skip E0310 entirely for a generic struct's literal, matching the
        // E0833 `generic_struct_names` precedent (SFN-910).
        let is_generic_struct = _string_list_has(ctx.generic_struct_names, struct_name);
        // SFN-1161. Capsule staging emits each module's `.sfn-asm` standalone,
        // deliberately order-independent — `build/runtime_objs.sfn` and
        // `main.sfn`'s `write_native_text_file_with_module_gated` header both
        // state the invariant, and the parallel emit fan-out plus the
        // source-only stage cache key depend on it. So a dependency module is
        // typechecked with no import context: an imported struct's *name* is
        // known (`_collect_imported_call_symbols` puts every import specifier
        // in `ctx.known_types`) but its *shape* is not.
        //
        // In that state this pass cannot render the fn-value verdict, and
        // guessing "reject" is what made a bare function name in an imported
        // struct's field fail the build. Defer instead: drop E0808 for that
        // one shape and let the pass that does have the shape decide —
        // `main.sfn`'s per-module compile for build/run/test, or
        // `check/engine.sfn` when the module is a named check entry. Both run
        // over the same module before any binary exists.
        //
        // Deferring, not disabling: the guards below keep every other
        // rejection intact, and the native resolve gate already defers to LLVM
        // lowering on the same grounds.
        // `imported_structs.length == 0` narrows the deferral to the pass it
        // exists for: capsule staging, which loads no import context at all.
        // Once a context IS loaded — the check engine for a named entry, or
        // the per-module compile — an unresolvable shape is a real miss, not
        // missing information, and keeps its normal verdict. That is what
        // preserves the pre-existing rejection for an aliased import
        // (`import { Verb as V }` registers `V` while the artifact declares
        // `Verb`, so the shape never resolves): loud as before, rather than
        // silently accepted forever.
        let no_import_context = ctx.imported_structs.length == 0;
        let shape_unresolvable = !_struct_shape_is_resolvable(expression.type_name, ctx);
        let name_is_imported = _struct_name_is_imported(expression.type_name, ctx);
        let defer_fn_value_verdict = no_import_context && shape_unresolvable
            && name_is_imported;
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            let field = expression.fields[index];
            let local_expected = _struct_field_expected_type(expression.type_name, field.name, ctx);
            let mut field_expected = local_expected;
            if field_expected == null {
                field_expected = _imported_struct_field_expected_type(expression.type_name, field.name, ctx);
            }
            let field_diagnostics = walk_expression(field.value, ctx_with_expected_type(ctx, field_expected));
            if defer_fn_value_verdict && field.value.variant == "Identifier" {
                diagnostics = diagnostics.concat(_without_code(field_diagnostics, "E0808"));
            } else { diagnostics = diagnostics.concat(field_diagnostics); }
            if !is_generic_struct {
                // `local_expected`, deliberately, not `field_expected`
                // (SFN-1161). `ctx.expected_type` is read in exactly two
                // places — `_array_element_expected_type` and the fn-value
                // gate — so routing an imported annotation only into
                // `ctx_with_expected_type` cannot raise anything but the
                // fn-value verdict this fix exists to correct. Passing it
                // here would additionally open E0310 on imported struct
                // fields, and `.sfn-asm` carries no struct type parameters,
                // so `is_generic_struct` above could not suppress an
                // unsubstituted `T[]` field on an imported `Box<T>`.
                diagnostics = diagnostics.concat(check_array_element_type(field.value, local_expected, ctx, "field `"
                    + field.name
                    + "`", field.name, _value_anchor_span(field.value)));
            }
            index += 1;
        }
        return diagnostics;
    }
    if expression.variant == "Lambda" {
        // Register the lambda's own parameters into the scope its body is
        // walked in, so a parameter used as a call target (or otherwise
        // resolved by name) is not falsely reported undefined (#1917). The
        // params start at `param_scope_start` (past the outer bindings) so a
        // parameter may shadow an enclosing name without tripping E0001, while
        // parameter-vs-parameter duplicates are still caught.
        let mut body_bindings: SymbolEntry[] = clone_bindings(bindings);
        if ctx.is_top_level {
            body_bindings = clone_bindings(ctx.top_level);
        }
        let default_bindings: SymbolEntry[] = clone_bindings(body_bindings);
        let param_scope_start = body_bindings.length;
        let mut diagnostics: Diagnostic[] = [];
        let mut _pp: int = 0;
        loop {
            if _pp >= expression.parameters.length { break; }
            let param = expression.parameters[_pp];
            let mut param_array: string = "";
            let mut param_prim: string = "";
            if param.type_annotation != null {
                param_array = declared_array_marker(param.type_annotation.text);
                param_prim = classify_declared_primitive(param.type_annotation.text);
            }
            let declared_struct = _declared_struct_annotation(param.type_annotation, body_bindings, ctx.type_params);
            let mut param_type: string = "";
            if param.type_annotation != null {
                param_type = param.type_annotation.text;
            }
            let registration = register_local_symbol(body_bindings, param.name, "parameter", param.span, param_scope_start, false, false, param_array, param_prim, declared_struct, param_type);
            body_bindings = registration.bindings;
            diagnostics = diagnostics.concat(registration.diagnostics);
            let default_ctx = ctx_with_bindings(ctx, default_bindings, param_scope_start);
            diagnostics = diagnostics.concat(walk_expression(param.default_value, ctx_with_expected_type(default_ctx, param.type_annotation)));
            diagnostics = diagnostics.concat(check_expected_primitive_type(param.default_value, param.type_annotation, default_bindings, "default for `"
                + param.name
                + "`", param.name, param.span));
            diagnostics = diagnostics.concat(check_object_literal_target(param.default_value, param.type_annotation, param.name, param.span, default_bindings));
            _pp += 1;
        }
        diagnostics = diagnostics.concat(walk_block_expressions(expression.body, ctx_enter_body(ctx, body_bindings, expression.return_type)));
        let mut lambda_span: SourceSpan? = null;
        let mut _lp: int = 0;
        loop {
            if _lp >= expression.parameters.length { break; }
            let parameter = expression.parameters[_lp];
            if lambda_span == null { lambda_span = parameter.span; }
            diagnostics = diagnostics.concat(check_bare_fn_type_annotation(parameter.type_annotation, parameter.name, parameter.span));
            diagnostics = diagnostics.concat(check_malformed_array_annotation(parameter.type_annotation, parameter.name, parameter.span));
            diagnostics = diagnostics.concat(check_unknown_type_annotation(parameter.type_annotation, parameter.name, parameter.span, ctx.known_types, ctx.type_params));
            diagnostics = diagnostics.concat(check_intersection_value_type_annotation(parameter.type_annotation, parameter.name, parameter.span));
            _lp += 1;
        }
        // A param-less lambda (`fn() -> (int) -> int`) has no parameter span
        // to anchor a return-type E0826 to; fall back to the body's opening
        // token so the diagnostic still renders with a source location.
        if lambda_span == null {
            if expression.body.tokens.length > 0 {
                let btok = expression.body.tokens[0];
                lambda_span = SourceSpan {
                    start_line: btok.line,
                    start_column: btok.column,
                    end_line: btok.line,
                    end_column: btok.column
                };
            }
        }
        diagnostics = diagnostics.concat(check_bare_fn_type_annotation(expression.return_type, "lambda", lambda_span));
        diagnostics = diagnostics.concat(check_malformed_array_annotation(expression.return_type, "lambda", lambda_span));
        diagnostics = diagnostics.concat(check_unknown_type_annotation(expression.return_type, "lambda", lambda_span, ctx.known_types, ctx.type_params));
        diagnostics = diagnostics.concat(check_intersection_value_type_annotation(expression.return_type, "lambda", lambda_span));
        return diagnostics;
    }
    if expression.variant == "Range" {
        let child_ctx = ctx_with_expected_type(ctx, null);
        let mut diagnostics = walk_expression(expression.start, child_ctx);
        diagnostics = diagnostics.concat(walk_expression(expression.end, child_ctx));
        return diagnostics;
    }
    if expression.variant == "Conditional" {
        // Ternary `cond ? then : else` (#1690) — recurse into all three
        // children so nested diagnostics (undefined symbols, parse-error
        // nodes, removed-keyword statements) inside any branch still fire.
        let mut diagnostics = walk_expression(expression.condition, ctx_with_expected_type(ctx, null));
        diagnostics = diagnostics.concat(walk_expression(expression.then_value, ctx));
        diagnostics = diagnostics.concat(walk_expression(expression.else_value, ctx));
        // #1715: constrain the condition to boolean and unify the two branch
        // types. Types are literal-inferred (#829 has no live inferencer), so
        // an un-inferable branch/condition is left unconstrained.
        let condition_type = _conditional_branch_type(expression.condition);
        let then_type = _conditional_branch_type(expression.then_value);
        let else_type = _conditional_branch_type(expression.else_value);
        diagnostics = diagnostics.concat(check_conditional_types(condition_type, then_type, else_type, expression.span));
        return diagnostics;
    }
    if expression.variant == "Assignment" {
        // Assignment `target <op> rhs` (#1627 Part D) — recurse into both
        // sides so diagnostics (undefined symbols, fn-value misuse, nested
        // parse-error nodes) in the lvalue and the rvalue still fire.
        let mut diagnostics = walk_expression(expression.target, ctx_with_expected_type(ctx, null));
        let rhs_expected = _assignment_expected_type(expression.target, ctx);
        diagnostics = diagnostics.concat(walk_expression(expression.rhs, ctx_with_expected_type(ctx, rhs_expected)));
        // E0310: `_assignment_expected_type` above stays `Identifier`-only on
        // purpose — widening it to `Member` targets would install
        // `ctx.expected_type` on the RHS of every `x.f = v` tree-wide,
        // affecting two unrelated consumers (the array-literal element
        // recursion above and `check_named_fn_value_compatibility`). Route
        // the Member-target array-element check through its own narrow path
        // instead (SFN-910).
        diagnostics = diagnostics.concat(check_array_element_assignment(expression, ctx));
        // SFN-812: `s.a = print(...)` / `arr[0] = print(...)` / `*p = print(...)`
        // compiled clean and dropped the store entirely — the complex-lvalue
        // arms of `statement_assignment.sfn` emit no store when the value
        // fails to lower. Reject the assignment here, at the source.
        diagnostics = diagnostics.concat(void_value_diagnostics(expression.rhs, ctx, "an assigned value"));
        return diagnostics;
    }
    if expression.variant == "Cast" {
        // A bare function identifier cast to a pointer (`<fn> as * u8` /
        // `<fn> as * fn (...)`) is a function-address materialization, not a
        // value-position misuse. Classify it DIRECTLY via `classify_fn_cast`
        // (E0808/E0809 per target) — do NOT recurse into the operand, because
        // the `Identifier` arm would wrongly emit E0808 for a perfectly valid
        // fn-address cast. #1627: Part A now structures every cast (including
        // bare-identifier operands), so this replaces the old text-based
        // `check_fn_reference_raw` cast path. Classification is
        // position-independent — it fires the same whether the cast is
        // top-level or buried in a call argument.
        // SFN-555: the cast target is the position where an unknown type used
        // to reach lowering as a bare `i8*` (lowercase) or an undeclared
        // `%Name*` that only `clang` rejected (capitalized).
        let cast_target_diags = check_unknown_type_annotation(expression.target_type, expression.target_type.text, expression.span, ctx.known_types, ctx.type_params);
        if expression.operand.variant == "Identifier" {
            let fn_entry = find_value_symbol(bindings, expression.operand.name);
            if fn_entry != null {
                if is_function_kind(fn_entry.kind) {
                    return cast_target_diags.concat(classify_fn_cast(expression.operand.name, expression.target_type.text, fn_entry, expression.span));
                }
            }
        }
        return cast_target_diags.concat(walk_expression(expression.operand, ctx_with_expected_type(ctx, null)));
    }
    if expression.variant == "Is" {
        // Type-guard `x is T` (#1753) — recurse into the operand so inner
        // diagnostics (undefined symbols, fn-value misuse, nested parse-error
        // nodes) still fire. The target type is a static type name, not an
        // expression, so there is nothing to walk there. Flow-sensitive
        // narrowing is applied at lowering via the `narrowed_variant`
        // machinery (the typecheck pass tracks names only — no type field).
        //
        // The target is deliberately NOT run through the unknown-type check
        // (E0013, SFN-555): `x is Text` names an enum VARIANT as often as a
        // type, and variant names are not in the type registry. Judging it
        // rejects the valid narrowing form.
        return walk_expression(expression.operand, ctx_with_expected_type(ctx, null));
    }
    if expression.variant == "TryOperator" {
        return walk_expression(expression.operand, ctx_with_expected_type(ctx, null));
    }
    // Concurrency nodes (issue #1082). Recurse into operands so inner
    // diagnostics still fire. `check_spawn_target` (SFN-1006, E0842) needs
    // only the callee's declared return type / known-ness, which the
    // resolver already has, so it runs unconditionally rather than only on a
    // `Lambda` operand. Await-on-non-future (E0814) and channel
    // send-mismatch (E0815) still need expression-type inference (#829,
    // out of scope) and ship as helpers exercised by
    // `concurrency_typecheck_test.sfn`.
    if expression.variant == "Spawn" {
        let mut diagnostics = walk_expression(expression.operand, ctx_with_expected_type(ctx, null));
        diagnostics = diagnostics.concat(check_spawn_target(expression, ctx));
        return diagnostics;
    }
    if expression.variant == "Await" {
        return walk_expression(expression.operand, ctx_with_expected_type(ctx, null));
    }
    if expression.variant == "Channel" {
        if expression.capacity == null { return []; }
        return walk_expression(expression.capacity, ctx_with_expected_type(ctx, null));
    }
    if expression.variant == "Parallel" {
        let mut diagnostics: Diagnostic[] = [];
        let mut index: int = 0;
        loop {
            if index >= expression.tasks.length { break; }
            diagnostics = diagnostics.concat(walk_expression(expression.tasks[index], ctx_with_expected_type(ctx, null)));
            index += 1;
        }
        return diagnostics;
    }
    if expression.variant == "Serve" {
        // SFN-29 (#1329): a `serve(...)` token sequence always parses to
        // `Expression.Serve`, but a `serve` that resolves to a user-defined
        // or imported function must be validated through the ordinary
        // call-site argument rules — so a bare function argument trips E0808
        // exactly as it would for any other call. This mirrors the lowering
        // gate in `llvm/expression_lowering/native/core.sfn`, which only
        // lowers builtin serve to `@sfn_serve` when no resolvable `serve` is
        // in scope. The bare builtin concurrency serve keeps its permissive
        // treatment (its handler is passed straight through to `@sfn_serve`).
        if _serve_resolves_to_user_fn(bindings) {
            let child_ctx = ctx_with_expected_type(ctx, null);
            let mut diagnostics = walk_expression(expression.handler, child_ctx);
            if expression.port != null {
                diagnostics = diagnostics.concat(walk_expression(expression.port, child_ctx));
            }
            diagnostics = diagnostics.concat(serve_argument_type_diagnostics(expression, bindings));
            return diagnostics;
        }
        let mut diagnostics: Diagnostic[] = [];
        if expression.handler.variant == "Identifier" {
            let handler = expression.handler;
            let mut entry = find_value_symbol(bindings, handler.name);
            if entry == null {
                entry = find_value_symbol(ctx.top_level, handler.name);
            }
            if entry == null {
                diagnostics.push(make_undefined_value_diagnostic(handler.name, handler.span));
            } else if strings_equal(entry.kind, "outer_local") {
                diagnostics.push(make_nested_fn_capture_diagnostic(handler.name, handler.span));
            }
        } else {
            diagnostics = diagnostics.concat(walk_expression(expression.handler, ctx_with_expected_type(ctx, null)));
        }
        if expression.port != null {
            diagnostics = diagnostics.concat(walk_expression(expression.port, ctx_with_expected_type(ctx, null)));
        }
        // A source-level function named `serve` may still reach this branch
        // when parser/effect disambiguation treats the spelling as builtin.
        // The primitive helper resolves the symbol directly and is a no-op
        // when no local signature exists.
        diagnostics = diagnostics.concat(serve_argument_type_diagnostics(expression, bindings));
        return diagnostics;
    }
    // A parser-originated diagnostic node (issue #1531): the parser emitted
    // this for syntax that must fail closed (e.g. the internal-only
    // `spawn:<type>` form). Surface it as a real error so `sfn check` exits
    // non-zero instead of silently dropping the statement.
    if expression.variant == "ParseError" {
        return [make_parse_error_diagnostic(expression.message, expression.span)];
    }
    // #1147: a bare identifier that resolves to a function used in value
    // position (not as a call target — those are handled in the Call arm)
    // is unsupported. The only way to materialize a function's address is
    // `<fn> as * u8` (#1146), which the parser degrades to a `Raw` node
    // (handled below), so a structured `Identifier` here is always an
    // unsupported value use (e.g. `let f = worker;`, `take(worker)`).
    if expression.variant == "Identifier" {
        let mut entry = find_value_symbol(bindings, expression.name);
        // Top-level initializer walks use the sequential declaration scope in
        // `bindings`; imports and forward declarations live in the pre-collected
        // resolution scope. Consult it on a miss so prelude aliases such as
        // `let runtime_sleep_fn = sfn_sleep` resolve their imported value.
        if entry == null {
            entry = find_value_symbol(ctx.top_level, expression.name);
        }
        if entry == null {
            return [make_undefined_value_diagnostic(expression.name, expression.span)];
        }
        if entry != null {
            // A nested `fn` body resolving a name to an enclosing data local
            // (tagged `"outer_local"` by `_build_nested_fn_scope`) is an
            // illegal capture (SFEP-0042, E0421) — reported here instead of
            // being silently accepted as a value reference.
            if strings_equal(entry.kind, "outer_local") {
                return [make_nested_fn_capture_diagnostic(expression.name, expression.span)];
            }
            if ctx.expected_type != null {
                let expected = parse_fn_type_text(ctx.expected_type.text);
                if expected.ok {
                    if strings_equal(entry.kind, "import") || strings_equal(entry.kind, "prelude") {
                        // Import/prelude placeholders do not carry a complete
                        // callable signature. Fail closed until parameter,
                        // generic, async, and ABI metadata cross this boundary.
                        //
                        // E0843, not E0808 (SFN-1161): the restriction here is
                        // missing import metadata, not the C ABI, so the
                        // generic "take its address with `as * u8`" advice
                        // sent readers to an unrelated escape hatch.
                        return [make_imported_fn_value_diagnostic(expression.name, expression.span)];
                    }
                }
            }
            if is_function_kind(entry.kind) {
                if strings_equal(entry.kind, "function") {
                    // SFN-108: a nested / local `fn` lifts to a real top-level
                    // symbol and carries the same signature metadata as a
                    // top-level one, so it is materializable as a value on the
                    // identical path (SFEP-0042 Sub-issue B). Every remaining
                    // rejection below — generic, async, arity/type/effect
                    // mismatch, aggregate ABI — is enforced by
                    // `check_named_fn_value_compatibility` for both kinds.
                    if entry.is_top_level_function || entry.is_nested_function {
                        if ctx.expected_type != null {
                            let expected = parse_fn_type_text(ctx.expected_type.text);
                            if expected.ok {
                                return check_named_fn_value_compatibility(expression.name, entry, ctx.expected_type.text, expression.span, _struct_type_names(ctx));
                            }
                        }
                    }
                }
                return [make_fn_value_position_diagnostic(expression.name, expression.span)];
            }
        }
        return [];
    }
    // Blanket fail-closed backstop for effect-opaque `Raw` nodes
    // (#1627 Part F / #1743). `check_fn_reference_raw` first classifies the
    // residual function-reference spellings (`& <fn>` → E0808, a defensive
    // `<fn> as <type>` → E0808/E0809); after Part A/B those normally structure
    // into `Cast`/`Unary`, so this is the last-resort path. Any non-empty Raw
    // that is NOT a recognized fn-reference is genuinely unanalyzable — every
    // valid construct has been structured (casts, prefix `*`/`&`, assignment,
    // typed channels) — so it fails closed with E0818 rather than reaching
    // codegen effect-blind. Empty Raw is clean; match-arm patterns are exempt
    // upstream (`walk_match_pattern`) and never reach this arm.
    if expression.variant == "Raw" {
        let fn_diags = check_fn_reference_raw(expression.text, bindings, expression.span);
        if fn_diags.length > 0 { return fn_diags; }
        // SFN-442: classify two familiar-but-unsupported shapes (a value-position
        // `if`, a character literal) with dedicated E-codes before the generic
        // E0818 backstop, so they carry an actionable rewrite instead of the
        // opaque "unstructured expression" message.
        let if_diags = check_value_if_raw(expression.text, expression.span);
        if if_diags.length > 0 { return if_diags; }
        let char_diags = check_char_literal_raw(expression.text, expression.span);
        if char_diags.length > 0 { return char_diags; }
        return check_unanalyzable_raw(expression.text, expression.span);
    }
    return [];
}

fn _call_argument_expected_type(expression: Expression, index: int, ctx: TypeckCtx) -> TypeAnnotation? {
    if expression.callee == null { return null; }
    if expression.callee.variant != "Identifier" { return null; }
    let mut entry = find_value_symbol(ctx.bindings, expression.callee.name);
    if entry == null {
        entry = find_value_symbol(ctx.top_level, expression.callee.name);
    }
    if entry == null { return null; }
    if is_function_kind(entry.kind) {
        if index >= entry.function_parameter_types.length { return null; }
        return TypeAnnotation {
            text: entry.function_parameter_types[index]
        };
    }
    if entry.declared_type.length == 0 { return null; }
    let fn_type = parse_fn_type_text(entry.declared_type);
    if !fn_type.ok { return null; }
    if index >= fn_type.param_types.length { return null; }
    return TypeAnnotation { text: fn_type.param_types[index] };
}

fn _assignment_expected_type(target: Expression, ctx: TypeckCtx) -> TypeAnnotation? {
    if target.variant != "Identifier" { return null; }
    let mut entry = find_value_symbol(ctx.bindings, target.name);
    if entry == null {
        entry = find_value_symbol(ctx.top_level, target.name);
    }
    if entry == null { return null; }
    if entry.declared_type.length == 0 { return null; }
    return TypeAnnotation { text: entry.declared_type };
}

fn _array_element_expected_type(expected: TypeAnnotation?) -> TypeAnnotation? {
    if expected == null { return null; }
    let text = trim_text(expected.text);
    if !ends_with(text, "[]") { return null; }
    let mut element = trim_text(substring(text, 0, text.length - 2));
    if element.length >= 2 {
        if substring(element, 0, 1) == "(" {
            if substring(element, element.length - 1, element.length) == ")" {
                element = trim_text(substring(element, 1, element.length - 1));
            }
        }
    }
    return TypeAnnotation { text: element };
}

// Walk a match-arm pattern for diagnostics, exempting the `Raw` shorthand
// destructure form from the blanket E0818 fail-closed backstop (#1743).
// Colon-less shorthand patterns (e.g. `Result.Ok { value }`) legitimately
// degrade to `Expression.Raw` — they are bindings, not unstructured
// *expressions*, and carry no effects, so they must not trip E0818. Their
// bindings are registered separately via `register_match_pattern_bindings`.
// Structured patterns (Struct/Identifier) are still walked normally.
fn walk_match_pattern(pattern: Expression?, ctx: TypeckCtx) -> Diagnostic[] {
    if pattern == null { return []; }
    if pattern.variant == "Raw" { return []; }
    // A bare identifier pattern introduces a binding (or is the `_`
    // wildcard); it is never a read from the surrounding value scope.
    if pattern.variant == "Identifier" { return []; }
    return walk_expression(pattern, ctx);
}
