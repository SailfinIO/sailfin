// compiler/capsules/analyzer/src/typecheck/statement_checks.sfn
//
// Statement-level scope and type checking: the per-statement rules that
// drive the whole program walk.
import { Program, Statement } from "sfn/syntax";
import { Token } from "sfn/syntax";

import { ImportSymbolTable } from "../effect_imports";
import { Diagnostic } from "../typecheck_types";
import {
    check_bare_fn_type_annotation,
    check_malformed_array_annotation,
    check_unknown_type_annotation,
    classify_declared_primitive,
    declared_array_marker,
    type_parameter_names
} from "../typecheck_types/annotation_shape_checks";
import {
    check_enum_variants,
    check_extern_signature,
    check_extern_var,
    check_function_signature,
    check_interface_members,
    check_struct_fields,
    check_struct_methods,
    detect_removed_ai_keyword,
    make_removed_keyword_diagnostic,
    make_unparseable_statement_diagnostic
} from "../typecheck_types/declaration_and_statement_checks";
import {
    channel_element_kind,
    check_uninferable_generic_constructor,
    make_task_array_element_marker,
    task_array_element_kind
} from "../typecheck_types/expr_type_rules";
import { check_type_parameters } from "../typecheck_types/generic_bounds";
import { check_struct_implements_interfaces } from "../typecheck_types/interface_and_generics";
import {
    ScopeResult,
    SymbolEntry,
    append_symbol,
    register_local_function_symbol,
    register_local_symbol
} from "../typecheck_types/symbol_table_and_raw_exprs";
import {
    check_interface_field_members,
    check_intersection_value_type_annotation,
    check_object_literal_target
} from "../typecheck_types/value_and_object_checks";
import { check_array_element_type } from "./array_element_rules";
import { void_value_diagnostics } from "./call_signature";
import {
    TypeckCtx,
    ctx_with_bindings,
    ctx_with_expected_type,
    ctx_with_type_params,
    make_typeck_ctx
} from "./context";
import { walk_expression, walk_match_pattern } from "./expression_walk";
import {
    _validate_main_signature,
    check_block,
    check_function_body,
    check_nested_function_body
} from "./function_scopes";
import { register_match_pattern_bindings } from "./patterns";
import { check_expected_primitive_type } from "./primitive_rules";
import {
    _decl_type_params,
    _declared_struct_annotation,
    _find_symbol_with_kind
} from "./symbols";

fn check_program_scopes(program: Program, interfaces: Statement[], imports: ImportSymbolTable, available_imports: ImportSymbolTable, top_level: SymbolEntry[], generic_struct_names: string[], known_types: string[], imported_structs: Statement[]) -> Diagnostic[] {
    let mut bindings: SymbolEntry[] = [];
    let mut diagnostics: Diagnostic[] = [];

    for statement in program.statements {
        let result = check_statement(statement, make_typeck_ctx(bindings, imports, available_imports, interfaces, program.statements, top_level, true, generic_struct_names, known_types, imported_structs));
        bindings = result.bindings;
        let mut _ci: int = 0;
        loop {
            if _ci >= result.diagnostics.length { break; }
            diagnostics.push(result.diagnostics[_ci]);
            _ci += 1;
        }
    }

    return diagnostics;
}

// `scope_start` carries the index that separates inherited (outer-scope)
// bindings from the current scope's own entries. Inner-block callers compute
// it as the parent-bindings length after `clone_bindings`, so a `let x` in a
// nested block can shadow an enclosing `let x` without tripping E0001. Top-
// level and recursive same-frame callers pass it through unchanged.
//
// `top_level` (#812) is the resolution-only scope of every top-level
// declaration plus the program's import-specifier names. It seeds
// function/method/test body scopes (via `check_function_body` /
// `seed_parameter_scope` and the `TestDeclaration` branch) so an E0420
// callee lookup resolves sibling top-level functions and imports
// regardless of source order. It is never re-registered, so it does not
// affect duplicate detection.
fn check_statement(statement: Statement, ctx: TypeckCtx) -> ScopeResult {
    let bindings = ctx.bindings;
    let interfaces = ctx.interfaces;
    let scope_start = ctx.scope_start;
    let imports = ctx.imports;
    let top_level = ctx.top_level;
    let is_top_level = ctx.is_top_level;
    let in_function_body = ctx.in_function_body;
    let enclosing_return_type = ctx.enclosing_return_type;
    if statement.variant == "VariableDeclaration" {
        // A `let x: Channel<T> = ...` binding records its element kind so
        // `check_channel_send` can enforce element-type on a later `x.send(v)`
        // (#1942). Every other binding records "". This is the primary
        // (plain-function-body / top-level) path; the lambda-body twin lives
        // in `walk_block_expressions`.
        let mut elem_kind: string = "";
        if statement.type_annotation != null {
            let resolved = channel_element_kind(statement.type_annotation.text);
            if resolved != null { elem_kind = resolved; }
            // A `Task<T>[]` handle array records its element kind under a
            // `taskarr:` marker so `push_spawn_handle_diagnostics` can enforce
            // homogeneity (E0836) on a later `.push(spawn ...)` (SFEP-0055).
            if elem_kind.length == 0 {
                let task_kind = task_array_element_kind(statement.type_annotation.text);
                if task_kind != null {
                    elem_kind = make_task_array_element_marker(task_kind);
                }
            }
            if elem_kind.length == 0 {
                elem_kind = declared_array_marker(statement.type_annotation.text);
            }
        }
        // An unannotated `let mut hs = []` bakes the array's LLVM element type
        // as `double` (empty literal, no inference target); tag it "empty_array"
        // so `push_spawn_handle_diagnostics` can reject a later `.push(spawn ...)`
        // before a future pointer is stored through that double slot (E0823,
        // SFN-386). The lambda-body twin lives in `walk_block_expressions`.
        if elem_kind.length == 0 {
            if statement.type_annotation == null {
                let init = statement.initializer;
                if init != null && strings_equal(init.variant, "Array") {
                    if init.elements.length == 0 { elem_kind = "empty_array"; } else {
                        elem_kind = "array";
                    }
                }
            }
        }
        let mut decl_prim: string = "";
        if statement.type_annotation != null {
            decl_prim = classify_declared_primitive(statement.type_annotation.text);
        }
        let mut declared_struct = _declared_struct_annotation(statement.type_annotation, bindings, ctx.type_params);
        // The source-wide top-level collection resolves annotations against
        // forward declarations. Preserve that proof when the sequential
        // statement walk re-registers this global for initializer analysis.
        if is_top_level {
            let top_variable = _find_symbol_with_kind(top_level, statement.name, "variable");
            if top_variable != null {
                declared_struct = top_variable.declared_struct;
            }
        }
        let mut declared_type: string = "";
        if statement.type_annotation != null {
            declared_type = statement.type_annotation.text;
        }
        let registration = register_local_symbol(bindings, statement.name, "variable", statement.span, scope_start, false, false, elem_kind, decl_prim, declared_struct, declared_type);
        let walk_diags = walk_expression(statement.initializer, ctx_with_expected_type(ctx, statement.type_annotation));
        let annotation_diags = check_bare_fn_type_annotation(statement.type_annotation, statement.name, statement.span);
        let array_diags = check_malformed_array_annotation(statement.type_annotation, statement.name, statement.span);
        let unknown_diags = check_unknown_type_annotation(statement.type_annotation, statement.name, statement.span, ctx.known_types, ctx.type_params);
        let intersection_diags = check_intersection_value_type_annotation(statement.type_annotation, statement.name, statement.span);
        let object_literal_diags = check_object_literal_target(statement.initializer, statement.type_annotation, statement.name, statement.span, top_level);
        let uninferable_ctor_diags = check_uninferable_generic_constructor(statement, ctx.generic_struct_names);
        let mut primitive_bindings = bindings;
        if is_top_level { primitive_bindings = top_level; }
        let primitive_diags = check_expected_primitive_type(statement.initializer, statement.type_annotation, primitive_bindings, "initializer for `"
            + statement.name
            + "`", statement.name, statement.initializer_span);
        let array_element_diags = check_array_element_type(statement.initializer, statement.type_annotation, ctx, "initializer for `"
            + statement.name
            + "`", statement.name, statement.initializer_span);
        // SFN-812: lowering already fails closed on a void initializer
        // (E1002), but only after the whole module has lowered. Reject it at
        // `sfn check` so the error names the callee rather than the slot type.
        let void_diags = void_value_diagnostics(statement.initializer, ctx, "the initializer for `"
            + statement.name
            + "`");
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: registration.diagnostics.concat(walk_diags).concat(annotation_diags).concat(array_diags).concat(unknown_diags).concat(intersection_diags).concat(object_literal_diags).concat(uninferable_ctor_diags).concat(primitive_diags).concat(array_element_diags).concat(void_diags)
        };
    }
    if statement.variant == "FunctionDeclaration" {
        // Nested / local function declaration (SFEP-0042). Its name is already
        // block-hoisted into `ctx.bindings` by `check_block`, so do NOT
        // re-register (that would double-report `E0001`); check its signature
        // and its body under the non-capturing nested scope so a reference to
        // an enclosing local surfaces as `E0421`.
        if in_function_body {
            let mut nested_diags = check_function_signature(statement.signature, interfaces, top_level, ctx.known_types, ctx.type_params);
            let nested_body_diags = check_nested_function_body(statement.signature, statement.body, ctx);
            let mut _cin: int = 0;
            loop {
                if _cin >= nested_body_diags.length { break; }
                nested_diags.push(nested_body_diags[_cin]);
                _cin += 1;
            }
            return ScopeResult {
                bindings: bindings,
                diagnostics: nested_diags
            };
        }
        let mut registration = register_local_function_symbol(bindings, statement.signature, "function", scope_start);
        if registration.diagnostics.length == 0 {
            let last = registration.bindings.length - 1;
            registration.bindings[last].is_top_level_function = true;
        }
        let mut diagnostics = registration.diagnostics;
        let _sig_diags = check_function_signature(statement.signature, interfaces, top_level, ctx.known_types, ctx.type_params);
        let mut _ci: int = 0;
        loop {
            if _ci >= _sig_diags.length { break; }
            diagnostics.push(_sig_diags[_ci]);
            _ci += 1;
        }
        let _main_diags = _validate_main_signature(statement.signature);
        let mut _cim: int = 0;
        loop {
            if _cim >= _main_diags.length { break; }
            diagnostics.push(_main_diags[_cim]);
            _cim += 1;
        }
        let function_diagnostics = check_function_body(statement.signature, statement.body, ctx);
        let mut _ci2: int = 0;
        loop {
            if _ci2 >= function_diagnostics.length { break; }
            diagnostics.push(function_diagnostics[_ci2]);
            _ci2 += 1;
        }
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "ExternFunctionDeclaration" {
        let registration = register_local_function_symbol(bindings, statement.signature, "extern function", scope_start);
        let mut diagnostics = registration.diagnostics;
        let _sig_diags = check_extern_signature(statement.signature);
        let mut _ci: int = 0;
        loop {
            if _ci >= _sig_diags.length { break; }
            diagnostics.push(_sig_diags[_ci]);
            _ci += 1;
        }
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "ExternVarDeclaration" {
        let registration = register_local_symbol(bindings, statement.name, "extern variable", statement.name_span, scope_start);
        let mut diagnostics = registration.diagnostics;
        let _var_diags = check_extern_var(statement.name, statement.type_annotation);
        let mut _ci: int = 0;
        loop {
            if _ci >= _var_diags.length { break; }
            diagnostics.push(_var_diags[_ci]);
            _ci += 1;
        }
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "StructDeclaration" {
        let registration = register_local_symbol(bindings, statement.name, "struct", statement.name_span, scope_start);
        let mut diagnostics = registration.diagnostics;
        let _tp_diags = check_type_parameters(statement.type_parameters, interfaces, top_level);
        let mut _ci: int = 0;
        loop {
            if _ci >= _tp_diags.length { break; }
            diagnostics.push(_tp_diags[_ci]);
            _ci += 1;
        }
        let _sf_diags = check_struct_fields(statement.fields, ctx.known_types, _decl_type_params(ctx, statement.type_parameters));
        let mut _ci2: int = 0;
        loop {
            if _ci2 >= _sf_diags.length { break; }
            diagnostics.push(_sf_diags[_ci2]);
            _ci2 += 1;
        }
        let _sm_diags = check_struct_methods(statement.methods, interfaces, top_level, ctx.known_types, _decl_type_params(ctx, statement.type_parameters));
        let mut _ci3: int = 0;
        loop {
            if _ci3 >= _sm_diags.length { break; }
            diagnostics.push(_sm_diags[_ci3]);
            _ci3 += 1;
        }
        let _si_diags = check_struct_implements_interfaces(statement, interfaces);
        let mut _ci4: int = 0;
        loop {
            if _ci4 >= _si_diags.length { break; }
            diagnostics.push(_si_diags[_ci4]);
            _ci4 += 1;
        }
        let method_ctx = ctx_with_type_params(ctx, type_parameter_names(statement.type_parameters));
        let mut index: int = 0;
        loop {
            if index >= statement.methods.length { break; }
            let method = statement.methods[index];
            let _mb_diags = check_function_body(method.signature, method.body, method_ctx);
            let mut _ci5: int = 0;
            loop {
                if _ci5 >= _mb_diags.length { break; }
                diagnostics.push(_mb_diags[_ci5]);
                _ci5 += 1;
            }
            index += 1;
        }
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "EnumDeclaration" {
        let registration = register_local_symbol(bindings, statement.name, "enum", statement.name_span, scope_start);
        let mut diagnostics = registration.diagnostics;
        let _tp_diags = check_type_parameters(statement.type_parameters, interfaces, top_level);
        let mut _ci: int = 0;
        loop {
            if _ci >= _tp_diags.length { break; }
            diagnostics.push(_tp_diags[_ci]);
            _ci += 1;
        }
        let _ev_diags = check_enum_variants(statement.variants, ctx.known_types, _decl_type_params(ctx, statement.type_parameters));
        let mut _ci2: int = 0;
        loop {
            if _ci2 >= _ev_diags.length { break; }
            diagnostics.push(_ev_diags[_ci2]);
            _ci2 += 1;
        }
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "InterfaceDeclaration" {
        let registration = register_local_symbol(bindings, statement.name, "interface", statement.name_span, scope_start);
        let mut diagnostics = registration.diagnostics;
        let _tp_diags = check_type_parameters(statement.type_parameters, interfaces, top_level);
        let mut _ci: int = 0;
        loop {
            if _ci >= _tp_diags.length { break; }
            diagnostics.push(_tp_diags[_ci]);
            _ci += 1;
        }
        let _im_diags = check_interface_members(statement.members, interfaces, top_level, ctx.known_types, _decl_type_params(ctx, statement.type_parameters));
        let mut _ci2: int = 0;
        loop {
            if _ci2 >= _im_diags.length { break; }
            diagnostics.push(_im_diags[_ci2]);
            _ci2 += 1;
        }
        let _fm_diags = check_interface_field_members(statement.field_members);
        let mut _ci3: int = 0;
        loop {
            if _ci3 >= _fm_diags.length { break; }
            diagnostics.push(_fm_diags[_ci3]);
            _ci3 += 1;
        }
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "TestDeclaration" {
        let registration = register_local_symbol(bindings, statement.name, "test", statement.name_span, scope_start);
        let mut diagnostics = registration.diagnostics;
        let _blk_diags = check_block(statement.body, ctx_with_bindings(ctx, top_level, scope_start));
        let mut _ci: int = 0;
        loop {
            if _ci >= _blk_diags.length { break; }
            diagnostics.push(_blk_diags[_ci]);
            _ci += 1;
        }
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "WithStatement" {
        let mut diagnostics: Diagnostic[] = [];
        let mut clause_index: int = 0;
        loop {
            if clause_index >= statement.clauses.length { break; }
            diagnostics = diagnostics.concat(walk_expression(statement.clauses[clause_index].expression, ctx));
            clause_index += 1;
        }
        diagnostics = diagnostics.concat(check_block(statement.body, ctx_with_bindings(ctx, bindings, scope_start)));
        return ScopeResult { bindings: bindings, diagnostics: diagnostics };
    }
    if statement.variant == "ForStatement" {
        let iter_diags = walk_expression(statement.clause.iterable, ctx);
        let loop_bindings = register_match_pattern_bindings(statement.clause.target, bindings);
        let body_diags = check_block(statement.body, ctx_with_bindings(ctx, loop_bindings, scope_start));
        return ScopeResult {
            bindings: bindings,
            diagnostics: iter_diags.concat(body_diags)
        };
    }
    if statement.variant == "LoopStatement" {
        return ScopeResult {
            bindings: bindings,
            diagnostics: check_block(statement.body, ctx_with_bindings(ctx, bindings, scope_start))
        };
    }
    if statement.variant == "MatchStatement" {
        let mut diagnostics = walk_expression(statement.expression, ctx);
        let mut index: int = 0;
        loop {
            if index >= statement.cases.length { break; }
            let case = statement.cases[index];
            diagnostics = diagnostics.concat(walk_match_pattern(case.pattern, ctx));
            let arm_bindings = register_match_pattern_bindings(case.pattern, bindings);
            let arm_ctx = ctx_with_bindings(ctx, arm_bindings, scope_start);
            diagnostics = diagnostics.concat(walk_expression(case.guard, arm_ctx));
            let _blk_diags = check_block(case.body, arm_ctx);
            let mut _ci: int = 0;
            loop {
                if _ci >= _blk_diags.length { break; }
                diagnostics.push(_blk_diags[_ci]);
                _ci += 1;
            }
            index += 1;
        }
        return ScopeResult { bindings: bindings, diagnostics: diagnostics };
    }
    if statement.variant == "IfStatement" {
        let mut diagnostics = walk_expression(statement.condition, ctx);
        diagnostics = diagnostics.concat(check_block(statement.then_block, ctx_with_bindings(ctx, bindings, scope_start)));
        if statement.else_branch != null {
            let branch = statement.else_branch;
            if branch.body != null {
                let _blk_diags = check_block(branch.body, ctx_with_bindings(ctx, bindings, scope_start));
                let mut _ci: int = 0;
                loop {
                    if _ci >= _blk_diags.length { break; }
                    diagnostics.push(_blk_diags[_ci]);
                    _ci += 1;
                }
            }
            if branch.statement != null {
                let result = check_statement(branch.statement, ctx_with_bindings(ctx, bindings, scope_start));
                let mut _ci2: int = 0;
                loop {
                    if _ci2 >= result.diagnostics.length { break; }
                    diagnostics.push(result.diagnostics[_ci2]);
                    _ci2 += 1;
                }
            }
        }
        return ScopeResult { bindings: bindings, diagnostics: diagnostics };
    }
    if statement.variant == "BlockStatement" {
        return ScopeResult {
            bindings: bindings,
            diagnostics: check_block(statement.body, ctx_with_bindings(ctx, bindings, scope_start))
        };
    }
    // `routine { ... }` is a block scope like any other (LoopStatement/
    // BlockStatement shaped, ast.sfn); descend into its body so its statements
    // are type/effect-checked and binding-scoped — without this, a `routine`
    // body bypassed the checker entirely and its `spawn`/handle-array defects
    // (E0823, SFN-386) surfaced only as invalid IR at build time.
    if statement.variant == "RoutineStatement" {
        return ScopeResult {
            bindings: bindings,
            diagnostics: check_block(statement.body, ctx_with_bindings(ctx, bindings, scope_start))
        };
    }
    if statement.variant == "TryStatement" {
        let mut diagnostics = check_block(statement.try_block, ctx_with_bindings(ctx, bindings, scope_start));
        if statement.catch_block != null {
            let mut catch_bindings = bindings;
            if statement.catch_name != null {
                catch_bindings = append_symbol(catch_bindings, statement.catch_name, "variable", null);
            }
            diagnostics = diagnostics.concat(check_block(statement.catch_block, ctx_with_bindings(ctx, catch_bindings, scope_start)));
        }
        if statement.finally_block != null {
            diagnostics = diagnostics.concat(check_block(statement.finally_block, ctx_with_bindings(ctx, bindings, scope_start)));
        }
        return ScopeResult { bindings: bindings, diagnostics: diagnostics };
    }
    if statement.variant == "TypeAliasDeclaration" {
        let registration = register_local_symbol(bindings, statement.name, "type", statement.name_span, scope_start);
        let mut diagnostics = registration.diagnostics;
        let _tp_diags = check_type_parameters(statement.type_parameters, interfaces, top_level);
        let mut _ci: int = 0;
        loop {
            if _ci >= _tp_diags.length { break; }
            diagnostics.push(_tp_diags[_ci]);
            _ci += 1;
        }
        diagnostics = diagnostics.concat(check_bare_fn_type_annotation(statement.aliased_type, statement.name, statement.name_span));
        diagnostics = diagnostics.concat(check_malformed_array_annotation(statement.aliased_type, statement.name, statement.name_span));
        diagnostics = diagnostics.concat(check_unknown_type_annotation(statement.aliased_type, statement.name, statement.name_span, ctx.known_types, _decl_type_params(ctx, statement.type_parameters)));
        diagnostics = diagnostics.concat(check_intersection_value_type_annotation(statement.aliased_type, statement.name, statement.name_span));
        return ScopeResult {
            bindings: registration.bindings,
            diagnostics: diagnostics
        };
    }
    if statement.variant == "ExpressionStatement" {
        return ScopeResult {
            bindings: bindings,
            diagnostics: walk_expression(statement.expression, ctx)
        };
    }
    if statement.variant == "ThrowStatement" {
        return ScopeResult {
            bindings: bindings,
            diagnostics: walk_expression(statement.expression, ctx)
        };
    }
    if statement.variant == "ReturnStatement" {
        let return_diags = walk_expression(statement.expression, ctx_with_expected_type(ctx, enclosing_return_type));
        // A `return { ... }` is classified against the enclosing function's
        // declared return type (#1904). Gate on `in_function_body`, not
        // `!is_top_level`: a `return` in a top-level nested block (`if`/`with`/
        // `{}`) is `!is_top_level` yet has no enclosing function, so its
        // `enclosing_return_type` is absent and the un-inferable branch must
        // not fire there.
        if !in_function_body {
            return ScopeResult {
                bindings: bindings,
                diagnostics: return_diags
            };
        }
        let object_literal_diags = check_object_literal_target(statement.expression, enclosing_return_type, "return", statement.span, top_level);
        let primitive_diags = check_expected_primitive_type(statement.expression, enclosing_return_type, bindings, "return value", "return", statement.span);
        // SFN-812: `return print(x);` returns nothing to the caller, which
        // then reads a fabricated value from the slot.
        let void_diags = void_value_diagnostics(statement.expression, ctx, "a returned value");
        return ScopeResult {
            bindings: bindings,
            diagnostics: return_diags.concat(object_literal_diags).concat(primitive_diags).concat(void_diags)
        };
    }
    if statement.variant == "Unknown" {
        let keyword = detect_removed_ai_keyword(statement.text);
        if keyword.length > 0 {
            return ScopeResult {
                bindings: bindings,
                diagnostics: [make_removed_keyword_diagnostic(keyword)]
            };
        }
        // A nested (block-level) unparseable statement must fail closed: the
        // top-level `Unknown` walk in `tools/check.sfn` (E0500) covers only
        // `program.statements`, so a `Statement.Unknown` produced inside a
        // block by `parse_unknown_statement` would otherwise be dropped with
        // no diagnostic and zero effects (#1691). Gate on `is_top_level` so we
        // never double-fire with E0500 at top level, and reach here only after
        // the E0410 check above so we never double-fire with it.
        if !is_top_level {
            let mut anchor: Token? = null;
            let mut near: string = "";
            if statement.tokens.length > 0 {
                anchor = statement.tokens[0];
                near = " near `" + statement.tokens[0].lexeme + "`";
            }
            // When the parser already abandoned this node with a precise parse
            // code (a committed declaration production minting `E05xx`, e.g. a
            // malformed nested `let` -> `E0504`, SFN-384), surface that instead
            // of the generic `E0819` so the diagnostic names the real defect.
            if statement.code.length > 0 {
                return ScopeResult {
                    bindings: bindings,
                    diagnostics: [Diagnostic {
                        code: statement.code, severity: "error", message: statement.message, file_path: "", primary: anchor, suggestion: null
                    }]
                };
            }
            return ScopeResult {
                bindings: bindings,
                diagnostics: [make_unparseable_statement_diagnostic(anchor, near)]
            };
        }
        return ScopeResult { bindings: bindings, diagnostics: [] };
    }
    return ScopeResult { bindings: bindings, diagnostics: [] };
}
