// compiler/capsules/analyzer/src/typecheck/try_and_conditional.sfn
//
// Type rules for the `?` operator and conditional expressions —
// result-type derivation and branch compatibility.
import {
    Block,
    ElseBranch,
    Expression,
    MatchCase,
    ObjectField,
    Parameter,
    SourceSpan,
    Statement,
    WithClause
} from "sfn/syntax";

import { Diagnostic } from "../typecheck_types";
import {
    make_conditional_branch_mismatch_diagnostic,
    make_conditional_non_boolean_condition_diagnostic,
    make_try_error_type_mismatch_diagnostic,
    make_try_non_result_fn_diagnostic,
    make_try_non_result_operand_diagnostic,
    make_try_value_shadowing_diagnostic,
    result_type_arguments,
    type_is_result
} from "../typecheck_types/expr_type_rules";
import { SymbolEntry } from "../typecheck_types/symbol_table_and_raw_exprs";
import { is_identifier_char } from "../typecheck_types/text_utils";
import { register_match_pattern_bindings } from "./patterns";

// `?` operator (TryOperator) type rules — issue #833, epic #371 (R.3).
// See `typecheck_types/expr_type_rules.sfn` for `type_is_result` / `result_type_arguments`
// and the E0810–E0812 factories. `operand_type` is the type of the `?`
// operand; `enclosing_return_type` is the declared return type of the
// function the `?` appears in (null when the function declares no return
// type). Rules are applied per the proposal §Type rules:
//   1. operand must be `Result<T, E>`            -> E0810
//   2. enclosing fn must return `Result<U, F>`   -> E0811
//   3. `E` must equal `F` exactly (no coercion)  -> E0812
// Rules 1 and 2 are independent, so a site that violates both reports
// both; rule 3 only applies once both sides are confirmed `Result` (else
// there is no error type to compare and rules 1/2 already fired).
//
// Type representation: types are plain strings (#829). There is no
// expression-type inferencer in the checker, so these rules are driven by
// `result_question_typecheck_test.sfn` against explicit type strings;
// live-walk wiring waits on operand-type inference (a larger workstream).
fn check_try_operator(operand_type: string, enclosing_return_type: string?, span: SourceSpan?) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];

    let operand_is_result = type_is_result(operand_type);
    if !operand_is_result {
        diagnostics.push(make_try_non_result_operand_diagnostic(operand_type, span));
    }

    if enclosing_return_type == null {
        diagnostics.push(make_try_non_result_fn_diagnostic("void", span));
        return diagnostics;
    }
    if !type_is_result(enclosing_return_type) {
        diagnostics.push(make_try_non_result_fn_diagnostic(enclosing_return_type, span));
        return diagnostics;
    }

    if operand_is_result {
        let operand_args = result_type_arguments(operand_type);
        let fn_args = result_type_arguments(enclosing_return_type);
        if !strings_equal(operand_args[1], fn_args[1]) {
            diagnostics.push(make_try_error_type_mismatch_diagnostic(operand_args[1], fn_args[1], span));
        }
    }

    return diagnostics;
}

// The unwrapped success type of a `?` operand — rule 4. Returns the `T`
// of a `Result<T, E>` operand, or null when the operand is not a `Result`
// (rule 1 reports that error separately via `check_try_operator`).
fn try_operator_result_type(operand_type: string) -> string? {
    if !type_is_result(operand_type) { return null; }
    return result_type_arguments(operand_type)[0];
}

// E0841 (SFN-901) — reject the `?`-desugar `value`-shadowing hazard. The
// emit-stage desugar (`emit_native_desugar_try.sfn`) rewrites a statement
// carrying a hoistable `?` into a `match`, relocating that statement plus
// every following statement in the block into the `Result.Ok` arm — whose
// binder is forced to the literal name `value`. A read of `value` in that
// relocated region would then resolve to the unwrapped payload instead of
// the user's own binding, with no diagnostic and no crash. No binder-rename
// form exists in the pattern grammar, so the collision fails closed here.
fn check_try_value_shadowing(block: Block) -> Diagnostic[] {
    let statements = block.statements;
    let mut index: int = 0;
    loop {
        if index >= statements.length { break; }
        // Every hoisting site is its own hazard, not just the first:
        // `dt_build_match` re-runs `dt_block` over the continuation it just
        // built (`emit_native_desugar_try.sfn:740-742`), so each `?` mints a
        // fresh `Result.Ok { value }` arm around the statements after it.
        // Stopping at the first site would miss
        // `f()?; let value = 7; g()?; use(value);`, where site 1 is clean
        // because `let value` shadows it but site 2 still miscompiles.
        if _stmt_contains_try(statements[index]) {
            if _region_reads_value(statements, index) {
                let mut diagnostics: Diagnostic[] = [];
                diagnostics.push(make_try_value_shadowing_diagnostic(_hazard_span(statements[index])));
                return diagnostics;
            }
        }
        index += 1;
    }
    return [];
}

// `Statement.WithStatement` declares only `clauses`/`body`/`decorators` —
// it carries no `span` (`ast.sfn:454-458`), so the span has to be gated by
// variant rather than read off the node. Every other statement that
// `_stmt_contains_try` can accept does have one.
fn _hazard_span(statement: Statement) -> SourceSpan? {
    if statement.variant == "WithStatement" { return null; }
    return statement.span;
}

// Whether the region starting at `start` reads `value` while it still
// resolves to the desugar's arm binder. Walks forward until the region
// rebinds `value` at its own top level, after which the user's binding
// governs and nothing later is at risk.
fn _region_reads_value(statements: Statement[], start: int) -> boolean {
    let mut index: int = start;
    loop {
        if index >= statements.length { break; }
        let statement = statements[index];
        if _stmt_reads_value(statement) { return true; }
        if _stmt_rebinds_value(statement) { return false; }
        index += 1;
    }
    return false;
}

// Only a top-level `let value` re-shadows the arm binder for the statements
// that follow. `for`/`match`/`catch` binders are scoped to their own bodies
// and are handled where those bodies are walked.
fn _stmt_rebinds_value(statement: Statement) -> boolean {
    if statement.variant != "VariableDeclaration" { return false; }
    return statement.name == "value";
}

fn _block_reads_value(block: Block) -> boolean {
    return _region_reads_value(block.statements, 0);
}

fn _stmt_reads_value(statement: Statement) -> boolean {
    if statement.variant == "VariableDeclaration" {
        if statement.initializer == null { return false; }
        return _expr_reads_value(statement.initializer);
    }
    if statement.variant == "ReturnStatement" {
        if statement.expression == null { return false; }
        return _expr_reads_value(statement.expression);
    }
    if statement.variant == "ExpressionStatement" {
        return _expr_reads_value(statement.expression);
    }
    if statement.variant == "ThrowStatement" {
        return _expr_reads_value(statement.expression);
    }
    if statement.variant == "IfStatement" {
        if _expr_reads_value(statement.condition) { return true; }
        if _block_reads_value(statement.then_block) { return true; }
        return _else_reads_value(statement.else_branch);
    }
    if statement.variant == "ForStatement" {
        if _expr_reads_value(statement.clause.iterable) { return true; }
        // `for value in ...` rebinds `value` for the whole body.
        if _pattern_binds_value(statement.clause.target) { return false; }
        return _block_reads_value(statement.body);
    }
    if statement.variant == "LoopStatement" {
        return _block_reads_value(statement.body);
    }
    if statement.variant == "RoutineStatement" {
        return _block_reads_value(statement.body);
    }
    if statement.variant == "BlockStatement" {
        return _block_reads_value(statement.body);
    }
    if statement.variant == "WithStatement" {
        if _clauses_read_value(statement.clauses) { return true; }
        return _block_reads_value(statement.body);
    }
    if statement.variant == "MatchStatement" {
        if _expr_reads_value(statement.expression) { return true; }
        return _cases_read_value(statement.cases);
    }
    if statement.variant == "TryStatement" {
        if _block_reads_value(statement.try_block) { return true; }
        let catch_block = statement.catch_block;
        if catch_block != null {
            // `catch value { ... }` rebinds `value` for the handler.
            if statement.catch_name != "value" {
                if _block_reads_value(catch_block) { return true; }
            }
        }
        let finally_block = statement.finally_block;
        if finally_block == null { return false; }
        return _block_reads_value(finally_block);
    }
    // A nested `fn` is lifted into its own scope and cannot see the
    // enclosing block's bindings, so its body is not part of this hazard.
    return false;
}

fn _else_reads_value(else_branch: ElseBranch?) -> boolean {
    if else_branch == null { return false; }
    let body = else_branch.body;
    if body != null { return _block_reads_value(body); }
    let nested = else_branch.statement;
    if nested == null { return false; }
    return _stmt_reads_value(nested);
}

fn _cases_read_value(cases: MatchCase[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= cases.length { break; }
        let case = cases[index];
        if case.guard != null {
            if _expr_reads_value(case.guard) { return true; }
        }
        // An arm that binds `value` — `Result.Ok { value }`, how every
        // `Result` match in the tree is written — shadows the desugar's
        // binder for its entire body. Walking that body would reject
        // correct, shipped source.
        if !_pattern_binds_value(case.pattern) {
            if _block_reads_value(case.body) { return true; }
        }
        index += 1;
    }
    return false;
}

fn _clauses_read_value(clauses: WithClause[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= clauses.length { break; }
        if _expr_reads_value(clauses[index].expression) { return true; }
        index += 1;
    }
    return false;
}

// Reuses the analyzer's own binder extraction so pattern shapes stay
// defined in exactly one place — shorthand destructures reach it as
// `Expression.Raw`, which `register_raw_pattern_bindings` decodes.
fn _pattern_binds_value(pattern: Expression?) -> boolean {
    let seed: SymbolEntry[] = [];
    let bindings = register_match_pattern_bindings(pattern, seed);
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if bindings[index].name == "value" { return true; }
        index += 1;
    }
    return false;
}

fn _params_bind_value(parameters: Parameter[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= parameters.length { break; }
        if parameters[index].name == "value" { return true; }
        index += 1;
    }
    return false;
}

fn _expr_reads_value(expression: Expression) -> boolean {
    if expression.variant == "Identifier" {
        return expression.name == "value";
    }
    if expression.variant == "Unary" {
        return _expr_reads_value(expression.operand);
    }
    if expression.variant == "Binary" {
        if _expr_reads_value(expression.left) { return true; }
        return _expr_reads_value(expression.right);
    }
    // `Member.member` is a plain string (`ast.sfn:79`), so `x.value` names a
    // field and never reads the binding.
    if expression.variant == "Member" {
        return _expr_reads_value(expression.object);
    }
    if expression.variant == "Call" {
        if _expr_reads_value(expression.callee) { return true; }
        return _expr_list_reads_value(expression.arguments);
    }
    if expression.variant == "Index" {
        if _expr_reads_value(expression.sequence) { return true; }
        return _expr_reads_value(expression.index);
    }
    if expression.variant == "Array" {
        return _expr_list_reads_value(expression.elements);
    }
    // `ObjectField.name` is a plain string too, so `Result.Ok { value: x }`
    // reads only `x` — the single most common shape in code using `?`.
    if expression.variant == "Object" {
        return _field_list_reads_value(expression.fields);
    }
    if expression.variant == "Struct" {
        return _field_list_reads_value(expression.fields);
    }
    if expression.variant == "Range" {
        if _expr_reads_value(expression.start) { return true; }
        return _expr_reads_value(expression.end);
    }
    if expression.variant == "Cast" {
        return _expr_reads_value(expression.operand);
    }
    if expression.variant == "Is" {
        return _expr_reads_value(expression.operand);
    }
    if expression.variant == "TryOperator" {
        return _expr_reads_value(expression.operand);
    }
    if expression.variant == "Spawn" {
        return _expr_reads_value(expression.operand);
    }
    if expression.variant == "Await" {
        return _expr_reads_value(expression.operand);
    }
    if expression.variant == "Conditional" {
        if _expr_reads_value(expression.condition) { return true; }
        if _expr_reads_value(expression.then_value) { return true; }
        return _expr_reads_value(expression.else_value);
    }
    if expression.variant == "Assignment" {
        if _expr_reads_value(expression.target) { return true; }
        return _expr_reads_value(expression.rhs);
    }
    if expression.variant == "Channel" {
        let capacity = expression.capacity;
        if capacity == null { return false; }
        return _expr_reads_value(capacity);
    }
    if expression.variant == "Parallel" {
        return _expr_list_reads_value(expression.tasks);
    }
    if expression.variant == "Serve" {
        if _expr_reads_value(expression.handler) { return true; }
        let port = expression.port;
        if port == null { return false; }
        return _expr_reads_value(port);
    }
    if expression.variant == "Lambda" {
        // Unlike `_expr_contains_try`, a lambda is NOT opaque here: it
        // captures the enclosing scope, so a read of `value` inside its body
        // still resolves to the desugar's arm binder — unless a parameter
        // rebinds the name.
        if _params_bind_value(expression.parameters) { return false; }
        return _block_reads_value(expression.body);
    }
    // A degraded parse keeps its source text only. Scan it for the bare
    // identifier so the guard fails closed rather than silently missing a
    // hazard it cannot see structurally.
    if expression.variant == "Raw" {
        return _raw_text_reads_value(expression.text);
    }
    return false;
}

fn _expr_list_reads_value(items: Expression[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= items.length { break; }
        if _expr_reads_value(items[index]) { return true; }
        index += 1;
    }
    return false;
}

fn _field_list_reads_value(fields: ObjectField[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= fields.length { break; }
        if _expr_reads_value(fields[index].value) { return true; }
        index += 1;
    }
    return false;
}

fn _raw_text_reads_value(text: string) -> boolean {
    let mut token: string = "";
    let mut index: int = 0;
    loop {
        if index >= text.length { break; }
        let ch = text[index];
        if is_identifier_char(ch) { token = token + ch; } else {
            if token == "value" { return true; }
            token = "";
        }
        index += 1;
    }
    return token == "value";
}

// True when `statement` carries a `?` that the desugar would hoist into THIS
// block. Deliberately mirrors `statement_has_hoistable_try`
// (`compiler/capsules/codegen/src/emit_native_desugar_try.sfn:509-536`):
// recurse into the statement's own expression positions only, never into a
// nested block body.
//
// Descending into nested blocks would be wrong, not merely conservative. A
// `?` inside an `if`/`for`/`loop`/`with`/`match` body is hoisted relative to
// THAT block, so it relocates only that block's remainder — and `check_block`
// visits every nested block in its own right, which is where such a `?` is
// caught. Treating it as hazardous here would reject valid code:
//
//     let value = 7;
//     if cond { let x = f()?; }
//     use(value);              // not shadowed — the arm scope ends at `}`
//
// Within expression positions the predicate may over-fire freely: a `?` in a
// position the desugar cannot hoist is already rejected by E1017, so a
// superset there costs nothing. Written fresh in the analyzer capsule rather
// than imported, because analyzer -> codegen would be a circular capsule
// dependency (`compiler/capsules/codegen/capsule.toml` depends on
// `sfn/analyzer`). If a new hoistable position is added to the desugar, it
// must be mirrored here.
fn _stmt_contains_try(statement: Statement) -> boolean {
    if statement.variant == "VariableDeclaration" {
        if statement.initializer == null { return false; }
        return _expr_contains_try(statement.initializer);
    }
    if statement.variant == "ReturnStatement" {
        if statement.expression == null { return false; }
        return _expr_contains_try(statement.expression);
    }
    if statement.variant == "ExpressionStatement" {
        return _expr_contains_try(statement.expression);
    }
    if statement.variant == "ThrowStatement" {
        return _expr_contains_try(statement.expression);
    }
    if statement.variant == "IfStatement" {
        return _expr_contains_try(statement.condition);
    }
    if statement.variant == "ForStatement" {
        return _expr_contains_try(statement.clause.iterable);
    }
    if statement.variant == "WithStatement" {
        return _clauses_contain_try(statement.clauses);
    }
    return false;
}

fn _clauses_contain_try(clauses: WithClause[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= clauses.length { break; }
        if _expr_contains_try(clauses[index].expression) { return true; }
        index += 1;
    }
    return false;
}

fn _expr_contains_try(expression: Expression) -> boolean {
    if expression.variant == "TryOperator" { return true; }
    if expression.variant == "Unary" {
        return _expr_contains_try(expression.operand);
    }
    if expression.variant == "Binary" {
        if _expr_contains_try(expression.left) { return true; }
        return _expr_contains_try(expression.right);
    }
    if expression.variant == "Member" {
        return _expr_contains_try(expression.object);
    }
    if expression.variant == "Call" {
        if _expr_contains_try(expression.callee) { return true; }
        return _expr_list_contains_try(expression.arguments);
    }
    if expression.variant == "Index" {
        if _expr_contains_try(expression.sequence) { return true; }
        return _expr_contains_try(expression.index);
    }
    if expression.variant == "Array" {
        return _expr_list_contains_try(expression.elements);
    }
    if expression.variant == "Object" {
        return _field_list_contains_try(expression.fields);
    }
    if expression.variant == "Struct" {
        return _field_list_contains_try(expression.fields);
    }
    if expression.variant == "Range" {
        if _expr_contains_try(expression.start) { return true; }
        return _expr_contains_try(expression.end);
    }
    if expression.variant == "Cast" {
        return _expr_contains_try(expression.operand);
    }
    // Lambda is opaque: a `?` inside a lambda body belongs to the lambda's
    // own function scope, not the enclosing one.
    return false;
}

fn _expr_list_contains_try(items: Expression[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= items.length { break; }
        if _expr_contains_try(items[index]) { return true; }
        index += 1;
    }
    return false;
}

fn _field_list_contains_try(fields: ObjectField[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= fields.length { break; }
        if _expr_contains_try(fields[index].value) { return true; }
        index += 1;
    }
    return false;
}

// === Ternary `Conditional` type rules — issue #1715, epic #1180 ===
//
// A ternary `cond ? then : else` (#1690's `Expression.Conditional`) must have a
// boolean condition and two branches that unify. The checker has no expression-
// type inferencer (#829), so branch/condition types are inferred only for the
// literal forms in `_conditional_branch_type` and left "" (unknown) otherwise;
// an unknown type is never reported, so a valid ternary the checker cannot yet
// type is passed through rather than rejected. The rules run both live (the
// `Conditional` arm of `walk_expression`) and directly under
// `conditional_typecheck_test.sfn`.
// The literal-inferred type of a ternary branch/condition, as a plain type
// string. Tracks the emitter's scalar literal inference for number ->
// "int"/"float" (dot detection), string -> "string", boolean -> "boolean",
// and null -> "null". It intentionally adds the internal "empty_array"
// sentinel for bare [] conditional branches so SFN-351 fails closed until the
// checker can contextually infer array element types.
// A signed numeric literal parses as `Unary { -, NumberLiteral }`, so it is
// unwrapped to its numeric kind. Any other form yields "" (not inferable).
fn _conditional_branch_type(expression: Expression?) -> string {
    if expression == null { return ""; }
    if expression.variant == "NumberLiteral" {
        return _conditional_number_kind(expression.value);
    }
    if expression.variant == "StringLiteral" { return "string"; }
    if expression.variant == "BooleanLiteral" { return "boolean"; }
    if expression.variant == "NullLiteral" { return "null"; }
    if expression.variant == "Array" {
        if expression.elements.length == 0 { return "empty_array"; }
        return "";
    }
    if expression.variant == "Unary" {
        // Only a signed numeric literal (`Unary { "-", NumberLiteral }`) carries
        // a numeric kind; other prefix operators (`!`, `*`, `&`) do not, so
        // gate on `-` to avoid classifying `!5` / `*42` / `&0` as int/float.
        if strings_equal(expression.operator, "-") && expression.operand.variant == "NumberLiteral" {
            return _conditional_number_kind(expression.operand.value);
        }
        return "";
    }
    return "";
}

// "float" if the numeric literal text carries a decimal point, else "int"
// (mirrors `_number_literal_kind` in `emit_native_format.sfn`).
fn _conditional_number_kind(value: string) -> string {
    let mut i: int = 0;
    loop {
        if i >= value.length { break; }
        if value[i] == "." { return "float"; }
        i += 1;
    }
    return "int";
}

fn _conditional_branch_diagnostic_type(branch_type: string) -> string {
    if strings_equal(branch_type, "empty_array") { return "[]"; }
    if branch_type.length == 0 { return "unknown"; }
    return branch_type;
}

// Unify two ternary branch types under exact/null-compatible rules (#1715). A
// "null" branch unifies with the other branch's type; two known non-null types
// unify only when equal. Returns "" when either side is unknown or the two are
// incompatible — the single source of truth for the branch rule, consumed by
// `check_conditional_types`. Coercion beyond this is deferred (#1715 Out).
fn conditional_result_type(then_type: string, else_type: string) -> string {
    if then_type.length == 0 { return ""; }
    if else_type.length == 0 { return ""; }
    if strings_equal(then_type, "null") { return else_type; }
    if strings_equal(else_type, "null") { return then_type; }
    if strings_equal(then_type, else_type) { return then_type; }
    return "";
}

// Type rules for a ternary `Conditional`, driven by the literal-inferred
// condition/branch type strings. Reports E0305 when the condition is a known
// non-boolean type, and E0304 when both branches are known but do not unify
// (via `conditional_result_type`, so the rule has one implementation). Unknown
// ("") types are left unconstrained.
fn check_conditional_types(condition_type: string, then_type: string, else_type: string, span: SourceSpan?) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];

    if condition_type.length > 0 {
        if !strings_equal(condition_type, "boolean") {
            diagnostics.push(make_conditional_non_boolean_condition_diagnostic(condition_type, span));
        }
    }

    // A bare [] branch has no element type without an expected type from an
    // annotation or contextual inference. The lowering path currently defaults
    // that branch independently, which can create a runnable program whose
    // array length/capacity are read through the wrong element shape (SFN-351).
    // Fail closed until expression inference can contextually type [] from the
    // sibling branch.
    if strings_equal(then_type, "empty_array") || strings_equal(else_type, "empty_array") {
        let display_then = _conditional_branch_diagnostic_type(then_type);
        let display_else = _conditional_branch_diagnostic_type(else_type);
        diagnostics.push(make_conditional_branch_mismatch_diagnostic(display_then, display_else, span));
        return diagnostics;
    }

    // Both branches known but no unified type -> an incompatible pair. A "null"
    // branch unifies (non-empty result), so it never reaches this diagnostic.
    if then_type.length > 0 && else_type.length > 0 {
        if conditional_result_type(then_type, else_type).length == 0 {
            diagnostics.push(make_conditional_branch_mismatch_diagnostic(then_type, else_type, span));
        }
    }

    return diagnostics;
}
