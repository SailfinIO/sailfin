// compiler/capsules/analyzer/src/typecheck/symbols.sfn
//
// Top-level symbol collection: gathering struct, interface, and global
// declarations into the `SymbolEntry` tables the scope checks run against.
import { ImplicitSymbol } from "sfn/ir";
import { int_to_string } from "sfn/strings";
import {
    FieldDeclaration,
    FunctionSignature,
    MethodDeclaration,
    Parameter,
    Program,
    Statement,
    TypeAnnotation,
    TypeParameter
} from "sfn/syntax";

import {
    ImportProviderBinding,
    ImportSymbolTable,
    ImportedFunctionSignature,
    provider_for_import_source
} from "../effect_imports";
import { ImportedTypeAlias } from "../typecheck_imports";
import { Diagnostic } from "../typecheck_types";
import {
    classify_declared_primitive,
    declared_array_marker,
    type_parameter_names
} from "../typecheck_types/annotation_shape_checks";
import { make_thread_local_requires_mut_diagnostic } from "../typecheck_types/declaration_and_statement_checks";
import { bound_base_name, check_generic_instantiation } from "../typecheck_types/generic_bounds";
import {
    TypeSubstitution,
    apply_type_substitution,
    parse_type_arguments,
    resolve_interface_annotation
} from "../typecheck_types/interface_and_generics";
import {
    SymbolCollectionResult,
    SymbolEntry,
    register_function_symbol,
    register_symbol
} from "../typecheck_types/symbol_table_and_raw_exprs";
import { TypeckCtx } from "./context";

// Every top-level struct declaration, for resolving a concrete type
// argument to its declaration when checking generic bound satisfaction
// (SFEP-0038 §3.2b, #1870). Mirrors `collect_interface_definitions`.
fn collect_struct_definitions(program: Program) -> Statement[] {
    let mut structs: Statement[] = [];
    for statement in program.statements {
        if statement.variant == "StructDeclaration" {
            structs.push(statement);
        }
    }
    return structs;
}

// The names of every top-level generic struct (`type_parameters.length > 0`),
// threaded through the walk so `check_uninferable_generic_constructor` (E0833,
// SFN-404) can tell a generic-struct static call from an enum/namespace access.
fn _generic_struct_names(structs: Statement[]) -> string[] {
    let mut names: string[] = [];
    for statement in structs {
        if statement.type_parameters.length > 0 {
            names.push(statement.name);
        }
    }
    return names;
}

// E0820 enforcement at generic instantiation sites (SFEP-0038 §3.2b,
// #1870). The checker has no expression-type inferencer (#829), so
// generic *function-call* argument→type-parameter binding and `let` /
// struct-literal generic annotations carry no recoverable concrete
// arguments to check yet — those live-wire when inference lands, exactly
// as the `?`-operator (E0810–E0812) and ternary rules defer their live
// walk. The instantiation site with syntactic concrete arguments today is
// a struct's `implements I<Args>` clause against a generic interface
// whose parameters carry bounds; this pass enforces bound satisfaction
// there. The rule itself (`check_generic_instantiation`) is call-ready
// for the remaining sites. In-scope parameters for bound propagation are
// the implementing struct's own type parameters.
fn check_generic_instantiation_sites(program: Program, interfaces: Statement[], structs: Statement[]) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];
    for statement in program.statements {
        if statement.variant == "StructDeclaration" {
            let mut _ai: int = 0;
            loop {
                if _ai >= statement.implements_types.length { break; }
                let annotation = statement.implements_types[_ai];
                let iface = resolve_interface_annotation(annotation, interfaces);
                if iface != null {
                    let found = iface;
                    if found.type_parameters.length > 0 {
                        let args = parse_type_arguments(annotation.text);
                        let inst = check_generic_instantiation(found.name, found.type_parameters, args, interfaces, structs, statement.type_parameters);
                        let mut _di: int = 0;
                        loop {
                            if _di >= inst.length { break; }
                            diagnostics.push(inst[_di]);
                            _di += 1;
                        }
                    }
                }
                _ai += 1;
            }
        }
    }
    return diagnostics;
}

// Wrap each implicitly-available prelude/runtime global name in a
// resolution-only `SymbolEntry` so the E0420 walker's `has_symbol`
// lookup treats it as in-scope. Kind `"prelude"` is informational; the
// walker only keys off `.name`.
fn _symbols_from_global_names(names: string[]) -> SymbolEntry[] {
    let mut out: SymbolEntry[] = [];
    let mut i: int = 0;
    loop {
        if i >= names.length { break; }
        out.push(SymbolEntry {
            name: names[i], kind: "prelude", span: null, is_generic: false, is_c_abi: false, element_kind: "", declared_prim: "", declared_struct: "", declared_type: "", function_parameter_types: [], function_return_type: "", function_effects: [], function_is_async: false, variadic_fixed_arity: -1, is_top_level_function: false, is_nested_function: false
        });
        i += 1;
    }
    return out;
}

// Structured implicit-provider declarations precede local symbols in the
// resolution scope so ordinary source declarations retain their existing
// shadowing behavior. Unlike the legacy name-only scanner rows, function
// entries preserve the complete callable contract required by named function
// values and callback expected-type propagation.
fn _symbols_from_implicit_provider(symbols: ImplicitSymbol[]) -> SymbolEntry[] {
    let mut out: SymbolEntry[] = [];
    let mut index: int = 0;
    loop {
        if index >= symbols.length { break; }
        let symbol = symbols[index];
        let mut kind = symbol.kind;
        if kind == "value" { kind = "variable"; }
        out.push(SymbolEntry {
            name: symbol.name, kind: kind, span: null, is_generic: symbol.is_generic, is_c_abi: symbol.is_c_abi, element_kind: "", declared_prim: "", declared_struct: "", declared_type: symbol.declared_type, function_parameter_types: symbol.parameter_types, function_return_type: symbol.return_type, function_effects: symbol.effects, function_is_async: symbol.is_async, variadic_fixed_arity: -1, is_top_level_function: kind == "function", is_nested_function: false
        });
        index += 1;
    }
    return out;
}

fn _filter_interface_declarations(statements: Statement[]) -> Statement[] {
    let mut out: Statement[] = [];
    let mut i: int = 0;
    loop {
        if i >= statements.length { break; }
        let s = statements[i];
        if strings_equal(s.variant, "InterfaceDeclaration") { out.push(s); }
        i += 1;
    }
    return out;
}

// Keep only imported struct shapes and type aliases used by pointer-store
// resolution. Other imported declarations have separate context channels.
fn _filter_struct_declarations(statements: Statement[]) -> Statement[] {
    let mut out: Statement[] = [];
    let mut i: int = 0;
    loop {
        if i >= statements.length { break; }
        let s = statements[i];
        if strings_equal(s.variant, "StructDeclaration") || strings_equal(s.variant, "TypeAliasDeclaration") {
            out.push(s);
        }
        i += 1;
    }
    return out;
}

fn _imported_struct_internal_name(index: int, name: string) -> string {
    return "__sfn_import_" + int_to_string(index) + "_" + name;
}

fn _imported_struct_substitution(aliases: ImportedTypeAlias[], provider: string) -> TypeSubstitution {
    let mut olds: string[] = [];
    let mut news: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= aliases.length { break; }
        if aliases[i].provider_module == provider && aliases[i].declaration.variant == "StructDeclaration" {
            olds.push(aliases[i].declaration.name);
            news.push(_imported_struct_internal_name(i, aliases[i].declaration.name));
        }
        i += 1;
    }
    return TypeSubstitution { olds: olds, news: news };
}

fn _substitution_outside_type_parameters(substitution: TypeSubstitution, parameters: TypeParameter[]) -> TypeSubstitution {
    let mut olds: string[] = [];
    let mut news: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= substitution.olds.length { break; }
        let mut shadowed = false;
        for parameter in parameters {
            if substitution.olds[i] == parameter.name { shadowed = true; }
        }
        if !shadowed {
            olds.push(substitution.olds[i]);
            news.push(substitution.news[i]);
        }
        i += 1;
    }
    return TypeSubstitution { olds: olds, news: news };
}

fn _substitution_outside_parameter_names(substitution: TypeSubstitution, names: string[]) -> TypeSubstitution {
    let mut olds: string[] = [];
    let mut news: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= substitution.olds.length { break; }
        let mut shadowed = false;
        for name in names {
            if substitution.olds[i] == name { shadowed = true; }
        }
        if !shadowed {
            olds.push(substitution.olds[i]);
            news.push(substitution.news[i]);
        }
        i += 1;
    }
    return TypeSubstitution { olds: olds, news: news };
}

// Imported signatures retain provider spellings even when the source imports
// only a function or renames its struct. Resolve those spellings to the same
// private struct names used by imported field and method metadata.
fn localize_imported_struct_signature_types(table: ImportSymbolTable, aliases: ImportedTypeAlias[]) -> ImportSymbolTable {
    let mut functions: ImportedFunctionSignature[] = [];
    for entry in table.functions {
        let substitution = _substitution_outside_parameter_names(_imported_struct_substitution(aliases, entry.provider_module), entry.type_parameters);
        let mut parameter_types: string[] = [];
        for parameter_type in entry.parameter_types {
            parameter_types.push(apply_type_substitution(parameter_type, substitution));
        }
        functions.push(ImportedFunctionSignature {
            name: entry.name, effects: entry.effects, origin: entry.origin, is_decorator: entry.is_decorator, provider_module: entry.provider_module, return_type: apply_type_substitution(entry.return_type, substitution), parameter_count: entry.parameter_count, required_parameter_count: entry.required_parameter_count, parameter_types: parameter_types, type_parameters: entry.type_parameters
        });
    }
    return ImportSymbolTable {
        functions: functions,
        intrinsic_effects: table.intrinsic_effects
    };
}

fn _localized_struct_method(method: MethodDeclaration, substitution: TypeSubstitution) -> MethodDeclaration {
    let signature = method.signature;
    let visible_substitution = _substitution_outside_type_parameters(substitution, signature.type_parameters);
    let mut parameters: Parameter[] = [];
    for parameter in signature.parameters {
        let mut annotation: TypeAnnotation? = null;
        if parameter.type_annotation != null {
            annotation = TypeAnnotation {
                text: apply_type_substitution(parameter.type_annotation.text, visible_substitution)
            };
        }
        parameters.push(Parameter {
            name: parameter.name, type_annotation: annotation, default_value: parameter.default_value, mutable: parameter.mutable, span: parameter.span
        });
    }
    let mut return_type: TypeAnnotation? = null;
    if signature.return_type != null {
        return_type = TypeAnnotation {
            text: apply_type_substitution(signature.return_type.text, visible_substitution)
        };
    }
    return MethodDeclaration {
        signature: FunctionSignature {
            name: signature.name,
            is_async: signature.is_async,
            parameters: parameters,
            return_type: return_type,
            effects: signature.effects,
            type_parameters: signature.type_parameters,
            name_span: signature.name_span
        },
        body: method.body,
        decorators: method.decorators
    };
}

fn _localized_imported_struct(declaration: Statement, name: string, substitution: TypeSubstitution) -> Statement {
    let visible_substitution = _substitution_outside_type_parameters(substitution, declaration.type_parameters);
    let mut fields: FieldDeclaration[] = [];
    for field in declaration.fields {
        fields.push(FieldDeclaration {
            name: field.name, type_annotation: TypeAnnotation {
                text: apply_type_substitution(field.type_annotation.text, visible_substitution)
            }, mutable: field.mutable, name_span: field.name_span
        });
    }
    let mut methods: MethodDeclaration[] = [];
    for method in declaration.methods {
        methods.push(_localized_struct_method(method, visible_substitution));
    }
    return Statement.StructDeclaration {
        name: name,
        name_span: declaration.name_span,
        type_parameters: declaration.type_parameters,
        implements_types: declaration.implements_types,
        fields: fields,
        methods: methods,
        decorators: declaration.decorators
    };
}

fn localize_imported_type_aliases(program: Program, declarations: Statement[], aliases: ImportedTypeAlias[], providers: ImportProviderBinding[]) -> Statement[] {
    let mut localized: Statement[] = [];
    let mut i: int = 0;
    loop {
        if i >= program.statements.length { break; }
        let statement = program.statements[i];
        if statement.variant == "ImportDeclaration" {
            let mut j: int = 0;
            loop {
                if j >= statement.import_specifiers.length { break; }
                let spec = statement.import_specifiers[j];
                let mut local_name = spec.name;
                if spec.alias != null { local_name = spec.alias; }
                let provider = provider_for_import_source(providers, statement.source);
                let mut direct: boolean = false;
                let mut k: int = 0;
                loop {
                    if k >= aliases.length { break; }
                    if aliases[k].declaration.name == spec.name && provider.length > 0
                        && aliases[k].provider_module == provider {
                        direct = true;
                    }
                    k += 1;
                }
                k = 0;
                loop {
                    if k >= aliases.length { break; }
                    let declaration = aliases[k].declaration;
                    if declaration.name == spec.name && (!direct || aliases[k].provider_module == provider) {
                        if declaration.variant == "TypeAliasDeclaration" {
                            localized.push(Statement.TypeAliasDeclaration {
                                name: local_name, name_span: declaration.name_span, type_parameters: declaration.type_parameters, aliased_type: TypeAnnotation {
                                    text: apply_type_substitution(declaration.aliased_type.text, _substitution_outside_type_parameters(_imported_struct_substitution(aliases, aliases[k].provider_module), declaration.type_parameters))
                                }, decorators: declaration.decorators
                            });
                        } else if declaration.variant == "StructDeclaration" {
                            localized.push(_localized_imported_struct(declaration, local_name, _imported_struct_substitution(aliases, aliases[k].provider_module)));
                        }
                    }
                    k += 1;
                }
                j += 1;
            }
        }
        i += 1;
    }
    let mut k: int = 0;
    loop {
        if k >= aliases.length { break; }
        if aliases[k].declaration.variant == "StructDeclaration" {
            localized.push(_localized_imported_struct(aliases[k].declaration, _imported_struct_internal_name(k, aliases[k].declaration.name), _imported_struct_substitution(aliases, aliases[k].provider_module)));
        }
        k += 1;
    }
    let mut initial: int = 0;
    loop {
        if initial >= declarations.length { break; }
        let declaration = declarations[initial];
        if declaration.variant == "StructDeclaration" {
            let mut present = false;
            for selected in localized {
                if selected.variant == "StructDeclaration" && selected.name == declaration.name {
                    present = true;
                }
            }
            for item in aliases {
                if item.declaration.variant == "StructDeclaration" && item.declaration.name == declaration.name {
                    present = true;
                }
            }
            if !present { localized.push(declaration); }
        }
        initial += 1;
    }
    return localized;
}

fn collect_interface_definitions(program: Program) -> Statement[] {
    let mut interfaces: Statement[] = [];

    for statement in program.statements {
        if statement.variant == "InterfaceDeclaration" {
            interfaces.push(statement);
        }
    }
    return interfaces;
}

fn collect_top_level_symbols(program: Program) -> SymbolCollectionResult {
    let mut symbols: SymbolEntry[] = [];
    let mut diagnostics: Diagnostic[] = [];

    for statement in program.statements {
        let result = register_top_level_symbol(statement, symbols);
        symbols = result.symbols;
        let mut _ci: int = 0;
        loop {
            if _ci >= result.diagnostics.length { break; }
            diagnostics.push(result.diagnostics[_ci]);
            _ci += 1;
        }
    }

    // Top-level names are collected before type metadata is resolved so a
    // variable annotation can name a struct declared later in the file. Walk
    // the source order again and enrich only the first variable declaration
    // for each name (duplicates were rejected above and retain the first).
    let mut seen_variables: string[] = [];
    let no_type_params: string[] = [];
    for statement in program.statements {
        if statement.variant == "VariableDeclaration" {
            if !_string_list_has(seen_variables, statement.name) {
                seen_variables.push(statement.name);
                let declared_struct = _declared_struct_annotation(statement.type_annotation, symbols, no_type_params);
                let mut declared_prim: string = "";
                if statement.type_annotation != null {
                    declared_prim = classify_declared_primitive(statement.type_annotation.text);
                }
                if declared_struct.length > 0 || declared_prim.length > 0 {
                    let mut index: int = 0;
                    loop {
                        if index >= symbols.length { break; }
                        if strings_equal(symbols[index].name, statement.name) {
                            if strings_equal(symbols[index].kind, "variable") {
                                symbols[index].declared_struct = declared_struct;
                                symbols[index].declared_prim = declared_prim;
                            }
                            break;
                        }
                        index += 1;
                    }
                }
            }
        }
    }

    return SymbolCollectionResult {
        symbols: symbols,
        diagnostics: diagnostics
    };
}

// Resolution-only scope contribution (#812): the local names a program's
// own `import { ... }` specifiers bring into call position. Registered
// for E0420 resolution alongside the top-level declarations so an
// imported free-function call resolves even on the standalone check path
// (`typecheck_diagnostics` / `typecheck_has_errors`) where the
// cross-module effect table is empty — the import specifier is itself
// proof the name is in scope. Aliased specifiers (`import { fetch as get }`)
// register under the local alias, mirroring
// `localize_import_symbols_for_program` in effect_imports.sfn.
fn _collect_imported_call_symbols(program: Program) -> SymbolEntry[] {
    let mut symbols: SymbolEntry[] = [];
    let mut i: int = 0;
    loop {
        if i >= program.statements.length { break; }
        let statement = program.statements[i];
        if statement.variant == "ImportDeclaration" {
            let mut s: int = 0;
            loop {
                if s >= statement.import_specifiers.length { break; }
                let spec = statement.import_specifiers[s];
                let mut local_name = spec.name;
                let alias = spec.alias;
                if alias != null {
                    let alias_str: string? = alias;
                    if alias_str.length > 0 { local_name = alias_str; }
                }
                symbols.push(SymbolEntry {
                    name: local_name, kind: "import", span: null, is_generic: false, is_c_abi: false, element_kind: "", declared_prim: "", declared_struct: "", declared_type: "", function_parameter_types: [], function_return_type: "", function_effects: [], function_is_async: false, variadic_fixed_arity: -1, is_top_level_function: false, is_nested_function: false
                });
                s += 1;
            }
        }
        i += 1;
    }
    return symbols;
}

// SFN-555: flatten a resolution scope to bare names for the E0013 known-type
// lookup. The scope mixes kinds (functions, types, imports, prelude globals);
// keeping every name is deliberate — see the fail-open note on
// `_first_unknown_type_name`.
// SFN-555: a declaration's own type parameters, layered onto whatever the
// walk already had in scope.
fn _decl_type_params(ctx: TypeckCtx, parameters: TypeParameter[]) -> string[] {
    let names = type_parameter_names(parameters);
    if names.length == 0 { return ctx.type_params; }
    return ctx.type_params.concat(names);
}

fn _names_from_symbols(symbols: SymbolEntry[]) -> string[] {
    let mut names: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= symbols.length { break; }
        names.push(symbols[i].name);
        i += 1;
    }
    return names;
}

fn _string_list_has(values: string[], target: string) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= values.length { break; }
        if strings_equal(values[index], target) { return true; }
        index += 1;
    }
    return false;
}

// Type annotations resolve in the type namespace. Walk innermost-first but
// ignore value/callable bindings with the same spelling; aliases, enums, and
// interfaces remain visible so they can prevent a false struct proof.
fn _find_type_symbol(symbols: SymbolEntry[], name: string) -> SymbolEntry? {
    let mut index: int = symbols.length - 1;
    loop {
        if index < 0 { break; }
        let entry = symbols[index];
        if strings_equal(entry.name, name) {
            let mut is_type: boolean = false;
            if strings_equal(entry.kind, "struct") { is_type = true; }
            if strings_equal(entry.kind, "enum") { is_type = true; }
            if strings_equal(entry.kind, "interface") { is_type = true; }
            if strings_equal(entry.kind, "type") { is_type = true; }
            if is_type { return entry; }
        }
        index -= 1;
    }
    return null;
}

fn _find_symbol_with_kind(symbols: SymbolEntry[], name: string, kind: string) -> SymbolEntry? {
    let mut index: int = symbols.length - 1;
    loop {
        if index < 0 { break; }
        let entry = symbols[index];
        if strings_equal(entry.name, name) {
            if strings_equal(entry.kind, kind) { return entry; }
        }
        index -= 1;
    }
    return null;
}

// Resolve an explicit annotation in its declaration scope. Only a direct
// struct name/generic instantiation survives. Arrays, aliases, inferred
// values, and a base name shadowed by a scoped type parameter stay fail-open.
fn _declared_struct_annotation(annotation: TypeAnnotation?, bindings: SymbolEntry[], type_params: string[]) -> string {
    if annotation == null { return ""; }
    let text = annotation.text;
    if declared_array_marker(text).length > 0 { return ""; }
    let base_name = bound_base_name(text);
    if _string_list_has(type_params, base_name) { return ""; }
    let type_entry = _find_type_symbol(bindings, base_name);
    if type_entry == null { return ""; }
    if !strings_equal(type_entry.kind, "struct") { return ""; }
    return text;
}

fn register_top_level_symbol(statement: Statement, existing: SymbolEntry[]) -> SymbolCollectionResult {
    if statement.variant == "FunctionDeclaration" {
        return register_function_symbol(statement.signature, "function", existing);
    }
    if statement.variant == "ExternFunctionDeclaration" {
        // Only a well-formed `...` (last position, at least one fixed
        // parameter) records a variadic arity; a misplaced marker is
        // already E0851 from `check_extern_signature`, and recording it
        // here would compound one error into a second at every call site.
        // SFN-1291.
        let mut fixed_arity: int = -1;
        if statement.variadic_index == statement.signature.parameters.length {
            if statement.variadic_index > 0 {
                fixed_arity = statement.variadic_index;
            }
        }
        return register_function_symbol(statement.signature, "extern function", existing, fixed_arity);
    }
    if statement.variant == "ExternVarDeclaration" {
        return register_symbol(statement.name, "extern variable", statement.name_span, existing);
    }
    if statement.variant == "StructDeclaration" {
        return register_symbol(statement.name, "struct", statement.name_span, existing);
    }
    if statement.variant == "EnumDeclaration" {
        return register_symbol(statement.name, "enum", statement.name_span, existing);
    }
    if statement.variant == "InterfaceDeclaration" {
        return register_symbol(statement.name, "interface", statement.name_span, existing);
    }
    if statement.variant == "TestDeclaration" {
        return register_symbol(statement.name, "test", statement.name_span, existing);
    }
    if statement.variant == "TypeAliasDeclaration" {
        return register_symbol(statement.name, "type", statement.name_span, existing);
    }
    if statement.variant == "VariableDeclaration" {
        let mut registration = register_symbol(statement.name, "variable", statement.span, existing);
        if registration.diagnostics.length == 0 {
            if statement.type_annotation != null {
                let last = registration.symbols.length - 1;
                registration.symbols[last].declared_type = statement.type_annotation.text;
            }
        }
        if statement.is_thread_local {
            if !statement.mutable {
                let mut diagnostics = registration.diagnostics;
                diagnostics.push(make_thread_local_requires_mut_diagnostic(statement.name));
                return SymbolCollectionResult {
                    symbols: registration.symbols,
                    diagnostics: diagnostics
                };
            }
        }
        return registration;
    }
    return SymbolCollectionResult { symbols: existing, diagnostics: [] };
}
