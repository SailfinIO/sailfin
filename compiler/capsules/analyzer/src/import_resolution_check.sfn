// compiler/capsules/analyzer/src/import_resolution_check.sfn
//
// Pure import-resolution analysis for `sfn check` (#1953, SFN-686). The driver
// resolves relative module paths on disk and records which capsule specs the
// resolver located, producing an `ImportResolutionContext`; the analyzer
// consumes that value to diagnose unresolved modules (E0430) and names absent
// from the staged import closure (E0431). Sailfin
// resolves imported symbols globally by name — a module may legally import
// a symbol from a module that does not itself declare it, as long as some
// module in the link defines it — so E0431 checks closure-wide existence,
// not per-declaring-module export (see `ClosureSymbolSet`). Runs only through
// the analyzer facade used by `sfn check`, never in the build/self-host emit
// path, so it cannot affect code generation.
//
// Two spec classes are checked: relative specs (`./`, `../`), against the
// driver's on-disk probe, and capsule specs (`<scope>/<name>[/...]`), against
// the set of specs the check resolver actually located.
//
// Two classes are deliberately left unchecked, because the check-time closure
// structurally omits them and diagnosing against it could only false-positive:
//
//   * `runtime/...` — `collect_scoped_import_specs`
//     (`compiler/src/capsule_import_scan.sfn`) excludes runtime-prefixed specs
//     from the resolver's edge set, and `sfn check` resolves with an empty
//     `runtime_root` (`compiler/src/capsule_resolver/check.sfn`), so runtime
//     modules are never staged into the closure this check reads.
//   * bare names (no `/`) — not a capsule spec; they resolve through
//     mechanisms that leave no record in the resolved-spec set.
import { strings_equal, substring } from "sfn/strings";
import { Program } from "sfn/syntax";

import { Diagnostic } from "./typecheck_types";
import {
    make_cannot_find_module_diagnostic,
    make_symbol_not_exported_diagnostic
} from "./typecheck_types/declaration_and_statement_checks";

// Closure-wide symbol surface built from the driver's staged import
// artifacts. `complete == false` suppresses E0431 because a missing or corrupt
// artifact makes the known-name set only a subset of the real closure.
struct ClosureSymbolSet {
    names: string[];
    complete: boolean;
}

// Driver-resolved import input for one parsed source file. The analyzer owns
// the semantic decision and diagnostic data, while the driver owns the
// filesystem probe needed to populate `resolved_relative_specs` and the
// resolver pass that populates `resolved_capsule_specs`.
//
// `resolved_capsule_specs` holds the specs the resolver recorded verbatim; an
// import matches an entry exactly or as a submodule beneath it, so neither
// side needs canonicalising (see `_irc_capsule_spec_resolved`).
// `capsule_specs_known` gates E0430 for capsule specs the same way
// `ClosureSymbolSet.complete` gates E0431: it is false whenever no resolver
// pass produced the set (the standalone `check_source` adapter), where an
// empty list means "unknown", not "nothing resolved".
struct ImportResolutionContext {
    closure_symbols: ClosureSymbolSet;
    resolved_relative_specs: string[];
    resolved_capsule_specs: string[];
    capsule_specs_known: boolean;
}

fn _irc_starts_with(text: string, prefix: string) -> boolean {
    if prefix.length > text.length { return false; }
    return strings_equal(substring(text, 0, prefix.length), prefix);
}

fn _irc_names_contains(names: string[], target: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= names.length { break; }
        if strings_equal(names[i], target) { return true; }
        i += 1;
    }
    return false;
}

fn _irc_specs_contains(specs: string[], target: string) -> boolean {
    return _irc_names_contains(specs, target);
}

fn _irc_is_relative(spec: string) -> boolean {
    if _irc_starts_with(spec, "./") { return true; }
    if _irc_starts_with(spec, "../") { return true; }
    return false;
}

fn _irc_has_slash(spec: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= spec.length { break; }
        if strings_equal(substring(spec, i, i + 1), "/") { return true; }
        i += 1;
    }
    return false;
}

// A capsule spec is any non-relative, non-runtime spec carrying a `/`.
fn _irc_is_capsule(spec: string) -> boolean {
    if _irc_is_relative(spec) { return false; }
    if _irc_starts_with(spec, "runtime/") { return false; }
    return _irc_has_slash(spec);
}

// Is `spec` covered by a capsule the resolver located? An entry matches the
// spec itself, or any submodule beneath it (`sfn/http` covers
// `sfn/http/client`). Prefix matching rather than truncating the spec to two
// segments: a capsule name may itself carry more than two segments
// (`is_safe_scope_name` in `../../../src/capsule_artifact.sfn` validates every
// `/`-separated segment, and `_cr_enumerate_host_capsule_sources` names
// `acme/router/middleware/auth` as a live shape), so a fixed truncation would
// miss the recorded entry and mint a spurious E0430. The trailing `/` keeps
// `sfn/httpx` from matching an `sfn/http` entry. Mirrors the prefix test
// `_cr_source_imports_host` (`../../../src/capsule_import_scan.sfn`) already
// uses for the same question.
fn _irc_capsule_spec_resolved(specs: string[], spec: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= specs.length { break; }
        let entry = specs[i];
        i += 1;
        if entry.length == 0 { continue; }
        if strings_equal(entry, spec) { return true; }
        if _irc_starts_with(spec, entry + "/") { return true; }
    }
    return false;
}

// Walk a parsed program's `import` declarations and emit E0430 for a spec the
// driver could not resolve, or E0431 for a named specifier defined nowhere in
// the staged import closure.
// Sailfin resolves imported symbols globally by name (see
// `ClosureSymbolSet`), so E0431 checks closure-wide existence, not
// per-module export. It is suppressed unless `closure.complete` — an
// incomplete closure (a missing/corrupt artifact, or a wildcard re-export)
// might not list a genuinely-defined name, and a false positive is worse
// than a missed one. E0430 still fires for a standalone single-file check
// because its driver adapter populates the resolved-spec set.
// `prelude_globals` is the second exemption: those names are defined by the
// runtime prelude rather than any staged artifact, so they never appear in
// the closure symbol set even though the link defines them.
fn collect_import_resolution_findings(program: Program, file_path: string, context: ImportResolutionContext, prelude_globals: string[] = []) -> Diagnostic[] {
    let mut out: Diagnostic[] = [];
    let mut i: int = 0;
    loop {
        if i >= program.statements.length { break; }
        let statement = program.statements[i];
        i += 1;
        if statement.variant != "ImportDeclaration" { continue; }
        let spec_path = statement.source;

        let relative = _irc_is_relative(spec_path);
        let capsule = _irc_is_capsule(spec_path);
        // `runtime/...` and bare names: unchecked, see the header comment.
        if !relative && !capsule { continue; }
        // No resolver pass ran, so an absent spec proves nothing.
        if capsule && !context.capsule_specs_known { continue; }

        let mut resolved: boolean = false;
        if relative {
            resolved = _irc_specs_contains(context.resolved_relative_specs, spec_path);
        } else {
            resolved = _irc_capsule_spec_resolved(context.resolved_capsule_specs, spec_path);
        }
        if !resolved {
            let mut d = make_cannot_find_module_diagnostic(spec_path);
            d.file_path = file_path;
            out.push(d);
            continue;
        }
        if !context.closure_symbols.complete { continue; }
        let mut s: int = 0;
        loop {
            if s >= statement.import_specifiers.length { break; }
            let importer = statement.import_specifiers[s];
            s += 1;
            if _irc_names_contains(context.closure_symbols.names, importer.name) {
                continue;
            }
            // A prelude global is defined by the runtime prelude, not by any
            // staged artifact, so it is absent from the closure symbol set
            // while still being defined in the link. `sfn/strings` re-exports
            // several (`strings_equal` is `runtime/prelude.sfn`'s, not its
            // own), and importing one from a capsule is legal under
            // global-by-name resolution. Without this it false-positives in
            // any closure small enough that no staged module happens to carry
            // the name as an `.import`/`.export` specifier.
            if _irc_names_contains(prelude_globals, importer.name) { continue; }
            let mut nd = make_symbol_not_exported_diagnostic(importer.name, spec_path);
            nd.file_path = file_path;
            out.push(nd);
        }
    }
    return out;
}

export {
    ClosureSymbolSet,
    ImportResolutionContext,
    collect_import_resolution_findings
};
