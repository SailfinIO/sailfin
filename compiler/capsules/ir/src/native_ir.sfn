// compiler/capsules/ir/src/native_ir.sfn
//
// Type definitions for the textual `.sfn-asm` IR. The parsing logic lives in
// native_ir_parser.sfn; this module exists purely so that downstream modules
// can import the types without pulling in the heavy parser code.
import { LoweringDiagnostic } from "./lowering_diagnostic";
import { NativeSourceSpan } from "./source_span";

enum NativeInstruction {
    Return {
        expression: string;
        span: NativeSourceSpan?;
    },
    Expression {
        expression: string;
        span: NativeSourceSpan?;
    },
    Let {
        name: string;
        mutable: boolean;
        is_thread_local: boolean;
        type_annotation: string;
        value: string?;
        span: NativeSourceSpan?;
        value_span: NativeSourceSpan?;
    },
    // Control-flow directives carry the span of the statement that opened them
    // (SFEP-0061 §2.2 Set B), so lowering can locate a `break` outside a loop or
    // a zero-stride `.for`. `LoopVectorize` is span-less: `.loop vectorize` is
    // emitted from a tensor-lowering text template rather than from an AST
    // statement.
    If {
        condition: string;
        span: NativeSourceSpan?;
    },
    Else { span: NativeSourceSpan? },
    EndIf,
    Routine,
    EndRoutine,
    For {
        target: string;
        iterable: string;
        span: NativeSourceSpan?;
    },
    EndFor,
    Loop { span: NativeSourceSpan? },
    LoopVectorize,
    EndLoop,
    Break { span: NativeSourceSpan? },
    Continue { span: NativeSourceSpan? },
    Match {
        expression: string;
        span: NativeSourceSpan?;
    },
    Case {
        pattern: string;
        guard: string?;
        span: NativeSourceSpan?;
    },
    EndMatch,
    Try,
    Catch {
        name: string;
    },
    Finally,
    EndTry,
    Throw {
        expression: string;
        span: NativeSourceSpan?;
    },
    Noop,
    Unknown { text: string }
}

struct NativeParameter {
    name: string;
    type_annotation: string;
    mutable: boolean;
    default_value: string?;
    span: NativeSourceSpan?;
}

struct NativeFunction {
    name: string;
    is_async: boolean;
    parameters: NativeParameter[];
    return_type: string;
    effects: string[];
    decorators: string[];
    is_extern: boolean;
    instructions: NativeInstruction[];
}

// Prepared lambda-capture contract consumed by target providers. Codegen
// serializes these fields into native IR after analyzer capture inference and
// lambda lifting have completed; LLVM reconstructs this IR-owned value without
// importing syntax or analyzer data structures. `by_value` and `mutable`
// preserve the existing capture ownership mode across the provider boundary.
struct NativeLambdaCapture {
    name: string;
    type_text: string;
    by_value: boolean;
    mutable: boolean;
}

struct NativeImportSpecifier {
    name: string;
    alias: string?;
}

struct NativeImport {
    kind: string;
    module: string;
    specifiers: NativeImportSpecifier[];
}

// Serialized native-IR interchange contracts. Codegen constructs these
// values, while parsers, verifiers, analyzer import loading, and target
// lowering consume them without depending back on the emitter.
struct NativeArtifact {
    name: string;
    format: string;
    contents: string;
}

struct NativeModule {
    module_name: string;
    artifacts: NativeArtifact[];
    entry_points: string[];
    symbol_count: int;
}

struct NativeStructField {
    name: string;
    type_annotation: string;
    mutable: boolean;
}

struct NativeStructLayoutField {
    name: string;
    type_annotation: string;
    offset: int;
    size: int;
    align: int;
}

struct NativeStructLayout {
    size: int;
    align: int;
    fields: NativeStructLayoutField[];
}

struct NativeStruct {
    name: string;
    fields: NativeStructField[];
    methods: NativeFunction[];
    implements: string[];
    layout: NativeStructLayout?;
}

struct NativeInterfaceSignature {
    name: string;
    is_async: boolean;
    type_parameters: string[];
    parameters: NativeParameter[];
    return_type: string;
    effects: string[];
}

struct NativeInterface {
    name: string;
    type_parameters: string[];
    signatures: NativeInterfaceSignature[];
}

struct NativeEnumVariantField {
    name: string;
    type_annotation: string;
    mutable: boolean;
}

struct NativeEnumVariant {
    name: string;
    fields: NativeEnumVariantField[];
}

struct NativeEnumVariantLayout {
    name: string;
    tag: int;
    offset: int;
    size: int;
    align: int;
    fields: NativeStructLayoutField[];
}

struct NativeEnumLayout {
    size: int;
    align: int;
    tag_type: string;
    tag_size: int;
    tag_align: int;
    variants: NativeEnumVariantLayout[];
}

struct NativeEnum {
    name: string;
    type_parameters: string[];
    variants: NativeEnumVariant[];
    layout: NativeEnumLayout?;
}

struct NativeBinding {
    name: string;
    mutable: boolean;
    is_thread_local: boolean;
    is_extern: boolean;
    type_annotation: string;
    value: string?;
}

// One declaration made available without a source import by an implicit
// capsule provider. `provider_module` is the canonical staged module slug,
// never a physical source path. `signature` is a deterministic declaration
// fingerprint used by the driver to reject ambiguous duplicate surfaces
// before analyzer or lowering tables can silently choose by staging order.
struct ImplicitSymbol {
    name: string;
    kind: string;
    provider_module: string;
    signature: string;
    effects: string[];
    parameter_types: string[];
    return_type: string;
    parameter_count: int;
    required_parameter_count: int;
    declared_type: string;
    is_async: boolean;
    is_generic: boolean;
    is_c_abi: boolean;
}

struct EnumParseResult {
    definition: NativeEnum?;
    next_index: int;
    diags: LoweringDiagnostic[];
}

struct CaseComponents {
    pattern: string;
    guard: string?;
}

struct InstructionParseResult {
    instructions: NativeInstruction[];
    span_consumed: boolean;
    value_span_consumed: boolean;
}

struct InstructionGatherResult {
    text: string;
    lines_consumed: int;
}

struct InstructionDepthState {
    paren_depth: int;
    bracket_depth: int;
    brace_depth: int;
    in_string: boolean;
    escaping: boolean;
}

struct StructParseResult {
    definition: NativeStruct?;
    next_index: int;
    diags: LoweringDiagnostic[];
}

struct InterfaceParseResult {
    definition: NativeInterface?;
    next_index: int;
    diags: LoweringDiagnostic[];
}

struct InterfaceSignatureParse {
    success: boolean;
    signature: NativeInterfaceSignature;
}

struct StructHeaderParse {
    name: string;
    implements: string[];
}

struct InterfaceHeaderParse {
    name: string;
    type_parameters: string[];
}

struct HeaderNameParse {
    name: string;
    type_parameters: string[];
    remainder: string;
}

struct StructLayoutHeaderParse {
    success: boolean;
    name: string;
    size: int;
    align: int;
}

struct StructLayoutFieldParse {
    success: boolean;
    field: NativeStructLayoutField;
}

struct ParseNativeResult {
    functions: NativeFunction[];
    imports: NativeImport[];
    structs: NativeStruct[];
    interfaces: NativeInterface[];
    enums: NativeEnum[];
    bindings: NativeBinding[];
    diags: LoweringDiagnostic[];
}

struct EnumLayoutHeaderParse {
    success: boolean;
    name: string;
    size: int;
    align: int;
    tag_type: string;
    tag_size: int;
    tag_align: int;
}

struct EnumLayoutVariantParse {
    success: boolean;
    variant: NativeEnumVariantLayout;
}

struct EnumLayoutPayloadParse {
    success: boolean;
    variant_name: string;
    field: NativeStructLayoutField;
}

struct NumberParseResult {
    success: boolean;
    value: int;
}

struct LayoutManifest {
    structs: NativeStruct[];
    enums: NativeEnum[];
}

// Driver-resolved mapping from a path-shaped import slug to the canonical
// provider slug whose staged artifact was loaded. LLVM consumes this value
// when mangling imported call sites; it never reads `.slugalias` itself.
struct ImportModuleAlias {
    import_slug: string;
    provider_slug: string;
}

// Explicit staged-interface payload crossing the driver/codegen boundary.
// The driver discovers and reads these artifacts; LLVM lowering consumes only
// the already-loaded data in this value.
struct ImportedModuleContext {
    manifests: LayoutManifest[];
    native_texts: string[];
    module_aliases: ImportModuleAlias[];
    // Provider-qualified declarations from selected implicit capsule entry
    // interfaces. Appended last so existing context field offsets stay stable
    // while the pinned seed compiles this capability family.
    implicit_symbols: ImplicitSymbol[];
}

struct BindingComponents {
    name: string;
    type_annotation: string;
    value: string?;
}
