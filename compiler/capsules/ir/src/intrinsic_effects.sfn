// compiler/capsules/ir/src/intrinsic_effects.sfn
//
// Target-neutral intrinsic identity and effect metadata consumed by semantic
// analysis. Target providers do not import this contract: their descriptors
// own only provider-local target lookup plus symbol/type/ABI lowering data.
import { substring } from "sfn/strings";

struct IntrinsicEffectEntry {
    target: string;
    effects: string[];
}

struct IntrinsicEffectTable {
    entries: IntrinsicEffectEntry[];
}

fn empty_intrinsic_effects() -> IntrinsicEffectTable {
    return IntrinsicEffectTable { entries: [] };
}

fn append_intrinsic_effects(table: IntrinsicEffectTable, target: string, effects: string[]) -> IntrinsicEffectTable {
    let mut updated = table;
    updated.entries.push(IntrinsicEffectEntry {
        target: target, effects: effects
    });
    return updated;
}

// Canonical semantic registry. Only effectful identities need rows: a missing
// exact row means the intrinsic is pure. Target providers may own additional
// lowering-only identities without coupling their registries to this table.
fn intrinsic_effect_table() -> IntrinsicEffectTable {
    let mut table = empty_intrinsic_effects();
    table = append_intrinsic_effects(table, "runtime_monotonic_millis_fn", ["clock"]);
    table = append_intrinsic_effects(table, "monotonic_millis", ["clock"]);
    table = append_intrinsic_effects(table, "runtime_unix_millis_fn", ["clock"]);
    table = append_intrinsic_effects(table, "runtime_log_execution_fn", ["io"]);
    table = append_intrinsic_effects(table, "runtime_serve_fn", ["io", "net"]);
    table = append_intrinsic_effects(table, "print", ["io.console"]);
    table = append_intrinsic_effects(table, "print.err", ["io.console"]);
    table = append_intrinsic_effects(table, "print.info", ["io.console"]);
    table = append_intrinsic_effects(table, "print.error", ["io.console"]);
    table = append_intrinsic_effects(table, "print.warn", ["io.console"]);
    table = append_intrinsic_effects(table, "console.info", ["io.console"]);
    table = append_intrinsic_effects(table, "console.log", ["io.console"]);
    table = append_intrinsic_effects(table, "console.error", ["io.console"]);
    table = append_intrinsic_effects(table, "fs.exists", ["io.fs"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_exe_path", ["io"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_fs_symlink", ["io"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_fs_exists", ["io"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_fs_get_perms", ["io"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_fs_list_dir", ["io"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_fs_read_link", ["io"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_fs_is_directory", ["io"]);
    table = append_intrinsic_effects(table, "http.get", ["net.http"]);
    table = append_intrinsic_effects(table, "http.post", ["net.http"]);
    table = append_intrinsic_effects(table, "sleep", ["clock"]);
    table = append_intrinsic_effects(table, "runtime_sleep_fn", ["clock"]);
    table = append_intrinsic_effects(table, "process.run", ["io"]);
    table = append_intrinsic_effects(table, "process.exit", ["io"]);
    table = append_intrinsic_effects(table, "process.run_capture", ["io"]);
    table = append_intrinsic_effects(table, "process.exec", ["io"]);
    table = append_intrinsic_effects(table, "process.run_capture_cwd", ["io"]);
    table = append_intrinsic_effects(table, "process.run_capture_rlimit_as", ["io"]);
    table = append_intrinsic_effects(table, "process.capture_take_stdout", ["io"]);
    table = append_intrinsic_effects(table, "process.capture_take_stderr", ["io"]);
    table = append_intrinsic_effects(table, "process.run_capture_metered", ["io", "clock"]);
    table = append_intrinsic_effects(table, "process.capture_take_wall_ms", ["io"]);
    table = append_intrinsic_effects(table, "process.capture_take_peak_rss_kb", ["io"]);
    table = append_intrinsic_effects(table, "process.spawn_with_env", ["io"]);
    table = append_intrinsic_effects(table, "process.spawn_with_env_cwd", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_write", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_close_stdin", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_read_stdout", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_read_stderr", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_read_line_stdout", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_read_bytes_stdout", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_stdout_at_eof", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_write_bytes", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_wait", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_stdout_fd", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_stderr_fd", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_read_bytes_stderr", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_stderr_at_eof", ["io"]);
    table = append_intrinsic_effects(table, "process.handle_kill", ["io"]);
    table = append_intrinsic_effects(table, "process.environ", ["io"]);
    table = append_intrinsic_effects(table, "io.poll_readable", ["io"]);
    table = append_intrinsic_effects(table, "io.poll_any", ["io"]);
    table = append_intrinsic_effects(table, "io.read_fd", ["io"]);
    table = append_intrinsic_effects(table, "io.read_line", ["io"]);
    table = append_intrinsic_effects(table, "fs_read_file", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.readFile", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs_write_file", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.writeFile", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs_append_file", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.appendFile", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs_write_lines", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.writeLines", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs_list_directory", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.listDirectory", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs_delete_file", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.deleteFile", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs_create_directory", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.createDirectory", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs_remove_directory", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.removeDirectory", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.set_perms", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.get_perms", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.mkdtemp", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.is_executable", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.symlink", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.read_link", ["io.fs"]);
    table = append_intrinsic_effects(table, "fs.is_directory", ["io.fs"]);
    table = append_intrinsic_effects(table, "http_get", ["net.http"]);
    table = append_intrinsic_effects(table, "http_post", ["net.http"]);
    table = append_intrinsic_effects(table, "serve_start", ["net", "io"]);
    table = append_intrinsic_effects(table, "serve_handler_dispatch", ["net", "io"]);
    table = append_intrinsic_effects(table, "websocket.serve", ["net.ws"]);
    table = append_intrinsic_effects(table, "websocket.serve_tls", ["net.ws"]);
    table = append_intrinsic_effects(table, "websocket.send", ["net.ws"]);
    table = append_intrinsic_effects(table, "websocket.close", ["net.ws"]);
    table = append_intrinsic_effects(table, "websocket.connect", ["net.ws"]);
    table = append_intrinsic_effects(table, "serve", ["io", "net"]);
    table = append_intrinsic_effects(table, "sailfin_intrinsic_mem_footprint", ["io"]);
    table = append_intrinsic_effects(table, "http.get_body", ["net.http"]);
    table = append_intrinsic_effects(table, "http.post_json", ["net.http"]);
    table = append_intrinsic_effects(table, "http.download", ["net.http", "io"]);
    table = append_intrinsic_effects(table, "env.get", ["io"]);
    table = append_intrinsic_effects(table, "env.home", ["io"]);
    table = append_intrinsic_effects(table, "fs.read_bytes", ["io.fs"]);
    // SFN-822: `tls.last_error` / `tls.last_alert` deliberately have NO row
    // here. `effect_checker/collector.sfn` resolves exact target first, then
    // falls back to the `tls.*` namespace union only when no `tls.*` row
    // exists at all; a rootless namespace with zero rows requires no
    // effects, which is correct for a pure accessor over a process-global
    // slot. Adding `["net"]` would force `![net]` onto assertion helpers that
    // read a value already recorded by an earlier `![net]` call — do not
    // "fix" this by adding a row.
    return table;
}

fn _ie_starts_with(text: string, prefix: string) -> boolean {
    if prefix.length > text.length { return false; }
    return substring(text, 0, prefix.length) == prefix;
}

fn _ie_namespace_prefix(target: string) -> string {
    let mut root = "";
    let mut index: int = 0;
    loop {
        if index >= target.length { break; }
        if target[index] == "." { break; }
        root = root + target[index];
        index += 1;
    }
    return root + ".";
}

fn _ie_contains(items: string[], target: string) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= items.length { break; }
        if items[index] == target { return true; }
        index += 1;
    }
    return false;
}

fn _ie_union(into: string[], additions: string[]) -> string[] {
    let mut out = into;
    let mut index: int = 0;
    loop {
        if index >= additions.length { break; }
        if !_ie_contains(out, additions[index]) {
            out.push(additions[index]);
        }
        index += 1;
    }
    return out;
}

// Exact target first, then conservative namespace union. This preserves the
// existing effect-checker contract: `http.download` keeps its precise
// `[net.http, io]`, while an unlisted `fs.*` member inherits the union of the
// provider's `fs.*` entries.
fn intrinsic_effects_for_callee_target(table: IntrinsicEffectTable, target: string) -> string[] {
    let mut index: int = 0;
    loop {
        if index >= table.entries.length { break; }
        if table.entries[index].target == target {
            return table.entries[index].effects;
        }
        index += 1;
    }
    let prefix = _ie_namespace_prefix(target);
    let mut accumulated: string[] = [];
    let mut fallback_index: int = 0;
    loop {
        if fallback_index >= table.entries.length { break; }
        let entry = table.entries[fallback_index];
        if _ie_starts_with(entry.target, prefix) {
            accumulated = _ie_union(accumulated, entry.effects);
        }
        fallback_index += 1;
    }
    return accumulated;
}

fn intrinsic_effects_for_exact_target(table: IntrinsicEffectTable, target: string) -> string[] {
    let mut index: int = 0;
    loop {
        if index >= table.entries.length { break; }
        if table.entries[index].target == target {
            return table.entries[index].effects;
        }
        index += 1;
    }
    return [];
}

fn intrinsic_effects_for_target(target: string) -> string[] {
    return intrinsic_effects_for_callee_target(intrinsic_effect_table(), target);
}

export {
    IntrinsicEffectEntry,
    IntrinsicEffectTable,
    append_intrinsic_effects,
    empty_intrinsic_effects,
    intrinsic_effect_table,
    intrinsic_effects_for_callee_target,
    intrinsic_effects_for_exact_target,
    intrinsic_effects_for_target
};
