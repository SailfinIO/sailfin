        } else if starts_with(token, "tag_align=") {
            let value_text = substring(token, 10, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                tag_align_found = true;
                tag_align_value = parsed.value;
            } else { }
        } else { }
        index += 1;
    }
    if !size_found { }
    if !align_found { }
    if tag_type.length == 0 { }
    if !tag_size_found { }
    if !tag_align_found { }
    let mut _let376: boolean = false;
    if size_found {
        if align_found {
            if tag_type.length > 0 {
                if tag_size_found {
                    if tag_align_found { _let376 = true; }
                }
            }
        }
    }
    let success = _let376;
    return EnumLayoutHeaderParse {
        success: success,
        name: name_value,
        size: size_value,
        align: align_value,
        tag_type: tag_type,
        tag_size: tag_size_value,
        tag_align: tag_align_value
    };
}

