fn parse_decimal_number(text: string) -> NumberParseResult {
    let trimmed = trim_text(text);
    if trimmed.length == 0 {
        return NumberParseResult { success: false, value: 0 };
    }
    let mut value: int = 0;
    let mut index: int = 0;
    let mut negative: boolean = false;
    if trimmed[0] == "-" {
        negative = true;
        index = 1;
        if index >= trimmed.length {
            return NumberParseResult { success: false, value: 0 };
        }
    }
    loop {
        if index >= trimmed.length { break; }
        let code = trimmed[index];
        if code == "0" { value = value * 10; } else if code == "1" {
            value = value * 10 + 1;
        } else if code == "2" { value = value * 10 + 2; } else if code == "3" {
            value = value * 10 + 3;
        } else if code == "4" { value = value * 10 + 4; } else if code == "5" {
            value = value * 10 + 5;
        } else if code == "6" { value = value * 10 + 6; } else if code == "7" {
            value = value * 10 + 7;
        } else if code == "8" { value = value * 10 + 8; } else if code == "9" {
            value = value * 10 + 9;
        } else {
            return NumberParseResult { success: false, value: 0 };
        }
        index += 1;
    }
    if negative { value = 0 - value; }
    return NumberParseResult { success: true, value: value };
}

fn _nir_layout_type_may_continue(type_text: string, offset_found: boolean, size_found: boolean, align_found: boolean) -> boolean {
    if type_text.length == 0 { return false; }
    if offset_found { return false; }
    if size_found { return false; }
    if align_found { return false; }
    return true;
}

fn parse_struct_layout_header(text: string) -> StructLayoutHeaderParse {
    let tokens = split_whitespace(trim_text(text));
    if tokens.length == 0 {
        return StructLayoutHeaderParse {
            success: false,
            name: "",
            size: 0,
            align: 0
        };
    }
    let mut name_found: boolean = false;
    let mut size_found: boolean = false;
    let mut align_found: boolean = false;
    let mut name_value: string = "";
    let mut size_value: int = 0;
    let mut align_value: int = 0;
    let mut index: int = 0;
    loop {
        if index >= tokens.length { break; }
        let token = tokens[index];
        if starts_with(token, "name=") {
            name_value = substring(token, 5, token.length);
            name_found = true;
        } else if starts_with(token, "size=") {
            let value_text = substring(token, 5, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                size_found = true;
                size_value = parsed.value;
            } else { }
        } else if starts_with(token, "align=") {
            let value_text = substring(token, 6, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                align_found = true;
                align_value = parsed.value;
            } else { }
        } else { }
        index += 1;
    }
    if !size_found { }
    if !align_found { }
    let mut _let374: boolean = false;
    if size_found {
        if align_found { _let374 = true; }
    }
    let success = _let374;
    return StructLayoutHeaderParse {
        success: success,
        name: name_value,
        size: size_value,
        align: align_value
    };
}

fn parse_struct_layout_field(text: string, struct_name: string) -> StructLayoutFieldParse {
    let trimmed = trim_text(text);
    let default_field = NativeStructLayoutField {
        name: "",
        type_annotation: "",
        offset: 0,
        size: 0,
        align: 0
    };
    if trimmed.length == 0 {
        return StructLayoutFieldParse { success: false, field: default_field };
    }
    let tokens = split_whitespace(trimmed);
    if tokens.length == 0 {
        return StructLayoutFieldParse { success: false, field: default_field };
    }
    let field_name = tokens[0];
    if field_name.length == 0 {
        return StructLayoutFieldParse { success: false, field: default_field };
    }
    let mut type_text: string = "";
    let mut offset_found: boolean = false;
    let mut size_found: boolean = false;
    let mut align_found: boolean = false;
    let mut offset_value: int = 0;
    let mut size_value: int = 0;
    let mut align_value: int = 0;
    let mut index: int = 1;
    loop {
        if index >= tokens.length { break; }
        let token = tokens[index];
        if starts_with(token, "type=") {
            type_text = substring(token, 5, token.length);
        } else if starts_with(token, "offset=") {
            let value_text = substring(token, 7, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                offset_found = true;
                offset_value = parsed.value;
            } else { }
        } else if starts_with(token, "size=") {
            let value_text = substring(token, 5, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                size_found = true;
                size_value = parsed.value;
            } else { }
        } else if starts_with(token, "align=") {
            let value_text = substring(token, 6, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                align_found = true;
                align_value = parsed.value;
            } else { }
        } else if _nir_layout_type_may_continue(type_text, offset_found, size_found, align_found) {
            // SFN-532: type annotations may contain whitespace. The first
            // keyed layout attribute ends the type value.
            type_text = type_text + " " + token;
        } else if type_text.length > 0 { } else { }
        index += 1;
    }
    if type_text.length == 0 { }
    if !offset_found { }
    if !size_found { }
    if !align_found { }
    let mut _let375: boolean = false;
    if type_text.length > 0 {
        if offset_found {
            if size_found {
                if align_found { _let375 = true; }
            }
        }
    }
    let success = _let375;
    let field = NativeStructLayoutField {
        name: field_name,
        type_annotation: type_text,
        offset: offset_value,
        size: size_value,
        align: align_value
    };
    return StructLayoutFieldParse { success: success, field: field };
}

