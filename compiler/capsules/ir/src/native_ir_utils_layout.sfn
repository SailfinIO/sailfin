fn parse_enum_payload_layout(text: string, enum_name: string) -> EnumLayoutPayloadParse {
    let trimmed = trim_text(text);
    let default_field = NativeStructLayoutField {
        name: "",
        type_annotation: "",
        offset: 0,
        size: 0,
        align: 0
    };
    if trimmed.length == 0 {
        return EnumLayoutPayloadParse {
            success: false,
            variant_name: "",
            field: default_field
        };
    }
    let tokens = split_whitespace(trimmed);
    if tokens.length == 0 {
        return EnumLayoutPayloadParse {
            success: false,
            variant_name: "",
            field: default_field
        };
    }
    let identifier = tokens[0];
    let dot_index = index_of(identifier, ".");
    let _dot_next = dot_index + 1;
    let mut _if378: boolean = false;
    if dot_index <= 0 { _if378 = true; }
    if _dot_next >= identifier.length { _if378 = true; }
    if _if378 {
        return EnumLayoutPayloadParse {
            success: false,
            variant_name: "",
            field: default_field
        };
    }
    let variant_name = substring(identifier, 0, dot_index);
    let field_name = substring(identifier, _dot_next, identifier.length);
    let mut type_text: string = "";
    let mut offset_found: boolean = false;
    let mut size_found: boolean = false;
    let mut align_found: boolean = false;
    let mut offset_value: int = 0;
    let mut size_value: int = 0;
    let mut align_value: int = 0;
    let mut index: int = 1;
    loop {
        if index >= tokens.length { break; }
        let token = tokens[index];
        if starts_with(token, "type=") {
            type_text = substring(token, 5, token.length);
        } else if starts_with(token, "offset=") {
            let value_text = substring(token, 7, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                offset_found = true;
                offset_value = parsed.value;
            } else { }
        } else if starts_with(token, "size=") {
            let value_text = substring(token, 5, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                size_found = true;
                size_value = parsed.value;
            } else { }
        } else if starts_with(token, "align=") {
            let value_text = substring(token, 6, token.length);
            let parsed = parse_decimal_number(value_text);
            if parsed.success {
                align_found = true;
                align_value = parsed.value;
            } else { }
        } else if _nir_layout_type_may_continue(type_text, offset_found, size_found, align_found) {
            // Payload types use the same keyed boundary as struct fields so
            // generic annotations retain spaces.
            type_text = type_text + " " + token;
        } else if type_text.length > 0 { } else { }
        index += 1;
    }
    if type_text.length == 0 { }
    if !offset_found { }
    if !size_found { }
    if !align_found { }
    let mut _let379: boolean = false;
    if type_text.length > 0 {
        if offset_found {
            if size_found {
                if align_found { _let379 = true; }
            }
        }
    }
    let success = _let379;
    let field = NativeStructLayoutField {
        name: field_name,
        type_annotation: type_text,
        offset: offset_value,
        size: size_value,
        align: align_value
    };
    return EnumLayoutPayloadParse {
        success: success,
        variant_name: variant_name,
        field: field
    };
}
