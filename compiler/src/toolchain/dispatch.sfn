// compiler/src/toolchain/dispatch.sfn
//
// Toolchain floor dispatch. Canonical host-qualified entries are preferred;
// the flat pre-SFEP-0073 store is a read-only compatibility fallback.
import { diagnostic_to_diag } from "sfn/analyzer/typecheck_types";

import { _path_basename } from "../build/paths";
import { _env_flag } from "../build_flags";
import {
    ToolchainDecision,
    toolchain_decide,
    toolchain_print_mismatch,
    toolchain_print_version_error,
    toolchain_selection_satisfies
} from "../capsule_resolver/toolchain";
import { CliContext } from "../cli/context";
import { starts_with, strings_equal, substring } from "../string_utils";
import { render_terminal_diagnostic } from "../terminal_output";
import { _strip_build_metadata, resolve_compiler_version } from "../version";
import { toolchain_known_sequence, toolchain_known_sequence_note } from "./channel";
import { toolchain_current_host } from "./host";
import {
    toolchain_revocation_find,
    toolchain_revocations_corrupt,
    toolchain_revocations_path,
    toolchain_revocations_read
} from "./index_cache";
import { toolchain_install_to_user_store, toolchain_is_valid_install_version } from "./install";
import {
    toolchain_print_integrity_failure,
    toolchain_verify_bundled_inputs,
    toolchain_verify_executable
} from "./integrity";
import {
    ToolchainStoreEntry,
    toolchain_resolve_compatible_store_entry,
    toolchain_store_diagnostic,
    toolchain_versions_base
} from "./store";
import {
    toolchain_user_default_corrupt,
    toolchain_user_default_path,
    toolchain_user_default_read
} from "./user_default";

fn _dispatch_normalize_ver(version: string) -> string {
    if version.length == 0 { return ""; }
    if starts_with(version, "v") {
        return substring(version, 1, version.length);
    }
    return version;
}

fn _dispatch_work_root() -> string ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { return scratch; }
    let temp = env.get("TMPDIR");
    if temp.length > 0 { return temp; }
    return "/tmp";
}

fn _dispatch_knob_is_mode(knob: string) -> boolean {
    if knob.length == 0 { return true; }
    if strings_equal(knob, "auto") { return true; }
    if strings_equal(knob, "local") { return true; }
    if strings_equal(knob, "off") { return true; }
    return strings_equal(knob, "0");
}

fn _print_store_error() -> void ![io] {
    let empty_lines: string[] = [];
    print.err(render_terminal_diagnostic(diagnostic_to_diag(toolchain_store_diagnostic(), "toolchain"), empty_lines, "toolchain"));
}

fn _dispatch_entry(versions_base: string, version: string) -> ToolchainStoreEntry ![io] {
    return toolchain_resolve_compatible_store_entry(versions_base, toolchain_current_host(), version);
}

// Every caller of `toolchain_gate_or_dispatch` is a build-like command
// (`build`, `check`, `run`, `test`), so a `return 0` here is the last moment
// before this process consumes its own bundled runtime and capsule sources.
// SFEP-0073 §3.8 requires those inputs to be verified against the install
// manifest first. A dev build or a pre-SFN-1064 entry carries no manifest and
// reports `unverified`, which is the documented SFEP-0046 compatibility
// boundary — it proceeds rather than failing.
// Verifies the payload beside the running executable. In a normal launch
// `ctx.runtime_root` derives from the same executable and so sits inside
// `ctx.binary_dir`; an explicit `--runtime-root`/`SAILFIN_RUNTIME_ROOT`
// can point elsewhere, in which case those sources are outside what the
// manifest covers. That is not an escalation — setting either already
// requires control of the invocation — but it does bound the guarantee.
fn _proceed_in_process(ctx: CliContext) -> int ![io] {
    let outcome = toolchain_verify_bundled_inputs(ctx.binary_dir);
    if outcome.ok { return 0; }
    toolchain_print_integrity_failure(ctx.binary_dir, _path_basename(ctx.binary_dir), outcome);
    return 1;
}

// Build the dispatched child's environment. Two keys are rewritten rather than
// inherited verbatim (SFN-1065).
//
// An exact `SAILFIN_TOOLCHAIN` is dropped, because the selection has already
// been made here. Leaving it would hand the child a selection input that
// disagrees with the toolchain it *is*, so `SAILFIN_TOOLCHAIN=A sfn +B <cmd>`
// would die in the child's own dispatch-loop guard, telling the user to
// reinstall a perfectly good toolchain. The mode words
// (`auto`/`local`/`off`/`0`) are kept: they constrain fetching and floor
// behavior in the child and are not selections. Dropping the exact knob also
// puts the child on the mode path, whose floor-before-marker ordering
// re-adjudicates the pin against what the child actually turned out to be.
//
// Any inherited `SAILFIN_TOOLCHAIN_DISPATCHED` is dropped so the marker
// appended below is the only one in the child's environment, rather than
// relying on every caller to have returned early on a set marker.
fn _dispatch_child_env(target: string) -> string[] ![io] {
    let source = process.environ();
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= source.length { break; }
        let entry = source[i];
        let mut keep: boolean = true;
        if starts_with(entry, "SAILFIN_TOOLCHAIN_DISPATCHED=") { keep = false; }
        if starts_with(entry, "SAILFIN_TOOLCHAIN=") {
            // 18 is the length of "SAILFIN_TOOLCHAIN=".
            keep = _dispatch_knob_is_mode(substring(entry, 18, entry.length));
        }
        if keep { out.push(entry); }
        i += 1;
    }
    out.push("SAILFIN_TOOLCHAIN_DISPATCHED=" + target);
    return out;
}

// The exact version named by `SAILFIN_TOOLCHAIN`, or "" when the variable is
// unset or holds one of the mode words. Exported so callers outside this
// module can ask "is there an explicit environment selection?" without
// duplicating the mode vocabulary.
fn toolchain_env_exact_selector() -> string ![io] {
    let knob = env.get("SAILFIN_TOOLCHAIN");
    if _dispatch_knob_is_mode(knob) { return ""; }
    return knob;
}

// Explicit exact selection — SFEP-0073 §3.3 ranks 1 and 2: a `+<version>`
// one-shot selector, `sfn toolchain run <version>`, or an exact
// `SAILFIN_TOOLCHAIN`. Unlike the floor gate below, this applies
// unconditionally: an explicit selector is a selection input, not mismatch
// recovery, so it takes effect even when the running toolchain already
// satisfies the project pin.
//
// Returns 0 when the caller should keep running in-process (the selection
// resolved to this very toolchain, or a version query found no payload), and
// non-zero on a refused selection. A successful dispatch never returns.
fn toolchain_select_exact(selector: string, source_label: string, entry_hint: string, ctx: CliContext, skip_flag: boolean, version_query: boolean) -> int ![clock, io, net] {
    let target = _dispatch_normalize_ver(selector);
    if !toolchain_is_valid_install_version(target) {
        print.err("error: " + source_label
            + " is not an exact toolchain version: "
            + selector);
        // Channel names resolve to a release through the signed index, which
        // is a later slice (SFEP-0073 §3.9 slice 4). Naming that limit beats a
        // bare parse error for whoever just typed `+stable`.
        print.err("  channel selectors (stable|rc|beta|alpha|latest) are not available yet");
        print.err("  name an exact release, e.g. sfn +0.10.6 build");
        return 2;
    }

    // Discovered before the marker check below, because a marker match is only
    // safe to trust once the running toolchain has been measured against the
    // pin.
    let decision: ToolchainDecision = toolchain_decide(entry_hint, ctx.binary_dir);
    let knob_now = env.get("SAILFIN_TOOLCHAIN");
    let hatched = skip_flag || _env_flag("SAILFIN_SKIP_TOOLCHAIN_CHECK")
        || strings_equal(knob_now, "off")
        || strings_equal(knob_now, "0");

    // A repeated selector re-enters this path, so the marker is compared
    // against the target rather than merely tested for presence: a match means
    // this process *is* the selection and must run the command, not dispatch
    // again. That match is trusted only when the floor actually holds for what
    // this process turned out to be. A store entry whose payload does not match
    // its directory name would otherwise use the marker to walk straight past
    // the pin it fails, which is the one thing this guard exists to catch.
    let dispatched = env.get("SAILFIN_TOOLCHAIN_DISPATCHED");
    if dispatched.length > 0 {
        if strings_equal(dispatched, target) {
            if !decision.pinned || decision.satisfied || hatched { return 0; }
        }
        print.err("error: toolchain dispatch loop — the dispatched toolchain "
            + dispatched
            + " does not satisfy the pin ("
            + decision.pin_desc
            + ")");
        print.err("  the stored toolchain for " + dispatched
            + " is the wrong version or corrupt");
        print.err("  reinstall it: sfn toolchain install " + dispatched);
        return 1;
    }

    // SFEP-0073 §3.3: the minimum and stability checks still run *after*
    // selection. An explicitly selected compiler below the project floor is an
    // error rather than a silent downgrade, and the three pre-existing escape
    // hatches stay the only way through.
    if decision.pinned {
        if !toolchain_selection_satisfies(decision, target) {
            if hatched {
                print.err("warning: " + source_label + " selects " + target
                    + ", which does not satisfy the project pin "
                    + decision.pin_desc
                    + " ("
                    + decision.pin_source
                    + " [toolchain]); proceeding (--skip-toolchain-check / SAILFIN_TOOLCHAIN=off)");
            } else {
                print.err("error: " + source_label + " selects " + target
                    + ", which does not satisfy the project pin");
                print.err("  this project pins " + decision.pin_desc + " ("
                    + decision.pin_source
                    + " [toolchain])");
                print.err("  select a satisfying version, or re-run with --skip-toolchain-check to override");
                return 1;
            }
        }
    }

    // Selecting the running toolchain is a no-op, not a re-exec. This keeps
    // `sfn +<running-version> ...` free of a pointless image replacement, and
    // free of a store lookup that could otherwise fetch a released build which
    // only shares a version number with a local dev binary.
    //
    // The build stamp is stripped for that comparison. An in-tree binary
    // resolves as `<version>+dev.<hash>` (`build_stamp.sfn`), while every
    // selector it could be compared against is a bare release: `sfn init`
    // strips the stamp before writing (SFEP-0073 §3.2 rule 2), and
    // `semver_is_exact_release` rejects a manifest field carrying one. Without
    // the strip, a project scaffolded by a dev build fetches the *released*
    // build of its own version on the very next command — the outcome the
    // paragraph above says this check exists to prevent.
    let running = _dispatch_normalize_ver(_strip_build_metadata(resolve_compiler_version(ctx.binary_dir)));
    if strings_equal(target, running) { return 0; }

    // `local` selects but never downloads (SFEP-0073 §3.3 mode table). It
    // constrains fetching, not selection, so it applies to a CLI selector as
    // much as to its own knob.
    let allow_fetch = !strings_equal(knob_now, "local");
    return _dispatch_exec_target(target, ctx, allow_fetch, version_query);
}

// SFEP-0073 §3.3 rank 3 — the active root's exact `[toolchain] version`.
//
// Resolved from the working directory before the command tree is built, so it
// reaches every ordinary command uniformly: `fmt`, `emit`, `bench`, `package`
// and `init` never call the floor gate, and a future command this toolchain
// cannot parse has no gate to call. Threading the field through each command's
// gate instead would cover only the four commands wired to
// `toolchain_gate_or_dispatch` today and could never cover one that does not
// exist yet.
//
// The working directory, not the entry file, is the resolution root. That is
// what §3.4 specifies for `active`, and it is forced anyway: naming the entry
// file requires the parse this runs ahead of. The floor gate keeps its own
// entry-hint discovery, so SFEP-0046 enforcement is unchanged by this path.
//
// Returns 0 when the caller should keep running in-process (no exact field, or
// it selected this very toolchain), and non-zero on a refused selection. A
// successful dispatch replaces the image and never returns.
fn toolchain_select_project_exact(ctx: CliContext, argv_skip: boolean, version_query: boolean) -> int ![clock, io, net] {
    // §3.2 rules 2 and 4 are checked before any stand-down below, because
    // manifest validity is not a version mismatch: the escape hatches exist to
    // override a *disagreement* between a valid requirement and the running
    // toolchain, and there is no such disagreement to override here — the
    // requirement itself is unusable, and no installed toolchain could satisfy
    // it. Letting a hatch suppress this would turn a typo in a manifest into
    // silence for anyone who habitually sets one.
    let decision: ToolchainDecision = toolchain_decide("", ctx.binary_dir);
    if decision.version_error.length > 0 {
        toolchain_print_version_error(decision);
        return 2;
    }
    if decision.pin_version.length == 0 { return 0; }

    // A dispatch already happened, so this process *is* somebody's selection
    // and the marker names their target, not this root's field. Re-selecting
    // would let a rank-3 field override the rank-1 or rank-2 selector that
    // chose this toolchain — and since the marker no longer matches the field,
    // `toolchain_select_exact` would report a dispatch loop against a
    // perfectly healthy store. The forwarded argv cannot carry the evidence
    // itself: the selector token is stripped before re-exec, and an exact
    // `SAILFIN_TOOLCHAIN` is dropped from the child environment, so the marker
    // is the only surviving record that a higher rank already chose. Ordinary
    // management routing stands down on the same signal (`management.sfn`).
    if env.get("SAILFIN_TOOLCHAIN_DISPATCHED").length > 0 { return 0; }

    // Rank 2 outranks this field. It is applied downstream by
    // `toolchain_gate_or_dispatch` and the `version` path, which hold the entry
    // hint its floor check is measured against; standing down here rather than
    // racing them is what keeps the documented precedence order intact.
    if toolchain_env_exact_selector().length > 0 { return 0; }

    // SFEP-0073 §3.3's mode table gives `off`/`0` one meaning: *do not
    // dispatch*, and run the entry toolchain. The two skip flags are
    // documented alongside it as proceeding on the running toolchain without
    // dispatching. They are not floor overrides here — there is no mismatch to
    // override, since an exact field selects unconditionally — so honoring
    // them has to mean declining to select at all. This is also the escape
    // hatch a deliberate seed transition depends on (`compiler/capsule.toml`).
    let knob = env.get("SAILFIN_TOOLCHAIN");
    if strings_equal(knob, "off") || strings_equal(knob, "0") { return 0; }
    if argv_skip || _env_flag("SAILFIN_SKIP_TOOLCHAIN_CHECK") { return 0; }

    // Naming the manifest that supplied the field, not merely the field, so a
    // per-field workspace/member merge is legible in the diagnostic.
    let source_label = decision.version_source + " [toolchain] version";
    // `version_query` doubles as the skip flag: reporting a version is not
    // running a build, so a floor mismatch warns and still answers rather than
    // refusing. Every other hatch already returned above.
    return toolchain_select_exact(decision.pin_version, source_label, "", ctx, version_query, version_query);
}

// SFEP-0073 §3.3 rank 4 — the per-user default recorded by `sfn toolchain
// default`. Every higher rank names a version explicitly; this one is the
// standing choice for a root that names none, and rank 5 (the entry
// toolchain) is what runs when this declines.
//
// Returns 0 when the caller should keep running in-process (no default
// recorded, a higher rank owns the selection, or the default names this very
// toolchain), and non-zero on a refused selection. A successful dispatch
// replaces the image and never returns.
fn toolchain_select_user_default(ctx: CliContext, argv_skip: boolean, version_query: boolean) -> int ![clock, io, net] {
    // Rank 3 runs immediately before this and returns non-zero only when it
    // refuses, so an exact field surviving to here already had its say —
    // either it selected this toolchain or it stood down. Answering for it
    // would invert ranks 3 and 4. A malformed field is likewise rank 3's to
    // report, and it already did.
    let decision: ToolchainDecision = toolchain_decide("", ctx.binary_dir);
    if decision.version_error.length > 0 { return 0; }
    if decision.pin_version.length > 0 { return 0; }

    // The same stand-downs as rank 3, for the reasons documented there: the
    // marker means a higher rank already chose this process, rank 2 is applied
    // downstream by `toolchain_gate_or_dispatch`, and the mode table's
    // `off`/`0` and the two skip flags all mean *do not dispatch*.
    if env.get("SAILFIN_TOOLCHAIN_DISPATCHED").length > 0 { return 0; }
    if toolchain_env_exact_selector().length > 0 { return 0; }
    let knob = env.get("SAILFIN_TOOLCHAIN");
    if strings_equal(knob, "off") || strings_equal(knob, "0") { return 0; }
    if argv_skip || _env_flag("SAILFIN_SKIP_TOOLCHAIN_CHECK") { return 0; }

    // Defaults are keyed by host triple so a roaming home can hold payloads
    // for several hosts (SFEP-0073 §3.5). An unrecognised host has no key to
    // read under, which is a stand-down rather than an error: the entry
    // toolchain still runs.
    let host = toolchain_current_host();
    if host.triple.length == 0 { return 0; }

    let recorded = toolchain_user_default_read(host.triple);
    if recorded.version.length == 0 {
        // Only now is the second read worth its cost, and only this branch can
        // confuse the two states: an unreadable record and an absent one both
        // surface as an empty version. Running the entry toolchain silently
        // while the user believes they selected another release is the one
        // outcome worth refusing, so a version query still answers (it reports
        // rather than builds, exactly as it treats a floor mismatch) and every
        // other command stops with the command that repairs it.
        if toolchain_user_default_corrupt() {
            let where = toolchain_user_default_path();
            if version_query {
                print.err("warning: the per-user toolchain default is unreadable: "
                    + where);
                return 0;
            }
            print.err("error: the per-user toolchain default is unreadable: "
                + where);
            print.err("  re-record it with sfn toolchain default <version>");
            return 2;
        }
        return 0;
    }

    // A standing default that cannot satisfy this root's floor is not an
    // error here — it is simply not the answer. SFEP-0073 §3.3 scopes the
    // below-the-minimum refusal to "a one-shot or environment-selected
    // compiler", both of which are a deliberate act naming a version for this
    // invocation. A default is neither: the user recorded it once, globally,
    // and a project they clone later that needs a newer floor should still
    // dispatch to that floor the way it did before any default existed.
    // Refusing instead would take a working `sfn build` and break it on every
    // machine that ever ran `toolchain default`, and the refusal's own advice
    // (`--skip-toolchain-check`) would then build below the floor rather than
    // fetch it. Standing down hands the decision to `toolchain_gate_or_dispatch`,
    // which fetches and re-execs the floor version as it always has.
    if !toolchain_selection_satisfies(decision, _dispatch_normalize_ver(recorded.version)) {
        return 0;
    }

    let rc = toolchain_select_exact(recorded.version, "the per-user toolchain default", "", ctx, version_query, version_query);
    if rc == 2 {
        // The record is user-editable, so a non-exact value lands in
        // `toolchain_select_exact`'s parse error, whose hint names a `+<version>`
        // one-shot. That does not repair the record, which is what is actually
        // wrong here.
        print.err("  re-record it with sfn toolchain default <version>");
    }
    return rc;
}

fn toolchain_gate_or_dispatch(entry_hint: string, ctx: CliContext, skip_flag: boolean) -> int ![clock, io, net] {
    // SFEP-0073 §3.3 rank 2. An exact `SAILFIN_TOOLCHAIN` is consulted before
    // the floor decision below, so it selects whether or not the running
    // toolchain already satisfies the project pin. It used to be reachable
    // only after a mismatch, which made it recovery rather than selection.
    // `selector_resolved` means a `+<version>` selector already chose this
    // toolchain in-process. The environment knob ranks below the CLI selector,
    // so it must not re-open a decision the selector already made — otherwise
    // `SAILFIN_TOOLCHAIN=A sfn +<running> <cmd>` dispatches to A.
    let knob = env.get("SAILFIN_TOOLCHAIN");
    if !_dispatch_knob_is_mode(knob) && !ctx.selector_resolved {
        let rc = toolchain_select_exact(knob, "SAILFIN_TOOLCHAIN", entry_hint, ctx, skip_flag, false);
        if rc != 0 { return rc; }
        return _proceed_in_process(ctx);
    }

    let decision: ToolchainDecision = toolchain_decide(entry_hint, ctx.binary_dir);
    if !decision.pinned || decision.satisfied {
        return _proceed_in_process(ctx);
    }

    let knob_off = strings_equal(knob, "off") || strings_equal(knob, "0");
    if skip_flag || _env_flag("SAILFIN_SKIP_TOOLCHAIN_CHECK") || knob_off {
        print.err("warning: toolchain mismatch — this project pins "
            + decision.pin_desc
            + " ("
            + decision.pin_source
            + " [toolchain]) but the running toolchain is "
            + decision.running_str
            + "; proceeding (--skip-toolchain-check / SAILFIN_TOOLCHAIN=off)");
        // Opting out of the version pin is not opting out of payload
        // integrity: this process still goes on to consume its own bundled
        // sources, so §3.8's pre-consumption check still applies.
        return _proceed_in_process(ctx);
    }

    let dispatched = env.get("SAILFIN_TOOLCHAIN_DISPATCHED");
    if dispatched.length > 0 {
        print.err("error: toolchain dispatch loop — the dispatched toolchain "
            + dispatched
            + " still does not satisfy the pin ("
            + decision.pin_desc
            + ")");
        print.err("  the stored toolchain for " + dispatched
            + " is the wrong version or corrupt");
        print.err("  reinstall it: sfn toolchain install " + dispatched);
        return 1;
    }
    if strings_equal(knob, "local") {
        toolchain_print_mismatch(decision);
        return 1;
    }

    // Only a mode knob reaches here — an exact one dispatched above — so the
    // pin is the sole fetch target on this path.
    let target = _dispatch_normalize_ver(decision.pin_sfn);
    if !toolchain_is_valid_install_version(target) {
        print.err("error: toolchain mismatch and no concrete version to fetch");
        print.err("  this project pins " + decision.pin_desc + " (" + decision.pin_source
            + " [toolchain])");
        print.err("  set SAILFIN_TOOLCHAIN=<version>, or install manually: sfn toolchain install <version>");
        return 1;
    }

    return _dispatch_exec_target(target, ctx, true, false);
}

// Resolve `target` in the store, fetch it when permitted, verify it, and
// replace this image with it. Returns 1 on any failure and 0 only when the
// caller should keep running in-process; a successful `process.exec` never
// returns, which is what preserves the selected toolchain's exit code and
// terminating signal exactly (SFEP-0073 §3.4 `run`).
//
// `allow_fetch` is false for `SAILFIN_TOOLCHAIN=local`, which selects but
// never downloads. `version_query` is true for a bare version request, which
// SFEP-0073 §3.3 requires stay network-silent: a missing payload prints an
// install hint and hands back to the entry toolchain rather than fetching.
fn _dispatch_exec_target(target: string, ctx: CliContext, allow_fetch: boolean, version_query: boolean) -> int ![clock, io, net] {
    let versions_base = toolchain_versions_base();
    if versions_base.length == 0 {
        _print_store_error();
        return 1;
    }
    let mut entry = _dispatch_entry(versions_base, target);
    // A complete legacy entry is used as-is and never promoted, moved, or
    // marked verified. An explicit install performs the authenticated online
    // migration into the qualified store.
    if !entry.ready {
        // A version query answers from what is already on disk. Reporting the
        // entry toolchain plus the install command is the actionable answer;
        // downloading a compiler to print its own version number is not.
        if version_query {
            print.err("note: the selected toolchain " + target
                + " is not installed");
            print.err("  reporting the entry toolchain instead");
            print.err("  install it: sfn toolchain install " + target);
            return 0;
        }
        if !allow_fetch {
            print.err("error: the selected toolchain " + target
                + " is not installed");
            print.err("  SAILFIN_TOOLCHAIN=local forbids fetching it");
            print.err("  install it: sfn toolchain install " + target);
            return 1;
        }
        // `false`: this install is implied by a project pin, not typed by a
        // user, so it must never silently override a yank. An explicit
        // `sfn toolchain install --allow-yanked <version>` is the only way in.
        let rc = toolchain_install_to_user_store(target, versions_base, _dispatch_work_root(), false);
        if rc != 0 {
            print.err("error: could not obtain the pinned toolchain " + target);
            print.err("  run: sfn toolchain install " + target);
            return 1;
        }
        entry = _dispatch_entry(versions_base, target);
        if !entry.ready || entry.legacy {
            print.err("error: the pinned toolchain " + target
                + " is still not available after install");
            print.err("  run: sfn toolchain install " + target);
            return 1;
        }
    }
    if entry.legacy {
        print.err("warning: dispatching unverified legacy toolchain " + target);
        print.err("  " + entry.dir);
        print.err("  run 'sfn toolchain install " + target
            + "' online to install a verified host-qualified entry");
    }

    // SFEP-0073 §3.7 (SFN-1069): a cached-known revoked release cannot be
    // executed, online or offline. The ledger is local and monotonic, so this
    // holds with no network at all — which is the point: revocation that only
    // bit while connected would be trivially evaded by pulling the cable. A
    // client never claims more than its highest cached signed sequence, so an
    // entry absent from the ledger runs normally rather than being presumed
    // revoked.
    // A ledger that will not parse means revocation cannot be evaluated, which
    // is not the same as "nothing is revoked" — `toolchain_revocations_read`
    // returns an empty list for both. Failing open here would hand anyone who
    // can write to this file a way to un-revoke every release by corrupting it,
    // which is precisely the evasion revocation exists to resist. §3.8 forbids
    // repairing it without an explicit user command, so refuse and say how.
    if toolchain_revocations_corrupt(versions_base) {
        print.err("error: the local revocation ledger is unreadable; refusing to execute "
            + target);
        print.err("  " + toolchain_revocations_path(versions_base));
        print.err("  delete that file to re-fetch revocation state on the next install");
        return 1;
    }

    let revoked = toolchain_revocations_read(versions_base);
    if toolchain_revocation_find(revoked, "release", target) >= 0 {
        print.err("error: toolchain " + target
            + " is revoked and will not be executed");
        print.err("  " + toolchain_known_sequence_note(toolchain_known_sequence(revoked)));
        print.err("  revocation has no override; select a different version");
        return 1;
    }

    // SFEP-0073 §3.8: hash the selected executable against its install
    // manifest before re-exec. `process.exec` replaces this image, so this is
    // the last instruction that can refuse a modified stored binary. A legacy
    // entry has no manifest and stays on the unverified path warned about
    // above (SFN-1064).
    let exe_ok = toolchain_verify_executable(entry.dir);
    if !exe_ok.ok {
        toolchain_print_integrity_failure(entry.dir, target, exe_ok);
        return 1;
    }

    let mut exec_argv: string[] = [entry.binary];
    let mut i: int = 0;
    loop {
        if i >= ctx.orig_args.length { break; }
        exec_argv.push(ctx.orig_args[i]);
        i += 1;
    }
    let _rc = process.exec(exec_argv, _dispatch_child_env(target));
    print.err("error: failed to re-exec the pinned toolchain at " + entry.binary);
    print.err("  run: sfn toolchain install " + target);
    return 1;
}

export {
    toolchain_env_exact_selector,
    toolchain_gate_or_dispatch,
    toolchain_select_exact,
    toolchain_select_project_exact,
    toolchain_select_user_default
};
