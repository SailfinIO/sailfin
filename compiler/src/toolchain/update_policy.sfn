// compiler/src/toolchain/update_policy.sfn
//
// The user-controlled network policy and the pure update decision behind
// `sfn toolchain update` (SFEP-0073 §§3.4, 3.6, SFN-1071). Three concerns
// share this file because they share one rule: nothing here downloads,
// installs, or writes. The network gate answers "may a release endpoint be
// contacted at all"; the plan answers "is this channel's head strictly newer
// than what would be replaced"; the manifest rewrite produces the byte-stable
// text an atomic commit publishes. Holding no `![net]` keeps every decision
// testable against strings and struct literals, the same discipline as
// `release_policy.sfn`.
//
// `install.sfn` imports the gate, so this module must never import
// `install.sfn`: validating a resolved version for the store is the
// installer's job at its own boundary.
import { _toml_trim_cmd } from "../build/fs";
import { _get_home_cmd } from "../build_flags";
import {
    semver_compare,
    semver_is_exact_release,
    semver_is_valid,
    semver_parse
} from "../semver";
import {
    char_code_at_text,
    find_char_local,
    strings_equal,
    substring
} from "../string_utils";
import { toml_get_string } from "../toml_parser";
import { _strip_build_metadata } from "../version";
import { toolchain_channel_refusal, toolchain_channel_resolve } from "./channel";
import { ToolchainIndex } from "./index";
import { ToolchainRevocationRecord } from "./index_cache";

let TOOLCHAIN_UPDATE_POLICY_NOTIFY: string = "notify";
let TOOLCHAIN_UPDATE_POLICY_MANUAL: string = "manual";
let TOOLCHAIN_UPDATE_POLICY_DISABLED: string = "disabled";

// The `sfn config` spelling of the key, and where it lives in
// `~/.sfn/config.toml`. The file is the same one `sfn config set registry`
// owns; `SAILFIN_CONFIG_DIR` relocates only the toolchain-default record,
// never this file, so a policy is always read from the real home.
let TOOLCHAIN_UPDATE_POLICY_KEY: string = "toolchain.update-policy";
let TOOLCHAIN_UPDATE_POLICY_SECTION: string = "toolchain";
let TOOLCHAIN_UPDATE_POLICY_FIELD: string = "update-policy";

fn toolchain_update_policy_is_valid(value: string) -> boolean {
    if strings_equal(value, TOOLCHAIN_UPDATE_POLICY_NOTIFY) { return true; }
    if strings_equal(value, TOOLCHAIN_UPDATE_POLICY_MANUAL) { return true; }
    return strings_equal(value, TOOLCHAIN_UPDATE_POLICY_DISABLED);
}

// Pure: the policy a `config.toml` text declares. An absent key is `notify`,
// the SFEP-0073 §3.6 default. A present but unrecognized value is returned
// verbatim rather than coerced to the default, so the gate can fail closed
// and name it — a hand-edited typo of `disabled` must not silently become
// the permissive policy.
fn toolchain_update_policy_from_config(text: string) -> string {
    let raw = _toml_trim_cmd(toml_get_string(text, TOOLCHAIN_UPDATE_POLICY_SECTION, TOOLCHAIN_UPDATE_POLICY_FIELD));
    if raw.length == 0 { return TOOLCHAIN_UPDATE_POLICY_NOTIFY; }
    return raw;
}

// "" when the home directory is unresolvable; the caller treats that as
// "no configuration", never as an error, matching `cmd_shared.sfn`'s
// registry reader.
fn toolchain_update_policy_config_path() -> string ![io] {
    let home = _get_home_cmd();
    if home.length == 0 { return ""; }
    return home + "/.sfn/config.toml";
}

fn toolchain_update_policy_read() -> string ![io] {
    let path = toolchain_update_policy_config_path();
    if path.length == 0 { return TOOLCHAIN_UPDATE_POLICY_NOTIFY; }
    if !fs.exists(path) { return TOOLCHAIN_UPDATE_POLICY_NOTIFY; }
    return toolchain_update_policy_from_config(fs.readFile(path));
}

// "" when a release endpoint may be contacted; otherwise the refusal to
// print (first line bare, continuation lines indented), produced before any
// request is made. `notify` and `manual` both permit an explicit `install`,
// `update`, or `update --check` — they differ only in the opportunistic
// check SFEP-0073 §3.6 adds (SFN-1073). `disabled` is the air-gap policy:
// local selection, inspection, verification, defaults, and removal never
// pass through here, so they keep working. An unrecognized value refuses
// too — see `toolchain_update_policy_from_config`.
fn toolchain_network_refusal() -> string ![io] {
    let policy = toolchain_update_policy_read();
    if strings_equal(policy, TOOLCHAIN_UPDATE_POLICY_NOTIFY) { return ""; }
    if strings_equal(policy, TOOLCHAIN_UPDATE_POLICY_MANUAL) { return ""; }
    if strings_equal(policy, TOOLCHAIN_UPDATE_POLICY_DISABLED) {
        return "toolchain update policy is disabled; refusing to contact the release endpoint\n"
            + "  installed toolchains, defaults, inspection, verification, and removal still work\n"
            + "  to allow explicit network commands: sfn config set toolchain.update-policy manual";
    }
    return "toolchain update policy \"" + policy + "\" is not recognized ("
        + toolchain_update_policy_config_path()
        + ")\n  expected one of: notify, manual, disabled\n  repair it with: sfn config set toolchain.update-policy notify";
}

// The decision `update` and `update --check` act on. `head` is what the
// channel resolves to for this host regardless of ordering; `candidate` is
// `head` only when it is strictly newer than `current`, else "" — so
// `available` and a non-empty `candidate` always agree, and the JSON
// envelope's `candidate` is `null` exactly when nothing would change.
struct ToolchainUpdatePlan {
    ok: boolean;
    reason: string;  // "" when ok
    channel: string;
    current: string;
    head: string;  // "" when the channel resolves to nothing
    candidate: string;  // "" unless strictly newer than `current`
    available: boolean;
}

fn _plan_failure(channel: string, current: string, reason: string) -> ToolchainUpdatePlan {
    return ToolchainUpdatePlan {
        ok: false,
        reason: reason,
        channel: channel,
        current: current,
        head: "",
        candidate: "",
        available: false
    };
}

// Pure. `channel` is already canonical (`toolchain_channel_canonical`);
// `current` is the exact version an update would replace — the recorded
// default, the project's `[toolchain] version`, or the entry toolchain.
//
// A candidate is offered only under strict semver precedence. Equal and
// older heads plan as "no update", and so does a channel transition whose
// head ranks below `current` (a stable `0.11.0` asked to move to a beta
// `0.11.0-beta.2`): SFEP-0073 §3.4 says no update command downgrades, and an
// intentional step down uses `default`, `+<version>`, or a project edit.
// Failures here are policy/network failures (exit 2), never data: a channel
// with no resolvable head cannot answer "is there an update".
fn toolchain_update_plan(index: ToolchainIndex, known: ToolchainRevocationRecord[], channel: string, host_triple: string, current: string) -> ToolchainUpdatePlan {
    // An index that was never obtained has no channels, and
    // `toolchain_channel_refusal` would read that as "publishes no <channel>
    // release" — blaming the publisher for an unreachable endpoint. The
    // acquisition failure is the truthful reason, so it wins.
    if !index.ok { return _plan_failure(channel, current, index.error); }
    let head = toolchain_channel_resolve(index, known, channel, host_triple);
    if head.length == 0 {
        return _plan_failure(channel, current, toolchain_channel_refusal(index, known, channel, host_triple));
    }
    // The head goes on to name a store path, a URL, and a manifest value, so
    // it must be an exact release identity — no alias, no build metadata —
    // rather than a trusted map key taken at its word.
    if !semver_is_exact_release(head) {
        return _plan_failure(channel, current, "the signed index resolved "
            + channel
            + " to a malformed version: \""
            + head
            + "\"");
    }
    let current_v = semver_parse(_strip_build_metadata(current));
    if !semver_is_valid(current_v) {
        return _plan_failure(channel, current, "cannot compare against the current toolchain version \""
            + current
            + "\"");
    }
    let available = semver_compare(semver_parse(head), current_v) > 0;
    let mut candidate: string = "";
    if available { candidate = head; }
    return ToolchainUpdatePlan {
        ok: true,
        reason: "",
        channel: channel,
        current: current,
        head: head,
        candidate: candidate,
        available: available
    };
}

fn _is_blank_byte(code: int) -> boolean { return code == 32 || code == 9; }

// `<ws>version<ws>=<ws>"<old>"<rest>` becomes the same line with `<new>`
// between the quotes; every other byte of the line — indentation, spacing
// around `=`, the quote style, a trailing comment, a `\r` — is kept. "" when
// the line is not a quoted `version` assignment.
fn _rewrite_version_line(line: string, version: string) -> string {
    let eq = find_char_local(line, "=", 0);
    if eq < 0 { return ""; }
    if !strings_equal(_toml_trim_cmd(substring(line, 0, eq)), "version") {
        return "";
    }
    let mut v: int = eq + 1;
    loop {
        if v >= line.length { break; }
        if !_is_blank_byte(char_code_at_text(line, v)) { break; }
        v += 1;
    }
    if v >= line.length { return ""; }
    let quote = substring(line, v, v + 1);
    if quote != "\"" && quote != "'" { return ""; }
    let close = find_char_local(line, quote, v + 1);
    if close < 0 { return ""; }
    return substring(line, 0, v + 1) + version + substring(line, close, line.length);
}

// Pure and byte-stable: `text` with the value of the first `version` key
// inside `[toolchain]` replaced by `version`, and no other byte changed —
// not `sfn`, not `channel`, not comments, blank lines, or line endings.
// SFEP-0073 §3.4: `update --project` "atomically updates only the root's
// `version` field", so this is a splice, never a regenerate like
// `toml_parser.sfn::toml_add_dependency`. Returns "" when the root has no
// such key: a root without an exact version is not an update target, and
// the caller refuses rather than inventing the field (that is `sfn init`'s
// job, SFN-1070).
fn toolchain_manifest_set_version(text: string, version: string) -> string {
    let mut out: string = "";
    let mut section: string = "";
    let mut replaced: boolean = false;
    let mut start: int = 0;
    let length = text.length;
    let mut i: int = 0;
    loop {
        if i > length { break; }
        let at_end = i == length;
        if at_end || char_code_at_text(text, i) == 10 {
            let line = substring(text, start, i);
            let mut emitted = line;
            if !replaced {
                let trimmed = _toml_trim_cmd(line);
                if trimmed.length > 0 {
                    let first = substring(trimmed, 0, 1);
                    if first == "[" {
                        let close = find_char_local(trimmed, "]", 0);
                        if close > 0 {
                            section = _toml_trim_cmd(substring(trimmed, 1, close));
                        }
                    } else if first != "#" && strings_equal(section, TOOLCHAIN_UPDATE_POLICY_SECTION) {
                        let rewritten = _rewrite_version_line(line, version);
                        if rewritten.length > 0 {
                            emitted = rewritten;
                            replaced = true;
                        }
                    }
                }
            }
            out = out + emitted;
            if !at_end { out = out + "\n"; }
            start = i + 1;
        }
        i += 1;
    }
    if !replaced { return ""; }
    return out;
}

export {
    TOOLCHAIN_UPDATE_POLICY_DISABLED,
    TOOLCHAIN_UPDATE_POLICY_KEY,
    TOOLCHAIN_UPDATE_POLICY_MANUAL,
    TOOLCHAIN_UPDATE_POLICY_NOTIFY,
    ToolchainUpdatePlan,
    toolchain_manifest_set_version,
    toolchain_network_refusal,
    toolchain_update_plan,
    toolchain_update_policy_config_path,
    toolchain_update_policy_from_config,
    toolchain_update_policy_is_valid,
    toolchain_update_policy_read
};
