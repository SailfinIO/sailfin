// compiler/src/typecheck_types/annotation_shape_checks.sfn
//
// Bare fn-type / malformed-array / unknown-type annotation shape checks.
// Extracted from typecheck_types.sfn (SFN-625).
import {
    char_code_at,
    ends_with,
    find,
    starts_with,
    strings_equal,
    substring
} from "sfn/strings";

import { SourceSpan, TypeAnnotation, TypeParameter } from "../ast";
import { FixSuggestion } from "../diagnostic";
import { Token } from "../token";
import { Diagnostic } from "../typecheck_types";
import { slice_text, token_from_name, trim_text } from "./text_utils";

// A "bare" function-type annotation — `( ... ) -> R` written without the
// leading `fn` keyword (e.g. `(int) -> int`). The parser accepts this
// spelling, but lowering maps it to an opaque `i8*` pointer instead of the
// `{i8*, i8*}` closure pair, silently miscompiling to wrong runtime output
// that `sfn check` does not otherwise catch (#1845). Sailfin has exactly one
// canonical function-type spelling, `fn(...) -> R` (spec §5, SFEP-0030),
// matching Go (`func(int) int`) and Rust (`fn(i32) -> i32`); the bare form is
// rejected with E0826 so a second spelling never takes root and `(T)` stays
// free for a future grouping/tuple meaning.
//
// Mirrors the balanced-paren scan of `_parse_fn_pointer_annotation`
// (llvm/expression_lowering/native/core_call_resolution/closure_callee.sfn): open with `(`
// (not the canonical `fn(` / `fn (`), find the matching close-paren by depth,
// and require `->` immediately after it. This recognizes the annotation whose
// outermost spelling is the bare arrow; a bare fn-type nested inside another
// type constructor (`((int) -> int)[]`, `Array<(int) -> int>`) is not matched
// textually and stays the province of the broader function-value work
// (SFEP-0030), which will type these positions structurally.
fn _is_bare_fn_type_annotation(annotation: string) -> boolean {
    let trimmed = trim_text(annotation);
    // Canonical spellings are always accepted.
    if starts_with(trimmed, "fn(") { return false; }
    if starts_with(trimmed, "fn (") { return false; }
    // The bare form must open with a parameter-list paren.
    if !starts_with(trimmed, "(") { return false; }
    let mut cursor: int = 1;
    let mut depth: int = 1;
    let mut params_end: int = -1;
    loop {
        if cursor >= trimmed.length { break; }
        let ch = substring(trimmed, cursor, cursor + 1);
        if ch == "(" { depth += 1; }
        if ch == ")" {
            depth -= 1;
            if depth == 0 {
                params_end = cursor;
                break;
            }
        }
        cursor += 1;
    }
    if params_end < 0 { return false; }
    let after = trim_text(substring(trimmed, params_end + 1, trimmed.length));
    return starts_with(after, "->");
}

// E0826: a bare `(...) -> R` function-type annotation. The fix-it steers to
// the canonical `fn(...) -> R` spelling (prefix the bare text with `fn`).
fn make_bare_fn_type_diagnostic(type_text: string, anchor: Token?) -> Diagnostic {
    let bare = trim_text(type_text);
    let canonical = "fn" + bare;
    let fix = FixSuggestion {
        message: "write the function type as `" + canonical
            + "` — Sailfin's one canonical spelling is `fn(...) -> R`",
        edits: []
    };
    return Diagnostic {
        code: "E0826",
        severity: "error",
        message: "bare function-type annotation `" + bare
            + "` is not supported; write it as `"
            + canonical
            + "`",
        file_path: "",
        primary: anchor,
        suggestion: fix
    };
}

// Reject a bare `(...) -> R` function-type annotation in any position that
// accepts a type annotation (fn/method/interface signatures, variable
// declarations, struct fields, lambda params/returns). Returns a single
// E0826 diagnostic anchored to `anchor_name`/`anchor_span`, or `[]` when the
// annotation is absent or already the canonical `fn(...)` spelling.
fn check_bare_fn_type_annotation(annotation: TypeAnnotation?, anchor_name: string, anchor_span: SourceSpan?) -> Diagnostic[] {
    if annotation == null { return []; }
    if !_is_bare_fn_type_annotation(annotation.text) { return []; }
    return [make_bare_fn_type_diagnostic(annotation.text, token_from_name(anchor_name, anchor_span))];
}

// E0830: a malformed array-type spelling. Canonical Sailfin arrays are the
// `T[]` suffix form; no valid type annotation begins with `[`, so a `[`-leading
// spelling is always malformed. Steers to the canonical `T[]` form —
// `[]string` -> `string[]`, `[int]` -> `int[]` (SFN-385).
fn make_malformed_array_annotation_diagnostic(type_text: string, suggested: string, anchor: Token?) -> Diagnostic {
    let bare = trim_text(type_text);
    let mut fix_message: string = "Sailfin arrays are written `T[]` (element type followed by `[]`)";
    if suggested.length > 0 { fix_message = "write it as `" + suggested + "`"; }
    let fix = FixSuggestion { message: fix_message, edits: [] };
    return Diagnostic {
        code: "E0830",
        severity: "error",
        message: "malformed array type `" + bare
            + "`; Sailfin arrays are written `T[]`",
        file_path: "",
        primary: anchor,
        suggestion: fix
    };
}

// Reject a malformed array-type spelling in any position that accepts a type
// annotation. Fires only when the (trimmed) annotation begins with `[` — no
// canonical Sailfin type spelling does, so this cannot flag a valid type. The
// suggested fix-it reconstructs the canonical `T[]` form from `[]T` or `[T]`.
fn check_malformed_array_annotation(annotation: TypeAnnotation?, anchor_name: string, anchor_span: SourceSpan?) -> Diagnostic[] {
    if annotation == null { return []; }
    let trimmed = trim_text(annotation.text);
    if !starts_with(trimmed, "[") { return []; }
    let mut inner: string = "";
    if starts_with(trimmed, "[]") {
        inner = trim_text(slice_text(trimmed, 2, trimmed.length));
    } else if ends_with(trimmed, "]") {
        inner = trim_text(slice_text(trimmed, 1, trimmed.length - 1));
    }
    let mut suggested: string = "";
    if inner.length > 0 { suggested = inner + "[]"; }
    return [make_malformed_array_annotation_diagnostic(annotation.text, suggested, token_from_name(anchor_name, anchor_span))];
}

// SFN-555: the primitive spellings a bare annotation may name. Union of
// `classify_declared_primitive`'s arithmetic table and the spellings
// `map_primitive_type` (llvm/type_mapping.sfn) lowers, so a name accepted
// here always has a lowering. `void`, `any`, and the `*opaque` pointee
// carry no arithmetic class and so are absent from the former.
fn _is_primitive_type_name(name: string) -> boolean {
    if classify_declared_primitive(name).length > 0 { return true; }
    if strings_equal(name, "void") { return true; }
    if strings_equal(name, "any") { return true; }
    if strings_equal(name, "opaque") { return true; }
    // `Self` is bound implicitly inside an interface body (`fn eq(self, other:
    // Self)`, runtime/prelude.sfn:103) rather than declared anywhere, so no
    // registry carries it.
    if strings_equal(name, "Self") { return true; }
    // `channel` is a builtin type spelling as well as a builtin call name
    // (`is_builtin_call_name`), so `fn produce(ch: channel)` resolves to no
    // source declaration either.
    if strings_equal(name, "channel") { return true; }
    return false;
}

// SFN-555: the bare names bound by a declaration's type-parameter list, so a
// signature's own `<T, E>` resolve as types inside it.
fn type_parameter_names(parameters: TypeParameter[]) -> string[] {
    let mut names: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= parameters.length { break; }
        names.push(parameters[i].name);
        i += 1;
    }
    return names;
}

fn _name_in_list(name: string, names: string[]) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= names.length { break; }
        if strings_equal(names[i], name) { return true; }
        i += 1;
    }
    return false;
}

// `known` and `type_params` stay separate rather than concatenated: `known`
// is the whole program-wide resolution scope, rebuilt per annotation if the
// two were merged at the call site.
fn _type_name_is_known(name: string, known: string[], type_params: string[]) -> boolean {
    if _is_primitive_type_name(name) { return true; }
    if _name_in_list(name, type_params) { return true; }
    return _name_in_list(name, known);
}

// True when every character is identifier-shaped, so the text is a bare name
// this checker is entitled to judge. Anything else is a spelling the
// decomposition below did not model and is waved through.
fn _is_plain_identifier(text: string) -> boolean {
    if text.length == 0 { return false; }
    let mut i: int = 0;
    loop {
        if i >= text.length { break; }
        let code = char_code_at(text, i);
        let mut ok: boolean = false;
        if code == 95 { ok = true; }
        if code >= 48 {
            if code <= 57 { ok = true; }
        }
        if code >= 65 {
            if code <= 90 { ok = true; }
        }
        if code >= 97 {
            if code <= 122 { ok = true; }
        }
        if !ok { return false; }
        i += 1;
    }
    return true;
}

// Split a generic argument list on top-level commas, ignoring commas nested
// inside a further `<...>`.
fn _split_generic_arguments(inner: string) -> string[] {
    let mut parts: string[] = [];
    let mut depth: int = 0;
    let mut start: int = 0;
    let mut i: int = 0;
    loop {
        if i >= inner.length { break; }
        let ch = inner[i];
        if strings_equal(ch, "<") { depth += 1; }
        if strings_equal(ch, ">") { depth -= 1; }
        if strings_equal(ch, ",") {
            if depth == 0 {
                parts.push(slice_text(inner, start, i));
                start = i + 1;
            }
        }
        i += 1;
    }
    parts.push(slice_text(inner, start, inner.length));
    return parts;
}

// SFN-555: reduce `text` to the base type names it references and return the
// first that resolves to nothing known, or "" when all of them resolve.
//
// Deliberately fail-open: any spelling this does not model returns "" and
// raises no diagnostic. A missed typo is the status quo this issue found; a
// false positive rejects valid source and breaks the self-host gate, so every
// unmodelled shape is accepted by construction.
fn _first_unknown_type_name(text: string, known: string[], type_params: string[]) -> string {
    let trimmed = trim_text(text);
    if trimmed.length == 0 { return ""; }

    // Ownership wrappers: judge the owned type. `Affine<T>` / `Linear<T>` are
    // type-level wrappers the lowerer strips (`unwrap_move_wrapper`,
    // llvm/type_mapping.sfn:84) and no source declares them, so the wrapper
    // name itself is never resolvable — only its payload is.
    if starts_with(trimmed, "move ") {
        return _first_unknown_type_name(slice_text(trimmed, 5, trimmed.length), known, type_params);
    }
    let mut _wrapped: boolean = false;
    if starts_with(trimmed, "Affine<") { _wrapped = true; }
    if starts_with(trimmed, "Linear<") { _wrapped = true; }
    if _wrapped {
        if ends_with(trimmed, ">") {
            let open = find(trimmed, "<", 0);
            return _first_unknown_type_name(slice_text(trimmed, open + 1, trimmed.length - 1), known, type_params);
        }
        return "";
    }

    // A raw pointer's pointee is not judged. `*T` is the FFI boundary, where
    // an opaque C handle that no Sailfin declaration describes is the normal
    // case — `*File` from `fopen` (runtime/sfn/adapters/filesystem.sfn:494) is
    // the motivating example.
    if starts_with(trimmed, "*") { return ""; }

    // Optional and array suffixes: judge the element.
    if ends_with(trimmed, "?") {
        return _first_unknown_type_name(slice_text(trimmed, 0, trimmed.length - 1), known, type_params);
    }
    if ends_with(trimmed, "[]") {
        return _first_unknown_type_name(slice_text(trimmed, 0, trimmed.length - 2), known, type_params);
    }

    // A leading `[` is the malformed-array spelling E0830 already reports;
    // staying silent here keeps one diagnostic per mistake.
    if starts_with(trimmed, "[") { return ""; }

    // Function types, intersections, module-qualified names, and any spaced
    // spelling are not modelled — E0826 owns the bare `(...) -> R` reject, and
    // a qualified name resolves through an import this checker cannot see.
    if find(trimmed, "(", 0) >= 0 { return ""; }
    if find(trimmed, "&", 0) >= 0 { return ""; }
    if find(trimmed, ".", 0) >= 0 { return ""; }
    if find(trimmed, " ", 0) >= 0 { return ""; }

    // Generic instantiation `Base<Args>`: judge the base, then each argument.
    if ends_with(trimmed, ">") {
        let open = find(trimmed, "<", 0);
        if open <= 0 { return ""; }
        let base = trim_text(slice_text(trimmed, 0, open));
        if !_is_plain_identifier(base) { return ""; }
        if !_type_name_is_known(base, known, type_params) { return base; }
        let inner = slice_text(trimmed, open + 1, trimmed.length - 1);
        let arguments = _split_generic_arguments(inner);
        let mut i: int = 0;
        loop {
            if i >= arguments.length { break; }
            let unknown = _first_unknown_type_name(arguments[i], known, type_params);
            if unknown.length > 0 { return unknown; }
            i += 1;
        }
        return "";
    }

    if !_is_plain_identifier(trimmed) { return ""; }
    if _type_name_is_known(trimmed, known, type_params) { return ""; }
    return trimmed;
}

fn make_unknown_type_diagnostic(name: string, anchor: Token?) -> Diagnostic {
    let fix = FixSuggestion {
        message: "declare `" + name + "` or correct the spelling",
        edits: []
    };
    return Diagnostic {
        code: "E0013",
        severity: "error",
        message: "unknown type `" + name + "`",
        file_path: "",
        primary: anchor,
        suggestion: fix
    };
}

// Reject a type annotation naming a type that resolves to no primitive, no
// declared struct/enum/interface/alias, no imported symbol, no prelude
// declaration, and no in-scope type parameter. `known` carries the latter
// four; primitives are built in.
//
// `TypeAnnotation` carries no span of its own, so the caret lands on the
// declared name (`anchor_name`/`anchor_span`) — the same anchoring E0826 and
// E0830 use for annotation diagnostics. Giving the annotation its own span
// would mean adding a field to `TypeAnnotation`, whose size is pinned at one
// pointer in `emit_native_layout.canonical_type_layouts()`; that table is
// consulted ahead of the real struct definition (emit_native_layout.sfn:418),
// so a second field is written outside the allocation.
fn check_unknown_type_annotation(annotation: TypeAnnotation?, anchor_name: string, anchor_span: SourceSpan?, known: string[], type_params: string[]) -> Diagnostic[] {
    if annotation == null { return []; }
    let unknown = _first_unknown_type_name(annotation.text, known, type_params);
    if unknown.length == 0 { return []; }
    return [make_unknown_type_diagnostic(unknown, token_from_name(anchor_name, anchor_span))];
}

// The normalized closed primitive kind an explicit type annotation denotes,
// or "" for anything compound (array `T[]`, optional `T?`, generic `<...>`,
// pointer `*`, fn-type, spaced/qualified) or any non-primitive/user type. The
// "" sentinel is fail-open: a use-site check (SFN-385 unknown-method /
// mixed-arithmetic) must never fire on it. Integer widths collapse to "int"
// and float widths to "float", matching `numeric_type_kind`'s granularity.
fn classify_declared_primitive(annotation: string) -> string {
    let trimmed = trim_text(annotation);
    if trimmed.length == 0 { return ""; }
    // Any compound-type punctuation or internal space disqualifies: arrays
    // (`[`/`]`), optionals (`?`), generics (`<`/`>`), pointers (`*`),
    // fn-types (`(`), qualified/spaced spellings. Only a bare primitive word
    // survives to the closed tables below.
    let mut i: int = 0;
    loop {
        if i >= trimmed.length { break; }
        let ch = trimmed[i];
        if strings_equal(ch, "[") { return ""; }
        if strings_equal(ch, "]") { return ""; }
        if strings_equal(ch, "?") { return ""; }
        if strings_equal(ch, "<") { return ""; }
        if strings_equal(ch, ">") { return ""; }
        if strings_equal(ch, "*") { return ""; }
        if strings_equal(ch, "(") { return ""; }
        if strings_equal(ch, " ") { return ""; }
        i += 1;
    }
    if strings_equal(trimmed, "string") { return "string"; }
    if strings_equal(trimmed, "SfnString") { return "string"; }
    if strings_equal(trimmed, "int") { return "int"; }
    if strings_equal(trimmed, "i64") { return "int"; }
    if strings_equal(trimmed, "i32") { return "int"; }
    if strings_equal(trimmed, "i16") { return "int"; }
    if strings_equal(trimmed, "i8") { return "int"; }
    if strings_equal(trimmed, "u64") { return "int"; }
    if strings_equal(trimmed, "u32") { return "int"; }
    if strings_equal(trimmed, "u16") { return "int"; }
    if strings_equal(trimmed, "u8") { return "int"; }
    if strings_equal(trimmed, "usize") { return "int"; }
    if strings_equal(trimmed, "isize") { return "int"; }
    if strings_equal(trimmed, "float") { return "float"; }
    if strings_equal(trimmed, "f64") { return "float"; }
    if strings_equal(trimmed, "f32") { return "float"; }
    if strings_equal(trimmed, "f16") { return "float"; }
    if strings_equal(trimmed, "bf16") { return "float"; }
    if strings_equal(trimmed, "number") { return "float"; }
    if strings_equal(trimmed, "boolean") { return "boolean"; }
    if strings_equal(trimmed, "bool") { return "boolean"; }
    return "";
}

// A compact marker for an explicitly-declared array type. SymbolEntry already
// carries collection element metadata for Channel<T>, Task<T>[], and inferred
// empty arrays; using the same fail-open slot avoids widening the scope record
// solely to prove that both operands of a binary expression are arrays.
fn declared_array_marker(annotation: string) -> string {
    let trimmed = trim_text(annotation);
    if trimmed.length < 3 { return ""; }
    if ends_with(trimmed, "[]") { return "array"; }
    return "";
}

fn element_kind_marks_array(element_kind: string) -> boolean {
    if strings_equal(element_kind, "array") { return true; }
    if strings_equal(element_kind, "empty_array") { return true; }
    return starts_with(element_kind, "taskarr:");
}
