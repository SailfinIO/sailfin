// compiler/src/typecheck_types/generic_bounds.sfn
//
// SFEP-0038 generic bound declaration/satisfaction checks.
// Extracted from typecheck_types.sfn (SFN-625).
import {
    SourceSpan,
    Statement,
    TypeAnnotation,
    TypeParameter
} from "../ast";
import { contains_string, strings_equal, substring } from "../string_utils";
import { Diagnostic } from "../typecheck_types";
import {
    format_interface_signature,
    parse_type_arguments,
    resolve_interface_annotation
} from "./interface_and_generics";
import { SymbolEntry, make_duplicate_symbol_diagnostic } from "./symbol_table_and_raw_exprs";
import { token_from_name, trim_text } from "./text_utils";

// Split a type-parameter bound list ("Eq + Comparable<int>") on top-level
// `+`, respecting `(`/`)` and `<`/`>` nesting the same way
// `split_top_level_commas` does (#1868, SFEP-0038 §3.1). Empty segments are
// dropped and each segment is trimmed.
// Split a type-parameter bound list ("Eq + Comparable<int>") on top-level
// `+`, respecting `(`/`)` and `<`/`>` nesting the same way
// `split_top_level_commas` does (#1868, SFEP-0038 §3.1). Empty segments are
// dropped and each segment is trimmed.
fn split_top_level_plus(text: string) -> string[] {
    let mut out: string[] = [];
    let mut current: string = "";
    let mut depth: int = 0;
    let mut index: int = 0;
    loop {
        if index >= text.length { break; }
        let ch = text[index];
        if ch == "(" {
            depth += 1;
            current = current + ch;
        } else if ch == ")" {
            if depth > 0 { depth -= 1; }
            current = current + ch;
        } else if ch == "<" {
            depth += 1;
            current = current + ch;
        } else if ch == ">" {
            if depth > 0 { depth -= 1; }
            current = current + ch;
        } else if ch == "+" {
            if depth == 0 {
                let trimmed = trim_text(current);
                if trimmed.length > 0 { out.push(trimmed); }
                current = "";
                index += 1;
                continue;
            }
            current = current + ch;
        } else { current = current + ch; }
        index += 1;
    }
    let trimmed_last = trim_text(current);
    if trimmed_last.length > 0 { out.push(trimmed_last); }
    return out;
}

fn check_type_parameters(type_parameters: TypeParameter[], interfaces: Statement[], top_level: SymbolEntry[]) -> Diagnostic[] {
    let mut seen: string[] = [];
    let mut diagnostics: Diagnostic[] = [];

    let mut _tpi: int = 0;
    loop {
        if _tpi >= type_parameters.length { break; }
        let type_parameter = type_parameters[_tpi];
        let name = type_parameter.name;
        if contains_string(seen, name) {
            diagnostics.push(make_duplicate_symbol_diagnostic(name, "type parameter", token_from_name(name, type_parameter.span)));
        } else { seen.push(name); }
        _tpi += 1;
    }

    // Declaration-time bound validation (SFEP-0038 §3.1/§3.2a, #1868).
    let mut _bpi: int = 0;
    loop {
        if _bpi >= type_parameters.length { break; }
        let tp = type_parameters[_bpi];
        let tp_bound = tp.bound;
        if tp_bound != null {
            let bound = tp_bound;
            let bound_refs = split_top_level_plus(bound.text);
            let mut _bri: int = 0;
            loop {
                if _bri >= bound_refs.length { break; }
                let ref_text = trim_text(bound_refs[_bri]);
                if ref_text.length > 0 {
                    let d = check_single_bound(ref_text, tp.name, tp.span, interfaces, top_level);
                    if d != null { diagnostics.push(d); }
                }
                _bri += 1;
            }
        }
        _bpi += 1;
    }

    return diagnostics;
}

// Returns the identifier before the first top-level `<` in a bound
// reference, trimmed ("From<int>" -> "From", "Comparable" -> "Comparable").
// Used to resolve a bound to a top-level struct/enum symbol for the E0821
// check (#1868, SFEP-0038 §3.1).
fn bound_base_name(text: string) -> string {
    let trimmed = trim_text(text);
    let mut index: int = 0;
    loop {
        if index >= trimmed.length { break; }
        if trimmed[index] == "<" { break; }
        index += 1;
    }
    return trim_text(substring(trimmed, 0, index));
}

// True if `symbols` contains an entry with this name AND kind.
fn symbol_has_kind(symbols: SymbolEntry[], name: string, kind: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= symbols.length { break; }
        if strings_equal(symbols[i].name, name) && strings_equal(symbols[i].kind, kind) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn make_bound_not_interface_diagnostic(bound_name: string, param_name: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0821",
        severity: "error",
        message: "bound `" + bound_name + "` on type parameter `" + param_name
            + "` is not an interface",
        file_path: "",
        primary: token_from_name(param_name, span),
        suggestion: null
    };
}

fn make_bound_arity_diagnostic(bound_name: string, param_name: string, interface_signature: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0822",
        severity: "error",
        message: "bound `" + bound_name + "` on type parameter `" + param_name
            + "` must match "
            + interface_signature
            + " type arguments",
        file_path: "",
        primary: token_from_name(param_name, span),
        suggestion: null
    };
}

// Validate one bound reference from a `T: Bound1 + Bound2` list against the
// interface table and the top-level symbol table (#1868, SFEP-0038 §3.1).
// Returns `null` when the bound is OK. If the bound resolves to a known
// interface, validates its type-argument arity (E0822). If it does not
// resolve, E0821 fires only when the base name is a KNOWN struct/enum —
// an unresolved name may be a prelude/imported interface not visible in a
// single-file check, so it is left unflagged to avoid false positives on
// std-library bounds.
fn check_single_bound(ref_text: string, param_name: string, span: SourceSpan?, interfaces: Statement[], top_level: SymbolEntry[]) -> Diagnostic? {
    let annotation = TypeAnnotation { text: ref_text, span: null };
    let iface = resolve_interface_annotation(annotation, interfaces);
    if iface != null {
        let found = iface;
        let expected = found.type_parameters.length;
        let provided = parse_type_arguments(ref_text);
        if expected == 0 {
            if provided.length > 0 {
                return make_bound_arity_diagnostic(trim_text(ref_text), param_name, format_interface_signature(found), span);
            }
        } else {
            if provided.length != expected {
                return make_bound_arity_diagnostic(trim_text(ref_text), param_name, format_interface_signature(found), span);
            }
        }
        return null;
    }
    let base = bound_base_name(ref_text);
    if symbol_has_kind(top_level, base, "struct") {
        return make_bound_not_interface_diagnostic(base, param_name, span);
    }
    if symbol_has_kind(top_level, base, "enum") {
        return make_bound_not_interface_diagnostic(base, param_name, span);
    }
    return null;
}

// Locate a top-level interface declaration by its bare name.
fn find_interface_by_name(name: string, interfaces: Statement[]) -> Statement? {
    let mut i: int = 0;
    loop {
        if i >= interfaces.length { break; }
        if strings_equal(interfaces[i].name, name) { return interfaces[i]; }
        i += 1;
    }
    return null;
}

// Locate a top-level struct declaration by its bare name.
fn find_struct_by_name(name: string, structs: Statement[]) -> Statement? {
    let mut i: int = 0;
    loop {
        if i >= structs.length { break; }
        if strings_equal(structs[i].name, name) { return structs[i]; }
        i += 1;
    }
    return null;
}

// True if `struct_decl` declares a method named `method_name`.
fn struct_has_method(struct_decl: Statement, method_name: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= struct_decl.methods.length { break; }
        if strings_equal(struct_decl.methods[i].signature.name, method_name) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Locate a type parameter by name within an in-scope parameter list.
fn find_type_parameter(name: string, params: TypeParameter[]) -> TypeParameter? {
    let mut i: int = 0;
    loop {
        if i >= params.length { break; }
        if strings_equal(params[i].name, name) { return params[i]; }
        i += 1;
    }
    return null;
}

// True if type parameter `param` was itself declared with a bound whose
// base name is `bound_name` (the bound-propagation predicate, §3.1).
fn type_parameter_declares_bound(param: TypeParameter, bound_name: string) -> boolean {
    let b = param.bound;
    if b == null { return false; }
    let bound = b;
    let refs = split_top_level_plus(bound.text);
    let mut i: int = 0;
    loop {
        if i >= refs.length { break; }
        if strings_equal(bound_base_name(trim_text(refs[i])), bound_name) {
            return true;
        }
        i += 1;
    }
    return false;
}

// True iff `struct_decl` implements the interface named `interface_name`:
// it must (1) declare `implements I` nominally AND (2) structurally
// provide every interface member as a method. This is the reusable
// conformance predicate the SFEP calls `struct_implements`, sharing the
// exact nominal+structural test `check_struct_implements_interfaces`
// emits diagnostics for (SFEP-0038 §3.1/§3.2b, #1870) — factored so the
// satisfaction test can query conformance against an arbitrary interface
// without re-walking diagnostics. When the interface is not visible in
// this compilation unit, the nominal `implements` declaration is trusted
// (structural conformance is proven at the struct's own declaration).
fn struct_implements(struct_decl: Statement, interface_name: string, interfaces: Statement[]) -> boolean {
    let mut nominal: boolean = false;
    let mut _ai: int = 0;
    loop {
        if _ai >= struct_decl.implements_types.length { break; }
        if strings_equal(bound_base_name(struct_decl.implements_types[_ai].text), interface_name) {
            nominal = true;
            break;
        }
        _ai += 1;
    }
    if !nominal { return false; }
    let iface = find_interface_by_name(interface_name, interfaces);
    if iface == null { return true; }
    let found = iface;
    let mut _mi: int = 0;
    loop {
        if _mi >= found.members.length { break; }
        if !struct_has_method(struct_decl, found.members[_mi].name) {
            return false;
        }
        _mi += 1;
    }
    return true;
}

// True iff the concrete type argument `concrete` satisfies the single
// bound reference `bound_ref` (one interface, e.g. "Comparable" or
// "From<int>") at an instantiation site (SFEP-0038 §3.1/§3.2b, #1870):
//   1. If `concrete` names an in-scope type parameter, consult ITS own
//      declared bounds — bound propagation: satisfied iff that parameter
//      was itself declared with `bound_ref`.
//   2. Otherwise resolve `concrete` to a struct declaration and ask
//      whether it implements the bound interface.
// Conservative on names it cannot resolve: a bound that does not name a
// known interface, or a concrete type that is neither an in-scope
// parameter nor a known struct (a primitive, enum, or imported type), is
// treated as satisfied — mirroring `check_single_bound`'s leniency so
// std/imported surfaces are not falsely flagged.
fn type_satisfies_bound(concrete: string, bound_ref: string, interfaces: Statement[], structs: Statement[], in_scope_params: TypeParameter[]) -> boolean {
    let bound_name = bound_base_name(bound_ref);
    if find_interface_by_name(bound_name, interfaces) == null { return true; }
    let concrete_name = bound_base_name(concrete);
    let param = find_type_parameter(concrete_name, in_scope_params);
    if param != null {
        let p = param;
        return type_parameter_declares_bound(p, bound_name);
    }
    let struct_decl = find_struct_by_name(concrete_name, structs);
    if struct_decl == null { return true; }
    return struct_implements(struct_decl, bound_name, interfaces);
}

// E0820 — a concrete type argument does not satisfy a declared bound at a
// generic instantiation site (SFEP-0038 §3.2b, #1870). Names the full
// bound (with any type arguments), the offending type, and the type
// parameter. The fix-it hint adapts to the offending type: an in-scope
// type parameter needs a *bound* added (`T: I`), a concrete type needs an
// `implements I` clause. No primary token is set — an `implements`
// annotation carries no span (`TypeAnnotation` is text-only), and the
// enclosing site span does not correspond to the offending type-argument
// text, so a caret there would mis-highlight; the message carries the
// full context instead.
fn make_bound_not_satisfied_diagnostic(concrete: string, bound_display: string, param_name: string, decl_name: string, concrete_is_param: boolean) -> Diagnostic {
    let mut fix: string = "; add `implements " + bound_display + "` to `"
        + concrete
        + "`";
    if concrete_is_param {
        fix = "; add bound `" + bound_display + "` to type parameter `"
            + concrete
            + "`";
    }
    return Diagnostic {
        code: "E0820",
        severity: "error",
        message: "type `" + concrete + "` does not satisfy bound `"
            + bound_display
            + "` on type parameter `"
            + param_name
            + "` of `"
            + decl_name
            + "`"
            + fix,
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// Verify every concrete type argument at a generic instantiation site
// satisfies the bounds declared on the corresponding type parameter
// (SFEP-0038 §3.2b, #1870). `decl_type_parameters` are the instantiated
// declaration's parameters (carrying their bounds); `type_arguments` are
// the concrete arguments supplied at the site; `in_scope_params` are the
// type parameters visible at the site (for bound propagation). Emits one
// E0820 per unsatisfied (argument, bound) pair. Positions past the
// shorter of the two lists are ignored — arity is validated separately
// (E0822 at declaration; the interface/enum arity checks at use sites).
fn check_generic_instantiation(decl_name: string, decl_type_parameters: TypeParameter[], type_arguments: string[], interfaces: Statement[], structs: Statement[], in_scope_params: TypeParameter[]) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];
    let mut limit: int = decl_type_parameters.length;
    if type_arguments.length < limit { limit = type_arguments.length; }
    let mut index: int = 0;
    loop {
        if index >= limit { break; }
        let param = decl_type_parameters[index];
        let concrete = trim_text(type_arguments[index]);
        let concrete_is_param = find_type_parameter(bound_base_name(concrete), in_scope_params) != null;
        let tp_bound = param.bound;
        if tp_bound != null {
            let bound = tp_bound;
            let refs = split_top_level_plus(bound.text);
            let mut _bri: int = 0;
            loop {
                if _bri >= refs.length { break; }
                let ref_text = trim_text(refs[_bri]);
                if ref_text.length > 0 {
                    if !type_satisfies_bound(concrete, ref_text, interfaces, structs, in_scope_params) {
                        diagnostics.push(make_bound_not_satisfied_diagnostic(concrete, ref_text, param.name, decl_name, concrete_is_param));
                    }
                }
                _bri += 1;
            }
        }
        index += 1;
    }
    return diagnostics;
}
