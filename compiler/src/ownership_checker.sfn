// compiler/src/ownership_checker.sfn
//
// Standalone ownership-checker pass (D7) for the Sailfin self-hosted
// compiler — the move core of the memory-safety epic (#1209). E4
// (#1213) landed this pass dormant (Phase R0); E5 (#1214) turned on the
// move half (`E0901`/`E0904`). E6 (#1215) added the in-place-mutation,
// use-after-free, and raw-pointer-escape rules that close the #1205
// hazard class structurally. **E7 (#1216) adds the linear
// must-be-consumed rule (`E0907`)**: a `Linear<T>` value must be used
// exactly once.
//
// What this pass enforces (scoped strictly to owned/affine-typed
// bindings — `OwnedBuf`, `Affine<T>`, `Linear<T>`, `Task<T>` — plus the
// nursery provenance of copyable `Channel` handles; every other value is
// copyable and untracked, so the compiler's own source — which uses no owned
// types — is unaffected and keeps self-hosting):
//
//   - **Move sites** consume an owned binding (`Owned -> Moved`):
//       * `let y = x;`        (a bare-identifier initializer)
//       * `f(..., x, ...)`    (a bare-identifier call argument)
//       * `return x;`         (a bare-identifier return value)
//   - **Use-after-move** — referencing a `Moved` owned binding:
//       * a read / pass / return of the moved value  -> `E0901`
//       * binding it to a fresh name (`let z = x;`)   -> `E0904`
//   - **Disposal** consumes an owned binding (`Owned -> Freed`):
//       * `free(x)` / `drop(x)`   (a disposer free-function call)
//       * `x.free()` / `x.drop()` (a disposer method call)
//   - **Use-after-free** — referencing a `Freed` owned binding -> `E0903`.
//   - **In-place mutation of a stale (possibly-aliased) buffer**: a
//     mutator method (`x.grow/.append/.set(...)`) on an owned receiver
//     that is already `Moved`/`Freed` — the bytes are aliased by the
//     move/free target -> `E0902`. Mutation through the *unique* live
//     owner stays clean (the receiver keeps state `Owned`), which is the
//     sound grow-at-tip path. These mutator methods denote an in-place
//     `&mut self` surface (proposal §3.2), *distinct from* the shipped
//     consume-and-return free function `owned_buf_append(self) ->
//     OwnedBuf` (§4.2): the free-function form moves its bare-identifier
//     receiver and is already covered by the move rules above, so the
//     two surfaces are complementary, not contradictory. E8 settles
//     which surface the migrated runtime uses.
//   - **Raw-pointer escape across the FFI boundary** — passing a bare
//     owned identifier directly into an `extern fn` call outside an
//     `unsafe` region -> `E0906`. The runtime's libc calls pass raw
//     `* u8` / `Cast` arguments (untracked), never a bare owned
//     identifier, so this stays dormant on the un-migrated runtime.
//   - **Linear value never consumed** — a `Linear<T>` binding (param or
//     `let`, and any `let` that inherits linearity by moving a linear
//     value into a fresh name) still in state `Owned` at scope exit was
//     never consumed -> `E0907`. Swept at routine and nested-block
//     boundaries. `OwnedBuf`/`Affine<T>` are at-most-once (not linear)
//     and exempt. Consumption is recognized straight-line within the
//     declaring scope (the narrow 1.0 subset; branch-local moves are not
//     lifted, matching the use-after-move analysis).
//   - **Task handle single-use** — direct `await`, movement into an array,
//     and `join_all` consume `Task<T>` / `Task<T>[]`; a later use raises
//     concurrency-specific `E0837` rather than generic `E0901`.
//   - **Nursery handle lifetime** — a Task or Channel created in a
//     `routine {}` may remain local, but a still-live handle in a parent
//     binding at nursery exit raises `E0838`.
//
//   Diagnostics carry two locations — the offending use plus the move /
//   free that invalidated it — embedded in the message (the `Diagnostic`
//   model is single-caret; the invalidating site rides in the note line,
//   the same shape the effect checker uses for its "required by" pairs).
//   `E0906` is a single-span boundary check (no second site).
//
// Model A (locked 2026-06-11): a rebind is a move. `let y = x` moves
// `x` into `y`; a later reference to `x` is the violation. The clean
// move-and-consume program (`let y = x; consume(y);`, `x` never touched
// again) compiles with zero findings — no false positives.
//
// Self-host invariant (load-bearing): generic owned-value moves retain their
// established lexical floor, so `OwnedBuf` early-return patterns keep
// self-hosting. Task bindings are the deliberate exception: unconditional
// blocks propagate their state, while alternatives and maybe-zero loops use a
// conservative `owned`/`moved` join. This closes Task duplication without
// changing the mature generic ownership behavior.
//
// The `unsafe` boundary (E2 / #1211) is unchanged: `unsafe { }`
// interiors and `unsafe fn` bodies are skipped — the author-asserted
// raw-pointer region the checker must not second-guess. `E0906` needs no
// extra region flag: an `unsafe { }` interior is already skipped before
// any call site inside it is reached.
//
// Out of scope (later rungs): shared borrows / `Slice`-view alias
// tracking (Phase U), the `E0905` return-of-local-reference rule
// (Phase U), and the opaque `Raw` assignment form (`y = x` parses to
// `Raw` text).
//
// Proposal §3.2 / §3.3 / §4; epic #1209; this issue: #1216.
import { int_to_string } from "sfn/strings";
import {
    Block,
    Expression,
    Parameter,
    Program,
    SourceSpan,
    Statement
} from "sfn/syntax";
import { Token, TokenKind } from "sfn/syntax";

import { ImportSymbolTable, empty_import_symbols } from "./effect_imports";
import {
    block_proves_fresh_channel_returns,
    block_proves_fresh_task_returns,
    channel_return_key,
    channel_type_is_bearing,
    declared_callable_key,
    fresh_channel_key,
    fresh_task_key,
    gather_block_task_returning_names,
    gather_task_returning_names,
    task_field_type,
    task_method_key,
    task_type_is_bearing
} from "./ownership_task_provenance";
import { LocalBinding, analyze_lambda } from "./typecheck_captures";
import { is_linear_type, is_owned_type, is_task_type } from "./typecheck_types/expr_type_rules";
import { is_identifier_char, trim_text } from "./typecheck_types/text_utils";

// One tracked binding. `state` is the lattice: "owned" on entry,
// "moved" once a move site consumes it, "freed" once a disposer consumes
// it. `is_owned` flags the bindings the rules apply to (owned/affine
// type); copyable bindings stay `is_owned == false` and no rule ever
// fires on them. `is_linear` additionally flags the subset that must be
// consumed *exactly once* (`Linear<T>`): such a binding still in state
// "owned" at scope exit is unconsumed and fires `E0907`. Affine/`OwnedBuf`
// bindings are at-most-once (`is_linear == false`) and are exempt from
// that sweep. `moved_span` records *where* the move/free happened so
// use-after-move / use-after-free diagnostics can point back at it.
// Shadowing is by position — the most recently pushed binding for a name
// wins.
struct OwnershipBinding {
    name: string;
    alias_roots: int[];
    declared_type: string;
    state: string;
    span: SourceSpan?;
    is_owned: boolean;
    is_linear: boolean;
    is_task: boolean;
    is_channel: boolean;
    nursery_bound: boolean;
    nursery_span: SourceSpan?;
    moved_span: SourceSpan?;
}

// An ownership finding. Findings mint `severity == "error"` with a
// `code` (`E0837`/`E0838`, `E0901`–`E0907`), the offending-use token (`trigger`), and the
// move/free-site token (`moved_trigger`) so callers and tests can
// inspect both spans structurally; the rendered message embeds both
// locations.
struct OwnershipWarning {
    routine_name: string;
    binding_name: string;
    message: string;
    trigger: Token?;
    severity: string;
    code: string;
    moved_trigger: Token?;
}

// Threaded walk state. `bindings` is the lexical environment at the
// current program point; `tracked` is the monotone count of every
// binding the walk has entered (the unit tests pin coverage through
// it); `findings` is the accumulated diagnostic stream, propagated out
// of every child scope even though child bindings are discarded.
// `extern_names` is the program-level set of `extern fn` names, gathered
// once and threaded read-only so the `E0906` escape check can recognize
// an FFI callee without re-walking the program. `routine_outer_count` is -1
// outside a nursery and otherwise records the parent-binding prefix whose live
// nursery-origin Task or Channel values must not cross the current boundary.
struct OwnershipScope {
    bindings: OwnershipBinding[];
    tracked: int;
    findings: OwnershipWarning[];
    extern_names: string[];
    task_returning_names: string[];
    routine_outer_count: int;
}

// Program-level result: the binding-coverage summary plus the findings
// stream.
struct OwnershipSummary {
    bindings_tracked: int;
    warnings: OwnershipWarning[];
}

// -------------------------------------------------------------------
// Leaf helpers
// -------------------------------------------------------------------
// Owned/affine-type classification (`OwnedBuf`, `Affine<T>`, `Linear<T>`)
// is shared with the typecheck side via `is_owned_type` in
// `typecheck_types/expr_type_rules.sfn` so the two passes can't drift as new owned
// wrappers are added. Integer formatting reuses `int_to_string` from
// `sfn/strings`.
// Synthesize an identifier token from an AST span so the finding can
// feed the shared diagnostic renderer (which keys carets off a Token).
fn _token_from_span(name: string, span: SourceSpan?) -> Token? {
    if span == null { return null; }
    let s: SourceSpan = span;
    return Token {
        kind: TokenKind.Identifier(),
        lexeme: name,
        line: s.start_line,
        column: s.start_column
    };
}

// " at <line>:<col>" for a span, or "" when the span is unknown.
fn _span_location(span: SourceSpan?) -> string {
    if span == null { return ""; }
    let s: SourceSpan = span;
    return " at " + int_to_string(s.start_line) + ":" + int_to_string(s.start_column);
}

// The in-place mutator method set (proposal §3.2). A call of the shape
// `x.grow/.append/.set(...)` on an owned receiver is an in-place
// mutation: sound through the unique owner, an `E0902` violation on a
// stale (moved/freed) receiver.
fn _is_mutator_method(member: string) -> boolean {
    if member == "grow" { return true; }
    if member == "append" { return true; }
    if member == "set" { return true; }
    return false;
}

// Disposer names. `free`/`drop` consume an owned binding (`Owned ->
// Freed`); a later use is use-after-free (`E0903`).
fn _is_disposer_name(name: string) -> boolean {
    if name == "free" { return true; }
    if name == "drop" { return true; }
    return false;
}

// Membership test for the `extern fn` name set.
fn _name_in_list(names: string[], name: string) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= names.length { break; }
        if names[index] == name { return true; }
        index += 1;
    }
    return false;
}

// -------------------------------------------------------------------
// Lattice helpers (exercised by unit tests)
// -------------------------------------------------------------------
// Last index of `name` in `bindings`, or -1. The last match wins so
// shadowed names resolve to the innermost declaration.
fn _find_binding_index(bindings: OwnershipBinding[], name: string) -> int {
    let mut last: int = -1;
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if bindings[index].name == name { last = index; }
        index += 1;
    }
    return last;
}

fn _index_in_list(indices: int[], target: int) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= indices.length { break; }
        if indices[index] == target { return true; }
        index += 1;
    }
    return false;
}

fn _merge_alias_roots(left: int[], right: int[]) -> int[] {
    let mut result: int[] = [];
    let mut index: int = 0;
    loop {
        if index >= left.length { break; }
        if !_index_in_list(result, left[index]) {
            result.push(left[index]);
        }
        index += 1;
    }
    index = 0;
    loop {
        if index >= right.length { break; }
        if !_index_in_list(result, right[index]) {
            result.push(right[index]);
        }
        index += 1;
    }
    return result;
}

fn _rebase_alias_roots(roots: int[], owner: int, retained_count: int) -> int[] {
    let mut result: int[] = [];
    let mut index: int = 0;
    loop {
        if index >= roots.length { break; }
        let mut root = roots[index];
        if root < 0 || root >= retained_count { root = owner; }
        if !_index_in_list(result, root) { result.push(root); }
        index += 1;
    }
    if result.length == 0 { result.push(owner); }
    return result;
}

fn _binding_with_alias_roots(binding: OwnershipBinding, alias_roots: int[]) -> OwnershipBinding {
    return OwnershipBinding {
        name: binding.name,
        alias_roots: alias_roots,
        declared_type: binding.declared_type,
        state: binding.state,
        span: binding.span,
        is_owned: binding.is_owned,
        is_linear: binding.is_linear,
        is_task: binding.is_task,
        is_channel: binding.is_channel,
        nursery_bound: binding.nursery_bound,
        nursery_span: binding.nursery_span,
        moved_span: binding.moved_span
    };
}

fn _binding_alias_roots(bindings: OwnershipBinding[], name: string) -> int[] {
    let mut result: int[] = [];
    let index = _find_binding_index(bindings, name);
    if index < 0 { return result; }
    if bindings[index].alias_roots.length == 0 {
        result.push(index);
        return result;
    }
    return _merge_alias_roots(result, bindings[index].alias_roots);
}

fn _mark_binding_alias_roots(bindings: OwnershipBinding[], name: string, alias_roots: int[]) -> OwnershipBinding[] {
    let last = _find_binding_index(bindings, name);
    if last < 0 || alias_roots.length == 0 { return bindings; }
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        let binding = bindings[index];
        if index == last {
            result.push(OwnershipBinding {
                name: binding.name, alias_roots: alias_roots, declared_type: binding.declared_type, state: binding.state, span: binding.span, is_owned: binding.is_owned, is_linear: binding.is_linear, is_task: binding.is_task, is_channel: binding.is_channel, nursery_bound: binding.nursery_bound, nursery_span: binding.nursery_span, moved_span: binding.moved_span
            });
        } else { result.push(binding); }
        index += 1;
    }
    return result;
}

// Resolve a name to its current ownership state. Returns "" when the
// name is not bound.
fn binding_state(bindings: OwnershipBinding[], name: string) -> string {
    let index = _find_binding_index(bindings, name);
    if index < 0 { return ""; }
    return bindings[index].state;
}

// The Owned -> Moved transition, recording the move site. Flips the
// most recent binding for `name`; a miss returns the input unchanged.
fn _mark_binding_moved_at(bindings: OwnershipBinding[], name: string, move_span: SourceSpan?) -> OwnershipBinding[] {
    let last = _find_binding_index(bindings, name);
    if last < 0 { return bindings; }
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index == last {
            result.push(OwnershipBinding {
                name: bindings[index].name, alias_roots: bindings[index].alias_roots, declared_type: bindings[index].declared_type, state: "moved", span: bindings[index].span, is_owned: bindings[index].is_owned, is_linear: bindings[index].is_linear, is_task: bindings[index].is_task, is_channel: bindings[index].is_channel, nursery_bound: bindings[index].nursery_bound, nursery_span: bindings[index].nursery_span, moved_span: move_span
            });
        } else { result.push(bindings[index]); }
        index += 1;
    }
    return result;
}

// The Owned -> Freed transition, recording the disposal site in the
// shared invalidating-site slot (`moved_span`). Mirrors
// `_mark_binding_moved_at`.
fn _mark_binding_freed_at(bindings: OwnershipBinding[], name: string, free_span: SourceSpan?) -> OwnershipBinding[] {
    let last = _find_binding_index(bindings, name);
    if last < 0 { return bindings; }
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index == last {
            result.push(OwnershipBinding {
                name: bindings[index].name, alias_roots: bindings[index].alias_roots, declared_type: bindings[index].declared_type, state: "freed", span: bindings[index].span, is_owned: bindings[index].is_owned, is_linear: bindings[index].is_linear, is_task: bindings[index].is_task, is_channel: bindings[index].is_channel, nursery_bound: bindings[index].nursery_bound, nursery_span: bindings[index].nursery_span, moved_span: free_span
            });
        } else { result.push(bindings[index]); }
        index += 1;
    }
    return result;
}

// Span-less wrapper retained for the lattice unit tests.
fn mark_binding_moved(bindings: OwnershipBinding[], name: string) -> OwnershipBinding[] {
    return _mark_binding_moved_at(bindings, name, null);
}

// -------------------------------------------------------------------
// Rule firing
// -------------------------------------------------------------------
fn _push_finding(scope: OwnershipScope, finding: OwnershipWarning) -> OwnershipScope {
    let mut findings = scope.findings;
    let mut existing_index: int = 0;
    loop {
        if existing_index >= findings.length { break; }
        let existing = findings[existing_index];
        if existing.code == finding.code && existing.binding_name == finding.binding_name {
            let existing_trigger = existing.trigger;
            let new_trigger = finding.trigger;
            if existing_trigger != null && new_trigger != null {
                if existing_trigger.line == new_trigger.line && existing_trigger.column == new_trigger.column {
                    return scope;
                }
            }
        }
        existing_index += 1;
    }
    findings.push(finding);
    return OwnershipScope {
        bindings: scope.bindings,
        tracked: scope.tracked,
        findings: findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
}

fn _make_finding(name: string, use_span: SourceSpan?, moved_span: SourceSpan?, code: string) -> OwnershipWarning {
    let use_loc = _span_location(use_span);
    let moved_loc = _span_location(moved_span);
    let mut message: string = "";
    if code == "E0837" {
        message = "task handle `" + name + "` is consumed more than once"
            + use_loc
            + "\nnote: `"
            + name
            + "` was first consumed here"
            + moved_loc
            + "\nhelp: each `Task<T>` may be awaited exactly once, directly or through `join_all`";
    } else if code == "E0838" {
        message = "task handle `" + name + "` escapes its `routine` nursery"
            + use_loc
            + "\nnote: the destination binding outlives the nursery"
            + moved_loc
            + "\nhelp: await the handle or consume its handle array with `join_all` before the `routine` ends";
    } else if code == "E0904" {
        message = "second live binding to uniquely-owned value `" + name + "`"
            + use_loc
            + "\nnote: `"
            + name
            + "` was moved here"
            + moved_loc
            + "\nhelp: `"
            + name
            + "` is uniquely owned; move it or take an explicit copy";
    } else if code == "E0902" {
        message = "in-place mutation of possibly-aliased buffer `" + name + "`"
            + use_loc
            + "\nnote: `"
            + name
            + "` was moved here"
            + moved_loc
            + "\nhelp: `"
            + name
            + "` may be aliased by the move target; take a unique OwnedBuf, or use the copying concat path";
    } else if code == "E0903" {
        message = "use after free of `" + name + "`" + use_loc + "\nnote: `"
            + name
            + "` was freed here"
            + moved_loc
            + "\nhelp: `"
            + name
            + "` was disposed; do not use it after disposal";
    } else if code == "E0906" {
        message = "raw-pointer escape of owned value `" + name
            + "` across an unsafe/extern boundary"
            + use_loc
            + "\nhelp: raw-pointer escape requires the call site to be inside an `unsafe` block, or the buffer to be released to FFI";
    } else if code == "E0907" {
        message = "linear value `" + name + "` is never consumed" + use_loc
            + "\nnote: `"
            + name
            + "` is `Linear<T>`; a linear value must be used exactly once"
            + "\nhelp: consume `"
            + name
            + "` (move it, return it, pass it to a call, or free it) before it goes out of scope";
    } else {
        message = "use of moved value `" + name + "`" + use_loc + "\nnote: `"
            + name
            + "` was moved here"
            + moved_loc
            + "\nhelp: copy it before the move, or restructure so the second use precedes the move";
    }
    return OwnershipWarning {
        routine_name: "",
        binding_name: name,
        message: message,
        trigger: _token_from_span(name, use_span),
        severity: "error",
        code: code,
        moved_trigger: _token_from_span(name, moved_span)
    };
}

// E0838 is shared by nursery-owned handle kinds. Task diagnostics retain the
// established await/join remediation; channels name their handle kind and
// explain that the channel must remain inside the creating nursery.
fn _make_nursery_finding(name: string, handle_kind: string, use_span: SourceSpan?, destination_span: SourceSpan?) -> OwnershipWarning {
    if handle_kind != "channel" {
        return _make_finding(name, use_span, destination_span, "E0838");
    }
    let use_loc = _span_location(use_span);
    let destination_loc = _span_location(destination_span);
    let message = "channel handle `" + name + "` escapes its `routine` nursery"
        + use_loc
        + "\nnote: the destination binding outlives the nursery"
        + destination_loc
        + "\nhelp: keep the channel and every alias inside the `routine` that created it";
    return OwnershipWarning {
        routine_name: "",
        binding_name: name,
        message: message,
        trigger: _token_from_span(name, use_span),
        severity: "error",
        code: "E0838",
        moved_trigger: _token_from_span(name, destination_span)
    };
}

// A reference to `name` in a *consuming* position (let initializer,
// call argument, return value). When the binding is owned and already
// freed this is use-after-free (`E0903`); already moved is
// use-after-move (`E0904` if the consuming site is a new binding,
// `E0901` otherwise). When it is owned and live this performs the
// `Owned -> Moved` transition.
fn _consume_identifier(scope: OwnershipScope, name: string, use_span: SourceSpan?, is_let_init: boolean) -> OwnershipScope {
    let index = _find_binding_index(scope.bindings, name);
    if index < 0 { return scope; }
    let binding = scope.bindings[index];
    if !binding.is_owned { return scope; }
    if binding.state == "freed" {
        return _push_finding(scope, _make_finding(name, use_span, binding.moved_span, "E0903"));
    }
    if binding.state == "moved" || binding.state == "maybe_moved" {
        let mut code: string = "E0901";
        if binding.is_task { code = "E0837"; } else if is_let_init {
            code = "E0904";
        }
        return _push_finding(scope, _make_finding(name, use_span, binding.moved_span, code));
    }
    let moved = _mark_binding_moved_at(scope.bindings, name, use_span);
    return OwnershipScope {
        bindings: moved,
        tracked: scope.tracked,
        findings: scope.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
}

// A read (non-consuming use) of `name`. Reading a freed owned binding is
// use-after-free (`E0903`); reading a moved owned binding is
// use-after-move (`E0901`); reading a live binding is fine and does not
// change state.
fn _check_read(scope: OwnershipScope, name: string, use_span: SourceSpan?) -> OwnershipScope {
    let index = _find_binding_index(scope.bindings, name);
    if index < 0 { return scope; }
    let binding = scope.bindings[index];
    if !binding.is_owned { return scope; }
    if binding.state == "freed" {
        return _push_finding(scope, _make_finding(name, use_span, binding.moved_span, "E0903"));
    }
    if binding.state == "moved" || binding.state == "maybe_moved" {
        let mut code: string = "E0901";
        if binding.is_task { code = "E0837"; }
        return _push_finding(scope, _make_finding(name, use_span, binding.moved_span, code));
    }
    return scope;
}

// Walk a call's argument list as consuming positions. A bare-identifier
// argument is a move; other arguments walk as ordinary expressions
// (their interior reads count). When `extern_call` is true the callee is
// a known `extern fn`: a *live* owned bare-identifier argument escaping
// into FFI fires `E0906` before the move is recorded.
fn _consume_call_args(arguments: Expression[], scope: OwnershipScope, extern_call: boolean) -> OwnershipScope {
    let mut next = scope;
    let mut index: int = 0;
    loop {
        if index >= arguments.length { break; }
        let argument = arguments[index];
        if argument.variant == "Identifier" {
            if extern_call {
                let ai = _find_binding_index(next.bindings, argument.name);
                if ai >= 0 {
                    if next.bindings[ai].is_owned {
                        if next.bindings[ai].state == "owned" {
                            next = _push_finding(next, _make_finding(argument.name, argument.span, null, "E0906"));
                        }
                    }
                }
            }
            next = _consume_task_value(next, argument, false);
        } else { next = _consume_task_value(next, argument, false); }
        index += 1;
    }
    return next;
}

// Consume a spawn-family closure's captured owned bindings as moves
// (issue #1220). A `spawn`/`parallel`/`serve` worker outlives the
// spawning scope, so an owned value the closure captures genuinely
// escapes the sender — the sender binding must lose it (`Owned ->
// Moved`), and any later use on the sender is then use-after-move
// (`E0901`). This is the static complement to #1094's RC-promote
// drop-emission: drops reclaim the memory, this proves no live
// aliased use remains on the sender.
//
// The capture set is the lambda's free variables, computed by reusing
// `analyze_lambda` from `typecheck_captures` (the same proven walk
// lambda-lowering relies on) with an empty outer scope so `.free`
// surfaces every name the body references that is not bound inside the
// lambda (params, body-local `let`s, for-targets, nested-lambda params
// are all excluded; the list is deduped). Each captured name that
// resolves to an owned live binding in the parent scope is consumed via
// `_consume_identifier`; free names that are not owned bindings (a
// callee function name, a copyable value) resolve to nothing and are
// harmless no-ops.
//
// Crucially this is gated at the spawn site, NOT the `Lambda` arm: an
// ordinary lambda (e.g. `array.map(() -> buf.len())`) stays isolated
// and treats captures as reads, preserving lambda-scope isolation. Only
// spawn-family escapes lift capture-moves back into the parent.
fn _consume_spawn_captures(scope: OwnershipScope, lambda: Expression, span: SourceSpan?) -> OwnershipScope {
    let empty: LocalBinding[] = [];
    let result = analyze_lambda(empty, lambda);
    let mut next = scope;
    let mut index: int = 0;
    loop {
        if index >= result.free.length { break; }
        next = _consume_identifier(next, result.free[index], span, false);
        index += 1;
    }
    return next;
}

// Ordinary closures may remain synchronous, so established OwnedBuf captures
// keep their read-only behavior. Task handles are affine regardless of where
// the closure runs, however: creating a closure that captures a Task moves the
// handle into the closure environment. Lift only Task captures into the parent
// state so the closure and its creator cannot both consume the same handle.
fn _consume_task_lambda_captures(scope: OwnershipScope, lambda: Expression, span: SourceSpan?) -> OwnershipScope {
    let empty: LocalBinding[] = [];
    let result = analyze_lambda(empty, lambda);
    let mut next = scope;
    let mut index: int = 0;
    loop {
        if index >= result.free.length { break; }
        let name = result.free[index];
        let binding_index = _find_binding_index(next.bindings, name);
        if binding_index >= 0 {
            if next.bindings[binding_index].is_task {
                next = _consume_identifier(next, name, span, false);
            }
        }
        index += 1;
    }
    return next;
}

fn _lambda_captures_task(lambda: Expression, bindings: OwnershipBinding[]) -> boolean {
    let empty: LocalBinding[] = [];
    let result = analyze_lambda(empty, lambda);
    let mut index: int = 0;
    loop {
        if index >= result.free.length { break; }
        let binding_index = _find_binding_index(bindings, result.free[index]);
        if binding_index >= 0 {
            if bindings[binding_index].is_task { return true; }
        }
        index += 1;
    }
    return false;
}

fn _lambda_captures_channel(lambda: Expression, bindings: OwnershipBinding[]) -> boolean {
    let empty: LocalBinding[] = [];
    let result = analyze_lambda(empty, lambda);
    let mut index: int = 0;
    loop {
        if index >= result.free.length { break; }
        let binding_index = _find_binding_index(bindings, result.free[index]);
        if binding_index >= 0 {
            if bindings[binding_index].is_channel { return true; }
        }
        index += 1;
    }
    return false;
}

fn _lambda_captures_nursery_handle(lambda: Expression, scope: OwnershipScope) -> boolean {
    let empty: LocalBinding[] = [];
    let result = analyze_lambda(empty, lambda);
    let mut index: int = 0;
    loop {
        if index >= result.free.length { break; }
        let binding_index = _find_binding_index(scope.bindings, result.free[index]);
        if binding_index >= 0 {
            let binding = scope.bindings[binding_index];
            if (binding.is_task || binding.is_channel) && binding.nursery_bound {
                return true;
            }
        }
        index += 1;
    }
    return false;
}

fn _lambda_nursery_origin_span(lambda: Expression, scope: OwnershipScope) -> SourceSpan? {
    let empty: LocalBinding[] = [];
    let result = analyze_lambda(empty, lambda);
    let mut index: int = 0;
    loop {
        if index >= result.free.length { break; }
        let binding_index = _find_binding_index(scope.bindings, result.free[index]);
        if binding_index >= 0 {
            let binding = scope.bindings[binding_index];
            if (binding.is_task || binding.is_channel) && binding.nursery_bound {
                return binding.nursery_span;
            }
        }
        index += 1;
    }
    return lambda.span;
}

fn _member_root_name(expression: Expression?) -> string {
    if expression == null { return ""; }
    if expression.variant == "Identifier" { return expression.name; }
    if expression.variant == "Member" {
        return _member_root_name(expression.object);
    }
    if expression.variant == "Index" {
        return _member_root_name(expression.sequence);
    }
    return "";
}

// Aggregate aliases retain stable binding indices rather than names. Indices
// survive lexical shadowing, and a conditional alias conservatively retains
// every destination it may denote.
fn _expression_alias_roots(expression: Expression?, bindings: OwnershipBinding[]) -> int[] {
    let mut empty: int[] = [];
    if expression == null { return empty; }
    if expression.variant == "Identifier" || expression.variant == "Member"
        || expression.variant == "Index" {
        return _binding_alias_roots(bindings, _member_root_name(expression));
    }
    if expression.variant == "Conditional" {
        let then_roots = _expression_alias_roots(expression.then_value, bindings);
        let else_roots = _expression_alias_roots(expression.else_value, bindings);
        return _merge_alias_roots(then_roots, else_roots);
    }
    return empty;
}

fn _roots_have_channel_marker(bindings: OwnershipBinding[], roots: int[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= roots.length { break; }
        let root = roots[index];
        if root >= 0 && root < bindings.length {
            if bindings[root].is_channel { return true; }
        }
        index += 1;
    }
    return false;
}

fn _roots_are_nursery_bound(bindings: OwnershipBinding[], roots: int[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= roots.length { break; }
        let root = roots[index];
        if root >= 0 && root < bindings.length {
            if bindings[root].nursery_bound { return true; }
        }
        index += 1;
    }
    return false;
}

fn _roots_nursery_span(bindings: OwnershipBinding[], roots: int[]) -> SourceSpan? {
    let mut index: int = 0;
    loop {
        if index >= roots.length { break; }
        let root = roots[index];
        if root >= 0 && root < bindings.length {
            if bindings[root].nursery_bound {
                return bindings[root].nursery_span;
            }
        }
        index += 1;
    }
    return null;
}

fn _expression_declared_type(expression: Expression?, bindings: OwnershipBinding[], task_names: string[]) -> string {
    if expression == null { return ""; }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(bindings, expression.name);
        if index >= 0 { return bindings[index].declared_type; }
        return "";
    }
    if expression.variant == "Struct" {
        if expression.type_name.length > 0 {
            return expression.type_name[expression.type_name.length - 1];
        }
        return "";
    }
    if expression.variant == "Member" {
        let owner_type = _expression_declared_type(expression.object, bindings, task_names);
        if owner_type.length == 0 { return ""; }
        return task_field_type(task_names, owner_type, expression.member);
    }
    if expression.variant == "Index" {
        let sequence_type = trim_text(_expression_declared_type(expression.sequence, bindings, task_names));
        if sequence_type.length >= 2 {
            if substring(sequence_type, sequence_type.length - 2, sequence_type.length) == "[]" {
                return trim_text(substring(sequence_type, 0, sequence_type.length - 2));
            }
        }
    }
    if expression.variant == "Conditional" {
        let then_type = _expression_declared_type(expression.then_value, bindings, task_names);
        if then_type.length > 0 { return then_type; }
        return _expression_declared_type(expression.else_value, bindings, task_names);
    }
    return "";
}

fn _task_callable_type(return_type: string, is_fresh: boolean) -> string {
    if is_fresh { return "fresh-task-callable:" + return_type; }
    return "task-callable:" + return_type;
}

fn _task_callable_type_from_annotation(type_text: string) -> string {
    let mut index: int = 0;
    let mut paren_depth: int = 0;
    let mut bracket_depth: int = 0;
    let mut angle_depth: int = 0;
    loop {
        if index + 1 >= type_text.length { break; }
        if type_text[index] == "(" { paren_depth += 1; } else if type_text[index] == ")" {
            if paren_depth > 0 { paren_depth -= 1; }
        } else if type_text[index] == "[" { bracket_depth += 1; } else if type_text[index] == "]" {
            if bracket_depth > 0 { bracket_depth -= 1; }
        } else if type_text[index] == "<" { angle_depth += 1; } else if type_text[index] == ">" {
            if angle_depth > 0 { angle_depth -= 1; }
        } else if type_text[index] == "-" && type_text[index + 1] == ">"
            && paren_depth == 0
            && bracket_depth == 0
            && angle_depth == 0 {
            let return_type = trim_text(substring(type_text, index + 2, type_text.length));
            if is_task_type(return_type) {
                return _task_callable_type(return_type, false);
            }
            return "";
        }
        index += 1;
    }
    return "";
}

fn _is_task_callable_type(type_text: string) -> boolean {
    if type_text.length >= 14 && substring(type_text, 0, 14) == "task-callable:" {
        return true;
    }
    if type_text.length >= 20 && substring(type_text, 0, 20) == "fresh-task-callable:" {
        return true;
    }
    return false;
}

fn _is_fresh_task_callable_type(type_text: string) -> boolean {
    return type_text.length >= 20 && substring(type_text, 0, 20) == "fresh-task-callable:";
}

fn _inferred_task_callable_type(expression: Expression?, bindings: OwnershipBinding[], task_names: string[]) -> string {
    if expression == null { return ""; }
    if expression.variant == "Lambda" {
        let return_type = expression.return_type;
        if return_type != null {
            if is_task_type(return_type.text) {
                let is_fresh = block_proves_fresh_task_returns(expression.body, task_names);
                return _task_callable_type(return_type.text, is_fresh);
            }
        }
        return "";
    }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(bindings, expression.name);
        if index >= 0 {
            let declared_type = bindings[index].declared_type;
            if _is_task_callable_type(declared_type) { return declared_type; }
            return "";
        }
        if _name_in_list(task_names, expression.name) {
            return _task_callable_type("Task<inferred>", _name_in_list(task_names, _fresh_task_key(expression.name)));
        }
    }
    return "";
}

// Preserve enough inferred Task shape for the ownership pass to distinguish a
// seeded handle collection (`[spawn ...]`) from an arbitrary Task-bearing
// aggregate or closure. These synthetic spellings never reach semantic type
// checking or lowering; they only keep provenance precise when the source has
// no annotation.
fn _inferred_task_binding_type(expression: Expression?, bindings: OwnershipBinding[], task_names: string[]) -> string {
    if expression == null { return ""; }
    if expression.variant == "Spawn" { return "Task<inferred>"; }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(bindings, expression.name);
        if index >= 0 {
            let declared_type = trim_text(bindings[index].declared_type);
            if is_task_type(declared_type) { return declared_type; }
        }
        return "";
    }
    if expression.variant == "Index" || expression.variant == "Member" {
        let declared_type = trim_text(_expression_declared_type(expression, bindings, task_names));
        if is_task_type(declared_type) { return declared_type; }
        return "";
    }
    if expression.variant == "Call" {
        if _expression_is_task_value(expression, bindings, task_names) {
            return "Task<inferred>";
        }
        return "";
    }
    if expression.variant == "Conditional" {
        let then_type = _inferred_task_binding_type(expression.then_value, bindings, task_names);
        let else_type = _inferred_task_binding_type(expression.else_value, bindings, task_names);
        if then_type.length > 0 { return then_type; }
        return else_type;
    }
    if expression.variant == "Array" {
        let mut index: int = 0;
        loop {
            if index >= expression.elements.length { break; }
            let element_type = _inferred_task_binding_type(expression.elements[index], bindings, task_names);
            if element_type.length > 0 { return element_type + "[]"; }
            index += 1;
        }
    }
    return "";
}

// -------------------------------------------------------------------
// Scope plumbing
// -------------------------------------------------------------------
fn _copy_bindings(bindings: OwnershipBinding[]) -> OwnershipBinding[] {
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        result.push(bindings[index]);
        index += 1;
    }
    return result;
}

fn _enter_binding(scope: OwnershipScope, name: string, declared_type: string, span: SourceSpan?, is_owned: boolean, is_linear: boolean, is_task: boolean, is_channel: boolean, nursery_bound: boolean, nursery_span: SourceSpan?) -> OwnershipScope {
    let mut bindings = scope.bindings;
    let mut alias_roots: int[] = [];
    alias_roots.push(bindings.length);
    bindings.push(OwnershipBinding {
        name: name, alias_roots: alias_roots, declared_type: declared_type, state: "owned", span: span, is_owned: is_owned, is_linear: is_linear, is_task: is_task, is_channel: is_channel, nursery_bound: nursery_bound, nursery_span: nursery_span, moved_span: null
    });
    return OwnershipScope {
        bindings: bindings,
        tracked: scope.tracked + 1,
        findings: scope.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
}

// Scope-exit sweep for the linear must-be-consumed rule (`E0907`).
// Walks `bindings[start..]` — the bindings *declared in the scope that is
// now exiting* — and flags any that are still linear-and-`owned`
// (i.e. never moved or freed) as unconsumed. A linear value consumed in
// the same scope reaches state "moved"/"freed" and is skipped. The sweep
// pushes findings into `scope` and returns it. `start` lets callers limit
// the walk to a scope's own declarations: 0 for a routine boundary
// (params + body-level lets), or the parent binding count for a nested
// block (block-local lets only).
//
// Limitation (narrow 1.0 subset): generic Linear<T> consumption is recognized
// only in its declaring lexical scope. Task<T> uses the separate flow-aware
// propagation and join below.
fn _sweep_unconsumed_linear(scope: OwnershipScope, bindings: OwnershipBinding[], start: int) -> OwnershipScope {
    let mut next = scope;
    let mut index = start;
    loop {
        if index >= bindings.length { break; }
        let binding = bindings[index];
        if binding.is_linear {
            if binding.state == "owned" {
                next = _push_finding(next, _make_finding(binding.name, binding.span, null, "E0907"));
            }
        }
        index += 1;
    }
    return next;
}

fn _task_state_after_paths(left: string, right: string) -> string {
    if left == right { return left; }
    return "maybe_moved";
}

fn _binding_has_live_nursery_handle(binding: OwnershipBinding) -> boolean {
    if !binding.nursery_bound { return false; }
    if binding.state == "moved" { return false; }
    if binding.state == "freed" { return false; }
    return true;
}

// Join the handle state of two possible paths for the bindings that existed
// before a child scope. Non-Task ownership keeps its established lexical
// behavior; Task moves and Task/Channel nursery provenance require a
// conservative path join across `if`, `match`, or a loop.
fn _merge_task_binding_paths(left: OwnershipBinding[], right: OwnershipBinding[], count: int) -> OwnershipBinding[] {
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= left.length { break; }
        let lb = left[index];
        if index < count && index < right.length && ((lb.is_task || right[index].is_task)
            || (lb.is_channel
            || right[index].is_channel)) {
            let rb = right[index];
            let left_live = _binding_has_live_nursery_handle(lb);
            let right_live = _binding_has_live_nursery_handle(rb);
            let mut nursery_span = lb.nursery_span;
            if !left_live && right_live { nursery_span = rb.nursery_span; }
            let mut moved_span = lb.moved_span;
            if moved_span == null { moved_span = rb.moved_span; }
            let merged = OwnershipBinding {
                name: lb.name,
                alias_roots: _merge_alias_roots(_rebase_alias_roots(lb.alias_roots, index, count), _rebase_alias_roots(rb.alias_roots, index, count)),
                declared_type: lb.declared_type,
                state: _task_state_after_paths(lb.state, rb.state),
                span: lb.span,
                is_owned: lb.is_owned || rb.is_owned,
                is_linear: lb.is_linear || rb.is_linear,
                is_task: lb.is_task || rb.is_task,
                is_channel: lb.is_channel || rb.is_channel,
                nursery_bound: left_live || right_live,
                nursery_span: nursery_span,
                moved_span: moved_span
            };
            result.push(merged);
        } else { result.push(lb); }
        index += 1;
    }
    return result;
}

// Propagate handle state through an unconditional lexical block while keeping
// child declarations scoped. Generic ownership retains its existing block
// floor; only Task state and Task/Channel nursery provenance are strengthened.
fn _propagate_parent_task_bindings(parent: OwnershipBinding[], child: OwnershipBinding[], count: int) -> OwnershipBinding[] {
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= parent.length { break; }
        if index < count && index < child.length && (parent[index].is_task
            || child[index].is_task
            || parent[index].is_channel
            || child[index].is_channel) {
            let roots = _rebase_alias_roots(child[index].alias_roots, index, count);
            result.push(_binding_with_alias_roots(child[index], roots));
        } else { result.push(parent[index]); }
        index += 1;
    }
    return result;
}

// Walk an unconditional nested block as a child scope: the child sees the
// parent's bindings, child declarations do not leak back, and Task moves /
// nursery provenance on parent bindings propagate through the block.
fn _nested_block_scope(block: Block, scope: OwnershipScope) -> OwnershipScope {
    let child_in = OwnershipScope {
        bindings: _copy_bindings(scope.bindings),
        tracked: scope.tracked,
        findings: scope.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
    let child_out = _scope_after_block(block, child_in);
    // Sweep the block's own declarations (positions >= the parent count)
    // for unconsumed linear bindings before they are discarded.
    let swept = _sweep_unconsumed_linear(child_out, child_out.bindings, scope.bindings.length);
    return OwnershipScope {
        bindings: _propagate_parent_task_bindings(scope.bindings, swept.bindings, scope.bindings.length),
        tracked: swept.tracked,
        findings: swept.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
}

// A loop body may execute zero times or repeatedly. Analyze a second
// iteration from the first iteration's Task state so a repeated await/move
// fires E0837 at the source operation, then join that result with the
// zero-iteration entry path. The Task lattice stabilizes by the second pass.
fn _block_reaches_next_iteration(block: Block) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= block.statements.length { break; }
        let statement = block.statements[index];
        if statement.variant == "BreakStatement" || statement.variant == "ReturnStatement"
            || statement.variant == "ThrowStatement" { return false; }
        index += 1;
    }
    return true;
}

fn _optional_block_scope(block: Block, scope: OwnershipScope) -> OwnershipScope {
    let first_out = _nested_block_scope(block, scope);
    if !_block_reaches_next_iteration(block) {
        return OwnershipScope {
            bindings: _merge_task_binding_paths(scope.bindings, first_out.bindings, scope.bindings.length),
            tracked: first_out.tracked,
            findings: first_out.findings,
            extern_names: scope.extern_names,
            task_returning_names: scope.task_returning_names,
            routine_outer_count: scope.routine_outer_count
        };
    }
    let second_in = OwnershipScope {
        bindings: _copy_bindings(first_out.bindings),
        tracked: first_out.tracked,
        findings: first_out.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
    let second_out = _nested_block_scope(block, second_in);
    return OwnershipScope {
        bindings: _merge_task_binding_paths(scope.bindings, second_out.bindings, scope.bindings.length),
        // Re-analysis is a flow fixpoint probe, not a second set of lexical
        // declarations for the coverage summary.
        tracked: first_out.tracked,
        findings: second_out.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
}

// Replace the current binding for `name` with a live Task value. Assignment
// reinitializes a previously consumed task binding; `nursery_bound` records
// whether the new value originated in the active routine and therefore must
// be consumed before that nursery closes.
fn _mark_task_binding_owned(bindings: OwnershipBinding[], name: string, nursery_bound: boolean, nursery_span: SourceSpan?, inferred_type: string) -> OwnershipBinding[] {
    let last = _find_binding_index(bindings, name);
    if last < 0 { return bindings; }
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index == last {
            let binding = bindings[index];
            let mut declared_type = binding.declared_type;
            if declared_type.length == 0 && inferred_type.length > 0 {
                declared_type = inferred_type;
            }
            result.push(OwnershipBinding {
                name: binding.name, alias_roots: binding.alias_roots, declared_type: declared_type, state: "owned", span: binding.span, is_owned: true, is_linear: binding.is_linear, is_task: true, is_channel: binding.is_channel, nursery_bound: nursery_bound, nursery_span: nursery_span, moved_span: null
            });
        } else { result.push(bindings[index]); }
        index += 1;
    }
    return result;
}

// Channel handles remain copyable in v0; this marker tracks only their
// nursery provenance. Rebinding a channel destination therefore does not opt
// it into Task's affine/double-consume rules.
fn _mark_channel_binding_owned_at(bindings: OwnershipBinding[], target: int, nursery_bound: boolean, nursery_span: SourceSpan?) -> OwnershipBinding[] {
    if target < 0 || target >= bindings.length { return bindings; }
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index == target {
            let binding = bindings[index];
            result.push(OwnershipBinding {
                name: binding.name, alias_roots: binding.alias_roots, declared_type: binding.declared_type, state: "owned", span: binding.span, is_owned: binding.is_owned, is_linear: binding.is_linear, is_task: binding.is_task, is_channel: true, nursery_bound: nursery_bound, nursery_span: nursery_span, moved_span: null
            });
        } else { result.push(bindings[index]); }
        index += 1;
    }
    return result;
}

fn _mark_channel_binding_owned(bindings: OwnershipBinding[], name: string, nursery_bound: boolean, nursery_span: SourceSpan?) -> OwnershipBinding[] {
    return _mark_channel_binding_owned_at(bindings, _find_binding_index(bindings, name), nursery_bound, nursery_span);
}

// Mark a task collection as containing at least one handle spawned in the
// active nursery. A non-nursery push does not clear an existing marker: the
// collection may still contain an earlier live nursery-bound handle.
fn _mark_task_collection_nursery_bound(bindings: OwnershipBinding[], name: string, nursery_span: SourceSpan?) -> OwnershipBinding[] {
    let last = _find_binding_index(bindings, name);
    if last < 0 { return bindings; }
    let binding = bindings[last];
    if !binding.is_task { return bindings; }
    return _mark_task_binding_owned(bindings, name, true, nursery_span, "");
}

fn _binding_prefix(bindings: OwnershipBinding[], count: int) -> OwnershipBinding[] {
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index >= count { break; }
        let roots = _rebase_alias_roots(bindings[index].alias_roots, index, count);
        result.push(_binding_with_alias_roots(bindings[index], roots));
        index += 1;
    }
    return result;
}

fn _clear_nursery_bound_at(bindings: OwnershipBinding[], target: int) -> OwnershipBinding[] {
    let mut result: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index == target {
            let binding = bindings[index];
            result.push(OwnershipBinding {
                name: binding.name, alias_roots: binding.alias_roots, declared_type: binding.declared_type, state: binding.state, span: binding.span, is_owned: binding.is_owned, is_linear: binding.is_linear, is_task: binding.is_task, is_channel: binding.is_channel, nursery_bound: false, nursery_span: null, moved_span: binding.moved_span
            });
        } else { result.push(bindings[index]); }
        index += 1;
    }
    return result;
}

// At a routine boundary, only parent bindings can carry a handle beyond the
// nursery. Routine-local bindings die with the scope and are safe even when
// unused because the runtime nursery joins all registered children. A parent
// Task binding/collection marked nursery-bound is legal when it was consumed
// in the routine; a live Task or Channel in a parent binding is the E0838
// escape.
// Snapshot which parent-prefix bindings already carry nursery provenance
// when a routine opens (SFN-696). A handle bound before this routine began
// belongs to an ENCLOSING nursery, so this routine's exit sweep must not
// claim it: sitting in an inner nursery's parent prefix is the normal
// resting place of a correctly-scoped outer-routine handle, not an escape.
fn _nursery_bound_marks(bindings: OwnershipBinding[], count: int) -> boolean[] {
    let mut marks: boolean[] = [];
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index >= count { break; }
        marks.push(bindings[index].nursery_bound);
        index += 1;
    }
    return marks;
}

fn _sweep_nursery_escapes(scope: OwnershipScope, outer_count: int, entry_marks: boolean[]) -> OwnershipScope {
    let mut next = scope;
    let mut bindings = scope.bindings;
    let mut index: int = 0;
    loop {
        if index >= bindings.length { break; }
        if index >= outer_count { break; }
        // Bound before this routine opened -> owned by an enclosing nursery,
        // and swept at that nursery's boundary instead (SFN-696). A handle
        // this routine stores into a parent binding is flagged at the store
        // itself, so skipping here loses no genuine escape.
        if index < entry_marks.length && entry_marks[index] {
            index += 1;
            continue;
        }
        let binding = bindings[index];
        if (binding.is_task || binding.is_channel) && binding.nursery_bound && (binding.state == "owned"
            || binding.state == "maybe_moved") {
            let mut handle_kind = "task";
            if binding.is_channel { handle_kind = "channel"; }
            next = _push_finding(next, _make_nursery_finding(binding.name, handle_kind, binding.nursery_span, binding.span));
            // The inner boundary owns this finding. Clear its provenance before
            // propagating the parent binding so nested routines report once.
            bindings = _clear_nursery_bound_at(bindings, index);
        }
        index += 1;
    }
    return OwnershipScope {
        bindings: bindings,
        tracked: next.tracked,
        findings: next.findings,
        extern_names: next.extern_names,
        task_returning_names: next.task_returning_names,
        routine_outer_count: next.routine_outer_count
    };
}

// A routine is unconditional straight-line scope, so parent handle state
// inside it propagates back out (unlike branch scopes). This is also the
// nursery-lifetime boundary: inspect live parent destinations before local
// declarations are discarded, then restore the enclosing routine marker.
fn _routine_block_scope(block: Block, scope: OwnershipScope) -> OwnershipScope {
    let outer_count = scope.bindings.length;
    let child_in = OwnershipScope {
        bindings: _copy_bindings(scope.bindings),
        tracked: scope.tracked,
        findings: scope.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: outer_count
    };
    let entry_marks = _nursery_bound_marks(scope.bindings, outer_count);
    let child_out = _scope_after_block(block, child_in);
    let linear_swept = _sweep_unconsumed_linear(child_out, child_out.bindings, outer_count);
    let nursery_swept = _sweep_nursery_escapes(linear_swept, outer_count, entry_marks);
    return OwnershipScope {
        bindings: _binding_prefix(nursery_swept.bindings, outer_count),
        tracked: nursery_swept.tracked,
        findings: nursery_swept.findings,
        extern_names: scope.extern_names,
        task_returning_names: scope.task_returning_names,
        routine_outer_count: scope.routine_outer_count
    };
}

fn _scope_after_block(block: Block, scope: OwnershipScope) -> OwnershipScope {
    // Every block form, including routine/for/match/catch/lambda bodies,
    // gets its complete local callable table before statements are walked.
    let mut current = OwnershipScope {
        bindings: scope.bindings,
        tracked: scope.tracked,
        findings: scope.findings,
        extern_names: scope.extern_names,
        task_returning_names: gather_block_task_returning_names(block, scope.task_returning_names),
        routine_outer_count: scope.routine_outer_count
    };
    let mut index: int = 0;
    loop {
        if index >= block.statements.length { break; }
        current = _scope_after_statement(block.statements[index], current);
        index += 1;
    }
    return current;
}

// True iff a `let`/parameter with this annotation + initializer should
// be tracked as owned. Owned if the annotation names an owned type, or
// (inference for the unannotated `let y = x;` chain) if the initializer
// is a bare identifier already bound to an owned value.
fn _binding_is_owned(type_text: string, has_type: boolean, initializer: Expression?, bindings: OwnershipBinding[]) -> boolean {
    if has_type {
        if is_owned_type(type_text) { return true; }
    }
    if initializer != null {
        if initializer.variant == "Identifier" {
            let si = _find_binding_index(bindings, initializer.name);
            if si >= 0 {
                if bindings[si].is_owned { return true; }
            }
        }
    }
    return false;
}

// True iff a `let`/parameter with this annotation + initializer is
// *linear* (`Linear<T>`, must be consumed exactly once). Mirrors
// `_binding_is_owned` for the linear subset: linear if the annotation
// names a linear type, or (inference for `let y = x;`) if the
// initializer is a bare identifier already bound to a linear value — a
// linear value moved into a fresh binding is still linear and the new
// binding inherits the obligation.
fn _binding_is_linear(type_text: string, has_type: boolean, initializer: Expression?, bindings: OwnershipBinding[]) -> boolean {
    if has_type {
        if is_linear_type(type_text) { return true; }
    }
    if initializer != null {
        if initializer.variant == "Identifier" {
            let si = _find_binding_index(bindings, initializer.name);
            if si >= 0 {
                if bindings[si].is_linear { return true; }
            }
        }
    }
    return false;
}

fn _task_method_key(type_name: string, method_name: string) -> string {
    return task_method_key(type_name, method_name);
}

// Nursery provenance is stricter than Task result identity. A declared
// `Task<T>` return proves that a call is affine, but it does not prove that the
// returned handle was freshly spawned (an identity helper may return an
// ambient Task argument). Fresh producers therefore use a separate key in the
// same read-only name table.
fn _fresh_task_key(callable_key: string) -> string {
    return fresh_task_key(callable_key);
}

// Task identity is kept separately from the generic owned bit so reuse can
// surface the concurrency-specific E0837 while ordinary affine values retain
// E0901/E0904. The structured `Spawn` node covers the common inferred binding
// (`let h = spawn ...`); identifier and non-empty array propagation preserve
// identity across legal moves into a fresh binding/collection.
fn _expression_is_task_value(expression: Expression?, bindings: OwnershipBinding[], task_returning_names: string[]) -> boolean {
    if expression == null { return false; }
    if expression.variant == "Spawn" { return true; }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(bindings, expression.name);
        if index >= 0 { return bindings[index].is_task; }
        return false;
    }
    if expression.variant == "Index" {
        let sequence_type = _expression_declared_type(expression.sequence, bindings, task_returning_names);
        if is_task_type(sequence_type) { return true; }
        let element_type = _expression_declared_type(expression, bindings, task_returning_names);
        return task_type_is_bearing(task_returning_names, element_type);
    }
    if expression.variant == "Member" {
        let member_type = _expression_declared_type(expression, bindings, task_returning_names);
        if is_task_type(member_type) { return true; }
        return task_type_is_bearing(task_returning_names, member_type);
    }
    if expression.variant == "Lambda" {
        return _lambda_captures_task(expression, bindings);
    }
    if expression.variant == "Call" {
        let callee = expression.callee;
        if callee.variant == "Identifier" {
            // A local binding shadows a same-named top-level/imported
            // function. Retain Task result identity when the binding itself
            // carries first-class callable return metadata.
            let binding_index = _find_binding_index(bindings, callee.name);
            if binding_index >= 0 {
                return _is_task_callable_type(bindings[binding_index].declared_type);
            }
            return _name_in_list(task_returning_names, callee.name);
        }
        if callee.variant == "Member" {
            let receiver = callee.object;
            let receiver_type = _expression_declared_type(receiver, bindings, task_returning_names);
            if receiver_type.length > 0 {
                return _name_in_list(task_returning_names, _task_method_key(receiver_type, callee.member));
            }
            return false;
        }
        return false;
    }
    if expression.variant == "Array" {
        let mut index: int = 0;
        loop {
            if index >= expression.elements.length { break; }
            if _expression_is_task_value(expression.elements[index], bindings, task_returning_names) {
                return true;
            }
            index += 1;
        }
    }
    if expression.variant == "Conditional" {
        return _expression_is_task_value(expression.then_value, bindings, task_returning_names)
            || _expression_is_task_value(expression.else_value, bindings, task_returning_names);
    }
    if expression.variant == "Struct" {
        let declared_type = _expression_declared_type(expression, bindings, task_returning_names);
        if task_type_is_bearing(task_returning_names, declared_type) {
            return true;
        }
    }
    if expression.variant == "Object" || expression.variant == "Struct" {
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            if _expression_is_task_value(expression.fields[index].value, bindings, task_returning_names) {
                return true;
            }
            index += 1;
        }
    }
    return false;
}

// Channels remain copyable handles, but bindings, aggregate literals, and
// field/index extraction retain identity so nursery provenance cannot be lost
// by copying a handle through a container. Declared member/element types keep
// non-Channel siblings from inheriting a container's Channel marker; the root
// marker is a fail-closed fallback when no declared shape is available.
fn _expression_is_channel_value(expression: Expression?, bindings: OwnershipBinding[], task_returning_names: string[]) -> boolean {
    if expression == null { return false; }
    if expression.variant == "Channel" { return true; }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(bindings, expression.name);
        if index >= 0 { return bindings[index].is_channel; }
        return false;
    }
    if expression.variant == "Call" {
        let callee = expression.callee;
        if callee.variant == "Identifier" {
            let index = _find_binding_index(bindings, callee.name);
            if index < 0 {
                return _name_in_list(task_returning_names, channel_return_key(callee.name));
            }
        }
        if callee.variant == "Member" {
            let receiver_type = _expression_declared_type(callee.object, bindings, task_returning_names);
            if receiver_type.length > 0 {
                let callable_key = _task_method_key(receiver_type, callee.member);
                return _name_in_list(task_returning_names, channel_return_key(callable_key));
            }
        }
        if callee.variant == "Lambda" {
            let return_type = callee.return_type;
            if return_type != null {
                if channel_type_is_bearing(task_returning_names, return_type.text) {
                    return true;
                }
            }
            return block_proves_fresh_channel_returns(callee.body, task_returning_names);
        }
        return false;
    }
    if expression.variant == "Index" || expression.variant == "Member" {
        let declared_type = _expression_declared_type(expression, bindings, task_returning_names);
        if declared_type.length > 0 {
            return channel_type_is_bearing(task_returning_names, declared_type);
        }
        return _roots_have_channel_marker(bindings, _expression_alias_roots(expression, bindings));
    }
    if expression.variant == "Lambda" {
        return _lambda_captures_channel(expression, bindings);
    }
    if expression.variant == "Conditional" {
        return _expression_is_channel_value(expression.then_value, bindings, task_returning_names)
            || _expression_is_channel_value(expression.else_value, bindings, task_returning_names);
    }
    if expression.variant == "Array" {
        let mut index: int = 0;
        loop {
            if index >= expression.elements.length { break; }
            if _expression_is_channel_value(expression.elements[index], bindings, task_returning_names) {
                return true;
            }
            index += 1;
        }
    }
    if expression.variant == "Object" || expression.variant == "Struct" {
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            if _expression_is_channel_value(expression.fields[index].value, bindings, task_returning_names) {
                return true;
            }
            index += 1;
        }
    }
    return false;
}

// Return the affine Task binding consumed when `expression` is moved. An
// indexed Task collection is affine as a whole: moving one element consumes
// the collection binding, preventing a second indexed extraction from
// manufacturing another live handle to the same task.
fn _task_source_binding_name(expression: Expression?, bindings: OwnershipBinding[], task_returning_names: string[]) -> string {
    if expression == null { return ""; }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(bindings, expression.name);
        if index >= 0 {
            if bindings[index].is_task { return expression.name; }
        }
        return "";
    }
    if expression.variant == "Index" || expression.variant == "Member" {
        if !_expression_is_task_value(expression, bindings, task_returning_names) {
            return "";
        }
        let root = _member_root_name(expression);
        let index = _find_binding_index(bindings, root);
        if index >= 0 {
            if bindings[index].is_task { return root; }
        }
    }
    return "";
}

fn _consume_task_source(scope: OwnershipScope, expression: Expression, is_let_init: boolean) -> OwnershipScope {
    let source = _task_source_binding_name(expression, scope.bindings, scope.task_returning_names);
    if source.length == 0 { return scope; }
    let mut next = scope;
    if expression.variant == "Index" {
        next = _scope_after_expression(expression.index, next);
    }
    return _consume_identifier(next, source, expression.span, is_let_init);
}

// Consume an affine value even when its runtime source is selected by a
// conditional. Each alternative is analyzed from the same post-condition
// state, then Task states are joined so neither possible source can be reused
// as though it were definitely untouched.
fn _consume_task_value(scope: OwnershipScope, expression: Expression, is_let_init: boolean) -> OwnershipScope {
    if expression.variant == "Conditional" && _expression_is_task_value(expression, scope.bindings, scope.task_returning_names) {
        let base = _scope_after_expression(expression.condition, scope);
        let then_out = _consume_task_value(base, expression.then_value, is_let_init);
        let else_in = OwnershipScope {
            bindings: _copy_bindings(base.bindings),
            tracked: then_out.tracked,
            findings: then_out.findings,
            extern_names: base.extern_names,
            task_returning_names: base.task_returning_names,
            routine_outer_count: base.routine_outer_count
        };
        let else_out = _consume_task_value(else_in, expression.else_value, is_let_init);
        return OwnershipScope {
            bindings: _merge_task_binding_paths(then_out.bindings, else_out.bindings, base.bindings.length),
            tracked: else_out.tracked,
            findings: else_out.findings,
            extern_names: base.extern_names,
            task_returning_names: base.task_returning_names,
            routine_outer_count: base.routine_outer_count
        };
    }
    let source = _task_source_binding_name(expression, scope.bindings, scope.task_returning_names);
    if source.length > 0 {
        return _consume_task_source(scope, expression, is_let_init);
    }
    if expression.variant == "Identifier" {
        return _consume_identifier(scope, expression.name, expression.span, is_let_init);
    }
    return _scope_after_expression(expression, scope);
}

fn _binding_is_task(type_text: string, has_type: boolean, initializer: Expression?, bindings: OwnershipBinding[], task_returning_names: string[]) -> boolean {
    if has_type || type_text.length > 0 {
        if is_task_type(type_text) { return true; }
        if task_type_is_bearing(task_returning_names, type_text) { return true; }
    }
    return _expression_is_task_value(initializer, bindings, task_returning_names);
}

fn _binding_is_channel(type_text: string, initializer: Expression?, bindings: OwnershipBinding[], task_returning_names: string[]) -> boolean {
    if type_text.length > 0 {
        if channel_type_is_bearing(task_returning_names, type_text) {
            return true;
        }
    }
    return _expression_is_channel_value(initializer, bindings, task_returning_names);
}

fn _is_channel_collection_type(type_text: string, task_returning_names: string[]) -> boolean {
    let concrete = trim_text(type_text);
    if concrete.length < 2 { return false; }
    if substring(concrete, concrete.length - 2, concrete.length) != "[]" {
        return false;
    }
    return channel_type_is_bearing(task_returning_names, concrete);
}

fn _is_direct_channel_type(type_text: string) -> boolean {
    let concrete = trim_text(type_text);
    if concrete.length >= 2 {
        if substring(concrete, concrete.length - 2, concrete.length) == "[]" {
            return false;
        }
    }
    if concrete == "Channel" || concrete == "channel" { return true; }
    if concrete.length < 8 { return false; }
    let prefix = substring(concrete, 0, 8);
    return prefix == "Channel<" || prefix == "channel:";
}

fn _is_channel_aggregate_type(type_text: string, task_returning_names: string[]) -> boolean {
    if _is_direct_channel_type(type_text) { return false; }
    return channel_type_is_bearing(task_returning_names, type_text);
}

fn _nursery_handle_kind(expression: Expression?, scope: OwnershipScope) -> string {
    if _expression_is_channel_value(expression, scope.bindings, scope.task_returning_names) {
        return "channel";
    }
    return "task";
}

fn _store_channel_in_alias_roots(scope: OwnershipScope, destination: Expression?, store_span: SourceSpan?) -> OwnershipScope {
    let roots = _expression_alias_roots(destination, scope.bindings);
    let mut next = scope;
    let mut index: int = 0;
    loop {
        if index >= roots.length { break; }
        let root = roots[index];
        if root >= 0 && root < next.bindings.length {
            let binding = next.bindings[root];
            if root < next.routine_outer_count {
                next = _push_finding(next, _make_nursery_finding(binding.name, "channel", store_span, binding.span));
            } else {
                let marked = _mark_channel_binding_owned_at(next.bindings, root, true, store_span);
                next = OwnershipScope {
                    bindings: marked,
                    tracked: next.tracked,
                    findings: next.findings,
                    extern_names: next.extern_names,
                    task_returning_names: next.task_returning_names,
                    routine_outer_count: next.routine_outer_count
                };
            }
        }
        index += 1;
    }
    return next;
}

// True when the expression carries a task spawned in the active nursery.
// The marker follows identifiers and arrays so a local `let h = spawn ...`
// moved into an outer task array is still recognized as a nursery escape.
fn _expression_is_nursery_bound(expression: Expression?, scope: OwnershipScope) -> boolean {
    if expression == null { return false; }
    if scope.routine_outer_count < 0 { return false; }
    if expression.variant == "Channel" { return true; }
    if expression.variant == "Spawn" { return true; }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(scope.bindings, expression.name);
        if index >= 0 { return scope.bindings[index].nursery_bound; }
        return false;
    }
    if expression.variant == "Index" {
        if !_expression_is_task_value(expression, scope.bindings, scope.task_returning_names)
            && !_expression_is_channel_value(expression, scope.bindings, scope.task_returning_names) {
            return false;
        }
        return _roots_are_nursery_bound(scope.bindings, _expression_alias_roots(expression.sequence, scope.bindings));
    }
    if expression.variant == "Member" {
        if !_expression_is_task_value(expression, scope.bindings, scope.task_returning_names)
            && !_expression_is_channel_value(expression, scope.bindings, scope.task_returning_names) {
            return false;
        }
        return _roots_are_nursery_bound(scope.bindings, _expression_alias_roots(expression, scope.bindings));
    }
    if expression.variant == "Array" {
        let mut index: int = 0;
        loop {
            if index >= expression.elements.length { break; }
            if _expression_is_nursery_bound(expression.elements[index], scope) {
                return true;
            }
            index += 1;
        }
    }
    if expression.variant == "Conditional" {
        return _expression_is_nursery_bound(expression.then_value, scope)
            || _expression_is_nursery_bound(expression.else_value, scope);
    }
    if expression.variant == "Lambda" {
        return _lambda_captures_nursery_handle(expression, scope);
    }
    if expression.variant == "Object" || expression.variant == "Struct" {
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            if _expression_is_nursery_bound(expression.fields[index].value, scope) {
                return true;
            }
            index += 1;
        }
    }
    if expression.variant == "Call" {
        let callee = expression.callee;
        let mut callable_key: string = "";
        if callee.variant == "Identifier" {
            let binding_index = _find_binding_index(scope.bindings, callee.name);
            if binding_index < 0 { callable_key = callee.name; } else {
                let binding = scope.bindings[binding_index];
                if _is_fresh_task_callable_type(binding.declared_type)
                    || binding.nursery_bound { return true; }
            }
        } else if callee.variant == "Member" {
            let receiver = callee.object;
            let receiver_type = _expression_declared_type(receiver, scope.bindings, scope.task_returning_names);
            if receiver_type.length > 0 {
                callable_key = _task_method_key(receiver_type, callee.member);
            }
        }
        if callable_key.length > 0 {
            if _name_in_list(scope.task_returning_names, _fresh_task_key(callable_key)) {
                return true;
            }
            if _name_in_list(scope.task_returning_names, fresh_channel_key(callable_key)) {
                return true;
            }
        }
        if callee.variant == "Lambda" {
            if block_proves_fresh_channel_returns(callee.body, scope.task_returning_names) {
                return true;
            }
            if _expression_is_channel_value(expression, scope.bindings, scope.task_returning_names)
                && _lambda_captures_nursery_handle(callee, scope) {
                return true;
            }
        }
        if callee.variant == "Member" && _expression_is_channel_value(expression, scope.bindings, scope.task_returning_names) {
            if _expression_is_nursery_bound(callee.object, scope) {
                return true;
            }
        }
        // A handle-returning call may transparently move or copy a
        // nursery-origin handle argument into its result. Propagate only
        // concrete argument provenance; return type alone is intentionally
        // insufficient.
        if _expression_is_task_value(expression, scope.bindings, scope.task_returning_names)
            || _expression_is_channel_value(expression, scope.bindings, scope.task_returning_names) {
            let mut index: int = 0;
            loop {
                if index >= expression.arguments.length { break; }
                if _expression_is_nursery_bound(expression.arguments[index], scope) {
                    return true;
                }
                index += 1;
            }
        }
    }
    return false;
}

fn _nursery_origin_span(expression: Expression?, scope: OwnershipScope) -> SourceSpan? {
    if expression == null { return null; }
    if expression.variant == "Channel" { return expression.span; }
    if expression.variant == "Spawn" { return expression.span; }
    if expression.variant == "Identifier" {
        let index = _find_binding_index(scope.bindings, expression.name);
        if index >= 0 { return scope.bindings[index].nursery_span; }
        return expression.span;
    }
    if expression.variant == "Index" {
        if !_expression_is_task_value(expression, scope.bindings, scope.task_returning_names)
            && !_expression_is_channel_value(expression, scope.bindings, scope.task_returning_names) {
            return expression.span;
        }
        let roots = _expression_alias_roots(expression.sequence, scope.bindings);
        let span = _roots_nursery_span(scope.bindings, roots);
        if span != null { return span; }
        return expression.span;
    }
    if expression.variant == "Member" {
        if !_expression_is_task_value(expression, scope.bindings, scope.task_returning_names)
            && !_expression_is_channel_value(expression, scope.bindings, scope.task_returning_names) {
            return expression.span;
        }
        let roots = _expression_alias_roots(expression, scope.bindings);
        let span = _roots_nursery_span(scope.bindings, roots);
        if span != null { return span; }
        return expression.span;
    }
    if expression.variant == "Array" {
        let mut index: int = 0;
        loop {
            if index >= expression.elements.length { break; }
            if _expression_is_nursery_bound(expression.elements[index], scope) {
                return _nursery_origin_span(expression.elements[index], scope);
            }
            index += 1;
        }
    }
    if expression.variant == "Conditional" {
        if _expression_is_nursery_bound(expression.then_value, scope) {
            return _nursery_origin_span(expression.then_value, scope);
        }
        if _expression_is_nursery_bound(expression.else_value, scope) {
            return _nursery_origin_span(expression.else_value, scope);
        }
        return expression.span;
    }
    if expression.variant == "Lambda" {
        return _lambda_nursery_origin_span(expression, scope);
    }
    if expression.variant == "Object" || expression.variant == "Struct" {
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            if _expression_is_nursery_bound(expression.fields[index].value, scope) {
                return _nursery_origin_span(expression.fields[index].value, scope);
            }
            index += 1;
        }
    }
    if expression.variant == "Call" {
        if _expression_is_nursery_bound(expression, scope) {
            let mut index: int = 0;
            loop {
                if index >= expression.arguments.length { break; }
                if _expression_is_nursery_bound(expression.arguments[index], scope) {
                    return _nursery_origin_span(expression.arguments[index], scope);
                }
                index += 1;
            }
            return expression.span;
        }
    }
    return null;
}

fn _scope_after_statement(statement: Statement, scope: OwnershipScope) -> OwnershipScope {
    if statement.variant == "VariableDeclaration" {
        let initializer = statement.initializer;
        // Compute the new binding's owned-ness against the *pre-move*
        // environment (so `let y = x;` inherits `x`'s owned flag).
        let mut has_type: boolean = false;
        let mut type_text: string = "";
        let annotation = statement.type_annotation;
        if annotation != null {
            has_type = true;
            type_text = annotation.text;
        } else if initializer != null {
            if initializer.variant == "Struct" {
                if initializer.type_name.length > 0 {
                    type_text = initializer.type_name[initializer.type_name.length - 1];
                }
            }
        }
        if type_text.length == 0 {
            let callable_type = _inferred_task_callable_type(initializer, scope.bindings, scope.task_returning_names);
            if callable_type.length > 0 { type_text = callable_type; }
            if _expression_is_channel_value(initializer, scope.bindings, scope.task_returning_names) {
                let inferred_channel_type = _expression_declared_type(initializer, scope.bindings, scope.task_returning_names);
                if inferred_channel_type.length > 0 {
                    type_text = inferred_channel_type;
                }
            }
        } else {
            let callable_type = _task_callable_type_from_annotation(type_text);
            if callable_type.length > 0 { type_text = callable_type; }
        }
        let owned_new = _binding_is_owned(type_text, has_type, initializer, scope.bindings);
        let linear_new = _binding_is_linear(type_text, has_type, initializer, scope.bindings);
        let task_new = _binding_is_task(type_text, has_type, initializer, scope.bindings, scope.task_returning_names);
        let channel_new = _binding_is_channel(type_text, initializer, scope.bindings, scope.task_returning_names);
        if type_text.length == 0 && task_new {
            type_text = _inferred_task_binding_type(initializer, scope.bindings, scope.task_returning_names);
        }
        let nursery_new = _expression_is_nursery_bound(initializer, scope);
        let mut nursery_span: SourceSpan? = null;
        if nursery_new {
            nursery_span = _nursery_origin_span(initializer, scope);
            if nursery_span == null {
                nursery_span = statement.initializer_span;
            }
        }
        // A Task-index initializer consumes its affine collection as a whole;
        // ordinary owned identifiers retain their established move behavior.
        let mut next = scope;
        if initializer != null {
            next = _consume_task_value(scope, initializer, true);
        }
        let entered = _enter_binding(next, statement.name, type_text, statement.span, owned_new
            || task_new, linear_new, task_new, channel_new, nursery_new, nursery_span);
        if initializer != null && _is_channel_aggregate_type(type_text, scope.task_returning_names) {
            let alias_roots = _expression_alias_roots(initializer, scope.bindings);
            if alias_roots.length > 0 {
                let marked = _mark_binding_alias_roots(entered.bindings, statement.name, alias_roots);
                return OwnershipScope {
                    bindings: marked,
                    tracked: entered.tracked,
                    findings: entered.findings,
                    extern_names: entered.extern_names,
                    task_returning_names: entered.task_returning_names,
                    routine_outer_count: entered.routine_outer_count
                };
            }
        }
        return entered;
    }
    if statement.variant == "BlockStatement" {
        // E2 boundary (#1211): the interior of `unsafe { }` is the
        // author-asserted raw-pointer region — the checker skips it.
        if statement.is_unsafe { return scope; }
        return _nested_block_scope(statement.body, scope);
    }
    if statement.variant == "IfStatement" {
        let base = _scope_after_expression(statement.condition, scope);
        let then_out = _nested_block_scope(statement.then_block, base);
        let mut else_out = OwnershipScope {
            bindings: base.bindings,
            tracked: then_out.tracked,
            findings: then_out.findings,
            extern_names: base.extern_names,
            task_returning_names: base.task_returning_names,
            routine_outer_count: base.routine_outer_count
        };
        let else_branch = statement.else_branch;
        if else_branch != null {
            let else_body = else_branch.body;
            if else_body != null {
                else_out = _nested_block_scope(else_body, else_out);
            }
            let else_statement = else_branch.statement;
            if else_statement != null {
                else_out = _scope_after_statement(else_statement, else_out);
            }
        }
        return OwnershipScope {
            bindings: _merge_task_binding_paths(then_out.bindings, else_out.bindings, base.bindings.length),
            tracked: else_out.tracked,
            findings: else_out.findings,
            extern_names: base.extern_names,
            task_returning_names: base.task_returning_names,
            routine_outer_count: base.routine_outer_count
        };
    }
    if statement.variant == "LoopStatement" {
        return _optional_block_scope(statement.body, scope);
    }
    if statement.variant == "RoutineStatement" {
        return _routine_block_scope(statement.body, scope);
    }
    if statement.variant == "ForStatement" {
        let iterable = statement.clause.iterable;
        let iterable_is_task = _expression_is_task_value(iterable, scope.bindings, scope.task_returning_names);
        let iterable_is_channel = _expression_is_channel_value(iterable, scope.bindings, scope.task_returning_names);
        let iterable_is_nursery = _expression_is_nursery_bound(iterable, scope);
        let iterable_nursery_span = _nursery_origin_span(iterable, scope);
        let mut target_type = trim_text(_expression_declared_type(iterable, scope.bindings, scope.task_returning_names));
        if target_type.length >= 2 {
            if substring(target_type, target_type.length - 2, target_type.length) == "[]" {
                target_type = trim_text(substring(target_type, 0, target_type.length - 2));
            }
        }
        if target_type.length == 0 && iterable_is_task {
            target_type = "Task<inferred>";
        }
        let mut next = _consume_task_value(scope, iterable, false);
        let mut child = OwnershipScope {
            bindings: _copy_bindings(next.bindings),
            tracked: next.tracked,
            findings: next.findings,
            extern_names: next.extern_names,
            task_returning_names: next.task_returning_names,
            routine_outer_count: next.routine_outer_count
        };
        let target = statement.clause.target;
        if target.variant == "Identifier" {
            child = _enter_binding(child, target.name, target_type, target.span, iterable_is_task, false, iterable_is_task, iterable_is_channel, iterable_is_nursery, iterable_nursery_span);
        }
        let child_out = _scope_after_block(statement.body, child);
        let swept = _sweep_unconsumed_linear(child_out, child_out.bindings, next.bindings.length);
        let body_bindings = _propagate_parent_task_bindings(next.bindings, swept.bindings, next.bindings.length);
        if !_block_reaches_next_iteration(statement.body) {
            return OwnershipScope {
                bindings: _merge_task_binding_paths(next.bindings, body_bindings, next.bindings.length),
                tracked: swept.tracked,
                findings: swept.findings,
                extern_names: next.extern_names,
                task_returning_names: next.task_returning_names,
                routine_outer_count: next.routine_outer_count
            };
        }
        // Probe a second iteration from the first iteration's parent Task
        // state. The loop target is freshly bound each iteration, while
        // outer handles retain their affine state.
        let mut second_child = OwnershipScope {
            bindings: _copy_bindings(body_bindings),
            tracked: swept.tracked,
            findings: swept.findings,
            extern_names: next.extern_names,
            task_returning_names: next.task_returning_names,
            routine_outer_count: next.routine_outer_count
        };
        if target.variant == "Identifier" {
            second_child = _enter_binding(second_child, target.name, target_type, target.span, iterable_is_task, false, iterable_is_task, iterable_is_channel, iterable_is_nursery, iterable_nursery_span);
        }
        let second_child_out = _scope_after_block(statement.body, second_child);
        let second_swept = _sweep_unconsumed_linear(second_child_out, second_child_out.bindings, next.bindings.length);
        let repeated_bindings = _propagate_parent_task_bindings(body_bindings, second_swept.bindings, next.bindings.length);
        return OwnershipScope {
            bindings: _merge_task_binding_paths(next.bindings, repeated_bindings, next.bindings.length),
            tracked: swept.tracked,
            findings: second_swept.findings,
            extern_names: next.extern_names,
            task_returning_names: next.task_returning_names,
            routine_outer_count: next.routine_outer_count
        };
    }
    if statement.variant == "WithStatement" {
        let mut next = scope;
        let mut clause_index: int = 0;
        loop {
            if clause_index >= statement.clauses.length { break; }
            next = _scope_after_expression(statement.clauses[clause_index].expression, next);
            clause_index += 1;
        }
        return _nested_block_scope(statement.body, next);
    }
    if statement.variant == "MatchStatement" {
        let match_type = _expression_declared_type(statement.expression, scope.bindings, scope.task_returning_names);
        let match_is_task = _expression_is_task_value(statement.expression, scope.bindings, scope.task_returning_names);
        let match_is_channel = _expression_is_channel_value(statement.expression, scope.bindings, scope.task_returning_names);
        let match_is_nursery = _expression_is_nursery_bound(statement.expression, scope);
        let match_nursery_span = _nursery_origin_span(statement.expression, scope);
        let base = _scope_after_expression(statement.expression, scope);
        let mut next = base;
        let mut merged_bindings = base.bindings;
        let mut saw_case: boolean = false;
        let mut case_index: int = 0;
        loop {
            if case_index >= statement.cases.length { break; }
            let case = statement.cases[case_index];
            // Arm scope: pattern-bound names enter as owned (copyable,
            // is_owned == false) before the guard and body walk,
            // mirroring `register_match_pattern_bindings` in typecheck.
            let mut child = OwnershipScope {
                bindings: _copy_bindings(base.bindings),
                tracked: next.tracked,
                findings: next.findings,
                extern_names: base.extern_names,
                task_returning_names: base.task_returning_names,
                routine_outer_count: base.routine_outer_count
            };
            child = _enter_pattern_bindings(case.pattern, match_type, match_is_task, match_is_channel, match_is_nursery, match_nursery_span, child);
            child = _scope_after_expression(case.guard, child);
            let child_out = _scope_after_block(case.body, child);
            let swept = _sweep_unconsumed_linear(child_out, child_out.bindings, base.bindings.length);
            let case_bindings = _propagate_parent_task_bindings(base.bindings, swept.bindings, base.bindings.length);
            if saw_case {
                merged_bindings = _merge_task_binding_paths(merged_bindings, case_bindings, base.bindings.length);
            } else {
                merged_bindings = case_bindings;
                saw_case = true;
            }
            next = OwnershipScope {
                bindings: base.bindings,
                tracked: swept.tracked,
                findings: swept.findings,
                extern_names: base.extern_names,
                task_returning_names: base.task_returning_names,
                routine_outer_count: base.routine_outer_count
            };
            case_index += 1;
        }
        if !saw_case { return next; }
        return OwnershipScope {
            bindings: merged_bindings,
            tracked: next.tracked,
            findings: next.findings,
            extern_names: base.extern_names,
            task_returning_names: base.task_returning_names,
            routine_outer_count: base.routine_outer_count
        };
    }
    if statement.variant == "TryStatement" {
        let try_out = _nested_block_scope(statement.try_block, scope);
        let mut next = try_out;
        let catch_block = statement.catch_block;
        if catch_block != null {
            // A catch continues an exceptional prefix of the try body. The
            // AST walk does not retain throw-edge snapshots, so the try's
            // conservative Task state is the safe catch entry: a Task that
            // may have been consumed before the throw cannot become live
            // again merely because control transferred to `catch`.
            let mut child = OwnershipScope {
                bindings: _copy_bindings(try_out.bindings),
                tracked: try_out.tracked,
                findings: try_out.findings,
                extern_names: scope.extern_names,
                task_returning_names: scope.task_returning_names,
                routine_outer_count: scope.routine_outer_count
            };
            let catch_name = statement.catch_name;
            if catch_name != null {
                child = _enter_binding(child, catch_name, "", null, false, false, false, false, false, null);
            }
            let child_out = _scope_after_block(catch_block, child);
            let swept = _sweep_unconsumed_linear(child_out, child_out.bindings, scope.bindings.length);
            let catch_bindings = _propagate_parent_task_bindings(try_out.bindings, swept.bindings, scope.bindings.length);
            next = OwnershipScope {
                bindings: _merge_task_binding_paths(try_out.bindings, catch_bindings, scope.bindings.length),
                tracked: swept.tracked,
                findings: swept.findings,
                extern_names: scope.extern_names,
                task_returning_names: scope.task_returning_names,
                routine_outer_count: scope.routine_outer_count
            };
        }
        let finally_block = statement.finally_block;
        if finally_block != null {
            next = _nested_block_scope(finally_block, next);
        }
        return next;
    }
    if statement.variant == "ReturnStatement" {
        let expression = statement.expression;
        if expression != null {
            let nursery_return = _expression_is_nursery_bound(expression, scope);
            let mut next = scope;
            if nursery_return {
                let source = _task_source_binding_name(expression, scope.bindings, scope.task_returning_names);
                let mut name = source;
                let handle_kind = _nursery_handle_kind(expression, scope);
                if name.length == 0 { name = handle_kind + " result"; }
                next = _push_finding(next, _make_nursery_finding(name, handle_kind, expression.span, _nursery_origin_span(expression, scope)));
            }
            return _consume_task_value(next, expression, false);
        }
        return scope;
    }
    if statement.variant == "ThrowStatement" {
        return _scope_after_expression(statement.expression, scope);
    }
    if statement.variant == "ExpressionStatement" {
        return _scope_after_expression(statement.expression, scope);
    }
    if statement.variant == "FunctionDeclaration" {
        // Nested fns get a fresh routine scope; the binding count and
        // findings flow back. `unsafe fn` bodies are skipped (E2).
        if statement.is_unsafe { return scope; }
        let summary = _analyze_routine_ownership(statement.signature.parameters, statement.body, scope.extern_names, scope.task_returning_names, scope.bindings, "");
        let merged = _append_warnings(scope.findings, summary.warnings);
        return OwnershipScope {
            bindings: scope.bindings,
            tracked: scope.tracked + summary.bindings_tracked,
            findings: merged,
            extern_names: scope.extern_names,
            task_returning_names: scope.task_returning_names,
            routine_outer_count: scope.routine_outer_count
        };
    }
    return scope;
}

// Mirror of `register_match_pattern_bindings` in typecheck/patterns.sfn: pattern
// names enter as copyable (is_owned == false) — destructured fields,
// shorthand-destructure names recovered from a `Raw` brace block, and
// bare catch-all identifiers.
fn _enter_pattern_field_binding(scope: OwnershipScope, name: string, source_type: string, source_is_task: boolean, source_is_channel: boolean, nursery_bound: boolean, nursery_span: SourceSpan?) -> OwnershipScope {
    let field_type = task_field_type(scope.task_returning_names, source_type, name);
    let mut is_task = source_is_task;
    let mut is_channel = source_is_channel;
    if field_type.length > 0 {
        is_task = task_type_is_bearing(scope.task_returning_names, field_type);
        is_channel = channel_type_is_bearing(scope.task_returning_names, field_type);
    }
    let field_nursery = nursery_bound && (is_task || is_channel);
    return _enter_binding(scope, name, field_type, null, is_task, false, is_task, is_channel, field_nursery, nursery_span);
}

fn _enter_pattern_bindings(pattern: Expression?, source_type: string, source_is_task: boolean, source_is_channel: boolean, nursery_bound: boolean, nursery_span: SourceSpan?, scope: OwnershipScope) -> OwnershipScope {
    if pattern == null { return scope; }
    if pattern.variant == "Struct" {
        let mut next = scope;
        let mut index: int = 0;
        loop {
            if index >= pattern.fields.length { break; }
            next = _enter_pattern_field_binding(next, pattern.fields[index].name, source_type, source_is_task, source_is_channel, nursery_bound, nursery_span);
            index += 1;
        }
        return next;
    }
    if pattern.variant == "Raw" {
        return _enter_raw_pattern_bindings(pattern.text, source_type, source_is_task, source_is_channel, nursery_bound, nursery_span, scope);
    }
    if pattern.variant == "Identifier" {
        if pattern.name == "_" { return scope; }
        return _enter_binding(scope, pattern.name, source_type, pattern.span, source_is_task, false, source_is_task, source_is_channel, nursery_bound, nursery_span);
    }
    return scope;
}

fn _enter_raw_pattern_bindings(text: string, source_type: string, source_is_task: boolean, source_is_channel: boolean, nursery_bound: boolean, nursery_span: SourceSpan?, scope: OwnershipScope) -> OwnershipScope {
    let mut next = scope;
    let mut in_block: boolean = false;
    let mut token: string = "";
    let mut index: int = 0;
    loop {
        if index >= text.length { break; }
        let ch = text[index];
        if !in_block {
            if ch == "{" { in_block = true; }
            index += 1;
            continue;
        }
        if ch == "}" {
            if token.length > 0 {
                next = _enter_pattern_field_binding(next, token, source_type, source_is_task, source_is_channel, nursery_bound, nursery_span);
                token = "";
            }
            break;
        }
        if is_identifier_char(ch) { token = token + ch; } else {
            if token.length > 0 {
                next = _enter_pattern_field_binding(next, token, source_type, source_is_task, source_is_channel, nursery_bound, nursery_span);
                token = "";
            }
        }
        index += 1;
    }
    return next;
}

// Expression walk. Reads of owned bindings are checked for
// use-after-move / use-after-free; call arguments are consuming
// positions (pass-by-value of an owned value is a move); lambdas open
// routine-like child scopes.
fn _scope_after_expression(expression: Expression?, scope: OwnershipScope) -> OwnershipScope {
    if expression == null { return scope; }
    if expression.variant == "Identifier" {
        return _check_read(scope, expression.name, expression.span);
    }
    if expression.variant == "Unary" {
        return _scope_after_expression(expression.operand, scope);
    }
    if expression.variant == "Binary" {
        let next = _scope_after_expression(expression.left, scope);
        return _scope_after_expression(expression.right, next);
    }
    if expression.variant == "Member" {
        return _scope_after_expression(expression.object, scope);
    }
    if expression.variant == "Call" {
        return _scope_after_call(expression, scope);
    }
    if expression.variant == "Index" {
        let next = _scope_after_expression(expression.sequence, scope);
        return _scope_after_expression(expression.index, next);
    }
    if expression.variant == "Array" {
        let mut next = scope;
        let mut index: int = 0;
        loop {
            if index >= expression.elements.length { break; }
            let element = expression.elements[index];
            next = _consume_task_value(next, element, false);
            index += 1;
        }
        return next;
    }
    if expression.variant == "Object" {
        let mut next = scope;
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            let value = expression.fields[index].value;
            next = _consume_task_value(next, value, false);
            index += 1;
        }
        return next;
    }
    if expression.variant == "Struct" {
        let mut next = scope;
        let mut index: int = 0;
        loop {
            if index >= expression.fields.length { break; }
            let value = expression.fields[index].value;
            next = _consume_task_value(next, value, false);
            index += 1;
        }
        return next;
    }
    if expression.variant == "Lambda" {
        let mut child = OwnershipScope {
            bindings: _copy_bindings(scope.bindings),
            tracked: scope.tracked,
            findings: scope.findings,
            extern_names: scope.extern_names,
            task_returning_names: scope.task_returning_names,
            // A lambda body owns its returns. Nursery provenance in its
            // captured Task environment is handled when the closure value is
            // created and consumed, not as a return from the enclosing block.
            routine_outer_count: -1
        };
        let mut index: int = 0;
        loop {
            if index >= expression.parameters.length { break; }
            let parameter = expression.parameters[index];
            let mut owned_param: boolean = false;
            let mut linear_param: boolean = false;
            let mut task_param: boolean = false;
            let p_annotation = parameter.type_annotation;
            if p_annotation != null {
                if is_owned_type(p_annotation.text) { owned_param = true; }
                if is_linear_type(p_annotation.text) { linear_param = true; }
                if is_task_type(p_annotation.text) { task_param = true; }
                if task_type_is_bearing(scope.task_returning_names, p_annotation.text) {
                    task_param = true;
                    owned_param = true;
                }
            }
            let mut parameter_type: string = "";
            if p_annotation != null { parameter_type = p_annotation.text; }
            let callable_type = _task_callable_type_from_annotation(parameter_type);
            if callable_type.length > 0 { parameter_type = callable_type; }
            child = _enter_binding(child, parameter.name, parameter_type, parameter.span, owned_param, linear_param, task_param, false, false, null);
            index += 1;
        }
        let child_out = _scope_after_block(expression.body, child);
        let parent_with_diagnostics = OwnershipScope {
            bindings: scope.bindings,
            tracked: child_out.tracked,
            findings: child_out.findings,
            extern_names: scope.extern_names,
            task_returning_names: scope.task_returning_names,
            routine_outer_count: scope.routine_outer_count
        };
        return _consume_task_lambda_captures(parent_with_diagnostics, expression, expression.span);
    }
    if expression.variant == "Range" {
        let next = _scope_after_expression(expression.start, scope);
        return _scope_after_expression(expression.end, next);
    }
    if expression.variant == "Cast" {
        return _scope_after_expression(expression.operand, scope);
    }
    if expression.variant == "TryOperator" {
        return _scope_after_expression(expression.operand, scope);
    }
    if expression.variant == "Conditional" {
        // Ternary alternatives are mutually exclusive. Analyze both from the
        // post-condition state, thread their diagnostics, then join Task
        // state exactly like statement-level `if`.
        let after_condition = _scope_after_expression(expression.condition, scope);
        let after_then = _scope_after_expression(expression.then_value, after_condition);
        let else_in = OwnershipScope {
            bindings: _copy_bindings(after_condition.bindings),
            tracked: after_then.tracked,
            findings: after_then.findings,
            extern_names: after_condition.extern_names,
            task_returning_names: after_condition.task_returning_names,
            routine_outer_count: after_condition.routine_outer_count
        };
        let after_else = _scope_after_expression(expression.else_value, else_in);
        return OwnershipScope {
            bindings: _merge_task_binding_paths(after_then.bindings, after_else.bindings, after_condition.bindings.length),
            tracked: after_else.tracked,
            findings: after_else.findings,
            extern_names: after_condition.extern_names,
            task_returning_names: after_condition.task_returning_names,
            routine_outer_count: after_condition.routine_outer_count
        };
    }
    if expression.variant == "Assignment" {
        // Assignment `target <op> rhs` (#1627 Part D). Thread the scope
        // through the rhs then the target so a move inside the rvalue
        // (`a = consume(buf)`) or an effectful/owning lvalue is recorded and a
        // later use of a moved binding is still caught. Rhs-before-target
        // matches evaluation order (the rvalue is computed before the store).
        let rhs_is_task = _expression_is_task_value(expression.rhs, scope.bindings, scope.task_returning_names);
        let rhs_is_channel = _expression_is_channel_value(expression.rhs, scope.bindings, scope.task_returning_names);
        let rhs_is_nursery = _expression_is_nursery_bound(expression.rhs, scope);
        let rhs_nursery_span = _nursery_origin_span(expression.rhs, scope);
        let mut after_rhs = _consume_task_value(scope, expression.rhs, false);
        if expression.operator == "=" && expression.target.variant == "Identifier" {
            let target_index = _find_binding_index(after_rhs.bindings, expression.target.name);
            if target_index >= 0 {
                // A Task-valued closure/aggregate may be assigned into a
                // previously copyable binding. Upgrade the destination to an
                // affine owner; an empty array retains an already-known Task
                // collection while clearing its nursery provenance.
                if rhs_is_task || (after_rhs.bindings[target_index].is_task
                    && expression.rhs.variant == "Array") {
                    let mut assigned_span = rhs_nursery_span;
                    if rhs_is_nursery { assigned_span = expression.span; }
                    let inferred_type = _inferred_task_binding_type(expression.rhs, scope.bindings, scope.task_returning_names);
                    let assigned = _mark_task_binding_owned(after_rhs.bindings, expression.target.name, rhs_is_nursery, assigned_span, inferred_type);
                    return OwnershipScope {
                        bindings: assigned,
                        tracked: after_rhs.tracked,
                        findings: after_rhs.findings,
                        extern_names: after_rhs.extern_names,
                        task_returning_names: after_rhs.task_returning_names,
                        routine_outer_count: after_rhs.routine_outer_count
                    };
                }
                if rhs_is_channel || (after_rhs.bindings[target_index].is_channel
                    && expression.rhs.variant == "Array") {
                    let mut assigned_span = rhs_nursery_span;
                    if rhs_is_nursery { assigned_span = expression.span; }
                    let mut assigned = _mark_channel_binding_owned(after_rhs.bindings, expression.target.name, rhs_is_nursery, assigned_span);
                    let destination_type = after_rhs.bindings[target_index].declared_type;
                    if _is_channel_aggregate_type(destination_type, scope.task_returning_names) {
                        let mut alias_roots = _expression_alias_roots(expression.rhs, scope.bindings);
                        if alias_roots.length == 0 {
                            alias_roots.push(target_index);
                        }
                        assigned = _mark_binding_alias_roots(assigned, expression.target.name, alias_roots);
                    }
                    return OwnershipScope {
                        bindings: assigned,
                        tracked: after_rhs.tracked,
                        findings: after_rhs.findings,
                        extern_names: after_rhs.extern_names,
                        task_returning_names: after_rhs.task_returning_names,
                        routine_outer_count: after_rhs.routine_outer_count
                    };
                }
            }
        }
        let after_target = _scope_after_expression(expression.target, after_rhs);
        if expression.operator == "=" && rhs_is_nursery && expression.target.variant == "Member" {
            if rhs_is_channel {
                return _store_channel_in_alias_roots(after_target, expression.target, expression.span);
            }
            let destination_name = _member_root_name(expression.target);
            let destination_index = _find_binding_index(after_target.bindings, destination_name);
            if destination_index >= 0 && destination_index < after_target.routine_outer_count {
                let handle_kind = _nursery_handle_kind(expression.rhs, scope);
                return _push_finding(after_target, _make_nursery_finding(destination_name, handle_kind, expression.span, after_target.bindings[destination_index].span));
            }
        }
        if expression.operator == "=" && expression.target.variant == "Index"
            && rhs_is_nursery {
            let sequence = expression.target.sequence;
            if rhs_is_task && sequence.variant == "Identifier" {
                let marked = _mark_task_collection_nursery_bound(after_target.bindings, sequence.name, expression.span);
                return OwnershipScope {
                    bindings: marked,
                    tracked: after_target.tracked,
                    findings: after_target.findings,
                    extern_names: after_target.extern_names,
                    task_returning_names: after_target.task_returning_names,
                    routine_outer_count: after_target.routine_outer_count
                };
            }
            if rhs_is_channel {
                return _store_channel_in_alias_roots(after_target, expression.target, expression.span);
            }
            let destination_name = _member_root_name(expression.target);
            let destination_index = _find_binding_index(after_target.bindings, destination_name);
            if destination_index >= 0 && destination_index < after_target.routine_outer_count {
                let handle_kind = _nursery_handle_kind(expression.rhs, scope);
                return _push_finding(after_target, _make_nursery_finding(destination_name, handle_kind, expression.span, after_target.bindings[destination_index].span));
            }
        }
        return after_target;
    }
    if expression.variant == "Spawn" {
        // A spawned closure captures owned values as moves (#1220). A
        // bare-fn spawn (`spawn foo(buf)`) is an ordinary call whose
        // bare-identifier args already move via `_consume_call_args`.
        let operand = expression.operand;
        if operand != null {
            if operand.variant == "Lambda" {
                return _consume_spawn_captures(scope, operand, expression.span);
            }
        }
        return _scope_after_expression(operand, scope);
    }
    if expression.variant == "Await" {
        let operand = expression.operand;
        return _consume_task_value(scope, operand, false);
    }
    if expression.variant == "Channel" {
        return _scope_after_expression(expression.capacity, scope);
    }
    if expression.variant == "Parallel" {
        // Each task is spawn-family: a directly-supplied closure captures
        // owned values as moves; a `spawn`-wrapped task routes through the
        // `Spawn` arm above. Both lift capture-moves into this scope.
        let mut next = scope;
        let mut index: int = 0;
        loop {
            if index >= expression.tasks.length { break; }
            let task = expression.tasks[index];
            if task.variant == "Lambda" {
                next = _consume_spawn_captures(next, task, expression.span);
            } else { next = _scope_after_expression(task, next); }
            index += 1;
        }
        return next;
    }
    if expression.variant == "Serve" {
        // The accept-loop handler is a spawn-family escape: an owned value
        // it captures crosses into per-connection workers and is moved.
        let mut next = scope;
        let handler = expression.handler;
        if handler.variant == "Lambda" {
            next = _consume_spawn_captures(next, handler, expression.span);
        } else { next = _scope_after_expression(handler, next); }
        return _scope_after_expression(expression.port, next);
    }
    return scope;
}

// Call-expression walk, split out so the ownership-relevant call shapes
// (disposers, in-place mutators, FFI escapes) are classified before the
// generic callee/argument walk:
//
//   - `free(x)` / `drop(x)` / `x.free()` / `x.drop()` on an owned
//     binding -> disposal (`Owned -> Freed`); a stale receiver is
//     use-after-free (`E0903`) / use-after-move (`E0901`).
//   - `x.grow/.append/.set(...)` on an owned receiver -> in-place
//     mutation: `E0902` on a stale (moved/freed) receiver; sound (no
//     state change) through the unique live owner.
//   - a bare owned identifier passed into an `extern fn` -> `E0906`.
//
// Anything else falls through to the generic walk (callee then args).
fn _first_nursery_task_argument(arguments: Expression[], scope: OwnershipScope) -> int {
    let mut index: int = 0;
    loop {
        if index >= arguments.length { break; }
        if _expression_is_nursery_bound(arguments[index], scope) {
            return index;
        }
        index += 1;
    }
    return -1;
}

fn _scope_after_call(expression: Expression, scope: OwnershipScope) -> OwnershipScope {
    let callee = expression.callee;
    let nursery_argument_index = _first_nursery_task_argument(expression.arguments, scope);
    if nursery_argument_index >= 0 && callee.variant == "Member" {
        if _is_mutator_method(callee.member) {
            let argument = expression.arguments[nursery_argument_index];
            let handle_kind = _nursery_handle_kind(argument, scope);
            let mut name = _task_source_binding_name(argument, scope.bindings, scope.task_returning_names);
            if name.length == 0 { name = handle_kind + " argument"; }
            return _push_finding(scope, _make_nursery_finding(name, handle_kind, argument.span, expression.span));
        }
    }
    let mut pushes_nursery_task: boolean = false;
    let mut pushes_nursery_channel: boolean = false;
    let mut pushed_nursery_span: SourceSpan? = null;
    if callee.variant == "Member" {
        if callee.member == "push" {
            let receiver_type = _expression_declared_type(callee.object, scope.bindings, scope.task_returning_names);
            if is_task_type(receiver_type) || _is_channel_collection_type(receiver_type, scope.task_returning_names) {
                let mut push_index: int = 0;
                loop {
                    if push_index >= expression.arguments.length { break; }
                    if _expression_is_nursery_bound(expression.arguments[push_index], scope) {
                        if is_task_type(receiver_type) {
                            pushes_nursery_task = true;
                        }
                        if _is_channel_collection_type(receiver_type, scope.task_returning_names) {
                            pushes_nursery_channel = true;
                        }
                        // E0838 should point at the escaping store, while the
                        // diagnostic note points at the destination binding.
                        pushed_nursery_span = expression.span;
                        break;
                    }
                    push_index += 1;
                }
            }
        }
    }
    // --- Disposer, free-function form: free(x) / drop(x) ---
    if callee.variant == "Identifier" {
        if _is_disposer_name(callee.name) {
            if expression.arguments.length >= 1 {
                let first = expression.arguments[0];
                if first.variant == "Identifier" {
                    let di = _find_binding_index(scope.bindings, first.name);
                    if di >= 0 {
                        let db = scope.bindings[di];
                        if db.is_owned {
                            if db.state == "freed" {
                                return _push_finding(scope, _make_finding(first.name, first.span, db.moved_span, "E0903"));
                            }
                            if db.state == "moved" {
                                return _push_finding(scope, _make_finding(first.name, first.span, db.moved_span, "E0901"));
                            }
                            let freed = _mark_binding_freed_at(scope.bindings, first.name, first.span);
                            return OwnershipScope {
                                bindings: freed,
                                tracked: scope.tracked,
                                findings: scope.findings,
                                extern_names: scope.extern_names,
                                task_returning_names: scope.task_returning_names,
                                routine_outer_count: scope.routine_outer_count
                            };
                        }
                    }
                }
            }
        }
    }
    // --- Method-call forms: x.free()/x.drop() (disposer) and
    //     x.grow/.append/.set(...) (in-place mutator) ---
    if callee.variant == "Member" {
        let recv = callee.object;
        if recv.variant == "Identifier" {
            let ri = _find_binding_index(scope.bindings, recv.name);
            if ri >= 0 {
                let rb = scope.bindings[ri];
                if rb.is_owned {
                    if _is_disposer_name(callee.member) {
                        if rb.state == "freed" {
                            return _push_finding(scope, _make_finding(recv.name, recv.span, rb.moved_span, "E0903"));
                        }
                        if rb.state == "moved" {
                            return _push_finding(scope, _make_finding(recv.name, recv.span, rb.moved_span, "E0901"));
                        }
                        let freed = _mark_binding_freed_at(scope.bindings, recv.name, recv.span);
                        let after = OwnershipScope {
                            bindings: freed,
                            tracked: scope.tracked,
                            findings: scope.findings,
                            extern_names: scope.extern_names,
                            task_returning_names: scope.task_returning_names,
                            routine_outer_count: scope.routine_outer_count
                        };
                        return _consume_call_args(expression.arguments, after, false);
                    }
                    if _is_mutator_method(callee.member) {
                        if rb.state == "moved" {
                            let after = _push_finding(scope, _make_finding(recv.name, recv.span, rb.moved_span, "E0902"));
                            return _consume_call_args(expression.arguments, after, false);
                        }
                        if rb.state == "freed" {
                            let after = _push_finding(scope, _make_finding(recv.name, recv.span, rb.moved_span, "E0903"));
                            return _consume_call_args(expression.arguments, after, false);
                        }
                        // Live unique owner: in-place mutation is sound;
                        // the receiver stays `Owned` (not read-consumed).
                        // Walk only the arguments.
                        //
                        // `.grow/.append/.set` denote an in-place `&mut
                        // self` mutator (proposal §3.2) — NOT sugar for
                        // the shipped consume-and-return free function
                        // `owned_buf_append(self: OwnedBuf, ...) ->
                        // OwnedBuf`. The two surfaces are complementary
                        // and both sound: the free-function form is a
                        // bare-identifier argument, so the *move* rules
                        // (E0901/E0904) already cover it (`buf` dies, the
                        // returned buffer is the new unique owner); the
                        // in-place method form is covered here by E0902
                        // (a stale receiver is the violation; the unique
                        // live owner grows in place without consuming).
                        // Keeping the live-owner mutator non-consuming is
                        // what makes `buf.append(x); return buf;` — the
                        // sound grow-at-tip path the issue requires to
                        // compile clean — legal. Which surface the
                        // migrated runtime adopts is settled by E8.
                        return _consume_call_args(expression.arguments, scope, false);
                    }
                }
            }
        }
    }
    // Calling a method on a Task-bearing aggregate transfers the affine
    // receiver into that call. Otherwise two calls could each extract and
    // consume the same contained handle even though the method body is
    // individually valid. Direct Task collections retain their dedicated
    // `push`/`join_all` handling above.
    if callee.variant == "Member" {
        let receiver_type = _expression_declared_type(callee.object, scope.bindings, scope.task_returning_names);
        if !is_task_type(receiver_type) && task_type_is_bearing(scope.task_returning_names, receiver_type) {
            let after_receiver = _consume_task_value(scope, callee.object, false);
            let after_args = _consume_call_args(expression.arguments, after_receiver, false);
            if nursery_argument_index >= 0 {
                let argument = expression.arguments[nursery_argument_index];
                let handle_kind = _nursery_handle_kind(argument, scope);
                let mut name = _task_source_binding_name(argument, scope.bindings, scope.task_returning_names);
                if name.length == 0 { name = handle_kind + " argument"; }
                return _push_finding(after_args, _make_nursery_finding(name, handle_kind, argument.span, expression.span));
            }
            return after_args;
        }
    }
    // --- Generic walk: callee then arguments, with the E0906 FFI-escape
    //     check active when the callee is a known extern fn. ---
    let mut next = scope;
    if callee.variant == "Identifier" {
        let callee_index = _find_binding_index(scope.bindings, callee.name);
        if callee_index >= 0 {
            if scope.bindings[callee_index].is_task {
                next = _consume_identifier(scope, callee.name, callee.span, false);
            } else {
                next = _scope_after_expression(expression.callee, scope);
            }
        } else {
            next = _scope_after_expression(expression.callee, scope);
        }
    } else { next = _scope_after_expression(expression.callee, scope); }
    let mut extern_call: boolean = false;
    if callee.variant == "Identifier" {
        if _name_in_list(scope.extern_names, callee.name) { extern_call = true; }
    }
    let after_args = _consume_call_args(expression.arguments, next, extern_call);
    if (pushes_nursery_task || pushes_nursery_channel) && callee.variant == "Member" {
        let receiver = callee.object;
        let destination_name = _member_root_name(receiver);
        let destination_index = _find_binding_index(after_args.bindings, destination_name);
        if destination_index >= 0 {
            let mut marked_scope = after_args;
            if pushes_nursery_task {
                let marked = _mark_task_collection_nursery_bound(marked_scope.bindings, destination_name, pushed_nursery_span);
                marked_scope = OwnershipScope {
                    bindings: marked,
                    tracked: marked_scope.tracked,
                    findings: marked_scope.findings,
                    extern_names: marked_scope.extern_names,
                    task_returning_names: marked_scope.task_returning_names,
                    routine_outer_count: marked_scope.routine_outer_count
                };
            }
            if pushes_nursery_channel {
                marked_scope = _store_channel_in_alias_roots(marked_scope, receiver, pushed_nursery_span);
            }
            return marked_scope;
        }
    }
    if nursery_argument_index >= 0 {
        let mut tracked_call: boolean = false;
        if callee.variant == "Identifier" {
            if callee.name == "join_all" && _find_binding_index(scope.bindings, callee.name) < 0
                && !_name_in_list(scope.task_returning_names, declared_callable_key(callee.name)) {
                tracked_call = true;
            }
        } else if callee.variant == "Member" {
            if pushes_nursery_task || pushes_nursery_channel {
                tracked_call = true;
            }
        }
        if !tracked_call {
            let argument = expression.arguments[nursery_argument_index];
            let handle_kind = _nursery_handle_kind(argument, scope);
            let mut name = _task_source_binding_name(argument, scope.bindings, scope.task_returning_names);
            if name.length == 0 { name = handle_kind + " argument"; }
            return _push_finding(after_args, _make_nursery_finding(name, handle_kind, argument.span, expression.span));
        }
    }
    return after_args;
}

// -------------------------------------------------------------------
// Routine / program analysis
// -------------------------------------------------------------------
fn _empty_summary() -> OwnershipSummary {
    let warnings: OwnershipWarning[] = [];
    return OwnershipSummary { bindings_tracked: 0, warnings: warnings };
}

fn _append_warnings(warnings: OwnershipWarning[], additions: OwnershipWarning[]) -> OwnershipWarning[] {
    let mut result = warnings;
    let mut index: int = 0;
    loop {
        if index >= additions.length { break; }
        result.push(additions[index]);
        index += 1;
    }
    return result;
}

// Collect the program-level `extern fn` name set, threaded read-only
// into every routine scope so the `E0906` escape check can recognize an
// FFI callee. Only top-level extern declarations *in this compilation
// unit* are gathered. An extern resolved implicitly — the prelude /
// `runtime/sfn/**` externs the compiler treats as in-scope without a
// local re-declaration (e.g. `memcpy`, `malloc`; see
// `prelude_globals.load_prelude_global_names`) — is therefore NOT
// matched, so `E0906` is a deliberate false negative for those callees
// at E6. This is self-host-safe (never a false positive) and avoids
// forcing this pure pass to take an `![io]` dependency on the prelude
// FS scan; widening to implicitly-linked externs (with an extern-only
// name source) is a follow-up. In practice the common bypass is already
// blocked upstream: passing a bare owned value to a `* u8`-typed extern
// parameter is a typecheck error before this pass runs.
fn _gather_extern_names(program: Program) -> string[] {
    let mut names: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= program.statements.length { break; }
        let statement = program.statements[index];
        if statement.variant == "ExternFunctionDeclaration" {
            names.push(statement.signature.name);
        }
        index += 1;
    }
    return names;
}

// Top-level bindings outlive every routine nursery. Seed them into each
// routine's ownership environment so a nursery-origin handle cannot escape by
// mutating a module-global scalar, collection, or aggregate field. Copyable
// globals remain untracked for moves but provide a destination identity.
fn _gather_global_task_bindings(program: Program, task_returning_names: string[]) -> OwnershipBinding[] {
    let mut bindings: OwnershipBinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= program.statements.length { break; }
        let statement = program.statements[index];
        if statement.variant == "VariableDeclaration" {
            let mut has_type: boolean = false;
            let mut type_text: string = "";
            let annotation = statement.type_annotation;
            if annotation != null {
                has_type = true;
                type_text = annotation.text;
            } else {
                let initializer = statement.initializer;
                if initializer != null {
                    if initializer.variant == "Struct" {
                        if initializer.type_name.length > 0 {
                            type_text = initializer.type_name[initializer.type_name.length - 1];
                        }
                    }
                }
            }
            if type_text.length == 0 {
                let callable_type = _inferred_task_callable_type(statement.initializer, bindings, task_returning_names);
                if callable_type.length > 0 { type_text = callable_type; }
            } else {
                let callable_type = _task_callable_type_from_annotation(type_text);
                if callable_type.length > 0 { type_text = callable_type; }
            }
            let is_task = _binding_is_task(type_text, has_type, statement.initializer, bindings, task_returning_names);
            let is_channel = _binding_is_channel(type_text, statement.initializer, bindings, task_returning_names);
            if type_text.length == 0 && is_task {
                type_text = _inferred_task_binding_type(statement.initializer, bindings, task_returning_names);
            }
            let mut alias_roots: int[] = [];
            alias_roots.push(bindings.length);
            bindings.push(OwnershipBinding {
                name: statement.name, alias_roots: alias_roots, declared_type: type_text, state: "owned", span: statement.span, is_owned: is_task, is_linear: false, is_task: is_task, is_channel: is_channel, nursery_bound: false, nursery_span: null, moved_span: null
            });
        }
        index += 1;
    }
    return bindings;
}

fn _analyze_routine_ownership(parameters: Parameter[], body: Block, extern_names: string[], task_returning_names: string[], initial_bindings: OwnershipBinding[], receiver_type: string) -> OwnershipSummary {
    let no_findings: OwnershipWarning[] = [];
    let mut scope = OwnershipScope {
        bindings: _copy_bindings(initial_bindings),
        tracked: 0,
        findings: no_findings,
        extern_names: extern_names,
        task_returning_names: task_returning_names,
        routine_outer_count: -1
    };
    let initial_count = initial_bindings.length;
    let mut index: int = 0;
    loop {
        if index >= parameters.length { break; }
        let parameter = parameters[index];
        let mut owned_param: boolean = false;
        let mut linear_param: boolean = false;
        let mut task_param: boolean = false;
        let annotation = parameter.type_annotation;
        if annotation != null {
            if is_owned_type(annotation.text) { owned_param = true; }
            if is_linear_type(annotation.text) { linear_param = true; }
            if is_task_type(annotation.text) { task_param = true; }
        }
        let mut parameter_type: string = "";
        if annotation != null { parameter_type = annotation.text; }
        if parameter_type.length == 0 && parameter.name == "self" {
            parameter_type = receiver_type;
        }
        let callable_type = _task_callable_type_from_annotation(parameter_type);
        if callable_type.length > 0 { parameter_type = callable_type; }
        if task_type_is_bearing(task_returning_names, parameter_type) {
            task_param = true;
            owned_param = true;
        }
        let channel_param = channel_type_is_bearing(task_returning_names, parameter_type);
        scope = _enter_binding(scope, parameter.name, parameter_type, parameter.span, owned_param, linear_param, task_param, channel_param, false, null);
        index += 1;
    }
    let out = _scope_after_block(body, scope);
    // Routine-boundary sweep: any linear parameter or body-level `let`
    // still in state "owned" was never consumed -> E0907.
    let swept = _sweep_unconsumed_linear(out, out.bindings, initial_count);
    return OwnershipSummary {
        bindings_tracked: swept.tracked,
        warnings: swept.findings
    };
}

fn _statement_summary(statement: Statement, extern_names: string[], task_returning_names: string[], global_task_bindings: OwnershipBinding[]) -> OwnershipSummary {
    if statement.variant == "FunctionDeclaration" {
        if statement.is_unsafe { return _empty_summary(); }
        return _analyze_routine_ownership(statement.signature.parameters, statement.body, extern_names, task_returning_names, global_task_bindings, "");
    }
    if statement.variant == "TestDeclaration" {
        let no_parameters: Parameter[] = [];
        return _analyze_routine_ownership(no_parameters, statement.body, extern_names, task_returning_names, global_task_bindings, "");
    }
    if statement.variant == "StructDeclaration" {
        let mut warnings: OwnershipWarning[] = [];
        let mut tracked: int = 0;
        let mut index: int = 0;
        loop {
            if index >= statement.methods.length { break; }
            let method = statement.methods[index];
            let summary = _analyze_routine_ownership(method.signature.parameters, method.body, extern_names, task_returning_names, global_task_bindings, statement.name);
            tracked = tracked + summary.bindings_tracked;
            warnings = _append_warnings(warnings, summary.warnings);
            index += 1;
        }
        return OwnershipSummary {
            bindings_tracked: tracked,
            warnings: warnings
        };
    }
    return _empty_summary();
}

// Full-program analysis. Exposed (alongside the lattice helpers) so unit
// tests can pin both the walk's coverage and the rule findings.
fn analyze_program_ownership_with_imports(program: Program, imports: ImportSymbolTable) -> OwnershipSummary {
    let extern_names = _gather_extern_names(program);
    let task_returning_names = gather_task_returning_names(program, imports);
    let global_task_bindings = _gather_global_task_bindings(program, task_returning_names);
    let mut warnings: OwnershipWarning[] = [];
    let mut tracked: int = 0;
    let mut index: int = 0;
    loop {
        if index >= program.statements.length { break; }
        let summary = _statement_summary(program.statements[index], extern_names, task_returning_names, global_task_bindings);
        tracked = tracked + summary.bindings_tracked;
        warnings = _append_warnings(warnings, summary.warnings);
        index += 1;
    }
    return OwnershipSummary { bindings_tracked: tracked, warnings: warnings };
}

fn analyze_program_ownership(program: Program) -> OwnershipSummary {
    return analyze_program_ownership_with_imports(program, empty_import_symbols());
}

// Findings-stream view, mirroring `validate_effects`' shape.
fn check_ownership(program: Program) -> OwnershipWarning[] {
    return analyze_program_ownership(program).warnings;
}

fn check_ownership_with_imports(program: Program, imports: ImportSymbolTable) -> OwnershipWarning[] {
    return analyze_program_ownership_with_imports(program, imports).warnings;
}
