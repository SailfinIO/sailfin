// compiler/src/parser/declarations/mod.sfn
//
// Declaration parser facade. Implementations are grouped by declaration kind
// so each compiler module stays small enough to compile with a bounded worker
// memory footprint.
export {
    consume_annotation_separator,
    consume_return_type_separator,
    parse_decorators,
    parse_decorator_argument,
    parse_effect_list,
    parse_type_parameter_clause,
    parse_implements_clause,
    parse_parameter_list,
    parse_single_parameter
} from "./syntax";

export {
    parse_import,
    parse_export,
    parse_specifier_list,
    build_import_specifiers,
    build_export_specifiers
} from "./imports_exports";

export { parse_variable, parse_variable_with_storage } from "./variables";

export { parse_function, parse_extern_function, parse_extern_var } from "./functions";

export { parse_struct, parse_struct_field, parse_struct_method } from "./structs";

export { parse_enum, parse_enum_variant, parse_enum_variant_field } from "./enums";

export { parse_interface, parse_interface_member, parse_type_alias } from "./interfaces";

export { parse_test, parse_lifecycle_hook } from "./tests";

export { parse_unknown } from "./recovery";
