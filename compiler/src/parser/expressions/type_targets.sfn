// compiler/src/parser/expressions/type_targets.sfn
//
// Cast and type-guard target parsing.
import { identifier_matches, identifier_text } from "../token_utils";
import { CastTargetParseResult, ExpressionTokens } from "../types";
import {
    expression_tokens_advance,
    expression_tokens_is_at_end,
    expression_tokens_peek
} from "./mod";

// Append a lexeme to an accumulator string, prefixing a space when the
// accumulator is non-empty. Used by `read_cast_target` to build the
// target-type text from individual token lexemes.
fn _cast_target_append(acc: string, lexeme: string) -> string {
    if acc.length == 0 { return lexeme; }
    return acc + " " + lexeme;
}

// Read a cast target type after `as`, consuming pointer prefixes, named
// types with generic argument lists (`Foo<X, Y>`), and fn-pointer targets
// (`fn (A) -> B`, `fn (A) -> * B`). Joins all consumed lexemes with
// single spaces into `text` — the Cast formatter serializes the text
// verbatim, and the shadow lowering re-parser is whitespace-insensitive,
// so the join is round-trip-safe. Returns `success:false` on a
// genuinely unparseable target (missing identifier, unbalanced brackets).
fn read_cast_target(state: ExpressionTokens) -> CastTargetParseResult {
    let mut cursor = state;
    let mut text: string = "";

    // Step 1: Accumulate optional leading `*` pointer-prefix symbols.
    loop {
        if expression_tokens_is_at_end(cursor) { break; }
        let tok = expression_tokens_peek(cursor);
        if tok.kind.variant != "Symbol" { break; }
        if !strings_equal(tok.lexeme, "*") { break; }
        text = _cast_target_append(text, "*");
        cursor = expression_tokens_advance(cursor);
    }

    if expression_tokens_is_at_end(cursor) {
        return CastTargetParseResult {
            state: state,
            text: "",
            success: false
        };
    }

    let head_tok = expression_tokens_peek(cursor);

    // Step 2a: Function-pointer target — starts with `fn`.
    if head_tok.kind.variant == "Identifier" {
        if identifier_matches(head_tok, "fn") {
            text = _cast_target_append(text, "fn");
            cursor = expression_tokens_advance(cursor);

            // Expect a balanced `( ... )` parameter list.
            if expression_tokens_is_at_end(cursor) {
                return CastTargetParseResult {
                    state: state,
                    text: "",
                    success: false
                };
            }
            let paren_tok = expression_tokens_peek(cursor);
            if !strings_equal(paren_tok.lexeme, "(") {
                return CastTargetParseResult {
                    state: state,
                    text: "",
                    success: false
                };
            }
            text = _cast_target_append(text, "(");
            cursor = expression_tokens_advance(cursor);
            let mut paren_depth: int = 1;
            loop {
                if expression_tokens_is_at_end(cursor) {
                    return CastTargetParseResult {
                        state: state,
                        text: "",
                        success: false
                    };
                }
                let inner_tok = expression_tokens_peek(cursor);
                if strings_equal(inner_tok.lexeme, "(") { paren_depth += 1; }
                if strings_equal(inner_tok.lexeme, ")") {
                    paren_depth -= 1;
                    if paren_depth == 0 {
                        text = _cast_target_append(text, ")");
                        cursor = expression_tokens_advance(cursor);
                        break;
                    }
                }
                text = _cast_target_append(text, inner_tok.lexeme);
                cursor = expression_tokens_advance(cursor);
            }

            // Optional `->` return type: may lex as symbol `->` or as two
            // separate symbols `-` then `>`.
            if !expression_tokens_is_at_end(cursor) {
                let arr_tok = expression_tokens_peek(cursor);
                let mut has_arrow: boolean = false;
                let mut arrow_cursor = cursor;
                if arr_tok.kind.variant == "Symbol" {
                    if strings_equal(arr_tok.lexeme, "->") {
                        has_arrow = true;
                        arrow_cursor = expression_tokens_advance(cursor);
                    }
                    if strings_equal(arr_tok.lexeme, "-") {
                        let after_minus = expression_tokens_advance(cursor);
                        if !expression_tokens_is_at_end(after_minus) {
                            let gt_tok = expression_tokens_peek(after_minus);
                            if strings_equal(gt_tok.lexeme, ">") {
                                has_arrow = true;
                                arrow_cursor = expression_tokens_advance(after_minus);
                            }
                        }
                    }
                }
                if has_arrow {
                    text = _cast_target_append(text, "->");
                    cursor = arrow_cursor;
                    // Return type: read recursively via the same target grammar.
                    let ret_result = read_cast_target(cursor);
                    if !ret_result.success {
                        return CastTargetParseResult {
                            state: state,
                            text: "",
                            success: false
                        };
                    }
                    text = _cast_target_append(text, ret_result.text);
                    cursor = ret_result.state;
                }
            }

            return CastTargetParseResult {
                state: cursor,
                text: text,
                success: true
            };
        }
    }

    // Step 2b: Named type with an optional generic argument list `< ... >`.
    if head_tok.kind.variant != "Identifier" {
        return CastTargetParseResult {
            state: state,
            text: "",
            success: false
        };
    }
    text = _cast_target_append(text, identifier_text(head_tok));
    cursor = expression_tokens_advance(cursor);

    // Optional generic args: consume `< ... >` balancing angle brackets.
    if !expression_tokens_is_at_end(cursor) {
        let maybe_lt = expression_tokens_peek(cursor);
        if maybe_lt.kind.variant == "Symbol" {
            if strings_equal(maybe_lt.lexeme, "<") {
                text = _cast_target_append(text, "<");
                cursor = expression_tokens_advance(cursor);
                let mut angle_depth: int = 1;
                loop {
                    if expression_tokens_is_at_end(cursor) {
                        return CastTargetParseResult {
                            state: state,
                            text: "",
                            success: false
                        };
                    }
                    let g_tok = expression_tokens_peek(cursor);
                    if strings_equal(g_tok.lexeme, "<") {
                        angle_depth += 1;
                        text = _cast_target_append(text, g_tok.lexeme);
                        cursor = expression_tokens_advance(cursor);
                    } else if strings_equal(g_tok.lexeme, ">>") {
                        if angle_depth >= 2 { angle_depth -= 2; } else {
                            angle_depth = 0;
                        }
                        if angle_depth == 0 {
                            text = _cast_target_append(text, ">");
                            cursor = expression_tokens_advance(cursor);
                            break;
                        }
                        text = _cast_target_append(text, ">>");
                        cursor = expression_tokens_advance(cursor);
                    } else if strings_equal(g_tok.lexeme, ">") {
                        angle_depth -= 1;
                        if angle_depth == 0 {
                            text = _cast_target_append(text, ">");
                            cursor = expression_tokens_advance(cursor);
                            break;
                        }
                        text = _cast_target_append(text, ">");
                        cursor = expression_tokens_advance(cursor);
                    } else {
                        text = _cast_target_append(text, g_tok.lexeme);
                        cursor = expression_tokens_advance(cursor);
                    }
                }
            }
        }
    }

    return CastTargetParseResult {
        state: cursor,
        text: text,
        success: true
    };
}

// Read an `is` type-guard target (issue #1753). A narrower sibling of
// `read_cast_target`: `is` is a runtime type predicate, not a reinterpret
// cast, so it accepts ONLY a named type with an optional generic argument
// list (`Foo`, `Foo<X, Y>`) — no pointer prefix (`* T`) and no fn-pointer
// (`fn (A) -> B`) forms, which are meaningless as a guard target. This is
// exactly Step 2b of `read_cast_target`. Returns `success:false` on a
// non-identifier head or unbalanced generic brackets so the enclosing
// expression falls through to `expression_parse_failure` → `Raw`.
fn read_is_target(state: ExpressionTokens) -> CastTargetParseResult {
    let mut cursor = state;
    let mut text: string = "";

    if expression_tokens_is_at_end(cursor) {
        return CastTargetParseResult {
            state: state,
            text: "",
            success: false
        };
    }
    let head_tok = expression_tokens_peek(cursor);
    if head_tok.kind.variant != "Identifier" {
        return CastTargetParseResult {
            state: state,
            text: "",
            success: false
        };
    }
    text = _cast_target_append(text, identifier_text(head_tok));
    cursor = expression_tokens_advance(cursor);

    // Optional generic args: consume `< ... >` balancing angle brackets,
    // identical to `read_cast_target` Step 2b.
    if !expression_tokens_is_at_end(cursor) {
        let maybe_lt = expression_tokens_peek(cursor);
        if maybe_lt.kind.variant == "Symbol" {
            if strings_equal(maybe_lt.lexeme, "<") {
                text = _cast_target_append(text, "<");
                cursor = expression_tokens_advance(cursor);
                let mut angle_depth: int = 1;
                loop {
                    if expression_tokens_is_at_end(cursor) {
                        return CastTargetParseResult {
                            state: state,
                            text: "",
                            success: false
                        };
                    }
                    let g_tok = expression_tokens_peek(cursor);
                    if strings_equal(g_tok.lexeme, "<") {
                        angle_depth += 1;
                        text = _cast_target_append(text, g_tok.lexeme);
                        cursor = expression_tokens_advance(cursor);
                    } else if strings_equal(g_tok.lexeme, ">>") {
                        if angle_depth >= 2 { angle_depth -= 2; } else {
                            angle_depth = 0;
                        }
                        if angle_depth == 0 {
                            text = _cast_target_append(text, ">");
                            cursor = expression_tokens_advance(cursor);
                            break;
                        }
                        text = _cast_target_append(text, ">>");
                        cursor = expression_tokens_advance(cursor);
                    } else if strings_equal(g_tok.lexeme, ">") {
                        angle_depth -= 1;
                        if angle_depth == 0 {
                            text = _cast_target_append(text, ">");
                            cursor = expression_tokens_advance(cursor);
                            break;
                        }
                        text = _cast_target_append(text, ">");
                        cursor = expression_tokens_advance(cursor);
                    } else {
                        text = _cast_target_append(text, g_tok.lexeme);
                        cursor = expression_tokens_advance(cursor);
                    }
                }
            }
        }
    }

    return CastTargetParseResult {
        state: cursor,
        text: text,
        success: true
    };
}
