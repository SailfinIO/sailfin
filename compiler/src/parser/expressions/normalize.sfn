// compiler/src/parser/expressions/normalize.sfn
//
// Operator precedence, normalization helpers, and expression append helpers.
import { Expression, ObjectField, Parameter } from "../../ast";
import {
    char_at,
    char_code,
    strings_equal,
    substring
} from "../../string_utils";

// ============================================================================
// Operator Precedence
// ============================================================================
// Operator precedence ladder (low to high) following C/Rust
// convention. Lower number = lower precedence (binds looser).
//   0   ..        (range)
//   1   ||        (logical OR)
//   2   &&        (logical AND)
//   3   |         (bitwise OR)              [Slice B 2026-05-02]
//   4   ^         (bitwise XOR)             [Slice B]
//   5   &         (bitwise AND)             [Slice B]
//   6   == !=
//   7   < <= > >=
//   8   << >>     (bitwise shift)           [Slice B]
//   9   + -
//  10   * / %
//  11   unary !   (logical NOT)
fn binary_precedence(op: string) -> int {
    if op == ".." { return 0; }
    if op == "||" { return 1; }
    if op == "&&" { return 2; }
    if op == "|" { return 3; }
    if op == "^" { return 4; }
    if op == "&" { return 5; }
    let mut _if405: boolean = false;
    if op == "==" { _if405 = true; }
    if op == "!=" { _if405 = true; }
    if _if405 { return 6; }
    let mut _if406: boolean = false;
    if op == "<" { _if406 = true; }
    if op == "<=" { _if406 = true; }
    if op == ">" { _if406 = true; }
    if op == ">=" { _if406 = true; }
    if _if406 { return 7; }
    let mut _if409: boolean = false;
    if op == "<<" { _if409 = true; }
    if op == ">>" { _if409 = true; }
    if _if409 { return 8; }
    let mut _if407: boolean = false;
    if op == "+" { _if407 = true; }
    if op == "-" { _if407 = true; }
    if _if407 { return 9; }
    let mut _if408: boolean = false;
    if op == "*" { _if408 = true; }
    if op == "/" { _if408 = true; }
    if op == "%" { _if408 = true; }
    if _if408 { return 10; }
    return -1;
}

fn unary_precedence() -> int { return 11; }

// ============================================================================
// Expression Normalization Helpers
// ============================================================================
// The public normalization entry point stays in mod.sfn with the folder API.
fn strip_surrounding_quotes_expr(text: string) -> string {
    if text.length < 2 { return text; }
    let first = char_code(char_at(text, 0));
    let last = char_code(char_at(text, text.length - 1));
    if first == 34 {
        if last == 34 { return substring(text, 1, text.length - 1); }
    }
    return text;
}

fn looks_like_number_expr(text: string) -> boolean {
    if text.length == 0 { return false; }
    let mut has_decimal: boolean = false;
    let mut index: int = 0;
    if char_at(text, 0) == "-" {
        if text.length == 1 { return false; }
        index = 1;
    }
    loop {
        if index >= text.length { break; }
        let ch = char_at(text, index);
        if ch == "." {
            if has_decimal { return false; }
            has_decimal = true;
            index += 1;
            continue;
        }
        if !is_decimal_digit_expr(ch) { return false; }
        index += 1;
    }
    return true;
}

fn is_decimal_digit_expr(ch: string) -> boolean {
    let mut _ret409: boolean = false;
    if ch == "0" { _ret409 = true; }
    if ch == "1" { _ret409 = true; }
    if ch == "2" { _ret409 = true; }
    if ch == "3" { _ret409 = true; }
    if ch == "4" { _ret409 = true; }
    if ch == "5" { _ret409 = true; }
    if ch == "6" { _ret409 = true; }
    if ch == "7" { _ret409 = true; }
    if ch == "8" { _ret409 = true; }
    if ch == "9" { _ret409 = true; }
    return _ret409;
}

// ============================================================================
// Append Helpers
// ============================================================================
fn append_expression(expressions: Expression[], expression: Expression) -> Expression[] {
    expressions.push(expression);
    return expressions;
}

fn append_object_field(fields: ObjectField[], field: ObjectField) -> ObjectField[] {
    fields.push(field);
    return fields;
}

fn append_parameter(parameters: Parameter[], parameter: Parameter) -> Parameter[] {
    parameters.push(parameter);
    return parameters;
}

fn append_string_local(values: string[], value: string) -> string[] {
    values.push(value);
    return values;
}  // Lambda bodies are parsed through the structured `parse_block` in  // statements.sfn (imported above), so `body.statements` is populated at  // parse time. The earlier token-collecting placeholder is gone; see  // issue #520.
