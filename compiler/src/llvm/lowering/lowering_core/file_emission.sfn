// compiler/src/llvm/lowering/lowering_core/file_emission.sfn
//
// Native-text and native-lines LLVM file entry points.
import {
    ImportedModuleContext,
    NativeArtifact,
    NativeModule,
    ParseNativeResult
} from "sfn/ir";
import { parse_native_artifact, parse_native_artifact_from_lines } from "sfn/ir";
import { lines_to_native_text, native_lines_have_text } from "sfn/ir";

import { LLVMProviderContext, install_llvm_provider_context, trace_log } from "../../lowering_debug_state";
import { LLVMArtifactResult, LoweredLLVMLinesResult } from "../../types";
import { collect_defined_function_symbols } from "../lowering_helpers";
import { fatal_lowering_diagnostic_lines, has_fatal_lowering_diagnostic } from "./diagnostics";
import { lower_to_llvm_lines_with_parsed_context } from "./mod";

fn make_native_module_for_emit(module_name: string, native_text: string) -> NativeModule {
    return NativeModule {
        module_name: module_name,
        artifacts: [NativeArtifact {
            name: module_name, format: "sailfin-native-text", contents: native_text
        }],
        entry_points: [],
        symbol_count: 0
    };
}

// Context-carrying variant for the `-p` per-module build path (#999). The
// driver supplies every staged manifest, native text, and discovery diagnostic
// through `import_context`; lowering remains a pure consumer of that artifact
// data. The `[fatal]` unresolved-callee gate is preserved unchanged — this
// supplies its input explicitly rather than weakening it (#306).
fn generate_llvm_artifact_from_native_text_with_context(native_text: string, module_name: string, import_context: ImportedModuleContext) -> LLVMArtifactResult {
    if native_text.length == 0 {
        return _failed_llvm_artifact("emit-llvm: empty native text for module "
            + module_name);
    }
    return _lower_parsed_native_to_llvm_artifact(parse_native_artifact(native_text), native_text, module_name, import_context);
}

// Lines-array counterpart of `generate_llvm_artifact_from_native_text_with_context`
// for the in-process emit→lower handoff (#1817). Parses the emitter's line
// array directly (no join→split), reconstructing the joined text only for
// the recovery re-parse the lowering still consumes on the happy path
// (`recover_functions_for_lowering` cross-checks the structured parse and
// `make_native_module_for_emit` carries it as the fallback). `recovery_text`
// is byte-identical to the old `native_text`, so output is unchanged; the
// win is skipping the primary `parse_native_artifact` re-split.
fn generate_llvm_artifact_from_native_lines_with_context(native_lines: string[], module_name: string, import_context: ImportedModuleContext) -> LLVMArtifactResult {
    if !native_lines_have_text(native_lines) {
        return _failed_llvm_artifact("emit-llvm: empty native text for module "
            + module_name);
    }
    let recovery_text = lines_to_native_text(native_lines);
    return _lower_parsed_native_to_llvm_artifact(parse_native_artifact_from_lines(native_lines), recovery_text, module_name, import_context);
}

fn _failed_llvm_artifact(failure_message: string) -> LLVMArtifactResult {
    return LLVMArtifactResult {
        ok: false,
        artifact_name: "module.ll",
        artifact_format: "llvm-ir-text",
        lines: [],
        diagnostics: [],
        diags: [],
        failure_message: failure_message
    };
}

fn _failed_llvm_artifact_from_lowering(failure_message: string, lowered: LoweredLLVMLinesResult) -> LLVMArtifactResult {
    let mut result = _failed_llvm_artifact(failure_message);
    result.diagnostics = lowered.diagnostics;
    result.diags = lowered.diags;
    return result;
}

// Shared lowering tail for the text and lines entry points above. The provider
// returns identity, lines, and diagnostics; the compiler driver owns path
// selection, atomic publication, stale-artifact policy, and cache updates.
fn _lower_parsed_native_to_llvm_artifact(parse: ParseNativeResult, native_text: string, module_name: string, import_context: ImportedModuleContext) -> LLVMArtifactResult {
    let dummy_module = make_native_module_for_emit(module_name, native_text);
    let lowered_lines = lower_to_llvm_lines_with_parsed_context(dummy_module, parse, import_context, true, native_text);
    if lowered_lines.lines == null {
        return _failed_llvm_artifact_from_lowering("emit-llvm: lowered lines null", lowered_lines);
    }
    // Refuse to return publishable IR when any lowering pass surfaced a `[fatal]`
    // diagnostic. Issued by `core_call_emission/dispatch.sfn` for calls whose
    // return type cannot be resolved (issue #306) and by
    // `lower_expression`'s `<closure_pair_fatal_mutable ...>` handler
    // for capturing lambdas with mutable captures (issue #687). A
    // partial IR file with the side-effecting call silently dropped
    // would be worse than no output at all. Return every fatal so the
    // driver receives the underlying cause before the build aborts.
    if has_fatal_lowering_diagnostic(lowered_lines.diagnostics) {
        return _failed_llvm_artifact_from_lowering("", lowered_lines);
    }
    let lowered_count = lowered_lines.lines.length;
    if lowered_count > 0 {
        let defined = collect_defined_function_symbols(lowered_lines.lines);
        if defined.length == 0 {
            return _failed_llvm_artifact_from_lowering("", lowered_lines);
        }
    }
    let lines = lowered_lines.lines;
    let mut _if247: boolean = false;
    if lines == null { _if247 = true; }
    if lines.length == 0 { _if247 = true; }
    if _if247 {
        return _failed_llvm_artifact_from_lowering("emit-llvm: lowering produced no output lines", lowered_lines);
    }
    return LLVMArtifactResult {
        ok: true,
        artifact_name: "module.ll",
        artifact_format: "llvm-ir-text",
        lines: lines,
        diagnostics: lowered_lines.diagnostics,
        diags: lowered_lines.diags,
        failure_message: ""
    };
}

// Dry-run the lowering gate over already-emitted native text WITHOUT
// writing any artifact. Used by `sfn emit native` (issue #906) so that
// command fails closed on the same unresolved-callee inputs that
// `sfn build` / `sfn emit llvm` reject via the LLVM artifact result gate.
// `emit native` stops at the native-IR stage (stage 5), before LLVM
// lowering (stage 6) where the `cannot resolve return type for call to
// ...` `[fatal]` is produced — so it never participated in return-type
// resolution and false-greened. This reuses the exact same lowering
// path and `[fatal]` scan as the `build` / `emit llvm` gate, guaranteeing
// byte-for-byte parity, but discards the lowered IR and writes nothing.
// Returns true when the native text lowers clean (no fatal), false on a
// fatal, empty/null input, or a lowering failure.
//
// NOTE: this lives off the self-host build path. The build's per-module
// stage-5 emit (`capsule_resolver.sfn`) calls the native-emit workers
// directly and never invokes this gate, so adding it cannot break
// self-hosting (cross-module signature resolution still happens later at
// the LLVM stage as before).
fn native_text_passes_lowering_gate(native_text: string, module_name: string, import_context: ImportedModuleContext, provider_context: LLVMProviderContext) -> boolean {
    install_llvm_provider_context(provider_context);
    if native_text.length == 0 {
        // No text to gate: the native emitter already failed upstream
        // (typecheck / effect / re-export error) and produced nothing.
        return false;
    }
    let parse = parse_native_artifact(native_text);
    let dummy_module = make_native_module_for_emit(module_name, native_text);
    let lowered_lines = lower_to_llvm_lines_with_parsed_context(dummy_module, parse, import_context, true, native_text);
    if lowered_lines.lines == null {
        trace_log("emit-native: lowered lines null");
        return false;
    }
    // Same fatal contract as `_lower_parsed_native_to_llvm_artifact` above:
    // record every `[fatal]` so the user sees the underlying cause, then
    // refuse the emit.
    if has_fatal_lowering_diagnostic(lowered_lines.diagnostics) {
        let fatal_lines = fatal_lowering_diagnostic_lines(lowered_lines.diagnostics, lowered_lines.diags);
        let mut fatal_index: int = 0;
        loop {
            if fatal_index >= fatal_lines.length { break; }
            trace_log(fatal_lines[fatal_index]);
            fatal_index += 1;
        }
        return false;
    }
    // Mirror the remaining non-fatal rejection conditions in
    // `_lower_parsed_native_to_llvm_artifact` above so `emit native` matches
    // `emit llvm` exactly, not just on `[fatal]`: lowering that produces
    // lines but no defined function symbols, or no output lines at all, is
    // a hard error there and must be one here too.
    let lowered_count = lowered_lines.lines.length;
    if lowered_count > 0 {
        let defined = collect_defined_function_symbols(lowered_lines.lines);
        if defined.length == 0 { return false; }
    }
    if lowered_lines.lines.length == 0 {
        trace_log("emit-native: lowering produced no output lines");
        return false;
    }
    return true;
}
