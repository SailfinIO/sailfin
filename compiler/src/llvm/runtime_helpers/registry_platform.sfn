// compiler/src/llvm/runtime_helpers/registry_platform.sfn
// Platform, console, filesystem, clock, and HTTP descriptor chunks.
import { RuntimeHelperDescriptor } from "../types";
import { append_runtime_helper } from "./registry_support";

fn _rh_descriptors_00(descriptors_in: RuntimeHelperDescriptor[]) -> RuntimeHelperDescriptor[] {
    let mut descriptors = descriptors_in;
    // Raw print: writes to stdout with no prefix, no decoration.
    // Used by the compiler itself for artifact output and CLI messages.
    // M2.8 (#401): flipped to the Sailfin-native sfn_print symbol via
    // native_signature, parameter_types bumped to the SfnString
    // aggregate ABI. The C trampoline in sailfin_runtime.c unpacks the
    // aggregate and forwards to sailfin_runtime_print_raw.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "print", symbol: "sfn_print", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print", c_abi_return_type: null
    });
    // Raw stderr print: writes to stderr with no prefix, no decoration.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "print.err", symbol: "sfn_print_err", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print_err", c_abi_return_type: null
    });

    // Prefixed print variants — print.err/print.warn/print.error write to
    // stderr; print.info writes to stdout with an [info] prefix.
    // Compiler diagnostics should use print.err() so they do not pollute
    // stdout (LLVM IR output, program output, etc.).
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "print.info", symbol: "sfn_print_info", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print_info", c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "print.error", symbol: "sfn_print_error", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print_error", c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "print.warn", symbol: "sfn_print_warn", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print_warn", c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "console.info", symbol: "sfn_print", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print", c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "console.log", symbol: "sfn_print", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print", c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "console.error", symbol: "sfn_print_error", return_type: "void", parameter_types: ["{i8*, i64}"], native_signature: "sfn_print_error", c_abi_return_type: null
    });

    // Filesystem intrinsics
    //
    // M3.1c (#926): `fs.exists` flipped to the `sfn_fs_exists`
    // adapter in `runtime/sfn/adapters/filesystem.sfn` (trampolines
    // to the legacy C intrinsic — see that module for why the
    // single cross-platform `filesystem.ll` keeps the C body). The
    // legacy C intrinsic stays exported through the M3 window so
    // seed-built compiler IR keeps linking; fresh emission routes
    // through `native_signature` per the `effective_symbol`
    // resolution in `rendering.sfn`.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "fs.exists", symbol: "sfn_fs_exists", return_type: "i1", parameter_types: ["i8*"], native_signature: "sfn_fs_exists", c_abi_return_type: null
    });

    // Arena mark / rewind. Phase 5a (`docs/proposals/archive/phase-5a-arena-reset.md`)
    // exposes the existing C bump-allocator's mark/rewind primitive
    // to Sailfin code so in-process multi-module tools (`sfn check`,
    // `sfn test`'s test-discovery loop) can reclaim per-iteration
    // scratch without invalidating cross-iteration state. The mark
    // is encoded as a Sailfin `number` (LLVM `double`) — Sailfin's
    // numeric type is double-precision floating point and the C
    // wrapper packs (page_index, used) into the mantissa.
    //
    // Both helpers are no-ops when the arena is disabled
    // (`SAILFIN_USE_ARENA={0,'',false}` opt-out — the runtime
    // default flipped on May 6 via #324). Calling them on a
    // disabled arena is safe.
    //
    // Today's callers reach the C symbols via `extern fn` declarations
    // (the 0.5.9 seed compiler doesn't carry these descriptors yet).
    // The descriptors below register bare-name sugar for a future
    // seed bump: once the next release seed includes them, callers
    // can drop the extern-fn boilerplate and just write
    // `sailfin_intrinsic_runtime_arena_mark()` (or a friendlier
    // alias added at that time).
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_runtime_arena_mark", symbol: "sfn_arena_sfn_mark", return_type: "i64", parameter_types: [], native_signature: "sfn_arena_sfn_mark", c_abi_return_type: "double"
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_runtime_arena_rewind", symbol: "sfn_arena_sfn_rewind", return_type: "void", parameter_types: ["double"], native_signature: "sfn_arena_sfn_rewind", c_abi_return_type: null
    });

    // Pointer-read intrinsics (#875, epic #763). These lower directly to an
    // LLVM `load` of the given width — there is no C symbol behind them. The
    // call-emission dispatcher (`coerce_and_emit_call` in
    // `core_call_emission/dispatch.sfn`) special-cases these symbols before normal
    // symbol resolution and emits `load i32`/`load i64`/`load double` (with a
    // leading `bitcast` when the operand isn't already the matching pointer
    // type).
    // No semantic registry row is intentional: a raw load is not a capability
    // — the effect lives on the upstream syscall that produced the pointer. The
    // declare loop in `rendering.sfn` skips them so no bogus
    // `declare @sailfin_intrinsic_pointer_read_*` links to nothing.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_pointer_read_i32", symbol: "sailfin_intrinsic_pointer_read_i32", return_type: "i32", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_pointer_read_i64", symbol: "sailfin_intrinsic_pointer_read_i64", return_type: "i64", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_pointer_read_f64", symbol: "sailfin_intrinsic_pointer_read_f64", return_type: "double", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });

    // errno-location sentinel (#877, epic #763). Resolves the
    // thread-local `errno` slot's address. The concrete C symbol is
    // platform-dependent — glibc exposes `int *__errno_location(void)`,
    // Darwin/macOS `int *__error(void)`, and Windows/mingw-w64
    // `int *_errno(void)` — so the call-emission dispatcher
    // (`coerce_and_emit_call` in `core_call_emission/dispatch.sfn`) special-cases
    // this symbol and emits the matching `call i32* @<sym>()` chosen by
    // `errno_locator_symbol` at emit time (the `SAILFIN_TARGET_OS`
    // target override, else the `uname -s` host probe), returning an
    // `i32*` that feeds straight into `sailfin_intrinsic_pointer_read_i32`.
    // This is the first target-conditional symbol selection in lowering
    // and is what lets `runtime/sfn/clock.sfn` read `errno` without
    // hardcoding the glibc-only locator (which broke the macOS link —
    // see #876/#882 — and the Windows cross-compile link — see #877).
    // No semantic registry row: choosing/reading the locator is not a capability.
    // The declare loop in `rendering.sfn` skips the sentinel target; the
    // concrete locator's `declare` is emitted by the lowering branch
    // itself.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_errno_location", symbol: "sailfin_intrinsic_errno_location", return_type: "i32*", parameter_types: [], native_signature: null, c_abi_return_type: null
    });
    // Concrete errno-locator C symbols backing the sentinel above.
    // These exist only so the post-lowering call-target scan
    // (`collect_runtime_helper_targets_from_lines`) emits a matching
    // `declare i32* @__errno_location()` / `@__error()` / `@_errno()`
    // for whichever symbol the sentinel branch actually emits for the
    // resolved target — the scan matches `descriptor.symbol` against
    // emitted `call` lines and the declare loop declares `symbol`, so
    // only the selected locator (the one with a real call site) is ever
    // declared; the other descriptors stay inert. Their `target`s are
    // deliberately dotted (member-style) so `runtime_helper_call_names()`
    // does NOT seed `__errno_location` / `__error` / `_errno` as bare
    // source-level globals — otherwise `__error()` would typecheck on
    // Linux and then fail to link. Callers must go through the
    // target-aware sentinel; these rows are internal-only.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "intrinsic.errno_location.glibc", symbol: "__errno_location", return_type: "i32*", parameter_types: [], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "intrinsic.errno_location.darwin", symbol: "__error", return_type: "i32*", parameter_types: [], native_signature: null, c_abi_return_type: null
    });
    // Windows/mingw-w64 spells the errno-slot accessor `int *_errno(void)`.
    // Selected when the sentinel resolves the *target* OS to Windows via
    // `SAILFIN_TARGET_OS` (cross-compilation from a Linux host — see
    // `make ci-cross-windows` and `errno_locator_symbol` in
    // `lowering_debug_state.sfn`, #877). Dotted target, same rationale as
    // the rows above: internal-only, never a bare source-level global.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "intrinsic.errno_location.mingw", symbol: "_errno", return_type: "i32*", parameter_types: [], native_signature: null, c_abi_return_type: null
    });
    return descriptors;
}

fn _rh_descriptors_01(descriptors_in: RuntimeHelperDescriptor[]) -> RuntimeHelperDescriptor[] {
    let mut descriptors = descriptors_in;

    // clock-monotonic clk_id sentinel (#908, epic #763). Resolves the
    // `CLOCK_MONOTONIC` `clk_id` immediate, which POSIX leaves
    // implementation-defined: glibc/Linux uses `1`, Darwin/macOS uses
    // `6`. Unlike errno (a symbol swap emitting a `call`) and
    // pointer-read (a `load`), this sentinel lowers to a bare `i32`
    // immediate — no symbol, no runtime call. The call-emission
    // dispatcher (`coerce_and_emit_call` in `core_call_emission/dispatch.sfn`)
    // special-cases this symbol and returns an inline `i32 1`/`i32 6`
    // operand chosen by `clock_monotonic_id_value` at emit time (the
    // `SAILFIN_TARGET_OS` target override, else the `uname -s` host
    // probe). This is the seed-gated replacement for the runtime clk_id
    // probe shipped in #905/#819: a later PR can swap
    // `runtime/sfn/clock.sfn`'s try-1-fall-back-to-6 probe for a single
    // emit-time constant once this intrinsic lands in a cut+pinned seed,
    // removing the extra macOS `clock_gettime` syscall. No semantic registry row:
    // selecting a constant is not a capability — the `![clock]` effect
    // lives on the `clock_gettime` call the constant feeds. The declare
    // loop in `rendering.sfn` skips the sentinel target; since the
    // lowering emits no call, there is no concrete symbol to declare.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_clock_monotonic_id", symbol: "sailfin_intrinsic_clock_monotonic_id", return_type: "i32", parameter_types: [], native_signature: null, c_abi_return_type: null
    });

    // `_SC_NPROCESSORS_ONLN` `sysconf` request-number sentinel (#1480,
    // epic #763). POSIX leaves the numeric request implementation-defined:
    // glibc/Linux uses `84`, Darwin/macOS uses `58`. Like the clk_id
    // sentinel above (and unlike errno, which emits a `call`, or
    // pointer-read, which emits a `load`), this lowers to a bare `i32`
    // immediate — no symbol, no runtime call. The call-emission dispatcher
    // (`coerce_and_emit_call` in `core_call_emission/dispatch.sfn`) special-cases
    // this symbol and returns an inline `i32 84`/`i32 58` operand chosen by
    // `sc_nprocessors_onln_value` at emit time (the `SAILFIN_TARGET_OS`
    // target override, else the `uname -s` host probe). This is the
    // seed-gated replacement for the Linux-only `84` that
    // `runtime/sfn/concurrency/scheduler.sfn` hardcodes today — which makes
    // `sysconf(84)` fail closed to `-1` on macOS and the worker pool
    // collapse to the two-worker deadlock floor regardless of real core
    // count (#1474 exposure). A later PR swaps the scheduler's hardcoded
    // `84` for this intrinsic once it lands in a cut+pinned seed (the same
    // intrinsic-then-seed-then-swap sequence the clk_id sentinel above
    // followed for `clock.sfn`); scheduler.sfn is an `sfn-source` the seed
    // compiles during self-host, so the swap cannot precede the seed.
    // No semantic registry row: selecting a constant is not a capability — the request
    // feeds the `sysconf` call whose effects live on that call. The declare
    // loop in `rendering.sfn` skips the sentinel target; since the lowering
    // emits no call, there is no concrete symbol to declare.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_sc_nprocessors_onln", symbol: "sailfin_intrinsic_sc_nprocessors_onln", return_type: "i32", parameter_types: [], native_signature: null, c_abi_return_type: null
    });

    // executable-path sentinel (#967, epic #390). Resolves the running
    // binary's own absolute path. Unlike errno (a pure symbol swap across
    // three same-shape locators), the per-target primitives differ in arity
    // and semantics — Linux `readlink("/proc/self/exe", …)`, Darwin
    // `_NSGetExecutablePath(buf, *size)`, Windows
    // `GetModuleFileNameA(NULL, buf, size)` — so the call-emission
    // dispatcher (`coerce_and_emit_call` in `core_call_emission/dispatch.sfn`)
    // lowers the sentinel to a per-target emission *sequence* (modeled on
    // `pointer_read`, not the errno symbol-swap), choosing the host leg via
    // `exe_path_locator` at emit time. The uniform Sailfin-visible signature
    // is the Linux shape `(i8* buf, i64 size) -> i64` (byte count written,
    // -1 on failure); the Darwin/Windows legs normalize to it in IR. The
    // declare loop in `rendering.sfn` skips the sentinel target; whichever
    // concrete symbol the dispatcher emits a `call` to gets its `declare`
    // from the post-lowering call-target scan via the concrete rows below.
    // The neutral registry assigns `io` — observing the process path is an environment read,
    // gated like the rest of `exec.sfn` (`![io]`), unlike errno which is not
    // a capability.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_exe_path", symbol: "sailfin_intrinsic_exe_path", return_type: "i64", parameter_types: ["i8*", "i64"], native_signature: null, c_abi_return_type: null
    });
    // Concrete exe-path primitives backing the sentinel above. Exactly like
    // the errno concrete rows, these exist only so the post-lowering
    // call-target scan (`collect_runtime_helper_targets_from_lines`) emits a
    // matching `declare` for whichever symbol the sentinel branch actually
    // calls on the resolved target. Their `target`s are deliberately dotted
    // (member-style) so `runtime_helper_call_names()` does NOT seed
    // `readlink` / `_NSGetExecutablePath` / `GetModuleFileNameA` as bare
    // source-level globals — only the host's selected leg is ever declared
    // or called, so the non-host symbols cannot trigger a cross-platform
    // unresolved-symbol link error.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "intrinsic.exe_path.linux", symbol: "readlink", return_type: "i64", parameter_types: ["i8*", "i8*", "i64"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "intrinsic.exe_path.darwin", symbol: "_NSGetExecutablePath", return_type: "i32", parameter_types: ["i8*", "i32*"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "intrinsic.exe_path.mingw", symbol: "GetModuleFileNameA", return_type: "i32", parameter_types: ["i8*", "i8*", "i32"], native_signature: null, c_abi_return_type: null
    });
    // `strlen` backs the Darwin leg's success-path length recovery:
    // `_NSGetExecutablePath` fills a NUL-terminated path but reports no
    // length, so the leg calls `strlen` on the buffer (see the
    // `exe_path_ok_` block in `core_call_emission/dispatch.sfn`). Registered as a
    // concrete row so the post-lowering call-target scan emits
    // `declare i64 @strlen(i8*)` whenever that leg's `call @strlen` is
    // present — without it an isolated `sfn emit llvm` of an exe-path
    // module produces IR that `llvm-as` rejects ("use of undefined
    // value '@strlen'"). The dotted target keeps `strlen` out of
    // `runtime_helper_call_names()`'s source-global seed, and `strlen`
    // has no other emitted call site (string length is carried in the
    // `{i8*, i64}` aggregate), so this is the sole declare — no
    // duplication risk.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "intrinsic.exe_path.darwin.strlen", symbol: "strlen", return_type: "i64", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });

    // Filesystem sentinels (#1308): retire the last platform-divergent C fs
    // symbols by lowering each `fs.*` op to a per-target emission sequence
    // (modeled on `exe_path` above), choosing the host leg via
    // `fs_platform_leg` at emit time. Only the host leg's symbol ever appears
    // in the IR, so the Windows cross-build never references a POSIX-only
    // `symlink`/`mkdtemp` it has no symbol for. The declare loop in
    // `rendering.sfn` skips these sentinel targets.
    //
    // NO per-leg "concrete" rows (unlike `exe_path`): the host-leg symbols the
    // sentinels emit (`symlink`/`mkdtemp`/`stat`/`GetFileAttributesA`) are real
    // libc symbols already declared via `extern fn` in the firing module
    // (`runtime/sfn/platform/libc.sfn`, inlined into `filesystem.sfn`), so the
    // extern is the single source of the `declare`. A concrete row carrying a
    // bare libc name (`symlink`/`mkdtemp`/`stat`) collides with same-named
    // user/capsule functions — e.g. `sfn/fs`'s public `fn mkdtemp`
    // (`@mkdtemp__sfn__fs__mod`): the declare machinery stamps the registry
    // signature onto the imported mangled symbol and llvm-as rejects the
    // redefinition. Reusing the libc extern avoids both the duplication and the
    // collision. `exe_path` needed concrete rows only because `readlink` /
    // `_NSGetExecutablePath` are in no `extern fn` accept-list. The sentinel
    // bodies are called WITHOUT an extern so the registry-by-name match
    // attaches the descriptor:
    //   symlink(target, link) -> bool   ; POSIX `symlink`,  Windows `false` stub
    //   mkdtemp(template)     -> bool    ; POSIX `mkdtemp(3)`, Windows `false` stub
    //   fs_exists(path)       -> bool    ; POSIX `stat`==0,  Windows GetFileAttributesA
    //   get_perms(path)       -> i64     ; POSIX stat+st_mode, Windows `-1` stub
    //   list_dir(path)        -> i8*     ; POSIX opendir/readdir, Windows FindFirstFile
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_fs_symlink", symbol: "sailfin_intrinsic_fs_symlink", return_type: "i1", parameter_types: ["i8*", "i8*"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_fs_mkdtemp", symbol: "sailfin_intrinsic_fs_mkdtemp", return_type: "i1", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_fs_exists", symbol: "sailfin_intrinsic_fs_exists", return_type: "i1", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_fs_get_perms", symbol: "sailfin_intrinsic_fs_get_perms", return_type: "i64", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });
    // `sailfin_intrinsic_fs_is_directory` (SFN-755): the non-destructive
    // directory predicate. Deliberately separate from `get_perms` rather
    // than derived from it — `get_perms` masks `st_mode` to the low 12
    // bits, which is what its `chmod` consumer wants (`_selfhost_promote_binary`
    // carries the source mode onto the staged binary verbatim), but that
    // mask strips `S_IFDIR` on the way out. Both share one `stat` call
    // shape and differ only in which bits they keep.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_fs_is_directory", symbol: "sailfin_intrinsic_fs_is_directory", return_type: "i1", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_fs_list_dir", symbol: "sailfin_intrinsic_fs_list_dir", return_type: "i8*", parameter_types: ["i8*"], native_signature: null, c_abi_return_type: null
    });
    // SFN-46: single-hop `readlink(path, buf, size) -> i64` byte count.
    // POSIX legs emit `call i64 @readlink(...)`; the Windows leg is a bare
    // `i64 -1` stub. No concrete row: the `@readlink` declare is supplied by
    // an `extern fn readlink` (already declared in
    // `runtime/sfn/platform/libc.sfn`; inlined into the runtime consumer per
    // the #306 cross-module-extern workaround) — the same
    // extern-is-the-declare-source contract as `symlink`/`mkdtemp`. This
    // sentinel is inert until that consumer (`fs.read_link`) lands post-seed.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sailfin_intrinsic_fs_read_link", symbol: "sailfin_intrinsic_fs_read_link", return_type: "i64", parameter_types: ["i8*", "i8*", "i64"], native_signature: null, c_abi_return_type: null
    });

    // Network intrinsics.
    // `http.get` / `http.post` member calls flipped (#912) to the
    // Sailfin-native socket client in `runtime/sfn/adapters/http.sfn`:
    // `sfn_http_get` (`i8*`->`i8*`) and `sfn_http_post2` (the 2-arg
    // `(url, body)` POST wrapper matching this row's arity). ABI-verified,
    // link-time resolved against the already-shipped bodies.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "http.get", symbol: "sfn_http_get", return_type: "i8*", parameter_types: ["i8*"], native_signature: "sfn_http_get", c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "http.post", symbol: "sfn_http_post2", return_type: "i8*", parameter_types: ["i8*", "i8*"], native_signature: "sfn_http_post2", c_abi_return_type: null
    });

    // Concurrency intrinsics. Sleep call sites route through the
    // Sailfin-native wrapper `@sfn_sleep` (defined in
    // `runtime/sfn/clock.sfn` and linked via the runtime capsule's
    // `sfn-sources`). PR 2 of the sleep migration (issue #397)
    // rewrote the wrapper body to call `nanosleep` directly via
    // `runtime/sfn/platform/posix.sfn`; the prior C trampoline
    // (`sailfin_runtime_sleep`) and its per-symbol descriptor are
    // both gone.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "sleep", symbol: "sfn_sleep", return_type: "void", parameter_types: ["double"], native_signature: null, c_abi_return_type: null
    });
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "runtime_sleep_fn", symbol: "sfn_sleep", return_type: "void", parameter_types: ["double"], native_signature: null, c_abi_return_type: null
    });
    // Per-symbol fallback signature for libc `nanosleep`, called from
    // `runtime/sfn/clock.sfn::sfn_sleep`. When `posix.sfn-asm` is staged,
    // the imported function entry wins at call resolution (issue #633 —
    // `core_call_resolution/signature.sfn` prefers the function entry over the
    // descriptor and clears `result_helper`), and `declare` is emitted
    // with the `%Timespec*` source-level signature; meanwhile
    // `render_runtime_helper_declarations` skips the descriptor via the
    // `target == symbol` shadow check in `rendering.sfn`. SFN-344 taught
    // `sfn build -p compiler` to self-stage posix into its private
    // `rt-import-context` tree (`_stage_imported_platform_externs`), so
    // the self-host build and the runtime-sfn-source consumer path
    // (`runtime_sfn_sources_link_consumer_test.sfn`) now always resolve
    // the `%Timespec*` form and this descriptor is only ever shadowed on
    // those paths. It is retained as the fallback for the last emit path
    // that still lacks staged posix: `ci-cross-windows`'s standalone
    // `clock.sfn` re-emit (SFN-58), which reads posix from the SHARED
    // tree the Makefile still stages for exactly this reason. Removal
    // condition: delete this descriptor (and its `clock_gettime` sibling,
    // the `rendering.sfn` exemption, and `_drifted_nanosleep` in
    // `prelude_mirror_drift_fatal_test.sfn`) once the cross-windows
    // standalone `clock` emit is retired or gains its own posix staging.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "nanosleep", symbol: "nanosleep", return_type: "i32", parameter_types: ["i8*", "i8*"], native_signature: null, c_abi_return_type: null
    });
    // Per-symbol fallback signature for libc `clock_gettime`, called
    // from `runtime/sfn/clock.sfn::sfn_clock_monotonic_nanos` (#878).
    // Same fallback discipline and removal condition as `nanosleep`
    // directly above: shadowed on the driver-staged self-host and
    // consumer paths (SFN-344), retained for the `ci-cross-windows`
    // (SFN-58) standalone `clock` re-emit that reads posix from the
    // SHARED tree.
    descriptors = append_runtime_helper(descriptors, RuntimeHelperDescriptor {
        target: "clock_gettime", symbol: "clock_gettime", return_type: "i32", parameter_types: ["i32", "i8*"], native_signature: null, c_abi_return_type: null
    });
    return descriptors;
}
