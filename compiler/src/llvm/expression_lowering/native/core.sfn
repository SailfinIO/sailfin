// compiler/src/llvm/expression_lowering/native/core.sfn
//
// Compatibility facade for the stable native expression-lowering surface.
import { NativeSourceSpan } from "sfn/ir";

import {
    LocalBinding,
    OwnershipAnalysis,
    OwnershipInfo,
    ParameterBinding
} from "../../types";
import {
    analyze_value_ownership_impl,
    detect_borrow_conflicts_impl,
    format_suspension_location_impl,
    resolve_borrow_base_impl
} from "./core_ownership";

export { lower_expression } from "./core_expression";

export { lower_closure_pair_marker } from "./core_closure_lowering";

export {
    parse_union_payload_types,
    is_union_llvm_type,
    extract_simple_identifier,
    unescape_string_literal,
    make_string_constant_name,
    make_string_constant_name_for_module
} from "./core_text";

export {
    parse_struct_literal,
    parse_struct_pattern,
    parse_enum_literal,
    parse_member_access,
    parse_index_expression,
    parse_range_iterable
} from "./core_parse";

export {
    emit_boolean_and,
    emit_comparison_instruction,
    is_string_pointer_type,
    load_local_operand
} from "./core_operands/comparisons";

export { coerce_operand_to_type, dominant_type, harmonise_operands } from "./core_operands/dispatch";

export {
    find_local_binding,
    infer_borrow_base_scope,
    append_lifetime_region,
    append_lifetime_release_event,
    apply_lifetime_release_events,
    make_lifetime_region_metadata,
    format_root_scope_id,
    make_child_scope_id,
    is_scope_descendant,
    append_local_binding,
    append_llvm_operand,
    append_struct_literal_field,
    append_native_struct,
    append_native_enum,
    replace_llvm_operand
} from "./core_scopes";

fn analyze_value_ownership(initializer: string?, span: NativeSourceSpan?, locals: LocalBinding[], bindings: ParameterBinding[]) -> OwnershipAnalysis {
    return analyze_value_ownership_impl(initializer, span, locals, bindings);
}

fn detect_borrow_conflicts(ownership: OwnershipInfo?, locals: LocalBinding[], binding_name: string, function_name: string) -> string[] {
    return detect_borrow_conflicts_impl(ownership, locals, binding_name, function_name);
}

fn format_suspension_location(keyword: string, borrow_span: NativeSourceSpan?, suspension_span: NativeSourceSpan?) -> string {
    return format_suspension_location_impl(keyword, borrow_span, suspension_span);
}

fn resolve_borrow_base(target: string, locals: LocalBinding[]) -> string {
    return resolve_borrow_base_impl(target, locals);
}
