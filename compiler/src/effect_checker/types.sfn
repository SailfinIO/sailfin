// compiler/src/effect_checker/types.sfn
//
// Shared diagnostic and requirement data for effect validation.
import { Token } from "../token";

struct EffectRequirement {
    effect: string;
    description: string;
    // Source-token attribution for the operation that introduced
    // this requirement. Populated by `collect_effects_from_expression`
    // when the AST node carries a span (Identifier / Member). Stays
    // null on synthesized decorator-implied effects, where no
    // Expression is available.
    // `analyze_routine` reads the first non-null trigger from the
    // missing-requirements list to caret the diagnostic at the call
    // site rather than the function declaration.
    trigger: Token?;
}

struct EffectViolation {
    routine_name: string;
    missing_effects: string[];
    requirements: EffectRequirement[];
    // Token pointing at the function (or test/method) declaration
    // that's missing one or more effects. Synthesized from
    // `FunctionSignature.name_span` so the renderer can show the
    // diagnostic at the signature site, where the user must add
    // `![effect, ...]`. Parsed `fn`, struct methods, and `test`
    // declarations all propagate their recorded `name_span`; the
    // field is null only when a synthesized routine genuinely has
    // no declaration site (no in-tree path produces that today, but
    // the renderer still has to handle null gracefully).
    signature_token: Token?;
    // Token pointing at the effect-triggering operation inside the
    // body. Today `trigger` is set to `signature_token` because
    // `enum Expression` variants don't carry per-node spans yet.
    // When per-expression spans land, this slot graduates to point
    // at the offending call site (e.g. the `print.info(…)` token).
    // The Diagnostic renderer reads `trigger` into `Diagnostic.primary`,
    // so callers that want signature-level rendering (Phase A
    // default) and callers that want call-site rendering (post-AST-
    // span work) both go through the same field.
    trigger: Token?;
    // "error" | "warning" | "hint". Phase A hardcodes "error" at
    // every factory call site — the value is decoupled from the
    // gate decision so Phase B can wire `SAILFIN_EFFECT_ENFORCE` to
    // toggle without touching the violation construction code.
    severity: string;
    // Track B B3: token at the body's opening `{` so the structured
    // `FixSuggestion` (built in `diagnostics_render`) knows where to
    // splice in `![effects] `. Synthesized from `body.tokens[0]` in
    // `analyze_routine` when available; null for synthesized routines
    // and parser-recovery edges where the body has no tokens. When
    // null, the renderer leaves `Diagnostic.suggestion` null too —
    // the human-readable suggestion line in `Diagnostic.message`
    // covers that path.
    body_open_token: Token?;
}

// Phase F (`docs/proposals/0008-effect-validation.md` §5): a function
// declared an effect outside the surrounding capsule's
// `[capabilities] required = [...]` set. Distinct from
// `EffectViolation` because the failure shape is different:
//
//   - `EffectViolation` = "function X is missing required effects ![…]"
//     (the body uses an effectful operation that the signature doesn't
//     declare).
//   - `CapabilityViolation` = "function X declares effect ![Y] outside
//     capsule capability surface" (the signature *does* declare the
//     effect, but the capsule manifest doesn't grant it).
//
// Renderer (`diagnostics_render.capability_violation_to_diagnostic`)
// emits diagnostic code `E0403` and a fix-it hint suggesting either
// "add Y to capsule.toml [capabilities] required" or "remove ![Y]
// from this function." Severity threading mirrors `EffectViolation`
// — the gate flips it to "warning" / "off" via
// `SAILFIN_EFFECT_ENFORCE` if the operator opts out of the strict
// post-Phase-D default.
struct CapabilityViolation {
    routine_name: string;
    excess_effects: string[];  // effects declared but outside the capability surface
    capabilities_required: string[];  // the capsule's allowed surface (for the diagnostic note)
    signature_token: Token?;
    trigger: Token?;
    severity: string;
}

// SFEP-0017 D1 (gate G6): a routine declared an effect whose refinement
// root is not one of the canonical six (and is not the `pure` sentinel)
// — e.g. `![disk]`, or the stray `fs` left behind if `io.fs` ever
// mis-split into `["io","fs"]`. Distinct from `EffectViolation` (missing
// a used effect) and `CapabilityViolation` (declared effect outside the
// manifest surface): here the effect *string itself* names no known
// capability. Renderer (`diagnostics_render.unrecognized_effect_violation_to_diagnostic`)
// emits `E0404`. This is the live consumer of `is_recognized_effect` that
// keeps the split-to-`fs` regression from reappearing silently.
struct UnrecognizedEffectViolation {
    routine_name: string;
    unrecognized_effects: string[];  // declared effects whose root isn't canonical
    signature_token: Token?;
    trigger: Token?;
    severity: string;
}

// Build a Token from a SourceSpan + lexeme. The renderer in
// `tools/check.sfn` reads `token.line`, `token.column`, and
// `token.lexeme` (for the caret width). We synthesize an Identifier-
// kinded token because the location refers to a function name; the
// kind is cosmetic in this context (the renderer doesn't use it),
// but using Identifier rather than the EOF sentinel keeps the
export {
    CapabilityViolation,
    EffectRequirement,
    EffectViolation,
    UnrecognizedEffectViolation
};
