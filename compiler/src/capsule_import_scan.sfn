// capsule_import_scan.sfn — source-level import-spec scanning.
//
// Extracted from capsule_resolver.sfn (#1512 build-memory work). These are
// the comment-aware character-level scanners that walk a `.sfn` source for
// `import`/`export { ... } from "spec"` statements. They are pure (no
// `![io]`), depend only on `string_utils`, and carry no coupling back to the
// resolver — which is exactly why they were the highest-IR-weight, lowest-
// risk cluster to lift out of capsule_resolver.sfn (the only module still
// over the 2 GB CI per-job gate). capsule_resolver re-imports and re-exports
// the public entry points so its consumers are unchanged.
import { strings_equal, substring } from "./string_utils";

// ASCII byte codes for the scanner state machines below, which compare
// the values `_cr_byte_at` returns.
let _CIS_TAB: int = 9;
let _CIS_LF: int = 10;
let _CIS_CR: int = 13;
let _CIS_SPACE: int = 32;
let _CIS_QUOTE: int = 34;
let _CIS_STAR: int = 42;
let _CIS_COMMA: int = 44;
let _CIS_SLASH: int = 47;
let _CIS_SEMI: int = 59;
let _CIS_BACKSLASH: int = 92;
let _CIS_UNDERSCORE: int = 95;
let _CIS_LOWER_A: int = 97;
let _CIS_LOWER_E: int = 101;
let _CIS_LOWER_F: int = 102;
let _CIS_LOWER_I: int = 105;
let _CIS_LBRACE: int = 123;
let _CIS_RBRACE: int = 125;
let _CIS_BANG: int = 33;
let _CIS_DOT: int = 46;
let _CIS_LBRACKET: int = 91;
let _CIS_RBRACKET: int = 93;
let _CIS_LOWER_Z: int = 122;

// Bound on how far past a `![` the effect scanner will read before giving up.
// An effect list is a handful of short lowercase names; 128 bytes is well past
// the longest real one and stops a stray `![` in prose or a string literal from
// running away over the rest of the file.
let _CIS_EFFECT_WINDOW: int = 128;

// ---- Source-level import scanning ----
// These helpers replace the cli_commands.sfn `_collect_relative_import_spans_cmd`
// state machine so the resolver owns the only import-spec scanner. Skip-aware
// of string literals, line comments, and block comments — must stay in sync
// with the legacy implementation until that is deleted.
// The scanners below touch every byte of every source they walk, so this
// accessor is on the hottest path in the resolver. Returning a `string`
// meant one `substring` allocation per source byte against an arena that
// never rewinds — ~630 MB of permanent arena for a single scan of the
// compiler's own source closure, paid once per relation per resolver
// group. `load_byte` is a true non-allocating `load i8` (the same
// primitive `prelude::find_char` uses for its ASCII fast path), and
// `substring`/`.length` are byte-indexed, so the index arithmetic below
// is unchanged. -1 marks out of range; no byte can collide with it
// (SFN-833) — `load_byte` lowers as `zext i8 ... to i64`, not `sext`
// (`compiler/capsules/codegen-llvm/src/byte_load.sfn`), so the returned range is 0..255;
// a `sext` lowering would make 0x80..0xFF negative and 0xFF would alias -1.
fn _cr_byte_at(text: string, index: int) -> int {
    if text.length == 0 { return -1; }
    if index < 0 { return -1; }
    if index >= text.length { return -1; }
    return load_byte(((text as *u8) as i64) + index) as int;
}

// `[A-Za-z0-9_]` over the byte codes `_cr_byte_at` now returns. The
// previous form scanned a 63-character `allowed` literal with one
// `substring` allocation per comparison.
fn _cr_is_ident_char(ch: int) -> boolean {
    if ch >= 97 && ch <= 122 { return true; }
    if ch >= 65 && ch <= 90 { return true; }
    if ch >= 48 && ch <= 57 { return true; }
    if ch == _CIS_UNDERSCORE { return true; }
    return false;
}

// Callers gate this on the keyword's first byte before calling. That
// guard is implied by the comparison below, so it changes no result —
// it exists because this allocates a `word.length` substring of
// `source` on every call and the scan loops call it once per source
// byte, against an arena that never rewinds (SFN-833).
fn _cr_word_matches(source: string, index: int, word: string) -> boolean {
    if word.length == 0 { return false; }
    if index < 0 { return false; }
    let end_pos = index + word.length;
    if end_pos > source.length { return false; }
    if substring(source, index, end_pos) != word { return false; }
    if index > 0 {
        if _cr_is_ident_char(_cr_byte_at(source, index - 1)) { return false; }
    }
    if end_pos < source.length {
        if _cr_is_ident_char(_cr_byte_at(source, end_pos)) { return false; }
    }
    return true;
}

// Walk the source for `import { ... } from "spec"` statements and return
// every spec string that begins with `./` or `../`. The walker is
// string-, line-comment-, and block-comment-aware so it doesn't trip on
// import-shaped strings inside comments or string literals.
// Walks `import { ... } from "spec"` AND
// `export { ... } from "spec"` — the latter is needed so barrel
// modules' inline re-export targets get staged into the
// import-context (#508). Bare `export { X };` produces an empty
// spec, which the `if spec.length > 0` guard inside silently drops,
// matching pre-#508 behavior.
fn collect_relative_import_specs(source: string) -> string[] {
    let mut out: string[] = [];
    let source_len = source.length;
    if source_len == 0 { return out; }
    let mut steps: int = 0;
    let max_steps = source_len * 6 + 1000;
    let mut i: int = 0;
    let mut in_string: boolean = false;
    let mut escaping: boolean = false;
    let mut in_line_comment: boolean = false;
    let mut in_block_comment: boolean = false;
    loop {
        if i >= source_len { break; }
        steps += 1;
        if steps > max_steps { break; }
        let ch = _cr_byte_at(source, i);
        if in_line_comment {
            if ch == _CIS_LF { in_line_comment = false; }
            i += 1;
            continue;
        }
        if in_block_comment {
            if ch == _CIS_STAR {
                if i + 1 < source_len {
                    if _cr_byte_at(source, i + 1) == _CIS_SLASH {
                        in_block_comment = false;
                        i += 2;
                        continue;
                    }
                }
            }
            i += 1;
            continue;
        }
        if in_string {
            if escaping {
                escaping = false;
                i += 1;
                continue;
            }
            if ch == _CIS_BACKSLASH {
                escaping = true;
                i += 1;
                continue;
            }
            if ch == _CIS_QUOTE {
                in_string = false;
                i += 1;
                continue;
            }
            i += 1;
            continue;
        }
        if ch == _CIS_SLASH {
            if i + 1 < source_len {
                let next = _cr_byte_at(source, i + 1);
                if next == _CIS_SLASH {
                    in_line_comment = true;
                    i += 2;
                    continue;
                }
                if next == _CIS_STAR {
                    in_block_comment = true;
                    i += 2;
                    continue;
                }
            }
        }
        if ch == _CIS_QUOTE {
            in_string = true;
            i += 1;
            continue;
        }
        let mut _is_dep_keyword: boolean = false;
        if ch == _CIS_LOWER_I {
            if _cr_word_matches(source, i, "import") { _is_dep_keyword = true; }
        }
        if ch == _CIS_LOWER_E {
            if _cr_word_matches(source, i, "export") { _is_dep_keyword = true; }
        }
        if _is_dep_keyword {
            let mut j: int = i;
            let mut s_in_string: boolean = false;
            let mut s_escaping: boolean = false;
            let mut s_in_line_comment: boolean = false;
            let mut s_in_block_comment: boolean = false;
            let mut spec: string = "";
            let mut stmt_end: int = -1;
            loop {
                if j >= source_len { break; }
                steps += 1;
                if steps > max_steps { break; }
                let cj = _cr_byte_at(source, j);
                if s_in_line_comment {
                    if cj == _CIS_LF { s_in_line_comment = false; }
                    j += 1;
                    continue;
                }
                if s_in_block_comment {
                    if cj == _CIS_STAR {
                        if j + 1 < source_len {
                            if _cr_byte_at(source, j + 1) == _CIS_SLASH {
                                s_in_block_comment = false;
                                j += 2;
                                continue;
                            }
                        }
                    }
                    j += 1;
                    continue;
                }
                if s_in_string {
                    if s_escaping {
                        s_escaping = false;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_BACKSLASH {
                        s_escaping = true;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_QUOTE {
                        s_in_string = false;
                        j += 1;
                        continue;
                    }
                    j += 1;
                    continue;
                }
                if cj == _CIS_SLASH {
                    if j + 1 < source_len {
                        let nj = _cr_byte_at(source, j + 1);
                        if nj == _CIS_SLASH {
                            s_in_line_comment = true;
                            j += 2;
                            continue;
                        }
                        if nj == _CIS_STAR {
                            s_in_block_comment = true;
                            j += 2;
                            continue;
                        }
                    }
                }
                if cj == _CIS_QUOTE {
                    s_in_string = true;
                    j += 1;
                    continue;
                }
                if spec.length == 0 && cj == _CIS_LOWER_F {
                    if _cr_word_matches(source, j, "from") {
                        let mut k = j + 4;
                        loop {
                            if k >= source_len { break; }
                            let wk = _cr_byte_at(source, k);
                            let mut ws: boolean = false;
                            if wk == _CIS_SPACE { ws = true; }
                            if wk == _CIS_TAB { ws = true; }
                            if wk == _CIS_LF { ws = true; }
                            if wk == _CIS_CR { ws = true; }
                            if !ws { break; }
                            k += 1;
                        }
                        if k < source_len {
                            if _cr_byte_at(source, k) == _CIS_QUOTE {
                                k += 1;
                                let start = k;
                                let mut esc: boolean = false;
                                loop {
                                    if k >= source_len { break; }
                                    let sk = _cr_byte_at(source, k);
                                    if esc {
                                        esc = false;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_BACKSLASH {
                                        esc = true;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_QUOTE {
                                        spec = substring(source, start, k);
                                        break;
                                    }
                                    k += 1;
                                }
                            }
                        }
                    }
                }
                if cj == _CIS_SEMI {
                    stmt_end = j + 1;
                    break;
                }
                j += 1;
            }
            if stmt_end > 0 {
                if spec.length > 0 {
                    let mut is_relative: boolean = false;
                    if spec.length >= 2 {
                        if substring(spec, 0, 2) == "./" { is_relative = true; }
                    }
                    if spec.length >= 3 {
                        if substring(spec, 0, 3) == "../" { is_relative = true; }
                    }
                    if is_relative { out.push(spec); }
                }
                i = stmt_end;
                continue;
            }
        }
        i += 1;
    }
    return out;
}

// Find the first occurrence of `needle` in `haystack`, or -1. Local
// to the resolver so we don't pull in `string_utils.sfn`'s richer
// `index_of` (which would broaden the diamond) for a single use.
fn _cr_find_substring(haystack: string, needle: string) -> int {
    if needle.length == 0 { return 0; }
    if haystack.length < needle.length { return -1; }
    let limit = haystack.length - needle.length;
    let mut i: int = 0;
    loop {
        if i > limit { break; }
        if substring(haystack, i, i + needle.length) == needle { return i; }
        i += 1;
    }
    return -1;
}

// ---- Scoped (capsule) import scanning ----
// Sibling of `collect_relative_import_specs` that returns specs containing
// `/` and not starting with `./`, `../`, or `runtime/`. These are the
// candidate inputs for capsule resolution: either declared in the project
// manifest's `[dependencies]` (handled by `enumerate_capsule_sources`) or
// resolved against workspace members (handled by
// `enumerate_workspace_implicit_sources`).
fn collect_scoped_import_specs(source: string) -> string[] {
    let mut out: string[] = [];
    let source_len = source.length;
    if source_len == 0 { return out; }
    let mut steps: int = 0;
    let max_steps = source_len * 6 + 1000;
    let mut i: int = 0;
    let mut in_string: boolean = false;
    let mut escaping: boolean = false;
    let mut in_line_comment: boolean = false;
    let mut in_block_comment: boolean = false;
    loop {
        if i >= source_len { break; }
        steps += 1;
        if steps > max_steps { break; }
        let ch = _cr_byte_at(source, i);
        if in_line_comment {
            if ch == _CIS_LF { in_line_comment = false; }
            i += 1;
            continue;
        }
        if in_block_comment {
            if ch == _CIS_STAR {
                if i + 1 < source_len {
                    if _cr_byte_at(source, i + 1) == _CIS_SLASH {
                        in_block_comment = false;
                        i += 2;
                        continue;
                    }
                }
            }
            i += 1;
            continue;
        }
        if in_string {
            if escaping {
                escaping = false;
                i += 1;
                continue;
            }
            if ch == _CIS_BACKSLASH {
                escaping = true;
                i += 1;
                continue;
            }
            if ch == _CIS_QUOTE {
                in_string = false;
                i += 1;
                continue;
            }
            i += 1;
            continue;
        }
        if ch == _CIS_SLASH {
            if i + 1 < source_len {
                let next = _cr_byte_at(source, i + 1);
                if next == _CIS_SLASH {
                    in_line_comment = true;
                    i += 2;
                    continue;
                }
                if next == _CIS_STAR {
                    in_block_comment = true;
                    i += 2;
                    continue;
                }
            }
        }
        if ch == _CIS_QUOTE {
            in_string = true;
            i += 1;
            continue;
        }
        let mut _is_dep_keyword: boolean = false;
        if ch == _CIS_LOWER_I {
            if _cr_word_matches(source, i, "import") { _is_dep_keyword = true; }
        }
        if ch == _CIS_LOWER_E {
            if _cr_word_matches(source, i, "export") { _is_dep_keyword = true; }
        }
        if _is_dep_keyword {
            let mut j: int = i;
            let mut s_in_string: boolean = false;
            let mut s_escaping: boolean = false;
            let mut s_in_line_comment: boolean = false;
            let mut s_in_block_comment: boolean = false;
            let mut spec: string = "";
            let mut stmt_end: int = -1;
            loop {
                if j >= source_len { break; }
                steps += 1;
                if steps > max_steps { break; }
                let cj = _cr_byte_at(source, j);
                if s_in_line_comment {
                    if cj == _CIS_LF { s_in_line_comment = false; }
                    j += 1;
                    continue;
                }
                if s_in_block_comment {
                    if cj == _CIS_STAR {
                        if j + 1 < source_len {
                            if _cr_byte_at(source, j + 1) == _CIS_SLASH {
                                s_in_block_comment = false;
                                j += 2;
                                continue;
                            }
                        }
                    }
                    j += 1;
                    continue;
                }
                if s_in_string {
                    if s_escaping {
                        s_escaping = false;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_BACKSLASH {
                        s_escaping = true;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_QUOTE {
                        s_in_string = false;
                        j += 1;
                        continue;
                    }
                    j += 1;
                    continue;
                }
                if cj == _CIS_SLASH {
                    if j + 1 < source_len {
                        let nj = _cr_byte_at(source, j + 1);
                        if nj == _CIS_SLASH {
                            s_in_line_comment = true;
                            j += 2;
                            continue;
                        }
                        if nj == _CIS_STAR {
                            s_in_block_comment = true;
                            j += 2;
                            continue;
                        }
                    }
                }
                if cj == _CIS_QUOTE {
                    s_in_string = true;
                    j += 1;
                    continue;
                }
                if spec.length == 0 && cj == _CIS_LOWER_F {
                    if _cr_word_matches(source, j, "from") {
                        let mut k = j + 4;
                        loop {
                            if k >= source_len { break; }
                            let wk = _cr_byte_at(source, k);
                            let mut ws: boolean = false;
                            if wk == _CIS_SPACE { ws = true; }
                            if wk == _CIS_TAB { ws = true; }
                            if wk == _CIS_LF { ws = true; }
                            if wk == _CIS_CR { ws = true; }
                            if !ws { break; }
                            k += 1;
                        }
                        if k < source_len {
                            if _cr_byte_at(source, k) == _CIS_QUOTE {
                                k += 1;
                                let start = k;
                                let mut esc: boolean = false;
                                loop {
                                    if k >= source_len { break; }
                                    let sk = _cr_byte_at(source, k);
                                    if esc {
                                        esc = false;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_BACKSLASH {
                                        esc = true;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_QUOTE {
                                        spec = substring(source, start, k);
                                        break;
                                    }
                                    k += 1;
                                }
                            }
                        }
                    }
                }
                if cj == _CIS_SEMI {
                    stmt_end = j + 1;
                    break;
                }
                j += 1;
            }
            if stmt_end > 0 {
                if spec.length > 0 {
                    let mut is_relative: boolean = false;
                    if spec.length >= 2 {
                        if substring(spec, 0, 2) == "./" { is_relative = true; }
                    }
                    if spec.length >= 3 {
                        if substring(spec, 0, 3) == "../" { is_relative = true; }
                    }
                    let mut is_runtime: boolean = false;
                    if spec.length >= 8 {
                        if substring(spec, 0, 8) == "runtime/" {
                            is_runtime = true;
                        }
                    }
                    let mut has_slash: boolean = false;
                    let mut si: int = 0;
                    loop {
                        if si >= spec.length { break; }
                        if substring(spec, si, si + 1) == "/" {
                            has_slash = true;
                            break;
                        }
                        si += 1;
                    }
                    if !is_relative {
                        if !is_runtime {
                            if has_slash { out.push(spec); }
                        }
                    }
                }
                i = stmt_end;
                continue;
            }
        }
        i += 1;
    }
    return out;
}

// P1 (#363): scan one source file for `import { ... } from "<spec>";`
// (and the `export { ... } from "..."` re-export shape) and return
// true if any spec equals `target` or starts with `target + "/"`. Used
// by `_cr_resolve_and_dedupe` to decide whether the host-capsule
// enumeration is needed. Cheap: collected specs go through the same
// comment-aware scanner that `collect_scoped_import_specs` shares with
// the existing relative-import / workspace-implicit walks; the only
// difference here is the post-filter (the existing scanner drops bare-
// name specs like `"my-app"` because those don't have a `/`).
//
// `target` should be the manifest's `[capsule].name`. `target/sub`
// matches the same prefix-relationship the import resolver applies
// when it canonicalises a scoped import down to its `scope/name`
// slug, so an `import { ... } from "<host>/util"` also gates the
// host enumeration on (a future submodule layout would land under
// `<host>/util.sfn` or `<host>/util/mod.sfn`, both of which the host
// walker captures).
fn _cr_source_imports_host(source: string, target: string) -> boolean {
    if target.length == 0 { return false; }
    let source_len = source.length;
    if source_len == 0 { return false; }
    let mut steps: int = 0;
    let max_steps = source_len * 6 + 1000;
    let mut i: int = 0;
    let mut in_string: boolean = false;
    let mut escaping: boolean = false;
    let mut in_line_comment: boolean = false;
    let mut in_block_comment: boolean = false;
    loop {
        if i >= source_len { break; }
        steps += 1;
        if steps > max_steps { break; }
        let ch = _cr_byte_at(source, i);
        if in_line_comment {
            if ch == _CIS_LF { in_line_comment = false; }
            i += 1;
            continue;
        }
        if in_block_comment {
            if ch == _CIS_STAR {
                if i + 1 < source_len {
                    if _cr_byte_at(source, i + 1) == _CIS_SLASH {
                        in_block_comment = false;
                        i += 2;
                        continue;
                    }
                }
            }
            i += 1;
            continue;
        }
        if in_string {
            if escaping {
                escaping = false;
                i += 1;
                continue;
            }
            if ch == _CIS_BACKSLASH {
                escaping = true;
                i += 1;
                continue;
            }
            if ch == _CIS_QUOTE {
                in_string = false;
                i += 1;
                continue;
            }
            i += 1;
            continue;
        }
        if ch == _CIS_SLASH {
            if i + 1 < source_len {
                let next = _cr_byte_at(source, i + 1);
                if next == _CIS_SLASH {
                    in_line_comment = true;
                    i += 2;
                    continue;
                }
                if next == _CIS_STAR {
                    in_block_comment = true;
                    i += 2;
                    continue;
                }
            }
        }
        if ch == _CIS_QUOTE {
            in_string = true;
            i += 1;
            continue;
        }
        let mut _is_dep_keyword: boolean = false;
        if ch == _CIS_LOWER_I {
            if _cr_word_matches(source, i, "import") { _is_dep_keyword = true; }
        }
        if ch == _CIS_LOWER_E {
            if _cr_word_matches(source, i, "export") { _is_dep_keyword = true; }
        }
        if _is_dep_keyword {
            // Walk forward to the `from "..."` token and pull the spec.
            // Mirrors `collect_scoped_import_specs`'s tokenising loop —
            // duplicated here to avoid running the broader scanner
            // (allocates a string array) when a single literal-match
            // probe is all we need.
            let mut j: int = i;
            let mut s_in_string: boolean = false;
            let mut s_escaping: boolean = false;
            let mut s_in_line_comment: boolean = false;
            let mut s_in_block_comment: boolean = false;
            let mut spec: string = "";
            let mut stmt_end: int = -1;
            loop {
                if j >= source_len { break; }
                steps += 1;
                if steps > max_steps { break; }
                let cj = _cr_byte_at(source, j);
                if s_in_line_comment {
                    if cj == _CIS_LF { s_in_line_comment = false; }
                    j += 1;
                    continue;
                }
                if s_in_block_comment {
                    if cj == _CIS_STAR {
                        if j + 1 < source_len {
                            if _cr_byte_at(source, j + 1) == _CIS_SLASH {
                                s_in_block_comment = false;
                                j += 2;
                                continue;
                            }
                        }
                    }
                    j += 1;
                    continue;
                }
                if s_in_string {
                    if s_escaping {
                        s_escaping = false;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_BACKSLASH {
                        s_escaping = true;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_QUOTE {
                        s_in_string = false;
                        j += 1;
                        continue;
                    }
                    j += 1;
                    continue;
                }
                if cj == _CIS_SLASH {
                    if j + 1 < source_len {
                        let nj = _cr_byte_at(source, j + 1);
                        if nj == _CIS_SLASH {
                            s_in_line_comment = true;
                            j += 2;
                            continue;
                        }
                        if nj == _CIS_STAR {
                            s_in_block_comment = true;
                            j += 2;
                            continue;
                        }
                    }
                }
                if cj == _CIS_QUOTE {
                    s_in_string = true;
                    j += 1;
                    continue;
                }
                if spec.length == 0 && cj == _CIS_LOWER_F {
                    if _cr_word_matches(source, j, "from") {
                        let mut k = j + 4;
                        loop {
                            if k >= source_len { break; }
                            let wk = _cr_byte_at(source, k);
                            let mut ws: boolean = false;
                            if wk == _CIS_SPACE { ws = true; }
                            if wk == _CIS_TAB { ws = true; }
                            if wk == _CIS_LF { ws = true; }
                            if wk == _CIS_CR { ws = true; }
                            if !ws { break; }
                            k += 1;
                        }
                        if k < source_len {
                            if _cr_byte_at(source, k) == _CIS_QUOTE {
                                k += 1;
                                let start = k;
                                let mut esc: boolean = false;
                                loop {
                                    if k >= source_len { break; }
                                    let sk = _cr_byte_at(source, k);
                                    if esc {
                                        esc = false;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_BACKSLASH {
                                        esc = true;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_QUOTE {
                                        spec = substring(source, start, k);
                                        break;
                                    }
                                    k += 1;
                                }
                            }
                        }
                    }
                }
                if cj == _CIS_SEMI {
                    stmt_end = j + 1;
                    break;
                }
                j += 1;
            }
            if stmt_end > 0 {
                if spec.length > 0 {
                    if strings_equal(spec, target) { return true; }
                    if spec.length > target.length {
                        if substring(spec, 0, target.length) == target {
                            if substring(spec, target.length, target.length + 1) == "/" {
                                return true;
                            }
                        }
                    }
                }
                i = stmt_end;
                continue;
            }
        }
        i += 1;
    }
    return false;
}

// Join a name list with `,` for `collect_import_statements`'s tab-separated
// row encoding (SFN-834). Bounded by `names.length`, unlike the byte-level
// walkers above, so it needs no separate step guard.
fn _cis_join_names(names: string[]) -> string {
    let mut result: string = "";
    let mut idx: int = 0;
    loop {
        if idx >= names.length { break; }
        if idx > 0 { result = result + ","; }
        result = result + names[idx];
        idx += 1;
    }
    return result;
}

// SFN-834 (SFEP-0070 §3.3): sibling of `collect_relative_import_specs` /
// `collect_scoped_import_specs` that also captures the brace-list names, so
// capsule-source reachability can narrow a barrel's `export { x } from
// "./sibling"` re-export to only the demanded names. Reuses the same
// comment-/string-aware walk verbatim; the only addition is tracking a
// brace-list name accumulator while inside `{ ... }`. Each result row is
// `<kind>\t<spec>\t<names>`, where `names` is `*` for a bare side-effect
// import or whenever the brace list couldn't be parsed with confidence
// (step guard, unterminated brace).
fn collect_import_statements(source: string) -> string[] {
    let mut out: string[] = [];
    let source_len = source.length;
    if source_len == 0 { return out; }
    let mut steps: int = 0;
    let max_steps = source_len * 6 + 1000;
    let mut i: int = 0;
    let mut in_string: boolean = false;
    let mut escaping: boolean = false;
    let mut in_line_comment: boolean = false;
    let mut in_block_comment: boolean = false;
    loop {
        if i >= source_len { break; }
        steps += 1;
        if steps > max_steps { break; }
        let ch = _cr_byte_at(source, i);
        if in_line_comment {
            if ch == _CIS_LF { in_line_comment = false; }
            i += 1;
            continue;
        }
        if in_block_comment {
            if ch == _CIS_STAR {
                if i + 1 < source_len {
                    if _cr_byte_at(source, i + 1) == _CIS_SLASH {
                        in_block_comment = false;
                        i += 2;
                        continue;
                    }
                }
            }
            i += 1;
            continue;
        }
        if in_string {
            if escaping {
                escaping = false;
                i += 1;
                continue;
            }
            if ch == _CIS_BACKSLASH {
                escaping = true;
                i += 1;
                continue;
            }
            if ch == _CIS_QUOTE {
                in_string = false;
                i += 1;
                continue;
            }
            i += 1;
            continue;
        }
        if ch == _CIS_SLASH {
            if i + 1 < source_len {
                let next = _cr_byte_at(source, i + 1);
                if next == _CIS_SLASH {
                    in_line_comment = true;
                    i += 2;
                    continue;
                }
                if next == _CIS_STAR {
                    in_block_comment = true;
                    i += 2;
                    continue;
                }
            }
        }
        if ch == _CIS_QUOTE {
            in_string = true;
            i += 1;
            continue;
        }
        let mut _is_dep_keyword: boolean = false;
        let mut kind: string = "";
        if ch == _CIS_LOWER_I {
            if _cr_word_matches(source, i, "import") {
                _is_dep_keyword = true;
                kind = "import";
            }
        }
        if ch == _CIS_LOWER_E {
            if _cr_word_matches(source, i, "export") {
                _is_dep_keyword = true;
                kind = "export";
            }
        }
        if _is_dep_keyword {
            let mut j: int = i + 6;
            let mut s_in_string: boolean = false;
            let mut s_escaping: boolean = false;
            let mut s_in_line_comment: boolean = false;
            let mut s_in_block_comment: boolean = false;
            let mut spec: string = "";
            let mut stmt_end: int = -1;
            let mut got_brace: boolean = false;
            let mut in_brace: boolean = false;
            let mut brace_closed: boolean = false;
            let mut names: string[] = [];
            let mut cur_name: string = "";
            let mut alias_pending: boolean = false;
            loop {
                if j >= source_len { break; }
                steps += 1;
                if steps > max_steps { break; }
                let cj = _cr_byte_at(source, j);
                if s_in_line_comment {
                    if cj == _CIS_LF { s_in_line_comment = false; }
                    j += 1;
                    continue;
                }
                if s_in_block_comment {
                    if cj == _CIS_STAR {
                        if j + 1 < source_len {
                            if _cr_byte_at(source, j + 1) == _CIS_SLASH {
                                s_in_block_comment = false;
                                j += 2;
                                continue;
                            }
                        }
                    }
                    j += 1;
                    continue;
                }
                if s_in_string {
                    if s_escaping {
                        s_escaping = false;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_BACKSLASH {
                        s_escaping = true;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_QUOTE {
                        s_in_string = false;
                        j += 1;
                        continue;
                    }
                    j += 1;
                    continue;
                }
                if cj == _CIS_SLASH {
                    if j + 1 < source_len {
                        let nj = _cr_byte_at(source, j + 1);
                        if nj == _CIS_SLASH {
                            s_in_line_comment = true;
                            j += 2;
                            continue;
                        }
                        if nj == _CIS_STAR {
                            s_in_block_comment = true;
                            j += 2;
                            continue;
                        }
                    }
                }
                if in_brace {
                    if cj == _CIS_RBRACE {
                        if cur_name.length > 0 {
                            if !alias_pending { names.push(cur_name); }
                        }
                        cur_name = "";
                        alias_pending = false;
                        in_brace = false;
                        brace_closed = true;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_COMMA {
                        if cur_name.length > 0 {
                            if !alias_pending { names.push(cur_name); }
                        }
                        cur_name = "";
                        alias_pending = false;
                        j += 1;
                        continue;
                    }
                    if cj == _CIS_LOWER_A {
                        if !alias_pending && cur_name.length > 0 {
                            if _cr_word_matches(source, j, "as") {
                                names.push(cur_name);
                                cur_name = "";
                                alias_pending = true;
                                j += 2;
                                continue;
                            }
                        }
                    }
                    if _cr_is_ident_char(cj) {
                        if !alias_pending {
                            cur_name = cur_name + substring(source, j, j + 1);
                        }
                        j += 1;
                        continue;
                    }
                    j += 1;
                    continue;
                }
                if !got_brace && spec.length == 0 && cj == _CIS_QUOTE {
                    let mut k = j + 1;
                    let start = k;
                    let mut esc: boolean = false;
                    loop {
                        if k >= source_len { break; }
                        steps += 1;
                        if steps > max_steps { break; }
                        let sk = _cr_byte_at(source, k);
                        if esc {
                            esc = false;
                            k += 1;
                            continue;
                        }
                        if sk == _CIS_BACKSLASH {
                            esc = true;
                            k += 1;
                            continue;
                        }
                        if sk == _CIS_QUOTE {
                            spec = substring(source, start, k);
                            k += 1;
                            break;
                        }
                        k += 1;
                    }
                    j = k;
                    continue;
                }
                if cj == _CIS_QUOTE {
                    s_in_string = true;
                    j += 1;
                    continue;
                }
                if !got_brace && !brace_closed && cj == _CIS_LBRACE {
                    got_brace = true;
                    in_brace = true;
                    j += 1;
                    continue;
                }
                if spec.length == 0 && cj == _CIS_LOWER_F {
                    if _cr_word_matches(source, j, "from") {
                        let mut k = j + 4;
                        loop {
                            if k >= source_len { break; }
                            let wk = _cr_byte_at(source, k);
                            let mut ws: boolean = false;
                            if wk == _CIS_SPACE { ws = true; }
                            if wk == _CIS_TAB { ws = true; }
                            if wk == _CIS_LF { ws = true; }
                            if wk == _CIS_CR { ws = true; }
                            if !ws { break; }
                            k += 1;
                        }
                        if k < source_len {
                            if _cr_byte_at(source, k) == _CIS_QUOTE {
                                k += 1;
                                let start = k;
                                let mut esc: boolean = false;
                                loop {
                                    if k >= source_len { break; }
                                    let sk = _cr_byte_at(source, k);
                                    if esc {
                                        esc = false;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_BACKSLASH {
                                        esc = true;
                                        k += 1;
                                        continue;
                                    }
                                    if sk == _CIS_QUOTE {
                                        spec = substring(source, start, k);
                                        break;
                                    }
                                    k += 1;
                                }
                            }
                        }
                    }
                }
                if cj == _CIS_SEMI {
                    stmt_end = j + 1;
                    break;
                }
                j += 1;
            }
            if stmt_end > 0 {
                if spec.length > 0 {
                    let mut names_field: string = "*";
                    if got_brace {
                        if brace_closed {
                            names_field = _cis_join_names(names);
                        }
                    }
                    out.push(kind + "\t" + spec + "\t" + names_field);
                }
                i = stmt_end;
                continue;
            }
        }
        i += 1;
    }
    return out;
}

// ---- Effect-annotation scanning ----
// SFN-882: collect every effect token appearing in an `![ ... ]` annotation.
// The demand set that drives runtime `sfn-source` gate selection is the union
// of these tokens across the unfiltered source set, each normalized through
// `effect_root()` — `![net.http]` demands `net`.
//
// Deliberately a RAW scan, unlike every other scanner in this file: it does not
// skip string literals or comments. The asymmetry is intentional and is the
// whole safety argument. An e2e test that embeds a fixture program as a string
// literal, or a comment reading "(http.download, ![io, net])", over-retains —
// which costs compile time and nothing else. A comment-state bug that *missed*
// a real annotation would drop a runtime module that a call site still
// references, and the build would fail at link with an undefined symbol. Only
// one of those two directions is recoverable, so the scan is biased toward it.
//
// Tokens are the lowercase-and-dot runs between separators inside the window;
// anything else (whitespace, commas, brackets) terminates the current token.
// Uppercase and digits terminate too — no canonical effect or sub-effect
// contains either, so a `![` that opened on non-effect text yields nothing
// rather than a junk token that could match a gate key.
fn _cis_is_effect_char(ch: int) -> boolean {
    if ch == _CIS_DOT { return true; }
    if ch < _CIS_LOWER_A { return false; }
    return ch <= _CIS_LOWER_Z;
}

fn collect_effect_tokens(source: string) -> string[] {
    let mut out: string[] = [];
    let source_len = source.length;
    if source_len == 0 { return out; }
    let mut steps: int = 0;
    let max_steps = source_len * 4 + 1000;
    let mut i: int = 0;
    loop {
        if i >= source_len { break; }
        steps += 1;
        if steps > max_steps { break; }
        if _cr_byte_at(source, i) != _CIS_BANG {
            i += 1;
            continue;
        }
        if i + 1 >= source_len { break; }
        // Skip whitespace between `!` and `[`. The grammar allows it —
        // `parse_effect_list` matches `!`, then `parser_advance_raw`, then
        // `skip_trivia`, then `consume_symbol("[")` — so `fn main() ! [net]`
        // parses and effect-checks exactly like `![net]`. `sfn fmt`
        // canonicalises to the tight form, so no in-tree source takes this
        // path, but unformatted user source can, and requiring adjacency here
        // would drop the effect from the demand set and break the link.
        let mut bracket = i + 1;
        let mut ws_guard: int = 0;
        loop {
            if bracket >= source_len { break; }
            if ws_guard > _CIS_EFFECT_WINDOW { break; }
            let wc = _cr_byte_at(source, bracket);
            if wc != _CIS_SPACE && wc != _CIS_TAB && wc != _CIS_LF && wc != _CIS_CR {
                break;
            }
            bracket += 1;
            ws_guard += 1;
        }
        if bracket >= source_len { break; }
        if _cr_byte_at(source, bracket) != _CIS_LBRACKET {
            i += 1;
            continue;
        }
        let mut window_end = bracket + 1 + _CIS_EFFECT_WINDOW;
        if window_end > source_len { window_end = source_len; }
        let mut j = bracket + 1;
        let mut tok_start: int = -1;
        loop {
            if j >= window_end { break; }
            let ch = _cr_byte_at(source, j);
            if ch == _CIS_RBRACKET { break; }
            if _cis_is_effect_char(ch) {
                if tok_start < 0 { tok_start = j; }
                j += 1;
                continue;
            }
            if tok_start >= 0 {
                out.push(substring(source, tok_start, j));
                tok_start = -1;
            }
            j += 1;
        }
        if tok_start >= 0 {
            out.push(substring(source, tok_start, j));
        }
        // Resume after the `![` rather than after the window: a nested or
        // malformed annotation inside the window should still get its own
        // pass, and re-scanning at most 128 bytes is not worth the branch.
        i = i + 2;
    }
    return out;
}

export {
    _cr_find_substring,
    _cr_source_imports_host,
    collect_effect_tokens,
    collect_import_statements,
    collect_relative_import_specs,
    collect_scoped_import_specs
};
