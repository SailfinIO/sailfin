// compiler/src/interpolation_deprecation_check.sfn
//
// W0212 soft-deprecation (SFEP-0057 Phase 2): a `StringLiteral` whose
// (quote-stripped, escape-decoded) value still uses the deprecated
// `{{ expr }}` string-interpolation form instead of `${ expr }`. Pure AST
// analysis, consumed by the `sfn check` fast path (`tools/check.sfn`) —
// mirrors the leaf-module shape of `bare_assert_check.sfn` so the
// emit-free check graph never reaches the emitter.
//
// Detection runs post-parse over `Expression.StringLiteral.value`, which
// the parser already quote-strips and escape-decodes
// (`parser/token_utils.sfn::string_literal_value`), so an escaped `\${`
// has already collapsed to a real `${` opener by the time this walk sees
// it — exactly the signal that distinguishes an intentional dollar-mode
// string from one still on the deprecated brace form.
//
// See SFEP-0057 and issue SFN-482.
import {
    Block,
    Expression,
    Program,
    Statement
} from "./ast";
import { substring } from "./string_utils";

export {
    InterpolationDeprecationFinding,
    collect_interpolation_deprecation_findings
};

// One flagged `StringLiteral` still using `{{ }}` interpolation. No source
// span is available on `StringLiteral` (mirrors W0211, which also renders
// with `primary: null`), so the literal's own text is carried for the
// diagnostic message.
struct InterpolationDeprecationFinding {
    literal: string;
}

fn _append_finding(values: InterpolationDeprecationFinding[], value: InterpolationDeprecationFinding) -> InterpolationDeprecationFinding[] {
    let mut out = values;
    if out == null { out = []; }
    out.push(value);
    return out;
}

// First index of `target` in `value` at or after `start`, or -1.
fn _find_from(value: string, target: string, start: int) -> int {
    let mut index: int = start;
    if index < 0 { index = 0; }
    let target_len = target.length;
    if target_len == 0 { return index; }
    let search_limit = value.length - target_len;
    loop {
        if index > search_limit { break; }
        if substring(value, index, index + target_len) == target {
            return index;
        }
        index += 1;
    }
    return -1;
}

// True when `value` contains a real, unescaped `${` opener. Scans
// left-to-right, skipping an escaped pair (`\` + next char) as a unit so
// an escaped `\${` never counts as a live dollar-mode opener.
fn _has_dollar_brace(value: string) -> boolean {
    let len = value.length;
    let mut index: int = 0;
    loop {
        if index >= len { break; }
        let ch = substring(value, index, index + 1);
        if ch == "\\" {
            index += 2;
            continue;
        }
        if ch == "$" {
            let next = substring(value, index + 1, index + 2);
            if next == "{" { return true; }
        }
        index += 1;
    }
    return false;
}

// True when `value` is still on the deprecated `{{ expr }}` form: a real
// dollar-mode opener disqualifies it outright; otherwise it must contain
// `{{` followed later by a matching `}}`.
fn _uses_deprecated_interpolation(value: string) -> boolean {
    if _has_dollar_brace(value) { return false; }
    let open_index = _find_from(value, "{{", 0);
    if open_index < 0 { return false; }
    let close_index = _find_from(value, "}}", open_index + 2);
    return close_index >= 0;
}

fn _scan_block(block: Block?, findings: InterpolationDeprecationFinding[]) -> InterpolationDeprecationFinding[] {
    let mut out = findings;
    if block == null { return out; }
    let mut index: int = 0;
    loop {
        if index >= block.statements.length { break; }
        out = _scan_statement(block.statements[index], out);
        index += 1;
    }
    return out;
}

fn _scan_expression(expression: Expression?, findings: InterpolationDeprecationFinding[]) -> InterpolationDeprecationFinding[] {
    let mut out = findings;
    if expression == null { return out; }
    let variant = expression.variant;
    if variant == "StringLiteral" {
        if _uses_deprecated_interpolation(expression.value) {
            out = _append_finding(out, InterpolationDeprecationFinding {
                literal: expression.value
            });
        }
        return out;
    }
    if variant == "Unary" {
        return _scan_expression(expression.operand, out);
    }
    if variant == "Binary" {
        out = _scan_expression(expression.left, out);
        out = _scan_expression(expression.right, out);
        return out;
    }
    if variant == "Member" {
        return _scan_expression(expression.object, out);
    }
    if variant == "Call" {
        out = _scan_expression(expression.callee, out);
        let mut ai: int = 0;
        loop {
            if ai >= expression.arguments.length { break; }
            out = _scan_expression(expression.arguments[ai], out);
            ai += 1;
        }
        return out;
    }
    if variant == "Index" {
        out = _scan_expression(expression.sequence, out);
        out = _scan_expression(expression.index, out);
        return out;
    }
    if variant == "Array" {
        let mut ei: int = 0;
        loop {
            if ei >= expression.elements.length { break; }
            out = _scan_expression(expression.elements[ei], out);
            ei += 1;
        }
        return out;
    }
    if variant == "Object" {
        let mut fi: int = 0;
        loop {
            if fi >= expression.fields.length { break; }
            out = _scan_expression(expression.fields[fi].value, out);
            fi += 1;
        }
        return out;
    }
    if variant == "Struct" {
        let mut fi: int = 0;
        loop {
            if fi >= expression.fields.length { break; }
            out = _scan_expression(expression.fields[fi].value, out);
            fi += 1;
        }
        return out;
    }
    if variant == "Lambda" { return _scan_block(expression.body, out); }
    if variant == "Range" {
        out = _scan_expression(expression.start, out);
        out = _scan_expression(expression.end, out);
        return out;
    }
    if variant == "Cast" {
        return _scan_expression(expression.operand, out);
    }
    if variant == "Is" {
        return _scan_expression(expression.operand, out);
    }
    if variant == "TryOperator" {
        return _scan_expression(expression.operand, out);
    }
    if variant == "Conditional" {
        out = _scan_expression(expression.condition, out);
        out = _scan_expression(expression.then_value, out);
        out = _scan_expression(expression.else_value, out);
        return out;
    }
    if variant == "Assignment" {
        out = _scan_expression(expression.target, out);
        out = _scan_expression(expression.rhs, out);
        return out;
    }
    // Concurrency expression nodes (ast.sfn): descend into their expression
    // children so a `{{ }}` literal inside e.g. a `spawn`/`parallel` operand
    // (including a spawned lambda body, reached via `operand`) is still
    // flagged — matching what lowering actually interpolates.
    if variant == "Spawn" {
        return _scan_expression(expression.operand, out);
    }
    if variant == "Await" {
        return _scan_expression(expression.operand, out);
    }
    if variant == "Channel" {
        return _scan_expression(expression.capacity, out);
    }
    if variant == "Parallel" {
        let mut ti: int = 0;
        loop {
            if ti >= expression.tasks.length { break; }
            out = _scan_expression(expression.tasks[ti], out);
            ti += 1;
        }
        return out;
    }
    if variant == "Serve" {
        out = _scan_expression(expression.handler, out);
        out = _scan_expression(expression.port, out);
        return out;
    }
    return out;
}

fn _scan_statement(statement: Statement, findings: InterpolationDeprecationFinding[]) -> InterpolationDeprecationFinding[] {
    let mut out = findings;
    let variant = statement.variant;
    if variant == "ExpressionStatement" {
        return _scan_expression(statement.expression, out);
    }
    if variant == "ReturnStatement" {
        return _scan_expression(statement.expression, out);
    }
    if variant == "ThrowStatement" {
        return _scan_expression(statement.expression, out);
    }
    if variant == "VariableDeclaration" {
        return _scan_expression(statement.initializer, out);
    }
    if variant == "IfStatement" {
        out = _scan_expression(statement.condition, out);
        out = _scan_block(statement.then_block, out);
        let else_branch = statement.else_branch;
        if else_branch != null {
            out = _scan_block(else_branch.body, out);
            if else_branch.statement != null {
                out = _scan_statement(else_branch.statement, out);
            }
        }
        return out;
    }
    if variant == "ForStatement" {
        out = _scan_expression(statement.clause.target, out);
        out = _scan_expression(statement.clause.iterable, out);
        out = _scan_block(statement.body, out);
        return out;
    }
    if variant == "LoopStatement" {
        return _scan_block(statement.body, out);
    }
    if variant == "BlockStatement" {
        return _scan_block(statement.body, out);
    }
    if variant == "WithStatement" {
        let mut ci: int = 0;
        loop {
            if ci >= statement.clauses.length { break; }
            out = _scan_expression(statement.clauses[ci].expression, out);
            ci += 1;
        }
        out = _scan_block(statement.body, out);
        return out;
    }
    if variant == "RoutineStatement" {
        return _scan_block(statement.body, out);
    }
    if variant == "TryStatement" {
        out = _scan_block(statement.try_block, out);
        out = _scan_block(statement.catch_block, out);
        out = _scan_block(statement.finally_block, out);
        return out;
    }
    if variant == "MatchStatement" {
        out = _scan_expression(statement.expression, out);
        let mut ci: int = 0;
        loop {
            if ci >= statement.cases.length { break; }
            let case_ = statement.cases[ci];
            out = _scan_expression(case_.pattern, out);
            out = _scan_expression(case_.guard, out);
            out = _scan_block(case_.body, out);
            ci += 1;
        }
        return out;
    }
    if variant == "FunctionDeclaration" {
        return _scan_block(statement.body, out);
    }
    if variant == "TestDeclaration" {
        return _scan_block(statement.body, out);
    }
    if variant == "StructDeclaration" {
        let mut mi: int = 0;
        loop {
            if mi >= statement.methods.length { break; }
            out = _scan_block(statement.methods[mi].body, out);
            mi += 1;
        }
        return out;
    }
    return out;
}

// Walk the whole program (every top-level statement, and recursively every
// nested block/expression) and return one finding per `StringLiteral`
// still using the deprecated `{{ }}` interpolation form.
fn collect_interpolation_deprecation_findings(program: Program) -> InterpolationDeprecationFinding[] {
    let mut findings: InterpolationDeprecationFinding[] = [];
    let mut index: int = 0;
    loop {
        if index >= program.statements.length { break; }
        findings = _scan_statement(program.statements[index], findings);
        index += 1;
    }
    return findings;
}
