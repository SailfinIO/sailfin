// capsule_emit_parallel.sfn — parallel `sfn emit` orchestration + job sizing.
//
// Extracted from capsule_resolver.sfn (#1512 build-memory work). Holds the
// parallel-emit fan-out (`_cr_run_parallel_emit`) and the job-count / RAM-
// budget resolution it depends on. Lifting this ~390-line shell-script-
// building block out of capsule_resolver.sfn was the second cut (after
// capsule_import_scan.sfn) to bring that module under the 2 GB CI per-job
// gate. capsule_resolver re-imports the public entry points.
import { _atomic_rename_into_place, _mktemp_sibling_cmd } from "./build/fs";
import { build_host_os } from "./build/target";
import { validate_llvm_ir } from "./emit_helpers";
import { number_to_string } from "./main";
import { substring } from "./string_utils";

// Resolve the per-build job count for parallel subprocess emits.
// Reads `SAILFIN_BUILD_JOBS` first; falls back to `nproc` (clamped
// to [1, 8] for system-memory safety — each worker subprocess
// holds its own arena + parser state, so 8 workers × ~500 MB ≈
// 4 GB peak total memory across the parent + worker processes,
// keeping us under the compiler's self-applied 8 GiB memory budget
// even when the parent's own resolver state is at peak; each worker
// inherits that RLIMIT_AS). Returns 1 on any read failure or
// when nproc isn't on PATH, which keeps the legacy serial
// behavior as the safe default.
//
// Stage E PR3: `_cr_run_parallel_emit` honours this. The architect's
// plan is to default to `nproc`, with `SAILFIN_BUILD_JOBS=1`
// available as a regression-bisect escape hatch (mirrors the
// `BUILD_JOBS=1` knob the prior `scripts/build.sh` historically
// exposed; the script was retired in Stage E PR7 / #383).
fn _cr_resolve_jobs() -> int ![io] {
    // SAILFIN_BUILD_JOBS is read FIRST on every host, before any host
    // branch, so `=1` forces serial even on Windows (SFN-498) — the
    // regression-bisect escape hatch works everywhere, not just POSIX.
    let env_jobs = env.get("SAILFIN_BUILD_JOBS");
    if env_jobs.length > 0 {
        let parsed = _cr_parse_positive_int(env_jobs);
        if parsed > 0 {
            if parsed > 8 { return 8; }
            return parsed;
        }
    }
    let host = build_host_os();
    return _cr_jobs_from_probe(_cr_host_cpu_count(host), _cr_host_memsize_bytes(host));
}

// Clamp a raw CPU-count probe to [1, 8] — the 8-job ceiling bounds
// worker memory (see `_cr_resolve_jobs`) — then defer to the RAM budget.
fn _cr_jobs_from_probe(raw_nproc: int, memsize_bytes: int) -> int {
    let mut nproc = raw_nproc;
    if nproc <= 0 { nproc = 1; }
    if nproc > 8 { nproc = 8; }
    return _cr_ram_budget_jobs(memsize_bytes, nproc);
}

// Per-host CPU-count probe ladder. Windows has no `nproc`/`sysctl`, so
// it reads `NUMBER_OF_PROCESSORS` directly; Darwin has no
// `/proc`, so it shells `sysctl -n hw.ncpu`; Linux prefers the
// `/sys/devices/system/cpu/online` range (accounts for offline/hotplugged
// CPUs, which a bare `/proc/cpuinfo` count does not) and falls back to
// counting `processor` lines in `/proc/cpuinfo` when the sysfs path is
// unavailable (e.g. some containers).
fn _cr_host_cpu_count(host: string) -> int ![io] {
    if host == "Windows" {
        return _cr_parse_positive_int(env.get("NUMBER_OF_PROCESSORS"));
    }
    if host == "Darwin" {
        return _cr_capture_int(["/usr/sbin/sysctl", "-n", "hw.ncpu"]);
    }
    let online = "/sys/devices/system/cpu/online";
    if fs.exists(online) {
        let n = _cr_parse_cpu_online(fs.readFile(online));
        if n > 0 { return n; }
    }
    let cpuinfo = "/proc/cpuinfo";
    if fs.exists(cpuinfo) {
        return _cr_count_cpuinfo_processors(fs.readFile(cpuinfo));
    }
    return 0;
}

// Per-host RAM-size probe ladder feeding `_cr_ram_budget_jobs`. Windows
// returns 0 — a deliberate fail-open, since `_cr_ram_budget_jobs(0, n)`
// returns `n` unchanged (Windows is serial-only regardless via
// `_mktemp_sibling_cmd`'s Windows degrade, so the RAM clamp is moot
// there). Darwin shells `sysctl -n hw.memsize`; Linux reads
// `/proc/meminfo`.
fn _cr_host_memsize_bytes(host: string) -> int ![io] {
    if host == "Windows" { return 0; }
    if host == "Darwin" {
        return _cr_capture_int(["/usr/sbin/sysctl", "-n", "hw.memsize"]);
    }
    let meminfo = "/proc/meminfo";
    if !fs.exists(meminfo) { return 0; }
    return _cr_parse_meminfo_bytes(fs.readFile(meminfo));
}

// Run `argv` with an empty environment and parse its captured stdout as
// a non-negative integer; 0 on any spawn/parse failure. Used by the
// Darwin `sysctl` probes.
fn _cr_capture_int(argv: string[]) -> int ![io] {
    let empty_env: string[] = [];
    let rc = process.run_capture(argv, empty_env);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if rc != 0 { return 0; }
    return _cr_parse_positive_int(out);
}

// Parse `/sys/devices/system/cpu/online`'s range-list syntax
// (e.g. "0-3,6,8-9") into a CPU count.
fn _cr_parse_cpu_online(text: string) -> int {
    let mut total: int = 0;
    let mut lo: int = -1;
    let mut tok: string = "";
    let mut i: int = 0;
    let limit = text.length + 1;
    loop {
        if i >= limit { break; }
        let mut ch: string = "";
        if i < text.length { ch = substring(text, i, i + 1); }
        if ch == "-" {
            lo = _cr_parse_positive_int(tok);
            tok = "";
        } else if ch == "," || ch == "\n" || ch == "\r" || ch == "" {
            if tok.length > 0 {
                let hi = _cr_parse_positive_int(tok);
                if lo >= 0 { total = total + hi - lo + 1; } else {
                    total = total + 1;
                }
            }
            tok = "";
            lo = -1;
        } else { tok = tok + ch; }
        i += 1;
    }
    if total < 0 { return 0; }
    return total;
}

// Count `processor` lines in `/proc/cpuinfo` — the fallback when
// `/sys/devices/system/cpu/online` is unavailable.
fn _cr_count_cpuinfo_processors(text: string) -> int {
    let key: string = "processor";
    let mut count: int = 0;
    let mut at_line_start: boolean = true;
    let mut i: int = 0;
    loop {
        if i >= text.length { break; }
        if at_line_start {
            if i + key.length <= text.length {
                if substring(text, i, i + key.length) == key { count += 1; }
            }
        }
        at_line_start = substring(text, i, i + 1) == "\n";
        i += 1;
    }
    return count;
}

// Parse `/proc/meminfo`'s `MemTotal:` line (kB) into bytes. `MemTotal`
// is documented as always the first line, so this anchors at offset 0
// rather than scanning the whole file.
fn _cr_parse_meminfo_bytes(text: string) -> int {
    let key: string = "MemTotal:";
    if text.length < key.length { return 0; }
    if substring(text, 0, key.length) != key { return 0; }
    let mut tok: string = "";
    let mut i: int = key.length;
    loop {
        if i >= text.length { break; }
        let ch = substring(text, i, i + 1);
        if ch == " " || ch == "\t" {
            if tok.length > 0 { break; }
            i += 1;
            continue;
        }
        if ch == "\n" { break; }
        if ch == "k" { break; }
        tok = tok + ch;
        i += 1;
    }
    let kb = _cr_parse_positive_int(tok);
    if kb <= 0 { return 0; }
    return kb * 1024;
}

// Memory-aware fan-out ceiling for `_cr_resolve_jobs`. Returns how
// many concurrent `sfn emit` workers fit in RAM, each reserving
// `per_job_reserve` bytes out of a 66% slice of physical memory
// (headroom for the parent, the `clang`/`llvm-link` grandchildren,
// and the OS). Pure arithmetic so it is unit-testable apart from the
// host RAM probe. `memsize_bytes <= 0` means "unknown" — return
// `nproc` unchanged (fail-open: never starve a build on a host we
// cannot measure). The clamp only ever *lowers* the CPU-derived
// count, never raises it.
fn _cr_ram_budget_jobs(memsize_bytes: int, nproc: int) -> int {
    if memsize_bytes <= 0 { return nproc; }
    // 3 GiB — the measured peak RSS of the heaviest compiler-module
    // emit (`capsule_resolver.sfn` ~3.23 GiB); see
    // `docs/proposals/0022-darwin-memory-governor.md` §2.4.
    let per_job_reserve: int = 3221225472;
    let usable: int = memsize_bytes * 66 / 100;
    let mut budget: int = usable / per_job_reserve;
    if budget < 1 { budget = 1; }
    if budget >= nproc { return nproc; }
    return budget;
}

// Parse a non-negative integer from a string. Returns 0 on any
// non-digit or empty input. Local to the resolver so we don't
// pull in a richer parser for a single-use helper.
fn _cr_parse_positive_int(value: string) -> int {
    if value.length == 0 { return 0; }
    let mut n: int = 0;
    let mut i: int = 0;
    let mut any_digit: boolean = false;
    loop {
        if i >= value.length { break; }
        let ch = substring(value, i, i + 1);
        let mut digit: int = -1;
        if ch == "0" { digit = 0; }
        if ch == "1" { digit = 1; }
        if ch == "2" { digit = 2; }
        if ch == "3" { digit = 3; }
        if ch == "4" { digit = 4; }
        if ch == "5" { digit = 5; }
        if ch == "6" { digit = 6; }
        if ch == "7" { digit = 7; }
        if ch == "8" { digit = 8; }
        if ch == "9" { digit = 9; }
        if digit < 0 {
            // Allow trailing whitespace (e.g. nproc's trailing newline
            // already stripped, but be defensive against printf "%s"
            // wrappers).
            if ch == " " {
                i += 1;
                continue;
            }
            if ch == "\t" {
                i += 1;
                continue;
            }
            if ch == "\n" {
                i += 1;
                continue;
            }
            return 0;
        }
        any_digit = true;
        n = n * 10 + digit;
        i += 1;
    }
    if !any_digit { return 0; }
    return n;
}

// One emit task for `_cr_run_parallel_emit`. The helper invokes
// `<sailfin_exe> emit --module-name <slug> -o <output_path> <mode>
// <source_path>` for each task, fanning across `jobs` workers.
struct ParallelEmitTask {
    slug: string;
    output_path: string;
    source_path: string;
}

// The emit child's argv — ONE construction shared by the serial branch and
// the parallel pool, so the two can never drift. Flag ownership is
// unchanged and out of scope: `--attempts 1 --no-validate` pins the child
// to a single bare emit (the resolver layer owns retry + validation), and
// `--no-resolve-gate` (#906) suppresses the lowering dry-run gate for a
// per-module intermediate emit that carries no cross-module import
// context. Mirrors `emit_helpers.emit_subprocess_with_retry`.
fn _cr_emit_child_argv(sailfin_exe: string, slug: string, emit_target: string, mode: string, source_path: string, import_context_root: string) -> string[] {
    let mut argv: string[] = [sailfin_exe, "emit", "--module-name", slug, "--attempts", "1", "--no-validate", "--no-resolve-gate", "-o", emit_target];
    if import_context_root.length > 0 {
        argv.push("--import-context");
        argv.push(import_context_root);
    }
    argv.push(mode);
    argv.push(source_path);
    return argv;
}

// The emit children's environment. `spawn_with_env` takes an EXPLICIT
// environment — an empty array means the EMPTY environment, never
// "inherit" — whereas the retired `env … sh driver` pipeline let every
// worker inherit the parent's. `process.environ()` reproduces that
// inheritance exactly (SFN-498 made it real on Windows too).
fn _cr_emit_child_env() -> string[] ![io] { return process.environ(); }

// Re-emit a child emit's captured stream on the parent's matching stream.
// The retired `xargs` workers inherited the parent's stdio, so an emit
// failure's diagnostics reached the terminal directly; the pool's pipes
// stash them instead, so they are drained and re-printed to preserve that
// visibility — grouped per module rather than interleaved mid-file.
// `print` / `print.err` append a newline, so one trailing newline is
// stripped for a byte-faithful round-trip. Mirrors
// `build/runtime_objs.sfn::_runtime_emit_captured_stream`.
fn _cr_emit_captured_stream(text: string, to_stderr: boolean) -> void ![io] {
    if text.length == 0 { return; }
    let mut body: string = text;
    if substring(body, body.length - 1, body.length) == "\n" {
        body = substring(body, 0, body.length - 1);
    }
    if to_stderr { print.err(body); } else { print(body); }
}

// Drain one emit child's pipes to EOF, re-emit what it wrote, then reap.
// Returns the child's exit code. `handle_wait` is the SOLE reaper/free
// path, so every spawned handle must reach it — a child's failure is an
// exit code here, never an early return.
//
// The drain is required, not cosmetic: `spawn_with_env` redirects the
// child's stdout/stderr into pipes, so a child that fills a pipe buffer
// blocks on `write` until the parent reads, and `handle_wait` closes the
// read ends before `waitpid` — reaping undrained would SIGPIPE a live
// child and report 141 for a successful emit. Draining the child at the
// head of the window to EOF is what guarantees the window always advances.
//
// POSIX demuxes with `io.poll_any` over the two fds; Windows has no fd
// projection for a HANDLE and no `poll(2)` over pipes, so it drives the
// framed reads, each of which pumps BOTH pipes so neither stream can wedge
// the other. Same split `cli/commands/test.sfn::_reap_test_child` carries.
fn _cr_reap_emit_child(handle: int) -> int ![io] {
    // `spawn_with_env` reports failure as handle 0 — nothing to drain or
    // reap. 127 is the same "could not execute" code the serial branch's
    // `process.run` surfaces.
    if handle == 0 { return 127; }
    let mut out_buf: string = "";
    let mut err_buf: string = "";
    let mut poll_failures: int = 0;
    loop {
        if process.handle_stdout_at_eof(handle) && process.handle_stderr_at_eof(handle) {
            break;
        }
        // The framed reads close an fd and set it to -1 at EOF, so the fds
        // are re-fetched every iteration rather than cached.
        let out_fd = process.handle_stdout_fd(handle);
        let err_fd = process.handle_stderr_fd(handle);
        let mut fds: int[] = [];
        if out_fd >= 0 { fds.push(out_fd); }
        if err_fd >= 0 { fds.push(err_fd); }
        let mut read_out: boolean = false;
        let mut read_err: boolean = false;
        if fds.length == 0 {
            // Windows: the accessors are -1 by design and `io.poll_any` is
            // a -1 stub. Each framed read blocks until a byte or EOF, which
            // is what keeps this from spinning; termination stays the
            // both-at-EOF check above.
            read_out = !process.handle_stdout_at_eof(handle);
            read_err = !process.handle_stderr_at_eof(handle);
        } else {
            let ready = io.poll_any(fds, -1);
            if ready < 0 {
                // EINTR is transient, but a permanently failing poll must
                // not busy-spin: bail to the reap after a bounded run of
                // consecutive failures.
                poll_failures += 1;
                if poll_failures > 64 { break; }
                continue;
            }
            poll_failures = 0;
            read_out = ready == out_fd;
            read_err = ready == err_fd;
        }
        if read_out {
            let chunk = process.handle_read_bytes_stdout(handle, 65536);
            if chunk.length > 0 { out_buf = out_buf + chunk; }
        }
        if read_err {
            let chunk = process.handle_read_bytes_stderr(handle, 65536);
            if chunk.length > 0 { err_buf = err_buf + chunk; }
        }
    }
    _cr_emit_captured_stream(out_buf, false);
    _cr_emit_captured_stream(err_buf, true);
    return process.handle_wait(handle);
}

// Run one fan-out round over `tasks`; return the tasks that did NOT
// publish a good artifact. Keeps at most `jobs` children live and reaps in
// launch order.
//
// In-order reaping (rather than first-to-finish) is the only strategy
// available: there is no wait-for-any primitive, and the EOF-proxy
// alternative needs `io.poll_any` across every live child's fds — which
// Windows cannot express (a HANDLE has no fd projection, and `poll(2)`
// does not cover pipes under mingw), so it would fork the fan-out per
// host. It is deadlock-free by construction: the head child is always
// drained to EOF, so it always terminates and the window always advances,
// even when peers are parked on a full pipe buffer. Same shape
// `cli/commands/test.sfn` runs its job pool with.
fn _cr_emit_pool_round(tasks: ParallelEmitTask[], mode: string, sailfin_exe: string, jobs: int, import_context_root: string, child_env: string[]) -> ParallelEmitTask[] ![io] {
    // `native` staging emits `.sfn-asm`, which does not round-trip through
    // `llvm-as`; only `llvm` output is validated. Same split the retired
    // worker's `[ "$SAILFIN_PE_MODE" != llvm ]` guard made.
    let validate = mode == "llvm";
    let mut failed: ParallelEmitTask[] = [];
    let mut handles: int[] = [];
    let mut staged: string[] = [];
    let mut targets: string[] = [];
    let mut launched: int = 0;
    let mut ti: int = 0;
    loop {
        if ti >= tasks.length { break; }
        // Top the window back up to `jobs` live children.
        loop {
            if launched >= tasks.length { break; }
            if launched - ti >= jobs { break; }
            let t = tasks[launched];
            // #1011 staging: emit to a sibling temp and publish with an
            // atomic same-filesystem rename, so no peer observes the
            // truncate+rewrite an emit performs on its `-o` target. "" is
            // the documented degrade (no `mktemp` on a Windows host) — safe
            // under the fan-out because every task owns a distinct output
            // path and no peer child reads another's in-flight output.
            let tmp = _mktemp_sibling_cmd(t.output_path);
            let mut target: string = t.output_path;
            if tmp.length > 0 { target = tmp; }
            staged.push(tmp);
            targets.push(target);
            handles.push(process.spawn_with_env(_cr_emit_child_argv(sailfin_exe, t.slug, target, mode, t.source_path, import_context_root), child_env));
            launched += 1;
        }
        let t = tasks[ti];
        let target = targets[ti];
        let tmp = staged[ti];
        let rc = _cr_reap_emit_child(handles[ti]);
        let mut ok: boolean = rc == 0;
        if !ok {
            print.err("capsule-resolver: emit failed for " + t.slug + " (exit "
                + number_to_string(rc)
                + ")");
        }
        if ok {
            if !fs.exists(target) { ok = false; }
        }
        if ok {
            // Non-empty probe — the `[ -s "$tmp" ]` the retired worker ran,
            // and the same probe `emit_subprocess_with_retry` keeps.
            let probe = fs.readFile(target);
            if probe.length == 0 { ok = false; }
        }
        if ok {
            if validate {
                if !validate_llvm_ir(target) { ok = false; }
            }
        }
        if ok {
            // Publish atomically (no-op when the in-place degrade ran).
            if tmp.length > 0 {
                if !_atomic_rename_into_place(tmp, t.output_path) { ok = false; }
            }
        }
        if !ok {
            // Drop a failed attempt's temp so retry rounds do not
            // accumulate `.sfn_stage.*` litter beside the output.
            if tmp.length > 0 { fs.deleteFile(tmp); }
            failed.push(t);
        }
        ti += 1;
    }
    return failed;
}

// Run a list of `<sailfin> emit` invocations. Each task is an
// independent subprocess (fresh arena, no shared state), so memory
// stays per-worker rather than scaling with `tasks.length`.
//
// Stage E PR3: this is the helper that closes the parallelism
// gap with the prior `scripts/build.sh`'s historical
// `xargs -P "$JOBS"` pattern (formerly at build.sh:819, 853;
// the script was retired in Stage E PR7 / #383). With
// `jobs == 1`, the helper sequentialises to keep the
// regression-bisect path simple.
fn _cr_run_parallel_emit(tasks: ParallelEmitTask[], mode: string, sailfin_exe: string, jobs: int, import_context_root: string) -> boolean ![io] {
    if tasks.length == 0 { return true; }
    let mut effective_jobs = jobs;
    if effective_jobs <= 0 { effective_jobs = 1; }

    // Sequential fallback: keeps regression bisects (and any
    // SAILFIN_BUILD_JOBS=1 invocations) on the simple
    // process.run-per-task path. No temp files beyond the per-task
    // #1011 staging.
    if effective_jobs == 1 {
        let mut i: int = 0;
        loop {
            if i >= tasks.length { break; }
            let t = tasks[i];
            // #1011: emit to a sibling temp + atomic rename so a peer
            // reader never sees a partial `.sfn-asm`/`.ll`. Mirrors
            // `emit_subprocess_with_retry`; falls back to in-place when
            // `mktemp` is unavailable.
            let staged = _mktemp_sibling_cmd(t.output_path);
            let mut emit_target: string = t.output_path;
            if staged.length > 0 { emit_target = staged; }
            let rc = process.run(_cr_emit_child_argv(sailfin_exe, t.slug, emit_target, mode, t.source_path, import_context_root));
            if rc != 0 {
                if staged.length > 0 {
                    process.run(["rm", "-f", staged]);
                }
                return false;
            }
            if staged.length > 0 {
                if !_atomic_rename_into_place(staged, t.output_path) {
                    return false;
                }
            }
            i += 1;
        }
        return true;
    }

    // Parallel: a bounded native worker pool. Each round keeps at most
    // `effective_jobs` `sfn emit` children live and reaps them in launch
    // order; the round returns the tasks that did not publish, and up to
    // `max_rounds` rounds re-run only those. That preserves the retired
    // shell worker's 3-attempt contract — the defence against the seed's
    // intermittent IR-corruption flake (#515) — while keeping the retry
    // itself fanned out rather than serialised behind one worker.
    //
    // Failure is reported after the whole queue drains, matching what
    // `xargs` actually did: it only aborts early on exit 255 or a signal,
    // and the worker exited 1, so the queue ran to completion and `xargs`
    // returned 123.
    let child_env = _cr_emit_child_env();
    let max_rounds: int = 3;
    let mut pending: ParallelEmitTask[] = tasks;
    let mut round: int = 0;
    loop {
        if pending.length == 0 { break; }
        if round >= max_rounds { break; }
        round += 1;
        pending = _cr_emit_pool_round(pending, mode, sailfin_exe, effective_jobs, import_context_root, child_env);
    }
    return pending.length == 0;
}

export {
    ParallelEmitTask,
    _cr_count_cpuinfo_processors,
    _cr_jobs_from_probe,
    _cr_parse_cpu_online,
    _cr_parse_meminfo_bytes,
    _cr_ram_budget_jobs,
    _cr_resolve_jobs,
    _cr_run_parallel_emit
};
