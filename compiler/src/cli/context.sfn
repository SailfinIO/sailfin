// compiler/src/cli/context.sfn
//
// CLI invocation context (CLI modularization epic #351, Issue 2.2 —
// proposal §4.2). Owns the driver-injected argv prefix that the
// retired C driver (and today's `sailfin_cli_main_with_paths`)
// prepends to user argv, in the fixed order:
//
//     --runtime-root <path> --binary-dir <path> --compiler-path <path>
//
// All flags are optional, but each is only recognised after its
// predecessor has been consumed (or was absent). The walk is positional,
// mirroring the historical inline parsing in `sailfin_cli_main`
// byte-for-byte. A flag with no following value is left unconsumed,
// exactly like the inline walk it replaces.
//
// `registry_url` is part of the canonical CliContext contract
// (proposal §4.2) but has no driver-prefix source today: registry
// resolution still lives with the `config` command plumbing until
// `compiler/src/cli/registry.sfn` lands in a later epic issue. It is
// always "" here, matching today's behaviour where no inline argv
// parsing produces a registry URL.
import { _env_flag, _legacy_flag_file } from "../build_flags";

struct CliContext {
    runtime_root: string;
    binary_dir: string;
    // Exact canonical path of the running compiler executable. This is
    // distinct from `binary_dir`: selecting a preferred sibling name
    // can identify different bytes when multiple compiler binaries
    // coexist in one directory (SFN-545).
    compiler_path: string;
    registry_url: string;
    trace_argv: boolean;
    // The user-visible argv (driver prefix stripped) the toolchain-dispatch
    // re-exec replays onto the pinned toolchain (SFN-172). Empty until
    // `sailfin_cli_main_v2` fills it after slicing the prefix — the parse here
    // does not have the sliced view, so `parse_driver_prefix` leaves it [].
    orig_args: string[];
    // True once a one-shot `+<version>` / `toolchain run` selector has been
    // resolved in this process (SFN-1065). A selector that resolves to the
    // running toolchain returns in-process rather than re-execing, so without
    // this the command's own gate would read `SAILFIN_TOOLCHAIN` and dispatch
    // anyway — letting the lower-ranked environment input override the CLI
    // selector that outranks it (SFEP-0073 §3.3).
    selector_resolved: boolean;
}

// Single source of truth for the prefix walk. Both public entry
// points (`parse_driver_prefix`, `driver_prefix_length`) delegate
// here so the prefix rules can never drift between the parsed
// values and the consumed-token count.
struct _DriverPrefix {
    runtime_root: string;
    binary_dir: string;
    compiler_path: string;
    length: int;
}

fn _walk_driver_prefix(argv: string[]) -> _DriverPrefix {
    let mut prefix = _DriverPrefix {
        runtime_root: "",
        binary_dir: "",
        compiler_path: "",
        length: 0
    };
    let mut start_index: int = 0;
    if start_index < argv.length {
        if argv[start_index] == "--runtime-root" {
            if start_index + 1 < argv.length {
                prefix.runtime_root = argv[start_index + 1];
                start_index += 2;
            }
        }
    }
    if start_index < argv.length {
        if argv[start_index] == "--binary-dir" {
            if start_index + 1 < argv.length {
                prefix.binary_dir = argv[start_index + 1];
                start_index += 2;
            }
        }
    }
    if start_index < argv.length {
        if argv[start_index] == "--compiler-path" {
            if start_index + 1 < argv.length {
                prefix.compiler_path = argv[start_index + 1];
                start_index += 2;
            }
        }
    }
    prefix.length = start_index;
    return prefix;
}

// Number of leading argv tokens consumed by the driver prefix.
// `argv[driver_prefix_length(argv)..]` is the user-visible argv.
// Kept separate from CliContext so the struct stays on the §4.2
// contract while callers can still slice the remaining args without
// re-walking the prefix inline.
fn driver_prefix_length(argv: string[]) -> int {
    let prefix = _walk_driver_prefix(argv);
    return prefix.length;
}

// Parse the driver-injected prefix out of `argv` into a CliContext.
// Populated identically to the historical inline parsing in
// `sailfin_cli_main`: same runtime_root / binary_dir for the same
// argv, and the same `trace_argv` toggle (SAILFIN_TRACE_ARGV env
// flag, with the legacy `build/sailfin/.trace_argv` file as
// back-compat). The `runtime_root` fallback to the local `runtime`
// bundle stays with the caller — it is a filesystem probe, not argv
// parsing. It now lives in `cli/runtime_root.sfn` (SFN-1088), which
// every linking command resolves through; this parser still yields the
// raw driver-prefix value and validates nothing.
fn parse_driver_prefix(argv: string[]) -> CliContext ![io] {
    let prefix = _walk_driver_prefix(argv);
    let mut ctx = CliContext {
        runtime_root: prefix.runtime_root,
        binary_dir: prefix.binary_dir,
        compiler_path: prefix.compiler_path,
        registry_url: "",
        trace_argv: false,
        orig_args: [],
        selector_resolved: false
    };
    ctx.trace_argv = _env_flag("SAILFIN_TRACE_ARGV") || _legacy_flag_file("build/sailfin/.trace_argv");
    return ctx;
}
