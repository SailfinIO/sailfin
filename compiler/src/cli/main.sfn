// compiler/src/cli/main.sfn
//
// Compiler CLI skeleton — `sailfin_cli_main_v2` (CLI modularization
// epic #351, Issue 2.3 — proposal §5 Phase 2, §7 Issue 2.3, Risk R2).
//
// v2 builds a root `Command` via `sfn/cli` from every subcommand's
// `command_def()`, parses with `sfn/cli`'s pure, non-exiting `parse()`,
// and dispatches each command to its `run` — the per-subcommand
// `command_def()` + `run()` pattern `version.sfn` established. As of
// SFEP-0027 Phase C (#1797) `sailfin_cli_main_v2` is the *sole* command
// dispatch: the four residual behaviors the former
// `sailfin_cli_main_legacy` shim owned — root `-h`/`--help`, the
// internal `selfhost` validator, bare-`.sfn`-file dispatch, and the
// unknown-command fallback — are handled inline at the fallthrough
// below, so no path routes through a legacy dispatcher.
//
// Risk R2 (proposal §8): `sfn/cli`'s `run()` calls `process.exit()` on
// --help/--version/parse errors, which would terminate the process out
// from under the `int`-returning CLI contract (and any embedder that
// binds the entry symbol). v2 therefore uses `parse()` exclusively and
// never `run()`, so the resolved exit code always flows back to the
// caller (`native_cli_main` / `sailfin_cli_main_with_paths`).
//
// Return-type note: the issue sketch writes `-> number`, but exit codes
// are integers — the `EXIT_*` constants are `int`, the legacy dispatch
// returns `int`, and the C-shim entry (`native_cli_main`) returns `int`.
// v2 returns `int` so the code threads through that chain without a
// numeric coercion.
import {
    Command,
    Matches,
    ParseError,
    command,
    flag_choice,
    format_help_for_path,
    get_or,
    parse,
    parse_error,
    parse_is_ok,
    parse_matches,
    render_help_json,
    render_help_tree,
    subcommand,
    subcommand_path,
    with_flag,
    with_subcommand
} from "sfn/cli";
import { int_to_string } from "sfn/strings";

import { _ends_with } from "../build/paths";
import { _runtime_bundle_exists } from "../build/runtime_objs";
import { handle_selfhost_command } from "../cli_selfhost";
import { ice_set_binary_dir } from "../ice";
import { starts_with, substring } from "../string_utils";
import { configure_terminal_output } from "../terminal_output";
import { command_def as add_command_def, run as add_run } from "./commands/add";
import { command_def as bench_command_def, run as bench_run } from "./commands/bench";
import { command_def as build_command_def, run as build_run } from "./commands/build";
import { command_def as cache_command_def, run as cache_run } from "./commands/cache";
import { command_def as capabilities_command_def, run as capabilities_run } from "./commands/capabilities";
import { command_def as check_command_def, run as check_run } from "./commands/check";
import { command_def as completion_command_def, run as completion_run } from "./commands/completion";
import { command_def as config_command_def, run as config_run } from "./commands/config";
import { command_def as dev_command_def, run as dev_run } from "./commands/dev";
import { command_def as emit_command_def, run as emit_run } from "./commands/emit";
import { command_def as fmt_command_def, run as fmt_run } from "./commands/fmt";
import { command_def as guillermo_command_def, run as guillermo_run } from "./commands/guillermo";
import { command_def as init_command_def, run as init_run } from "./commands/init";
import { command_def as lock_command_def, run as lock_run } from "./commands/lock";
import { command_def as login_command_def, run as login_run } from "./commands/login";
import { command_def as package_command_def, run as package_run } from "./commands/package";
import { command_def as publish_command_def, run as publish_run } from "./commands/publish";
import { command_def as run_command_def, run as run_run } from "./commands/run";
import { command_def as symbols_command_def, run as symbols_run } from "./commands/symbols";
import { command_def as test_command_def, run as test_run } from "./commands/test/mod";
import {
    command_def as toolchain_command_def,
    run as toolchain_run,
    toolchain_env_exact_selector,
    toolchain_select_exact
} from "./commands/toolchain";
import { command_def as version_command_def, run as version_run } from "./commands/version";
import { CliContext, driver_prefix_length, parse_driver_prefix } from "./context";

// Render one command row for `_usage()`: the invocation `sig` padded to a
// fixed column so the one-line `desc` aligns across every group. The
// top-level listing intentionally shows only the command shape — the full
// per-command flag surface lives under `sfn <command> --help`, so long flag
// lists no longer wrap the terminal (the two `sfn bench` modes collapse to
// one row here for the same reason).
fn _cmd_row(sig: string, desc: string) -> string {
    let col: int = 31;
    let mut out = "  " + sig;
    let mut pad = col - sig.length;
    if pad < 1 { pad = 1; }
    let mut i = 0;
    loop {
        if i >= pad { break; }
        out = out + " ";
        i += 1;
    }
    return out + desc + "\n";
}

// Render the grouped top-level listing for one category: every direct
// subcommand of `root` that filed itself under `category` via `with_usage`,
// in registration order. Registration order is display order — that is the
// point, and it is why `sailfin_cli_main_v2` registers commands grouped
// rather than ad hoc (SFN-1159).
fn _usage_group(root: Command, heading: string) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= root.subcmds.length { break; }
        let sub: Command = root.subcmds[i];
        if strings_equal(sub.category, heading) {
            let mut sig: string = sub.usage_sig;
            if sig.length == 0 { sig = "sfn " + sub.name; }
            let mut desc: string = sub.summary;
            if desc.length == 0 { desc = sub.description; }
            out = out + _cmd_row(sig, desc);
        }
        i += 1;
    }
    if out.length == 0 { return ""; }
    return heading + ":\n" + out + "\n";
}

// Top-level `sfn --help`. Every command row is derived from the registered
// `Command` tree rather than hand-maintained here, so the listing cannot
// drift from what is actually registered — the same bug class SFN-1074
// fixed for `sfn <cmd> --help` (SFN-1159). A command opts in by calling
// `with_usage` in its own `command_def()`; one that does not (`dev`,
// `guillermo`) stays registered and dispatchable but unlisted.
// The category headings to render, in the order their first member is
// registered. Derived rather than declared: a hand-kept heading list would be
// a second place for the listing to drift from the tree — a command whose
// `category` matched no entry would vanish from `sfn --help` silently, which
// is the failure mode SFN-1159 exists to remove.
fn _usage_headings(root: Command) -> string[] {
    let mut headings: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= root.subcmds.length { break; }
        let category: string = root.subcmds[i].category;
        if category.length > 0 {
            let mut seen: boolean = false;
            let mut j: int = 0;
            loop {
                if j >= headings.length { break; }
                if strings_equal(headings[j], category) {
                    seen = true;
                    break;
                }
                j += 1;
            }
            if !seen { headings.push(category); }
        }
        i += 1;
    }
    return headings;
}

fn _usage(root: Command) -> string {
    let mut out: string = "usage: sfn <command> [options]\n\n";
    let headings: string[] = _usage_headings(root);
    let mut h: int = 0;
    loop {
        if h >= headings.length { break; }
        out = out + _usage_group(root, headings[h]);
        h += 1;
    }
    out = out + "global options:\n";
    out = out + _cmd_row("sfn --color <mode> ...", "color: auto, always, or never");
    out = out + "\n";
    out = out
        + "Run `sfn <command> --help` for the full flags on any command.\n\n";
    out = out + "examples:\n";
    out = out + "  sfn run examples/basics/hello-world.sfn\n";
    out = out
        + "  sfn build -o build/native/examples/hello examples/basics/hello-world.sfn\n";
    out = out + "  sfn add acme/router\n";
    out = out + "  sfn config set registry https://registry.acme.internal\n";
    out = out + "\n";
    out = out
        + "developer commands (compiler/toolchain maintainers): see sfn dev --help\n";
    return out;
}

// Direct-params facade over `sailfin_cli_main_v2` (M5.3 / #471). This
// is the route from the synthesized `@main(argc, argv)` prologue
// (`fn main` below) into the CLI dispatch: `runtime_root`, `binary_dir`,
// and the exact `compiler_path` are resolved as Sailfin strings via
// `runtime/sfn/platform/exec.sfn`, then re-encoded as the
// `--runtime-root` / `--binary-dir` / `--compiler-path` driver prefix that
// `cli/context.sfn::parse_driver_prefix` consumes — the shape the
// retired C driver injected as argv flags.
fn sailfin_cli_main_with_paths(argv: string[], runtime_root: string, binary_dir: string, compiler_path: string) -> int ![clock, io, net] {
    let mut composed: string[] = [];
    if runtime_root.length > 0 {
        composed.push("--runtime-root");
        composed.push(runtime_root);
    }
    if binary_dir.length > 0 {
        composed.push("--binary-dir");
        composed.push(binary_dir);
    }
    if compiler_path.length > 0 {
        composed.push("--compiler-path");
        composed.push(compiler_path);
    }
    let mut i: int = 0;
    loop {
        if i >= argv.length { break; }
        composed.push(argv[i]);
        i += 1;
    }
    return sailfin_cli_main_v2(composed);
}

// Cold-path `SAILFIN_TRACE_ARGV` trace. v2 is the sole dispatch, so it
// reproduces this trace for the argv each path acts on — every matched
// subcommand block and the fallthrough call it under `ctx.trace_argv`,
// so `version` / `--version` / `-V` and the help/selfhost/bare-file/
// unknown paths all emit the argv trace under the toggle (pinned by
// `compiler/tests/e2e/compiler_debug_toggle_env_vars_test.sfn`).
fn _v2_trace_argv(argv: string[]) ![io] {
    print.err("cli: argv.len=" + int_to_string(argv.length));
    let mut trace_index: int = 0;
    loop {
        if trace_index >= argv.length { break; }
        print.err("cli: argv[" + int_to_string(trace_index) + "]=" + argv[trace_index]);
        trace_index += 1;
    }
}

// Terminal handler for every non-ok `parse()` that still descended into a
// registered subcommand. `sfn/cli`'s parser reports `--help`/`-h` as a
// `help_requested` parse error rather than a success, so the two cases
// arrive here together and are told apart by `parse_err.kind`: a help
// request is answered on stdout with exit 0, anything else keeps the
// legacy usage exit code 2.
//
// Both branches render the same text through `format_help_for_path`,
// derived from the `command_def()` tree the parser itself matched against.
// Before SFN-1074 each dispatch block printed its own hand-maintained
// `usage: sfn <cmd> ...` literal, which shadowed the owning command's real
// flag set and drifted from it (`sfn build --help` never mentioned
// `--target`; `sfn dev --help` advertised one of seven groups). Deriving
// the text removes the second copy that could drift.
//
// The literal `2` (not `sfn/cli`'s `EXIT_USAGE`) is deliberate and matches
// every other exit in this dispatch: the `EXIT_*` constants are
// module-level `let`s with no cross-capsule import value path today, so
// they lower to 0 here.
fn _v2_help_or_usage(root: Command, matches: Matches, parse_err: ParseError) -> int ![io] {
    let text = format_help_for_path(root, subcommand_path(matches));
    if strings_equal(parse_err.kind, "help_requested") {
        print(text);
        return 0;
    }
    // A real usage error: lead with the parser's diagnostic when it carries
    // one (`unknown subcommand 'quantum'` and friends, which the e2e parity
    // oracles assert on), then the same derived help.
    if parse_err.message.length > 0 { print(parse_err.message); }
    print(text);
    return 2;
}

fn _is_help_json_args(args: string[]) -> boolean {
    if args.length != 2 { return false; }
    if strings_equal(args[0], "--help") {
        return strings_equal(args[1], "--json");
    }
    if strings_equal(args[0], "-h") {
        return strings_equal(args[1], "--json");
    }
    if strings_equal(args[0], "help") {
        return strings_equal(args[1], "--json");
    }
    return false;
}

fn _requests_json(args: string[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= args.length { break; }
        if args[index] == "--json" { return true; }
        index += 1;
    }
    return false;
}

// One-shot exact selector peeled off the front of the user-visible argv
// (SFEP-0073 §3.3 rank 1). `form` doubles as the diagnostic source label and
// is empty when no selector was present, in which case `rest` is the argv
// unchanged.
struct CliSelector {
    form: string;
    selector: string;
    rest: string[];
}

fn _v2_slice_from(args: string[], start: int) -> string[] {
    let mut out: string[] = [];
    let mut i: int = start;
    loop {
        if i >= args.length { break; }
        out.push(args[i]);
        i += 1;
    }
    return out;
}

// Recognize `sfn +<version> <command> ...` and its long form
// `sfn toolchain run <version> [--] <command> ...`. Deliberately a prefix scan
// over raw strings rather than a parse: it must accept a `<command>` this
// toolchain has never heard of, so that an older entry can forward it to a
// newer payload (SFEP-0073 §3.3). Anything it declines to peel falls through
// to the normal command tree, which owns the usage error.
fn _v2_peel_selector(args: string[]) -> CliSelector {
    let none = CliSelector { form: "", selector: "", rest: args };
    if args.length == 0 { return none; }

    if starts_with(args[0], "+") {
        // A bare "+" selects nothing; leave it to the parser to reject.
        if args[0].length == 1 { return none; }
        // With no command after it there is nothing to forward, and dispatching
        // would install a toolchain just to print its own usage. Declining
        // leaves the parser to report the unknown command locally.
        if args.length < 2 { return none; }
        return CliSelector {
            form: "+<version>",
            selector: substring(args[0], 1, args[0].length),
            rest: _v2_slice_from(args, 1)
        };
    }

    if args.length >= 3 {
        if strings_equal(args[0], "toolchain") {
            if strings_equal(args[1], "run") {
                // A version never starts with `-`, so a flag here is `--help`
                // or a usage error. Declining routes it to the registered leaf,
                // which owns both — peeling would answer `toolchain run --help`
                // with a "not an exact version" error and hide the command.
                if starts_with(args[2], "-") { return none; }
                // The `--` separator is conventional but optional; everything
                // after the selector is the forwarded command either way.
                let mut start: int = 2 + 1;
                if args.length > 3 {
                    if strings_equal(args[3], "--") { start = 4; }
                }
                // No command left to forward: a local usage error, not a
                // dispatch that would fetch a toolchain to print its usage.
                if start >= args.length { return none; }
                return CliSelector {
                    form: "sfn toolchain run",
                    selector: args[2],
                    rest: _v2_slice_from(args, start)
                };
            }
        }
    }
    return none;
}

// `--skip-toolchain-check` is read straight off the argv here because the
// selector is resolved before the command tree parses, so the typed flag is
// not available yet. It is matched exactly, never as a prefix, so it cannot
// be confused with a longer flag or with a value that merely contains it.
fn _v2_argv_has_skip_flag(args: string[]) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= args.length { break; }
        if strings_equal(args[i], "--skip-toolchain-check") { return true; }
        i += 1;
    }
    return false;
}

// A version query must stay network-silent (SFEP-0073 §3.3), so the selection
// path needs to know it is answering one before it considers fetching.
fn _v2_is_version_query(args: string[]) -> boolean {
    if args.length == 0 { return false; }
    if strings_equal(args[0], "version") { return true; }
    if strings_equal(args[0], "--version") { return true; }
    return strings_equal(args[0], "-V");
}

fn sailfin_cli_main_v2(argv: string[]) -> int ![clock, io, net] {
    // Parse the driver-injected `--runtime-root` / `--binary-dir` prefix
    // (Issue 2.2) so `binary_dir` is available for version resolution
    // and the user-visible args can be sliced off the front.
    let mut ctx: CliContext = parse_driver_prefix(argv);
    // Stash `binary_dir` for the ICE banner (SFEP-0037 §3.2, #1807): an
    // uncaught pipeline `throw` — which the `@main` wrapper prints as the ICE
    // banner — resolves the version from this lazily, so the banner carries
    // the `.build-stamp` dev hash even though the throw site cannot reach
    // `binary_dir`. No panic boundary is installed here on purpose: a nested
    // source-level `try/catch` frame corrupts the exception chain under the
    // arena allocator (see `ice.sfn` header).
    ice_set_binary_dir(ctx.binary_dir);
    let start_index: int = driver_prefix_length(argv);

    let mut args: string[] = [];
    let mut i: int = start_index;
    loop {
        if i >= argv.length { break; }
        args.push(argv[i]);
        i += 1;
    }
    // SFEP-0073 §3.3 rank 1: peel a one-shot exact selector before the command
    // tree is built, let alone parsed. Two things depend on it happening here.
    // The forwarded argv must not carry the selector token — `orig_args` is
    // what the re-exec replays, and a selector left in it would make the
    // selected toolchain re-select and loop. And the command after the
    // selector must never be validated against *this* toolchain's tree, so an
    // older entry can hand an unfamiliar command to a newer payload.
    let selection = _v2_peel_selector(args);
    args = selection.rest;

    // The user-visible argv the toolchain dispatcher (SFN-172) replays onto the
    // pinned toolchain on a re-exec. Captured here (not in `parse_driver_prefix`)
    // because the prefix slice is computed at this level.
    ctx.orig_args = args;

    if selection.form.length > 0 {
        // The entry hint is empty, so the project floor this selection is
        // checked against is discovered from the working directory rather than
        // from the entry file. The entry file is not knowable here by
        // construction — resolving it would require the parse this scan exists
        // to run ahead of — and cwd is the same root in every case but a
        // command naming a source file in a *different* project.
        //
        // Returns only when the selection resolved to this very toolchain; a
        // successful dispatch replaces this image and never comes back.
        // A version query is answered, never refused: a floor mismatch warns and
        // reports rather than withholding the version, matching what the
        // `SAILFIN_TOOLCHAIN` path does for the same query below.
        let version_query = _v2_is_version_query(args);
        let sel_rc = toolchain_select_exact(selection.selector, selection.form, "", ctx, _v2_argv_has_skip_flag(args)
            || version_query, version_query);
        if sel_rc != 0 { return sel_rc; }
        // Resolved in-process rather than dispatched. Recorded so the
        // lower-ranked `SAILFIN_TOOLCHAIN` cannot override the selector that
        // outranks it, in the command's own gate or in the version path below.
        ctx.selector_resolved = true;
    }

    // Root command, composed from each subcommand's `command_def()`. Built
    // incrementally (one `with_subcommand` reassignment per command) rather
    // than as a single deeply-nested expression: the pinned seed miscompiles
    // a `with_subcommand(...)` chain at this depth, emitting code that
    // segfaults at runtime while constructing the tree (#1773 — adding the
    // 13th command tipped the nested form over). The reassignment form is
    // semantically identical and codegens cleanly, and scales to the
    // remaining `build` / `run` migrations (SFEP-0027 §3.4) without
    // re-tripping the limit. The version string is not set on the command
    // (`with_version`) because `version.run` prints it itself — resolving it
    // eagerly here would add a filesystem read to every `build` / `run`
    // invocation. `parse()` skips argv[0] (the program name), so a synthetic
    // "sfn" head is prepended before parsing.
    let color_modes: string[] = ["auto", "always", "never"];
    let mut root: Command = with_flag(command("sfn", "Sailfin compiler"), flag_choice("color", "Color output: auto, always, or never", color_modes));
    // Registration order is the order `_usage()` lists these in, grouped by
    // the `with_usage` category each command declares. Keep a command beside
    // its group when adding one; an unlisted command (`guillermo`, `dev`)
    // goes at the end.
    root = with_subcommand(root, build_command_def());
    root = with_subcommand(root, run_command_def());
    root = with_subcommand(root, emit_command_def());
    root = with_subcommand(root, cache_command_def());
    root = with_subcommand(root, bench_command_def());
    root = with_subcommand(root, init_command_def());
    root = with_subcommand(root, check_command_def());
    root = with_subcommand(root, fmt_command_def());
    root = with_subcommand(root, test_command_def());
    root = with_subcommand(root, capabilities_command_def());
    root = with_subcommand(root, add_command_def());
    root = with_subcommand(root, lock_command_def());
    root = with_subcommand(root, publish_command_def());
    root = with_subcommand(root, package_command_def());
    root = with_subcommand(root, login_command_def());
    root = with_subcommand(root, config_command_def());
    root = with_subcommand(root, toolchain_command_def());
    root = with_subcommand(root, version_command_def());
    root = with_subcommand(root, completion_command_def());
    root = with_subcommand(root, symbols_command_def());
    root = with_subcommand(root, guillermo_command_def());
    root = with_subcommand(root, dev_command_def());

    // Machine-readable top-level help for tools and agents. This bypasses
    // `parse()` intentionally: `--json` is a modifier for root help, not a
    // root command flag, so the human-readable `sfn --help` path below stays
    // byte-for-byte unchanged.
    if _is_help_json_args(args) {
        print(render_help_json(render_help_tree(root)));
        return 0;
    }

    // Preserve the legacy `--emit` long-flag alias (`sfn --emit llvm x.sfn`):
    // the legacy dispatch treated `--emit` as the first token identically to
    // the `emit` subcommand. `sfn/cli`'s `parse()` would otherwise see it as
    // an unknown root flag, so normalize the leading `--emit` to `emit`
    // before parsing — the only place the alias is recognized now that the
    // legacy `is_emit` arm is removed.
    let mut parse_argv: string[] = ["sfn"];
    let mut j: int = 0;
    loop {
        if j >= args.length { break; }
        if j == 0 && strings_equal(args[0], "--emit") {
            parse_argv.push("emit");
        } else { parse_argv.push(args[j]); }
        j += 1;
    }

    let parse_result = parse(root, parse_argv);
    let parse_ok: boolean = parse_is_ok(parse_result);
    let matches = parse_matches(parse_result);
    let parse_err = parse_error(parse_result);
    let mut color_mode = get_or(matches, "color", "auto");
    // Machine-readable streams are protocol bytes, never terminal text. An
    // explicit `--color always` cannot inject SGR sequences into JSON.
    if _requests_json(args) { color_mode = "never"; }
    configure_terminal_output(color_mode);

    // `sfn guillermo` — the registered subcommand matched. Dispatch to the
    // guillermo command's `run` (it takes no input, so `matches` and `ctx`
    // are unused), reproducing the cold-path argv trace v2 owns. The
    // `parse_ok` gate is deliberate and unlike every other dispatch below:
    // `guillermo` is an easter egg, so `sfn guillermo --help` deliberately
    // does NOT get a rendered help page — it falls through to the root
    // fallthrough, keeping the command undiscoverable through `--help`. It
    // stays listed in `sfn --help --json` and shell completion, which walk
    // the whole `root` tree.
    if parse_ok {
        if strings_equal(subcommand(matches), "guillermo") {
            if ctx.trace_argv { _v2_trace_argv(argv); }
            return guillermo_run(matches, ctx);
        }
    }

    // `sfn init` — the registered subcommand matched. `init` declares no
    // args, so a clean parse (`parse_ok`) is the bare invocation and
    // dispatches to `init.run` (exit 0 scaffolded / 1 already-exists). Any
    // trailing token makes the parse non-ok while still marking the `init`
    // subcommand as descended; that is a usage error (exit 2), matching the
    // legacy handler's `args.length != 1` guard — the parser owns argument
    // validation, so the misuse never reaches `init.run`.
    if strings_equal(subcommand(matches), "init") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return init_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn login [token]` — the registered subcommand matched. A clean parse
    // dispatches to `login.run` (which uses the `token` positional when
    // present, else prompts and reads from stdin). A non-ok parse that still
    // descended into `login` (e.g. a second positional) is a usage error
    // (exit 2), matching the legacy handler's `args.length > 2` guard — the
    // parser owns argument validation, so the misuse never reaches
    // `login.run`.
    if strings_equal(subcommand(matches), "login") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return login_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn add [options] <capsule>` — the registered subcommand matched. A
    // clean parse dispatches to `add.run`. A non-ok parse that still
    // descended into `add` (a missing `<capsule>`, an unexpected extra
    // positional) is a usage error (exit 2), matching the legacy handler's
    // `capsule_arg.length == 0` / "unexpected argument" guards — the parser
    // owns argument validation, so the misuse never reaches `add.run`.
    if strings_equal(subcommand(matches), "add") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return add_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn publish [path]` — the registered subcommand matched. A clean parse
    // dispatches to `publish.run` (which packages the capsule at the optional
    // `[path]`, defaulting to the current directory). A non-ok parse that
    // still descended into `publish` (an unexpected extra positional) is a
    // usage error (exit 2), matching the legacy handler's `args.length > 2`
    // guard — the parser owns argument validation, so the misuse never
    // reaches `publish.run`.
    if strings_equal(subcommand(matches), "publish") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return publish_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn lock [options]` — the registered subcommand matched. A clean parse
    // dispatches to `lock.run`, which reconstructs the legacy positional
    // slice and delegates to `handle_lock_command` (the workspace-lock body
    // now lives in `cli/commands/lock.sfn`). A non-ok parse that still
    // descended into `lock` (a `--work-dir` with no value, an unrecognized
    // flag) is a usage error (exit 2), matching the legacy handler's
    // "requires a directory argument" / unknown-flag guards — the parser owns
    // argument validation, so the misuse never reaches `lock.run`.
    if strings_equal(subcommand(matches), "lock") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return lock_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn package [options]` — the registered subcommand matched. A clean
    // parse dispatches to `package.run`, which reconstructs the legacy
    // positional slice and delegates to `handle_package_command` (the
    // packaging body now lives in `cli/commands/package.sfn`). A non-ok parse
    // that still descended into `package` (a value flag with no value, an
    // unrecognized flag) is a usage error (exit 2) — the parser owns argument
    // validation.
    if strings_equal(subcommand(matches), "package") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return package_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn emit [options] <llvm|sailfin|native> <file.sfn>` — the registered
    // subcommand matched (including the normalized `--emit` alias). A clean
    // parse dispatches to `emit.run`, which reproduces the legacy
    // `_legacy_dispatch_emit` body against typed matches. A non-ok parse that
    // still descended into `emit` (a value flag with no value, an
    // unrecognized flag, a missing/surplus positional) is a usage error (exit
    // 2) — the parser owns argument validation, replacing the legacy
    // `_usage()` branches.
    if strings_equal(subcommand(matches), "emit") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return emit_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn fmt [options] <path...>` — the registered subcommand matched. The
    // variadic `[path...]` accepts zero tokens, so a bare `sfn fmt` (and
    // every flag combination) parses ok and dispatches to `fmt.run`, which
    // owns the no-path usage message (exit 1) and the `--check`/`--write`
    // mutual-exclusion error (exit 1), preserving the legacy handler's exit
    // codes. A non-ok parse that still descended into `fmt` (an unrecognized
    // flag) is a usage error (exit 2) — the parser owns flag validation.
    if strings_equal(subcommand(matches), "fmt") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return fmt_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn test [options] [suite...]` — the registered subcommand matched.
    // The variadic `<suite...>` accepts zero tokens, so a bare `sfn test`
    // (and every flag combination) parses ok and dispatches to `test.run`,
    // which defaults an empty suite list to "." and owns its own exit codes
    // (0 pass / 1 test or setup failure / 2 jobs range error). A non-ok parse
    // that still descended into `test` (an unrecognized flag, or a `--jobs`
    // non-integer rejected as `type_error`) is a usage error (exit 2) — the
    // parser owns flag validation.
    if strings_equal(subcommand(matches), "test") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return test_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn check [options] [path...]` — the registered subcommand matched.
    // The variadic `[path...]` accepts zero tokens, so a bare `sfn check`
    // (and every flag combination) parses ok and dispatches to `check.run`,
    // which reconstructs the legacy positional slice and delegates to
    // `handle_check_command` (the body stays in `check/engine.sfn`, reused
    // verbatim — SFEP-0027 §3.4 command #5). A non-ok parse that still
    // descended into `check` (an unrecognized flag) is a usage error (exit 2)
    // — the parser owns flag validation.
    if strings_equal(subcommand(matches), "check") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return check_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn symbols [options]` — the registered subcommand matched. A clean
    // parse dispatches to `symbols.run` (always JSON in v1); a non-ok parse
    // that still descended into `symbols` (e.g. an unrecognized flag) is a
    // usage error (exit 2), matching the other migrated commands.
    if strings_equal(subcommand(matches), "symbols") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return symbols_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn config <command>` — the registered subcommand matched. `config` is
    // the first migrated command with nested subcommands, so
    // `subcommand(result.matches)` returns the *leaf* (e.g. "get") rather
    // than "config"; the dispatch therefore gates on the descent path's root
    // (`subcommand_path[0]`). A clean parse dispatches to `config.run`, which
    // reconstructs the legacy positional slice and delegates to
    // `handle_config_command`. A non-ok parse that descended into `config` is
    // a usage error (exit 2): the `unknown_subcommand` / `unknown_flag` kinds
    // carry a non-empty diagnostic (e.g. `config quantum` → "unknown
    // subcommand 'quantum'", preserving the e2e parity oracle), which
    // `_v2_help_or_usage` prints ahead of the derived help; the
    // `help_requested` kind carries an empty message and is answered with the
    // help alone on exit 0.
    let config_path: string[] = subcommand_path(matches);
    if config_path.length > 0 {
        if strings_equal(config_path[0], "config") {
            if ctx.trace_argv { _v2_trace_argv(argv); }
            if parse_ok { return config_run(matches, ctx); }
            return _v2_help_or_usage(root, matches, parse_err);
        }
    }

    // `sfn cache <command>` — the registered subcommand matched. Like
    // `config`, `cache` has nested subcommands, so
    // `subcommand(result.matches)` returns the *leaf* (e.g. "prune") and the
    // dispatch gates on the descent path's root (`subcommand_path[0]`). A
    // clean parse dispatches to `cache.run`; a non-ok parse that descended
    // into `cache` (an unrecognized flag, a `--max-size` non-integer) is a
    // usage error (exit 2) — the parser owns flag validation. A carried
    // diagnostic (unknown subcommand/flag) is printed ahead of the derived
    // help.
    let cache_path: string[] = subcommand_path(matches);
    if cache_path.length > 0 {
        if strings_equal(cache_path[0], "cache") {
            if ctx.trace_argv { _v2_trace_argv(argv); }
            if parse_ok { return cache_run(matches, ctx); }
            return _v2_help_or_usage(root, matches, parse_err);
        }
    }

    // `sfn toolchain <command>` — nested subcommand, so the dispatch gates on
    // the descent path's root (`subcommand_path[0]`) exactly like
    // `config`/`cache`. A clean parse dispatches to `toolchain.run`; a non-ok
    // parse that descended into `toolchain` (missing `<version>`, unknown
    // leaf) is a usage error (exit 2) — the parser owns argument validation.
    let toolchain_path: string[] = subcommand_path(matches);
    if toolchain_path.length > 0 {
        if strings_equal(toolchain_path[0], "toolchain") {
            if ctx.trace_argv { _v2_trace_argv(argv); }
            if parse_ok { return toolchain_run(matches, ctx); }
            return _v2_help_or_usage(root, matches, parse_err);
        }
    }

    // `sfn capabilities <command>` — SFEP-0051 Phase 4c workspace capability
    // envelope reporting surface, a nested subcommand gated on the descent
    // path's root exactly like `toolchain`/`cache`. A clean parse dispatches
    // to `capabilities.run`; a non-ok parse that descended into
    // `capabilities` (unknown leaf) is a usage error (exit 2).
    let capabilities_path: string[] = subcommand_path(matches);
    if capabilities_path.length > 0 {
        if strings_equal(capabilities_path[0], "capabilities") {
            if ctx.trace_argv { _v2_trace_argv(argv); }
            if parse_ok { return capabilities_run(matches, ctx); }
            return _v2_help_or_usage(root, matches, parse_err);
        }
    }

    // `sfn dev <group>` — maintainer-only nested
    // subcommands (SFEP-0047), gated on the descent path's root exactly like
    // `toolchain`/`config`. A clean parse dispatches to `dev.run`; a non-ok
    // parse that descended into `dev` is a usage error (exit 2).
    let dev_path: string[] = subcommand_path(matches);
    if dev_path.length > 0 {
        if strings_equal(dev_path[0], "dev") {
            if ctx.trace_argv { _v2_trace_argv(argv); }
            if parse_ok { return dev_run(matches, ctx); }
            return _v2_help_or_usage(root, matches, parse_err);
        }
    }

    let mut handled_version: boolean = false;
    if parse_ok {
        // `sfn version` — the registered subcommand matched.
        if strings_equal(subcommand(matches), "version") {
            handled_version = true;
        }
    } else {
        // `sfn version --help` descended into `version` but asks for help,
        // not the version string, so it routes to the shared help handler
        // like every other subcommand rather than printing a version and
        // exiting 0 (SFN-1074).
        if strings_equal(parse_err.kind, "help_requested") {
            if strings_equal(subcommand(matches), "version") {
                if ctx.trace_argv { _v2_trace_argv(argv); }
                return _v2_help_or_usage(root, matches, parse_err);
            }
        }
        // `sfn --version` / `sfn -V` — the built-in version flag.
        if strings_equal(parse_err.kind, "version_requested") {
            handled_version = true;
        }
    }
    if handled_version {
        // Reproduce the legacy cold-path argv trace for the paths v2
        // owns; legacy never runs for these, so without this the
        // `SAILFIN_TRACE_ARGV` toggle would go silent on `version`.
        if ctx.trace_argv { _v2_trace_argv(argv); }
        // SFEP-0073 §3.3 names `version` among the commands selection applies
        // to, so an exact `SAILFIN_TOOLCHAIN` reports the selected compiler
        // rather than the entry. (A `+<version>` query already resolved in the
        // early scan above.) The query stays network-silent: a missing payload
        // prints an install hint and falls through to the entry version.
        // `skip_flag` is true because reporting a version is not running a
        // build — a floor mismatch warns rather than refusing to answer.
        let env_selector = toolchain_env_exact_selector();
        if env_selector.length > 0 && !ctx.selector_resolved {
            let version_rc = toolchain_select_exact(env_selector, "SAILFIN_TOOLCHAIN", "", ctx, true, true);
            if version_rc != 0 { return version_rc; }
        }
        // Dispatch to the `version` command's `run`. On the `--version` /
        // `-V` flag path `parse_ok` is false, but `result.matches` still
        // reflects the accumulated parse state; `version.run` ignores it,
        // so passing it on both paths keeps the dispatch uniform.
        return version_run(matches, ctx);
    }

    // `sfn build [options] [<file.sfn>]` — the registered subcommand matched.
    // A clean parse dispatches to `build.run`, which reproduces the legacy
    // `_legacy_dispatch_build` body against typed matches. A non-ok parse
    // that still descended into `build` (a value flag with no value, an
    // unrecognized flag) is a usage error (exit 2) — the parser owns argument
    // validation.
    if strings_equal(subcommand(matches), "build") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return build_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn run [options] <file.sfn>` — the registered subcommand matched. A
    // clean parse dispatches to `run.run`, which reproduces the legacy
    // `_legacy_dispatch_run` build-then-exec body against typed matches. A
    // non-ok parse that still descended into `run` (an unrecognized flag) is
    // a usage error (exit 2) — the parser owns argument validation. Bare-file
    // dispatch (`sfn foo.sfn`) re-enters here as `["run", foo.sfn]` from the
    // legacy fallthrough.
    if strings_equal(subcommand(matches), "run") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return run_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn bench --compiler [--module M]... [--top N] [--csv PATH]
    // [--budget-time S] [--budget-mem KB]` or `sfn bench --consumer
    // [--fixtures DIR] [--csv PATH]` — the registered subcommand matched. A
    // clean parse dispatches to `bench.run`, which owns the
    // `--compiler`/`--consumer`-mode gate (exit 2 when absent) and its own
    // exit codes (0 clean / 1 module or fixture failures / 2 budget
    // violations). A non-ok parse that still descended into `bench` (an
    // unrecognized flag, a non-integer `--top`/`--budget-time`/
    // `--budget-mem`) is a usage error (exit 2) — the parser owns argument
    // validation.
    if strings_equal(subcommand(matches), "bench") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok { return bench_run(matches, ctx); }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // `sfn completion <shell>` — the registered subcommand matched. Unlike
    // the other subcommands, `run` also receives the root `HelpNode`
    // (`render_help_tree(root)`): the completion generator introspects the
    // whole command tree — the same source `--help --json` renders — not just
    // this command's matches. A clean parse dispatches to `completion.run`
    // (exit 0 / exit 2 on an unsupported shell); a non-ok parse that still
    // descended into `completion` (a missing/surplus positional) is a usage
    // error (exit 2) — the parser owns argument validation.
    if strings_equal(subcommand(matches), "completion") {
        if ctx.trace_argv { _v2_trace_argv(argv); }
        if parse_ok {
            return completion_run(matches, ctx, render_help_tree(root));
        }
        return _v2_help_or_usage(root, matches, parse_err);
    }

    // Fallthrough — every path the registered subcommands above did not
    // claim. SFEP-0027 Phase C (#1797) folded the former
    // `sailfin_cli_main_legacy` shim in here so v2 is the sole dispatch;
    // `ctx` / `args` are the driver prefix and user args already parsed
    // at the top, so no argv re-parse is needed. The four residual
    // behaviors, in the legacy order: empty-args usage, root help,
    // `selfhost`, bare-file dispatch, unknown-command.
    if ctx.trace_argv { _v2_trace_argv(argv); }

    // Bare invocation (no user args after the driver prefix, or empty
    // argv): print usage, exit 2 — matching the legacy `args.length == 0`
    // guard.
    if args.length == 0 {
        print(_usage(root));
        return 2;
    }

    let cmd: string = args[0];

    // Root `-h` / `--help` (no subcommand): print usage, exit 0.
    let mut is_help: boolean = false;
    if strings_equal(cmd, "-h") { is_help = true; }
    if strings_equal(cmd, "--help") { is_help = true; }
    if is_help {
        print(_usage(root));
        return 0;
    }

    // `selfhost` — internal self-host fixed-point validator (#1502).
    // Intentionally absent from `_usage()`: driven by `sfn dev verify` /
    // CI, not end users.
    if strings_equal(cmd, "selfhost") {
        return handle_selfhost_command(args, ctx.binary_dir);
    }

    // Bare-file dispatch: `sfn <file.sfn>` (a single `.sfn` positional,
    // no subcommand) compiles and runs the file, matching the
    // `python script.py` / `node script.js` convention. Re-enters as
    // `["run", <file>]` through `sailfin_cli_main_with_paths` → this
    // dispatch, so `cli/commands/run.sfn` owns the build-then-exec body.
    // The empty `runtime_root` → "runtime" bundle fallback is a
    // filesystem probe (not argv parsing), reproduced from the legacy
    // caller.
    if args.length == 1 && _ends_with(cmd, ".sfn") {
        let mut runtime_root: string = ctx.runtime_root;
        if runtime_root.length == 0 {
            if _runtime_bundle_exists("runtime") { runtime_root = "runtime"; }
        }
        return sailfin_cli_main_with_paths(["run", cmd], runtime_root, ctx.binary_dir, ctx.compiler_path);
    }

    print("unknown command: " + cmd);
    print(_usage(root));
    return 2;
}
