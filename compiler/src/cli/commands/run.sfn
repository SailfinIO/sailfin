// compiler/src/cli/commands/run.sfn
//
// `run` subcommand (CLI modularization epic #1671 / tracker #1675,
// Phase B — SFEP-0027 §3.4, command #7). Migrates `run` off the legacy
// hand-rolled dispatch (`cli_main.sfn`'s inline `_legacy_dispatch_run` —
// no `handle_run_command` existed; the body was entirely inline) into the
// per-command `command_def()` + `run()` pattern that `version.sfn`
// established and `build.sfn` (command #6) extended.
//
// `run` = build-then-exec: it shares the Phase A `compiler/src/build/`
// modules with `build` but has a smaller surface (no `-p`, no `-o`, no
// `--work-dir`, no `--json`, no `--check-determinism`). The hand-rolled
// argv walk becomes typed `sfn/cli` match accessors; the build-then-exec
// body is reproduced verbatim (parity oracles:
// `compiler/tests/e2e/run_cache_flags_test.sfn`,
// `compiler/tests/e2e/run_scratch_isolation_test.sfn`,
// `compiler/tests/e2e/cli_bare_file_dispatch_test.sfn`,
// `compiler/tests/e2e/runtime_implicit_capsule_link_test.sfn`).
//
// Bare-file dispatch (`sfn foo.sfn`) re-invokes `["run", foo.sfn]` from
// `sailfin_cli_main_v2`'s fallthrough (SFEP-0027 Phase C, #1797), which
// routes back through `sailfin_cli_main_v2` to this command — so the
// bare-file path shares this exact body.
//
// The `runtime_root` empty→"runtime" bundle fallback is reproduced from the
// legacy caller (it is a filesystem probe, not argv parsing, so
// `parse_driver_prefix` deliberately does not apply it). `binary_dir` is
// threaded from the driver-parsed `CliContext`, replacing the legacy
// handler's extra param.
import {
    Command,
    Matches,
    arg_variadic,
    command,
    flag,
    has_flag,
    positionals,
    with_arg,
    with_flag
} from "sfn/cli";
import { int_to_string } from "sfn/strings";

import {
    _print_cache_summary,
    _resolve_capsule_build_spec,
    _resolve_sailfin_cache_dir_for_work
} from "../../build/cache";
import {
    CREATE_EXCLUSIVE_CREATED,
    CREATE_EXCLUSIVE_ERROR,
    CREATE_EXCLUSIVE_MODE_EXE,
    _create_exclusive_cmd
} from "../../build/fs";
import { remove_tree } from "../../build/fs_tree";
import { _clang_link_multi } from "../../build/link";
import { _dirname, _ends_with, _ensure_dir } from "../../build/paths";
import { _runtime_bundle_exists } from "../../build/runtime_objs";
import { select_runtime_sfn_sources } from "../../build/runtime_selection";
import { build_target_os, target_exe_name } from "../../build/target";
import { cache_root, merge_cache_stats, resolve_build_cache_config } from "../../build_cache";
import { prepare_project_capsules } from "../../capsule_resolver";
import { workspace_capability_gate } from "../../capsule_resolver/capability";
import { module_name_for_source } from "../../capsule_resolver/identity";
import { ResolverConsumer } from "../../capsule_resolver/types";
import { discover_workspace_root } from "../../capsule_resolver/workspace";
import { format_backend_failure_banner } from "../../ice";
import { compile_to_llvm_file_with_module_imports_and_implicit } from "../../main";
import { runtime_capsule_from_root } from "../../runtime_capsule_resolver";
import { CliContext } from "../context";
import { toolchain_gate_or_dispatch } from "./toolchain";

// The `sfn/cli` definition for `run`, registered on the v2 root via
// `with_subcommand`. Three boolean flags and a variadic positional
// `[file]`; `run` has no value flags (no `-o`/`-p`/`--work-dir`).
fn command_def() -> Command {
    let mut cmd: Command = command("run", "Compile and run a Sailfin source file or the current capsule");
    cmd = with_flag(cmd, flag("no-cache", "Disable the build cache for this invocation"));
    cmd = with_flag(cmd, flag("clean", "Clear the build cache before building"));
    cmd = with_flag(cmd, flag("cache-trace", "Print per-artifact cache hit/miss trace"));
    cmd = with_flag(cmd, flag("skip-toolchain-check", "Bypass the [toolchain] pin check for this invocation"));
    cmd = with_arg(cmd, arg_variadic("file", "Sailfin source file (or prebuilt executable); omit to run the current capsule"));
    return cmd;
}

// SFN-719 / SFN-974: claim a per-invocation exe path so a nested or
// concurrent `sfn run` never targets the same file as another still-running
// one. `monotonic_millis()` seeds the candidate; the claim is what makes it
// unique — `_create_exclusive_cmd` creates the executable's own path
// atomically, so exactly one of two invocations starting in the same
// millisecond can win a given name and the loser advances the ordinal.
//
// Returns an extensionless STEM, not a path, so this invocation's executable
// and its `.ll` cannot disagree about which invocation they belong to
// (SFN-1004). Only the EXE name is claimed: the `.ll` is derived from the
// won stem, so a unique stem makes it unique too.
//
// Returns "" when no name could be claimed. The two ways that happens are
// deliberately not distinguished by the return value — both are fatal to the
// invocation and the caller reports one message.
fn _unique_run_stem(run_cache_dir: string) -> string ![clock, io] {
    let base = run_cache_dir + "/run-" + int_to_string(monotonic_millis());
    let target_os = build_target_os();
    let mut candidate = base;
    let mut attempt: int = 1;
    loop {
        let claim = _create_exclusive_cmd(target_exe_name(candidate, target_os), CREATE_EXCLUSIVE_MODE_EXE);
        if claim == CREATE_EXCLUSIVE_CREATED { return candidate; }
        // A real filesystem fault (unwritable cache dir, missing parent) is
        // not about this name, so advancing the ordinal would just repeat it
        // 1000 times before failing anyway.
        if claim == CREATE_EXCLUSIVE_ERROR { return ""; }
        if attempt > 1000 { return ""; }
        candidate = base + "-" + int_to_string(attempt);
        attempt += 1;
    }
}

// Delete the artifacts this invocation claimed. No-op on the guarded
// (`SAILFIN_TEST_SCRATCH`) branch, which keeps the fixed `run` name and
// claims nothing. The per-invocation link workspace is always disposable;
// `keep_ll` is true only on the link-failure path, where the SFN-34
// backend-failure banner names the top-level IR file.
fn _release_run_stem(claimed: boolean, exe_path: string, ll_path: string, work_dir: string, keep_ll: boolean) -> void ![io] {
    if !claimed { return; }
    if fs.exists(work_dir) { remove_tree(work_dir); }
    if fs.exists(exe_path) { fs.deleteFile(exe_path); }
    if keep_ll { return; }
    if fs.exists(ll_path) { fs.deleteFile(ll_path); }
}

// Reproduce the legacy `_legacy_dispatch_run` body against typed matches.
// Flag reads replace the hand-rolled argv walk; the build-then-exec body is
// verbatim. The `runtime_root` empty→"runtime" fallback is applied here (not
// in `parse_driver_prefix`) because it is a filesystem probe, not argv parsing.
fn run(matches: Matches, ctx: CliContext) -> int ![clock, io, net] {
    let no_cache_flag: boolean = has_flag(matches, "no-cache");
    let clean_flag: boolean = has_flag(matches, "clean");
    let cache_trace_flag: boolean = has_flag(matches, "cache-trace");
    // One positional retains the file/executable form. With no positional,
    // resolve the current capsule's manifest entry — the project workflow
    // created by `sfn init`. More than one positional remains a usage error.
    let _run_positionals: string[] = positionals(matches, "file");
    if _run_positionals.length > 1 {
        print("usage: sfn run [--no-cache] [--clean] [--cache-trace] [<file.sfn>]");
        return 2;
    }
    let mut input_path: string = "";
    if _run_positionals.length == 1 { input_path = _run_positionals[0]; } else {
        if !fs.exists("capsule.toml") {
            print("sfn run: no capsule.toml in the current directory; pass a .sfn file to run");
            return 2;
        }
        let cap_spec = _resolve_capsule_build_spec(".");
        if cap_spec.entry_path.length == 0 { return 1; }
        if cap_spec.kind != "binary" {
            print("sfn run: current capsule has [build].kind = \"" + cap_spec.kind
                + "\"; only binary capsules can be run");
            return 2;
        }
        input_path = cap_spec.entry_path;
    }

    let binary_dir: string = ctx.binary_dir;
    let mut runtime_root: string = ctx.runtime_root;
    if runtime_root.length == 0 {
        if _runtime_bundle_exists("runtime") { runtime_root = "runtime"; }
    }

    // If the argument doesn't look like Sailfin source, treat it as an executable.
    if !_ends_with(input_path, ".sfn") {
        return process.run([input_path]);
    }

    if !fs.exists(input_path) {
        print("file not found: " + input_path);

        return 1;
    }

    let _tc = toolchain_gate_or_dispatch(input_path, ctx, has_flag(matches, "skip-toolchain-check"));
    if _tc != 0 { return _tc; }

    // `run` is a build-then-execute surface and must enforce the same source
    // workspace grant/deny envelope as build and check before any emit/link.
    let capability_workspace_root = discover_workspace_root(_dirname(input_path));
    if workspace_capability_gate(capability_workspace_root) != 0 { return 1; }

    // #1411: route the top-level `run.ll`/`run` executable under the
    // per-invocation scratch when one is set (`SAILFIN_TEST_SCRATCH`),
    // exactly as `sfn build` does. Bare-file dispatch delegates here
    // (`["run", cmd]`), so it inherits this too. Without it, two concurrent
    // `sfn run`/bare-dispatch children in the parallel `sfn test --jobs N`
    // pool both write the fixed `build/sailfin/run` and clobber each other's
    // executable — a test asserting on the run's stdout then sees another
    // fixture's output (non-deterministic, #1411). Empty scratch resolves to
    // `build/sailfin`, keeping the default invocation byte-for-byte.
    let run_cache_dir = _resolve_sailfin_cache_dir_for_work("");
    _ensure_dir(run_cache_dir);

    // Derived name (never an explicit `-o`), so it carries Windows' `.exe`
    // suffix from birth: `CreateProcessA` below and the link's `-o` must
    // agree by construction (SFN-693).
    //
    // SFN-719: the pooled-test path above is already isolated (each
    // `SAILFIN_TEST_SCRATCH` is per-invocation), so the fixed `run` name
    // stays there untouched. Only the unguarded default (`build/sailfin`,
    // shared across every plain-CLI and nested `sfn run`) gets a
    // per-invocation unique name — that's the path where a still-running
    // `.exe` (locked on Windows) or a concurrent invocation can collide
    // with a fixed name.
    //
    // SFN-1004: the `.ll` is derived from the SAME stem, because SFN-719
    // isolated only the executable. A fixed `run.ll` under the unguarded
    // default meant two concurrent invocations still wrote one IR file:
    // each got its own exe, and the second compile clobbered the first's
    // IR mid-flight, so the loser linked corrupted or mismatched input.
    // That is the hazard `.claude/rules/no-bash-e2e.md` records for the
    // pooled path, and it applied here too. Both names now come from one
    // stem so they cannot drift apart.
    //
    // The guarded branch keeps the literal `run`/`run.ll` names it has
    // always had: that path is already per-invocation isolated, and
    // renaming it would churn cache keys for no gain.
    let run_exe_unguarded = env.get("SAILFIN_TEST_SCRATCH").length == 0;
    let mut run_stem = run_cache_dir + "/run";
    let mut run_work_dir = run_cache_dir;
    if run_exe_unguarded {
        run_stem = _unique_run_stem(run_cache_dir);
        if run_stem.length == 0 {
            print.err("sfn run: could not claim a unique executable name under "
                + run_cache_dir);
            return 1;
        }
        // The executable and top-level IR were already unique, but runtime
        // emits, object sidecars, and link inputs still used the shared
        // `build/sailfin` directory. Cold overlapping runs then raced on
        // fixed `*.ll.old` promotion paths and failed before linking their
        // distinct executables. Keep that whole transient surface under the
        // claimed stem as well (SFN-1144).
        run_work_dir = run_stem + ".work";
    }
    let exe_path = target_exe_name(run_stem, build_target_os());
    let ll_path = run_stem + ".ll";

    // Resolve and compile capsule deps before lowering the main file. The
    // unified resolver covers relative imports, manifest-declared capsule
    // deps, and workspace-implicit imports in one pass. CLI overrides
    // (`--no-cache` / `--clean` / `--cache-trace`) layer on top of env-var
    // defaults (`SAILFIN_NO_CACHE` / `SAILFIN_CACHE_TRACE`).
    let run_cache_config = resolve_build_cache_config(no_cache_flag, cache_trace_flag, clean_flag);
    // `sfn run` has no `-p` plumbing yet, so scope/name stay empty:
    // relative-import `.ll`s take the legacy flat layout. `sailfin_exe` /
    // `work_dir` stay empty; threading `binary_dir` lets
    // `prepare_project_capsules` upgrade to subprocess isolation only when
    // the resolved closure is large enough to otherwise OOM. `ctx.compiler_path`
    // (SFN-904) is the running binary's own exact path, threaded as
    // `self_exe` so an isolated-emit child spawns the real file instead of
    // a guessed `<binary_dir>/sfn` that doesn't exist under a renamed build.
    //
    // SFN-341: `runtime_root` IS threaded, unlike the rest of the consumer.
    // `sfn run` links, so it needs the runtime capsule's own `[dependencies]`
    // resolved exactly as `sfn build` does — the runtime's `sfn-sources` are
    // in every binary, so their calls into a capsule provider are emitted
    // here too. The resolver gates that union on `runtime_root`, so passing
    // `empty_resolver_consumer()` silently dropped those definitions from the
    // link set. (`sfn check` keeps the empty consumer on purpose: it never
    // links, so no symbol resolution depends on the runtime's private deps.)
    let run_consumer = ResolverConsumer {
        scope: "",
        name: "",
        walk_project_src: false,
        include_host_as_dep: false,
        runtime_root: runtime_root,
        retain_full_runtime: false
    };
    let run_capsule_result = prepare_project_capsules(input_path, run_cache_config, run_consumer, "", ctx.compiler_path, "", binary_dir);
    if !run_capsule_result.success {
        _release_run_stem(run_exe_unguarded, exe_path, ll_path, run_work_dir, false);
        return 1;
    }
    let capsule_lls = run_capsule_result.ll_paths;

    let source = fs.readFile(input_path);
    let module_name = module_name_for_source(input_path);
    let ok = compile_to_llvm_file_with_module_imports_and_implicit(source, module_name, ll_path, "", run_capsule_result.entry_import_asm_paths, run_capsule_result.implicit_provider_asm_paths);
    if !ok {
        print("failed to compile LLVM for: " + input_path);
        _release_run_stem(run_exe_unguarded, exe_path, ll_path, run_work_dir, false);
        return 1;
    }

    let mut all_lls: string[] = [ll_path];
    let mut rli: int = 0;
    loop {
        if rli >= capsule_lls.length { break; }
        all_lls.push(capsule_lls[rli]);
        rli += 1;
    }
    // Issue #940: same implicit-capsule fallback as `sfn build` (no-op for
    // `-p` / declared-dep, load-bearing for a no-dep `sfn run <file>`).
    let mut run_runtime_caps = run_capsule_result.runtime_capsules;
    if run_runtime_caps.length == 0 {
        // SFN-882: narrow the implicit-capsule fallback, same as `sfn build`.
        run_runtime_caps = select_runtime_sfn_sources(runtime_capsule_from_root(runtime_root), run_capsule_result.runtime_demand);
    }
    // Shared runtime-object cache root (#1096); empty under `--no-cache` to
    // leave the persistent store untouched.
    let mut run_shared_cache_root: string = "";
    if run_cache_config.enabled {
        run_shared_cache_root = cache_root(run_cache_config.capsule_name);
    }
    let link_result = _clang_link_multi(all_lls, exe_path, runtime_root, run_runtime_caps, binary_dir, run_work_dir, run_shared_cache_root);
    let link_rc = link_result.rc;
    if link_rc != 0 {
        // A native link failure is a real compiler/runtime bug to fix at the
        // source — never paper over it. Fail closed with the clang exit code
        // (the prior `process.run(["sfn", "run", input_path])` "seed
        // fallback" recursed into itself forever on a persistent failure,
        // #969). The SFN-34 backend-failure ICE banner is gated on the
        // backend having actually run: a preflight bailout (missing runtime
        // bundle / assembly failure) already printed its own diagnostic, so
        // stacking a "file a compiler bug" frame on it misattributes a
        // config/environment error (SFN-212).
        if link_result.ran_backend {
            print.err(format_backend_failure_banner(binary_dir, "clang link", ll_path, link_rc));
        }
        // `keep_ll = true`: the banner just printed names `ll_path`.
        _release_run_stem(run_exe_unguarded, exe_path, ll_path, run_work_dir, true);
        return link_rc;
    }

    // Keep `sfn run` quiet by default: stdout/stderr should belong to the
    // program unless the user asks for cache telemetry. Runtime object-cache
    // stats still fold in alongside the `.ll` module cache total (#915),
    // gated on `run_cache_config.enabled` so `--no-cache` stays quiet. The
    // summary itself is gated on the resolved `run_cache_config.trace`, so
    // `SAILFIN_CACHE_TRACE=1` layers in exactly like `--cache-trace`.
    let mut run_cache_stats = run_capsule_result.stats;
    if run_cache_config.enabled {
        run_cache_stats = merge_cache_stats(run_capsule_result.stats, link_result.stats);
    }
    if run_cache_config.trace { _print_cache_summary(run_cache_stats); }
    let run_rc = process.run([exe_path]);
    // A spawn failure (e.g. a bare 127) with no binary on disk at the
    // attempted path is a naming/link disagreement, not a program exit —
    // name the exact path so it doesn't read as an opaque 127 (SFN-693).
    if run_rc != 0 && !fs.exists(exe_path) {
        print.err("sfn run: no binary at " + exe_path);
    }
    // SFN-719: `process.run` is synchronous, so by the time it returns
    // THIS invocation's own child has exited and its exe is no longer
    // locked. Delete only this invocation's own path — never a sweep of
    // the shared directory — so the per-invocation naming scheme above
    // doesn't accumulate across repeated `sfn run` calls without ever
    // touching an artifact another live invocation owns. SFN-1004: the
    // `.ll` is per-invocation now too, so it is released alongside the exe
    // rather than left to grow the shared directory without bound.
    _release_run_stem(run_exe_unguarded, exe_path, ll_path, run_work_dir, false);
    return run_rc;
}

export { command_def, run };
