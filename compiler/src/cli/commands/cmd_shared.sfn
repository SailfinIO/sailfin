// compiler/src/cli/commands/cmd_shared.sfn
//
// Cross-command shared helpers relocated out of the deleted
// cli_commands.sfn (SFEP-0027 §3.2, issue #1795): capsule-name/version
// validators, the registry-URL resolution tree, and the path-basename
// helper. Consumed by add / publish / test / config / package command
// modules. Kept compiler-local — do NOT push into a stdlib capsule
// (that is #345's call).
import { _toml_trim_cmd } from "../../build/fs";
import { _get_env_cmd } from "../../build_flags";
import { _string_contains_cmd } from "../../string_cmd_utils";
import { find_char_local, substring } from "../../string_utils";
import { toml_get_string } from "../../toml_parser";
import { user_config_path } from "../../user_config";

// Validate a path segment (scope, name) contains no traversal or illegal chars.
fn _is_safe_capsule_segment_cmd(value: string) -> boolean {
    if value.length == 0 { return false; }
    if strings_equal(value, ".") { return false; }
    if strings_equal(value, "..") { return false; }
    if find_char_local(value, "/", 0) >= 0 { return false; }
    if find_char_local(value, "\\", 0) >= 0 { return false; }
    return true;
}

// Validate a version string contains no traversal sequences.
fn _is_safe_capsule_version_cmd(value: string) -> boolean {
    if value.length == 0 { return false; }
    if strings_equal(value, ".") { return false; }
    if strings_equal(value, "..") { return false; }
    if find_char_local(value, "/", 0) >= 0 { return false; }
    if find_char_local(value, "\\", 0) >= 0 { return false; }
    if _string_contains_cmd(value, "..") { return false; }
    return true;
}

// ═══════════════════════════════════════════════════════════════════
// Registry configuration
// ═══════════════════════════════════════════════════════════════════
//
// Registry URL resolution order (highest priority first):
//   1. SFN_REGISTRY environment variable (one-shot override for CI)
//   2. `[registry] url` in the user config.toml (persisted via `sfn config`;
//      `~/.sfn`, or `SAILFIN_CONFIG_DIR` when set)
//   3. Compiled-in default: https://pkg.sfn.dev
//
// Per-project overrides (e.g. `[registry]` in capsule.toml) are intentionally
// out of scope for now — can be added later without breaking this layering.
fn _default_registry_url_cmd() -> string { return "https://pkg.sfn.dev"; }

fn _strip_trailing_slash_cmd(url: string) -> string {
    let mut end = url.length;
    loop {
        if end == 0 { break; }
        if substring(url, end - 1, end) != "/" { break; }
        end -= 1;
    }
    if end == url.length { return url; }
    return substring(url, 0, end);
}

// Validate a registry URL before persisting or interpolating into shell/TOML.
// Must be http:// or https://, contain no whitespace/control chars, no quotes,
// no shell metacharacters that can escape a single-quoted context.
fn _is_valid_registry_url_cmd(url: string) -> boolean {
    if url.length == 0 { return false; }
    let mut has_http = false;
    if url.length >= 7 {
        if strings_equal(substring(url, 0, 7), "http://") { has_http = true; }
    }
    if url.length >= 8 {
        if strings_equal(substring(url, 0, 8), "https://") { has_http = true; }
    }
    if !has_http { return false; }
    let mut i: int = 0;
    loop {
        if i >= url.length { break; }
        let ch = url[i];
        if ch == " " { return false; }
        if ch == "\t" { return false; }
        if ch == "\r" { return false; }
        if ch == "\n" { return false; }
        if ch == "\"" { return false; }
        if ch == "'" { return false; }
        if ch == "`" { return false; }
        if ch == "$" { return false; }
        if ch == "\\" { return false; }
        if ch == ";" { return false; }
        if ch == "|" { return false; }
        if ch == "&" { return false; }
        if ch == "<" { return false; }
        if ch == ">" { return false; }
        if ch == "(" { return false; }
        if ch == ")" { return false; }
        i += 1;
    }
    return true;
}

fn _config_file_path_cmd() -> string ![io] { return user_config_path(); }

fn _config_registry_url_from_file_cmd() -> string ![io] {
    let path = _config_file_path_cmd();
    if path.length == 0 { return ""; }
    if !fs.exists(path) { return ""; }
    let text = fs.readFile(path);
    return _toml_trim_cmd(toml_get_string(text, "registry", "url"));
}

// Returns resolved registry base URL (no trailing slash). Silently falls back
// to the next source if a source is set but invalid — the config-set path
// already rejects bad URLs, so this only matters for SFN_REGISTRY from the
// environment and hand-edited config files.
fn _resolve_registry_url_cmd() -> string ![io] {
    let env_url = _strip_trailing_slash_cmd(_toml_trim_cmd(_get_env_cmd("SFN_REGISTRY")));
    if env_url.length > 0 {
        if _is_valid_registry_url_cmd(env_url) { return env_url; }
        print.err("warning: SFN_REGISTRY is not a valid http(s) URL; ignoring");
    }
    let file_url = _strip_trailing_slash_cmd(_config_registry_url_from_file_cmd());
    if file_url.length > 0 {
        if _is_valid_registry_url_cmd(file_url) { return file_url; }
        print.err("warning: ~/.sfn/config.toml registry.url is invalid; ignoring");
    }
    return _default_registry_url_cmd();
}

// Last `/`-separated segment of `path`. Returns `""` if the path
// has no segments or ends with `/`.
fn _package_basename(path: string) -> string {
    if path.length == 0 { return ""; }
    let mut last_slash: int = -1;
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if substring(path, i, i + 1) == "/" { last_slash = i; }
        i += 1;
    }
    if last_slash < 0 { return path; }
    if last_slash == path.length - 1 { return ""; }
    return substring(path, last_slash + 1, path.length);
}

// ═══════════════════════════════════════════════════════════════════
// Registry transport
// ═══════════════════════════════════════════════════════════════════
//
// The registry transport reaches the runtime's HTTP primitive through a plain
// `extern fn` rather than by depending on the `sfn/http` capsule (SFN-496).
//
// Declaring `"sfn/http"` in `compiler/capsule.toml` makes that capsule's
// barrel — which exports its own client `get(url: string) -> string ![net]` —
// visible across the whole compiler tree, where it collides on bare name with
// `sfn/cli`'s `get(m: Matches, name: string)` and with `env.get`. Imported
// names are matched without provenance, so the collision resolves to the
// wrong declaration: the effect checker then demands `![net]` from a dozen
// unrelated commands (`E0402` in `completion`, `config`, `dev`, `emit`,
// `login`, `symbols`, `toolchain`), and LLVM lowering emits colliding calls
// with the wrong ABI. The extern reaches the same runtime symbol with no
// capsule dependency and therefore no new names in scope. Collapse this back
// onto `sfn/http`'s typed `fetch` once SFN-893 makes name resolution
// provenance-aware.
//
// The extern carries no effect annotation (externs may not); enforcement
// rides on the `![net]` wrappers below. `sfn_http_request_raw` returns the
// FULL raw response (status line + headers + body) as a caller-owned
// NUL-terminated buffer, or null on a socket/connect/TLS failure.
extern fn sfn_http_request_raw(method: *u8, url: *u8, headers: *u8, body: *u8) -> *u8;

// Status code and body of a registry HTTP call. `status` is 0 when the
// request never reached the server (connect/socket failure).
struct RegistryResponse {
    status: int;
    body: string;
}

// Drop a single trailing CR, so a CRLF-delimited line compares as its text.
fn _registry_strip_cr_cmd(line: string) -> string {
    let n = line.length;
    if n == 0 { return line; }
    if substring(line, n - 1, n) != "\r" { return line; }
    return substring(line, 0, n - 1);
}

// Leading run of ASCII digits as an int; 0 when there are none.
fn _registry_parse_int_cmd(s: string) -> int {
    let mut value: int = 0;
    let mut i: int = 0;
    loop {
        if i >= s.length { break; }
        let code = char_code(substring(s, i, i + 1));
        if code < 48 { break; }
        if code > 57 { break; }
        value = value * 10 + (code - 48);
        i += 1;
    }
    return value;
}

// Status code and body out of a raw HTTP/1.1 response. Mirrors the status and
// body halves of `sfn/http`'s `parse_response`; the header lines are walked
// only to find the blank line that starts the body, since no caller here reads
// response headers.
fn _registry_parse_response_cmd(raw: string) -> RegistryResponse {
    let total = raw.length;
    if total == 0 {
        return RegistryResponse { status: 0, body: "" };
    }

    let line_nl = find_char_local(raw, "\n", 0);
    let mut line_end = total;
    if line_nl >= 0 { line_end = line_nl; }
    let status_line = _registry_strip_cr_cmd(substring(raw, 0, line_end));

    // "HTTP/1.1 <code> <reason>" — the code is the token after the first space.
    let mut status: int = 0;
    let sp1 = find_char_local(status_line, " ", 0);
    if sp1 >= 0 {
        let sp2 = find_char_local(status_line, " ", sp1 + 1);
        let mut code_end = status_line.length;
        if sp2 >= 0 { code_end = sp2; }
        status = _registry_parse_int_cmd(substring(status_line, sp1 + 1, code_end));
    }

    let mut body: string = "";
    let mut cursor = total;
    if line_nl >= 0 { cursor = line_nl + 1; }
    loop {
        if cursor >= total { break; }
        let nl = find_char_local(raw, "\n", cursor);
        let mut end = total;
        if nl >= 0 { end = nl; }
        let line = _registry_strip_cr_cmd(substring(raw, cursor, end));
        let mut next = total;
        if nl >= 0 { next = nl + 1; }
        if line.length == 0 {
            body = substring(raw, next, total);
            break;
        }
        if nl < 0 { break; }
        cursor = next;
    }
    return RegistryResponse { status: status, body: body };
}

// Perform `method url` with `headers` ("Name: value" lines) and `body`. The
// runtime owns the Host / Content-Length / Connection framing.
fn _registry_request_cmd(method: string, url: string, headers: string[], body: string) -> RegistryResponse ![net] {
    let mut headers_blob: string = "";
    let mut i: int = 0;
    loop {
        if i >= headers.length { break; }
        headers_blob = headers_blob + headers[i] + "\r\n";
        i += 1;
    }
    let raw_ptr = sfn_http_request_raw(method as *u8, url as *u8, headers_blob as *u8, body as *u8);
    if raw_ptr as i64 == 0 {
        // Connect/socket failure — surface status 0 rather than dereferencing
        // a null buffer as a string.
        return RegistryResponse { status: 0, body: "" };
    }
    return _registry_parse_response_cmd(raw_ptr as string);
}

// GET `url` and return the response body, or "" on any transport failure or
// a non-2xx status. The status gate preserves the fail-closed semantics the
// pre-SFN-496 shelled fetch had (`-f`): a 4xx/5xx index fetch is a miss, not
// a body.
fn _registry_get_cmd(url: string) -> string ![net] {
    let resp = _registry_request_cmd("GET", url, [], "");
    if resp.status < 200 { return ""; }
    if resp.status >= 300 { return ""; }
    return resp.body;
}

// POST `json_body` to `url` with a bearer `auth_header`, returning the raw
// status and body so the caller can distinguish "unreachable" (status 0) from
// a server-side rejection.
fn _registry_post_json_cmd(url: string, auth_header: string, json_body: string) -> RegistryResponse ![net] {
    return _registry_request_cmd("POST", url, ["Content-Type: application/json", "Authorization: "
        + auth_header], json_body);
}

export {
    _is_safe_capsule_segment_cmd,
    _is_safe_capsule_version_cmd,
    _resolve_registry_url_cmd,
    _package_basename,
    _strip_trailing_slash_cmd,
    _is_valid_registry_url_cmd,
    RegistryResponse,
    _registry_get_cmd,
    _registry_post_json_cmd
};
