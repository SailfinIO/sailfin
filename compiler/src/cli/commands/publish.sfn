// compiler/src/cli/commands/publish.sfn
//
// `publish` subcommand (CLI modularization epic #351, Issue 3.9 — proposal
// §5 Phase 3 item 9, §7). Migrates `sfn publish` off the legacy
// `cli_commands` handler onto the per-command `command_def()`/`run()`
// pattern established by Issue 2.4 (`version`) and exercised by Issues 3.1
// (`init`), 3.2 (`login`), 3.3 (`guillermo`), and 3.5 (`add`).
//
// `publish` takes a single optional positional `[path]` — the capsule
// directory to publish, defaulting to `.` (the current directory). `run`
// reproduces the legacy handler: the same token resolution (`SFN_TOKEN` env
// then `~/.sfn/credentials`), the same packaging, the same registry upload,
// and every message and exit code, plus the private-capsule gate below:
//   - 0 — published (server response printed).
//   - 1 — no `capsule.toml`, missing name/version, a private capsule or an
//         invalid `[capsule] publish` value (SFEP-0020 §3.6), no token,
//         temp-file / digest / payload failure, or a non-2xx / unreachable
//         registry.
// The usage error (2) for an extra positional (`sfn publish a b c`) is
// enforced by the v2 dispatch in `cli/main.sfn`: a second positional makes
// the parse non-ok while still marking `publish` as descended, and the
// dispatch returns 2 there — the parser owns argument validation, matching
// the legacy `args.length > 2` guard.
//
// The optional `[path]` uses an empty-string default rather than a sentinel
// (cf. `login.sfn`): the legacy handler treated an absent path and an
// explicit empty path identically (both leave `capsule_dir == ""`), so
// `get(matches, "path")` returning "" on either route preserves behavior
// without distinguishing the two cases.
//
// Exit codes are integer literals, not the `sfn/cli` `EXIT_*` constants:
// those are module-level `let` constants with no cross-capsule import value
// path today (see the `init.sfn` note), so they lower to 0 in the importing
// module — `publish` needs 1, so it uses literals to return it correctly.
//
// The registry helper `_resolve_registry_url_cmd` now lives in the shared
// `cli/commands/cmd_shared.sfn` module (relocated from the deleted
// `cli_commands.sfn` in #1795, SFEP-0027 §3.2); the crypto/collection
// helpers (`_collect_sfn_files_cmd`, `_sha256_of_file`, …) live in the
// backend-shared `build/fs.sfn` module and are imported from there.
import {
    Command,
    Matches,
    arg_optional,
    command,
    get,
    with_arg,
    with_usage
} from "sfn/cli";
import { base64_encode } from "sfn/crypto";
import { int_to_string } from "sfn/strings";

import {
    _collect_sfn_files_cmd,
    _mktemp_from_template_cmd,
    _sha256_of_file,
    _toml_trim_cmd
} from "../../build/fs";
import { _get_env_cmd, _get_home_cmd } from "../../build_flags";
import { substring } from "../../string_utils";
import { toml_get_name, toml_get_publish, toml_get_version } from "../../toml_parser";
import { CliContext } from "../context";
import { _registry_post_json_cmd, _resolve_registry_url_cmd } from "./cmd_shared";

// The `sfn/cli` definition for `publish`, registered on the v2 root via
// `with_subcommand`. A single optional `[path]` positional; no flags.
fn command_def() -> Command {
    return with_usage(with_arg(command("publish", "Publish a capsule to the registry"), arg_optional("path", "Capsule directory to publish (defaults to .)", "")), "packages", "sfn publish [path]", "publish a capsule");
}

// Package the capsule at `[path]` (or the current directory) and upload it
// to the registry, authenticating with the token from `SFN_TOKEN` or
// `~/.sfn/credentials`. Identical to the legacy `publish` command-handler body
// apart from the private-capsule gate (SFEP-0020 §3.6), which runs before the
// token lookup. `ctx` is part of the per-command contract but unused here.
fn run(matches: Matches, ctx: CliContext) -> int ![io, net] {
    let mut capsule_dir: string = get(matches, "path");
    if capsule_dir.length > 0 {
        if substring(capsule_dir, capsule_dir.length - 1, capsule_dir.length) == "/" {
            capsule_dir = substring(capsule_dir, 0, capsule_dir.length - 1);
        }
    }
    let mut toml_path: string = "capsule.toml";
    let mut src_dir: string = "src";
    if capsule_dir.length > 0 {
        toml_path = capsule_dir + "/capsule.toml";
        src_dir = capsule_dir + "/src";
    }
    if !fs.exists(toml_path) {
        print.err("no capsule.toml found — run `sfn init` first");
        return 1;
    }
    let toml_text = fs.readFile(toml_path);
    let pkg_name = toml_get_name(toml_text);
    let pkg_version = toml_get_version(toml_text);
    if pkg_name.length == 0 {
        print.err("capsule.toml: missing capsule name");
        return 1;
    }
    if pkg_version.length == 0 {
        print.err("capsule.toml: missing capsule version");
        return 1;
    }

    // SFEP-0020 §3.6: `[capsule] publish = false` is the private-capsule
    // distribution boundary. The gate sits here deliberately — after the
    // manifest yields the capsule name the diagnostic must report, and before
    // credential discovery, packaging, and the registry upload. Reading the
    // manifest above is itself a filesystem read, so the guarantee is not
    // "before any side effect" but the narrower one that matters: a private
    // capsule produces no package artifact, no credential access, and no
    // network traffic. The gate reads only the manifest text already in scope,
    // so an explicit `[path]`, current-directory discovery, and an
    // `SFN_REGISTRY` override all reach it identically.
    // An invalid value carries no policy (SFN-707), so it is rejected rather
    // than coerced to either boolean. `E0612` is the code SFEP-0002 §3.7
    // allocates for this refusal; it is emitted as a message prefix because
    // every diagnostic in this command is a plain `print.err` + non-zero
    // return (SFN-732), not a rendered `Diagnostic`.
    let publish_policy = toml_get_publish(toml_text);
    if publish_policy.error.length > 0 {
        print.err(toml_path + ": " + publish_policy.error);
        return 1;
    }
    // Fail closed on an unresolved policy. `toml_get_publish` pairs a null
    // `publish` with a non-empty `error` today, so the branch below is
    // unreachable — but this is a distribution boundary reached across a module
    // edge, and permitting publication for a policy that did not resolve is the
    // wrong default if that pairing ever changes.
    if publish_policy.publish == null {
        print.err(toml_path + ": could not resolve the [capsule] publish policy");
        return 1;
    }
    let publish_allowed: boolean = publish_policy.publish;
    if !publish_allowed {
        print.err("E0612: " + pkg_name + ": " + toml_path
            + " sets [capsule] publish = false — this capsule is private and cannot be published");
        return 1;
    }

    let mut token: string = "";
    let env_token = _get_env_cmd("SFN_TOKEN");
    if env_token.length > 0 { token = env_token; } else {
        let home = _get_home_cmd();
        if home.length > 0 {
            let cred_path = home + "/.sfn/credentials";
            if fs.exists(cred_path) {
                let cred = fs.readFile(cred_path);
                token = _toml_trim_cmd(cred);
            }
        }
    }
    if token.length == 0 {
        print.err("no auth token found — set SFN_TOKEN or create ~/.sfn/credentials");
        return 1;
    }

    print("packaging " + pkg_name + "@" + pkg_version + "...");
    let mut payload: string = "SFNPKG/1\n";
    payload = payload + "--- path: capsule.toml\n" + toml_text + "\n";

    let src_files = _collect_sfn_files_cmd(src_dir, 10);
    let mut fi: int = 0;
    loop {
        if fi >= src_files.length { break; }
        let file_path = src_files[fi];
        let content = fs.readFile(file_path);
        let mut rel_path: string = file_path;
        if capsule_dir.length > 0 {
            rel_path = substring(file_path, capsule_dir.length + 1, file_path.length);
        }
        payload = payload + "--- path: " + rel_path + "\n" + content + "\n";
        fi += 1;
    }

    let payload_tmp = _mktemp_from_template_cmd("/tmp/.sfn_pub_XXXXXX");
    if payload_tmp.length == 0 {
        print.err("failed to create temp file");
        return 1;
    }
    fs.writeFile(payload_tmp, payload);
    let raw_digest = _sha256_of_file(payload_tmp);
    if raw_digest.length == 0 {
        print.err("failed to compute digest");
        fs.deleteFile(payload_tmp);
        return 1;
    }
    let digest = "sha256:" + raw_digest;

    // `sfn/crypto`'s `base64_encode` rather than the `base64.encode`
    // intrinsic: the intrinsic lowers to this same capsule symbol but creates
    // no import edge, so demand-driven staging never emits the definition and
    // the compiler link fails on an undefined
    // `base64_encode__capsules__sfn__crypto__src__mod` (SFN-496).
    let content_b64 = base64_encode(payload);
    let json_body = "{\"type\":\"capsule\",\"capsule\":\"" + pkg_name
        + "\",\"version\":\""
        + pkg_version
        + "\",\"digest\":\""
        + digest
        + "\",\"content_b64\":\""
        + content_b64
        + "\",\"meta\":{}}";

    let auth_header = "Bearer " + token;
    let registry_base = _resolve_registry_url_cmd();
    let registry_url = registry_base + "/api/publish";
    print("publishing to " + registry_url + "...");
    let resp = _registry_post_json_cmd(registry_url, auth_header, json_body);
    fs.deleteFile(payload_tmp);
    let response = _toml_trim_cmd(resp.body);
    if resp.status == 0 {
        print.err("publish failed — could not reach registry");
        if response.length > 0 { print.err("server: " + response); }
        return 1;
    }
    if resp.status < 200 || resp.status >= 300 {
        print.err("publish failed (HTTP " + int_to_string(resp.status) + ")");
        if response.length > 0 { print.err("server: " + response); }
        return 1;
    }
    print(response);
    return 0;
}
