// compiler/src/cli/commands/login.sfn
//
// `login` subcommand (CLI modularization epic #351, Issue 3.2 — proposal
// §5 Phase 3 item 2, §7). Migrates `sfn login` off the legacy
// `cli_commands` handler onto the per-command `command_def()`/`run()`
// pattern established by Issue 2.4 (`version`) and exercised by Issues 3.1
// (`init`) / 3.3 (`guillermo`).
//
// `login` takes a single optional positional `[token]`. When present it is
// the registry token; when absent, `run` prompts and reads the token from
// stdin exactly as the legacy handler did. The credential store
// (`credentials` in the user config directory — `~/.sfn`, or
// `SAILFIN_CONFIG_DIR` when set), the 0o700/0o600 permission handling, and the
// write-back verification are preserved, as are the exit codes below.
// Messages match the legacy handler except that immediate stdin EOF now
// reports "failed to read token" (SFN-154 made EOF distinguishable from a
// blank line):
//   - 0 — credentials written and verified.
//   - 1 — empty token, no home directory, or a failed write.
//
// That permission handling is POSIX-only (SFN-888). It is `fs.set_perms`
// via `_set_perms_or_skip` rather than a `chmod` spawn, and on a Windows
// host it short-circuits to success because `_chmod` there honours only
// the read-only attribute — 0o600 is inexpressible, so the
// credential file is NOT access-restricted on that host. `run` prints
// a notice saying so after the write rather than leaving the degradation
// silent. Removal condition: SFN-884 restricts the file via an NTFS ACL,
// and its PR deletes the notice and this paragraph together.
//
// The usage error (2) for extra positionals is enforced by the v2 dispatch
// in `cli/main.sfn`: a second positional makes the parse non-ok while
// marking `login` as descended, and the dispatch returns 2 there — the
// parser owns argument validation, matching the legacy `args.length > 2`
// guard.
//
// `get(matches, "token")` returns the Arg's `default_value` when the
// positional is absent and "" when it is present-but-empty (`sfn login ""`);
// the parser records both as a single "token" positional and cannot
// otherwise tell them apart. The legacy handler split on `args.length`
// (absent → prompt; any supplied token, even "", → use it directly), so the
// default is a sentinel no shell-passed argv token can match: a truly absent
// token routes to the interactive stdin prompt, while an explicit empty
// token falls through to the "empty token" error WITHOUT reading stdin.
// (Reading stdin on `sfn login ""` would also hang the parallel test pool,
// whose pooled children do not see stdin EOF.)
//
// Exit codes are integer literals, not the `sfn/cli` `EXIT_*` constants:
// those are module-level `let` constants with no cross-capsule import value
// path today (see the `init.sfn` note), so they lower to 0 in the importing
// module — `login` needs 1, so it uses literals to return it correctly.
import { Diagnostic, diagnostic_to_diag } from "sfn/analyzer/typecheck_types";
import {
    Command,
    Matches,
    arg_optional,
    command,
    get,
    with_arg,
    with_usage
} from "sfn/cli";

import { _ensure_dir_recursive_cmd, _set_perms_or_skip, _toml_trim_cmd } from "../../build/fs";
import { host_is_windows } from "../../build/target";
import { render_terminal_diagnostic } from "../../terminal_output";
import {
    user_config_credentials_path,
    user_config_dir,
    user_config_dir_is_default
} from "../../user_config";
import { CliContext } from "../context";

// E0616: `env.home` exhausted its `HOME` -> `USERPROFILE` ->
// `HOMEDRIVE`+`HOMEPATH` ladder (`runtime/sfn/io.sfn`) and every rung was
// unset/empty. No source span — this is a process-environment condition,
// not a `.sfn` file — so `primary` is null, matching `_unsupported_target_diagnostic`
// (`cli/commands/build.sfn`).
fn _home_dir_diagnostic() -> Diagnostic {
    return Diagnostic {
        code: "E0616",
        severity: "error",
        message: "could not determine home directory (HOME, USERPROFILE, and HOMEDRIVE+HOMEPATH are all unset)",
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// Sentinel `default_value` for the optional `[token]` positional, returned
// by `get(matches, "token")` only when no token was supplied on the command
// line. The control-char wrapping makes it unmatchable by any real argv
// token, so `run` can tell an absent token (→ prompt) from an explicit empty
// one (`sfn login ""` → "empty token" error). A function (not a top-level
// `let`) so the literal is read through a definite value path in both the
// builder and `run` (see the `init.sfn` note on module-level constants).
fn _token_absent_sentinel() -> string {
    return "\t\t__sfn_login_token_absent__\t\t";
}

// The `sfn/cli` definition for `login`, registered on the v2 root via
// `with_subcommand`. A single optional `[token]` positional; no flags.
fn command_def() -> Command {
    return with_usage(with_arg(command("login", "Save a registry token to the user config directory"), arg_optional("token", "Registry token (read from stdin when omitted)", _token_absent_sentinel())), "packages", "sfn login [token]", "authenticate to a registry");
}

// Save a registry token to `credentials` in the user config directory
// (`~/.sfn`, or `SAILFIN_CONFIG_DIR` when set). With a `token` positional
// the value is used directly; without one, prompt and read a single line
// from stdin via `io.read_line(0)` (SFN-154), replacing the legacy `head -1`
// shellout. `ctx` is part of the per-command contract but unused here. Exit
// codes and side effects match the legacy handler; the only message change
// is the immediate-EOF path (see the header note).
fn run(matches: Matches, ctx: CliContext) -> int ![io] {
    let token_arg = get(matches, "token");
    let mut token: string = "";
    if !strings_equal(token_arg, _token_absent_sentinel()) {
        // A token was supplied on the command line (possibly empty) — use it
        // directly, exactly as the legacy `args.length == 2` branch did.
        token = _toml_trim_cmd(token_arg);
    } else {
        print("enter your registry token:");
        // Read a single line from fd 0. `io.read_line(0) -> string?` returns
        // `null` on immediate EOF (no input at all) or an allocation failure;
        // a blank line is `Some("")`, which falls through to the "empty token"
        // guard below — matching the legacy `head -1` behaviour without the
        // mktemp/rm shellout.
        let line = io.read_line(0);
        if line != null { token = _toml_trim_cmd(line); } else {
            print.err("error: failed to read token");
            return 1;
        }
    }

    if token.length == 0 {
        print.err("error: empty token");
        return 1;
    }

    let sfn_dir = user_config_dir();
    if sfn_dir.length == 0 {
        let empty_lines: string[] = [];
        print.err(render_terminal_diagnostic(diagnostic_to_diag(_home_dir_diagnostic(), "login"), empty_lines, "login"));
        return 1;
    }

    // 0o700 on the directory, but only where sfn owns it: its own `~/.sfn`
    // (maintaining that mode is why `config_test.sfn`'s permission case
    // exists), or a relocated directory this command just created.
    // `SAILFIN_CONFIG_DIR` can otherwise name a directory sfn does not own —
    // `~/.config`, a shared team path — where narrowing the mode is overreach,
    // and where a directory owned by another user fails the chmod outright,
    // breaking a command that need not touch the mode at all (SFN-1258).
    let created = !fs.exists(sfn_dir);
    _ensure_dir_recursive_cmd(sfn_dir);
    if created || user_config_dir_is_default() {
        _set_perms_or_skip(sfn_dir, 448);
    }

    // 0o600 on the file is the restriction that actually protects the token,
    // so unlike the directory it is enforced on every write and its failure is
    // fatal. Reporting "credentials saved" over a file whose mode could not be
    // set would hand the user a false assurance (SFN-1258).
    let cred_path = user_config_credentials_path();
    fs.writeFile(cred_path, token);
    if !_set_perms_or_skip(cred_path, 384) {
        print.err("error: failed to restrict permissions on " + cred_path);
        return 1;
    }

    if !fs.exists(cred_path) {
        print.err("error: failed to write credentials to " + cred_path);
        return 1;
    }
    let saved = fs.readFile(cred_path);
    if !strings_equal(_toml_trim_cmd(saved), token) {
        print.err("error: failed to write credentials to " + cred_path);
        return 1;
    }

    print("credentials saved to " + cred_path);
    // The credential file is not access-restricted on a Windows host:
    // `_set_perms_or_skip` short-circuits there because `_chmod` honours
    // only the read-only attribute, so 0o600 is inexpressible. Disclose it
    // in command output — a source comment is not disclosure. Deleted by
    // SFN-884, which restricts the file via an NTFS ACL.
    if host_is_windows() {
        print("note: this file is NOT access-restricted on Windows");
        print("      (NTFS ACL support tracked in SFN-884)");
    }
    return 0;
}
