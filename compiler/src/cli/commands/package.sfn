// compiler/src/cli/commands/package.sfn
//
// `package` subcommand (CLI modularization epic #1671 / tracker #1675,
// Phase B — SFEP-0027 §3.4, command #3). Migrates `package` off the
// legacy hand-rolled dispatch (`cli_main.sfn`) into the per-command
// `command_def()` + `run()` pattern that `version.sfn` established and
// `lock.sfn` (command #2) extended.
//
// `run` reconstructs the legacy positional args slice and delegates to
// `handle_package_command` **verbatim** — output and exit codes are
// byte-identical to today (parity oracle:
// `compiler/tests/e2e/sfn_package_test.sfn`). The `--installer` / `-p`
// mutual-exclusion stays inside `handle_package_command` and is
// preserved automatically by delegation. That body now lives in this
// module, relocated from the deleted `cli_commands.sfn` (#1795,
// SFEP-0027 §3.2).
//
// A missing value for a value flag, an unrecognized flag, or `--help`
// makes the parse non-ok while still marking `package` as descended;
// the v2 dispatch in `cli/main.sfn` returns the usage error (exit 2)
// there — the parser owns argument validation.
import {
    CreateOptions,
    DeflateOptions,
    DeflateStrategy,
    LinkPolicy,
    targz_create
} from "sfn/archive";
import {
    Command,
    Matches,
    command,
    flag,
    flag_value,
    flag_value_short,
    get_or,
    has_flag,
    with_flag,
    with_usage
} from "sfn/cli";
import { int_to_string } from "sfn/strings";

import {
    _copy_file_preserving_mode,
    _file_size_of,
    _sha256_of_file,
    _shell_read_cmd
} from "../../build/fs";
import { copy_tree, ensure_dir_p, remove_tree } from "../../build/fs_tree";
import {
    build_host_os,
    host_exe_name,
    host_is_windows,
    target_exe_name,
    triple_target_os
} from "../../build/target";
import { is_safe_scope_name, parse_scope_name } from "../../capsule_artifact";
import { DistManifest, dist_manifest_to_json, empty_dist_manifest } from "../../dist_manifest";
import { compiler_manifest_from_workspace, stage_installer_workspace_assets } from "../../installer_staging";
import { index_of, substring } from "../../string_utils";
import { toml_get_name, toml_get_version } from "../../toml_parser";
import { CliContext } from "../context";
import { _is_safe_capsule_version_cmd, _package_basename } from "./cmd_shared";

// ---- sfn package (Stage C4) ----
//
// Produce a distributable tarball + sha256 sidecar + JSON manifest
// describing a built artifact.  Replaces `tools/package.sh`.
//
// Usage:
//   sfn package [--target T] [--out DIR] [--compiler-bin PATH] [-p <capsule-path>]
//
// Without `-p`: packages the compiler. Resolves the `sfn/compiler`
// workspace member for its version (the compiler has no per-capsule
// sidecar). Default `--compiler-bin = build/bin/sfn`. Tarball stem
// `sailfin-native-<target>-<version>`.
//
// With `-p <path>`: packages a user capsule. Reads the C2c sidecar at
// `<path>/build/capsules/<scope>/<name>/manifest.json` (must exist —
// run `sfn build -p <path>` first). Tarball stem
// `<sanitized-name>-<target>-<version>`.
//
// Output: `<out>/<stem>.tar.gz`, `<stem>.tar.gz.sha256`,
// `<stem>.manifest.json`. Outputs match `tools/package.sh`'s shape
// except the manifest is now schema-versioned (see `dist_manifest.sfn`).
//
// Staging is minted per invocation: the root honours
// `SAILFIN_TEST_SCRATCH` (falling back to `build/sailfin`) and the leaf
// is a fresh `fs.mkdtemp` directory. The original fixed
// `build/sailfin/.package-staging` literal was wiped on entry and exit,
// which was sound while packaging was release-only but became a
// cross-invocation hazard once pooled e2e tests began driving
// `sfn package` concurrently: one run's entry wipe deleted another's
// staged tree mid-flight (SFN-983).
//
// A hard crash — or an exit wipe that fails, since those discard their
// result — now leaks a staging directory rather than self-healing on the
// next run. That is deliberate: sweeping stale siblings on entry would
// reintroduce the exact deletion hazard this removes, because nothing
// distinguishes a stale directory from a live concurrent one.
// `build/sailfin` is build output; `sfn dev clean build` reclaims it.
//
// Does NOT auto-rebuild — run `sfn dev bootstrap build` (or `sfn build
// -p <path>`) first. Auto-rebuilding from inside the packaging command
// is a bootstrapping smell (the compiler would be rebuilding itself
// before packaging itself).
// SFN-973: the manifest `build_date` used to shell out to `date -u`
// (`_shell_read_cmd`), which does not exist on native Windows. The
// wall-clock epoch (`runtime_unix_millis_fn` — SFN-623) and ISO-8601
// formatting below replace that shell-out with a pure computation.
// Floor division: Sailfin `/` truncates toward zero (LLVM `sdiv`), so a
// negative dividend needs this correction to floor instead. Mirrors
// `capsules/sfn/crypto/src/der.sfn::_floor_div`, duplicated locally
// because that helper is module-private and `sfn/crypto`'s public
// surface doesn't need to grow for one caller.
fn _floor_div(a: int, b: int) -> int {
    let q: int = a / b;
    let r: int = a - q * b;
    if r != 0 && ((r < 0) != (b < 0)) { return q - 1; }
    return q;
}

struct CivilDate {
    year: int;
    month: int;
    day: int;
}

// Inverse of `capsules/sfn/crypto/src/der.sfn::der_days_from_civil` —
// Howard Hinnant's `civil_from_days`: exact integer arithmetic, no
// floating point, no lookup table. `days` is the signed day count
// since 1970-01-01 (proleptic Gregorian); negative values (pre-1970)
// require floor division throughout, which is why `era` uses
// `_floor_div` rather than plain `/`.
fn civil_from_days(days: int) -> CivilDate {
    let z: int = days + 719468;
    let era: int = _floor_div(z, 146097);
    let doe: int = z - era * 146097;  // [0, 146096]
    let yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;  // [0, 399]
    let y: int = yoe + era * 400;
    let doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100);  // [0, 365]
    let mp: int = (5 * doy + 2) / 153;  // [0, 11]
    let d: int = doy - (153 * mp + 2) / 5 + 1;  // [1, 31]
    let mut m: int = mp + 3;
    if mp >= 10 { m = mp - 9; }
    let mut year: int = y;
    if m <= 2 { year += 1; }
    return CivilDate { year: year, month: m, day: d };
}

fn _pad2(n: int) -> string {
    if n < 10 { return "0" + int_to_string(n); }
    return int_to_string(n);
}

fn _pad4(n: int) -> string {
    if n < 10 { return "000" + int_to_string(n); }
    if n < 100 { return "00" + int_to_string(n); }
    if n < 1000 { return "0" + int_to_string(n); }
    return int_to_string(n);
}

// Format signed epoch milliseconds as `YYYY-MM-DDTHH:MM:SSZ`.
// Milliseconds are truncated, not rounded, and not emitted. Pure (no
// effects) so it is directly unit-testable without a clock — see
// `compiler/tests/unit/package_iso8601_test.sfn`.
fn _iso8601_utc_from_unix_millis(millis: int) -> string {
    let seconds: int = _floor_div(millis, 1000);
    let days: int = _floor_div(seconds, 86400);
    let sec_of_day: int = seconds - days * 86400;  // [0, 86399]
    let hour: int = sec_of_day / 3600;
    let minute: int = (sec_of_day - hour * 3600) / 60;
    let sec: int = sec_of_day - hour * 3600 - minute * 60;
    let civil: CivilDate = civil_from_days(days);
    return _pad4(civil.year) + "-" + _pad2(civil.month) + "-" + _pad2(civil.day)
        + "T"
        + _pad2(hour)
        + ":"
        + _pad2(minute)
        + ":"
        + _pad2(sec)
        + "Z";
}

// Read the realtime wall clock and format it as ISO-8601 UTC, replacing
// the `date -u` shell-out this module used before SFN-973 (does not
// exist on native Windows). Mirrors `stdlib/time/src/mod.sfn`'s
// `unix_millis()`: `runtime_unix_millis_fn` is the internal
// status/out-pointer target for `sfn_clock_unix_millis`
// (`runtime/sfn/clock.sfn`), recognized as a bare builtin by the effect
// checker (`compiler/capsules/analyzer/src/effect_checker/collector.sfn`)
// independent of which module calls it. A failed clock read must not be
// swallowed into a silent empty `build_date` — that is the exact bug
// this issue exists to fix, just triggered by a different provider
// failure than the Windows `date -u` shell-out — so this returns
// `Result<string, string>` (`.claude/rules/code-style.md`: new internal
// fallible code returns `Result<T, E>`) rather than a sentinel, matching
// `_unix_millis_result` (same file as above). The out-param is read
// through `sailfin_intrinsic_pointer_read_i64`, not the bare local: the
// runtime writes the result via `memcpy` through the pointer
// (`runtime/sfn/clock.sfn:163`), so reading the local directly would
// rely on the compiler knowing it was mutated through an alias.
fn _package_build_date() -> Result<string, string> ![clock] {
    let mut epoch_ms: i64 = 0;
    let out: *i64 = & epoch_ms;
    let status: i32 = runtime_unix_millis_fn(out);
    if status != 1 {
        return Result.Err {
            error: "sfn package: realtime clock provider failed"
        };
    }
    let value: i64 = sailfin_intrinsic_pointer_read_i64(out);
    return Result.Ok { value: _iso8601_utc_from_unix_millis(value as int) };
}

fn handle_package_command(args: string[]) -> int ![clock, io] {
    // Parse args.
    let mut target_arg: string = "";
    let mut out_dir: string = "dist";
    let mut compiler_bin: string = host_exe_name("build/bin/sfn");
    let mut capsule_path: string = "";
    let mut installer_mode: boolean = false;
    let mut argi: int = 1;
    loop {
        if argi >= args.length { break; }
        let a = args[argi];
        if strings_equal(a, "--target") {
            if argi + 1 >= args.length {
                print.err("sfn package: --target requires a value");
                return 2;
            }
            target_arg = args[argi + 1];
            argi += 2;
            continue;
        }
        if strings_equal(a, "--out") {
            if argi + 1 >= args.length {
                print.err("sfn package: --out requires a directory");
                return 2;
            }
            out_dir = args[argi + 1];
            argi += 2;
            continue;
        }
        if strings_equal(a, "--compiler-bin") {
            if argi + 1 >= args.length {
                print.err("sfn package: --compiler-bin requires a path");
                return 2;
            }
            compiler_bin = args[argi + 1];
            argi += 2;
            continue;
        }
        if strings_equal(a, "--installer") {
            installer_mode = true;
            argi += 1;
            continue;
        }
        if strings_equal(a, "-p") {
            if argi + 1 >= args.length {
                print.err("sfn package: -p requires a capsule path");
                return 2;
            }
            capsule_path = args[argi + 1];
            argi += 2;
            continue;
        }
        print.err("sfn package: unknown argument \"" + a + "\"");
        print.err("usage: sfn package [--target T] [--out DIR] [--compiler-bin PATH] [--installer] [-p <capsule-path>]");
        return 2;
    }

    // `--installer` and `-p` are mutually exclusive: the installer
    // tarball bundles compiler + runtime + import-context, which
    // are all compiler-specific. A user capsule has no analogue.
    if installer_mode {
        if capsule_path.length > 0 {
            print.err("sfn package: --installer is incompatible with -p");
            return 2;
        }
    }

    // Detect platform target if not overridden.
    let mut target: string = target_arg;
    if target.length == 0 { target = _package_detect_target(); }
    if target.length == 0 {
        print.err("sfn package: failed to detect platform target");
        return 1;
    }

    // Routing: installer vs compiler vs user capsule.
    if installer_mode {
        return _package_installer(target, out_dir, compiler_bin);
    }
    if capsule_path.length == 0 {
        return _package_compiler(target, out_dir, compiler_bin);
    }
    return _package_user_capsule(target, out_dir, capsule_path);
}

// Map the host OS/arch to a canonical target string.
// Falls back to `unknown-<s>-<m>` for unrecognised pairs.
//
// `os` comes from `build_host_os()` rather than a `uname -s` shell
// read: `_shell_read_cmd` self-disables on Windows and returns "",
// which this function used to turn into a hard failure before
// reaching any argv site (SFN-857 fixed the identical bug in
// `toolchain.sfn::_detect_os`). The Windows arch leg is fixed to
// `x86_64` rather than probed — `triple_is_supported`
// (`build/target.sfn`) admits no arm64 Windows target, so there is
// nothing for a probe to distinguish.
fn _package_detect_target() -> string ![io] {
    let os = build_host_os();
    if os.length == 0 { return ""; }
    if strings_equal(os, "Windows") { return "windows-x86_64"; }
    let arch = _shell_read_cmd("uname -m");
    if arch.length == 0 { return ""; }
    if strings_equal(os, "Linux") {
        if strings_equal(arch, "x86_64") { return "linux-x86_64"; }
        if strings_equal(arch, "aarch64") { return "linux-arm64"; }
    }
    if strings_equal(os, "Darwin") {
        if strings_equal(arch, "arm64") { return "macos-arm64"; }
        if strings_equal(arch, "x86_64") { return "macos-x86_64"; }
    }
    return "unknown-" + os + "-" + arch;
}

// Short-form package targets (`windows-x86_64`, `linux-arm64`, ...) are the
// vocabulary `_package_detect_target` emits. `triple_target_os` decodes only
// full triples, so it cannot replace these prefix tests directly — but it
// composes fine as a fallback for a caller that passes a full triple via
// `--target` (e.g. `x86_64-pc-windows-msvc`), so an unrecognized short form
// still resolves before falling through to "" (which leaves `target_exe_name`
// a no-op).
fn _package_target_os(target: string) -> string {
    if index_of(target, "windows-") == 0 { return "Windows"; }
    if index_of(target, "linux-") == 0 { return "Linux"; }
    if index_of(target, "macos-") == 0 { return "Darwin"; }
    return triple_target_os(target);
}

// Root for per-invocation staging. Honours `SAILFIN_TEST_SCRATCH` so a
// pooled `sfn test` child stages inside its own scratch dir rather than
// the shared repo build tree; falls back to the historical
// `build/sailfin` for ordinary release-time runs.
//
// Deliberately does not probe `test_runner_scratch_root()` first, the way
// `_cr_scratch_root` (`capsule_resolver/paths.sfn`) does: that returns ""
// unless the in-process test runner is active, and `sfn package` always
// runs as a separate process from `sfn test`, so the probe would be dead
// code here.
fn _package_staging_root() -> string ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { return scratch; }
    return "build/sailfin";
}

// Mint a fresh staging directory under the staging root. Returns "" when
// the directory could not be created; every caller treats that as fatal.
// The two failure modes are reported separately because they have
// different remedies: an uncreatable root is a permission or space problem
// on the root itself, while a failed mint means the root is fine but the
// leaf could not be claimed.
fn _package_mint_staging_dir(label: string) -> string ![io] {
    let root = _package_staging_root();
    if !ensure_dir_p(root) {
        print.err("sfn package: failed to create staging root " + root);
        return "";
    }
    // The prefix contains a '/', so `fs.mkdtemp` treats it as a literal
    // template prefix instead of anchoring under `$TMPDIR`
    // (`sfn_fs_mkdtemp`, `runtime/sfn/adapters/filesystem.sfn`).
    let staging = fs.mkdtemp(root + "/." + label + "-");
    if staging.length == 0 {
        print.err("sfn package: failed to mint " + label
            + " staging directory under "
            + root);
    }
    return staging;
}

// Package the compiler. Resolves the `sfn/compiler` workspace member for its
// version, stages `<bin>/sailfin` + `<bin>/sfn` (`.exe`-suffixed on a Windows
// target), tars + sha256s + manifest.
fn _package_compiler(target: string, out_dir: string, compiler_bin: string) -> int ![clock, io] {
    if !fs.exists(compiler_bin) {
        print.err("sfn package: compiler binary not found: " + compiler_bin);
        print.err("hint: run `sfn dev bootstrap build` first");
        return 1;
    }
    let manifest_path = compiler_manifest_from_workspace(".");
    if !fs.exists(manifest_path) {
        print.err("sfn package: missing manifest for workspace member `sfn/compiler`");
        return 1;
    }
    let manifest_text = fs.readFile(manifest_path);
    let version = toml_get_version(manifest_text);
    let capsule_name = toml_get_name(manifest_text);
    if version.length == 0 {
        print.err("sfn package: missing version in " + manifest_path);
        return 1;
    }
    // Defence-in-depth: `version` is interpolated into the tarball
    // stem, which is a filename, and into the `tar` argv below.
    // A malformed manifest with `version = "x'$(rm)"` would otherwise
    // produce a path-traversal or shell-metachar surface. The
    // sanitiser blocks `/`, `\`, `..` traversal components.
    if !_is_safe_capsule_version_cmd(version) {
        print.err("sfn package: rejecting unsafe version string \"" + version
            + "\"");
        return 1;
    }

    let stem = "sailfin-native-" + target + "-" + version;
    let staging = _package_mint_staging_dir("package-staging");
    if staging.length == 0 { return 1; }
    let staging_root = staging + "/sailfin-native-" + target;
    let staging_bin = staging_root + "/bin";
    // Target-gated (not host-gated): a staged tarball member is a
    // distribution artifact for `target`, not a binary this host must run
    // (SFN-972; see `target_exe_name`'s doc comment, `build/target.sfn`).
    let pkg_target_os = _package_target_os(target);
    let sailfin_name = target_exe_name("sailfin", pkg_target_os);
    let sfn_name = target_exe_name("sfn", pkg_target_os);

    ensure_dir_p(staging_bin);
    if !_copy_file_preserving_mode(compiler_bin, staging_bin + "/"
        + sailfin_name) {
        print.err("sfn package: failed to stage sailfin binary");
        remove_tree(staging);
        return 1;
    }
    if !_copy_file_preserving_mode(compiler_bin, staging_bin + "/" + sfn_name) {
        print.err("sfn package: failed to stage sfn binary");
        remove_tree(staging);
        return 1;
    }

    ensure_dir_p(out_dir);
    let tarball = out_dir + "/" + stem + ".tar.gz";
    let create_opts = CreateOptions {
        exec_paths: ["sailfin-native-" + target + "/bin/" + sailfin_name, "sailfin-native-"
            + target
            + "/bin/"
            + sfn_name],
        host_is_windows: host_is_windows(),
        link_policy: LinkPolicy.Preserve,
        deflate: DeflateOptions { strategy: DeflateStrategy.Fixed }
    };
    let created = targz_create(tarball, staging, ["sailfin-native-" + target], create_opts);
    match created {
        Result.Ok { value }
        : { },
        Result.Err { error }
        : {
            print.err("sfn package: archive creation failed: " + error.message);
            remove_tree(staging);
            return 1;
        }
    }

    let digest = _sha256_of_file(tarball);
    if digest.length == 0 {
        print.err("sfn package: failed to compute sha256 for " + tarball);
        remove_tree(staging);
        return 1;
    }
    fs.writeFile(tarball + ".sha256", digest + "\n");

    let binary_size = _package_size_of_file(compiler_bin);
    let tarball_size = _package_size_of_file(tarball);
    let mut build_date: string = "";
    match _package_build_date() {
        Result.Ok { value }
        : {
            build_date = value;
        },
        Result.Err { error }
        : {
            print.err(error);
            remove_tree(staging);
            return 1;
        }
    }

    let mut manifest = empty_dist_manifest();
    manifest.name = "sailfin-native";
    manifest.kind = "compiler";
    manifest.capsule_name = capsule_name;
    manifest.version = version;
    manifest.target = target;
    manifest.tarball = stem + ".tar.gz";
    manifest.sha256 = digest;
    manifest.binary_size = binary_size;
    manifest.tarball_size = tarball_size;
    manifest.build_date = build_date;

    let manifest_out = out_dir + "/" + stem + ".manifest.json";
    fs.writeFile(manifest_out, dist_manifest_to_json(manifest));

    remove_tree(staging);

    print("[package] created " + tarball);
    print("[package] created " + tarball + ".sha256");
    print("[package] created " + manifest_out);
    return 0;
}

// Package the installer (Stage C4b) — replaces the second half of
// `tools/package.sh`. Bundles the compiler binary together with
// the C runtime sources, the prelude object, and the staged
// import-context so a fresh-clone consumer can invoke
// `install.sh` (or eventually `sfn bootstrap`) and get a
// working compiler without rebuilding from a seed.
//
// Tarball name: `installer-<target>.tar.gz` (no version, matching
// the historical `tools/package.sh` shape — the version is on
// the bundled binary, not the dist artifact). Manifest is named
// `installer-<target>.manifest.json` and reuses
// `DistManifest.kind = "installer"` for downstream tooling that
// needs to disambiguate tarball flavours.
//
// Tarball contents (under top-level `<root>/`, no wrapping dir —
// `targz_create(tarball, staging, [], ...)` walks the whole staging
// tree, mirroring the historical `tar -czf <out> -C <staging> .`):
//   - bin/sailfin, bin/sfn               — the compiler (`.exe`-suffixed on a Windows target)
//   - workspace.toml                     — installed member inventory
//   - runtime/                           — runtime manifest, sources, and IR
//   - capsules/<scope>/<name>/           — compiler/runtime dependency closure
//   - import-context/                    — staged .sfn-asm tree (if available)
//
// The compiler dependency closure, runtime assets, and prelude contract are
// required. `stage_installer_workspace_assets` validates and copies them from
// resolved workspace members before archive creation; only import-context is
// optional because a fresh install can regenerate it.
fn _package_installer(target: string, out_dir: string, compiler_bin: string) -> int ![clock, io] {
    if !fs.exists(compiler_bin) {
        print.err("sfn package: compiler binary not found: " + compiler_bin);
        print.err("hint: run `sfn dev bootstrap build` first");
        return 1;
    }
    let manifest_path = compiler_manifest_from_workspace(".");
    if !fs.exists(manifest_path) {
        print.err("sfn package: missing manifest for workspace member `sfn/compiler`");
        return 1;
    }
    let manifest_text = fs.readFile(manifest_path);
    let version = toml_get_version(manifest_text);
    let capsule_name = toml_get_name(manifest_text);
    if version.length == 0 {
        print.err("sfn package: missing version in " + manifest_path);
        return 1;
    }
    if !_is_safe_capsule_version_cmd(version) {
        print.err("sfn package: rejecting unsafe version string \"" + version
            + "\"");
        return 1;
    }

    let stem = "installer-" + target;
    let staging = _package_mint_staging_dir("installer-staging");
    if staging.length == 0 { return 1; }
    let staging_bin = staging + "/bin";
    // Target-gated (not host-gated): a staged tarball member is a
    // distribution artifact for `target`, not a binary this host must run
    // (SFN-972; see `target_exe_name`'s doc comment, `build/target.sfn`).
    let pkg_target_os = _package_target_os(target);
    let sailfin_name = target_exe_name("sailfin", pkg_target_os);
    let sfn_name = target_exe_name("sfn", pkg_target_os);
    ensure_dir_p(staging_bin);
    if !_copy_file_preserving_mode(compiler_bin, staging_bin + "/"
        + sailfin_name) {
        print.err("sfn package: failed to stage sailfin binary");
        remove_tree(staging);
        return 1;
    }
    if !_copy_file_preserving_mode(compiler_bin, staging_bin + "/" + sfn_name) {
        print.err("sfn package: failed to stage sfn binary");
        remove_tree(staging);
        return 1;
    }

    let staged_workspace = stage_installer_workspace_assets(".", staging);
    if !staged_workspace.ok {
        remove_tree(staging);
        return 1;
    }

    // Staged import-context — only present after a self-host
    // build has run. Tools consuming the installer can survive
    // without it (they regenerate from the seed) but bundling
    // saves a rebuild on first use. Same logic as the prelude
    // copy: presence is conditional, but once present a
    // failed copy is a bug, not a soft skip.
    if fs.exists("build/compiler/import-context") {
        if !copy_tree("build/compiler/import-context", staging
            + "/import-context") {
            print.err("sfn package: failed to stage import-context");
            remove_tree(staging);
            return 1;
        }
    }

    ensure_dir_p(out_dir);
    let tarball = out_dir + "/" + stem + ".tar.gz";
    let create_opts = CreateOptions {
        exec_paths: ["bin/" + sailfin_name, "bin/" + sfn_name],
        host_is_windows: host_is_windows(),
        link_policy: LinkPolicy.Preserve,
        // The complete manifest closure contains enough source text that
        // fixed-Huffman LZ77's arena-owned token graph exceeds the compiler's
        // 8 GiB Linux self-cap. Stored blocks remain deterministic and keep
        // installer creation bounded without weakening that safety invariant.
        deflate: DeflateOptions { strategy: DeflateStrategy.Stored }
    };
    let created = targz_create(tarball, staging, [], create_opts);
    match created {
        Result.Ok { value }
        : { },
        Result.Err { error }
        : {
            print.err("sfn package: archive creation failed: " + error.message);
            remove_tree(staging);
            return 1;
        }
    }

    let digest = _sha256_of_file(tarball);
    if digest.length == 0 {
        print.err("sfn package: failed to compute sha256 for " + tarball);
        remove_tree(staging);
        return 1;
    }
    fs.writeFile(tarball + ".sha256", digest + "\n");

    // `binary_size` reports the bundled compiler binary's size.
    // For an installer tarball this is the most useful "primary
    // payload" measurement; the rest of the tarball (runtime
    // sources, optional prelude/import-context) is supporting
    // material with size already encoded in `tarball_size`.
    let binary_size = _package_size_of_file(compiler_bin);
    let tarball_size = _package_size_of_file(tarball);
    let mut build_date: string = "";
    match _package_build_date() {
        Result.Ok { value }
        : {
            build_date = value;
        },
        Result.Err { error }
        : {
            print.err(error);
            remove_tree(staging);
            return 1;
        }
    }

    let mut dm = empty_dist_manifest();
    dm.name = stem;
    dm.kind = "installer";
    dm.capsule_name = capsule_name;
    dm.version = version;
    dm.target = target;
    dm.tarball = stem + ".tar.gz";
    dm.sha256 = digest;
    dm.binary_size = binary_size;
    dm.tarball_size = tarball_size;
    dm.build_date = build_date;

    let manifest_out = out_dir + "/" + stem + ".manifest.json";
    fs.writeFile(manifest_out, dist_manifest_to_json(dm));

    remove_tree(staging);

    print("[package] created " + tarball);
    print("[package] created " + tarball + ".sha256");
    print("[package] created " + manifest_out);
    return 0;
}

// Package a user capsule. Reads the C2c sidecar to determine the
// artifact path and kind. Stages binary/object + sidecar +
// capsule.toml into the tarball — minimal contents until a
// post-1.0 `--include-ir` flag adds the per-module IR.
fn _package_user_capsule(target: string, out_dir: string, capsule_path: string) -> int ![clock, io] {
    // Normalise trailing slash on the path.
    let mut path = capsule_path;
    if path.length > 0 {
        if substring(path, path.length - 1, path.length) == "/" {
            path = substring(path, 0, path.length - 1);
        }
    }
    let manifest_path = path + "/capsule.toml";
    if !fs.exists(manifest_path) {
        print.err("sfn package: " + manifest_path + " not found");
        return 1;
    }
    let manifest_text = fs.readFile(manifest_path);
    let capsule_name = toml_get_name(manifest_text);
    let version = toml_get_version(manifest_text);
    if capsule_name.length == 0 {
        print.err("sfn package: missing [capsule].name in " + manifest_path);
        return 1;
    }
    if version.length == 0 {
        print.err("sfn package: missing version in " + manifest_path);
        return 1;
    }
    // See compiler-mode rationale: `version` flows into the tarball
    // stem and into shell commands; reject anything that could
    // escape filename or shell quoting.
    if !_is_safe_capsule_version_cmd(version) {
        print.err("sfn package: rejecting unsafe version string \"" + version
            + "\"");
        return 1;
    }

    // The sidecar lives under the capsule's per-capsule tree
    // (Stage C2a). `[capsule].name` must be in scope/name form
    // for the sidecar to have been written.
    let parts = parse_scope_name(capsule_name);
    if parts.scope.length == 0 {
        print.err("sfn package: capsule name \"" + capsule_name
            + "\" is not in scope/name form; cannot locate sidecar");
        return 1;
    }
    if !is_safe_scope_name(parts.scope, parts.name) {
        print.err("sfn package: capsule name \"" + capsule_name + "\" is unsafe");
        return 1;
    }
    let sidecar_path = path + "/build/capsules/" + parts.scope + "/" + parts.name
        + "/manifest.json";
    if !fs.exists(sidecar_path) {
        print.err("sfn package: no sidecar at " + sidecar_path);
        print.err("hint: run `sfn build -p " + capsule_path + "` first");
        return 1;
    }
    let sidecar_text = fs.readFile(sidecar_path);
    let kind = _package_extract_top_level(sidecar_text, "kind");
    let out_field = _package_extract_top_level(sidecar_text, "out");
    if kind.length == 0 {
        print.err("sfn package: sidecar at " + sidecar_path
            + " has no \"kind\" field");
        return 1;
    }
    if out_field.length == 0 {
        print.err("sfn package: sidecar at " + sidecar_path
            + " has no \"out\" field");
        return 1;
    }
    // out field is relative to the capsule path's CWD. Resolve.
    let artifact_path = path + "/" + out_field;
    if !fs.exists(artifact_path) {
        print.err("sfn package: artifact not found: " + artifact_path);
        print.err("hint: run `sfn build -p " + capsule_path
            + "` to (re)produce it");
        return 1;
    }

    // Sanitised tarball stem: replace `/` in capsule names with `-`.
    let safe_name = _package_sanitise_name(capsule_name);
    let stem = safe_name + "-" + target + "-" + version;
    let staging = _package_mint_staging_dir("capsule-staging");
    if staging.length == 0 { return 1; }
    let staging_root = staging + "/" + safe_name + "-" + target;

    ensure_dir_p(staging_root);

    // Stage the artifact under bin/ or obj/ depending on kind.
    let mut artifact_dest: string = "";
    // Populated for `kind == "binary"` only: the archive-relative path of
    // the staged binary, so `targz_create` can store the canonical 0755
    // mode without probing `access(X_OK)` (unreliable on Windows). A
    // library's `.o` is never executable, so this stays empty for that
    // branch.
    let mut exec_rel_paths: string[] = [];
    if strings_equal(kind, "binary") {
        ensure_dir_p(staging_root + "/bin");
        // Use the artifact's basename for the tarball's bin entry.
        let bn = _package_basename(artifact_path);
        if bn.length == 0 {
            print.err("sfn package: could not derive binary basename from "
                + artifact_path);
            remove_tree(staging);
            return 1;
        }
        artifact_dest = staging_root + "/bin/" + bn;
        exec_rel_paths = [safe_name + "-" + target + "/bin/" + bn];
    } else if strings_equal(kind, "library") {
        ensure_dir_p(staging_root + "/obj");
        artifact_dest = staging_root + "/obj/mod.o";
    } else {
        print.err("sfn package: unsupported kind \"" + kind
            + "\" (expected binary | library)");
        remove_tree(staging);
        return 1;
    }
    if !_copy_file_preserving_mode(artifact_path, artifact_dest) {
        print.err("sfn package: failed to stage artifact " + artifact_path);
        remove_tree(staging);
        return 1;
    }
    // Self-describing: copy the sidecar AND capsule.toml so a
    // consumer of the tarball can see what they got without
    // re-running the build.
    _copy_file_preserving_mode(sidecar_path, staging_root + "/manifest.json");
    _copy_file_preserving_mode(manifest_path, staging_root + "/capsule.toml");

    ensure_dir_p(out_dir);
    let tarball = out_dir + "/" + stem + ".tar.gz";
    let create_opts = CreateOptions {
        exec_paths: exec_rel_paths,
        host_is_windows: host_is_windows(),
        link_policy: LinkPolicy.Preserve,
        deflate: DeflateOptions { strategy: DeflateStrategy.Fixed }
    };
    let created = targz_create(tarball, staging, [safe_name + "-" + target], create_opts);
    match created {
        Result.Ok { value }
        : { },
        Result.Err { error }
        : {
            print.err("sfn package: archive creation failed: " + error.message);
            remove_tree(staging);
            return 1;
        }
    }

    let digest = _sha256_of_file(tarball);
    if digest.length == 0 {
        print.err("sfn package: failed to compute sha256 for " + tarball);
        remove_tree(staging);
        return 1;
    }
    fs.writeFile(tarball + ".sha256", digest + "\n");

    let artifact_size = _package_size_of_file(artifact_path);
    let tarball_size = _package_size_of_file(tarball);
    let mut build_date: string = "";
    match _package_build_date() {
        Result.Ok { value }
        : {
            build_date = value;
        },
        Result.Err { error }
        : {
            print.err(error);
            remove_tree(staging);
            return 1;
        }
    }

    let mut manifest = empty_dist_manifest();
    manifest.name = safe_name;
    manifest.kind = kind;
    manifest.capsule_name = capsule_name;
    manifest.version = version;
    manifest.target = target;
    manifest.tarball = stem + ".tar.gz";
    manifest.sha256 = digest;
    manifest.binary_size = artifact_size;
    manifest.tarball_size = tarball_size;
    manifest.build_date = build_date;

    let manifest_out = out_dir + "/" + stem + ".manifest.json";
    fs.writeFile(manifest_out, dist_manifest_to_json(manifest));

    remove_tree(staging);

    print("[package] created " + tarball);
    print("[package] created " + tarball + ".sha256");
    print("[package] created " + manifest_out);
    return 0;
}

// Thin alias over `_file_size_of` (`build/fs.sfn`), kept so call sites
// elsewhere in this module don't change shape. Returns 0 on read
// failure.
fn _package_size_of_file(path: string) -> int ![io] {
    return _file_size_of(path);
}

// Replace `/` and `\` in a capsule name with `-` so it's safe to
// interpolate into a filename. Other characters pass through; the
// caller should already have validated via `is_safe_scope_name`.
fn _package_sanitise_name(name: string) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= name.length { break; }
        let ch = substring(name, i, i + 1);
        if ch == "/" { out = out + "-"; } else if ch == "\\" { out = out + "-"; } else {
            out = out + ch;
        }
        i += 1;
    }
    return out;
}

// Extract the value of a top-level string field from the per-capsule
// sidecar JSON (Stage C2a/C2c). Anchored on the prefix `"<field>":"`
// at the **outermost** object level — e.g. for `kind = "binary"` the
// match is `,"kind":"binary"` (or `{"kind":"binary"`).
//
// Hand-rolled because we don't have a JSON parser yet; only the few
// top-level fields `sfn package` cares about (`kind`, `out`) are
// read this way. The sidecar's `modules[]` may also contain a
// `"slug"` field, but the loop terminates at the FIRST match
// against the outer-prefix anchor — and the outer fields appear
// before `"modules":[...]` in
// `capsule_artifact_manifest_to_json`'s field order.  If that
// ordering ever changes, the unit test on this helper catches it.
fn _package_extract_top_level(json: string, field: string) -> string {
    if json.length == 0 { return ""; }
    if field.length == 0 { return ""; }
    let needle = "\"" + field + "\":\"";
    let start = _package_find_substring(json, needle, 0);
    if start < 0 { return ""; }
    let value_start = start + needle.length;
    // Find the closing quote, honouring backslash escapes.
    let mut end: int = value_start;
    loop {
        if end >= json.length { return ""; }
        let ch = substring(json, end, end + 1);
        if ch == "\\" {
            // skip the next character (escape)
            end += 2;
            continue;
        }
        if ch == "\"" { break; }
        end += 1;
    }
    return substring(json, value_start, end);
}

fn _package_find_substring(haystack: string, needle: string, start: int) -> int {
    if needle.length == 0 { return start; }
    if haystack.length < needle.length { return -1; }
    let limit = haystack.length - needle.length;
    let mut i: int = start;
    loop {
        if i > limit { break; }
        if substring(haystack, i, i + needle.length) == needle { return i; }
        i += 1;
    }
    return -1;
}

// The `sfn/cli` definition for `package`, registered on the v2 root via
// `with_subcommand`. Four optional value flags, one boolean flag, and one
// short value flag `-p`.
fn command_def() -> Command {
    return with_usage(with_flag(with_flag(with_flag(with_flag(with_flag(command("package", "Package a capsule or the compiler for distribution"), flag_value("target", "Platform target (e.g. linux-x86_64); auto-detected if absent")), flag_value("out", "Output directory (default: dist)")), flag_value("compiler-bin", "Path to the compiler binary (default: build/bin/sfn)")), flag("installer", "Package the compiler installer bundle")), flag_value_short("p", "p", "Capsule path to package (user-capsule mode)")), "packages", "sfn package", "build a distributable");
}

// Reconstruct the legacy positional args slice from the typed matches and
// delegate to `handle_package_command` verbatim. Absent flags are omitted
// from the slice so the handler applies its own defaults (`out` → "dist",
// `compiler-bin` → "build/bin/sfn") and its own mutual-exclusion
// check exactly as before. `ctx` is part of the per-command contract but
// unused here (package sources no driver state).
fn run(matches: Matches, ctx: CliContext) -> int ![clock, io] {
    let mut args: string[] = ["package"];
    let target: string = get_or(matches, "target", "");
    if target.length > 0 {
        args.push("--target");
        args.push(target);
    }
    let out_dir: string = get_or(matches, "out", "");
    if out_dir.length > 0 {
        args.push("--out");
        args.push(out_dir);
    }
    let compiler_bin: string = get_or(matches, "compiler-bin", "");
    if compiler_bin.length > 0 {
        args.push("--compiler-bin");
        args.push(compiler_bin);
    }
    if has_flag(matches, "installer") { args.push("--installer"); }
    let capsule_path: string = get_or(matches, "p", "");
    if capsule_path.length > 0 {
        args.push("-p");
        args.push(capsule_path);
    }
    return handle_package_command(args);
}
