// compiler/src/cli/commands/dev.sfn
//
// `sfn dev bootstrap ...` — the compiler-maintainer bootstrap surface
// (SFEP-0047). These commands are developer/agent-only: they operate on the
// compiler checkout's root `bootstrap.toml` (the exact stage0 seed policy)
// and are deliberately kept out of the primary `sfn --help` list so ordinary
// Sailfin application authors never see them.
//
//   sfn dev bootstrap fetch              acquire + verify the pinned seed only
//   sfn dev bootstrap build [-- <args>]  fetch if needed, then build the
//                                        compiler with the exact seed
//   sfn dev bootstrap check              build + smoke-verify the built
//                                        compiler
//   sfn dev bootstrap pin <version>      update bootstrap.toml [seed].version
//   sfn dev bootstrap fingerprint [root] print the compiler source
//                                        fingerprint
//   sfn dev bootstrap install [--from]   publish an already-built compiler as
//                                        build/bin/sfn or under a prefix
//
// The steady-state contributor path is still `sfn build -p compiler`, which
// enters bootstrap mode via `bootstrap_gate_or_dispatch` (exported here and
// called from `build.sfn`). Both share the same acquire-then-dispatch
// implementation; the gate re-execs mid-`build`, while the explicit command
// subprocesses the seed so it can report a result.
import {
    Command,
    Matches,
    arg,
    arg_variadic,
    command,
    flag,
    flag_value,
    get,
    has_flag,
    positionals,
    subcommand,
    subcommand_path,
    with_arg,
    with_flag,
    with_subcommand
} from "sfn/cli";
import { ascii_lowercase, int_to_string } from "sfn/strings";

import {
    BOOTSTRAP_MANIFEST_PATH,
    BootstrapManifest,
    bootstrap_manifest_exists,
    read_bootstrap_manifest,
    rewrite_seed_version
} from "../../bootstrap_manifest";
import {
    CREATE_EXCLUSIVE_CREATED,
    CREATE_EXCLUSIVE_MODE_FILE,
    _atomic_rename_into_place,
    _copy_file,
    _create_exclusive_cmd,
    _cwd_cmd,
    _mktemp_sibling_cmd,
    _rename_noreplace_preserving_source_on_failure,
    _rename_preserving_source_on_failure,
    _set_current_directory,
    _sha256_of_file,
    _toml_trim_cmd
} from "../../build/fs";
import { ensure_dir_p, remove_tree } from "../../build/fs_tree";
import { _dirname, _path_basename, _path_join } from "../../build/paths";
import {
    built_program_path,
    compute_source_fingerprint,
    compute_workspace_source_fingerprint,
    default_fingerprint_roots,
    install_built_compiler,
    native_install_path,
    pending_fingerprint_path,
    read_stored_fingerprint,
    source_fingerprint_path,
