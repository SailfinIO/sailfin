// Resolve DESTDIR against the physical filesystem without adding a new
// builtin that the pinned seed cannot compile. The Windows runtime supplies
// the same sibling implementation used by build/fs.sfn::_cwd_cmd.
extern fn realpath(path: *u8, resolved: *u8) -> *u8;

// Where a bootstrap-triggered fetch stages its download: the per-invocation
// test scratch first (so parallel `sfn test --jobs N` children never collide),
// then `TMPDIR`, then `/tmp`.
fn _bootstrap_work_root() -> string ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { return scratch; }
    let tmp = env.get("TMPDIR");
    if tmp.length > 0 { return tmp; }
    return "/tmp";
}

// True when `path` is already rooted. A POSIX absolute path leads with `/`;
// a Windows one leads with a drive letter, a `:`, and a separator (SFN-888).
// Without the drive-letter arm a `C:\...` install base read from
// `bootstrap.toml` is treated as relative and gets a cwd prefix, producing
// an alias target that resolves nowhere.
fn _bootstrap_is_absolute(path: string) -> boolean {
    return is_absolute_path(path);
}

// Absolute path to `path` (relative paths are resolved against the current
// working directory). Symlink targets must be absolute so the seed store's
// `bin/` alias holds regardless of the directory a later `sfn` runs from.
fn _bootstrap_abspath(path: string) -> string ![io] {
    if _bootstrap_is_absolute(path) { return path; }
    let cwd = _cwd_cmd();
    // `_cwd_cmd` floors at "." when neither `realpath` nor `PWD` answers;
    // prefixing that would only re-spell the same relative path, so degrade
    // to returning `path` untouched exactly as the `pwd` shellout did.
    if cwd.length == 0 || strings_equal(cwd, ".") { return path; }
    return cwd + "/" + path;
}

// Strip the host root before placing an install prefix beneath DESTDIR.
// `/usr/local` becomes `<destdir>/usr/local`; `C:/Sailfin` becomes
// `<destdir>/Sailfin`. The shared root parser keeps drive and UNC handling
// aligned with the rest of the compiler instead of producing an invalid
// embedded `C:` path on Windows.
fn _bootstrap_unroot_prefix(prefix: string) -> string {
    let root_len = path_root_prefix_len(prefix);
    if root_len <= 0 { return prefix; }
    return substring(prefix, root_len, prefix.length);
}

fn _bootstrap_has_parent_segment(path: string) -> boolean {
    let mut start: int = 0;
    let mut i: int = 0;
    loop {
        if i > path.length { break; }
        let at_end = i == path.length;
        if at_end || is_path_separator(substring(path, i, i + 1)) {
            if substring(path, start, i) == ".." { return true; }
            start = i + 1;
        }
        i += 1;
    }
    return false;
}

// True when DESTDIR names the filesystem root itself. That spelling is not a
// staging sandbox: `/` + `/usr/local` is the live `/usr/local`, so it must
// retain the same package-manager ownership guard as a direct prefix install.
fn _bootstrap_destdir_is_live_root(destdir: string) -> boolean {
    if destdir.length == 0 { return false; }
    let root_len = path_root_prefix_len(destdir);
    if root_len <= 0 { return false; }
    let mut i: int = root_len;
    loop {
        if i >= destdir.length { break; }
        if !is_path_separator(substring(destdir, i, i + 1)) { return false; }
        i += 1;
    }
    return true;
}

fn _bootstrap_realpath(path: string) -> string ![io] {
    let resolved: *u8 = realpath(path as *u8, null);
    if resolved as i64 == 0 { return ""; }
    return _source_identity_normalize_path(resolved as string);
}

fn _bootstrap_path_contains(root: string, path: string) -> boolean {
    if strings_equal(root, path) { return true; }
    if root.length == 0 || path.length <= root.length { return false; }
    if !starts_with(path, root) { return false; }
    return is_path_separator(substring(path, root.length, root.length + 1));
}

fn _bootstrap_physical_paths_equal(a: string, b: string) -> boolean ![io] {
    let normalized_a = _source_identity_normalize_path(a);
    let normalized_b = _source_identity_normalize_path(b);
    if host_is_windows() {
        return strings_equal(ascii_lowercase(normalized_a), ascii_lowercase(normalized_b));
    }
    return strings_equal(normalized_a, normalized_b);
}

// Create `path` one component at a time from its filesystem root (or the
// physical cwd for a relative spelling). Resolving only the final path is too
// late: recursive directory creation follows a symlink or NTFS junction in an
// ancestor before the caller can classify DESTDIR as staging. Each component
// must therefore resolve to the direct physical child of its validated parent.
fn _bootstrap_prepare_destdir_root(destdir: string) -> string ![io] {
    let lexical_root = _source_identity_normalize_path(_bootstrap_abspath(destdir));
    let root_len = path_root_prefix_len(lexical_root);
    if root_len <= 0 {
        print.err("error: could not resolve DESTDIR root " + destdir);
        return "";
    }

    let mut cursor = substring(lexical_root, 0, root_len);
    let mut resolved_parent = _bootstrap_realpath(cursor);
    if resolved_parent.length == 0 {
        print.err("error: could not resolve DESTDIR root " + cursor);
        return "";
    }
    let mut start = root_len;
    if start < lexical_root.length && is_path_separator(substring(lexical_root, start, start
        + 1)) { start += 1; }
    let mut i = start;
    loop {
        if i > lexical_root.length { break; }
        let at_end = i == lexical_root.length;
        if at_end || is_path_separator(substring(lexical_root, i, i + 1)) {
            if i > start {
                let segment = substring(lexical_root, start, i);
                cursor = _path_join(cursor, segment);
                if fs.read_link(cursor).length > 0 {
                    if _bootstrap_physical_paths_equal(cursor, lexical_root) {
                        print.err("error: DESTDIR must not be a symbolic link: "
                            + destdir);
                    } else {
                        print.err("error: DESTDIR path contains a symbolic link: "
                            + cursor);
                    }
                    return "";
                }
                if !fs.exists(cursor) && !fs.createDirectory(cursor, false) {
                    print.err("error: could not create DESTDIR component "
                        + cursor);
                    return "";
                }
                let resolved_cursor = _bootstrap_realpath(cursor);
                let expected_cursor = _source_identity_normalize_path(_path_join(resolved_parent, segment));
                if resolved_cursor.length == 0 || !_bootstrap_physical_paths_equal(expected_cursor, resolved_cursor) {
                    print.err("error: DESTDIR path contains a redirecting filesystem component: "
                        + cursor);
                    return "";
                }
                resolved_parent = resolved_cursor;
            }
            start = i + 1;
        }
        i += 1;
    }
    return resolved_parent;
}

struct BootstrapDestdirPreparation {
    kind: int;
    physical_bin: string;
}

// Prepare only the portion beneath DESTDIR, rejecting redirecting components
// before publication. This makes the staging root a containment boundary
// instead of letting an existing `<destdir>/usr` link or junction redirect a
// package publish into the live filesystem. `kind` is 1 for a live filesystem
// root, 0 for a contained staging root, and -1 on validation failure. The
// staged result carries the physical bin path produced by this same validated
// component walk, so the caller never re-resolves an attacker-swappable alias.
fn _bootstrap_prepare_destdir(destdir: string, bin_dir: string) -> BootstrapDestdirPreparation ![io] {
    let resolved_root = _bootstrap_prepare_destdir_root(destdir);
    if resolved_root.length == 0 {
        return BootstrapDestdirPreparation { kind: -1, physical_bin: "" };
    }
    if _bootstrap_destdir_is_live_root(resolved_root) {
        return BootstrapDestdirPreparation { kind: 1, physical_bin: "" };
    }

    let lexical_root = _source_identity_normalize_path(_bootstrap_abspath(destdir));
    let lexical_bin = _source_identity_normalize_path(_bootstrap_abspath(bin_dir));
    if !_bootstrap_path_contains(lexical_root, lexical_bin) {
        print.err("error: resolved install prefix escapes DESTDIR: " + bin_dir);
        return BootstrapDestdirPreparation { kind: -1, physical_bin: "" };
    }

    let mut cursor = lexical_root;
    let mut resolved_parent = resolved_root;
    let mut start: int = lexical_root.length;
    if start < lexical_bin.length && is_path_separator(substring(lexical_bin, start, start
        + 1)) { start += 1; }
    let mut i: int = start;
    loop {
        if i > lexical_bin.length { break; }
        let at_end = i == lexical_bin.length;
        if at_end || is_path_separator(substring(lexical_bin, i, i + 1)) {
            if i > start {
                cursor = _path_join(cursor, substring(lexical_bin, start, i));
                if fs.read_link(cursor).length > 0 {
                    print.err("error: install path beneath DESTDIR contains a symbolic link: "
                        + cursor);
                    return BootstrapDestdirPreparation {
                        kind: -1,
                        physical_bin: ""
                    };
                }
                if !fs.exists(cursor) && !fs.createDirectory(cursor, false) {
                    print.err("error: could not create staged install directory "
                        + cursor);
                    return BootstrapDestdirPreparation {
                        kind: -1,
                        physical_bin: ""
                    };
                }
                let resolved_cursor = _bootstrap_realpath(cursor);
                let expected_cursor = _source_identity_normalize_path(_path_join(resolved_parent, substring(lexical_bin, start, i)));
                if resolved_cursor.length == 0 || !_bootstrap_physical_paths_equal(expected_cursor, resolved_cursor) {
                    print.err("error: install path beneath DESTDIR contains a redirecting filesystem component: "
                        + cursor);
                    return BootstrapDestdirPreparation {
                        kind: -1,
                        physical_bin: ""
                    };
                }
                if !_bootstrap_path_contains(resolved_root, resolved_cursor) {
                    print.err("error: resolved install path escapes DESTDIR: "
                        + cursor);
                    return BootstrapDestdirPreparation {
                        kind: -1,
                        physical_bin: ""
                    };
                }
                resolved_parent = resolved_cursor;
            }
            start = i + 1;
        }
        i += 1;
    }
    return BootstrapDestdirPreparation {
        kind: 0,
        physical_bin: resolved_parent
    };
}

// Resolve a prefixed install from an already host-conditioned executable
// name. Keeping the name as an input makes the Windows `.exe` branch
// regression-testable without duplicating its rule here; production passes
// `host_exe_name("sfn")`.
fn _bootstrap_prefixed_install_path(prefix: string, destdir: string, exe_name: string) -> string {
    let mut install_prefix = prefix;
    if destdir.length > 0 {
        install_prefix = _path_join(destdir, _bootstrap_unroot_prefix(prefix));
    }
    return _source_identity_normalize_path(_path_join(_path_join(install_prefix, "bin"), exe_name));
}

// Resolve the destination for `dev bootstrap install`. No flags preserve the
// canonical repo-local publish path. DESTDIR without an explicit prefix uses
// `~/.local`, matching the Makefile compatibility target it replaces.
fn _dev_bootstrap_install_prefix(prefix: string, destdir: string) -> string ![io] {
    if prefix.length == 0 && destdir.length == 0 { return ""; }
    let mut install_prefix = prefix;
    if install_prefix.length == 0 {
        let home = env.home();
        if home.length == 0 { return ""; }
        install_prefix = _path_join(home, ".local");
    }
    return install_prefix;
}

fn _dev_bootstrap_install_path(prefix: string, destdir: string) -> string ![io] {
    if prefix.length == 0 && destdir.length == 0 {
        return native_install_path();
    }
    let install_prefix = _dev_bootstrap_install_prefix(prefix, destdir);
    if install_prefix.length == 0 { return ""; }
    return _bootstrap_prefixed_install_path(install_prefix, destdir, host_exe_name("sfn"));
}

// Canonical publication is selected by CLI mode, not by path coincidence.
// Explicit path flags may normalize to `build/bin/sfn`, but they still request
// prefixed/staged bundle semantics and must not touch the repo fingerprint.
fn _bootstrap_install_is_canonical(prefix: string, destdir: string) -> boolean {
    return prefix.length == 0 && destdir.length == 0;
}

fn _bootstrap_dev_owner_marker_path(out: string) -> string {
    return out + ".sfn-dev-install.sha256";
}

// `fs.exists` follows POSIX symlinks, so it reports a dangling entry as
// absent. `fs.read_link` observes that link node without following it. On
// Windows the read-link primitive is unavailable, but `fs.exists` lowers to
// GetFileAttributesA, whose link behavior reports attributes for the link
// itself. Keep the combination centralized so ownership, backup, and rollback
// cannot disagree about whether a filesystem entry occupies a live path.
fn _bootstrap_path_entry_exists(path: string) -> boolean ![io] {
    if fs.exists(path) { return true; }
    return fs.read_link(path).length > 0;
}

// A live prefixed install may replace only a binary that this command wrote
// and that has not changed since. Package managers do not carry the sidecar,
// and a later package-manager replacement leaves a digest mismatch, so both
// cases fail closed instead of losing the PATH entry behind the user's back
// (SFN-1075; SFEP-0073 §3.5).
fn _bootstrap_dev_owns_install(out: string) -> boolean ![io] {
    if !_bootstrap_path_entry_exists(out) {
        let bin_dir = _dirname(out);
        return !_bootstrap_path_entry_exists(bin_dir + "/runtime") && !_bootstrap_path_entry_exists(bin_dir
            + "/capsules")
            && !_bootstrap_path_entry_exists(bin_dir
            + "/workspace.toml")
            && !_bootstrap_path_entry_exists(_bootstrap_dev_owner_marker_path(out));
    }
    let marker = _bootstrap_dev_owner_marker_path(out);
    if !_bootstrap_path_entry_exists(marker) { return false; }
    let expected = _toml_trim_cmd(fs.readFile(marker));
    if expected.length == 0 { return false; }
    let actual = _sha256_of_file(out);
    return actual.length > 0 && strings_equal(actual, expected);
}

// Stage the compiler's resolved runtime/dependency closure before touching an
// install prefix. A compiler executable is not a complete local toolchain on
// its own: through 0.10.5 both driver and analyzer discovery require the
// adjacent runtime mirror (SFN-1124).
fn _bootstrap_stage_dev_payload(src: string, out: string, record_owner: boolean) -> string ![io] {
    let bin_dir = _dirname(out);
    if !ensure_dir_p(bin_dir) { return ""; }
    let staging = fs.mkdtemp(bin_dir + "/.sfn-dev-install-payload-");
    if staging.length == 0 { return ""; }
    let result = stage_installer_workspace_assets(".", staging);
    if !result.ok {
        remove_tree(staging);
        return "";
    }
    let staged_bin = staging + "/" + _path_basename(out);
    if !install_built_compiler(src, staged_bin) {
        remove_tree(staging);
        return "";
    }
    if record_owner {
        let digest = _sha256_of_file(staged_bin);
        if digest.length == 0 {
            remove_tree(staging);
            return "";
        }
        let staged_marker = staging + "/" + _path_basename(_bootstrap_dev_owner_marker_path(out));
        fs.writeFile(staged_marker, digest + "\n");
        if !strings_equal(_toml_trim_cmd(fs.readFile(staged_marker)), digest) {
            remove_tree(staging);
            return "";
        }
    }
    return staging;
}

struct BootstrapInstallBackup {
    ok: boolean;
    existed: boolean;
    path: string;
}

fn _bootstrap_backup_install_path(live: string, fixed_backup: string) -> BootstrapInstallBackup ![io] {
    if !_bootstrap_path_entry_exists(live) {
        return BootstrapInstallBackup { ok: true, existed: false, path: "" };
    }
    let mut backup = fixed_backup;
    if backup.length > 0 {
        if _bootstrap_path_entry_exists(backup) && !remove_tree(backup) {
            return BootstrapInstallBackup {
                ok: false,
                existed: true,
                path: ""
            };
        }
    } else {
        backup = _mktemp_sibling_cmd(live);
        if backup.length == 0 {
            return BootstrapInstallBackup {
                ok: false,
                existed: true,
                path: ""
            };
        }
        fs.deleteFile(backup);
    }
    if !_rename_preserving_source_on_failure(live, backup) {
        return BootstrapInstallBackup { ok: false, existed: true, path: "" };
    }
    return BootstrapInstallBackup { ok: true, existed: true, path: backup };
}

fn _bootstrap_discard_install_backup(backup: BootstrapInstallBackup) -> boolean ![io] {
    if !backup.existed || backup.path.length == 0 { return true; }
    return remove_tree(backup.path);
}

fn _bootstrap_restore_captured_paths_no_clobber(live_paths: string[], backups: BootstrapInstallBackup[]) -> boolean ![io] {
    let mut restored = true;
    let mut i = backups.length - 1;
    loop {
        if i < 0 { break; }
        if _bootstrap_path_entry_exists(live_paths[i]) {
            if !_bootstrap_discard_install_backup(backups[i]) {
                restored = false;
            }
            restored = false;
        } else if backups[i].existed && backups[i].path.length > 0 {
            if !_rename_noreplace_preserving_source_on_failure(backups[i].path, live_paths[i]) {
                restored = false;
            }
        }
        i -= 1;
    }
    return restored;
}

// After the executable claim there is no portable compare-and-delete primitive
// that binds a digest check to the exact directory entry removed. Rollback must
// therefore never delete a live path: another writer could replace it after any
// inspection. Captured paths return only to names that remain absent through an
// atomic no-clobber move; occupied names are preserved and our backups discarded.
fn _bootstrap_restore_after_entry_claim(live_paths: string[], backups: BootstrapInstallBackup[], _published_digest: string) -> boolean ![io] {
    return _bootstrap_restore_captured_paths_no_clobber(live_paths, backups);
}

// Commit a complete same-filesystem bundle. Every source is staged before a
// live path moves. Failures before the executable claim restore the prior
// bundle; later failures preserve occupied names and restore only absent ones
// because deleting a live path could remove a concurrent external publish.
// The caller holds the per-entry install lock, so cooperating dev writers do
// not interleave their backup sets.
fn _bootstrap_commit_dev_payload(staging: string, out: string, record_owner: boolean) -> boolean ![io] {
    let bin_dir = _dirname(out);
    let marker = _bootstrap_dev_owner_marker_path(out);
    // Capture the entry and its ownership proof before moving any companion
    // path. The pre-commit digest check is advisory only: an external writer
    // can replace `out` immediately afterward. Moving it first atomically
    // selects the exact bytes this transaction would overwrite; validating
    // that captured backup against the captured marker closes that race.
    let live_paths = [out, marker, bin_dir + "/runtime", bin_dir + "/capsules", bin_dir
        + "/workspace.toml"];
    let mut staged_paths = [staging + "/" + _path_basename(out), "", staging
        + "/runtime", staging
        + "/capsules", staging
        + "/workspace.toml"];
    if record_owner {
        staged_paths[1] = staging + "/" + _path_basename(marker);
    }

    let mut backups: BootstrapInstallBackup[] = [];
    let mut i: int = 0;
    loop {
        if i >= 2 { break; }
        // Windows permits a running image to move but keeps the displaced
        // file locked until this process exits. A unique backup would leak one
        // compiler per self-reinstall. Reuse one fixed executable backup, as
        // `sfn_rename_replace` does for its bounded `.old` sibling; the next
        // invocation sweeps it after the prior process has released the lock.
        let mut fixed_backup = "";
        if i == 0 { fixed_backup = out + ".sfn-dev-install.old"; }
        let backup = _bootstrap_backup_install_path(live_paths[i], fixed_backup);
        if !backup.ok {
            let restored = _bootstrap_restore_captured_paths_no_clobber(live_paths, backups);
            if !restored {
                print.err("error: failed to restore captured install paths without replacing a foreign entry");
            }
            return false;
        }
        backups.push(backup);
        i += 1;
    }

    if record_owner {
        let captured_any = backups[0].existed || backups[1].existed;
        let captured_both = backups[0].existed && backups[1].existed;
        let mut captured_matches = !captured_any;
        if captured_both {
            let expected = _toml_trim_cmd(fs.readFile(backups[1].path));
            let actual = _sha256_of_file(backups[0].path);
            captured_matches = expected.length > 0 && actual.length > 0
                && strings_equal(expected, actual);
        }
        if !captured_matches {
            let restored = _bootstrap_restore_captured_paths_no_clobber(live_paths, backups);
            if !restored {
                print.err("error: failed to restore captured install paths without replacing a foreign entry");
            }
            print.err("error: the entry executable changed before it could be captured for publication");
            return false;
        }
    }

    let published_digest = _sha256_of_file(staged_paths[0]);
    if published_digest.length == 0 || !_rename_noreplace_preserving_source_on_failure(staged_paths[0], live_paths[0]) {
        let restored = _bootstrap_restore_after_entry_claim(live_paths, backups, "");
        if !restored {
            print.err("error: a foreign entry executable appeared during local compiler publication and was preserved");
        }
        return false;
    }

    i = 2;
    loop {
        if i >= live_paths.length { break; }
        let backup = _bootstrap_backup_install_path(live_paths[i], "");
        if !backup.ok {
            let restored = _bootstrap_restore_after_entry_claim(live_paths, backups, published_digest);
            if !restored {
                print.err("error: failed to restore the prior local compiler bundle without replacing a foreign entry");
            }
            return false;
        }
        backups.push(backup);
        i += 1;
    }

    i = 2;
    loop {
        if i >= live_paths.length { break; }
        if staged_paths[i].length > 0 {
            if !_atomic_rename_into_place(staged_paths[i], live_paths[i]) {
                let restored = _bootstrap_restore_after_entry_claim(live_paths, backups, published_digest);
                if !restored {
                    print.err("error: failed to restore the prior local compiler bundle without replacing a foreign entry");
                }
                return false;
            }
        }
        i += 1;
    }

    if record_owner {
        if !_rename_noreplace_preserving_source_on_failure(staged_paths[1], live_paths[1]) {
            let restored = _bootstrap_restore_after_entry_claim(live_paths, backups, published_digest);
            if !restored {
                print.err("error: failed to restore the prior local compiler bundle without replacing a foreign entry");
            }
            return false;
        }
        let current_digest = _sha256_of_file(live_paths[0]);
        if current_digest.length == 0 || !strings_equal(current_digest, published_digest) {
            let restored = _bootstrap_restore_after_entry_claim(live_paths, backups, published_digest);
            if !restored {
                print.err("error: a foreign entry executable appeared during local compiler publication and was preserved");
            }
            return false;
        }
    }

    i = 0;
    loop {
        if i >= backups.length { break; }
        if backups[i].existed && backups[i].path.length > 0 {
            remove_tree(backups[i].path);
        }
        i += 1;
    }
    remove_tree(staging);
    return true;
}

// A seed store entry is ready to build/dispatch from when its `sailfin`
// binary is present AND — when the native installer's `.sha256` completeness
// marker exists — that marker is non-empty. The marker is written LAST, so a
// present-but-empty/whitespace marker signals a torn install: not ready, so
// `_bootstrap_fetch` re-runs the verified installer to repair it. When the
// marker is ABSENT the entry is a migration-era `make fetch-seed`/`install.sh`
// store (SFEP-0047 §3.3 keeps it as a transitional shim, and install.sh writes
// no marker), which is ready to use as-is — requiring the marker there would
// force a needless re-fetch of an already-usable seed.
fn _bootstrap_store_ready(install_base: string, ver: string) -> boolean ![io] {
    let store_dir = install_base + "/" + ver;
    if !fs.exists(_bootstrap_seed_bin(install_base, ver)) { return false; }
    let sha_path = store_dir + "/.sha256";
    if fs.exists(sha_path) {
        let recorded = _toml_trim_cmd(fs.readFile(sha_path));
        if recorded.length == 0 { return false; }
    }
    return true;
}

// The seed binary path within the store.
//
// HOST-gated (SFN-1007, the same class SFN-701 closed elsewhere): this
// names a binary THIS machine has to probe and execute, so it follows
// `build_host_os()` and never `build_target_os()`. The Windows installer
// writes `sailfin.exe` (`install.ps1`'s alias list), so an extensionless
// literal here finds nothing on a native Windows host — and spawning the
// relative extensionless path fails `ERROR_FILE_NOT_FOUND` outright.
// Route through `host_exe_name` rather than appending `.exe` by hand, so
// there stays exactly one definition of how an executable is named per
// target. The probe in `_bootstrap_store_ready` calls this function for
// the same reason: one spelling, not two that can drift.
fn _bootstrap_seed_bin(install_base: string, ver: string) -> string ![io] {
    return host_exe_name(install_base + "/" + ver + "/sailfin");
}

// Lay the `bin_dir` aliases (`sfn`, `sailfin`) over the freshly-installed
// seed so the repo-local store is a drop-in for the `install.sh`-produced one
// the Makefile's `SEED = build/toolchains/seed/bin/sfn` still reads during
// migration. Best-effort: a filesystem without symlinks leaves the versioned
// binary usable directly, which is all the native dispatch path needs.
fn _bootstrap_link_bin(install_base: string, bin_dir: string, ver: string) -> void ![io] {
    ensure_dir_p(bin_dir);
    let abs_bin = _bootstrap_abspath(_bootstrap_seed_bin(install_base, ver));
    // HOST-gated (SFN-1007), matching the store-entry scheme in
    // `toolchain.sfn`: an extensionless copy is not launchable on Windows,
    // and the Makefile's `SEED = build/toolchains/seed/bin/sfn` reads this
    // alias directly.
    _bootstrap_alias(abs_bin, host_exe_name(bin_dir + "/sfn"));
    _bootstrap_alias(abs_bin, host_exe_name(bin_dir + "/sailfin"));
}

// Point `alias` at `abs_bin`, preferring a symlink and falling back to a
// copy (SFN-888, replacing `ln -sfn`).
//
// The `fs.deleteFile` is load-bearing, not tidiness: `ln -sfn` is *force* +
// *no-dereference*, while `fs.symlink` is bare `symlink(2)` and fails
// `EEXIST` on any existing path, so without the unlink this would be a
// no-op on every re-run. It is also what makes both modes idempotent —
// `_bootstrap_link_bin` re-runs on the fetch path and on the
// already-present path, so a re-pin refreshes an alias rather than leaving
// a stale binary, on any host that permits the unlink. Windows cannot
// unlink a RUNNING image (the property `build/fs.sfn` records for
// `_atomic_rename_into_place`), so a re-pin racing a live `bin/sfn` there
// leaves the old copy in place; that is the best-effort contract this leaf
// already declares, not a guarantee being made.
//
// The unlink is unconditional — it happens before anything knows a
// replacement is achievable — so a refused symlink followed by a failed
// `_copy_file` leaves no alias at all. That window is copy-leg-only and
// unreachable on POSIX, where `symlink(2)` succeeds even for a target that
// does not exist and the copy is never entered. `fs.deleteFile` is `unlink(2)`, which removes a
// symlink WITHOUT following it, so this cannot reach through an existing
// alias into the store entry it points at.
//
// The fallback branches on the RETURN VALUE, not on `host_is_windows()`.
// `fs.symlink` now calls `sfn_fs_link_create` (SFN-1143), which on Windows
// is a real `CreateSymbolicLinkA` attempt, so on a host with Developer Mode
// or `SeCreateSymbolicLinkPrivilege` the alias is a genuine symlink into
// the version store, not a copy; branching on the capability rather than
// the host means both that path and an unprivileged Windows host (or a
// POSIX filesystem that refuses links) already fall out of the same
// return-value check. A copy is not a concession there: the alias must be
// executable, and the store entry is immutable and version-keyed, so it
// costs one binary of disk and nothing in correctness. Best-effort
// throughout, matching this leaf's `-> void` contract.
fn _bootstrap_alias(abs_bin: string, alias: string) -> void ![io] {
    fs.deleteFile(alias);
    if fs.symlink(abs_bin, alias) { return; }
    if _copy_file(abs_bin, alias) { fs.set_perms(alias, 493); }
}

// Acquire + verify + install the pinned seed into the checkout's repo-local
// store, then lay the `bin/` aliases. Reuses the toolchain installer's
// fail-closed fetch/verify/extract pipeline against the bootstrap store base.
fn _bootstrap_fetch(m: BootstrapManifest) -> int ![clock, io, net] {
    let rc = toolchain_install_to_base(m.version, m.install_base, _bootstrap_work_root());
    if rc != 0 { return rc; }
    _bootstrap_link_bin(m.install_base, m.bin_dir, m.version);
    return 0;
}

// Ensure the pinned seed is present in the store, fetching (and verifying) it
// when absent. Returns 0 when the store is ready.
fn _bootstrap_ensure_seed(m: BootstrapManifest) -> int ![clock, io, net] {
    if _bootstrap_store_ready(m.install_base, m.version) { return 0; }
    let rc = _bootstrap_fetch(m);
    if rc != 0 {
        print.err("error: could not obtain the pinned seed " + m.version);
        print.err("  run: sfn dev bootstrap fetch");
        return rc;
    }
    if !_bootstrap_store_ready(m.install_base, m.version) {
        print.err("error: the pinned seed " + m.version
            + " is still not available after install");
        return 1;
    }
    return 0;
}

// Read + validate the root `bootstrap.toml`. Returns an `ok = false` manifest
// (with `error` set) on any failure so the caller can print the diagnostic and
// bail without guessing a seed.
fn _bootstrap_resolve_manifest() -> BootstrapManifest ![io] {
    return read_bootstrap_manifest(BOOTSTRAP_MANIFEST_PATH);
}

// Whether the resolved build target is something other than the host, and so
// must not be dispatched to the pinned seed. Equal triples mean a host build,
// which still dispatches — including a `--target` that names the host
// explicitly. Empty `target` is defensive only: the caller resolves through
// `build_target_triple()`, which always answers.
//
// A cross build is not a stage0 self-host. The seed's target conditioning is
// frozen at its cut, so replaying `--target=<non-host>` into it builds with
// that seed's link libs, runtime source set, and ABI flags instead of the
// working tree's. Seed 0.10.4 omitted `-lbcrypt` for the gnu ABI and could
// not read `[targets.*]` at all, which is what left `BCryptGenRandom`
// undefined on both v0.10.5 mingw legs (SFN-1108).
//
// Split out as a pure predicate so the decision is testable without a
// process re-exec; the gate below is `![clock, io, net]` and ends in
// `process.exec`.
fn _bootstrap_target_is_cross(target: string, host: string) -> boolean {
    if target.length == 0 { return false; }
    return !strings_equal(target, host);
}

// ---- The build-command gate (steady-state `sfn build -p compiler`) ----
//
// Turn `sfn build -p compiler` into the smooth contributor path: when the
// running toolchain is not the exact pinned seed, acquire it and re-exec it
// so the compiler always self-hosts from the exact released stage0. Modeled
// on `toolchain_gate_or_dispatch` (the `[toolchain]` floor gate), but keyed on
// the exact bootstrap seed rather than a floor.
//
// Safe by construction: when the running toolchain's core version already
// equals the pinned seed (the common case — a contributor on the pinned
// toolchain, and every `make compile` self-host pass), this is a no-op and
// the build proceeds in-process. Dispatch only fires for a *different*
// toolchain. `SAILFIN_BOOTSTRAP=off` (or `0`) skips the gate for the
// seed-transition window where the pin is ahead of the seed.
fn bootstrap_gate_or_dispatch(ctx: CliContext) -> int ![clock, io, net] {
    // Only a compiler checkout (root bootstrap.toml present) has a seed to
    // dispatch. An ordinary capsule build never enters this path.
    if !bootstrap_manifest_exists() { return 0; }

    let knob = env.get("SAILFIN_BOOTSTRAP");
    if strings_equal(knob, "off") || strings_equal(knob, "0") { return 0; }

    // `build_target_triple()` rather than the `--target` cell alone: it also
    // covers the `SAILFIN_TARGET_TRIPLE` and `SAILFIN_TARGET_OS` overrides,
    // which select a cross target just as really as the flag does. With none
    // of the three set it resolves to the identical call
    // `host_target_triple()` makes, so the ordinary host path is provably
    // unchanged. The `--target` cell is seeded before this gate runs
    // (`set_build_target`, `cli/commands/build.sfn`).
    if _bootstrap_target_is_cross(build_target_triple(), host_target_triple()) {
        return 0;
    }

    let m = _bootstrap_resolve_manifest();
    if !m.ok {
        print.err("error: " + m.error);
        return 1;
    }

    // Exact-seed satisfaction: the running toolchain already IS the pinned
    // seed (build metadata stripped so a `<ver>+dev.<hash>` self-host build
    // matches the released `<ver>`). Build in-process — no dispatch.
    let running = _strip_build_metadata(resolve_compiler_version(ctx.binary_dir));
    if strings_equal(running, m.version) { return 0; }

    // Re-entrancy guard: a dispatched seed re-reads bootstrap.toml and, if
    // correct, satisfies the check above and returns. Reaching here with the
    // guard set means the stored seed is the wrong version or corrupt.
    let dispatched = env.get("SAILFIN_BOOTSTRAP_DISPATCHED");
    if dispatched.length > 0 {
        print.err("error: bootstrap dispatch loop — the dispatched seed "
            + dispatched
            + " still does not satisfy the pinned seed "
            + m.version);
        print.err("  the stored seed is the wrong version or corrupt");
        print.err("  reinstall it: sfn dev bootstrap fetch");
        return 1;
    }

    // A `local-path` source has no release to fetch; the running toolchain
    // must be the seed. Emit an actionable error rather than dispatching.
    if strings_equal(m.source, "local-path") {
        print.err("error: bootstrap.toml pins a local-path seed " + m.version
            + " but the running toolchain is "
            + running);
        print.err("  build with the pinned seed on PATH, or set SAILFIN_BOOTSTRAP=off");
        return 1;
    }

    let ensured = _bootstrap_ensure_seed(m);
    if ensured != 0 { return ensured; }

    // Re-exec the stored seed, replaying the original argv. The guard is
    // threaded so the dispatched seed does not dispatch again. On a
    // process-image replacement `process.exec` never returns; a return means
    // the exec failed (missing/not-executable).
    let seed_bin = _bootstrap_seed_bin(m.install_base, m.version);
    let mut exec_argv: string[] = [seed_bin];
    let mut i: int = 0;
    loop {
        if i >= ctx.orig_args.length { break; }
        exec_argv.push(ctx.orig_args[i]);
        i += 1;
    }
    // The seed about to replace this image is chosen by `bootstrap.toml`, which
    // a cloned repository supplies. Dispatch and management routing both refuse
    // a cached-known revoked release before their own `process.exec`; this was
    // the one exec site without that check, so a revoked seed kept running for
    // as long as the pin named it. Local ledger only — no network, nothing that
    // can expire, so the self-host build stays independent of index liveness.
    let ledger_base = toolchain_versions_base();
    if ledger_base.length > 0 {
        if toolchain_revocations_corrupt(ledger_base) {
            print.err("error: the local revocation ledger is unreadable; refusing to run seed "
                + m.version);
            print.err("  " + toolchain_revocations_path(ledger_base));
            return 1;
        }
        let ledger = toolchain_revocations_read(ledger_base);
        // Read the flat store dir's manifest header, the same layout
        // `_bootstrap_store_ready` probes, so a `signing-key` revocation of
        // the seed's recorded key is caught offline too (SFN-1203). Anything
        // but OK contributes "" — an unreadable header is never presumed
        // revoked, only a recorded key id is.
        let seed_store_dir = m.install_base + "/" + m.version;
        let header = toolchain_manifest_read_header(seed_store_dir);
        let mut manifest_key_id: string = "";
        if header.status == TOOLCHAIN_MANIFEST_OK {
            manifest_key_id = header.meta.manifest_key_id;
        }
        let revoked_at = toolchain_payload_revocation_find(ledger, m.version, manifest_key_id);
        if revoked_at >= 0 {
            if ledger[revoked_at].kind == "signing-key" {
                print.err("error: the pinned bootstrap seed " + m.version
                    + " was signed by revoked key "
                    + ledger[revoked_at].subject
                    + " and will not be executed");
            } else {
                print.err("error: the pinned bootstrap seed " + m.version
                    + " is revoked and will not be executed");
            }
            print.err("  revocation has no override; pin a different seed in bootstrap.toml");
            return 1;
        }
    }

    let mut exec_env: string[] = process.environ();
    exec_env.push("SAILFIN_BOOTSTRAP_DISPATCHED=" + m.version);
    let _rc = process.exec(exec_argv, exec_env);
    print.err("error: failed to re-exec the pinned seed at " + seed_bin);
    print.err("  run: sfn dev bootstrap fetch");
    return 1;
}

// ---- `sfn dev bootstrap` subcommands ----
// fetch: acquire + verify the pinned seed only.
fn _dev_bootstrap_fetch() -> int ![clock, io, net] {
    let m = _bootstrap_resolve_manifest();
    if !m.ok {
        print.err("error: " + m.error);
        return 1;
    }
    if strings_equal(m.source, "local-path") {
        print.err("error: bootstrap.toml pins a local-path seed; nothing to fetch");
        return 1;
    }
    if _bootstrap_store_ready(m.install_base, m.version) {
        print("sfn dev bootstrap: seed " + m.version + " already present in "
            + m.install_base
            + "/"
            + m.version);
        _bootstrap_link_bin(m.install_base, m.bin_dir, m.version);
        return 0;
    }
    let rc = _bootstrap_fetch(m);
    if rc != 0 { return rc; }
    print("sfn dev bootstrap: fetched seed " + m.version + " to " + m.install_base);
    return 0;
}

// Run the pinned seed's `sfn build -p compiler` as a subprocess (not a
// process-image replacement) so the command can report a result. The seed
// binary is the exact stage0; the `SAILFIN_BOOTSTRAP_DISPATCHED` guard is not
// needed because the invoked binary IS the seed (its core version satisfies
// the pin, so its own gate is a no-op).
fn _bootstrap_compiler_build_argv(seed_bin: string, build_args: string[]) -> string[] {
    // `--skip-toolchain-check` belongs to the fixed prefix, not after the
    // forwarded tail: the driver has already resolved the exact seed binary to
    // run and must not let that child re-select a different toolchain (a
    // recorded user default, SFEP-0073 §3.3 rank 4, or an exact project pin)
    // out from under it — see workspace.toml's `dev` exclusion note — while
    // SFN-1076 requires the caller's trailing arguments to reach the seed
    // last and byte-for-byte. Appending it after them would satisfy the first
    // and quietly break the second.
    let mut argv: string[] = [seed_bin, "build", "-p", "compiler", "--skip-toolchain-check"];
    let mut i: int = 0;
    loop {
        if i >= build_args.length { break; }
        argv.push(build_args[i]);
        i += 1;
    }
    return argv;
}

fn _bootstrap_run_compiler_build(m: BootstrapManifest, build_args: string[]) -> int ![io] {
    let seed_bin = _bootstrap_seed_bin(m.install_base, m.version);
    return process.run(_bootstrap_compiler_build_argv(seed_bin, build_args));
}

// A `local-path` seed has no release to fetch; the seed must already be in
// the store (a developer override). Reject before `_bootstrap_ensure_seed`
// would try to GitHub-download the version. Returns the error string, or ""
// when the source is fetchable.
fn _bootstrap_local_path_reject(m: BootstrapManifest) -> string {
    if strings_equal(m.source, "local-path") {
        return "bootstrap.toml pins a local-path seed " + m.version
            + "; place it in the store manually — there is nothing to fetch";
    }
    return "";
}

// Whether `SAILFIN_BOOTSTRAP_FORCE` is set to a truthy value. Mirrors the
// `flag OR env` pattern other bootstrap knobs use so an agent driving the
// build from a shell (no CLI flag control) still gets the override.
fn _bootstrap_force_env() -> boolean ![io] {
    let v = env.get("SAILFIN_BOOTSTRAP_FORCE");
    return strings_equal(v, "1") || strings_equal(v, "true") || strings_equal(v, "yes");
}

// build: fetch if needed, then build the compiler with the exact seed —
// but only when the source fingerprint changed (or `force` is set). The
// fingerprint is snapshotted BEFORE the seed build runs (`pre`) and
// re-checked AFTER it completes (`post`): a mismatch means the sources
// changed mid-build, so the freshly built binary is refused rather than
// published as if it matched `pre`. The stored fingerprint is only ever
// promoted after the binary is installed — never before — so an
// interrupted run cannot leave a stored fingerprint claiming a binary
// that was never installed.
fn _dev_bootstrap_build(force: boolean, build_args: string[]) -> int ![clock, io, net] {
    let m = _bootstrap_resolve_manifest();
    if !m.ok {
        print.err("error: " + m.error);
        return 1;
    }
    let lp = _bootstrap_local_path_reject(m);
    if lp.length > 0 {
        print.err("error: " + lp);
        return 1;
    }

    let pre = compute_workspace_source_fingerprint(".");
    if pre.length == 0 {
        print.err("error: could not compute the compiler source fingerprint");
        return 1;
    }

    let out = native_install_path();
    // Explicit seed-build arguments are diagnostic intent: skipping here
    // would accept them without ever forwarding them to the pinned seed.
    // The empty-tail path keeps the existing fingerprint behavior exactly.
    if !force && build_args.length == 0 {
        let stored = read_stored_fingerprint(source_fingerprint_path());
        if fs.is_executable(out) && stored.length > 0 && stored == pre {
            print("sfn dev bootstrap: " + out
                + " is up to date (source fingerprint "
                + substring(pre, 0, 12)
                + "); skipping build");
            return 0;
        }
    }

    write_fingerprint(pending_fingerprint_path(), pre);

    let ensured = _bootstrap_ensure_seed(m);
    if ensured != 0 {
        fs.deleteFile(pending_fingerprint_path());
        return ensured;
    }
    print("sfn dev bootstrap: building compiler with seed " + m.version);
    let rc = _bootstrap_run_compiler_build(m, build_args);
    if rc != 0 {
        fs.deleteFile(pending_fingerprint_path());
        print.err("error: compiler build failed (seed " + m.version + ", exit "
            + int_to_string(rc)
            + ")");
        return rc;
    }

    let post = compute_workspace_source_fingerprint(".");
    if post.length == 0 || post != pre {
        fs.deleteFile(pending_fingerprint_path());
        print.err("error: compiler sources changed during the build; refusing to publish a stale binary");
        return 1;
    }

    // Smoke-verify the built artifact BEFORE it replaces anything (SFN-679).
    // Publishing first and checking after would swap a working `build/bin/sfn`
    // for a broken one on every bad build, leaving the developer with no
    // usable compiler; and recording freshness for a binary that does not run
    // would wedge every later build into "up to date" against it, escapable
    // only via --force. Verifying the source artifact keeps a failed build
    // purely additive: the previously installed compiler is untouched.
    // SFN-1068 / SFEP-0073 §3.3: prove the freshly built binary runs, not
    // that its per-user default toolchain resolves.
    let smoke_rc = process.run([built_program_path(), "version", "--skip-toolchain-check"]);
    if smoke_rc != 0 {
        fs.deleteFile(pending_fingerprint_path());
        print.err("error: the compiler built at " + built_program_path()
            + " failed its smoke check (exit "
            + int_to_string(smoke_rc)
            + "); "
            + out
            + " was left unchanged");
        return 1;
    }

    if !install_built_compiler(built_program_path(), out) {
        fs.deleteFile(pending_fingerprint_path());
        print.err("error: could not install the built compiler to " + out);
        return 1;
    }

    if !_atomic_rename_into_place(pending_fingerprint_path(), source_fingerprint_path()) {
        write_fingerprint(source_fingerprint_path(), pre);
        fs.deleteFile(pending_fingerprint_path());
    }

    print("sfn dev bootstrap: installed " + out + " (seed " + m.version + ")");
    return 0;
}

// fingerprint: print the source digest alone on stdout (no roots given
// uses the default scope). A Makefile/CI captures this with `$(...)`, so
// nothing else may reach stdout here.
fn _dev_bootstrap_fingerprint(roots: string[]) -> int ![io] {
    let mut digest = "";
    if roots.length == 0 {
        digest = compute_workspace_source_fingerprint(".");
    } else { digest = compute_source_fingerprint(roots); }
    if digest.length == 0 {
        print.err("error: could not compute the compiler source fingerprint");
        return 1;
    }
    print(digest);
    return 0;
}

// Whether `s` has the shape of a fingerprint this compiler produced: 64
// lowercase hex characters. Anything else is treated as absent rather
// than as a conflicting snapshot (SFN-679).
fn _looks_like_digest(s: string) -> boolean {
    let mut start: int = 0;
    if s.length == 67 && substring(s, 0, 3) == "v2-" { start = 3; } else if s.length != 64 {
        return false;
    }
    let mut i: int = start;
    loop {
        if i >= s.length { break; }
        let c = char_code(s[i]);
        let is_digit = c >= 48 && c <= 57;
        let is_lower_hex = c >= 97 && c <= 102;
        if !is_digit && !is_lower_hex { return false; }
        i += 1;
    }
    return true;
}

// install: publish an already-built compiler binary (from `from_path`, or
// `build/capsules/sfn/compiler/bin/compiler` by default) as the canonical
// `build/bin/sfn`, or as `<destdir><prefix>/bin/sfn` when a packaging path
// is requested.
// The post-build publish half of `_dev_bootstrap_build`, invoked by the
// Makefile from the freshly built binary. Applies the same
// pending-fingerprint race guard: if the sources changed since the build
// that produced `src` was snapshotted, refuse to publish it.
//
// Unlike `_dev_bootstrap_build`, `install` may run with no trustworthy
// pre-build snapshot at all — a clean checkout has no prior `build/bin/sfn`
// to have taken one from, and a binary predating SFN-679 cannot produce one.
// Both degrade to "install, but do not record a freshness claim nobody
// checked" rather than failing the completed build outright (SFN-679).
fn _dev_bootstrap_install(from_path: string, prefix: string, destdir: string) -> int ![io] {
    let mut src = from_path;
    if src.length == 0 { src = built_program_path(); }
    if !fs.exists(src) {
        print.err("error: no built compiler at " + src);
        return 1;
    }

    let effective_prefix = _dev_bootstrap_install_prefix(prefix, destdir);
    let mut out = _dev_bootstrap_install_path(prefix, destdir);
    if out.length == 0 {
        print.err("error: could not determine the default install prefix because the home directory is unset");
        return 1;
    }

    if destdir.length > 0 {
        if _bootstrap_has_parent_segment(destdir) {
            print.err("error: DESTDIR contains a parent path component: "
                + destdir);
            return 1;
        }
        if _bootstrap_has_parent_segment(effective_prefix) {
            print.err("error: install prefix contains a parent path component and escapes DESTDIR: "
                + effective_prefix);
            return 1;
        }
    }

    let canonical = _bootstrap_install_is_canonical(prefix, destdir);
    let mut live_prefixed = !canonical && destdir.length == 0;
    let mut staged_prefixed = false;
    if !canonical && destdir.length > 0 {
        let prepared_destdir = _bootstrap_prepare_destdir(destdir, _dirname(out));
        if prepared_destdir.kind < 0 { return 1; }
        live_prefixed = prepared_destdir.kind == 1;
        staged_prefixed = prepared_destdir.kind == 0;
        if staged_prefixed {
            // Stop using the caller's lexical DESTDIR after validation. A
            // later swap of an alias/junction ancestor must not retarget the
            // lock, staging tree, backups, or publication paths.
            out = _path_join(prepared_destdir.physical_bin, _path_basename(out));
        }
    }
    if live_prefixed && !_bootstrap_dev_owns_install(out) {
        print.err("error: refusing to overwrite the existing entry executable at "
            + out);
        print.err("  it is not an unchanged sfn dev install and may be owned by a package manager");
        print.err("  remove it explicitly before publishing a local self-build to this prefix");
        return 1;
    }

    // A prefixed publish does not make `build/bin/sfn` fresh. Keep the
    // canonical fingerprint transaction below isolated so installing onto
    // PATH cannot make a stale repo-local compiler pass the next build gate.
    if !canonical {
        // SFN-1068 / SFEP-0073 §3.3: prove the freshly built binary runs, not
        // that its per-user default toolchain resolves.
        let smoke_rc = process.run([src, "version", "--skip-toolchain-check"]);
        if smoke_rc != 0 {
            print.err("error: the compiler at " + src
                + " failed its smoke check (exit "
                + int_to_string(smoke_rc)
                + "); "
                + out
                + " was left unchanged");
            return 1;
        }
        let lock_path = out + ".sfn-dev-install.lock";
        if !ensure_dir_p(_dirname(out)) {
            print.err("error: could not create the local compiler install directory "
                + _dirname(out));
            return 1;
        }
        let lock_claim = _create_exclusive_cmd(lock_path, CREATE_EXCLUSIVE_MODE_FILE);
        if lock_claim != CREATE_EXCLUSIVE_CREATED {
            print.err("error: another local compiler install owns " + lock_path);
            return 1;
        }
        let validated_publish_bin = _bootstrap_realpath(_dirname(out));
        if validated_publish_bin.length == 0 || (staged_prefixed && !_bootstrap_physical_paths_equal(validated_publish_bin, _dirname(out))) {
            fs.deleteFile(lock_path);
            print.err("error: install path changed after destination validation: "
                + _dirname(out));
            return 1;
        }
        let payload_staging = _bootstrap_stage_dev_payload(src, out, live_prefixed);
        if payload_staging.length == 0 {
            fs.deleteFile(lock_path);
            print.err("error: could not stage the local compiler runtime payload");
            return 1;
        }
        // Staging copies the full runtime closure and can take long enough
        // for an external writer to replace the entry after the initial
        // ownership check. Revalidate while holding the dev-writer lock at
        // the commit boundary so that replacement is preserved, not buried.
        if live_prefixed && !_bootstrap_dev_owns_install(out) {
            remove_tree(payload_staging);
            fs.deleteFile(lock_path);
            print.err("error: refusing to overwrite the existing entry executable at "
                + out);
            print.err("  it changed while the local compiler bundle was being staged and may be owned by a package manager");
            print.err("  remove it explicitly before publishing a local self-build to this prefix");
            return 1;
        }
        let resolved_publish_bin = _bootstrap_realpath(_dirname(out));
        if resolved_publish_bin.length == 0 || !_bootstrap_physical_paths_equal(resolved_publish_bin, validated_publish_bin) {
            print.err("error: install path changed before publication: "
                + _dirname(out));
            print.err("  transaction artifacts were preserved because the original directory can no longer be addressed safely");
            return 1;
        }
        // Switch the process cwd to the validated physical bin directory and
        // publish only relative names. Both POSIX and Win32 retain the current
        // directory as a stable kernel reference, so a concurrent rename or
        // junction swap of a DESTDIR ancestor cannot retarget the transaction.
        let prior_cwd = _cwd_cmd();
        let publish_bin = _bootstrap_realpath(_dirname(out));
        if prior_cwd.length == 0 || publish_bin.length == 0 || !_bootstrap_physical_paths_equal(publish_bin, validated_publish_bin)
            || !_set_current_directory(publish_bin) {
            print.err("error: could not anchor the install directory for publication: "
                + _dirname(out));
            print.err("  transaction artifacts were preserved because the original directory can no longer be addressed safely");
            return 1;
        }
        let anchored_cwd = _cwd_cmd();
        if !_bootstrap_physical_paths_equal(anchored_cwd, publish_bin) {
            remove_tree(_path_basename(payload_staging));
            fs.deleteFile(_path_basename(lock_path));
            _set_current_directory(prior_cwd);
            print.err("error: install directory changed while publication was being anchored: "
                + _dirname(out));
            return 1;
        }
        let relative_staging = _path_basename(payload_staging);
        let relative_lock = _path_basename(lock_path);
        let committed = _bootstrap_commit_dev_payload(relative_staging, _path_basename(out), live_prefixed);
        // Keep cleanup within the stable cwd reference. Releasing the anchor
        // first would let absolute names re-traverse a replaced DESTDIR tree.
        if !committed { remove_tree(relative_staging); }
        fs.deleteFile(relative_lock);
        let cwd_restored = _set_current_directory(prior_cwd);
        if !cwd_restored {
            print.err("error: installed the compiler but could not restore the working directory "
                + prior_cwd);
        }
        if !committed || !cwd_restored {
            print.err("error: could not commit the local compiler bundle at "
                + out);
            return 1;
        }
        print("sfn dev bootstrap: installed " + out);
        return 0;
    }

    let cur = compute_workspace_source_fingerprint(".");
    if cur.length == 0 {
        // Not fatal: an unhashable tree (unreadable input, allocation
        // failure, or a file over the binary-read size cap) must not
        // abort an otherwise-completed ~10-minute build at the final step
        // (SFN-679).
        print.err("warning: could not compute the compiler source fingerprint; installing without a freshness record");
    }

    let pending_path = pending_fingerprint_path();
    let pending = read_stored_fingerprint(pending_path);
    // Only a well-formed digest counts as a pre-build snapshot. A
    // `build/bin/sfn` predating SFN-679 has no `dev bootstrap
    // fingerprint` leaf, so the Makefile's pre-build capture can leave
    // usage text here during the one transitional build; treating that
    // as a mid-build source change would fail the build outright
    // instead of self-healing.
    let have_snapshot = _looks_like_digest(pending);

    let mut comparable = cur;
    if pending.length == 64 {
        comparable = compute_source_fingerprint(default_fingerprint_roots());
    }

    if have_snapshot && comparable.length > 0 && pending != comparable {
        fs.deleteFile(pending_path);
        print.err("error: compiler sources changed during the build; refusing to publish a stale binary");
        return 1;
    }

    // Smoke-verify the candidate BEFORE it replaces anything (SFN-679), so a
    // build that produced an unrunnable binary leaves the previously
    // installed compiler intact rather than swapping a working toolchain for
    // a broken one. See `_dev_bootstrap_build` for the full rationale.
    // SFN-1068 / SFEP-0073 §3.3: prove the freshly built binary runs, not
    // that its per-user default toolchain resolves.
    let smoke_rc = process.run([src, "version", "--skip-toolchain-check"]);
    if smoke_rc != 0 {
        fs.deleteFile(pending_path);
        print.err("error: the compiler at " + src
            + " failed its smoke check (exit "
            + int_to_string(smoke_rc)
            + "); "
            + out
            + " was left unchanged");
        return 1;
    }

    if !install_built_compiler(src, out) {
        print.err("error: could not install the built compiler to " + out);
        return 1;
    }

    let promotable_v2 = pending.length == 67 && substring(pending, 0, 3) == "v2-";
    if have_snapshot && promotable_v2 && cur.length > 0 && comparable.length > 0
        && pending == comparable {
        write_fingerprint(source_fingerprint_path(), cur);
        fs.deleteFile(pending_path);
    } else {
        fs.deleteFile(pending_path);
        print("sfn dev bootstrap: no trustworthy pre-build source snapshot; freshness record not written — the next build will re-run (SFN-679)");
    }

    print("sfn dev bootstrap: installed " + out);
    return 0;
}

// check: build with the exact seed, then smoke-verify the built compiler.
fn _dev_bootstrap_check() -> int ![clock, io, net] {
    let m = _bootstrap_resolve_manifest();
    if !m.ok {
        print.err("error: " + m.error);
        return 1;
    }
    let lp = _bootstrap_local_path_reject(m);
    if lp.length > 0 {
        print.err("error: " + lp);
        return 1;
    }
    let ensured = _bootstrap_ensure_seed(m);
    if ensured != 0 { return ensured; }
    print("sfn dev bootstrap: building compiler with seed " + m.version);
    let no_build_args: string[] = [];
    let build_rc = _bootstrap_run_compiler_build(m, no_build_args);
    if build_rc != 0 {
        print.err("error: compiler build failed (seed " + m.version + ", exit "
            + int_to_string(build_rc)
            + ")");
        return build_rc;
    }
    let built = built_program_path();
    if !fs.exists(built) {
        print.err("error: build did not produce " + built);
        return 1;
    }
    // SFN-1068 / SFEP-0073 §3.3: prove the freshly built binary runs, not
    // that its per-user default toolchain resolves.
    let smoke_rc = process.run([built, "version", "--skip-toolchain-check"]);
    if smoke_rc != 0 {
        print.err("error: the built compiler failed its smoke check (exit "
            + int_to_string(smoke_rc)
            + ")");
        return smoke_rc;
    }
    print("sfn dev bootstrap: seed " + m.version + " built a working compiler");
    return 0;
}

// pin: update bootstrap.toml [seed].version. The public `[toolchain]` /
// `[capsule].version` bump stays a deliberate, separately-reviewed step —
// this prints the reminder rather than editing the compiler manifest.
fn _dev_bootstrap_pin(new_version: string) -> int ![io] {
    if new_version.length == 0 {
        print.err("error: sfn dev bootstrap pin requires a <version>");
        print.err("usage: sfn dev bootstrap pin <version>");
        return 2;
    }
    let mut ver = new_version;
    if starts_with(ver, "v") { ver = substring(ver, 1, ver.length); }
    if !bootstrap_manifest_exists() {
        print.err("error: no bootstrap.toml at " + BOOTSTRAP_MANIFEST_PATH
            + " — run inside a compiler checkout");
        return 1;
    }
    let text = fs.readFile(BOOTSTRAP_MANIFEST_PATH);
    let rewritten = rewrite_seed_version(text, ver);
    if rewritten.length == 0 {
        print.err("error: could not find [seed].version in "
            + BOOTSTRAP_MANIFEST_PATH);
        return 1;
    }
    fs.writeFile(BOOTSTRAP_MANIFEST_PATH, rewritten);
    print("sfn dev bootstrap: pinned seed " + ver);
    print("  updated bootstrap.toml [seed].version");
    print("  remember to bump compiler/capsule.toml [toolchain].sfn and [capsule].version when the source version advances (SFEP-0047 §3.4)");
    return 0;
}

// The `sfn/cli` definition for `dev`, registered on the v2 root. Three nested
// groups: `bootstrap` (fetch/build/check/pin/fingerprint/install leaves),
// `shard` (the CI test-shard surface, SFN-200), and `arena` (the arena IR
// equivalence gate, SFN-201).
fn command_def() -> Command {
    let mut bootstrap: Command = command("bootstrap", "Compiler seed bootstrap (reads bootstrap.toml)");
    bootstrap = with_subcommand(bootstrap, command("fetch", "Acquire and verify the pinned seed"));
    let mut build = with_flag(command("build", "Build the compiler with the exact seed"), flag("force", "Rebuild even when the source fingerprint is unchanged"));
    // SFN-1120. Unlike `sfn test` / `sfn build`, this leaf spawns the seed
    // with a constructed argv, so the flag is never forwarded to the child.
    build = with_flag(build, flag("verdict", "Emit a machine-readable sailfin-run/2 verdict trailer after the run"));
    build = with_arg(build, arg_variadic("build-arg", "Arguments forwarded to the seed build after --"));
    bootstrap = with_subcommand(bootstrap, build);
    bootstrap = with_subcommand(bootstrap, command("check", "Build then smoke-verify the compiler"));
    bootstrap = with_subcommand(bootstrap, with_arg(command("pin", "Update the pinned seed version"), arg("version", "Seed version to pin (e.g. 0.8.0-alpha.4)")));
    bootstrap = with_subcommand(bootstrap, with_arg(command("fingerprint", "Print the compiler source fingerprint"), arg_variadic("root", "Source roots to hash (default: workspace maintainer + explicit inputs)")));
    let mut install = with_flag(command("install", "Publish an already-built compiler locally or under an install prefix"), flag_value("from", "Path to the built compiler binary (default: build/capsules/sfn/compiler/bin/compiler)"));
    install = with_flag(install, flag_value("prefix", "Install under <dir>/bin instead of build/bin"));
    install = with_flag(install, flag_value("destdir", "Prepend a packaging staging root to the install prefix"));
    bootstrap = with_subcommand(bootstrap, install);
    let mut dev: Command = with_subcommand(command("dev", "Compiler/toolchain maintainer commands"), bootstrap);
    dev = with_subcommand(dev, shard_command_def());
    dev = with_subcommand(dev, arena_command_def());
    dev = with_subcommand(dev, det_sweep_command_def());
    dev = with_subcommand(dev, clean_command_def());
    dev = with_subcommand(dev, verify_command_def());
    dev = with_subcommand(dev, inventory_command_def());
    return dev;
}

// Dispatch the parsed `dev` subcommand. `subcommand(matches)` returns the
// deepest leaf (`fetch`/`build`/`check`/`pin`); a bare `sfn dev` or
// `sfn dev bootstrap` prints usage.
fn run(matches: Matches, ctx: CliContext) -> int ![clock, io, net] {
    // `sfn dev shard <leaf>` routes to the shard surface; the descent path's
    // second element (`["dev", "shard", ...]`) distinguishes it from the
    // `bootstrap` group whose leaves are dispatched below.
    let path: string[] = subcommand_path(matches);
    if path.length >= 2 && strings_equal(path[1], "shard") {
        return shard_run(matches, ctx);
    }
    // `sfn dev arena [--all] [<module>...]` routes to the arena equivalence
    // gate; the descent path's second element (`["dev", "arena"]`)
    // distinguishes it from the `bootstrap` leaves dispatched below.
    if path.length >= 2 && strings_equal(path[1], "arena") {
        return arena_run(matches, ctx);
    }
    // `sfn dev determinism-sweep [--seed …] [--jobs N] [--iters N] [--out DIR]
    // [path…]` routes to the emit-hashing determinism harness (SFN-202); the
    // descent path's second element (`["dev", "determinism-sweep"]`)
    // distinguishes it from the `bootstrap` leaves dispatched below.
    if path.length >= 2 && strings_equal(path[1], "determinism-sweep") {
        return det_sweep_run(matches, ctx);
    }
    // `sfn dev clean <build|dist|all>` routes to the repo-local artifact
    // cleaner (SFN-680); the descent path's second element
    // (`["dev", "clean", ...]`) is what keeps its `build` leaf from being
    // taken for the `bootstrap` leaf of the same name dispatched below.
    if path.length >= 2 && strings_equal(path[1], "clean") {
        return clean_run(matches, ctx);
    }
    // `sfn dev verify [--fast] [--full-pass1] [--json] [--strict] [--jobs N]
    // [--test-timeout SECS]` routes to the native pipeline supervisor
    // (SFN-725); the descent path's second element (`["dev", "verify"]`)
    // keeps it clear of the `bootstrap` leaves dispatched below.
    if path.length >= 2 && strings_equal(path[1], "verify") {
        return verify_run(matches, ctx);
    }
    if path.length >= 2 && strings_equal(path[1], "inventory") {
        return inventory_run(matches, ctx);
    }
    // Everything past this point is a `bootstrap` leaf, matched on the leaf
    // name alone — so the `path[1]` guards above are load-bearing, not
    // stylistic. A new `dev <group>` whose leaf collides with a `bootstrap`
    // leaf (`build`, `check`, `fetch`, `pin`, `fingerprint`, `install`) is
    // claimed by the wrong handler unless it adds its own `path[1]` guard
    // here. That is the same defect SFN-1085 removed from the root dispatch
    // (`_v2_is_command` in `cli/main.sfn`, which gates on `subcommand_path[0]`
    // so ordering carries no meaning); at this level the ordering is still
    // what keeps the groups apart.
    let sub: string = subcommand(matches);
    if strings_equal(sub, "fetch") { return _dev_bootstrap_fetch(); }
    if strings_equal(sub, "build") {
        let force = has_flag(matches, "force") || _bootstrap_force_env();
        return _dev_bootstrap_build(force, positionals(matches, "build-arg"));
    }
    if strings_equal(sub, "check") { return _dev_bootstrap_check(); }
    if strings_equal(sub, "pin") {
        return _dev_bootstrap_pin(get(matches, "version"));
    }
    if strings_equal(sub, "fingerprint") {
        return _dev_bootstrap_fingerprint(positionals(matches, "root"));
    }
    if strings_equal(sub, "install") {
        return _dev_bootstrap_install(get(matches, "from"), get(matches, "prefix"), get(matches, "destdir"));
    }
    print("usage: sfn dev bootstrap <fetch|build|check|pin|fingerprint|install>");
    return 2;
}

export {
    BootstrapInstallBackup,
    bootstrap_gate_or_dispatch,
    command_def,
    run,
    // Exported for regression coverage (compiler/tests/unit).
    _bootstrap_alias,
    _bootstrap_compiler_build_argv,
    _bootstrap_is_absolute,
    _bootstrap_install_is_canonical,
    _bootstrap_commit_dev_payload,
    _bootstrap_prefixed_install_path,
    _bootstrap_restore_after_entry_claim,
    _bootstrap_target_is_cross
};
