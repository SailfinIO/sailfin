import { Matches, get_int, has } from "sfn/cli";

import { _shell_read_cmd } from "../../../build/fs";
import { build_host_os } from "../../../build/target";
import { _get_env_cmd } from "../../../build_flags";
import { _has_prefix_cmd } from "../../../string_cmd_utils";
import {
    char_code_at_text,
    find_char_local,
    strings_equal,
    substring
} from "../../../string_utils";

// #1236: parse the `--jobs N` value for `sfn test`. Returns the
// parsed worker count, or `-1` for anything that is not a plain
// positive decimal integer in [1, 256]. The 256 ceiling is a sanity
// cap, not a tuning hint: every pooled child is a full compiler
// invocation whose leaf compile can peak at multiple GB. Explicit
// `--jobs 1` keeps the byte-identical serial path; absent an override,
// `_resolve_test_jobs` chooses a RAM+CPU-aware native default.
fn _parse_jobs_value(text: string) -> int {
    if text.length == 0 { return -1; }
    let mut i: int = 0;
    let mut n: int = 0;
    loop {
        if i >= text.length { break; }
        let c = char_code_at_text(text, i);
        if c < 48 { return -1; }
        if c > 57 { return -1; }
        n = n * 10 + (c - 48);
        if n > 256 { return -1; }
        i += 1;
    }
    if n < 1 { return -1; }
    return n;
}

// SFN-91: pure half of the native test-worker budget —
// `min(cores, (usable_RAM - parent_reserve) / per_job_reserve)` with a floor
// of 1, a global cap of 16, and a Darwin cap of 2 for nested cold-build
// tests. Unknown RAM is deliberately fail-closed to serial: the test pool has
// no shared RLIMIT_AS backstop, so CPU-only fan-out can OOM a small host.
// The emit fan-out's `_cr_ram_budget_jobs` is fail-open by contrast, and
// would rather over-fan than starve a build on a host it cannot measure.
// That is one of four deliberate divergences between the two policies; see
// the SFN-781 note below for the other three.
//
// SFN-547 established that the reserve must be sized for the heaviest child
// rather than the light unit-test majority: the previous 384 MiB figure
// under-counted the build-and-run class by ~8x, handed a 14 GiB host 16 jobs,
// and OOMed it outright. `RLIMIT_AS` bounds each process, not the fleet — N
// children multiply the 8 GiB cap — so this arithmetic is the only thing
// standing between the pool and the host's RAM. `_pool_child_env` pins each
// child's own emit fan-out to serial, which is what makes
// `jobs * per_job_reserve` an honest bound rather than a floor.
//
// SFN-781 corrected two defects in that sizing. The reserve had been borrowed
// verbatim from the emit fan-out (`_cr_ram_budget_jobs`,
// `compiler/src/capsule_emit_parallel.sfn`) on the theory that a test child's
// peak is the nested emit it spawns. It is not: a pooled `--no-test-cache`
// test child was measured at 2.63-3.08 GiB steady-state against the 1.55 GiB
// emit worker SFN-626 sized that figure from. And the parent runner was not a
// term at all, despite being the largest single process in the tree
// (3.65-4.85 GiB measured) and therefore always the OOM victim — it is not a
// thin orchestrator, since `_run_multi_file` compiles the whole dependency
// closure in-process via `_prewarm_test_dep_closures` before fanning out.
// Together those two omissions prescribed `--jobs 4` on a 16 GiB / 4-core
// host, which peaked at 17.26 GiB tree RSS and was SIGKILLed.
//
// The two reserves are therefore deliberately no longer equal, and must not
// be re-unified: they are sized against different workloads. SFN-781 scoped
// `_cr_ram_budget_jobs` explicitly out, so the emit fan-out keeps 2.5 GiB out
// of 66%.
//
// This function is the sole implementation of the policy. A bash
// reimplementation shadowed it for the Makefile's pre-binary `TEST_JOBS ?=`
// default, which had to size the pool before any `sfn` binary existed to
// ask; SFEP-0074 §5.2 retired both. Job sizing now resolves here for every
// caller — `_resolve_test_jobs` applies `--jobs` > `SAILFIN_TEST_JOBS` >
// this budget — so a constant edited below takes effect everywhere at once.
// Do not reintroduce a second form: the previous one agreed with this
// arithmetic only by the accident of these constants landing on whole-MiB
// thresholds, and a slice or reserve change would have separated them
// silently, by one job, in narrow RAM windows.
fn _test_jobs_budget(memsize_bytes: int, nproc: int, is_darwin: boolean) -> int {
    if memsize_bytes <= 0 { return 1; }
    let mut cores = nproc;
    if cores < 1 { cores = 1; }
    // 3 GiB per pooled child — the 2.63-3.08 GiB steady-state band measured
    // across a full `--no-test-cache` run (SFN-781), rounded to a whole GiB.
    // That rounds ~80 MiB/job *below* the band's maximum rather than above it;
    // the shortfall is absorbed by the 20% non-reserved remainder. Deliberately
    // not the emit fan-out's 2.5 GiB: that was sized from a 1.55 GiB emit
    // worker, which is the wrong workload for this pool.
    let per_job_bytes: int = 3221225472;
    // 5 GiB for the parent runner, which prewarms the dependency closure
    // in-process before fanning out. Sized just above the top of the
    // 3.65-4.85 GiB measured range, per this file's standing "budget the
    // heaviest, not the common" rule (SFN-547).
    let parent_reserve_bytes: int = 5368709120;
    // 80% slice of physical RAM. This is deliberately larger than the emit
    // fan-out's 66%: that 34% remainder was absorbing the parent runner as
    // well as the `clang`/`llvm-link` grandchildren and the OS. Now that the
    // parent is an explicit term, keeping 66% would double-count it and
    // prescribe serial on a host that comfortably runs two jobs. The
    // remaining 20% covers the grandchildren, the OS, and page cache.
    let usable: int = memsize_bytes * 80 / 100;
    // A host that cannot seat the parent alone has no budget to divide.
    if usable <= parent_reserve_bytes { return 1; }
    let mut by_mem = (usable - parent_reserve_bytes) / per_job_bytes;
    if by_mem < 1 { by_mem = 1; }
    let mut jobs = cores;
    if by_mem < jobs { jobs = by_mem; }
    // macOS caps at 2 regardless of what the memory arithmetic allows. On the
    // ~7 GiB macOS runner the budget alone let enough heavy children coincide
    // to tip the pool into OOM: the macOS-arm64 nightly self-host check kept
    // aborting with exit 134 / SIGABRT in the e2e phase, the victim test
    // roaming run to run (SFN-87). A flat 2-job cap bounds the
    // concurrent-heavy-compile peak. Linux is unaffected, and an explicit
    // `--jobs N` or `SAILFIN_TEST_JOBS=N` still wins.
    if is_darwin && jobs > 2 { jobs = 2; }
    // `--jobs` accepts [1, 256], but the sliding-window pool has diminishing
    // returns past core count; 16 matches the workflow cap used elsewhere in
    // CI.
    if jobs > 16 { jobs = 16; }
    if jobs < 1 { jobs = 1; }
    return jobs;
}

// Native host probe for test-runner parallelism. This reuses the compiler's
// popen-backed `_shell_read_cmd` primitive (also used by the emit fan-out
// clamp) rather than depending on the Makefile or a helper script. Linux and
// Darwin have reliable probes.
//
// Windows is checked FIRST, ahead of the `uname` shell probe below: native
// Windows has no POSIX shell, so `_shell_read_cmd("uname -s ...")` degrades
// to empty output and would otherwise fall through to the unknown-host
// serial floor (SFN-980). `build_host_os()` is the de-shelled host
// resolver already used by the emit fan-out
// (`compiler/src/capsule_emit_parallel.sfn`). The CPU count comes from
// `NUMBER_OF_PROCESSORS`, mirroring `_cr_host_cpu_count`'s Windows arm; the
// RAM probe is `windows_physical_ram_bytes`, an `extern fn` resolved at
// link time against the target-conditioned `rlimit`/`rlimit_windows`
// runtime pair (see `capsule_emit_parallel.sfn`'s matching declaration for
// why this cannot be a plain cross-module import). It returns 0 on any
// failure — `_test_jobs_budget` floors that to 1, preserving this
// function's fail-closed policy exactly as an unmeasurable Linux/Darwin
// host does.
extern fn windows_physical_ram_bytes() -> i64;

fn _resolve_auto_test_jobs() -> int ![io] {
    if build_host_os() == "Windows" {
        let cores = _parse_positive_decimal_cmd(_get_env_cmd("NUMBER_OF_PROCESSORS"));
        let memory = windows_physical_ram_bytes() as int;
        return _test_jobs_budget(memory, cores, false);
    }
    let host = _shell_read_cmd("uname -s 2>/dev/null");
    let mut is_darwin: boolean = false;
    let mut cores_text: string = "";
    let mut mem_text: string = "";
    if _has_prefix_cmd(host, "Linux") {
        cores_text = _shell_read_cmd("{ nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1; }");
        mem_text = _shell_read_cmd("awk '/^MemTotal:/{printf \"%d\", $2*1024; exit}' /proc/meminfo 2>/dev/null");
    } else {
        if _has_prefix_cmd(host, "Darwin") {
            is_darwin = true;
            cores_text = _shell_read_cmd("sysctl -n hw.ncpu 2>/dev/null");
            mem_text = _shell_read_cmd("sysctl -n hw.memsize 2>/dev/null");
        } else { return 1; }
    }
    let cores = _parse_positive_decimal_cmd(cores_text);
    let memory = _parse_positive_decimal_cmd(mem_text);
    return _test_jobs_budget(memory, cores, is_darwin);
}

// Parse an unbounded positive decimal host measurement. `_parse_jobs_value`
// intentionally caps at 256, which is correct for worker counts but not RAM
// byte totals.
fn _parse_positive_decimal_cmd(text: string) -> int {
    if text.length == 0 { return -1; }
    let mut value: int = 0;
    let mut i: int = 0;
    loop {
        if i >= text.length { break; }
        let c = char_code_at_text(text, i);
        if c < 48 { return -1; }
        if c > 57 { return -1; }
        value = value * 10 + (c - 48);
        i += 1;
    }
    if value < 1 { return -1; }
    return value;
}

// Resolve test jobs with one precedence contract shared by direct tests and
// `sfn dev shard run`: explicit flag > SAILFIN_TEST_JOBS > host auto-budget.
// A malformed environment override fails closed to serial; explicit range
// errors are returned to the caller so the normal usage error remains intact.
fn _resolve_test_jobs(matches: Matches) -> int ![io] {
    if has(matches, "jobs") { return get_int(matches, "jobs"); }
    let env_jobs = _get_env_cmd("SAILFIN_TEST_JOBS");
    if env_jobs.length > 0 {
        let parsed = _parse_jobs_value(env_jobs);
        if parsed < 1 { return 1; }
        return parsed;
    }
    return _resolve_auto_test_jobs();
}

// `sailfin test --shard I/N` partitioning (issue #1237, test-infra
// Phase 4 Track A). Moves shard partitioning out of `scripts/test_shards.sh`'s
// awk stride into the runner: one tested home for the shard map, reusable
// by the Makefile / CI / nightly. The partition mirrors that script's
// `(NR - 1) % n == (i - 1)` stride over the sorted file list, so the
// runner's `--shard` and the legacy bash shard map agree byte-for-byte
// over the same discovery surface.
//
// API shape note: these helpers return only `int` / `boolean` so their
// signatures resolve across modules in the pinned seed. A struct-valued
// `_parse_shard_value(...) -> ShardSpec` and an array-valued
// `_shard_select_indices(...) -> int[]` were the natural first cut, but a
// *cross-module* call to a function returning a freshly-declared struct or
// an `int[]` cannot resolve its return type in the seed
// (`llvm lowering [fatal]: ... callee signature is not known`) — `int[]`
// was, in fact, the only such return type in the whole compiler. Tracked
// as a separate compiler-robustness follow-up; the `int`/`boolean` surface
// below is exactly as testable.
// Parse one positive decimal field (the `I` or `N` of `I/N`). Returns -1
// on an empty string or any non-digit byte, matching `_parse_jobs_value`.
// No 256 ceiling: a shard total is bounded by the discovered file surface,
// not by per-child memory like `--jobs`.
fn _parse_shard_field(text: string) -> int {
    if text.length == 0 { return -1; }
    let mut i: int = 0;
    let mut n: int = 0;
    loop {
        if i >= text.length { break; }
        let c = char_code_at_text(text, i);
        if c < 48 { return -1; }
        if c > 57 { return -1; }
        n = n * 10 + (c - 48);
        i += 1;
    }
    if n < 1 { return -1; }
    return n;
}

// Parse and fully validate a `--shard I/N` value, returning the field
// selected by `which` (0 = I, 1 = N), or -1 when the spec is malformed.
// A valid spec is exactly one '/', both sides positive integers, and
// `1 <= I <= N`; any deviation ("", "2", "0/3", "4/3", "a/3", "1/2/3")
// yields -1. The two public wrappers below expose the I and N fields.
fn _parse_shard_field_at(text: string, which: int) -> int {
    let slash = find_char_local(text, "/", 0);
    if slash < 0 { return -1; }
    let lhs = substring(text, 0, slash);
    let rhs = substring(text, slash + 1, text.length);
    // A second '/' (e.g. "1/2/3") is malformed: the right field must
    // contain no further slash.
    if find_char_local(rhs, "/", 0) >= 0 { return -1; }
    let index = _parse_shard_field(lhs);
    let total = _parse_shard_field(rhs);
    if index < 1 { return -1; }
    if total < 1 { return -1; }
    if index > total { return -1; }
    if which == 0 { return index; }
    return total;
}

// The shard index I of a valid `--shard I/N`, or -1 if the spec is
// malformed. The caller treats either field returning -1 as a usage error.
fn _parse_shard_index(text: string) -> int {
    return _parse_shard_field_at(text, 0);
}

// The shard total N of a valid `--shard I/N`, or -1 if the spec is
// malformed.
fn _parse_shard_total(text: string) -> int {
    return _parse_shard_field_at(text, 1);
}

// Does the 0-based `item_index` belong to shard `shard_index`/`shard_total`?
// The stable stride `item_index % shard_total == shard_index - 1`
// (`shard_index` is 1-based) mirrors `scripts/test_shards.sh`'s
// `(NR - 1) % n == (i - 1)`. `1/1` keeps every index. Over
// `shard_index = 1..shard_total` each item lands in exactly one residue
// class mod `shard_total`, so the shards are disjoint, their union is the
// whole surface, and their sizes differ by at most one (file-count
// balanced). Deterministic: depends only on its three integer arguments,
// so it is stable across runs and platforms for a fixed sorted file list.
fn _shard_keeps_index(item_index: int, shard_index: int, shard_total: int) -> boolean {
    if shard_total < 1 { return false; }
    return (item_index % shard_total) == (shard_index - 1);
}

// SFN-863: time-weighted LPT (longest processing time) partitioning for the
// named CI shards (`sfn dev shard run/cover` and `sfn test --shard-weights`),
// replacing the file-count stride's name-prefix skew (measured 2.13x on the
// macOS e2e legs). `_shard_keeps_index` above and the generic `--shard I/N`
// stay untouched — this is a deliberately separate, opt-in partition.
//
// Same API-shape constraint as the `--shard` helpers above: every exported
// function here returns `int`/`boolean`/`string` only, never an array or a
// struct, because a cross-module call to one that does cannot resolve its
// return type in the pinned seed. Building a weights `int[]` therefore has
// to happen locally in each caller's own module (`dev_shard.sfn`,
// `test/mod.sfn`) via the per-path lookup below; only the algorithm and the
// table parsing are shared.
// The generated per-file weight table's default location, used by the named
// CI shards. `sfn test --shard-weights <path>` can point at any path (e.g.
// for tests); this constant is the one `sfn dev shard` uses.
fn _shard_weight_table_path() -> string {
    return "compiler/tests/shard_weights.tsv";
}

// The default for a discovered file with no table row is the median of the
// loaded table, derived at load time rather than hardcoded. SFN-863 hardcoded
// `2136` -- exactly the median of the 621-row table it generated -- but that
// copy decayed across two regenerations (SFN-883, SFN-1223) while the
// table's actual median moved to 449. Deriving it here makes the value
// self-maintaining (SFN-1224).
//
// Median rather than mean: the weight distribution is heavy-tailed (current
// table: max 106411, mean 1286, median 449), so the mean is pulled ~2.9x
// above the typical file by a handful of outliers.
//
// This is a hygiene fix, not a measured partition-quality win: a simulation
// over the current table found no significant difference in resulting leg
// spread between median, mean, p75, p90 and the old 2136 constant. What
// actually drives spread is how many files lack a row, which is why the
// coverage signal in `dev shard cover` exists.
//
// Built and consumed entirely inside this function per the module note
// above: an exported `int[]`-returning helper cannot resolve its return
// type in the pinned seed.
fn _shard_default_weight(table_text: string) -> int {
    let len = table_text.length;
    let mut i: int = 0;
    let mut values: int[] = [];
    loop {
        if i >= len { break; }
        let mut line_end = find_char_local(table_text, "\n", i);
        if line_end < 0 { line_end = len; }
        let w = _shard_weight_row_weight(table_text, i, line_end);
        if w > 0 { values.push(w); }
        i = line_end + 1;
    }

    let n = values.length;
    if n == 0 {
        // Defensive and unreachable in practice: both call sites gate on
        // `_shard_weight_table_row_count(table_text) > 0` before ever asking
        // for a default. `1` rather than `0` because a `0` weight would
        // always sort last under LPT and never balance anything.
        return 1;
    }

    // Selection with a `used` marker array (mirrors `_shard_lpt_owner`
    // above) rather than an in-place sort: repeatedly scan for the smallest
    // not-yet-used value, mark it used, `k + 1` times where
    // `k = n / 2`. For an even-length array this yields the upper-middle
    // element.
    let mut used: boolean[] = [];
    let mut ui: int = 0;
    loop {
        if ui >= n { break; }
        used.push(false);
        ui += 1;
    }
    let k = n / 2;
    let mut median: int = 0;
    let mut picked: int = 0;
    loop {
        if picked > k { break; }
        let mut best: int = -1;
        let mut bi: int = 0;
        loop {
            if bi >= n { break; }
            if !used[bi] {
                if best < 0 { best = bi; } else {
                    if values[bi] < values[best] { best = bi; }
                }
            }
            bi += 1;
        }
        used[best] = true;
        median = values[best];
        picked += 1;
    }
    return median;
}

// Whether the unweighted fraction of the discovered test surface (`uncovered`
// out of `total`) has passed the point where regenerating the weight table is
// worth doing (SFN-1224). Threshold is 15%, warn-only -- see the call site in
// `dev_shard.sfn::_shard_cover` for the calibration. Integer comparison, no
// division: no rounding, no divide-by-zero.
fn _shard_weights_coverage_warns(uncovered: int, total: int) -> boolean {
    if total <= 0 { return false; }
    if uncovered <= 0 { return false; }
    return uncovered * 100 > total * 15;
}

// Load the raw weight table text at an arbitrary path, or "" if it is
// missing or unreadable. Fail-open (mirrors SFEP-0070's filter): callers
// treat "" — and a text with zero parseable rows, see
// `_shard_weight_table_row_count` — as "no table available" and fall back to
// the alphabetical stride rather than failing the run.
fn _shard_weight_table_text_at(path: string) -> string ![io] {
    if path.length == 0 { return ""; }
    if !fs.exists(path) { return ""; }
    return fs.readFile(path);
}

// Load the raw weight table text from the default `_shard_weight_table_path`
// location.
fn _shard_weight_table_text() -> string ![io] {
    return _shard_weight_table_text_at(_shard_weight_table_path());
}

// Parse one `path\tweight` row's weight field, given the row's `[line_start,
// line_end)` span in `table_text`. Returns -1 for a comment line (`#`), the
// `path\tweight` header (its weight field is not a decimal), a blank line,
// or any other malformed row.
fn _shard_weight_row_weight(table_text: string, line_start: int, line_end: int) -> int {
    if line_end <= line_start { return -1; }
    if table_text[line_start] == "#" { return -1; }
    let tab = find_char_local(table_text, "\t", line_start);
    if tab < 0 || tab >= line_end { return -1; }
    let weight_text = substring(table_text, tab + 1, line_end);
    return _parse_positive_decimal_cmd(weight_text);
}

// Number of parseable `path\tweight` data rows in `table_text`. Zero means
// the table is present but unusable (empty, only comments/header, or
// corrupt) — callers fold that into the same fail-open fallback as a missing
// file.
fn _shard_weight_table_row_count(table_text: string) -> int {
    let len = table_text.length;
    let mut i: int = 0;
    let mut count: int = 0;
    loop {
        if i >= len { break; }
        let mut line_end = find_char_local(table_text, "\n", i);
        if line_end < 0 { line_end = len; }
        if _shard_weight_row_weight(table_text, i, line_end) > 0 { count += 1; }
        i = line_end + 1;
    }
    return count;
}

// The weight for `path` in `table_text`, or -1 if no row names it (an
// unlisted file — the caller applies `_shard_default_weight` — or the table
// itself has no usable rows).
fn _shard_weight_for_path(table_text: string, path: string) -> int {
    let len = table_text.length;
    let mut i: int = 0;
    loop {
        if i >= len { break; }
        let mut line_end = find_char_local(table_text, "\n", i);
        if line_end < 0 { line_end = len; }
        let w = _shard_weight_row_weight(table_text, i, line_end);
        if w > 0 {
            let tab = find_char_local(table_text, "\t", i);
            let row_path = substring(table_text, i, tab);
            if strings_equal(row_path, path) { return w; }
        }
        i = line_end + 1;
    }
    return -1;
}

// The 1-based shard (of `shard_total`) that owns `item_index` under greedy
// LPT: visit indices `0..weights.length` in `(weight desc, index asc)` order
// (the index tiebreak makes the walk deterministic regardless of sort
// implementation) and assign each to the currently least-loaded shard,
// breaking load ties by the lowest shard index. Recomputes the whole
// assignment on every call — O(n^2) selection sort over the discovered test
// surface (~325 files today) is trivial next to the compile work a shard
// actually does, and avoids the array-return hazard a memoized table would
// hit (see the module note above). Returns 0 for an out-of-range
// `item_index` or a non-positive `shard_total`.
fn _shard_lpt_owner(item_index: int, weights: int[], shard_total: int) -> int {
    let n = weights.length;
    if shard_total < 1 { return 0; }
    if item_index < 0 || item_index >= n { return 0; }

    // Selection sort into `order`: indices 0..n-1 by (weight desc, index
    // asc). Scanning ascending and only replacing `best` on a strictly
    // greater weight keeps the lowest untried index on a tie.
    let mut used: boolean[] = [];
    let mut ui: int = 0;
    loop {
        if ui >= n { break; }
        used.push(false);
        ui += 1;
    }
    let mut order: int[] = [];
    let mut picked: int = 0;
    loop {
        if picked >= n { break; }
        let mut best: int = -1;
        let mut bi: int = 0;
        loop {
            if bi >= n { break; }
            if !used[bi] {
                if best < 0 { best = bi; } else {
                    if weights[bi] > weights[best] { best = bi; }
                }
            }
            bi += 1;
        }
        used[best] = true;
        order.push(best);
        picked += 1;
    }

    // Greedy walk: place each item (in the order above) onto the
    // least-loaded shard, lowest index breaking ties.
    let mut loads: int[] = [];
    let mut li: int = 0;
    loop {
        if li >= shard_total { break; }
        loads.push(0);
        li += 1;
    }
    let mut owner: int[] = [];
    let mut oi: int = 0;
    loop {
        if oi >= n { break; }
        owner.push(0);
        oi += 1;
    }
    let mut pi: int = 0;
    loop {
        if pi >= order.length { break; }
        let idx = order[pi];
        let mut least: int = 0;
        let mut si: int = 1;
        loop {
            if si >= shard_total { break; }
            if loads[si] < loads[least] { least = si; }
            si += 1;
        }
        loads[least] = loads[least] + weights[idx];
        owner[idx] = least + 1;
        pi += 1;
    }
    return owner[item_index];
}

// Does `item_index` belong to `shard_index`/`shard_total` under the LPT
// assignment over `weights`? Companion to `_shard_lpt_owner` so callers
// share the "is this mine" check instead of re-deriving it from the raw
// owner index.
fn _shard_lpt_keeps(item_index: int, shard_index: int, shard_total: int, weights: int[]) -> boolean {
    if shard_total < 1 { return false; }
    return _shard_lpt_owner(item_index, weights, shard_total) == shard_index;
}

