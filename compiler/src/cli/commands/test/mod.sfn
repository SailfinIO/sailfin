// compiler/src/cli/commands/test.sfn
//
// `test` subcommand (CLI modularization epic #351, Issue 3.8 — proposal
// §5 Phase 3 item 8, §7). Migrates `sfn test` off the legacy
// `cli_commands` handler onto the per-command `command_def()`/`run()`
// pattern established by Issue 2.4 (`version`) and exercised by the other
// Phase 3 commands (`init`, `login`, `guillermo`, `add`, `publish`, `fmt`).
//
// `test` carries a real flag surface plus a variadic positional:
//   sfn test [--json] [-k NAME] [--tag TAG] [--update-snapshots]
//            [--no-test-cache] [--jobs N] [--shard I/N] <suite...>
// `--json` / `--update-snapshots` / `--no-test-cache` are boolean flags;
// `-k` (name substring), `--tag` (tag filter), and `--shard` (I/N
// partition, issue #1237) are value flags; `--jobs`
// is a `flag_int` (Issue 1.5, #794) so `parse()` rejects a non-integer
// value as a `type_error` before `run` is reached; `suite` is a variadic
// positional (Issue 1.11, #800) collecting one or more suite paths (zero
// defaults to "."). `runtime_root` / `binary_dir` are threaded from the
// driver-parsed `CliContext` (Issue 2.2), replacing the legacy handler's
// extra params.
//
// The `run` body and its `_test_*` / `_clang_link_test_cmd_with_deps`
// private helpers (and the `TestSuite` / `TestGroup` / `TestFileOutcome` /
// `RetryPolicy` types) move verbatim from `cli_commands.sfn` — only the
// flag-parsing preamble changes (the hand-rolled argv walk becomes typed
// `sfn/cli` match accessors). Test discovery, snapshot, caching, and jobs
// semantics are unchanged. Exit codes stay integer literals (the
// `sfn/cli` `EXIT_*` constants lower to 0 in an importing module — see the
// `fmt.sfn` note).
import {
    Command,
    Matches,
    arg_variadic,
    command,
    flag,
    flag_int,
    flag_value,
    flag_value_short,
    get_int,
    get_or,
    has,
    has_flag,
    positionals,
    with_arg,
    with_flag
} from "sfn/cli";

import { AssertFailure, _empty_assert_failure } from "../../../assert_failure";
import { Program, Statement } from "../../../ast";
import { LinkPlan, LlvmTextBackend } from "../../../backend";
import { assemble_link_inputs } from "../../../build/clang_argv";
import {
    _dirname_cmd,
    _ends_with_cmd,
    _ensure_dir_cmd,
    _path_join_cmd,
    _sanitize_filename_cmd,
    _shell_read_cmd,
    _strip_trailing_slashes_cmd,
    _write_text_cmd
} from "../../../build/fs";
import {
    assemble_runtime_capsule_link_inputs,
    runtime_stamp_identity,
    write_runtime_identity_stamp
} from "../../../build/runtime_objs";
import {
    CacheKey,
    cache_copy_artifact_to,
    cache_lookup_artifact,
    cache_store_artifact,
    canonicalize_flags,
    runtime_link_inputs_identity,
    test_bin_cache_key,
    test_bin_cache_root,
    test_bin_compiler_identity
} from "../../../build_cache";
import { _env_flag, _get_env_cmd, _legacy_flag_file } from "../../../build_flags";
import { is_safe_scope_name, parse_scope_name } from "../../../capsule_artifact";
import { prepare_project_capsules_for_test } from "../../../capsule_resolver";
import { discover_project_root } from "../../../capsule_resolver/paths";
import { ResolverConsumer, TestCapsuleResolution } from "../../../capsule_resolver/types";
import { discover_workspace_root, load_workspace_default_members } from "../../../capsule_resolver/workspace";
import { ImportSymbolTable, empty_import_symbols } from "../../../effect_imports";
import { format_backend_failure_banner } from "../../../ice";
import { compile_tests_to_llvm_file_with_module_imports, module_name_from_path } from "../../../main";
import { LayoutManifest } from "../../../native_ir";
import { number_to_string } from "../../../num_format";
import { parse_program } from "../../../parser/mod";
import { runtime_capsule_from_root } from "../../../runtime_capsule_resolver";
import { _has_prefix_cmd, _sort_strings_cmd } from "../../../string_cmd_utils";
import {
    char_code_at_text,
    find_char_local,
    index_of,
    substring
} from "../../../string_utils";
import { TestResultRecord, parse_test_record_line } from "../../../test_results";
import {
    TestEntry,
    collect_test_entries,
    locate_failing_test,
    render_hook_event,
    render_start_event,
    render_summary_event,
    render_test_event
} from "../../../test_runner_json";
import {
    enter_test_runner_mode,
    exit_test_runner_mode,
    set_test_filters,
    set_test_scratch_root,
    test_decl_is_matching_test,
    test_decl_matches_filters,
    test_filters_active
} from "../../../test_runner_state";
import { toml_get_name } from "../../../toml_parser";
import { load_imported_interfaces_from_paths } from "../../../typecheck_import_loader";
import { resolve_test_bin_identity_for_cache } from "../../../version";
import { CliContext } from "../../context";
import { _package_basename } from "../cmd_shared";
import { toolchain_gate_or_dispatch } from "../toolchain";
import {
    _parse_jobs_value,
    _parse_positive_decimal_cmd,
    _parse_shard_field,
    _parse_shard_field_at,
    _parse_shard_index,
    _parse_shard_total,
    _resolve_auto_test_jobs,
    _resolve_test_jobs,
    _shard_keeps_index,
    _test_jobs_budget
} from "./arg_and_jobs";
import {
    TestScratchRoot,
    _clean_lowering_state,
    _cleanup_test_scratch,
    _collect_header_files_cmd,
    _resolve_test_scratch_root,
    _test_bin_runtime_identity,
    _test_scratch_root
} from "./cache_scratch";
import {
    TestGroup,
    _collect_test_files_cmd,
    _file_has_matching_test,
    _filter_program_tests_cmd,
    _find_test_group,
    _looks_like_test_file_cmd,
    _suite_name_from_path,
    _test_group_key,
    _test_resolver_consumer_for_group
} from "./discovery";
import {
    RetryPolicy,
    TestBinResult,
    _STREAM_ASSERT_KIND,
    _assert_failure_from_record,
    _classify_test_retry,
    _emit_captured_stream,
    _emit_crash_diagnostic,
    _emit_crash_diagnostic_neutral,
    _env_snapshot_has_key,
    _first_assert_failure,
    _ingest_child_stderr_line,
    _is_signal_exit,
    _run_test_binary,
    _should_retry_test,
    _test_deadline_ms,
    _test_exec_env,
    _test_hook_records,
    _test_retries_disabled,
    _test_timeout_secs
} from "./exec";
import { TestLinkResult, _clang_link_test_cmd_with_deps } from "./link";
import {
    ReapResult,
    _append_test_filter_args,
    _env_entry_has_key,
    _extract_json_uint_after,
    _is_subframe_summary_line,
    _pool_child_argv,
    _pool_child_env,
    _pool_env_snapshot,
    _prewarm_test_dep_closures,
    _reap_test_child,
    _resolve_test_self_path
} from "./pool";
import {
    TestSuite,
    _emit_file_test_events,
    _emit_results_events,
    _emit_suite_banners,
    _format_assert_failure,
    _outcome_all_pass,
    _outcome_failed_at,
    _outcome_setup_failure,
    _records_have_failure,
    _synthetic_assert_failure,
    _trj_decode_failed,
    _trj_decode_passed,
    _trj_decode_skipped
} from "./reporting";

// The `sfn/cli` definition for `test`, registered on the v2 root via
// `with_subcommand`. Three boolean flags, three value flags (`-k`,
// `--tag`, `--shard`), one int flag (`--jobs`), and a variadic `suite`
// positional.
fn command_def() -> Command {
    return with_arg(with_flag(with_flag(with_flag(with_flag(with_flag(with_flag(with_flag(with_flag(command("test", "Run tests or workspace default members"), flag("json", "Emit a JSONL event stream")), flag("update-snapshots", "Re-baseline snapshot golden files this run")), flag("no-test-cache", "Bypass the per-test linked-binary cache")), flag_value_short("k", "k", "Only run tests whose name contains this substring")), flag_value("tag", "Only run tests carrying @tag(\"<value>\")")), flag_int("jobs", "Run up to N per-file children concurrently")), flag_value("shard", "Run only the I-th of N file-count-balanced shards (e.g. 1/3)")), flag("skip-toolchain-check", "Bypass the [toolchain] pin check for this invocation")), arg_variadic("suite", "Suite paths (omit at a workspace root to test default members)"));
}

fn run(matches: Matches, ctx: CliContext) -> int ![clock, io, net] {
    // Flag surface migrated to `sfn/cli` (epic #351, Issue 3.8). The
    // legacy hand-rolled argv walk is replaced by typed builders:
    // `--json` / `--update-snapshots` / `--no-test-cache` (booleans),
    // `-k` / `--tag` (value flags), and `--jobs N` (`flag_int`, so a
    // non-integer value is rejected by `parse()` as a `type_error`
    // before `run` is reached). `runtime_root` / `binary_dir` come from
    // the driver-parsed `CliContext` instead of the old extra params.
    let runtime_root: string = ctx.runtime_root;
    let binary_dir: string = ctx.binary_dir;
    let _tc_suites: string[] = positionals(matches, "suite");
    let mut _tc_hint: string = ".";
    if _tc_suites.length > 0 { _tc_hint = _tc_suites[0]; }
    let _tc = toolchain_gate_or_dispatch(_tc_hint, ctx, has_flag(matches, "skip-toolchain-check"));
    if _tc != 0 { return _tc; }
    let json_output: boolean = has_flag(matches, "json");
    let no_test_cache: boolean = has_flag(matches, "no-test-cache");
    let update_snapshots: boolean = has_flag(matches, "update-snapshots");
    // Discovery filters (issue #849): `-k <substr>` keeps tests whose
    // name contains <substr>; `--tag <value>` keeps tests carrying
    // `@tag("<value>")`. Absent → "" (no filter), composing exactly as
    // the legacy two-`else if` branches did.
    let name_filter: string = get_or(matches, "k", "");
    let tag_filter: string = get_or(matches, "tag", "");
    // `--jobs` is a `flag_int`: `parse()` already rejected non-integer
    // input. Preserve the [1, 256] range guard (exit 2) here; absent flags
    // resolve through SAILFIN_TEST_JOBS and then the native host budget.
    let jobs: int = _resolve_test_jobs(matches);
    if jobs < 1 || jobs > 256 {
        print("sfn test: --jobs requires a positive integer in [1, 256] (got '"
            + number_to_string(jobs)
            + "')");
        return 2;
    }
    // `--shard I/N` (issue #1237): run only the I-th of N file-count-
    // balanced shards of the discovered surface. Absent → no sharding
    // (the whole surface). A malformed spec (not `I/N` with both sides
    // positive integers and `1 <= I <= N`) exits 2, mirroring the
    // `--jobs` range-guard convention. The stable stride partition is
    // applied to `test_files` after discovery/filtering, below.
    let mut shard_active: boolean = false;
    let mut shard_index: int = 1;
    let mut shard_total: int = 1;
    let shard_spec_raw: string = get_or(matches, "shard", "");
    if shard_spec_raw.length > 0 {
        let s_index: int = _parse_shard_index(shard_spec_raw);
        let s_total: int = _parse_shard_total(shard_spec_raw);
        if s_index < 0 || s_total < 0 {
            print("sfn test: --shard requires I/N with 1 <= I <= N (got '"
                + shard_spec_raw
                + "')");
            return 2;
        }
        shard_active = true;
        shard_index = s_index;
        shard_total = s_total;
    }

    // Variadic suite positionals: zero or more. Zero defaults to a single
    // "." suite below (the legacy `positional.length == 0` branch).
    let positional: string[] = positionals(matches, "suite");
    set_test_filters(name_filter, tag_filter);

    // Build the suite list. At a workspace root, zero positional args select
    // `[workspace].default-members` (or every member when undeclared). Outside
    // a workspace the historical single "." suite remains the fallback.
    // One or more positionals are unchanged.
    let mut suites: TestSuite[] = [];
    if positional.length == 0 {
        let workspace_root = discover_workspace_root(".");
        if workspace_root.length > 0 {
            let members = load_workspace_default_members(workspace_root);
            let mut wmi: int = 0;
            loop {
                if wmi >= members.length { break; }
                let member = members[wmi];
                let empty_failed: string[] = [];
                suites.push(TestSuite {
                    name: member.name, path: workspace_root + "/" + member.member_path, pass_count: 0, fail_count: 0, failed_files: empty_failed
                });
                wmi += 1;
            }
        } else {
            let empty_failed: string[] = [];
            suites.push(TestSuite {
                name: ".", path: ".", pass_count: 0, fail_count: 0, failed_files: empty_failed
            });
        }
    } else {
        let mut spi: int = 0;
        loop {
            if spi >= positional.length { break; }
            let sp = positional[spi];
            let sn = _suite_name_from_path(sp);
            let empty_failed: string[] = [];
            suites.push(TestSuite {
                name: sn, path: sp, pass_count: 0, fail_count: 0, failed_files: empty_failed
            });
            spi += 1;
        }
    }

    // Per-suite banner suppression rule: a single positional `.sfn`
    // file path runs in legacy single-file mode (no banner). Every
    // other shape — zero positionals, one directory, multiple
    // paths — emits banners. Keeps `sfn test path/to/x_test.sfn`
    // (the shape the multi-file path's own `<self> test <file>`
    // children use) byte-compatible with pre-#848 output so the
    // parent's banner aggregation isn't polluted by per-child
    // decoration.
    let mut emit_banners: boolean = true;
    if positional.length == 1 && _ends_with_cmd(positional[0], ".sfn") {
        emit_banners = false;
    }

    _ensure_dir_cmd("build");
    _ensure_dir_cmd("build/sailfin");
    // Capture whether the caller pinned the scratch root before
    // resolving it. Unpinned test invocations get an ephemeral root so
    // separate `sfn test <file>` processes cannot race on
    // `build/sailfin/test.ll` or resolver capsule `.ll` paths.
    let scratch_env = _get_env_cmd("SAILFIN_TEST_SCRATCH");
    let scratch_choice = _resolve_test_scratch_root(scratch_env);
    let scratch_root = scratch_choice.root;
    let scratch_owned = scratch_choice.owned;
    _ensure_dir_cmd(scratch_root);
    _ensure_dir_cmd(scratch_root + "/test-o0");
    // Sub-frame mode (#1121 / SFEP-0050): set by the multi-file parent on
    // each child via SAILFIN_TEST_JSON_SUBFRAME=1. In this mode a `--json`
    // child suppresses its own start on stdout (it still emits per-test
    // events, which the parent forwards from the child's stdout) and
    // routes its `summary` line to its own STDERR — the parent skims the
    // counts off the reap demux and does not forward it, aggregating them
    // into one run-level summary. The result is a single coherent jsonl
    // document per `sfn test` invocation. (The pre-SFEP-0050 transport
    // wrote the counts to `<scratch>/_subframe_summary.json`; the stream
    // replaces that side-channel file.)
    let json_subframe = json_output && _env_flag("SAILFIN_TEST_JSON_SUBFRAME");

    // Resolve the trace toggle once (popen-cost is fine on the
    // cold orchestrator path) and stash both bits in the
    // process-local `test_runner_state` module so the LLVM
    // lowering pipeline reads them via direct boolean loads
    // instead of re-probing the filesystem on every statement.
    // See `compiler/src/test_runner_state.sfn` for the contract.
    let trace_runner = _env_flag("SAILFIN_TRACE_TEST_RUNNER")
        || _legacy_flag_file("build/sailfin/.trace_test_runner");
    enter_test_runner_mode(trace_runner);
    set_test_scratch_root(scratch_root);

    // Walk each suite's path for `_test.sfn` files. `file_suite_index`
    // tracks the originating suite per file so the loop can attribute
    // pass/fail counts back to the right banner. The flat `test_files`
    // list keeps the existing resolver-group partition + arena-mark
    // loop shape downstream — only the upstream collection step
    // fans out to multiple roots.
    let mut test_files: string[] = [];
    let mut file_suite_index: int[] = [];
    let mut csi: int = 0;
    loop {
        if csi >= suites.length { break; }
        // Sort within each suite so the run order is deterministic
        // across platforms (`fs.listDirectory` returns entries in
        // filesystem order). Matches the pre-#848 `find ... | sort`.
        let suite_files = _sort_strings_cmd(_collect_test_files_cmd(suites[csi].path, 25));
        let mut sfi: int = 0;
        loop {
            if sfi >= suite_files.length { break; }
            test_files.push(suite_files[sfi]);
            file_suite_index.push(csi);
            sfi += 1;
        }
        csi += 1;
    }

    // File-level discovery pre-filter (issue #849). When `-k`/`--tag`
    // are active, drop any test file that contains no matching test so
    // it never reaches the compile path — a file compiled with every
    // test filtered out would synthesize an empty harness (no `@main`)
    // and fail to link. The per-test cut in
    // `compile_tests_to_llvm_file_with_module_imports` then trims the
    // surviving files down to only their matching tests. Both passes
    // share `test_decl_matches_filters`, so a file kept here always has
    // at least one test that survives the cut.
    if test_filters_active() {
        let mut kept_files: string[] = [];
        let mut kept_suite_index: int[] = [];
        let mut fpi: int = 0;
        loop {
            if fpi >= test_files.length { break; }
            if _file_has_matching_test(test_files[fpi]) {
                kept_files.push(test_files[fpi]);
                kept_suite_index.push(file_suite_index[fpi]);
            }
            fpi += 1;
        }
        test_files = kept_files;
        file_suite_index = kept_suite_index;
    }

    // `--shard I/N` partition (issue #1237). Keep only the I-th of N
    // file-count-balanced shards using the stable stride
    // `i % total == index - 1` over the deterministic (sorted within each
    // suite) discovery order — mirroring `scripts/test_shards.sh`'s awk
    // stride so the runner and the legacy bash shard map agree over the
    // same file list. Applied after the `-k`/`--tag` cut so a shard
    // partitions exactly the surface that would otherwise run. The
    // `file_suite_index` parallel array is partitioned in lockstep so
    // per-suite banner attribution stays aligned. An empty shard (more
    // shards than files) falls through to the benign 0/0/0 path below.
    if shard_active {
        let mut sharded_files: string[] = [];
        let mut sharded_suite_index: int[] = [];
        let mut shi: int = 0;
        loop {
            if shi >= test_files.length { break; }
            if _shard_keeps_index(shi, shard_index, shard_total) {
                sharded_files.push(test_files[shi]);
                sharded_suite_index.push(file_suite_index[shi]);
            }
            shi += 1;
        }
        test_files = sharded_files;
        file_suite_index = sharded_suite_index;
    }

    if test_files.length == 0 {
        // Empty discovery exits 0 in BOTH modes (issue #848). The
        // pre-#848 split — JSON returned 1, the human path printed
        // "no Sailfin test files found" and also returned 1, while
        // the Makefile's `test-capsules` loop special-cased an empty
        // `capsules/` to exit 0 — left the runner and the Makefile
        // disagreeing. The unified runner standardises on the
        // `test-capsules` shape: an empty suite is a benign 0/0/0,
        // not a failure. The all-zeros JSON summary / `0/0 passed`
        // banner is the "no tests" signal consumers read; the exit
        // code stays 0 so a legitimately-empty suite (e.g. a capsule
        // with no `tests/` dir) doesn't fail the build.
        if json_output {
            if json_subframe {
                print.err(render_summary_event(0, 0, 0, 0, 0, 0));
            } else {
                print(render_start_event(0));
                print(render_summary_event(0, 0, 0, 0, 0, 0));
            }
            exit_test_runner_mode();
            _cleanup_test_scratch(scratch_owned, scratch_root, true);
            return 0;
        }
        let mut hi: int = 0;
        loop {
            if hi >= suites.length { break; }
            print("[test-" + suites[hi].name
                + "] no *_test.sfn files found under "
                + suites[hi].path);
            hi += 1;
        }
        if emit_banners { _emit_suite_banners(suites); }
        exit_test_runner_mode();
        _cleanup_test_scratch(scratch_owned, scratch_root, true);
        return 0;
    }

    // Multi-file isolation (issue #848). When more than one test file
    // runs in this invocation, compile + link + run each in a fresh
    // `<self> test <file>` subprocess and aggregate the exit codes
    // into the per-suite banners. The single-shared in-process path
    // below groups every test under one resolver pass whose
    // `native_texts` is the UNION of every test's imports — and tests
    // with conflicting expectations for the same symbol cannot
    // coexist in that union. The canonical case: `number_to_string`
    // resolves to the `![pure]` int-signature import for
    // `cross_module_int_signature_test` (pinning the #633 fix) but to
    // the `double` runtime-helper descriptor for `pure_assert_smoke_test`
    // — one resolver group can only pick one, so the loser fails with
    // an ABI mismatch. Per-file subprocesses give each test its own
    // resolver pass (its own imports only), which is exactly what the
    // retired `scripts/run_native_test.sh` per-file loop did. JSON
    // mode (#1121) also uses this per-file subprocess path — a multi-file
    // `sfn test <dir> --json` no longer forces every file through one
    // resolver pass (that single-process path OOM/segfaulted on the real
    // suite — 132 unit files — under the 8 GB cap and hit the
    // resolver-union conflicts per-file isolation exists to avoid).
    // Output stays a SINGLE coherent jsonl document per invocation: the
    // parent emits one aggregate `start`, runs each child in sub-frame
    // mode (children forward only per-test events on the shared stdout
    // and route their counts back over their own stderr `summary` line,
    // which the parent skims — SFEP-0050), then emits one aggregate
    // `summary`. Human banners and the RETRY line are suppressed in JSON
    // mode so the stream stays pure jsonl.
    if test_files.length > 1 {
        let self_exe = _resolve_test_self_path(binary_dir);
        // Ephemeral scratch root + cleanup, ported from the retired
        // `scripts/run_native_test.sh` (issue #850). The script ran
        // each test under a fresh `mktemp -d` and removed it on
        // success (preserving on failure for post-mortem); the runner
        // owns that lifecycle now. Command entry resolves the root once:
        // caller-pinned `SAILFIN_TEST_SCRATCH` roots are preserved, and
        // unpinned roots are cleaned after success.
        let sub_root = scratch_root;
        // Per-file wall-clock cap (SFEP-0050). Each `<self> test <file>`
        // sub-frame child is bounded by a handle-owned deadline enforced
        // via `handle_kill` inside `_reap_test_child`, retiring the outer
        // `timeout(1)` wrapper. A deadline kill is remapped to 124 and
        // falls through the signal-kill retry gate (which only retries
        // 137/139), matching the old wrapper's exit code.
        let deadline_ms = _test_deadline_ms();
        // Snapshot the passthrough environment ONCE for every spawned
        // child. Both the pool and the serial multi-file path now spawn
        // via `spawn_with_env` (the child routes its summary to its own
        // captured stderr, so it must be reaped, not inherited). Each
        // `_get_env_cmd` read shells out via popen, so resolving it per
        // spawn would add dozens of subprocesses per test file.
        let pool_base_env = _pool_env_snapshot();
        // Same signal-kill retry gate the in-process path uses: a
        // child killed by SIGKILL/SIGSEGV (137/139) under transient
        // CI memory pressure is retried once before being counted as
        // a failure. Without this the per-child subprocess path would
        // be flakier than the in-process path (which retries the test
        // exec internally) — a child OOM-killed mid-compile dies
        // before its in-process retry can fire, so the parent must
        // re-run the whole child. `SAILFIN_TEST_RETRY=0` opts out.
        let sub_retries_disabled = _test_retries_disabled();
        // #940 PERF: warm the runtime-capsule objects ONCE into the
        // shared `sub_root` before forking per-file children. Each
        // child links against this shared dir via
        // `SAILFIN_TEST_RUNTIME_OBJDIR` and cache-hits, so the runtime
        // is compiled once per `sfn test` invocation instead of once
        // per test file (the regression #940 must not introduce — the
        // retired probe path used pre-staged `.o`). Done here, outside
        // the per-test `timeout` wrapper, so the first child isn't
        // charged the full runtime compile and tripped by the cap. A
        // warm failure is non-fatal: children re-attempt and surface a
        // precise per-file link error.
        let warm_caps = runtime_capsule_from_root(runtime_root);
        // #1996 / SFEP-0044 §3-A: after a successful warm, write the
        // invocation stamp so children skip the per-file runtime
        // cache-key derivation. The nonce ties the stamp to THIS
        // invocation: children only trust a stamp whose `invocation=`
        // matches the `SAILFIN_TEST_RUNTIME_STAMP` env they were
        // handed, so a stale stamp in a reused pinned objdir (e.g.
        // seedcheck runs pin SAILFIN_TEST_SCRATCH) can never validate.
        // A failed warm or failed stamp write leaves the nonce empty
        // and children fall back to full hashing — the pre-stamp path.
        let mut stamp_nonce: string = "";
        if warm_caps.length > 0 {
            _ensure_dir_cmd(sub_root);
            let warm = assemble_runtime_capsule_link_inputs(warm_caps, sub_root, "-O0", binary_dir, "");
            if !warm.success {
                print.err("[test] warning: failed to pre-warm runtime objects under "
                    + sub_root
                    + " (children will retry per file)");
            } else {
                let candidate_nonce = _sanitize_filename_cmd(sub_root) + "-"
                    + number_to_string(monotonic_millis());
                let warm_identity = _test_bin_runtime_identity(runtime_root, _sanitize_filename_cmd(sub_root));
                if write_runtime_identity_stamp(warm_caps, sub_root, "-O0", binary_dir, candidate_nonce, warm_identity) {
                    stamp_nonce = candidate_nonce;
                }
            }
        }
        // Single-frame `--json` aggregation (#1121). The parent owns the
        // run's `start`/`summary`; children run in sub-frame mode
        // (`SAILFIN_TEST_JSON_SUBFRAME`) and forward only per-test events.
        // Pre-parse
        // each file to compute the aggregate `total` (parse-only, no
        // codegen) and keep per-file test counts so a child that dies
        // before writing its summary file can still be attributed.
        let mut sf_total: int = 0;
        let mut sf_counts: int[] = [];
        if json_output {
            let mut sfp: int = 0;
            loop {
                if sfp >= test_files.length { break; }
                let sf_src = fs.readFile(test_files[sfp]);
                let mut sf_prog: Program = parse_program(sf_src);
                if test_filters_active() {
                    sf_prog = _filter_program_tests_cmd(sf_prog);
                }
                let sf_entries = collect_test_entries(sf_prog, test_files[sfp]);
                sf_counts.push(sf_entries.length);
                sf_total += sf_entries.length;
                sfp += 1;
            }
            print(render_start_event(sf_total));
        }
        let sf_start_ms = monotonic_millis();
        let mut sf_passed: int = 0;
        let mut sf_failed: int = 0;
        let mut sf_skipped: int = 0;
        // #1230: aggregate each child's per-test-binary cache counters
        // from its sub-frame summary so the parent's single run-level
        // `summary` reports the run-wide `cache.test_bin_hit_rate`.
        let mut sf_tb_hits: int = 0;
        let mut sf_tb_misses: int = 0;
        let mut overall_rc: int = 0;
        if jobs > 1 {
            // SFN-148: warm the dep-closure module cache once before the
            // pool fans out, so the cold-start wave cache-hits instead of
            // each child re-emitting the shared closure.
            _prewarm_test_dep_closures(test_files, binary_dir);
            // #1236: bounded worker pool. A sliding window keeps at
            // most `jobs` children live: the launch loop tops the
            // window up via `process.spawn_with_env`, then the parent
            // reaps the OLDEST child (`_reap_test_child`: poll-demux
            // stdout+stderr, skim the summary, `handle_wait`). In-order
            // reaping keeps every downstream consumer identical to the
            // serial loop — suite attribution, the signal-kill retry
            // gate, and the `--json` sub-frame aggregation all index by
            // `ti` exactly as before — and re-emits each child's
            // captured output grouped per file, so pooled output is
            // never interleaved mid-file. The loop has no early
            // return: every spawned handle is reaped (and its fds
            // closed + struct freed by `handle_wait`) before the
            // multi-file path returns, so no zombie children or
            // leaked handles survive an error — a child's failure is
            // an exit code here, never an abort. A retried child
            // (137/139) is re-spawned and reaped synchronously at
            // reap time; the window stays ≤ `jobs` live children
            // throughout.
            let mut handles: int[] = [];
            // #1303: indices (and their original exit codes) of children
            // that hit a signal-kill (137/139) retry. Their retry is
            // deferred to a serial tail after the pool drains so it runs
            // in isolation rather than under the same memory pressure
            // that crashed the first attempt — see the deferral comment
            // in the reap block below.
            let mut retry_pending: int[] = [];
            let mut retry_rc: int[] = [];
            let mut launched: int = 0;
            let mut ti: int = 0;
            loop {
                if ti >= test_files.length { break; }
                // Top up the window. Per-test scratch (`sub-<i>`,
                // unique per file) gives each live child its own
                // `.ll` / `test` / `fail.bin` tree; runtime objects
                // come from the shared pre-warmed `sub_root` via
                // `SAILFIN_TEST_RUNTIME_OBJDIR`, which is read-only
                // cache-hit territory after the warm above.
                loop {
                    if launched >= test_files.length { break; }
                    if launched - ti >= jobs { break; }
                    let spawn_scratch = sub_root + "/sub-" + number_to_string(launched);
                    _ensure_dir_cmd(spawn_scratch);
                    handles.push(process.spawn_with_env(_pool_child_argv(self_exe, test_files[launched], name_filter, tag_filter, json_output, no_test_cache), _pool_child_env(pool_base_env, spawn_scratch, sub_root, stamp_nonce, update_snapshots, json_output)));
                    launched += 1;
                }
                let path = test_files[ti];
                let suite_idx = file_suite_index[ti];
                let reap = _reap_test_child(handles[ti], deadline_ms, json_output);
                let rc = reap.rc;
                if _should_retry_test(rc, sub_retries_disabled) {
                    // #1303: defer signal-kill (137/139) retries to the
                    // isolated serial tail after the pool drains.
                    // Re-spawning the retry inline here runs it while up
                    // to `jobs-1` other children are still live — the
                    // same sustained memory pressure that produced the
                    // transient crash — so it tends to crash again (the
                    // flaky 148/150 signature for the two adjacent
                    // heavy-lowering atomic tests). Replaying it once the
                    // window has emptied matches the isolation that
                    // passes 3/3 deterministically, so a transient
                    // 137/139 self-heals. Accounting + JSON aggregation
                    // for this file are deferred to the drain loop below.
                    retry_pending.push(ti);
                    retry_rc.push(rc);
                    ti += 1;
                    continue;
                }
                if rc == 0 { suites[suite_idx].pass_count += 1; } else {
                    // #1303: a signal-kill that reaches here (rather than
                    // the deferred tail) means retries are disabled
                    // (`SAILFIN_TEST_RETRY=0`); surface the lost crash
                    // explicitly so the failure is attributed, not a gap.
                    if !json_output && _is_signal_exit(rc) {
                        _emit_crash_diagnostic(_package_basename(path), rc);
                    } else if !json_output && rc == 134 {
                        _emit_crash_diagnostic_neutral(_package_basename(path), rc);
                    }
                    suites[suite_idx].fail_count += 1;
                    suites[suite_idx].failed_files.push(_package_basename(path));
                    if overall_rc == 0 { overall_rc = rc; }
                }
                if json_output {
                    // Aggregate the child's counts skimmed from the
                    // `summary` line it routed to its stderr during the
                    // reap demux (SFEP-0050). A child that died before
                    // emitting a summary counts its whole file as failed,
                    // matching the old missing-summary-file fallback.
                    if reap.summary_seen {
                        sf_passed += reap.passed;
                        sf_failed += reap.failed;
                        sf_skipped += reap.skipped;
                        sf_tb_hits += reap.tb_hits;
                        sf_tb_misses += reap.tb_misses;
                    } else { sf_failed += sf_counts[ti]; }
                }
                ti += 1;
            }
            // #1303 serial retry tail. The pool has fully drained, so
            // each replay runs alone — the same isolation an in-process
            // `sailfin test <file>` enjoys, where these tests pass 3/3.
            // Mirrors exactly what the inline retry used to do (banner
            // gate, spawn/reap, pass/fail accounting, JSON sub-frame
            // aggregation) — only the timing changed. `SAILFIN_TEST_RETRY=0`
            // is already honoured upstream: `_should_retry_test` returns
            // false under `sub_retries_disabled`, so nothing is ever
            // pushed onto `retry_pending` and this loop is a no-op.
            let mut ri: int = 0;
            loop {
                if ri >= retry_pending.length { break; }
                let rti = retry_pending[ri];
                let rpath = test_files[rti];
                let rsuite_idx = file_suite_index[rti];
                let rchild_scratch = sub_root + "/sub-" + number_to_string(rti);
                if !json_output {
                    print("[test] RETRY: " + _package_basename(rpath)
                        + " (exit code "
                        + number_to_string(retry_rc[ri])
                        + ", retrying once)");
                }
                // The retry's records live on its own fresh pipe — no
                // stale side-channel file to unlink; a double crash that
                // never emits a summary falls back to `sf_counts[rti]` via
                // `reap.summary_seen` below.
                let retry_handle = process.spawn_with_env(_pool_child_argv(self_exe, rpath, name_filter, tag_filter, json_output, no_test_cache), _pool_child_env(pool_base_env, rchild_scratch, sub_root, stamp_nonce, update_snapshots, json_output));
                let reap = _reap_test_child(retry_handle, deadline_ms, json_output);
                let rc = reap.rc;
                if rc == 0 { suites[rsuite_idx].pass_count += 1; } else {
                    // #1303: the isolated retry also died. The RETRY
                    // banner above already named the file; add the
                    // attributed crash line so the final FAIL isn't a
                    // bare unexplained gap (its own output was lost to
                    // the unflushed crash buffer).
                    if !json_output && _is_signal_exit(rc) {
                        _emit_crash_diagnostic(_package_basename(rpath), rc);
                    } else if !json_output && rc == 134 {
                        _emit_crash_diagnostic_neutral(_package_basename(rpath), rc);
                    }
                    suites[rsuite_idx].fail_count += 1;
                    suites[rsuite_idx].failed_files.push(_package_basename(rpath));
                    if overall_rc == 0 { overall_rc = rc; }
                }
                if json_output {
                    if reap.summary_seen {
                        sf_passed += reap.passed;
                        sf_failed += reap.failed;
                        sf_skipped += reap.skipped;
                        sf_tb_hits += reap.tb_hits;
                        sf_tb_misses += reap.tb_misses;
                    } else { sf_failed += sf_counts[rti]; }
                }
                ri += 1;
            }
        } else {
            let mut ti: int = 0;
            loop {
                if ti >= test_files.length { break; }
                let path = test_files[ti];
                let suite_idx = file_suite_index[ti];
                // Per-test scratch (build cache + `sfn/test` fixture temp
                // dirs) so sequential children never clobber each other's
                // `.ll` / `test` tree. Runtime objects live in the shared
                // `sub_root` (warmed above) — see `SAILFIN_TEST_RUNTIME_OBJDIR`.
                // SFEP-0050: spawn via `spawn_with_env` + reap so the child's
                // `summary` (now on its captured stderr) is skimmed, not lost
                // to inherited stdio, exactly like the pool path.
                let child_scratch = sub_root + "/sub-" + number_to_string(ti);
                _ensure_dir_cmd(child_scratch);
                let child_env = _pool_child_env(pool_base_env, child_scratch, sub_root, stamp_nonce, update_snapshots, json_output);
                let child_argv = _pool_child_argv(self_exe, path, name_filter, tag_filter, json_output, no_test_cache);
                let mut reap = _reap_test_child(process.spawn_with_env(child_argv, child_env), deadline_ms, json_output);
                if _should_retry_test(reap.rc, sub_retries_disabled) {
                    // RETRY banner is a human-mode artifact; suppress it in
                    // JSON mode so the jsonl stream stays pure (mirrors the
                    // in-process path's `if !json_output` retry-print gate).
                    if !json_output {
                        print("[test] RETRY: " + _package_basename(path)
                            + " (exit code "
                            + number_to_string(reap.rc)
                            + ", retrying once)");
                    }
                    reap = _reap_test_child(process.spawn_with_env(child_argv, child_env), deadline_ms, json_output);
                }
                let rc = reap.rc;
                if rc == 0 { suites[suite_idx].pass_count += 1; } else {
                    // #1303: serial path — a signal-kill (after the
                    // inline retry, if any) lost its own output to the
                    // unflushed crash buffer; surface an attributed FAIL.
                    if !json_output && _is_signal_exit(rc) {
                        _emit_crash_diagnostic(_package_basename(path), rc);
                    } else if !json_output && rc == 134 {
                        _emit_crash_diagnostic_neutral(_package_basename(path), rc);
                    }
                    suites[suite_idx].fail_count += 1;
                    suites[suite_idx].failed_files.push(_package_basename(path));
                    if overall_rc == 0 { overall_rc = rc; }
                }
                if json_output {
                    // Aggregate the child's per-test counts skimmed from
                    // the `summary` line it routed to its stderr (SFEP-0050).
                    // No summary means the child died before emitting one
                    // (segfault/timeout); count that file's tests as failed
                    // so the aggregate stays consistent with the non-zero
                    // run exit code.
                    if reap.summary_seen {
                        sf_passed += reap.passed;
                        sf_failed += reap.failed;
                        sf_skipped += reap.skipped;
                        sf_tb_hits += reap.tb_hits;
                        sf_tb_misses += reap.tb_misses;
                    } else { sf_failed += sf_counts[ti]; }
                }
                ti += 1;
            }
        }
        if json_output {
            // One aggregate `summary` closes the single jsonl document:
            // one `start`, every per-test event the children forwarded,
            // one `summary` with run-level counts and wall-clock duration.
            let sf_dur = monotonic_millis() - sf_start_ms;
            print(render_summary_event(sf_passed, sf_failed, sf_skipped, sf_dur, sf_tb_hits, sf_tb_misses));
        } else if emit_banners { _emit_suite_banners(suites); }
        exit_test_runner_mode();
        _cleanup_test_scratch(scratch_owned, sub_root, overall_rc == 0);
        return overall_rc;
    }

    let ll_path = scratch_root + "/test.ll";
    let exe_path = scratch_root + "/test";
    let dump_sources = _env_flag("SAILFIN_DUMP_TEST_SOURCES")
        || _legacy_flag_file("build/sailfin/.dump_test_sources");

    // Partition test files into resolution groups. Within a group,
    // every file shares `(project_root, workspace_root)`, so a single
    // resolver pass anchored on the group's full file list covers
    // every relative-import + capsule-dep + workspace-implicit graph
    // the test compile + link needs. Between groups (e.g. running
    // tests from two different capsules in one invocation), each
    // project resolves independently.
    let mut groups: TestGroup[] = [];
    let mut file_group_index: int[] = [];
    let mut gpi: int = 0;
    loop {
        if gpi >= test_files.length { break; }
        let path = test_files[gpi];
        let key = _test_group_key(path);
        let mut idx = _find_test_group(groups, key);
        if idx < 0 {
            let empty_entries: string[] = [];
            let empty_interfaces: Statement[] = [];
            let empty_texts: string[] = [];
            let empty_lls: string[] = [];
            let empty_caps: string[] = [];
            groups.push(TestGroup {
                key: key, entry_paths: empty_entries, interfaces: empty_interfaces, native_texts: empty_texts, dep_ll_paths: empty_lls, function_effects: empty_import_symbols(), capabilities_required: empty_caps
            });
            idx = groups.length - 1;
        }
        groups[idx].entry_paths.push(path);
        file_group_index.push(idx);
        gpi += 1;
    }

    // Per-group resolver pass: stage `.sfn-asm` import-context, load
    // it for typecheck-with-imports, and compile each capsule
    // dependency to its own `.ll` so the link step can resolve
    // imported helper definitions strongly. Setup errors (slug
    // collision, stage-write failure, capsule-compile failure) all
    // collapse to `staging_failed = true` and exit 2 to distinguish
    // setup from test failure (exit 1).
    let mut gi: int = 0;
    loop {
        if gi >= groups.length { break; }
        if trace_runner {
            print.err("test runner: resolver pass start (group="
                + number_to_string(gi)
                + ", files="
                + number_to_string(groups[gi].entry_paths.length)
                + ")");
        }
        // P1 (#363): derive the resolver consumer from the host
        // capsule's manifest so a test file in `<project>/tests/`
        // can import the host capsule by its `[capsule].name` (e.g.
        // `import { fn } from "my-app"`) — not just by relative
        // path (`../src/mod`). `include_host_as_dep = true` opts
        // the resolver into enumerating `<project_root>/src/` with
        // `<capsule_name>/<stem>` slugs, which matches what the
        // test source's import-path normalizer resolves the bare
        // capsule name to. Tests that don't import the host by
        // name — the compiler's own `compiler/tests/` suite is the
        // canonical case, since those tests reach `compiler/src/`
        // exclusively via `../../src/X` relative imports — fail
        // the in-resolver `_cr_any_entry_imports_host` gate, so
        // host-enum stays a no-op and the resolver behaves the
        // same as the prior `empty_resolver_consumer()` path. That
        // gate is load-bearing: host-enum pulls in every host `src/`
        // module including `main.sfn`, so firing it for those tests
        // would link a second `@main` into each test binary. (#527
        // mixed the slug into `cache_key_for`'s digest, closing the
        // separate cache-entry race that co-firing the two walkers
        // would cause; the gate still guards the link-layer
        // duplicate-`@main` hazard.) Standalone test files outside
        // any `capsule.toml` (project_root empty) get a fully empty
        // consumer for the same reason — there's no manifest, no
        // `[capsule].name`, and so nothing for
        // host-enum to walk.
        // Stage D PR3 / #1405 Bug 2: `sfn test` keeps the in-process
        // compile path for ordinary fixtures (which stay well below the
        // per-module count where arena pressure bites). But a few
        // compiler unit tests import the whole compiler (e.g. via
        // `lower_to_llvm_ir_from_text`), and compiling that ~120-module
        // closure in-process OOMs past the 8 GiB self-cap on a cold
        // test-bin cache. Thread the same-generation `binary_dir` so the
        // resolver upgrades *only* those large-closure tests to
        // subprocess-per-module isolation (fresh arena per child); small
        // fixtures still take the in-process fast path.
        let consumer = _test_resolver_consumer_for_group(groups[gi].entry_paths[0]);
        let resolution = prepare_project_capsules_for_test(groups[gi].entry_paths, consumer, "", "", binary_dir);
        if resolution.staging_failed {
            // Resolver already emitted a structured error to stderr
            // (slug collision, stage-write, or compile failure).
            exit_test_runner_mode();
            _cleanup_test_scratch(scratch_owned, scratch_root, false);
            return 2;
        }
        // Single-pass loader: returns both the parsed interface set
        // (for typecheck-with-imports) and the raw `.sfn-asm` text set
        // (for `apply_module_symbol_mangling`'s provider-name lookup),
        // reading each artifact off disk exactly once.
        let load = load_imported_interfaces_from_paths(resolution.asm_paths);
        groups[gi].interfaces = load.interfaces;
        groups[gi].native_texts = load.native_texts;
        groups[gi].dep_ll_paths = resolution.ll_paths;
        // Phase E: stash the cross-module function-effect table so
        // the per-test compile below can hand it to
        // `compile_tests_to_llvm_file_with_module_imports` alongside
        // the interface list.
        groups[gi].function_effects = load.function_effects;
        // Phase F: stash the capsule manifest's
        // `[capabilities] required` surface from the resolver pass
        // so the per-test compile produces `E0403` for any test
        // body declaring an effect outside the surface.
        groups[gi].capabilities_required = resolution.capabilities_required;
        if trace_runner {
            print.err("test runner: resolver pass done (group="
                + number_to_string(gi)
                + ", deps="
                + number_to_string(resolution.ll_paths.length)
                + ")");
        }
        gi += 1;
    }

    // Per-test compile + link + run. The test source is compiled
    // fresh each iteration; dependency `.ll` files were compiled once
    // by the resolver pass above and reused across every test in the
    // group.
    //
    // Phase 5a (`docs/proposals/archive/phase-5a-arena-reset.md`): mark the
    // arena before the loop and rewind at the bottom of each
    // iteration. Cross-iteration state — `test_files`, `groups[]`,
    // `file_group_index`, `runtime_root` — is allocated above this
    // point. The test source / module-name string / compile output
    // path / clang output are per-iteration and reclaimed each
    // rewind. No-op when the arena is disabled
    // (`SAILFIN_USE_ARENA` unset). Test discovery for the full
    // compiler tree compiles ~75 tests in one process, hitting the
    // same accumulating-allocation wall `sfn check` did pre-Phase-5a.
    let test_scratch_mark = sailfin_intrinsic_runtime_arena_mark();

    // Pre-parse pass: only run in `--json` mode. Walks every test
    // file once, parses it, and pulls out the
    // `test "name" { ... }` declarations. Three reasons the runner
    // needs this: (1) the `start` event's `total` must be exact
    // before the first per-test event is emitted; (2) per-test
    // names and source spans must be known even when the test
    // binary aborts mid-suite (the harness calls every `test:`
    // symbol in sequence and a single `assert false;` brings the
    // whole process down via `abort()`); (3) compile failures
    // still need attribution to the affected tests so consumers
    // see a `skip` event per declaration. The non-`--json` path
    // skips the extra read+parse and matches the previous
    // behaviour exactly — a measurable saving for the ~75-file
    // self-host suite where every read+parse cycle adds up.
    let mut per_file_entries: TestEntry[][] = [];
    let mut total_tests: int = 0;
    if json_output {
        let mut pi: int = 0;
        loop {
            if pi >= test_files.length { break; }
            let pre_path = test_files[pi];
            let pre_source = fs.readFile(pre_path);
            let mut pre_program: Program = parse_program(pre_source);
            // Mirror the per-test cut the harness compile applies
            // (issue #849) so the `start` total and per-test events
            // describe exactly the tests that will run.
            if test_filters_active() {
                pre_program = _filter_program_tests_cmd(pre_program);
            }
            let entries = collect_test_entries(pre_program, pre_path);
            per_file_entries.push(entries);
            total_tests += entries.length;
            pi += 1;
        }
        // Sub-frame children suppress their own `start`; the multi-file
        // parent emits one aggregate `start` for the whole run.
        if !json_subframe { print(render_start_event(total_tests)); }
    }

    let runner_start_ms = monotonic_millis();

    // Read the retry gate once before the loop — env var lookups
    // shell out via popen, and the gate is invariant for the
    // duration of the invocation.
    let retries_disabled = _test_retries_disabled();

    let mut total_passed: int = 0;
    let mut total_failed: int = 0;
    let mut total_skipped: int = 0;
    let mut overall_rc: int = 0;

    // #1230/#1233: per-test linked-binary cache. Resolve the
    // invocation-stable key inputs once: the compiler identity (bare
    // capsule version plus the running binary's SHA-256, so identical
    // binaries can share across commits but different binaries always
    // miss), the runtime link-input content identity (so a
    // runtime/header/include-root change busts every entry), and the
    // canonical clang flag set (`-O0`, matching
    // `_clang_link_test_cmd_with_deps`). Per-test the key additionally
    // folds the test source hash + the resolver's dep closure
    // (`dep_ll_paths` + `native_texts`). `--no-test-cache` disables both
    // the read and the write so `make check` always cold-builds — so the
    // runtime identity (the one expensive input: it hashes the runtime
    // sources + headers) is only computed when the cache is enabled.
    let mut test_cache_enabled = !no_test_cache;
    let tb_cache_root = test_bin_cache_root();
    let mut tb_compiler_identity: string = "";
    let mut tb_runtime_identity: string = "";
    if test_cache_enabled {
        let tb_compiler_version = resolve_test_bin_identity_for_cache(binary_dir);
        // `compiler_path` is the exact canonical executable resolved at
        // the native entrypoint. Do not reconstruct it from `binary_dir`:
        // a preferred sibling such as `sfn` may contain different bytes
        // when the running compiler is named `sailfin` or `sfn-selfhost2`.
        let tb_compiler_path = ctx.compiler_path;
        tb_compiler_identity = test_bin_compiler_identity(tb_compiler_version, tb_compiler_path);
        // Identity failure must fail cold. Falling back to the bare
        // capsule version would let a different compiler binary address
        // this invocation's restored test-bin entries (SFN-545).
        if tb_compiler_identity.length == 0 { test_cache_enabled = false; } else {
            tb_runtime_identity = _test_bin_runtime_identity(runtime_root, _sanitize_filename_cmd(scratch_root));
        }
    }
    let mut tb_flags: string[] = ["-O0"];
    let tb_flags_canonical = canonicalize_flags(tb_flags);
    let mut test_bin_hits: int = 0;
    let mut test_bin_misses: int = 0;

    let mut index: int = 0;
    loop {
        if index >= test_files.length { break; }
        let path = test_files[index];
        let group_idx = file_group_index[index];
        // `per_file_entries` is only populated in `--json` mode;
        // the human path doesn't read it.
        let mut entries: TestEntry[] = [];
        if json_output { entries = per_file_entries[index]; }
        if !json_output { print("test: " + path); }
        let source = fs.readFile(path);
        let module_name = module_name_from_path(path);

        if dump_sources {
            let safe = _sanitize_filename_cmd(path);
            _write_text_cmd(scratch_root + "/test-source-" + safe + ".sfn", source);
        }

        let file_start_ms = monotonic_millis();

        // #1230/#1233: derive the per-test binary cache key from the test
        // source + the resolver's dep closure (the test-source-specific
        // link inputs) plus the invocation-stable `tb_runtime_identity`
        // (the runtime link inputs — sources, headers, include roots, link
        // libs — folded by content above) and the compiler-binary content
        // identity, see `test_bin_cache_key`. Then try to serve the linked
        // binary from cache. On a hit we copy it into `exe_path` and skip
        // both LLVM
        // lowering and the clang link (the dominant per-test cost); we
        // still RUN the binary below (variant 2a — never trust a cached
        // result).
        //
        // The `_sha256_of_string` temp path is disambiguated by
        // `scratch_root` (per-invocation / per-child unique — the
        // multi-file parent mints a `mktemp -d` and hands each child its
        // own `sub-N`; seedcheck pins `SAILFIN_TEST_SCRATCH`) so
        // concurrent `sfn test` invocations and CI shards never collide
        // on the deterministic `/tmp/.sfn_build_cache_hash_*` tmp file.
        let mut tb_key: CacheKey = CacheKey { digest: "" };
        let mut cache_hit: boolean = false;
        if test_cache_enabled {
            tb_key = test_bin_cache_key(path, groups[group_idx].dep_ll_paths, groups[group_idx].native_texts, tb_compiler_identity, tb_runtime_identity, tb_flags_canonical, _sanitize_filename_cmd(scratch_root
                + "/"
                + path));
            if cache_lookup_artifact(tb_cache_root, tb_key, "test-bin") {
                if cache_copy_artifact_to(tb_cache_root, tb_key, "test-bin", exe_path) {
                    // The shared atomic-copy helper publishes through an
                    // `mktemp` temp (mode 0600), so the restored binary
                    // loses the executable bit clang gave the original —
                    // harmless for the `.ll`/`.o` artifacts the module
                    // cache restores, fatal for a binary we then `exec`
                    // (`Permission denied`, rc 126). Re-assert +x; only
                    // count the hit when chmod succeeds, otherwise leave
                    // `cache_hit` false so the run falls through to a cold
                    // lower+link (counted as a miss) rather than exec'ing a
                    // non-executable file.
                    if process.run(["chmod", "+x", exe_path]) == 0 {
                        cache_hit = true;
                        test_bin_hits += 1;
                        if trace_runner {
                            print.err("test runner: test-bin cache hit (" + path
                                + ")");
                        }
                    }
                }
            }
        }

        if !cache_hit {
            if trace_runner { print.err("test runner: compile start"); }
            _clean_lowering_state(scratch_root);
            let empty_manifests: LayoutManifest[] = [];
            let _compiled = compile_tests_to_llvm_file_with_module_imports(source, module_name, ll_path, groups[group_idx].interfaces, empty_manifests, groups[group_idx].native_texts, groups[group_idx].function_effects, groups[group_idx].capabilities_required);
            if !_compiled {
                // Stderr stays usable for compiler-internal diagnostics
                // even in `--json` mode; the affected tests show up as
                // `skip` events with a synthetic assertion message so
                // consumers can correlate the stderr noise with the
                // tests that didn't run.
                print.err("test runner: compile failed for " + path);
                if json_output {
                    let outcome = _outcome_setup_failure(_synthetic_assert_failure(path, "compile failed"));
                    let packed = _emit_file_test_events(entries, outcome);
                    total_passed += _trj_decode_passed(packed);
                    total_failed += _trj_decode_failed(packed);
                    total_skipped += _trj_decode_skipped(packed);
                    overall_rc = 1;
                    sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
                    index += 1;
                    continue;
                }
                // FAIL banner on compile failure: the bash wrapper
                // surfaced this as `[test] FAIL: <basename> (exit code 1,
                // ...)`. Emit the same shape so callers parsing test
                // output (CI log scrubbers, human readers) see consistent
                // attribution regardless of which stage failed.
                let cf_basename = _package_basename(path);
                print("[test] FAIL: " + cf_basename + " (exit code 1)");
                suites[file_suite_index[index]].fail_count += 1;
                suites[file_suite_index[index]].failed_files.push(cf_basename);
                if overall_rc == 0 { overall_rc = 1; }
                sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
                index += 1;
                continue;
            }

            if trace_runner { print.err("test runner: link start"); }
            let link_res = _clang_link_test_cmd_with_deps(ll_path, exe_path, runtime_root, groups[group_idx].dep_ll_paths, scratch_root, binary_dir);
            let link_rc = link_res.rc;
            if link_rc != 0 {
                // Only a genuine backend failure earns the SFN-34 ICE banner;
                // a preflight bailout already printed its own diagnostic
                // (SFN-212). The `[test] FAIL` line and overall_rc below are
                // unconditional, preserving exit-code fidelity either way.
                if link_res.ran_backend {
                    print.err(format_backend_failure_banner(binary_dir, "clang link", ll_path, link_rc));
                }
                if json_output {
                    let outcome = _outcome_setup_failure(_synthetic_assert_failure(path, "link failed (clang exit="
                        + number_to_string(link_rc)
                        + ")"));
                    let packed = _emit_file_test_events(entries, outcome);
                    total_passed += _trj_decode_passed(packed);
                    total_failed += _trj_decode_failed(packed);
                    total_skipped += _trj_decode_skipped(packed);
                    if overall_rc == 0 { overall_rc = link_rc; }
                    sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
                    index += 1;
                    continue;
                }
                // FAIL banner on link failure (issue #845). Same rationale
                // as the compile-failure banner above — keep `[test] FAIL`
                // attribution consistent across every failure stage so
                // tooling (CI scrubbers, human readers, future grep-based
                // log audits) sees one shape.
                let lf_basename = _package_basename(path);
                print("[test] FAIL: " + lf_basename + " (exit code "
                    + number_to_string(link_rc)
                    + ")");
                suites[file_suite_index[index]].fail_count += 1;
                suites[file_suite_index[index]].failed_files.push(lf_basename);
                if overall_rc == 0 { overall_rc = link_rc; }
                sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
                index += 1;
                continue;
            }
            // #1230: a fresh lower+link produced `exe_path`; record the miss
            // and populate the cache so the next unchanged run hits. The
            // store is atomic (temp+rename) and non-fatal — a write failure
            // just means the next run misses again, never a broken binary.
            if test_cache_enabled {
                test_bin_misses += 1;
                cache_store_artifact(tb_cache_root, tb_key, "test-bin", exe_path);
            }
        }
        // SFEP-0050 (SFN-393): run the compiled binary under the streamed
        // record transport — spawn with captured stdout+stderr, frame the
        // harness's `SFTR` records off the child's stderr, and classify
        // inline. No pre-exec unlink (no `results.log`/`fail.bin` files
        // exist), no scratch-keyed side channel — the pipe is owned by
        // this parent, so no nesting/concurrency collision is possible.
        if trace_runner { print.err("test runner: exec start"); }
        let deadline_ms = _test_deadline_ms();
        let mut br = _run_test_binary(exe_path, scratch_root, update_snapshots, json_output, deadline_ms);
        // Signal-kill retry (ported from `scripts/run_native_test.sh`
        // by issue #845). 137 (OOM-SIGKILL) / 139 (SIGSEGV) are
        // transient under sustained CI memory pressure on the
        // seedcheck phase of `make check`; retry once before
        // declaring failure. A deadline kill is remapped to 124 in
        // `_run_test_binary`, so `_should_retry_test` never retries a
        // timeout; normal asserts (1) and unrelated signals also fall
        // through. `SAILFIN_TEST_RETRY=0` opts out.
        if _should_retry_test(br.rc, retries_disabled) {
            // Banner is a human-mode artifact — the `--json` stream
            // must stay pure jsonl so consumers don't have to filter
            // out interleaved decoration. The retry itself still
            // runs in JSON mode; we just don't announce it.
            if !json_output {
                let test_basename = _package_basename(path);
                print("[test] RETRY: " + test_basename + " (exit code "
                    + number_to_string(br.rc)
                    + ", retrying once)");
            }
            // The streamed records live on the child's own pipe, so a
            // retry starts from a clean channel with no stale-record
            // carryover to unlink — the collision the file side-channel
            // needed guarding against is structurally gone.
            br = _run_test_binary(exe_path, scratch_root, update_snapshots, json_output, deadline_ms);
        }
        let run_rc = br.rc;
        if trace_runner {
            print.err("test runner: exec done (exit=" + number_to_string(run_rc)
                + ")");
        }
        // Split the streamed records: `failure` is the first assert-location
        // record (the `fail.bin` SFAF analog), `results` the `test`/`hook`
        // classification records (the `results.log` analog). `_emit_results_events`
        // and the crash fall-through consume these exactly as before.
        let failure = br.failure;
        let results = br.records;
        let file_elapsed_ms = monotonic_millis() - file_start_ms;
        // SFN-17: classify from the harness's per-test records (source of
        // truth) instead of the fail.bin index-inference — but only when
        // the records *explain* the exit code. `@main` exits non-zero iff
        // `sfn_test_failures() != 0`, and every failure increment writes a
        // record, so `run_rc == 0` (clean) or a failing record present
        // means the records are authoritative. A non-zero exit with only
        // passing records is a hard crash (SIGSEGV / non-throw `abort()`)
        // that bypassed `@main` after an earlier test passed — it must
        // fall through to the file-level crash path below, not be masked
        // as pass (#1206 / `crash_attribution_test.sfn`).
        let results_explain = run_rc == 0 || _records_have_failure(results);
        if results.length > 0 && results_explain {
            let packed = _emit_results_events(entries, results, failure, json_output, file_elapsed_ms as int, path);
            let res_failed = _trj_decode_failed(packed);
            if json_output {
                total_passed += _trj_decode_passed(packed);
                total_failed += res_failed;
                total_skipped += _trj_decode_skipped(packed);
            } else {
                let rf_basename = _package_basename(path);
                if res_failed > 0 {
                    print("[test] FAIL: " + rf_basename + " (exit code "
                        + number_to_string(run_rc)
                        + ")");
                    suites[file_suite_index[index]].fail_count += 1;
                    suites[file_suite_index[index]].failed_files.push(rf_basename);
                } else {
                    print("[test] PASS: " + _package_basename(path));
                    suites[file_suite_index[index]].pass_count += 1;
                }
            }
            // Propagate the child's real exit code (1 for a recovered
            // assert; a signal code if a later test crashed after an
            // earlier one already failed) rather than a synthetic 1.
            if res_failed > 0 && overall_rc == 0 {
                if run_rc != 0 { overall_rc = run_rc; } else { overall_rc = 1; }
            }
            sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
            index += 1;
            continue;
        }
        if run_rc != 0 {
            if json_output {
                let mut effective = failure;
                if !effective.present {
                    effective = _synthetic_assert_failure(path, "test process exited with code "
                        + number_to_string(run_rc));
                }
                let failed_index = locate_failing_test(entries, effective);
                let outcome = _outcome_failed_at(failed_index as int, effective, file_elapsed_ms as int);
                let packed = _emit_file_test_events(entries, outcome);
                total_passed += _trj_decode_passed(packed);
                total_failed += _trj_decode_failed(packed);
                total_skipped += _trj_decode_skipped(packed);
                if overall_rc == 0 { overall_rc = run_rc; }
                sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
                index += 1;
                continue;
            }
            // FAIL banner (issue #845): the bash wrapper used to emit
            // this line; the compiler emits it now so `sfn test` is
            // self-contained. The compiler's structured `test failed:`
            // detail line follows for editor-hyperlinkable assertion
            // attribution. The bash `grep -nE ... <<< "$output"`
            // diagnostic excerpt has no in-process analog (we don't
            // buffer the child's stdout/stderr), but the structured
            // `test runner: compile failed`, `link failed`, and
            // `test failed:` lines already carry the per-step
            // attribution the grep heuristic was reconstructing
            // post-hoc.
            let rf_basename = _package_basename(path);
            print("[test] FAIL: " + rf_basename + " (exit code "
                + number_to_string(run_rc)
                + ")");
            if failure.present {
                print("test failed: " + _format_assert_failure(path, failure));
            } else { print("test failed: " + path); }
            suites[file_suite_index[index]].fail_count += 1;
            suites[file_suite_index[index]].failed_files.push(rf_basename);
            if overall_rc == 0 { overall_rc = run_rc; }
            sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
            index += 1;
            continue;
        }
        if json_output {
            let outcome = _outcome_all_pass(file_elapsed_ms as int);
            let packed = _emit_file_test_events(entries, outcome);
            total_passed += _trj_decode_passed(packed);
            total_failed += _trj_decode_failed(packed);
            total_skipped += _trj_decode_skipped(packed);
        } else {
            // PASS banner (issue #845): matches the bash wrapper's
            // `[test] PASS: <basename>` output exactly. Emitted only
            // on the human path; the JSON path emits structured
            // per-test events instead.
            print("[test] PASS: " + _package_basename(path));
            suites[file_suite_index[index]].pass_count += 1;
        }
        // Phase 5a: rewind arena scratch back to the per-test
        // mark. Per-iteration allocations (parsed test AST,
        // typecheck/effect tables, emitted .ll bytes, clang
        // output buffers) live above this point and get reclaimed.
        // Cross-iteration state (test_files, groups, paths) is
        // below the mark and unaffected.
        sailfin_intrinsic_runtime_arena_rewind(test_scratch_mark);
        index += 1;
    }
    if json_output {
        let runner_elapsed_ms = monotonic_millis() - runner_start_ms;
        let summary_line = render_summary_event(total_passed, total_failed, total_skipped, runner_elapsed_ms, test_bin_hits, test_bin_misses);
        // Sub-frame children route their summary to their own stderr
        // (skimmed by the parent's reap demux) instead of printing a
        // per-file summary onto the shared stdout stream (SFEP-0050).
        if json_subframe { print.err(summary_line); } else {
            print(summary_line);
        }
    } else if emit_banners {
        // Per-suite banners. Suppressed in `--json` mode (the
        // structured summary event is the source of truth there)
        // and suppressed in legacy single-`.sfn`-file mode (direct
        // single-file callers and the multi-file path's own children
        // — `emit_banners` gates the call site).
        _emit_suite_banners(suites);
    }
    exit_test_runner_mode();
    _cleanup_test_scratch(scratch_owned, scratch_root, overall_rc == 0);
    return overall_rc;
}

export { command_def, run };
