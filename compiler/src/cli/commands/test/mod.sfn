// The `sfn/cli` definition for `test`, registered on the v2 root via
// `with_subcommand`. Three boolean flags, three value flags (`-k`,
// `--tag`, `--shard`), one int flag (`--jobs`), and a variadic `suite`
// positional.
fn command_def() -> Command {
    return with_arg(with_flag(with_flag(with_flag(with_flag(with_flag(with_flag(with_flag(with_flag(command("test", "Run tests or workspace default members"), flag("json", "Emit a JSONL event stream")), flag("update-snapshots", "Re-baseline snapshot golden files this run")), flag("no-test-cache", "Bypass the per-test linked-binary cache")), flag_value_short("k", "k", "Only run tests whose name contains this substring")), flag_value("tag", "Only run tests carrying @tag(\"<value>\")")), flag_int("jobs", "Run up to N per-file children concurrently")), flag_value("shard", "Run only the I-th of N file-count-balanced shards (e.g. 1/3)")), flag("skip-toolchain-check", "Bypass the [toolchain] pin check for this invocation")), arg_variadic("suite", "Suite paths (omit at a workspace root to test default members)"));
}

fn run(matches: Matches, ctx: CliContext) -> int ![clock, io, net] {
    // Flag surface migrated to `sfn/cli` (epic #351, Issue 3.8). The
    // legacy hand-rolled argv walk is replaced by typed builders:
    // `--json` / `--update-snapshots` / `--no-test-cache` (booleans),
    // `-k` / `--tag` (value flags), and `--jobs N` (`flag_int`, so a
    // non-integer value is rejected by `parse()` as a `type_error`
    // before `run` is reached). `runtime_root` / `binary_dir` come from
    // the driver-parsed `CliContext` instead of the old extra params.
    let runtime_root: string = ctx.runtime_root;
    let binary_dir: string = ctx.binary_dir;
    let _tc_suites: string[] = positionals(matches, "suite");
    let mut _tc_hint: string = ".";
    if _tc_suites.length > 0 { _tc_hint = _tc_suites[0]; }
    let _tc = toolchain_gate_or_dispatch(_tc_hint, ctx, has_flag(matches, "skip-toolchain-check"));
    if _tc != 0 { return _tc; }
    let json_output: boolean = has_flag(matches, "json");
    let no_test_cache: boolean = has_flag(matches, "no-test-cache");
    let update_snapshots: boolean = has_flag(matches, "update-snapshots");
    // Discovery filters (issue #849): `-k <substr>` keeps tests whose
    // name contains <substr>; `--tag <value>` keeps tests carrying
    // `@tag("<value>")`. Absent → "" (no filter), composing exactly as
    // the legacy two-`else if` branches did.
    let name_filter: string = get_or(matches, "k", "");
    let tag_filter: string = get_or(matches, "tag", "");
    // `--jobs` is a `flag_int`: `parse()` already rejected non-integer
    // input. Preserve the [1, 256] range guard (exit 2) here; absent flags
    // resolve through SAILFIN_TEST_JOBS and then the native host budget.
    let jobs: int = _resolve_test_jobs(matches);
    if jobs < 1 || jobs > 256 {
        print("sfn test: --jobs requires a positive integer in [1, 256] (got '"
            + number_to_string(jobs)
            + "')");
        return 2;
    }
    // `--shard I/N` (issue #1237): run only the I-th of N file-count-
    // balanced shards of the discovered surface. Absent → no sharding
    // (the whole surface). A malformed spec (not `I/N` with both sides
    // positive integers and `1 <= I <= N`) exits 2, mirroring the
    // `--jobs` range-guard convention. The stable stride partition is
    // applied to `test_files` after discovery/filtering, below.
    let mut shard_active: boolean = false;
    let mut shard_index: int = 1;
    let mut shard_total: int = 1;
    let shard_spec_raw: string = get_or(matches, "shard", "");
    if shard_spec_raw.length > 0 {
        let s_index: int = _parse_shard_index(shard_spec_raw);
        let s_total: int = _parse_shard_total(shard_spec_raw);
        if s_index < 0 || s_total < 0 {
            print("sfn test: --shard requires I/N with 1 <= I <= N (got '"
                + shard_spec_raw
                + "')");
            return 2;
        }
        shard_active = true;
        shard_index = s_index;
        shard_total = s_total;
    }

    // Variadic suite positionals: zero or more. Zero defaults to a single
    // "." suite below (the legacy `positional.length == 0` branch).
    let positional: string[] = positionals(matches, "suite");
    set_test_filters(name_filter, tag_filter);

    // Build the suite list. At a workspace root, zero positional args select
    // `[workspace].default-members` (or every member when undeclared). Outside
    // a workspace the historical single "." suite remains the fallback.
    // One or more positionals are unchanged.
    let mut suites: TestSuite[] = [];
    if positional.length == 0 {
        let workspace_root = discover_workspace_root(".");
        if workspace_root.length > 0 {
            let members = load_workspace_default_members(workspace_root);
            let mut wmi: int = 0;
            loop {
                if wmi >= members.length { break; }
                let member = members[wmi];
                let empty_failed: string[] = [];
                suites.push(TestSuite {
                    name: member.name, path: workspace_root + "/" + member.member_path, pass_count: 0, fail_count: 0, failed_files: empty_failed
                });
                wmi += 1;
            }
        } else {
            let empty_failed: string[] = [];
            suites.push(TestSuite {
                name: ".", path: ".", pass_count: 0, fail_count: 0, failed_files: empty_failed
            });
        }
    } else {
        let mut spi: int = 0;
        loop {
            if spi >= positional.length { break; }
            let sp = positional[spi];
            let sn = _suite_name_from_path(sp);
            let empty_failed: string[] = [];
            suites.push(TestSuite {
                name: sn, path: sp, pass_count: 0, fail_count: 0, failed_files: empty_failed
            });
            spi += 1;
        }
    }

    // Per-suite banner suppression rule: a single positional `.sfn`
    // file path runs in legacy single-file mode (no banner). Every
    // other shape — zero positionals, one directory, multiple
    // paths — emits banners. Keeps `sfn test path/to/x_test.sfn`
    // (the shape the multi-file path's own `<self> test <file>`
    // children use) byte-compatible with pre-#848 output so the
    // parent's banner aggregation isn't polluted by per-child
    // decoration.
    let mut emit_banners: boolean = true;
    if positional.length == 1 && _ends_with_cmd(positional[0], ".sfn") {
        emit_banners = false;
    }

    _ensure_dir_cmd("build");
    _ensure_dir_cmd("build/sailfin");
    // Capture whether the caller pinned the scratch root before
    // resolving it. Unpinned test invocations get an ephemeral root so
    // separate `sfn test <file>` processes cannot race on
    // `build/sailfin/test.ll` or resolver capsule `.ll` paths.
    let scratch_env = _get_env_cmd("SAILFIN_TEST_SCRATCH");
    let scratch_choice = _resolve_test_scratch_root(scratch_env);
    let scratch_root = scratch_choice.root;
    let scratch_owned = scratch_choice.owned;
    _ensure_dir_cmd(scratch_root);
    _ensure_dir_cmd(scratch_root + "/test-o0");
    // Sub-frame mode (#1121 / SFEP-0050): set by the multi-file parent on
    // each child via SAILFIN_TEST_JSON_SUBFRAME=1. In this mode a `--json`
    // child suppresses its own start on stdout (it still emits per-test
    // events, which the parent forwards from the child's stdout) and
    // routes its `summary` line to its own STDERR — the parent skims the
    // counts off the reap demux and does not forward it, aggregating them
    // into one run-level summary. The result is a single coherent jsonl
    // document per `sfn test` invocation. (The pre-SFEP-0050 transport
    // wrote the counts to `<scratch>/_subframe_summary.json`; the stream
    // replaces that side-channel file.)
    let json_subframe = json_output && _env_flag("SAILFIN_TEST_JSON_SUBFRAME");

    // Resolve the trace toggle once on the cold orchestrator path and stash
    // both bits in process-local test-runner state. The driver snapshots them
    // into each LLVM provider context instead of letting lowering import this
    // state or re-probe the filesystem on every statement.
    // See `compiler/src/test_runner_state.sfn` for the contract.
    let trace_runner = _env_flag("SAILFIN_TRACE_TEST_RUNNER")
        || _legacy_flag_file("build/sailfin/.trace_test_runner");
    enter_test_runner_mode(trace_runner);
    set_test_scratch_root(scratch_root);

    // Walk each suite's path for `_test.sfn` files. `file_suite_index`
    // tracks the originating suite per file so the loop can attribute
    // pass/fail counts back to the right banner. The flat `test_files`
    // list keeps the existing resolver-group partition + arena-mark
    // loop shape downstream — only the upstream collection step
    // fans out to multiple roots.
    let mut test_files: string[] = [];
    let mut file_suite_index: int[] = [];
    let mut csi: int = 0;
    loop {
        if csi >= suites.length { break; }
        // Sort within each suite so the run order is deterministic
        // across platforms (`fs.listDirectory` returns entries in
        // filesystem order). Matches the pre-#848 `find ... | sort`.
        let suite_files = _sort_strings_cmd(_collect_test_files_cmd(suites[csi].path, 25));
        let mut sfi: int = 0;
        loop {
            if sfi >= suite_files.length { break; }
            test_files.push(suite_files[sfi]);
            file_suite_index.push(csi);
            sfi += 1;
        }
        csi += 1;
    }

    // File-level discovery pre-filter (issue #849). When `-k`/`--tag`
    // are active, drop any test file that contains no matching test so
    // it never reaches the compile path — a file compiled with every
    // test filtered out would synthesize an empty harness (no `@main`)
    // and fail to link. The per-test cut in
    // `compile_tests_to_llvm_file_with_module_imports` then trims the
    // surviving files down to only their matching tests. Both passes
    // share `test_decl_matches_filters`, so a file kept here always has
    // at least one test that survives the cut.
    if test_filters_active() {
        let mut kept_files: string[] = [];
        let mut kept_suite_index: int[] = [];
        let mut fpi: int = 0;
        loop {
            if fpi >= test_files.length { break; }
            if _file_has_matching_test(test_files[fpi]) {
                kept_files.push(test_files[fpi]);
                kept_suite_index.push(file_suite_index[fpi]);
            }
            fpi += 1;
        }
        test_files = kept_files;
        file_suite_index = kept_suite_index;
    }

    // `--shard I/N` partition (issue #1237). Keep only the I-th of N
    // file-count-balanced shards using the stable stride
    // `i % total == index - 1` over the deterministic (sorted within each
    // suite) discovery order — mirroring `scripts/test_shards.sh`'s awk
    // stride so the runner and the legacy bash shard map agree over the
    // same file list. Applied after the `-k`/`--tag` cut so a shard
    // partitions exactly the surface that would otherwise run. The
    // `file_suite_index` parallel array is partitioned in lockstep so
    // per-suite banner attribution stays aligned. An empty shard (more
    // shards than files) falls through to the benign 0/0/0 path below.
    if shard_active {
        let mut sharded_files: string[] = [];
        let mut sharded_suite_index: int[] = [];
        let mut shi: int = 0;
        loop {
            if shi >= test_files.length { break; }
            if _shard_keeps_index(shi, shard_index, shard_total) {
                sharded_files.push(test_files[shi]);
                sharded_suite_index.push(file_suite_index[shi]);
            }
            shi += 1;
        }
        test_files = sharded_files;
        file_suite_index = sharded_suite_index;
    }

    if test_files.length == 0 {
        // Empty discovery exits 0 in BOTH modes (issue #848). The
        // pre-#848 split — JSON returned 1, the human path printed
        // "no Sailfin test files found" and also returned 1, while
        // the Makefile's `test-capsules` loop special-cased an empty
        // `capsules/` to exit 0 — left the runner and the Makefile
        // disagreeing. The unified runner standardises on the
        // `test-capsules` shape: an empty suite is a benign 0/0/0,
        // not a failure. The all-zeros JSON summary / `0/0 passed`
        // banner is the "no tests" signal consumers read; the exit
        // code stays 0 so a legitimately-empty suite (e.g. a capsule
        // with no `tests/` dir) doesn't fail the build.
        if json_output {
            if json_subframe {
                print.err(render_summary_event(0, 0, 0, 0, 0, 0));
            } else {
                print(render_start_event(0));
                print(render_summary_event(0, 0, 0, 0, 0, 0));
            }
            exit_test_runner_mode();
            _cleanup_test_scratch(scratch_owned, scratch_root, true);
            return 0;
        }
        let mut hi: int = 0;
        loop {
            if hi >= suites.length { break; }
            print("[test-" + suites[hi].name
                + "] no *_test.sfn files found under "
                + suites[hi].path);
            hi += 1;
        }
        if emit_banners { _emit_suite_banners(suites); }
        exit_test_runner_mode();
        _cleanup_test_scratch(scratch_owned, scratch_root, true);
        return 0;
    }

    // Multi-file isolation (issue #848). When more than one test file
    // runs in this invocation, compile + link + run each in a fresh
    // `<self> test <file>` subprocess and aggregate the exit codes
    // into the per-suite banners. The single-shared in-process path
    // below groups every test under one resolver pass whose
    // `native_texts` is the UNION of every test's imports — and tests
    // with conflicting expectations for the same symbol cannot
    // coexist in that union. The canonical case: `number_to_string`
    // resolves to the `![pure]` int-signature import for
    // `cross_module_int_signature_test` (pinning the #633 fix) but to
    // the `double` runtime-helper descriptor for `pure_assert_smoke_test`
    // — one resolver group can only pick one, so the loser fails with
    // an ABI mismatch. Per-file subprocesses give each test its own
    // resolver pass (its own imports only), which is exactly what the
    // retired `scripts/run_native_test.sh` per-file loop did. JSON
    // mode (#1121) also uses this per-file subprocess path — a multi-file
    // `sfn test <dir> --json` no longer forces every file through one
    // resolver pass (that single-process path OOM/segfaulted on the real
    // suite — 132 unit files — under the 8 GB cap and hit the
    // resolver-union conflicts per-file isolation exists to avoid).
    // Output stays a SINGLE coherent jsonl document per invocation: the
    // parent emits one aggregate `start`, runs each child in sub-frame
    // mode (children forward only per-test events on the shared stdout
    // and route their counts back over their own stderr `summary` line,
    // which the parent skims — SFEP-0050), then emits one aggregate
    // `summary`. Human banners and the RETRY line are suppressed in JSON
    // mode so the stream stays pure jsonl.
    if test_files.length > 1 {
        return _run_multi_file(test_files, file_suite_index, suites, jobs, json_output, name_filter, tag_filter, no_test_cache, update_snapshots, emit_banners, scratch_root, scratch_owned, runtime_root, binary_dir);
    }

    return _run_single_process(test_files, file_suite_index, suites, json_output, json_subframe, trace_runner, no_test_cache, update_snapshots, emit_banners, scratch_root, scratch_owned, runtime_root, binary_dir, ctx);
}

export { command_def, run };
