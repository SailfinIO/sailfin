import { int_to_string } from "sfn/strings";

import { AssertFailure, _empty_assert_failure } from "../../../assert_failure";
import { TestResultRecord } from "../../../test_results";
import { TestEntry, render_hook_event, render_test_event } from "../../../test_runner_json";

// SFN-17: collect the `T` (per-test) records in emission order. The
// harness writes exactly one `T` record per test in source order (a
// pass, or a fail; a passed test whose `after_each` fails still has one
// `T pass` plus a separate `H` record). Matching these to `entries` by
// position is robust to the display-name/symbol-name mismatch: the
// harness only has the sanitized `test:` symbol (spaces stripped), while
// `collect_test_entries` keeps the raw test name — but both sequences are
// the non-hook tests in identical source order.
fn _collect_test_records(records: TestResultRecord[]) -> TestResultRecord[] {
    let mut out: TestResultRecord[] = [];
    let mut i: int = 0;
    loop {
        if i >= records.length { break; }
        if strings_equal(records[i].kind, "T") { out.push(records[i]); }
        i += 1;
    }
    return out;
}

// SFN-17: true when any record is a failure (a `T fail` or any `H`
// record — hook records are always failures). Used to decide whether
// `results.log` *explains* a non-zero exit: a hard crash (SIGSEGV/abort,
// which `setjmp` cannot catch) after a passing test leaves a non-empty
// log with only `pass` records, and must NOT be classified as pass — it
// falls through to the file-level crash path instead.
fn _records_have_failure(records: TestResultRecord[]) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= records.length { break; }
        if strings_equal(records[i].status, "fail") { return true; }
        i += 1;
    }
    return false;
}

// SFN-1096: `records` now carries the paired assert location directly
// (`_test_hook_records` in `exec.sfn` stamps it onto the failing record in
// stream order), so a failure's location is read off the record itself
// rather than matched by message-text equality against the file's FIRST
// assert failure — the prior gate stamped every failure after the first
// with the first one's location. `r.line > 0` is the "have a location"
// signal, matching the `_synthetic_assert_failure` convention that an
// unpinned failure carries `line: 0`.
fn _record_assert_failure(test_path: string, r: TestResultRecord) -> AssertFailure {
    if r.line > 0 {
        return AssertFailure {
            present: true,
            file: r.file,
            line: r.line,
            col: r.col,
            message: r.message
        };
    }
    return _synthetic_assert_failure(test_path, r.message);
}

// SFN-17: structured per-test/hook classification from `results.log`.
// Replaces the fail.bin index-inference when the recoverable harness
// produced real per-test records — each test is classified by its own
// record (source of truth), and hook failures surface as distinct
// events (JSON) / lines (human). Per-failure file:line:col comes from
// `_record_assert_failure` reading the record's own paired location
// (SFN-1096); the `failure` param is unused in this function's body now,
// left on the signature unchanged since `TestBinResult.failure` is still
// the crash-fallback location for the no-records case in
// `single_process_run.sfn`. Returns pass/fail/skip packed as
// `_emit_file_test_events` does.
fn _emit_results_events(entries: TestEntry[], records: TestResultRecord[], failure: AssertFailure, json_output: boolean, elapsed_ms: int, test_path: string) -> int ![io] {
    let t_records = _collect_test_records(records);
    // --- Counting from the records (source of truth). This must not
    // depend on `entries`, which is populated only in `--json` mode
    // (line ~1238); a human-mode run has `entries == []` but still needs
    // correct pass/fail counts driving the file banner + exit code. ---
    let mut passed: int = 0;
    let mut failed: int = 0;
    // SFN-815: a body-declared `skip(reason)` arrives as a real `T` record
    // with status `skip`. Without this branch it would land in the `else`
    // and be counted a failure — the runner previously never saw a `skip`
    // record because nothing could emit one.
    let mut declared_skips: int = 0;
    let mut tr: int = 0;
    loop {
        if tr >= t_records.length { break; }
        if strings_equal(t_records[tr].status, "pass") { passed += 1; } else if strings_equal(t_records[tr].status, "skip") {
            declared_skips += 1;
        } else { failed += 1; }
        tr += 1;
    }
    let mut hcount: int = 0;
    let mut hc: int = 0;
    loop {
        if hc >= records.length { break; }
        if strings_equal(records[hc].kind, "H") { hcount += 1; }
        hc += 1;
    }
    failed += hcount;
    // Tests with no record ran neither pass nor fail (a crash before
    // reaching them). Only knowable when `entries` is present (`--json`).
    // Declared skips are known from the records alone, so they count in
    // both modes.
    let mut skipped: int = declared_skips;
    if entries.length > t_records.length {
        skipped += entries.length - t_records.length;
    }
    // --- Emission. JSON emits one event per entry (needs `entries`, only
    // present in `--json` mode); human mode prints a detail line per
    // failing test from the records directly (per-test pass lines are
    // noise in the human stream, matching the pre-SFN-17 banner style). ---
    if json_output {
        let per_test_ms = _trj_per_test_duration(elapsed_ms, entries.length);
        let mut idx: int = 0;
        loop {
            if idx >= entries.length { break; }
            let entry = entries[idx];
            let mut status: string = "skip";
            // No record for this entry at all — the process died before
            // reaching it. Involuntary, and distinct from a declared skip.
            let mut skip_kind: string = "not_run";
            let mut event_failure: AssertFailure = _empty_assert_failure();
            if idx < t_records.length {
                let r = t_records[idx];
                if strings_equal(r.status, "pass") {
                    status = "pass";
                    skip_kind = "";
                } else if strings_equal(r.status, "skip") {
                    // SFN-815: the body called `skip(reason)`. Carry the
                    // reason on the assertion object so it is retrievable
                    // from the event stream, the same way the involuntary
                    // sites carry the runner's explanation.
                    status = "skip";
                    skip_kind = "declared";
                    event_failure = _synthetic_assert_failure(test_path, r.message);
                } else {
                    status = "fail";
                    skip_kind = "";
                    event_failure = _record_assert_failure(test_path, r);
                }
            }
            print(render_test_event(entry.name, entry.file, entry.line, status, per_test_ms, entry.effects, event_failure, skip_kind));
            idx += 1;
        }
    } else {
        let mut tri: int = 0;
        loop {
            if tri >= t_records.length { break; }
            let r = t_records[tri];
            if strings_equal(r.status, "fail") {
                let ef = _record_assert_failure(test_path, r);
                print("[test] FAIL: " + r.name + " (" + _format_assert_failure(test_path, ef)
                    + ")");
            } else if strings_equal(r.status, "skip") {
                // SFN-815: per-test pass lines are deliberately omitted as
                // noise, but a skip is not noise — an unreported skip is
                // exactly what made a dormant test read as a passing one.
                print("[test] SKIP: " + r.name + " (" + r.message + ")");
            }
            tri += 1;
        }
    }
    // Hook-failure events (AC3/AC4), in record order, after the tests.
    let mut hi: int = 0;
    loop {
        if hi >= records.length { break; }
        let r = records[hi];
        if strings_equal(r.kind, "H") {
            if json_output {
                print(render_hook_event(r.hook, r.name, r.status, r.message));
            } else {
                print("[test] HOOK FAIL: " + r.hook + " (" + r.message + ")");
            }
        }
        hi += 1;
    }
    return passed * 1000000 + failed * 1000 + skipped;
}

// Format an AssertFailure for human-readable test runner output.
// Matches the shape `path:line:col: message` so editors / CI
// log-renderers can hyperlink the location.
fn _format_assert_failure(test_path: string, failure: AssertFailure) -> string {
    let mut location = test_path;
    if failure.file.length > 0 { location = failure.file; }
    return location + ":" + int_to_string(failure.line) + ":" + int_to_string(failure.col)
        + ": "
        + failure.message;
}

// `TestSuite`: per-positional-path bucket for banner emission.
// Each positional `path` passed to `sfn test` becomes one suite;
// the runner walks `path` for `*_test.sfn` files, runs them, and
// emits a `═══ <name>: N/M passed, K failed ═══` banner per suite
// after the test loop completes. Issue #848 (parent epic #840
// Phase 1.2): consolidates the four Makefile shell loops
// (`test-unit` / `test-integration` / `test-e2e` / `test-capsules`)
// into a single `sfn test` invocation that emits the same banners
// the loops used to.
struct TestSuite {
    name: string;
    path: string;
    pass_count: int;
    fail_count: int;
    failed_files: string[];
}

// Emit the per-suite `═══ <name>: N/M passed, K failed ═══` banner
// for every suite, followed by an indented failed-files list when
// the suite has failures. Format matches the pre-#848 Makefile
// shell-loop output at `Makefile:215-220, 243-248, 279-284, 314-319`
// exactly so log scrubbers and human readers see no diff. Called
// once at end-of-run from `run` only in non-JSON
// mode — JSON consumers parse the structured summary event
// instead.
fn _emit_suite_banners(suites: TestSuite[]) ![io] {
    let mut bi: int = 0;
    loop {
        if bi >= suites.length { break; }
        let s = suites[bi];
        let total = s.pass_count + s.fail_count;
        print("");
        print("═══ " + s.name + ": " + int_to_string(s.pass_count) + "/"
            + int_to_string(total)
            + " passed, "
            + int_to_string(s.fail_count)
            + " failed ═══");
        if s.fail_count > 0 {
            print("");
            let mut fi: int = 0;
            loop {
                if fi >= s.failed_files.length { break; }
                print("  " + s.failed_files[fi]);
                fi += 1;
            }
        }
        bi += 1;
    }
}

// Synthesize an `AssertFailure` for a test that was skipped or for
// which we have no `fail.bin` record. `present=true` so the JSON
// emitter still attaches an `assertion` object — consumers can
// inspect `message` for the runner's reason (compile failed, link
// failed, process aborted before reaching this test, etc.). The
// `line`/`col` are 0 because the failure is not pinned to a
// specific source location.
fn _synthetic_assert_failure(file: string, message: string) -> AssertFailure {
    return AssertFailure {
        present: true,
        file: file,
        line: 0,
        col: 0,
        message: message
    };
}

// Per-file outcome buckets used by the JSON emitter. The runner
// drives these as it processes each file; they're consumed at the
// bottom of the loop iteration to emit per-test events without
// re-entering the per-file branches.
struct TestFileOutcome {
    kind: string;
    failed_index: int;
    failure: AssertFailure;
    elapsed_ms: int;
}

fn _outcome_all_pass(elapsed_ms: int) -> TestFileOutcome {
    return TestFileOutcome {
        kind: "pass",
        failed_index: -1,
        failure: _empty_assert_failure(),
        elapsed_ms: elapsed_ms
    };
}

fn _outcome_failed_at(failed_index: int, failure: AssertFailure, elapsed_ms: int) -> TestFileOutcome {
    return TestFileOutcome {
        kind: "fail",
        failed_index: failed_index,
        failure: failure,
        elapsed_ms: elapsed_ms
    };
}

fn _outcome_setup_failure(failure: AssertFailure) -> TestFileOutcome {
    return TestFileOutcome {
        kind: "setup_failed",
        failed_index: -1,
        failure: failure,
        elapsed_ms: 0
    };
}

// Even-distribution slice for per-test `duration_ms`. A file's
// binary executes every test in one process, so per-test wall time
// is not directly observable; spec §11 documents the
// even-distribution approximation used here. Returns 0 when the
// file produced no test entries.
fn _trj_per_test_duration(file_elapsed_ms: int, test_count: int) -> int {
    if test_count <= 0 { return 0; }
    if file_elapsed_ms <= 0 { return 0; }
    let mut quotient: int = 0;
    let mut remaining: int = file_elapsed_ms;
    loop {
        if remaining < test_count { break; }
        remaining -= test_count;
        quotient += 1;
    }
    return quotient;
}

// Emit one jsonl `test` event per entry in `entries`, attributing
// outcomes per `outcome.kind`. Stdout-only — caller must not have
// mixed any human banner output into the same stream.
fn _emit_file_test_events(entries: TestEntry[], outcome: TestFileOutcome) -> int ![io] {
    let total_in_file = entries.length;
    let per_test_ms = _trj_per_test_duration(outcome.elapsed_ms, total_in_file);
    let mut passed: int = 0;
    let mut failed: int = 0;
    let mut skipped: int = 0;
    let mut idx: int = 0;
    loop {
        if idx >= entries.length { break; }
        let entry = entries[idx];
        let mut status: string = "pass";
        // SFN-815: every skip this function produces is involuntary — the
        // file never built, or an earlier failure aborted the process. The
        // qualifier keeps them distinguishable from a body-declared skip.
        let mut skip_kind: string = "";
        let mut event_failure: AssertFailure = _empty_assert_failure();
        if strings_equal(outcome.kind, "pass") {
            status = "pass";
            passed += 1;
        } else if strings_equal(outcome.kind, "setup_failed") {
            status = "skip";
            skip_kind = "setup_failed";
            event_failure = outcome.failure;
            skipped += 1;
        } else {
            // outcome.kind == "fail"
            if outcome.failed_index < 0 {
                // Couldn't pin the failure to a specific test; flag the
                // first entry as the failing one and skip the rest. See
                // spec §11 for the attribution rule.
                if idx == 0 {
                    status = "fail";
                    event_failure = outcome.failure;
                    failed += 1;
                } else {
                    status = "skip";
                    skip_kind = "after_failure";
                    skipped += 1;
                }
            } else {
                if idx < outcome.failed_index {
                    status = "pass";
                    passed += 1;
                } else if idx == outcome.failed_index {
                    status = "fail";
                    event_failure = outcome.failure;
                    failed += 1;
                } else {
                    status = "skip";
                    skip_kind = "after_failure";
                    skipped += 1;
                }
            }
        }
        let line = render_test_event(entry.name, entry.file, entry.line, status, per_test_ms, entry.effects, event_failure, skip_kind);
        print(line);
        idx += 1;
    }
    // Pack pass/fail/skip into the outcome's `failed_index` slot via
    // a side-effect-free encoding for the caller's running totals.
    // Returning a struct from this function would force the caller
    // into another pattern-match; instead we expose three accessors
    // on a small typed counter.
    return passed * 1000000 + failed * 1000 + skipped;
}

fn _trj_decode_passed(packed: int) -> int {
    let mut p: int = packed;
    if p < 0 { p = 0 - p; }
    let mut count: int = 0;
    loop {
        if p < 1000000 { break; }
        p -= 1000000;
        count += 1;
    }
    return count;
}

fn _trj_decode_failed(packed: int) -> int {
    let mut p: int = packed;
    if p < 0 { p = 0 - p; }
    // Strip the millions slot.
    loop {
        if p < 1000000 { break; }
        p -= 1000000;
    }
    let mut count: int = 0;
    loop {
        if p < 1000 { break; }
        p -= 1000;
        count += 1;
    }
    return count;
}

fn _trj_decode_skipped(packed: int) -> int {
    let mut p: int = packed;
    if p < 0 { p = 0 - p; }
    loop {
        if p < 1000000 { break; }
        p -= 1000000;
    }
    loop {
        if p < 1000 { break; }
        p -= 1000;
    }
    return p;
}

// SFN-862: format an integer millisecond duration as fixed-point seconds
// with two decimal places (e.g. `1234` -> `"1.23"`). Mirrors the shape of
// `_fmt_secs` in `bench.sfn`; not imported from there since it is
// module-private. Callers append the trailing "s".
fn _fmt_elapsed_ms(ms: int) -> string {
    let mut clamped: int = ms;
    if clamped < 0 { clamped = 0; }
    let s = clamped / 1000;
    let cs = (clamped % 1000) / 10;
    let mut cs_str = int_to_string(cs);
    if cs < 10 { cs_str = "0" + cs_str; }
    return int_to_string(s) + "." + cs_str;
}

// SFN-862: print the `[test] slowest N files:` summary at the end of a
// human-mode run. Files whose timing was never captured (compile/link
// failures) are excluded, and the summary is suppressed entirely for a
// single-file run or when `limit <= 0`. Returns whether anything was
// printed.
fn _emit_slowest_summary(names: string[], elapsed_ms: int[], limit: int) -> boolean ![io] {
    if limit <= 0 { return false; }
    let mut fnames: string[] = [];
    let mut fms: int[] = [];
    let mut i: int = 0;
    // SFN-862: `names`/`elapsed_ms` are pushed in lockstep by the caller;
    // the min-length guard is defensive against a mismatched pair.
    let mut pair_count = elapsed_ms.length;
    if names.length < pair_count { pair_count = names.length; }
    loop {
        if i >= pair_count { break; }
        if elapsed_ms[i] > 0 {
            fnames.push(names[i]);
            fms.push(elapsed_ms[i]);
        }
        i += 1;
    }
    if fnames.length < 2 { return false; }
    // Selection sort, descending by ms then ascending by name.
    let mut a: int = 0;
    loop {
        if a >= fms.length { break; }
        let mut best: int = a;
        let mut b: int = a + 1;
        loop {
            if b >= fms.length { break; }
            if fms[b] > fms[best] { best = b; } else if fms[b] == fms[best] {
                if fnames[b] < fnames[best] { best = b; }
            }
            b += 1;
        }
        if best != a {
            let tmp_ms = fms[a];
            fms[a] = fms[best];
            fms[best] = tmp_ms;
            let tmp_name = fnames[a];
            fnames[a] = fnames[best];
            fnames[best] = tmp_name;
        }
        a += 1;
    }
    let mut shown = fnames.length;
    if limit < shown { shown = limit; }
    print("[test] slowest " + int_to_string(shown) + " files:");
    let mut r: int = 0;
    loop {
        if r >= shown { break; }
        print("[test]   " + int_to_string(r + 1) + ". " + _fmt_elapsed_ms(fms[r])
            + "s  "
            + fnames[r]);
        r += 1;
    }
    return true;
}

export {
    _collect_test_records,
    _records_have_failure,
    _emit_results_events,
    _format_assert_failure,
    TestSuite,
    _emit_suite_banners,
    _synthetic_assert_failure,
    TestFileOutcome,
    _outcome_all_pass,
    _outcome_failed_at,
    _outcome_setup_failure,
    _trj_per_test_duration,
    _emit_file_test_events,
    _trj_decode_passed,
    _trj_decode_failed,
    _trj_decode_skipped,
    _fmt_elapsed_ms,
    _emit_slowest_summary
};
