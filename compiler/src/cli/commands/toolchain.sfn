// compiler/src/cli/commands/toolchain.sfn
//
// Public CLI facade. Store identity, acquisition, and dispatch live in
// cohesive compiler/src/toolchain modules; existing imports keep this stable.
import { diagnostic_to_diag } from "sfn/analyzer/typecheck_types";
import {
    Command,
    Matches,
    arg,
    command,
    get,
    subcommand,
    with_arg,
    with_subcommand,
    with_usage
} from "sfn/cli";

import { render_terminal_diagnostic } from "../../terminal_output";
import { toolchain_install_to_user_store } from "../../toolchain/install";
import { toolchain_store_diagnostic, toolchain_versions_base } from "../../toolchain/store";
import { CliContext } from "../context";

fn _toolchain_install(version: string, work_root: string) -> int ![io, net] {
    let versions_base = toolchain_versions_base();
    if versions_base.length == 0 {
        let empty_lines: string[] = [];
        print.err(render_terminal_diagnostic(diagnostic_to_diag(toolchain_store_diagnostic(), "toolchain"), empty_lines, "toolchain"));
        return 1;
    }
    return toolchain_install_to_user_store(version, versions_base, work_root);
}

fn command_def() -> Command {
    let install_cmd = with_arg(command("install", "Download, verify, and store a pinned toolchain"), arg("version", "Toolchain version to install (e.g. 0.8.0-alpha.3)"));
    let cmd = with_subcommand(command("toolchain", "Manage installed sfn toolchains"), install_cmd);
    return with_usage(cmd, "packages", "sfn toolchain install <ver>", "install a toolchain version");
}

fn run(matches: Matches, ctx: CliContext) -> int ![clock, io, net] {
    let sub = subcommand(matches);
    if sub == "install" {
        let mut work_root = env.get("TMPDIR");
        if work_root.length == 0 { work_root = "/tmp"; }
        return _toolchain_install(get(matches, "version"), work_root);
    }
    print("usage: sfn toolchain install <version>");
    return 2;
}

export { command_def, run };

export { toolchain_gate_or_dispatch } from "../../toolchain/dispatch";

export { toolchain_install_to_base, toolchain_is_valid_install_version } from "../../toolchain/install";

export { _toolchain_link_alias, toolchain_lay_out_store_entry } from "../../toolchain/store";

export { _detect_arch, _detect_os } from "../../toolchain/host";
