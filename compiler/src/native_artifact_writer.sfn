// Driver-owned native-text publication used by capsule staging. Validation
// lives separately so cross-target emission can compile each closure within
// the native compiler's memory budget.
import { Diag } from "sfn/analyzer/diagnostic";
import { emit_native_diag_lines } from "sfn/codegen";
import { native_lines_have_text } from "sfn/ir";
import { Program, parse_program } from "sfn/syntax";

import { _publish_lines_atomic } from "./build/fs";
import { _env_flag } from "./build_flags";
import { emit_native_lines_with_module_name } from "./codegen_driver";
import { validate_staged_program } from "./native_artifact_validation";

fn _staging_report_emit_diags(diags: Diag[], file_path: string) ![io] {
    if !_env_flag("SAILFIN_DEBUG_LOWERING") { return; }
    let mut index: int = 0;
    loop {
        if index >= diags.length { break; }
        diags[index].file_path = file_path;
        index += 1;
    }
    let lines = emit_native_diag_lines(diags);
    index = 0;
    loop {
        if index >= lines.length { break; }
        print.err("[emit-native] " + lines[index]);
        index += 1;
    }
}

fn write_staged_native_text_file(source: string, module_name: string, out_path: string) -> boolean ![io] {
    let program: Program = parse_program(source);
    if !validate_staged_program(program, source, module_name) { return false; }
    let emitted = emit_native_lines_with_module_name(program, module_name);
    _staging_report_emit_diags(emitted.diags, module_name);
    if !native_lines_have_text(emitted.lines) { return false; }
    return _publish_lines_atomic(out_path, emitted.lines);
}

export { write_staged_native_text_file };
