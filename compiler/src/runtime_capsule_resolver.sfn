// compiler/src/runtime_capsule_resolver.sfn
//
// Stage D PR1 — discover `kind = "runtime"` workspace members and
// surface their declarative C / LL / include / link-libs metadata
// for downstream consumers.
//
// `kind = "runtime"` capsules don't ship `.sfn` modules. They ship
// C source (`c-sources`), pre-written LLVM IR (`ll-sources`),
// header roots (`include-dirs`), and link flags (`link-libs`)
// declared in `capsule.toml`. The driver compiles each `.c` with
// clang, assembles each `.ll` with clang, propagates `-I` flags
// from the include roots, and appends the link flags to the final
// link.
//
// This module is the surface every downstream consumer (the link
// phase, the cache key digester, future cross-compile target
// resolution) reads from. PR1 introduces the surface as
// dead-code: no production call site invokes
// `enumerate_runtime_capsule_artifacts` yet — that wires up in
// Stage D PR2 when `_clang_compile_runtime_objects` stops using
// hardcoded `runtime/native/...` paths and starts iterating
// resolved artifacts. The unit test in
// `compiler/tests/unit/runtime_capsule_resolver_test.sfn` is the
// only consumer in this PR.
//
// Path resolution rule: every path returned in
// `RuntimeCapsuleArtifacts` is workspace-rooted (i.e.
// `workspace_root + "/" + manifest_member_path + "/" + relative`),
// so consumers don't have to redo the join. The manifest stores
// paths relative to its own directory (Cargo-style); the
// resolver does the workspace-rooted resolution once.
import { canonical_effects } from "sfn/analyzer/effect_taxonomy";

import {
    SourceIdentityOwner,
    source_identity_for,
    source_role_runtime_provider
} from "./module_paths";
import { contains_string, strip_prefix, substring } from "./string_utils";
import {
    toml_get_build_kind,
    toml_get_c_sources,
    toml_get_dependencies,
    toml_get_include_dirs,
    toml_get_link_libs,
    toml_get_ll_sources,
    toml_get_name,
    toml_get_prelude_entry,
    toml_get_sfn_module_prefix,
    toml_get_sfn_source_gate,
    toml_get_sfn_source_root,
    toml_get_sfn_sources,
    toml_get_string_array,
    toml_get_target_triples,
    toml_get_workspace_members
} from "./toml_parser";

// Target-specific runtime inputs parsed from one `[targets.<triple>]`
// manifest table (SFN-775 / SFEP-0068). Paths are resolved at the same
// manifest boundary as the base runtime inputs; the build layer only applies
// these already-canonical records. Keeping one descriptor per triple makes
// target conditioning data-driven without coupling manifest discovery to the
// process-global active target.
struct RuntimeTargetArtifacts {
    triple: string;
    valid: boolean;
    // Absolute `from\tto` records. A tab cannot occur in a TOML path token,
    // so the representation stays unambiguous without adding a pair type.
    sfn_source_replacements: string[];
    sfn_sources_add: string[];
    sfn_sources_drop: string[];
    ll_sources_add: string[];
    link_libs_add: string[];
    link_libs_drop: string[];
}

// Resolved per-runtime-capsule build inputs. All paths are
// workspace-rooted; consumers feed them straight into
// `process.run([...])` argv arrays for clang.
//
// `link_libs` is intentionally not path-resolved — these are
// linker flags (e.g. `-lm`, `-lpthread`), not files. They flow
// through verbatim.
//
// `sfn_sources` is the production-ready replacement for the
// Makefile-staged `prelude.o` pattern: any `runtime/sfn/*.sfn`
// module the runtime capsule wants linked into every consumer
// is declared in the manifest's `[build] sfn-sources` array.
// The driver iterates each entry, spawns the compiler subprocess
// to emit `.ll`, and runs `clang -c` to produce the `.o`. This
// path is what enables the Sailfin-native runtime modules
// (`runtime/sfn/clock.sfn`, `runtime/sfn/io.sfn`, …) to ship
// without per-module Makefile wiring.
struct RuntimeCapsuleArtifacts {
    capsule_name: string;
    manifest_dir: string;
    c_sources: string[];
    ll_sources: string[];
    sfn_sources: string[];
    include_dirs: string[];
    link_libs: string[];
    prelude_entry: string;
    sfn_source_root: string;
    sfn_module_prefix: string;
    // Ordinary `kind = "library"` capsules this runtime capsule declares in
    // `[dependencies]`. Spec names only (`["sfn/crypto"]`); the declared
    // version is deliberately dropped, because a runtime capsule's dep is
    // located by path off the runtime manifest dir rather than by version —
    // it ships with the toolchain, same provenance as the runtime itself
    // (SFN-773, design note `sfn-341-native-tls-runtime-swap.md` §3.1.4).
    // Reintroducing versioned runtime deps is a deliberate future change,
    // not an oversight.
    capsule_deps: string[];
    // SFN-882: the manifest's `[sfn-source-gates]` table, resolved to absolute
    // paths, as `"<effect>\t<absolute-source-path>"` records. A source named
    // here is compiled only when the build's demand set contains `<effect>`; a
    // source absent from every record is always compiled.
    //
    // A record list rather than an array parallel to `sfn_sources` because
    // manifest target conditioning rewrites that list — substituting and
    // appending platform siblings — so any positional alignment is stale
    // the moment conditioning runs. Keying on the path makes the lookup
    // independent of both ordering and length, which is what lets selection and
    // conditioning compose in either order (SFN-882 design note §4.7).
    //
    // Paths are resolved through `_rcr_resolve_paths` here, at parse time, so
    // the comparison downstream is absolute-to-absolute and cannot drift when
    // `SAILFIN_RUNTIME_ROOT` relocates the runtime — the SFN-146 defect class.
    sfn_source_gates: string[];
    target_artifacts: RuntimeTargetArtifacts[];
}

fn empty_runtime_capsule_artifacts() -> RuntimeCapsuleArtifacts {
    let empty: string[] = [];
    let empty2: string[] = [];
    let empty3: string[] = [];
    let empty4: string[] = [];
    let empty5: string[] = [];
    let empty6: string[] = [];
    let empty7: string[] = [];
    let empty_targets: RuntimeTargetArtifacts[] = [];
    return RuntimeCapsuleArtifacts {
        capsule_name: "",
        manifest_dir: "",
        c_sources: empty,
        ll_sources: empty2,
        sfn_sources: empty5,
        include_dirs: empty3,
        link_libs: empty4,
        prelude_entry: "",
        sfn_source_root: "",
        sfn_module_prefix: "",
        capsule_deps: empty6,
        sfn_source_gates: empty7,
        target_artifacts: empty_targets
    };
}

// ---- Path helpers ----
// True iff `ch` is a path separator. Windows accepts `/` and `\`
// interchangeably in every Win32 file API, and both
// `GetModuleFileNameA` and `_fullpath` hand back `\` — so a path
// reaching this module on Windows routinely carries either, or
// both in one string (SFN-642).
fn _rcr_is_sep(ch: string) -> boolean { return ch == "/" || ch == "\\"; }

// True iff `ch` is an ASCII letter, i.e. a candidate drive letter.
fn _rcr_is_drive_letter(ch: string) -> boolean {
    let code = char_code(ch);
    if code >= 65 && code <= 90 { return true; }
    return code >= 97 && code <= 122;
}

// True iff `path` is exactly a bare drive-relative root (`C:`), with
// no segment after it. `C:a` is not this — it already has a segment.
fn _rcr_is_bare_drive_root(path: string) -> boolean {
    if path.length != 2 { return false; }
    if substring(path, 1, 2) != ":" { return false; }
    return _rcr_is_drive_letter(substring(path, 0, 1));
}

// `path_join("a", "b")` → `"a/b"`. Idempotent on trailing separators.
fn _rcr_path_join(base: string, name: string) -> string {
    if base.length == 0 { return name; }
    if name.length == 0 { return base; }
    // A bare drive-relative root takes NO separator: `C:` names the
    // working directory on drive C, so `C:` + `sfn` is `C:sfn`.
    // Inserting a `/` would silently promote it to `C:/sfn`, the root
    // of drive C — a different file. `_rcr_normalize_path` defends
    // this same distinction when it reassembles (see its `lead`), and
    // the two must agree or the round trip through
    // `_rcr_resolve_path` loses it (SFN-642).
    if _rcr_is_bare_drive_root(base) { return base + name; }
    if _rcr_is_sep(substring(base, base.length - 1, base.length)) {
        return base + name;
    }
    return base + "/" + name;
}

// Length of the leading ROOT of `path`, or 0 when `path` is
// relative. The root is the prefix `..` may never climb past.
//
// Recognized roots:
//   `/`               POSIX                      -> 1
//   `C:/` or `C:\`    drive-absolute             -> 3
//   `C:`              drive-RELATIVE             -> 2
//   `\\server\share`  UNC                        -> through the share
//
// UNC is detected ONLY in its backslash form. `//foo/bar` is a
// legal POSIX path that must keep collapsing to `/foo/bar`, and
// no Windows tool emits a forward-slash UNC — so treating `//` as
// a UNC root would break POSIX byte-identity to buy nothing.
fn _rcr_root_prefix_len(path: string) -> int {
    if path.length == 0 { return 0; }
    if path.length >= 2 && substring(path, 0, 2) == "\\\\" {
        // Scan the server component, then the share component. Both
        // belong to the root: `\\server\share\..` clamps to
        // `\\server\share` and never climbs to `\\server`.
        let mut i: int = 2;
        loop {
            if i >= path.length { break; }
            if _rcr_is_sep(substring(path, i, i + 1)) { break; }
            i += 1;
        }
        if i >= path.length { return path.length; }
        // Consume exactly ONE separator, never a run. On a doubled
        // separator (`\\srv\\a`) the share scan then starts on the
        // second separator and matches an EMPTY share, so the root is
        // `\\srv\` and `a` is an ordinary poppable segment. That looks
        // like an off-by-one but it is precisely what Win32 does —
        // verified, because the intuitive reading is wrong:
        //   GetFullPath("//srv//a/../../b")   -> "\\srv\b"    (a popped)
        //   GetFullPath("//srv/sh/a/../../b") -> "\\srv\sh\b" (sh kept)
        // Skipping the run instead would keep `a` as the share and
        // diverge from the platform.
        i += 1;
        loop {
            if i >= path.length { break; }
            if _rcr_is_sep(substring(path, i, i + 1)) { break; }
            i += 1;
        }
        return i;
    }
    if path.length >= 2 && substring(path, 1, 2) == ":" && _rcr_is_drive_letter(substring(path, 0, 1)) {
        if path.length >= 3 && _rcr_is_sep(substring(path, 2, 3)) { return 3; }
        return 2;
    }
    if _rcr_is_sep(substring(path, 0, 1)) { return 1; }
    return 0;
}

// Collapse `.` and `..` segments in a path. Used
// by `_rcr_resolve_path` to produce canonical workspace-rooted
// paths from manifest entries that climb out of the manifest
// dir (e.g. `runtime/native` + `../sfn/io.sfn` →
// `runtime/sfn/io.sfn`, not `runtime/native/../sfn/io.sfn`).
//
// Why canonicalize here: downstream consumers feed these paths
// to `sfn emit` as the source argument. The compiler's import
// resolver (the path arithmetic that turns
// `import { write } from "./platform/libc"` into a sibling
// `.sfn` to load) does not normalize `..` segments — passing a
// `runtime/native/../sfn/io.sfn` source path resolves the
// import as `runtime/native/../sfn/platform/libc`, which the
// import-loader's lookup table does not match cleanly. Canonical
// paths sidestep that by ensuring the source path string has
// no `..` segments to begin with.
//
// Only collapses lexically; does not touch the filesystem (no
// symlink resolution). Leading `..` segments that can't be
// collapsed survive in the output (e.g. `../sfn/io.sfn` stays
// `../sfn/io.sfn` when there's no parent to consume).
//
// SFN-642 — separator-agnostic and root-aware. Splitting on `/`
// alone made a drive-qualified Windows path a single opaque
// segment, so `C:\Users\foo\bin/../runtime` collapsed to a bare
// `runtime`: silent corruption of the runtime root. Splitting on
// both separators is necessary but NOT sufficient — under the old
// `path[0] == "/"` absoluteness test a drive prefix stays an
// ordinary poppable segment, so `C:\a\..\..\b` still yields `b`.
// The root has to be recognized AS a root.
//
// The rule applied is the one Windows itself uses, and the one this
// function already applied to `/`: an absolute root ABSORBS excess
// `..`. Verified against Win32 rather than assumed —
//   GetFullPath("C:/a/b/../../../../c")   -> "C:\c"
//   GetFullPath("//server/share/a/../..") -> "\\server\share"
//
// Output form: segments always rejoin with `/`, which Win32 accepts
// in drive and UNC paths alike, so the rest of the compiler keeps
// its single `/`-shaped assumption. The root is emitted verbatim
// apart from the drive/POSIX separator (`C:\` → `C:/`), because
// this function must be IDEMPOTENT — `_rcr_artifacts_from_manifest`
// normalizes `manifest_dir` and then re-normalizes it once per
// artifact through `_rcr_resolve_path`, so already-normalized output
// is re-fed 5+ times per capsule. Rewriting a `\\server\share` root
// to `//server/share` would make the next pass re-read it as a POSIX
// root and hand back `/server/share`.
//
// Idempotent is not the same as extension-stable, and this function
// is only the former. `normalize("\\srv\\a")` renders the empty-share
// root as `\\srv\a`, promoting `a` from a segment to the share, so a
// later `../b` clamps instead of popping. Win32 `GetFullPath` has the
// identical property — its own output re-parsed reads `a` as a share
// too — so this matches the platform including its lossiness.
//
// The manifest-aware source-identity service applies the same lexical root
// rules to source and owner paths. Keep this resolver-facing helper aligned;
// it remains here because manifest resolution and its platform path tests use
// it directly before identity is assigned.
//
// Two POSIX inputs DO change meaning, deliberately. `\` is a legal
// character in a POSIX filename, so host-agnostic string logic
// cannot distinguish "a file named `a\b`" from "a Windows path":
//   `dir/a\b` → `dir/a/b`   (a `\` in a name becomes a separator)
//   `\a`      → `/a`        (relative is promoted to absolute)
// Pure forward-slash input is byte-identical to the pre-SFN-642
// output, and that covers every path reached in practice: workspace
// member paths are gated by `_rcr_is_safe_member_path`, which
// rejects `\` outright. The manifest's artifact relatives
// (`c-sources`, `ll-sources`, `sfn-sources`, `include-dirs`,
// `prelude-entry`) are NOT gated, so a manifest that declares a
// POSIX filename containing a literal `\` resolves differently than
// it used to. Treating that as a separator is the intended reading
// on the platform this function exists to support, and a `\` in a
// build-input filename is pathological on either.
fn _rcr_normalize_path(path: string) -> string {
    if path.length == 0 { return path; }

    // Win32 extended-length (`\\?\C:\x`) and device (`\\.\PIPE\x`)
    // paths bypass Win32 path parsing entirely and are valid ONLY
    // with backslashes, so normalizing one would break it. Nothing
    // in the toolchain produces one today; handing the input back
    // untouched is degraded-but-correct rather than corrupting.
    if path.length >= 4 && substring(path, 0, 2) == "\\\\" && substring(path, 3, 4) == "\\" {
        let device = substring(path, 2, 3);
        if device == "?" || device == "." { return path; }
    }

    let root_len = _rcr_root_prefix_len(path);
    let mut root = substring(path, 0, root_len);
    let drive_relative = root_len == 2 && substring(path, 1, 2) == ":";
    // A drive-relative root (`C:foo`) names the per-drive working
    // directory, so it is NOT absolute: a leading `..` stays
    // meaningful and survives, as it does for a bare relative path.
    let mut absolute: boolean = root_len > 0;
    if drive_relative { absolute = false; }
    if root_len == 1 { root = "/"; }
    if root_len == 3 && substring(path, 1, 2) == ":" {
        root = substring(path, 0, 2) + "/";
    }

    let mut segments: string[] = [];
    let mut start: int = root_len;
    let mut i: int = root_len;
    loop {
        if i > path.length { break; }
        if i == path.length || _rcr_is_sep(substring(path, i, i + 1)) {
            if i > start {
                let segment = substring(path, start, i);
                if segment == "." {
                    // skip
                } else if segment == ".." {
                    if segments.length > 0 {
                        let last = segments[segments.length - 1];
                        if last != ".." {
                            // Pop the last segment.
                            let mut popped: string[] = [];
                            let mut pi: int = 0;
                            loop {
                                if pi >= segments.length - 1 { break; }
                                popped.push(segments[pi]);
                                pi += 1;
                            }
                            segments = popped;
                        } else { segments.push(".."); }
                    } else if !absolute {
                        // No parent to climb out of; preserve `..`.
                        segments.push("..");
                    }
                    // For absolute paths, leading `..` is dropped
                    // (`/..` stays `/`).
                } else { segments.push(segment); }
            }
            start = i + 1;
        }
        i += 1;
    }
    // Separator between the root and the first segment. A root that
    // already ends in one (`/`, `C:/`) needs none. A UNC root does.
    // A drive-relative root must NOT gain one — `C:a` and `C:/a`
    // name different files.
    let mut lead: string = "";
    if root.length > 0 && !drive_relative && !_rcr_is_sep(substring(root, root.length - 1, root.length)) {
        lead = "/";
    }

    if segments.length == 0 {
        if root.length > 0 { return root; }
        return ".";
    }

    let mut out: string = root;
    let mut j: int = 0;
    loop {
        if j >= segments.length { break; }
        if j == 0 { out = out + lead; } else { out = out + "/"; }
        out = out + segments[j];
        j += 1;
    }
    return out;
}

// Resolve `manifest_dir + "/" + relative`. The manifest is
// Cargo-style: paths are relative to the manifest dir, but
// humans sometimes write `./src/foo.c` instead of `src/foo.c`.
// `strip_prefix` (shared from `string_utils.sfn`) collapses
// both forms to the canonical "no leading `./`" shape before
// the join, and `_rcr_normalize_path` collapses any remaining
// `..` segments — see that helper for the rationale.
fn _rcr_resolve_path(manifest_dir: string, relative: string) -> string {
    let cleaned = strip_prefix(relative, "./");
    return _rcr_normalize_path(_rcr_path_join(manifest_dir, cleaned));
}

// Apply `_rcr_resolve_path` to every entry in `relatives`.
fn _rcr_resolve_paths(manifest_dir: string, relatives: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= relatives.length { break; }
        out.push(_rcr_resolve_path(manifest_dir, relatives[i]));
        i += 1;
    }
    return out;
}

// Resolve `from=to` target replacement entries to absolute tab-separated
// records. Malformed entries are omitted; the identity validation below then
// rejects a target whose declared source set cannot be owned by the runtime
// capsule. The manifest regression tests pin every production entry, so an
// omission cannot silently change the shipped target set.
fn _rcr_resolve_replacements(manifest_dir: string, entries: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let entry = entries[i];
        let mut eq: int = -1;
        let mut j: int = 0;
        loop {
            if j >= entry.length { break; }
            if substring(entry, j, j + 1) == "=" {
                eq = j;
                break;
            }
            j += 1;
        }
        if eq > 0 && eq + 1 < entry.length {
            let from = _rcr_resolve_path(manifest_dir, substring(entry, 0, eq));
            let to = _rcr_resolve_path(manifest_dir, substring(entry, eq + 1, entry.length));
            out.push(from + "\t" + to);
        }
        i += 1;
    }
    return out;
}

fn _rcr_target_artifacts(manifest_dir: string, manifest_text: string) -> RuntimeTargetArtifacts[] {
    let mut out: RuntimeTargetArtifacts[] = [];
    let triples = _rcr_split_newlines(toml_get_target_triples(manifest_text));
    let mut i: int = 0;
    loop {
        if i >= triples.length { break; }
        let triple = triples[i];
        let section = "targets." + triple;
        let replacements = _rcr_split_newlines(toml_get_string_array(manifest_text, section, "sfn-sources-replace"));
        let sfn_add = _rcr_split_newlines(toml_get_string_array(manifest_text, section, "sfn-sources-add"));
        let sfn_drop = _rcr_split_newlines(toml_get_string_array(manifest_text, section, "sfn-sources-drop"));
        let ll_add = _rcr_split_newlines(toml_get_string_array(manifest_text, section, "ll-sources-add"));
        let libs_add = _rcr_split_newlines(toml_get_string_array(manifest_text, section, "link-libs-add"));
        let libs_drop = _rcr_split_newlines(toml_get_string_array(manifest_text, section, "link-libs-drop"));
        let resolved_replacements = _rcr_resolve_replacements(manifest_dir, replacements);
        out.push(RuntimeTargetArtifacts {
            triple: triple, valid: resolved_replacements.length == replacements.length, sfn_source_replacements: resolved_replacements, sfn_sources_add: _rcr_resolve_paths(manifest_dir, sfn_add), sfn_sources_drop: _rcr_resolve_paths(manifest_dir, sfn_drop), ll_sources_add: _rcr_resolve_paths(manifest_dir, ll_add), link_libs_add: libs_add, link_libs_drop: libs_drop
        });
        i += 1;
    }
    return out;
}

// Newline-split helper for `toml_get_workspace_members` output.
fn _rcr_split_newlines(text: string) -> string[] {
    let mut out: string[] = [];
    if text.length == 0 { return out; }
    let mut start: int = 0;
    let mut i: int = 0;
    loop {
        if i >= text.length { break; }
        if substring(text, i, i + 1) == "\n" {
            if i > start { out.push(substring(text, start, i)); }
            start = i + 1;
        }
        i += 1;
    }
    if start < text.length {
        out.push(substring(text, start, text.length));
    }
    return out;
}

// Path-traversal guard for workspace member paths. Mirrors
// `_cr_is_safe_member_path` in `capsule_resolver.sfn`: rejects
// absolute paths, backslashes, and any `.` / `..` segment.
// Inline-duplicated rather than imported because the original is
// `_cr_`-prefixed (file-private convention) and pulling it in
// would require restructuring the resolver's exports. Same
// behavioural contract — keep them in sync if either changes.
fn _rcr_is_safe_member_path(path: string) -> boolean {
    if path.length == 0 { return false; }
    if substring(path, 0, 1) == "/" { return false; }
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if substring(path, i, i + 1) == "\\" { return false; }
        i += 1;
    }
    let mut start: int = 0;
    loop {
        if start >= path.length { break; }
        let mut end: int = start;
        loop {
            if end >= path.length { break; }
            if substring(path, end, end + 1) == "/" { break; }
            end += 1;
        }
        let segment = substring(path, start, end);
        if segment == ".." { return false; }
        if segment == "." { return false; }
        start = end + 1;
    }
    return true;
}

// Build a `RuntimeCapsuleArtifacts` from a manifest's text plus
// its on-disk member path (relative to workspace root). Returns
// the empty artifact if the manifest doesn't declare
// `kind = "runtime"` — caller filters those out.
// Split `toml_get_dependencies`' newline-joined `<capsule>=<version>` records
// into bare spec names. `capsule_resolver/discovery.sfn::_cr_parse_deps` does
// the same job for ordinary capsules but is module-private, and this path
// needs only the spec.
fn _rcr_parse_dep_specs(deps_text: string) -> string[] {
    let mut out: string[] = [];
    let records = _rcr_split_newlines(deps_text);
    let mut i: int = 0;
    loop {
        if i >= records.length { break; }
        let record = records[i];
        i += 1;
        let mut scan: int = 0;
        let mut eq: int = -1;
        loop {
            if scan >= record.length { break; }
            if substring(record, scan, scan + 1) == "=" {
                eq = scan;
                break;
            }
            scan += 1;
        }
        let mut spec = record;
        if eq > 0 { spec = substring(record, 0, eq); }
        if spec.length > 0 { out.push(spec); }
    }
    return out;
}

// SFN-882: read `[sfn-source-gates]` into `"<effect>\t<absolute-path>"` records.
//
// Six fixed lookups, one per `canonical_effects()` member — no section
// enumeration is needed, and a new gate key costs a manifest edit alone. Only
// canonical effect names are consulted, which is the fail-open direction: a
// misspelled or non-canonical key is never read, so its sources match no record
// and stay compiled. An entry naming a source that is not in `sfn-sources` is
// inert; the two `_windows` spellings are exactly that until a Windows target
// manifest entry selects them.
fn _rcr_resolve_source_gates(manifest_dir: string, manifest_text: string) -> string[] {
    let mut out: string[] = [];
    let effects = canonical_effects();
    let mut e: int = 0;
    loop {
        if e >= effects.length { break; }
        let effect = effects[e];
        let gated_abs = _rcr_resolve_paths(manifest_dir, toml_get_sfn_source_gate(manifest_text, effect));
        let mut g: int = 0;
        loop {
            if g >= gated_abs.length { break; }
            out.push(effect + "\t" + gated_abs[g]);
            g += 1;
        }
        e += 1;
    }
    return out;
}

fn _rcr_runtime_identity_inputs_valid(sources: string[], gates: string[], owner: SourceIdentityOwner) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= sources.length { break; }
        if !source_identity_for(sources[i], owner, source_role_runtime_provider()).ok {
            return false;
        }
        i += 1;
    }
    i = 0;
    loop {
        if i >= gates.length { break; }
        let record = gates[i];
        let mut tab: int = -1;
        let mut k: int = 0;
        loop {
            if k >= record.length { break; }
            if substring(record, k, k + 1) == "\t" {
                tab = k;
                break;
            }
            k += 1;
        }
        if tab < 0 || tab + 1 >= record.length { return false; }
        let path = substring(record, tab + 1, record.length);
        if !source_identity_for(path, owner, source_role_runtime_provider()).ok {
            return false;
        }
        i += 1;
    }
    return true;
}

// Target-added prewritten IR is not a Sailfin module, so it cannot use the
// source-identity validator above. It is nevertheless executable link input
// owned by the runtime capsule and must stay beneath that capsule's manifest
// root. Both values have already passed through `_rcr_normalize_path`.
fn _rcr_runtime_ir_path_owned(path: string, member_root: string) -> boolean {
    if path == member_root { return true; }
    let prefix = member_root + "/";
    if path.length <= prefix.length { return false; }
    return substring(path, 0, prefix.length) == prefix;
}

fn _rcr_target_identity_inputs_valid(targets: RuntimeTargetArtifacts[], base_sources: string[], owner: SourceIdentityOwner) -> boolean {
    let mut seen_triples: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= targets.length { break; }
        let target = targets[i];
        if !target.valid { return false; }
        if contains_string(seen_triples, target.triple) { return false; }
        seen_triples.push(target.triple);
        let mut paths: string[] = [];
        let mut seen_replacement_sources: string[] = [];
        let mut r: int = 0;
        loop {
            if r >= target.sfn_source_replacements.length { break; }
            let record = target.sfn_source_replacements[r];
            let mut tab: int = -1;
            let mut j: int = 0;
            loop {
                if j >= record.length { break; }
                if substring(record, j, j + 1) == "\t" {
                    tab = j;
                    break;
                }
                j += 1;
            }
            if tab <= 0 || tab + 1 >= record.length { return false; }
            let from = substring(record, 0, tab);
            if !contains_string(base_sources, from) { return false; }
            if contains_string(seen_replacement_sources, from) { return false; }
            seen_replacement_sources.push(from);
            paths.push(from);
            paths.push(substring(record, tab + 1, record.length));
            r += 1;
        }
        let mut a: int = 0;
        loop {
            if a >= target.sfn_sources_add.length { break; }
            paths.push(target.sfn_sources_add[a]);
            a += 1;
        }
        let mut d: int = 0;
        loop {
            if d >= target.sfn_sources_drop.length { break; }
            paths.push(target.sfn_sources_drop[d]);
            d += 1;
        }
        let mut p: int = 0;
        loop {
            if p >= paths.length { break; }
            if !source_identity_for(paths[p], owner, source_role_runtime_provider()).ok {
                return false;
            }
            p += 1;
        }
        let mut ll: int = 0;
        loop {
            if ll >= target.ll_sources_add.length { break; }
            if !_rcr_runtime_ir_path_owned(target.ll_sources_add[ll], owner.member_root) {
                return false;
            }
            ll += 1;
        }
        i += 1;
    }
    return true;
}

fn _rcr_artifacts_from_manifest(workspace_root: string, member_path: string, manifest_text: string) -> RuntimeCapsuleArtifacts {
    let kind = toml_get_build_kind(manifest_text);
    if kind != "runtime" { return empty_runtime_capsule_artifacts(); }
    let name = toml_get_name(manifest_text);
    if name.length == 0 { return empty_runtime_capsule_artifacts(); }
    // SFN-146: lexically normalize `manifest_dir` (strip trailing slashes,
    // collapse `.`/`..`) the same way `_rcr_resolve_path` normalizes the
    // resolved source paths. `runtime_capsule_from_root` passes the value
    // `resolve_runtime_root` returns for `SAILFIN_RUNTIME_ROOT` verbatim
    // (no `realpath`, no trailing-slash strip — runtime/sfn/platform/exec.sfn),
    // so an operator root like `/x/runtime-copy/` or `./runtime-copy` would
    // otherwise leave `manifest_dir` a non-canonical prefix of the
    // (normalized) `sfn_sources`, defeating the runtime-relative slug
    // derivation in `runtime_objs.sfn::_runtime_module_slug` and
    // reintroducing the out-of-tree duplicate-`sfn_type_register` failure.
    // Normalizing here keeps `manifest_dir` a clean prefix of every resolved
    // source; the per-source joins already normalize, so this is idempotent
    // for the in-tree (already-canonical) root.
    let manifest_dir = _rcr_normalize_path(_rcr_path_join(workspace_root, member_path));
    let c_sources_rel = toml_get_c_sources(manifest_text);
    let ll_sources_rel = toml_get_ll_sources(manifest_text);
    let sfn_sources_rel = toml_get_sfn_sources(manifest_text);
    let sfn_source_root_rel = toml_get_sfn_source_root(manifest_text);
    let sfn_module_prefix = toml_get_sfn_module_prefix(manifest_text);
    let include_dirs_rel = toml_get_include_dirs(manifest_text);
    let link_libs = toml_get_link_libs(manifest_text);
    let capsule_deps = _rcr_parse_dep_specs(toml_get_dependencies(manifest_text));
    let prelude_entry_rel = toml_get_prelude_entry(manifest_text);
    let mut prelude_entry: string = "";
    if prelude_entry_rel.length > 0 {
        prelude_entry = _rcr_resolve_path(manifest_dir, prelude_entry_rel);
    }
    let sfn_source_root = _rcr_resolve_path(manifest_dir, sfn_source_root_rel);
    let sfn_sources = _rcr_resolve_paths(manifest_dir, sfn_sources_rel);
    let sfn_source_gates = _rcr_resolve_source_gates(manifest_dir, manifest_text);
    let target_artifacts = _rcr_target_artifacts(manifest_dir, manifest_text);
    let identity_owner = SourceIdentityOwner {
        manifest_name: name,
        member_root: manifest_dir,
        source_root: sfn_source_root,
        module_prefix: sfn_module_prefix
    };
    if !_rcr_runtime_identity_inputs_valid(sfn_sources, sfn_source_gates, identity_owner)
        || !_rcr_target_identity_inputs_valid(target_artifacts, sfn_sources, identity_owner) {
        return empty_runtime_capsule_artifacts();
    }
    return RuntimeCapsuleArtifacts {
        capsule_name: name,
        manifest_dir: manifest_dir,
        c_sources: _rcr_resolve_paths(manifest_dir, c_sources_rel),
        ll_sources: _rcr_resolve_paths(manifest_dir, ll_sources_rel),
        sfn_sources: sfn_sources,
        include_dirs: _rcr_resolve_paths(manifest_dir, include_dirs_rel),
        link_libs: link_libs,
        prelude_entry: prelude_entry,
        sfn_source_root: sfn_source_root,
        sfn_module_prefix: sfn_module_prefix,
        capsule_deps: capsule_deps,
        sfn_source_gates: sfn_source_gates,
        target_artifacts: target_artifacts
    };
}

// Walk the workspace's [workspace].members; for every member
// whose capsule.toml declares `kind = "runtime"`, return a
// `RuntimeCapsuleArtifacts` with workspace-rooted paths.
//
// `dep_specs` filters by canonical capsule name (e.g.
// `["sfn/runtime-native"]`). Empty `dep_specs` returns ALL
// runtime capsules in the workspace — useful for code paths
// that haven't yet migrated to declare their runtime deps
// explicitly (the bootstrap fallback under Stage D PR2/PR3).
//
// Members that fail to read (missing capsule.toml, parse
// errors, missing name) are skipped silently rather than
// erroring — same shape as `load_workspace_members`. Callers
// that need to detect "no runtime capsule found" inspect the
// returned array's length.
fn enumerate_runtime_capsule_artifacts(workspace_root: string, dep_specs: string[]) -> RuntimeCapsuleArtifacts[] ![io] {
    let mut out: RuntimeCapsuleArtifacts[] = [];
    if workspace_root.length == 0 { return out; }
    let workspace_manifest = _rcr_path_join(workspace_root, "workspace.toml");
    if !fs.exists(workspace_manifest) { return out; }
    let workspace_text = fs.readFile(workspace_manifest);
    let members_text = toml_get_workspace_members(workspace_text);
    let members = _rcr_split_newlines(members_text);
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        let member_path = members[i];
        i += 1;
        if member_path.length == 0 { continue; }
        // Path-traversal guard: a hostile workspace.toml could
        // declare members like `"../etc"` or `"/abs/path"`; reject
        // those before any fs.exists() touches them.
        if !_rcr_is_safe_member_path(member_path) {
            print.err("runtime-capsule-resolver: skipping unsafe member path \""
                + member_path
                + "\" (must be relative, no `..`, no backslashes)");
            continue;
        }
        let member_manifest = _rcr_path_join(_rcr_path_join(workspace_root, member_path), "capsule.toml");
        if !fs.exists(member_manifest) { continue; }
        let manifest_text = fs.readFile(member_manifest);
        let artifacts = _rcr_artifacts_from_manifest(workspace_root, member_path, manifest_text);
        if artifacts.capsule_name.length == 0 { continue; }
        if dep_specs.length > 0 {
            if !contains_string(dep_specs, artifacts.capsule_name) { continue; }
        }
        out.push(artifacts);
    }
    return out;
}

// Resolve the well-known runtime capsule (`<runtime_root>/
// capsule.toml`) as an *implicit* dependency, independent of any
// `workspace.toml` membership. This is the implicit runtime-capsule
// link path for an end-user `sfn build` / `sfn run` / `sfn test` of a
// binary that declares no `[dependencies]`: the driver injects the
// result as a pure fallback when the normal resolver surfaced no
// runtime capsules (issue #940, Ra of #939 / Phase R of #513).
//
// The runtime root is well-known (it is computed from the binary's
// own location), so there is no `[build] implicit = true` flag to
// honour here — a flag would be parsed-but-unenforced today. When
// `sfn/prelude` becomes a real workspace library (Stage F), this
// retires in favour of the workspace-implicit resolver path.
//
// Path model mirrors a one-member `enumerate_runtime_capsule_artifacts`
// walk: `workspace_root = runtime_root`, `member_path = ""`, so
// `manifest_dir` resolves to `<runtime_root>` and the manifest's
// relative entries normalize against it (e.g. `sfn/io.sfn` →
// `<runtime_root>/sfn/io.sfn`, `prelude.sfn` →
// `<runtime_root>/prelude.sfn`).
//
// Returns `[]` when the manifest is absent (caller surfaces a loud
// "runtime bundle/manifest missing" error) or doesn't parse as a
// `kind = "runtime"` capsule with a name — same skip-silently shape
// as `enumerate_runtime_capsule_artifacts`.
fn runtime_capsule_from_root(runtime_root: string) -> RuntimeCapsuleArtifacts[] ![io] {
    let mut out: RuntimeCapsuleArtifacts[] = [];
    if runtime_root.length == 0 { return out; }
    let manifest = _rcr_path_join(runtime_root, "capsule.toml");
    if !fs.exists(manifest) { return out; }
    let manifest_text = fs.readFile(manifest);
    let artifacts = _rcr_artifacts_from_manifest(runtime_root, "", manifest_text);
    if artifacts.capsule_name.length == 0 { return out; }
    out.push(artifacts);
    return out;
}

export {
    RuntimeCapsuleArtifacts,
    RuntimeTargetArtifacts,
    // Module-private by convention; exported solely as a test seat so
    // the SFN-642 root/separator rules are assertable as pure string
    // logic on a Linux host, with no Windows and no filesystem. Same
    // arrangement as `_strip_trailing_slashes_cmd` in `build/fs.sfn`.
    _rcr_normalize_path,
    _rcr_path_join,
    _rcr_resolve_path,
    empty_runtime_capsule_artifacts,
    enumerate_runtime_capsule_artifacts,
    runtime_capsule_from_root
};
