// Manifest-aware source identity shared by the compiler driver.
//
// A physical path is not a module identity. The resolved member and build
// role decide whether the source is selected-binary-relative,
// manifest-prefixed, or runtime-provider-prefixed. The standalone fallback is
// deliberately repository-agnostic so future source moves do not grow another
// physical-path compatibility branch here.
import { path_root_prefix_len, substring } from "./string_utils";

struct SourceIdentityOwner {
    manifest_name: string;
    member_root: string;
    source_root: string;
    module_prefix: string;
}

struct SourceIdentityResult {
    ok: boolean;
    module_name: string;
}

fn source_role_selected_binary() -> string { return "selected-binary"; }

fn source_role_library() -> string { return "library"; }

fn source_role_runtime_provider() -> string { return "runtime-provider"; }

fn source_role_standalone() -> string { return "standalone"; }

fn empty_source_identity_owner() -> SourceIdentityOwner {
    return SourceIdentityOwner {
        manifest_name: "",
        member_root: "",
        source_root: "",
        module_prefix: ""
    };
}

fn _source_identity_is_separator(ch: string) -> boolean {
    return ch == "/" || ch == "\\";
}

fn _source_identity_is_drive_letter(ch: string) -> boolean {
    let code = char_code(ch);
    if code >= 65 && code <= 90 { return true; }
    return code >= 97 && code <= 122;
}

fn _source_identity_root_length(path: string) -> int {
    if path.length == 0 { return 0; }
    if path.length >= 2 && substring(path, 0, 2) == "\\\\" {
        let mut index: int = 2;
        loop {
            if index >= path.length { break; }
            if _source_identity_is_separator(substring(path, index, index + 1)) {
                break;
            }
            index += 1;
        }
        if index >= path.length { return path.length; }
        index += 1;
        loop {
            if index >= path.length { break; }
            if _source_identity_is_separator(substring(path, index, index + 1)) {
                break;
            }
            index += 1;
        }
        return index;
    }
    if path.length >= 2 && substring(path, 1, 2) == ":"
        && _source_identity_is_drive_letter(substring(path, 0, 1)) {
        if path.length >= 3 && _source_identity_is_separator(substring(path, 2, 3)) {
            return 3;
        }
        return 2;
    }
    if _source_identity_is_separator(substring(path, 0, 1)) { return 1; }
    return 0;
}

// Lexical canonicalization only: separators and `.`/`..` segments converge,
// while symlinks and filesystem state never participate in module identity.
fn _source_identity_normalize_path(path: string) -> string {
    if path.length == 0 { return path; }
    if path.length >= 4 && substring(path, 0, 2) == "\\\\" && substring(path, 3, 4) == "\\" {
        let device = substring(path, 2, 3);
        if device == "?" || device == "." { return path; }
    }

    let root_length = _source_identity_root_length(path);
    let mut root = substring(path, 0, root_length);
    let drive_relative = root_length == 2 && substring(path, 1, 2) == ":";
    let mut absolute = root_length > 0;
    if drive_relative { absolute = false; }
    if root_length == 1 { root = "/"; }
    if root_length == 3 && substring(path, 1, 2) == ":" {
        root = substring(path, 0, 2) + "/";
    }

    let mut segments: string[] = [];
    let mut start = root_length;
    let mut index = root_length;
    loop {
        if index > path.length { break; }
        if index == path.length || _source_identity_is_separator(substring(path, index, index
            + 1)) {
            if index > start {
                let segment = substring(path, start, index);
                if segment == "." {
                    // Skip lexical current-directory segments.
                } else if segment == ".." {
                    if segments.length > 0 && segments[segments.length - 1] != ".." {
                        let mut shortened: string[] = [];
                        let mut copy_index: int = 0;
                        loop {
                            if copy_index >= segments.length - 1 { break; }
                            shortened.push(segments[copy_index]);
                            copy_index += 1;
                        }
                        segments = shortened;
                    } else if !absolute { segments.push(".."); }
                } else { segments.push(segment); }
            }
            start = index + 1;
        }
        index += 1;
    }

    if segments.length == 0 {
        if root.length > 0 { return root; }
        return ".";
    }
    let mut separator = "";
    if root.length > 0 && !drive_relative && !_source_identity_is_separator(substring(root, root.length - 1, root.length)) {
        separator = "/";
    }
    let mut normalized = root;
    index = 0;
    loop {
        if index >= segments.length { break; }
        if index == 0 { normalized = normalized + separator; } else {
            normalized = normalized + "/";
        }
        normalized = normalized + segments[index];
        index += 1;
    }
    return normalized;
}

fn _source_identity_strip_extension(path: string) -> string {
    let mut last_slash: int = -1;
    let mut index: int = 0;
    loop {
        if index >= path.length { break; }
        if substring(path, index, index + 1) == "/" { last_slash = index; }
        index += 1;
    }
    let mut dot: int = -1;
    index = path.length;
    loop {
        if index <= last_slash + 1 { break; }
        index -= 1;
        if substring(path, index, index + 1) == "." {
            dot = index;
            break;
        }
    }
    if dot >= 0 { return substring(path, 0, dot); }
    return path;
}

fn _source_identity_safe_prefix(prefix: string) -> boolean {
    if prefix.length == 0 { return false; }
    if substring(prefix, 0, 1) == "/" { return false; }
    if prefix.length >= 2 && substring(prefix, 1, 2) == ":"
        && _source_identity_is_drive_letter(substring(prefix, 0, 1)) {
        return false;
    }
    if substring(prefix, prefix.length - 1, prefix.length) == "/" {
        return false;
    }
    let mut start: int = 0;
    loop {
        if start >= prefix.length { break; }
        let mut end = start;
        loop {
            if end >= prefix.length { break; }
            if substring(prefix, end, end + 1) == "/" { break; }
            end += 1;
        }
        let segment = substring(prefix, start, end);
        if segment.length == 0 || segment == "." || segment == ".." {
            return false;
        }
        start = end + 1;
    }
    return true;
}

fn _source_identity_normalize_prefix(prefix: string) -> string {
    let mut normalized = "";
    let mut index: int = 0;
    loop {
        if index >= prefix.length { break; }
        let ch = substring(prefix, index, index + 1);
        if ch == "\\" { normalized = normalized + "/"; } else {
            normalized = normalized + ch;
        }
        index += 1;
    }
    if !_source_identity_safe_prefix(normalized) { return ""; }
    return normalized;
}

fn source_identity_for(source_path: string, owner: SourceIdentityOwner, role: string) -> SourceIdentityResult {
    let source = _source_identity_normalize_path(source_path);
    if role == source_role_standalone() {
        let standalone = module_name_from_path(source);
        return SourceIdentityResult {
            ok: standalone.length > 0,
            module_name: standalone
        };
    }
    let source_root = _source_identity_normalize_path(owner.source_root);
    if source.length == 0 || source_root.length == 0 {
        return SourceIdentityResult { ok: false, module_name: "" };
    }
    let root_prefix = source_root + "/";
    if source.length <= root_prefix.length {
        return SourceIdentityResult { ok: false, module_name: "" };
    }
    if substring(source, 0, root_prefix.length) != root_prefix {
        return SourceIdentityResult { ok: false, module_name: "" };
    }
    let relative = _source_identity_strip_extension(substring(source, root_prefix.length, source.length));
    if relative.length == 0 {
        return SourceIdentityResult { ok: false, module_name: "" };
    }
    if role == source_role_selected_binary() {
        return SourceIdentityResult { ok: true, module_name: relative };
    }
    let mut declared_prefix = owner.manifest_name;
    if role == source_role_runtime_provider() {
        declared_prefix = owner.module_prefix;
    }
    let prefix = _source_identity_normalize_prefix(declared_prefix);
    if prefix.length == 0 {
        return SourceIdentityResult { ok: false, module_name: "" };
    }
    if role != source_role_library() && role != source_role_runtime_provider() {
        return SourceIdentityResult { ok: false, module_name: "" };
    }
    return SourceIdentityResult {
        ok: true,
        module_name: prefix + "/" + relative
    };
}

// Repository-agnostic identity for a source with no resolved member. Managed
// workspace and runtime sources must use `source_identity_for` instead.
fn module_name_from_path(source_path: string) -> string {
    if source_path.length == 0 { return "main"; }
    let normalized = _source_identity_normalize_path(source_path);
    let mut stripped = _source_identity_strip_extension(normalized);
    if stripped.length == 0 { return "main"; }
    // Strip a leading root (`/`, `C:/`, `C:\`, `\\server\share`), not just a
    // POSIX `/`. A POSIX-only strip left a Windows drive-absolute source
    // baking its `C:/` prefix into the emitted slug (SFN-704).
    let root_len = path_root_prefix_len(stripped);
    if root_len > 0 {
        stripped = substring(stripped, root_len, stripped.length);
    }
    if stripped.length == 0 { return "main"; }
    return stripped;
}

export {
    SourceIdentityOwner,
    SourceIdentityResult,
    _source_identity_normalize_path,
    empty_source_identity_owner,
    module_name_from_path,
    source_identity_for,
    source_role_library,
    source_role_runtime_provider,
    source_role_selected_binary,
    source_role_standalone
};
