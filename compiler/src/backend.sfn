// compiler/src/backend.sfn
//
// The external-tool invocation seam (SFEP-0066 §3.2): a `Backend`
// interface that hides the driver's `process.run(["clang", …])` codegen
// and link call sites behind a single seam. Today's textual-LLVM-IR +
// clang path is the sole implementation (`LlvmTextBackend`); it
// reproduces every existing clang invocation byte-for-byte (zero
// behaviour change — `--check-determinism` must still pass with no
// rebaseline), with two deliberate Darwin link exceptions: the driver is
// Apple's `/usr/bin/clang` (or the explicit `SAILFIN_CC` override), and the
// argv self-supplies `-isysroot`/`-L<sdk>/usr/lib` (see the helpers below,
// #1914 and SFN-1077). The Linux invocation is unchanged.
//
// Later codegen/link work plugs in here instead of re-hardcoding LLVM
// assumptions across the driver: the LLVM C-API binding (#347) lands as
// an `LlvmApiBackend`. A native code generator does not plug in here —
// SFEP-0066 §3.2 places that provider seam at the capsule boundary (a
// future `sfn/codegen-native` capsule), not in this interface. The driver
// stays pure orchestration: it keeps computing the runtime objects, the
// linker selection, the dead-strip decision (and its diagnostic), and the
// link-lib dedup, then hands the already-ordered pieces to the backend,
// which owns only the final argv assembly + `process.run`.
//
// Dispatch note: `compiler/src/` has never exercised interface-typed
// *values* in its own source (it can lower trait objects but does not
// self-host any), so the driver constructs `LlvmTextBackend {}` directly
// and calls methods on the concrete type. The `Backend` interface is
// declared for conformance + documentation, not dynamic dispatch.
//
// Self-host note: the argv-assembly bodies (which call the array builtin
// `.push`) live in module-level free functions, not in the struct method
// bodies. Calling `.push` from inside a struct method is a lowering path
// the self-hosting compiler does not resolve ("cannot resolve return type
// for call to `args.push`"), even though `sfn check` accepts it — a
// build-only failure of the #1389 class. The methods are thin delegators
// to the free functions, which is the proven self-hosting shape.
// The clang `assemble` argv builder lives in the struct-free
// `build/clang_argv` leaf so build-driver modules can assemble without
// importing this module (and emitting the `LlvmTextBackend` vtable). See
// that file's header for the seed-lowering reason (#1730).
import { _llvm_text_assemble_argv } from "./build/clang_argv";
// Sailfin owns the Link role on Linux x86-64 (SFEP-0066 §3.1 role table,
// `direct_link.sfn`): a direct `ld.lld` invocation instead of clang.
// Resolves `ok=false` (a controlled fallback to the clang path) on any
// non-Linux target or missing prerequisite.
import {
    direct_ld_lld_argv,
    resolve_direct_ld_lld,
    trace_direct_link_fallback
} from "./build/direct_link";
// `_shell_read_cmd` runs a command and trims its stdout — used by the
// macOS SDK probe (`xcrun --show-sdk-path`, `sw_vers`), both of which sit
// behind the Darwin gate and so are unreachable off Darwin.
import { _shell_read_cmd } from "./build/fs";
// Length-gated response-file collapse for the final link argv (SFN-641):
// Windows `CreateProcess` caps `lpCommandLine` at 32,767 chars, and the
// self-host link measures 45,941 across 412 objects and 70 retain-root
// flags.
import { link_argv_or_response_file } from "./build/link_response";
// Target conditioning (SFN-52, SFEP-0021 §4.2(A)): the final link resolves
// the build target once and threads the `-target` triple + POSIX-lib
// filtering through both link layouts. Host-native Linux/macOS stays empty;
// non-Windows cross targets carry their explicit triple.
import {
    build_host_os,
    build_target_os,
    build_target_triple,
    host_target_triple,
    target_clang_flags,
    target_extra_link_libs,
    target_filter_link_libs,
    target_linker_driver,
    target_linker_driver_flags
} from "./build/target";
// `_env_flag` gives `SAILFIN_TRACE_LINK` the same toggle semantics ("",
// "0", "false" are off) as the other `SAILFIN_TRACE_*` knobs;
// `_get_env_cmd` reads a single env var (the macOS SDK probe below).
import { _env_flag, _get_env_cmd } from "./build_flags";
import { user_config_cc } from "./user_config";

// Reserved opaque object-file handle for later backend stages (#347, or a
// future `sfn/codegen-native` provider per SFEP-0066 §3.2, produce these
// in-process). The current driver still passes paths directly, so this
// pins the shape the semantic seam will grow into.
struct ObjectArtifact {
    path: string;
}

// The semantic inputs to a final link, computed by the driver. The two
// link sites (program/run/build vs. `sfn test`) emit genuinely
// different clang argv layouts — `-o` position, input ordering, and the
// section/strip/linker flag set all differ — so `test_mode` selects the
// layout `LlvmTextBackend` reproduces. A non-clang backend ignores
// `link_flags` (clang-driver-specific) and uses `objects` / `libs` directly.
struct LinkPlan {
    // Pre-compiled `.o` inputs. SFN-453 makes this the complete link-input
    // boundary: textual LLVM IR is assembled before `Backend.link`.
    objects: string[];
    out_path: string;
    opt_flag: string;
    // Clang-driver flags the program link interleaves between
    // `-Wno-override-module` and the inputs: linker selection
    // (`-fuse-ld=…`), `-ffunction-sections`/`-fdata-sections`, the
    // dead-strip flag (when safe), and the runtime retain-root flags.
    // Empty in test mode.
    link_flags: string[];
    // Linker libraries appended after `-o <out>` (e.g. `-lm`,
    // `-lpthread`), already deduped/back-filled by the driver.
    libs: string[];
    // Selects the `sfn test` link layout (see above).
    test_mode: boolean;
}

interface Backend {
    // Compile a single IR/C source to an object file (`clang -c`).
    fn assemble(self, src: string, out: string, opt_flag: string, include_flags: string[]) -> int ![io];
    // Link pre-compiled objects + IR inputs into a binary.
    fn link(self, plan: LinkPlan) -> int ![io];
}

// Resolve the clang DRIVER for the final link, not the clang used for the
// Assemble role (`build/clang_argv.sfn`). Homebrew LLVM belongs early on a
// macOS contributor's PATH so `llvm-link`, `llvm-as`, and a matching clang can
// assemble LLVM IR. Its clang driver is not the platform-default owner of the
// Darwin SDK/linker contract, though, so a native Darwin final link must not
// inherit whichever `clang` happens to be first on PATH (SFN-1077).
//
// `SAILFIN_CC` preserves the existing Makefile shim's explicit escape hatch.
// The fallback to bare `clang` is deliberate for a non-Darwin target, a
// non-Darwin host, or a Darwin host without Command Line Tools installed; only
// the native Darwin case has a canonical `/usr/bin/clang` to prefer.
fn _clang_link_driver_for(target_os: string, host_os: string, override: string, apple_clang_available: boolean) -> string {
    if target_os != "Darwin" { return "clang"; }
    if host_os != "Darwin" { return "clang"; }
    if override.length > 0 { return override; }
    if apple_clang_available { return "/usr/bin/clang"; }
    return "clang";
}

fn _clang_link_driver(target_os: string) -> string ![io] {
    let host_os = build_host_os();
    let mut apple_clang_available: boolean = false;
    if host_os == "Darwin" {
        apple_clang_available = fs.exists("/usr/bin/clang");
    }
    // SFEP-0076 section 3.3: rung 2 (environment) above rung 4 (user config).
    // The pure `_clang_link_driver_for` keeps owning the compiled-in default,
    // so an absent config file changes nothing here.
    let mut cc_override = _get_env_cmd("SAILFIN_CC");
    // `_clang_link_driver_for` returns "clang" for every host/target pair that
    // is not native Darwin, before it ever looks at an override. Gating the
    // rung-4 read on the same condition keeps it from being a per-link file
    // read whose result cannot be used. The rung-2 read is left unconditional
    // so `SAILFIN_CC` behaves exactly as it did before.
    if cc_override.length == 0 && target_os == "Darwin" && host_os == "Darwin" {
        cc_override = user_config_cc(build_target_triple());
    }
    return _clang_link_driver_for(target_os, host_os, cc_override, apple_clang_available);
}

export { _clang_link_driver_for };

// macOS SDK link flags (#1914). The driver invokes `clang` by bare name
// and, on Darwin, has historically leaned on the *ambient* environment
// (`SDKROOT` / `LIBRARY_PATH`) for the linker to locate the platform
// libraries (`libSystem`, `libm`, `libpthread`). That is fragile: a
// non-Apple `clang` first on `PATH` (a common Homebrew-LLVM setup) with
// those vars unset fails the link outright (`ld: library 'System'/'m' not
// found`), and a subprocess build that inherits a stripped env — e.g. the
// parallel test pool's per-child env, which forwards only PATH/HOME/TMPDIR
// — reintroduces the same gap. That gap surfaced as non-deterministic
// macOS-arm64 e2e failures because whether a nested build's link resolved
// depended on load-timed SDK re-detection rather than on the source.
// Passing an explicitly-probed `-isysroot`/`-L<sdk>/usr/lib` makes the
// link self-sufficient without ambient SDK env. SFN-1077 additionally resolves
// the final-link driver above so a Homebrew clang earlier on PATH cannot own
// the Darwin link implicitly. Non-Darwin returns [] (no-op); additive only
// when a real SDK is found, so a working Apple-clang link is byte-unchanged.
//
// Probed once and cached (a link may recur per test binary in one process;
// caching also avoids re-running `xcrun` under load, the very race this
// closes). Only scalars are memoized — matching the `errno_locator_symbol`
// lazy-init contract in `llvm/lowering_debug_state.sfn`.
let mut _macos_sdk_probe_done: boolean = false;
let mut _macos_sdk_root: string = "";
let mut _macos_deployment_probe_done: boolean = false;
let mut _macos_deployment_target: string = "";

fn _macos_sdk_link_flags() -> string[] ![io] {
    if !_macos_sdk_probe_done {
        _macos_sdk_root = _probe_macos_sdk_root();
        _macos_sdk_probe_done = true;
    }
    if !_macos_deployment_probe_done {
        _macos_deployment_target = _probe_macos_deployment_target();
        _macos_deployment_probe_done = true;
    }
    let mut flags: string[] = [];
    if _macos_sdk_root.length > 0 {
        flags.push("-isysroot");
        flags.push(_macos_sdk_root);
        flags.push("-L" + _macos_sdk_root + "/usr/lib");
    }
    if _macos_deployment_target.length > 0 {
        flags.push("-mmacosx-version-min=" + _macos_deployment_target);
    }
    return flags;
}

// Module-private by naming convention; exported so the de-shelling
// regression guard (`compiler/tests/unit/windows_build_deshell_test.sfn`,
// SFN-488) can assert the off-Darwin flag set is empty directly rather than
// inferring it from a link argv. Mirrors the `_llvm_text_link_*_argv`
// export-of-underscore-helper precedent below; no rename, no behavior
// change.
export { _macos_sdk_link_flags };

// Resolve the macOS SDK root, or "" when not on Darwin / none found.
// Order: `build_target_os()` gates on Darwin — same `SAILFIN_TARGET_OS`
// override the rest of the link path resolves through, and shell-free, so
// the gate costs no subprocess on the every-link path (SFN-488); then
// `SDKROOT` (no subprocess, most stable when set), `xcrun --show-sdk-path`,
// and the Command Line Tools default. Each SDK candidate must exist on disk
// before it is trusted, so a stale env var cannot force a bad `-isysroot`.
fn _probe_macos_sdk_root() -> string ![io] {
    if build_target_os() != "Darwin" { return ""; }
    let env_sdk = _get_env_cmd("SDKROOT");
    if env_sdk.length > 0 {
        if fs.exists(env_sdk) { return env_sdk; }
    }
    let xcrun_sdk = _shell_read_cmd("xcrun --show-sdk-path 2>/dev/null");
    if xcrun_sdk.length > 0 {
        if fs.exists(xcrun_sdk) { return xcrun_sdk; }
    }
    let clt = "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk";
    if fs.exists(clt) { return clt; }
    return "";
}

// Homebrew LLVM releases can lag Apple's Darwin-major mapping. On macOS 27,
// clang 17 maps `arm64-apple-darwin27` to `macosx18.0`, making ld warn when
// linking Homebrew dylibs built for the real host platform. Passing the host
// deployment target avoids that stale inference while still honoring an
// explicit caller-provided `MACOSX_DEPLOYMENT_TARGET`.
fn _probe_macos_deployment_target() -> string ![io] {
    if build_target_os() != "Darwin" { return ""; }
    let explicit = _get_env_cmd("MACOSX_DEPLOYMENT_TARGET");
    if explicit.length > 0 { return explicit; }
    return _shell_read_cmd("v=\"$(SYSTEM_VERSION_COMPAT=0 sw_vers -productVersion 2>/dev/null)\"; IFS=.; set -- $v; if [ -n \"$1\" ] && [ -n \"$2\" ]; then printf '%s.%s' \"$1\" \"$2\"; fi");
}

// Build the clang link argv for the `sfn test` layout:
// `clang -O0 -Wno-override-module <sdk_flags…> -o OUT <objects…> <libs…>`.
fn _llvm_text_link_test_argv_with_driver(plan: LinkPlan, sdk_flags: string[], driver: string) -> string[] {
    let mut args: string[] = [driver, plan.opt_flag, "-Wno-override-module"];
    let mut si: int = 0;
    loop {
        if si >= sdk_flags.length { break; }
        args.push(sdk_flags[si]);
        si += 1;
    }
    args.push("-o");
    args.push(plan.out_path);
    let mut oi: int = 0;
    loop {
        if oi >= plan.objects.length { break; }
        args.push(plan.objects[oi]);
        oi += 1;
    }
    let mut li: int = 0;
    loop {
        if li >= plan.libs.length { break; }
        args.push(plan.libs[li]);
        li += 1;
    }
    return args;
}

fn _llvm_text_link_test_argv(plan: LinkPlan, sdk_flags: string[]) -> string[] {
    return _llvm_text_link_test_argv_with_driver(plan, sdk_flags, "clang");
}

// Build the clang link argv for the program/build layout:
// `clang <opt> -Wno-override-module <sdk_flags…> <link_flags…> <objects…> -o OUT <libs…>`.
fn _llvm_text_link_program_argv_with_driver(plan: LinkPlan, sdk_flags: string[], driver: string) -> string[] {
    let mut args: string[] = [driver, plan.opt_flag, "-Wno-override-module"];
    let mut si: int = 0;
    loop {
        if si >= sdk_flags.length { break; }
        args.push(sdk_flags[si]);
        si += 1;
    }
    let mut fi: int = 0;
    loop {
        if fi >= plan.link_flags.length { break; }
        args.push(plan.link_flags[fi]);
        fi += 1;
    }
    let mut roi: int = 0;
    loop {
        if roi >= plan.objects.length { break; }
        args.push(plan.objects[roi]);
        roi += 1;
    }
    args.push("-o");
    args.push(plan.out_path);
    let mut lli: int = 0;
    loop {
        if lli >= plan.libs.length { break; }
        args.push(plan.libs[lli]);
        lli += 1;
    }
    return args;
}

fn _llvm_text_link_program_argv(plan: LinkPlan, sdk_flags: string[]) -> string[] {
    return _llvm_text_link_program_argv_with_driver(plan, sdk_flags, "clang");
}

// Both builders are module-private by naming convention; export them so
// the runtime `link_libs` parity regression guard
// (`compiler/tests/unit/backend_link_libs_parity_test.sfn`, SFEP-0036 /
// #1782) can call them directly. Mirrors the `build/clang_argv.sfn`
// export-of-underscore-helper precedent; no rename, no behavior change.
export {
    _llvm_text_link_program_argv,
    _llvm_text_link_program_argv_with_driver,
    _llvm_text_link_test_argv,
    _llvm_text_link_test_argv_with_driver
};

// Env-gated (`SAILFIN_TRACE_LINK`) stderr echo of the resolved clang link
// argv (#1908): a read-only observability aid that prints exactly the argv
// `_llvm_text_link_{program,test}_argv` already returns, so link-flag tests
// can assert on the argv directly instead of proving honoring behaviorally
// (the #1902 follow-up). The toggle uses the shared `_env_flag` helper so
// its semantics match the other `SAILFIN_TRACE_*` knobs, and all string
// work is skipped when unset, so the unset fast path stays free of per-link
// cost — output is byte-identical to an untraced link (the #1112
// zero-behaviour gate). Lives as a free function (not a struct method) to
// match the module's self-host shape; the caller binds the argv to a local
// so the echoed slice is the same one handed to `process.run`.
fn _llvm_text_trace_link(argv: string[]) ![io] {
    if !_env_flag("SAILFIN_TRACE_LINK") { return; }
    let mut line: string = "[trace-link]";
    let mut i: int = 0;
    loop {
        if i >= argv.length { break; }
        line = line + " " + argv[i];
        i += 1;
    }
    print.err(line);
}

// Concatenate two clang-driver-flag slices (SFN-52). Used to prefix the
// `-target` pair ahead of the macOS SDK flags so both ride the single
// `sdk_flags` slice the argv builders already splice after
// `-Wno-override-module`. A free function (not a struct-method body)
// because it calls the array builtin `.push` — see the file-header
// self-host note. Empty `a` (the non-Windows case) returns `b` verbatim.
fn _concat_driver_flags(a: string[], b: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= a.length { break; }
        out.push(a[i]);
        i += 1;
    }
    let mut j: int = 0;
    loop {
        if j >= b.length { break; }
        out.push(b[j]);
        j += 1;
    }
    return out;
}

// Return a copy of `plan` with `libs` filtered, then extended, for
// `triple` (SFN-52, promoted to the triple axis by SFN-774). On the msvc
// ABI the POSIX/OpenSSL libs are dropped (MSVC/UCRT auto-links its CRT)
// and `-lbcrypt` is added (`platform/rand_windows.sfn`'s
// `BCryptGenRandom`, SFN-549); on every other target both
// `target_filter_link_libs` and `target_extra_link_libs` are the
// identity/empty, so the returned plan is structurally equal and the link
// argv stays byte-identical (#1112). A free function so the LinkPlan
// literal is not constructed inside a struct-method body (file-header
// self-host note).
fn _target_conditioned_plan(plan: LinkPlan, triple: string) -> LinkPlan {
    let mut libs = target_filter_link_libs(plan.libs, triple);
    let extra = target_extra_link_libs(triple);
    let mut i: int = 0;
    loop {
        if i >= extra.length { break; }
        libs.push(extra[i]);
        i += 1;
    }
    return LinkPlan {
        objects: plan.objects,
        out_path: plan.out_path,
        opt_flag: plan.opt_flag,
        link_flags: plan.link_flags,
        libs: libs,
        test_mode: plan.test_mode
    };
}

// The current behaviour: emit textual LLVM IR and drive `clang` for
// assembly and linking. The methods delegate argv construction to the
// free functions above (see the self-host note in the file header).
struct LlvmTextBackend {
    fn assemble(self, src: string, out: string, opt_flag: string, include_flags: string[]) -> int ![io] {
        let target_flags = target_clang_flags(build_target_triple(), host_target_triple());
        return process.run(_llvm_text_assemble_argv(src, out, opt_flag, include_flags, target_flags));
    }

    fn link(self, plan: LinkPlan) -> int ![io] {
        // Resolve the build target once (SFN-52, promoted to the triple
        // axis by SFN-774): prefix the `-target` triple ahead of the
        // macOS SDK flags and filter POSIX libs. Host-native Linux/macOS
        // stays byte-identical; cross targets carry their triple.
        // `resolve_direct_ld_lld`
        // below stays OS-keyed (Linux-only path selection), so both
        // resolutions are threaded independently.
        let target_os = build_target_os();
        let triple = build_target_triple();
        let mut link_driver = target_linker_driver(triple);
        if link_driver == "clang" {
            link_driver = _clang_link_driver(target_os);
        }
        let driver_flags = _concat_driver_flags(target_linker_driver_flags(triple, host_target_triple()), _macos_sdk_link_flags());
        let eff_plan = _target_conditioned_plan(plan, triple);
        // Sailfin owns Link on Linux x86-64 (SFEP-0066 §3.1 role table):
        // take the direct `ld.lld` path when the link contract resolves,
        // for both the program and test layouts (test mode carries empty
        // `link_flags`, so the same builder serves both). Any non-Linux
        // target or missing prerequisite falls back to the clang driver
        // below with a trace-visible reason — never a silent ABI change.
        let direct = resolve_direct_ld_lld(target_os);
        if direct.ok {
            let direct_argv = direct_ld_lld_argv(direct, eff_plan.objects, eff_plan.out_path, eff_plan.libs, eff_plan.link_flags);
            // The trace keeps receiving the ORIGINAL argv so
            // `SAILFIN_TRACE_LINK` still prints the full command
            // (#1908); only the spawned argv collapses onto a response
            // file when it is over the Windows `CreateProcess` cap.
            let direct_spawn = link_argv_or_response_file(direct_argv, eff_plan.out_path);
            _llvm_text_trace_link(direct_argv);
            return process.run(direct_spawn);
        }
        trace_direct_link_fallback(direct.reason);
        if eff_plan.test_mode {
            let test_argv = _llvm_text_link_test_argv_with_driver(eff_plan, driver_flags, link_driver);
            let test_spawn = link_argv_or_response_file(test_argv, eff_plan.out_path);
            _llvm_text_trace_link(test_argv);
            return process.run(test_spawn);
        }
        let program_argv = _llvm_text_link_program_argv_with_driver(eff_plan, driver_flags, link_driver);
        let program_spawn = link_argv_or_response_file(program_argv, eff_plan.out_path);
        _llvm_text_trace_link(program_argv);
        return process.run(program_spawn);
    }
}
