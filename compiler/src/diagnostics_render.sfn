// compiler/src/diagnostics_render.sfn
//
// Single source of truth for diagnostic rendering shared between
// `sfn check` (`tools/check.sfn`) and the build path
// (`main.sfn` via `effect_gate.sfn`). Phase B
// (`docs/proposals/0008-effect-validation.md` §5, locked 2026-04-26)
// extracts this code from `tools/check.sfn` so the build pipeline
// can render effect diagnostics in the same shape — same headers,
// same caret pointers, same `[kind: effect]` suffix — without
// pulling in a dependency cycle through `main.sfn`.
//
// The rendering API is intentionally narrow:
//
//   - `effect_violation_to_diagnostic(violation) -> Diagnostic` —
//     converts an `EffectViolation` (carrying signature/trigger
//     tokens since Phase A) into the typed `Diagnostic` value the
//     renderer consumes.
//   - `render_diagnostic(diag, source_lines, kind) -> string` —
//     returns the multi-line rendered text (caret diagram included
//     when `diag.span` is non-null and the line index is in
//     range; location-only `--> file_path` line otherwise).
//   - `split_source_lines(source) -> string[]` — splits source on
//     CR/LF/CRLF the same way `main.sfn`'s
//     `format_typecheck_diagnostic` does, kept here so the renderer
//     is self-contained and can be unit-tested without bootstrapping
//     a full compile pipeline.
//
// Every other helper in this module is private (`_dr_*` prefix) and
// is duplicated rather than imported from `main.sfn` on purpose:
// `main.sfn` imports diagnostic-rendering helpers from this module,
// and the seed compiler does not handle import cycles cleanly. The
// duplication is small (~50 lines, four pure string helpers) and
// changes here are decoupled from changes to `main.sfn`'s own copies.
import { Diag, Span } from "sfn/analyzer/diagnostic";
import {
    CapabilityViolation,
    EffectRequirement,
    EffectViolation,
    UnrecognizedEffectViolation
} from "sfn/analyzer/effect_checker/types";
import {
    capability_violation_to_diagnostic_data,
    code_for_missing_effect_data,
    effect_violation_to_diagnostic_data,
    join_effects_data,
    unrecognized_effect_violation_to_diagnostic_data
} from "sfn/analyzer/effect_diagnostics";
import { Diagnostic } from "sfn/analyzer/typecheck_types";

import { substring } from "./string_utils";

// -------------------------------------------------------------------
// Effect-violation → Diagnostic
// -------------------------------------------------------------------
fn join_effects(effects: string[]) -> string {
    return join_effects_data(effects);
}

fn code_for_missing_effect(missing_effects: string[], requirements: EffectRequirement[]) -> string {
    return code_for_missing_effect_data(missing_effects, requirements);
}

fn effect_violation_to_diagnostic(violation: EffectViolation) -> Diagnostic {
    return effect_violation_to_diagnostic_data(violation);
}

// Phase F: render a `CapabilityViolation` as an `E0403` diagnostic.
// Distinct from the `EffectViolation` shape — the failure here is
// "function declares an effect that the capsule manifest doesn't
// grant", not "function is missing an effect its body uses". The
// diagnostic includes:
//
//   - The header `function X declares effect ![Y] outside capsule
//     capability surface ![A, B, ...]`.
//   - A note line listing the capsule's full capability surface so
//     the user can see at a glance what's allowed.
//   - A two-pronged fix-it suggestion: either widen the manifest
//     (add Y to `[capabilities] required`) or narrow the function
//     (drop ![Y] from the signature).
//
// Severity threading mirrors `effect_violation_to_diagnostic`:
// `SAILFIN_EFFECT_ENFORCE=warning` flips this to a warning, `=off`
// silences it on the build path. `=error` (the post-Phase-D default)
// fails the build.
fn capability_violation_to_diagnostic(violation: CapabilityViolation) -> Diagnostic {
    return capability_violation_to_diagnostic_data(violation);
}

// Gate G6 (SFEP-0017 D1): render an `UnrecognizedEffectViolation` as an
// `E0404` diagnostic. The failure is "the declared effect string names no
// known capability" — its refinement root is outside the canonical six
// and it is not the `pure` sentinel (e.g. `![disk]`, or a stray `fs` from
// an `io.fs` mis-parse). The note names the recognized roots and the
// dotted sub-effect form so the fix (correct the name, or drop the effect)
// is obvious. Severity threads through the same `SAILFIN_EFFECT_ENFORCE`
// contract as the sibling renderers.
fn unrecognized_effect_violation_to_diagnostic(violation: UnrecognizedEffectViolation) -> Diagnostic {
    return unrecognized_effect_violation_to_diagnostic_data(violation);
}

// -------------------------------------------------------------------
// Diagnostic rendering
// -------------------------------------------------------------------
fn _dr_split_lines(source: string) -> string[] {
    let mut lines: string[] = [];
    let mut current: string = "";
    let mut index: int = 0;
    loop {
        if index >= source.length { break; }
        let _ch_next = index + 1;
        let ch = substring(source, index, _ch_next);
        if ch == "\r" {
            lines.push(current);
            current = "";
            if _ch_next < source.length {
                let _ch_next2 = index + 2;
                let next = substring(source, _ch_next, _ch_next2);
                if next == "\n" {
                    index += 2;
                    continue;
                }
            }
            index += 1;
            continue;
        }
        if ch == "\n" {
            lines.push(current);
            current = "";
            index += 1;
            continue;
        }
        current = current + ch;
        index += 1;
    }
    lines.push(current);
    return lines;
}

fn split_source_lines(source: string) -> string[] {
    return _dr_split_lines(source);
}

// Driver-owned presentation for analyzer re-export findings. Codegen returns
// diagnostic data and never writes to stderr or persistent storage.
fn report_reexport_violations(violations: string[]) -> void ![io] {
    let mut index: int = 0;
    loop {
        if index >= violations.length { break; }
        print.err("[emit-native] " + violations[index]);
        index += 1;
    }
}

fn _dr_join_lines(lines: string[]) -> string {
    if lines.length == 0 { return ""; }
    let mut result: string = lines[0];
    let mut index: int = 1;
    loop {
        if index >= lines.length { break; }
        result = result + "\n" + lines[index];
        index += 1;
    }
    return result;
}

fn _dr_number_to_string(value: int) -> string {
    if value == 0 { return "0"; }
    let mut working: int = value;
    let mut negative: boolean = false;
    if working < 0 {
        negative = true;
        working = 0 - working;
    }
    let digits = "0123456789";
    let mut remaining: int = working;
    let mut output: string = "";
    loop {
        if remaining <= 0 { break; }
        let mut temp: int = remaining;
        let mut quotient: int = 0;
        loop {
            if temp < 10 { break; }
            temp -= 10;
            quotient += 1;
        }
        let ch = substring(digits, temp, temp + 1);
        output = ch + output;
        remaining = quotient;
    }
    if negative { output = "-" + output; }
    return output;
}

fn _dr_repeat(ch: string, count: int) -> string {
    if count <= 0 { return ""; }
    let mut index: int = 0;
    let mut result: string = "";
    loop {
        if index >= count { break; }
        result = result + ch;
        index += 1;
    }
    return result;
}

fn _dr_render_message_lines(message: string) -> string[] {
    return _dr_split_lines(message);
}

fn _dr_pad_number_string(value: string, width: int) -> string {
    if value.length >= width { return value; }
    let pad_count = width - value.length;
    return _dr_repeat(" ", pad_count) + value;
}

fn _dr_build_pointer_prefix(column: int, line_text: string) -> string {
    if column <= 1 { return ""; }
    let mut prefix: string = "";
    let mut index: int = 1;
    loop {
        if index >= column { break; }
        if index <= line_text.length {
            let ch = substring(line_text, index - 1, index);
            if ch == "\t" { prefix = prefix + "\t"; } else {
                prefix = prefix + " ";
            }
        } else { prefix = prefix + " "; }
        index += 1;
    }
    return prefix;
}

fn _dr_build_caret(span_width: int, line_text: string, column: int) -> string {
    let mut highlight: int = span_width;
    if highlight <= 0 { highlight = 1; }
    let mut remaining: int = line_text.length - (column - 1);
    if remaining <= 0 { remaining = 1; }
    if highlight > remaining { highlight = remaining; }
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= highlight { break; }
        out = out + "^";
        i += 1;
    }
    return out;
}

fn render_diagnostic(d: Diag, source_lines: string[], kind: string) -> string {
    let mut parts: string[] = [];
    let msg_lines = _dr_render_message_lines(d.message);
    let mut header: string = d.severity + "[" + d.code + "]: ";
    if msg_lines.length > 0 { header = header + msg_lines[0]; }
    parts.push(header);

    let mut padding_width: int = 1;
    if source_lines.length > 0 {
        padding_width = _dr_number_to_string(source_lines.length).length;
    }

    let mut has_location: boolean = false;
    let mut line_number: int = 0;
    let mut column_number: int = 1;
    let mut span_width: int = 0;
    if d.span != null {
        let span: Span? = d.span;
        line_number = span.start_line;
        column_number = span.start_column;
        if span.end_line == span.start_line {
            span_width = span.end_column - span.start_column;
        }
        if line_number >= 1 {
            if line_number <= source_lines.length { has_location = true; }
        }
    }

    if has_location {
        let loc = "  --> " + d.file_path + ":" + _dr_number_to_string(line_number)
            + ":"
            + _dr_number_to_string(column_number);
        parts.push(loc);
        let gutter = _dr_repeat(" ", padding_width);
        parts.push(" " + gutter + " |");
        let line_text = source_lines[line_number - 1];
        let line_label = _dr_pad_number_string(_dr_number_to_string(line_number), padding_width);
        parts.push(" " + line_label + " | " + line_text);
        let pointer_prefix = _dr_build_pointer_prefix(column_number, line_text);
        let caret = _dr_build_caret(span_width, line_text, column_number);
        parts.push(" " + gutter + " | " + pointer_prefix + caret);
    } else if d.file_path.length > 0 {
        parts.push("  --> " + d.file_path);
    }

    let mut i: int = 1;
    loop {
        if i >= msg_lines.length { break; }
        parts.push("  = " + msg_lines[i]);
        i += 1;
    }

    // Prefix tag (typecheck vs effect) helps grep/filtering.
    if kind.length > 0 { parts.push("  [kind: " + kind + "]"); }

    return _dr_join_lines(parts);
}

export {
    capability_violation_to_diagnostic,
    code_for_missing_effect,
    effect_violation_to_diagnostic,
    join_effects,
    render_diagnostic,
    split_source_lines,
    unrecognized_effect_violation_to_diagnostic
};
