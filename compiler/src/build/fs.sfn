// compiler/src/build/fs.sfn
//
// Backend-shared filesystem, path, shell, and file-hash helpers
// relocated from `cli_commands_utils` (SFEP-0027 §3.5); leave the
// `compiler-common` boundary to #345.
import { substring } from "../string_utils";
import { sha256_hex_of_bytes } from "./hash";
import { _is_path_sep } from "./paths";
import { host_is_windows } from "./target";

// libc primitives backing the staging path's temp-mint, atomic
// publish, and file copy. Declared module-locally rather than added
// as `fs.*` builtins: a plain `extern fn` over a libc symbol resolves
// against the pinned seed and needs no seed cut, whereas a new
// builtin is a compiler-emitted intrinsic sentinel + registry row the
// seed cannot resolve (`E0420`) and would force one (SFEP-0021 §5).
// The same reason `arena_relocate.sfn` declares `calloc`/`memcpy` and
// `cli/entry.sfn` declares `realpath` inline.
//
// Pass `string` arguments through an `as *u8` cast, never a `.ptr`
// field access — the latter typechecks green and then lowers to
// nothing, silently dropping the call. Drop this note when SFN-492
// makes that spelling either compile or fail loudly.
//
// `mkstemp` and `close` are POSIX spellings absent from the MSVC UCRT
// (which exports `_close`).
// `mkstemp` resolves against `runtime/sfn/platform/mkstemp_windows.sfn`
// (SFN-549, appended by `target_condition_runtime_sfn_sources`) — the
// same sibling-module treatment `@realpath` gets from
// `platform/realpath_windows.sfn`. `close` has no such sibling and
// needs none: it resolves on the native MSVC leg via `oldnames.lib`
// aliasing to `_close` (verified, SFN-671 —
// `runtime/sfn/platform/socket_ops.sfn:34-43`). That note also
// documents `close`/`_close` as FATAL on a Windows `SOCKET` handle,
// which is not an index into the CRT's low-fd table — the fd closed
// here comes from `mkstemp_windows.sfn:49`'s `_open`, a genuine CRT
// descriptor, so this call site is not that hazard.
extern fn mkstemp(template: *u8) -> i32;

extern fn close(fd: i32) -> i32;

// `opendir`/`closedir` back `_dir_is_enumerable` below. Only the open and
// the close are declared because whether `opendir` succeeds is the entire
// question; reading the entries out is `fs.listDirectory`'s job.
//
// On the native MSVC leg these resolve against
// `runtime/sfn/platform/opendir_windows.sfn` (SFN-903, appended by
// `target_condition_runtime_sfn_sources`), the same sibling-module
// treatment `mkstemp` gets above from `platform/mkstemp_windows.sfn`. On
// mingw the symbols are unchanged: libmingwex implements `opendir` there.
extern fn opendir(path: *u8) -> *u8;

extern fn closedir(dirp: *u8) -> i32;

// `realpath(path, null)` — libc allocates the resolved buffer. Backs
// `_cwd_cmd` below. Declared module-locally rather than imported from
// `cli/entry.sfn`, which declares the same extern, per the SFN-635
// no-cross-module-extern convention.
extern fn realpath(path: *u8, resolved: *u8) -> *u8;

// Publish-into-place, replacing an existing destination. Defined by
// `runtime/sfn/platform/rename_ops.sfn` and swapped for its Windows
// sibling per target — declared as an extern here rather than imported,
// matching the SFN-635 cross-module workaround the runtime modules use
// (SFN-720). Returns 0 on success, like `rename(2)`.
extern fn sfn_rename_replace(src: *u8, dst: *u8) -> i32;

// Atomically claim `path`, creating it as an empty regular file iff it
// does not already exist. Defined by
// `runtime/sfn/platform/exclusive_create.sfn` and swapped for its
// Windows sibling per target — declared as an extern here rather than
// imported, matching the SFN-635 cross-module workaround the runtime
// modules use (SFN-720). Returns `CREATE_EXCLUSIVE_CREATED`,
// `CREATE_EXCLUSIVE_EXISTS`, or `CREATE_EXCLUSIVE_ERROR` below — never
// retry a new name on the error outcome, since the fault is not about
// the name (SFN-974).
extern fn sfn_create_exclusive(path: *u8, mode: i32) -> i32;

// SFN-1005: these initializers must stay LITERALS. A computed
// module-global initializer is silently dropped in a non-entry module and
// keeps the zero value, so respelling `-1` as `0 - 1` — matching the
// stylistic `0 - 1` used in some `_windows` modules — would collapse
// `CREATE_EXCLUSIVE_ERROR` into `CREATE_EXCLUSIVE_CREATED`'s 0 and erase
// the created-vs-error distinction this primitive exists to provide.
// Delete this note when SFN-1005 lands.
let CREATE_EXCLUSIVE_CREATED: i32 = 0;

let CREATE_EXCLUSIVE_EXISTS: i32 = 1;

let CREATE_EXCLUSIVE_ERROR: i32 = -1;

// POSIX creation modes. Decimal because Sailfin has no octal literal
// (`runtime/sfn/adapters/filesystem.sfn:632` spells 0o777 as 511):
// 384 = 0o600, 448 = 0o700. Ignored on a Windows target.
let CREATE_EXCLUSIVE_MODE_FILE: i32 = 384;

// GNU `ld` preserves an existing output file's mode across `-o` (LLD
// and mold both discard/recreate it), so an exclusive-create placeholder
// claimed with `CREATE_EXCLUSIVE_MODE_FILE` would leave the linked
// binary non-executable under GNU `ld`. The executable claim uses 448
// (0o700) so every linker path produces a runnable file.
let CREATE_EXCLUSIVE_MODE_EXE: i32 = 448;

fn _create_exclusive_cmd(path: string, mode: i32) -> i32 ![io] {
    return sfn_create_exclusive(path as *u8, mode);
}

extern fn ferror(f: *File) -> i32;

extern fn fopen(path: *u8, mode: *u8) -> *File;

extern fn fclose(f: *File) -> i32;

extern fn fread(buf: *u8, size: usize, nmemb: usize, f: *File) -> usize;

extern fn fwrite(buf: *u8, size: usize, nmemb: usize, f: *File) -> usize;

extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn realloc(ptr: *u8, size: usize) -> *u8;

extern fn memset(ptr: *u8, value: i32, n: usize) -> *u8;

extern fn calloc(n: usize, sz: usize) -> *u8;

extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

fn _ends_with_cmd(value: string, suffix: string) -> boolean {
    if suffix.length == 0 { return true; }
    if value.length < suffix.length { return false; }
    let start = value.length - suffix.length;
    return substring(value, start, value.length) == suffix;
}

fn _dirname_cmd(path: string) -> string {
    let mut last_slash: int = -1;
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if _is_path_sep(path[i]) { last_slash = i; }
        i += 1;
    }
    if last_slash < 0 { return "."; }
    // Preserve the separator the caller actually used, so a Windows
    // root keeps its `\` spelling rather than being rewritten to `/`.
    if last_slash == 0 { return substring(path, 0, 1); }
    return substring(path, 0, last_slash);
}

// Mint a unique temp file from an explicit `XXXXXX`-suffixed
// `template` via libc `mkstemp`. Returns the minted path, or "" when
// one cannot be minted (every caller degrades rather than failing the
// build).
//
// `mkstemp` creates the file `O_EXCL` and rewrites the trailing
// `XXXXXX` of its argument in place, so the buffer must be writable
// heap, not a string literal: `calloc` zeroes it (supplying the
// trailing NUL) and `memcpy` fills the template. The resulting
// NUL-terminated buffer is returned directly as a `string`, the same
// `*u8`→`string` shape `arena_relocate.sfn::relocate_string_to_heap`
// relies on. The descriptor is closed immediately — the name is
// already exclusively ours, so the caller reopening it by path is not
// a TOCTOU window.
//
// No shell is involved, so a `template` deriving from
// `$SAILFIN_BUILD_CACHE_DIR` or a capsule path with shell
// metacharacters is no longer a quoting or injection concern.
fn _mktemp_from_template_cmd(template: string) -> string ![io] {
    // `mkstemp` resolves on a native Windows host via
    // `runtime/sfn/platform/mkstemp_windows.sfn` (SFN-549), so no
    // `host_is_windows()` degrade is needed here.
    let n: i64 = template.length as i64;
    let buf: *u8 = calloc((n + 1) as usize, 1 as usize);
    if buf as i64 == 0 { return ""; }
    memcpy(buf, template as *u8, n as usize);
    let fd: i32 = mkstemp(buf);
    if fd < 0 {
        free(buf);
        return "";
    }
    close(fd);
    return buf;
}

// Mint a unique temp path in the SAME directory as `dst_path`, so a
// subsequent `rename` onto `dst_path` is an atomic same-filesystem
// operation (a `/tmp` temp would force a non-atomic cross-device
// copy). The destination's directory must already exist. Returns the
// temp path, or "" when a temp cannot be minted (callers fall back to
// a direct, non-atomic write).
fn _mktemp_sibling_cmd(dst_path: string) -> string ![io] {
    return _mktemp_from_template_cmd(_dirname_cmd(dst_path)
        + "/.sfn_stage.XXXXXX");
}

// The current working directory, replacing the `pwd` shellout (SFN-888).
// `realpath(".", null)` has libc allocate the resolved buffer, the same
// `*u8`->`string` shape `_mktemp_from_template_cmd` returns above.
//
// Unlike `_shell_read_cmd("pwd")` this needs no `host_is_windows()` gate:
// `@realpath` is provided on a native Windows host by
// `runtime/sfn/platform/realpath_windows.sfn` over `_fullpath`, appended
// for Windows targets by `target_condition_runtime_sfn_sources` — the same
// sibling-module treatment `mkstemp` gets. That sibling returns
// BACKSLASH-separated paths; consumers concatenate forward-slash suffixes
// onto the result and Win32 accepts both separators, so the mixed spelling
// is benign (`realpath_windows.sfn:43-49` argues this at length).
//
// `PWD` is the fallback, not the primary, because it is maintained by a
// *shell*: it is absent when `sfn` is spawned by a non-shell parent and
// absent on native Windows. That ordering is the one difference from the
// existing `env.get("PWD")` reads at `init.sfn:51` and `lock.sfn:61`.
// Returns "." when neither answers, leaving a relative path relative
// rather than fabricating a root.
fn _cwd_cmd() -> string ![io] {
    let resolved: *u8 = realpath("." as *u8, null);
    if resolved as i64 != 0 { return resolved as string; }
    let pwd = env.get("PWD");
    if pwd.length > 0 { return pwd; }
    return ".";
}

// Apply a POSIX mode to `path`, short-circuiting to success on a Windows
// host (SFN-888). Backs the `chmod 700`/`chmod 600` sites in
// `cli/commands/config.sfn` and `cli/commands/login.sfn`; each caller keeps
// its own failure policy for the POSIX result.
//
// The short-circuit sits BEFORE the call deliberately. `_chmod` honours
// only the read-only attribute, so `0o600` and `0o700` are inexpressible
// on Windows and `fs.set_perms` is a semantic no-op there even when it
// succeeds — reporting its failure would let a permission Windows never
// had block `sfn config set` outright.
//
// The consequence is that `~/.sfn/credentials` and `~/.sfn/config.toml`
// are NOT access-restricted on Windows. That is already true today, since
// `chmod` is unspawnable there, and this does not make it worse — but it
// is disclosed in `sfn login`'s output rather than left silent, because a
// source comment is not disclosure. Removal condition: SFN-884 restricts
// the credential file via an NTFS ACL, and its PR deletes this gate, the
// `login` notice, and the `login.sfn` header qualifier together.
fn _set_perms_or_skip(path: string, mode: int) -> boolean ![io] {
    if host_is_windows() { return true; }
    return fs.set_perms(path, mode);
}

// Atomically publish an already-written temp file as `dst_path`. The
// move is atomic only when `tmp_path` and `dst_path` share a filesystem
// — pair this with `_mktemp_sibling_cmd(dst_path)` so the temp lives
// beside the destination. A concurrent reader then observes `dst_path`
// as either the prior complete file or the new complete file, never a
// partial write — the invariant that fixes the parallel-emit staging
// race (#1011) and the cache race (#1034). On failure the temp is
// removed and false returned.
//
// Routed through `sfn_rename_replace` (`platform/rename_ops.sfn`,
// swapped for its Windows sibling by
// `target_condition_runtime_sfn_sources`) rather than calling libc
// `rename` directly, because REPLACING an existing destination is the
// load-bearing half of this contract and Windows does not do it: the
// CRT's `rename()` returns `EEXIST` where POSIX `rename(2)` replaces
// atomically. Every publish here therefore worked exactly once per
// destination on Windows and failed forever after — `sfn selfhost`
// failing on its second run is how it surfaced (SFN-720). The Windows
// sibling uses `MoveFileExA` + `MOVEFILE_REPLACE_EXISTING`; the POSIX
// one is a pass-through to the same `rename(2)` this used before, so
// non-Windows behaviour is unchanged.
//
// The atomicity stated above has one exception, and it is reachable
// only where this function already returned false. Windows cannot
// atomically replace a RUNNING image — Win32 has no such operation — so
// the Windows sibling displaces the live image and then publishes,
// leaving a window in which `dst_path` is briefly absent. That window
// is entered only after the atomic form has already failed, so no
// publish that succeeds today loses the concurrent-reader invariant.
// Only two callers can reach it, both publishing a compiler binary:
// `cli_selfhost.sfn`'s `--promote-to` and
// `source_fingerprint.sfn::install_built_compiler`. Every other
// destination here is an object file, IR, cache entry or manifest,
// which is never a running image and so always takes the atomic path.
fn _atomic_rename_into_place(tmp_path: string, dst_path: string) -> boolean ![io] {
    if sfn_rename_replace(tmp_path as *u8, dst_path as *u8) != 0 {
        fs.deleteFile(tmp_path);
        return false;
    }
    return true;
}

// A null or empty line array publishes a zero-length artifact, matching
// the pre-SFN-712 LLVM publication contract. `fs.writeLines`
// returns early on a null handle without touching the file, so the empty
// case routes through `fs.writeFile` instead.
fn _write_lines_or_empty(target: string, lines: string[]) -> void ![io] {
    if lines == null {
        fs.writeFile(target, "");
        return;
    }
    if lines.length == 0 {
        fs.writeFile(target, "");
        return;
    }
    fs.writeLines(target, lines);
}

// Publish `lines` as `path` through a sibling temp + atomic rename, so no
// reader observes the destination mid-write. `fs.writeLines` opens its
// target `"wb"` and that truncation IS the tear, so writing the
// destination directly makes a partially-emitted `.ll`/`.sfn-asm`
// observable even when the write later fails (SFN-542, SFN-578).
//
// Returns the real publish status, which both IR emit callers thread to
// their own `boolean` return in place of the `fs.exists` check they used
// to consume. `fs.writeLines` is `-> void` (a frozen runtime-helper
// descriptor signature under `compiler/capsules/codegen-llvm/src/runtime_helpers/`), so the
// staged write's outcome is read as `fs.exists(tmp)` — which is only a
// sound signal because the mint's pre-created temp is dropped first. See
// the `fs.deleteFile(tmp)` below.
//
// On failure the destination is removed rather than left holding a prior
// build's output — `fs.exists(path)` is the completeness check downstream
// tooling that only stats the path applies, and a stale-but-complete
// artifact would pass it. That is build-artifact policy: do not reuse this
// helper for a destination whose prior content must survive a failed
// write, which is why the cache publishes via `_atomic_rename_into_place`
// directly.
//
// With no temp mintable (`host_is_windows()`) the write degrades to the
// direct in-place form — crash atomicity is lost, the artifact is still
// produced, and the failure is still reported.
fn _publish_lines_atomic(path: string, lines: string[]) -> boolean ![io] {
    let tmp = _mktemp_sibling_cmd(path);
    if tmp.length == 0 {
        // The degrade leg writes the destination in place, so `fs.exists`
        // only means "this write produced a file" once any prior artifact
        // is gone — otherwise a failed write reports the previous build's
        // output as success. This is the whole native-Windows leg, where
        // the mint always returns "" (SFN-578).
        if fs.exists(path) { fs.deleteFile(path); }
        _write_lines_or_empty(path, lines);
        return fs.exists(path);
    }
    // `_mktemp_sibling_cmd` pre-creates the temp `O_EXCL`, so its mere
    // presence proves nothing about the staged write — `sfn_fs_write_lines`
    // has one failure return (`fopen` itself failing) that does not unlink,
    // and a surviving zero-byte temp would then be renamed into place and
    // reported as a successful publish. Dropping the temp first restores
    // the intended equivalence: `fs.exists(tmp)` afterwards means the write
    // opened the file AND did not remove it for a short write or failing
    // `fclose` (SFN-542). The mint's randomised name stays effectively
    // reserved; the codebase already treats `fs.exists` on a minted temp as
    // no evidence of content (`emit_helpers.sfn` pairs it with a non-empty
    // probe for the same reason).
    fs.deleteFile(tmp);
    _write_lines_or_empty(tmp, lines);
    if !fs.exists(tmp) {
        if fs.exists(path) { fs.deleteFile(path); }
        return false;
    }
    if !_atomic_rename_into_place(tmp, path) {
        if fs.exists(path) { fs.deleteFile(path); }
        return false;
    }
    return true;
}

// Outcome of `_copy_file_counted`: whether the copy succeeded, and how
// many bytes were written. On failure `bytes` is whatever was written
// before the failure, matching `FileBytes`'s "report what happened, don't
// hide the partial state" shape above.
struct CopyOutcome {
    ok: boolean;
    bytes: int;
}

// Copy `src` to `dst` byte-for-byte through libc stdio, replacing any
// existing `dst`. Returns `ok: false` on any open, short-write, or close
// failure, leaving `dst` in whatever state the partial write reached
// — callers publish through `_atomic_rename_into_place` so a failed
// copy never becomes the visible artifact. `bytes` is the count
// successfully written, letting a caller learn a copied file's size
// without a second read or a `stat`.
//
// Chunked rather than a single sized read: the cache stores multi-
// megabyte `.o` and `.ll` artifacts, and a whole-file buffer would
// scale the compiler's peak RSS with the largest object under the
// 8 GiB self-cap. `guard` bounds the loop so a pathological stream
// that never reports EOF terminates instead of spinning forever.
fn _copy_file_counted(src: string, dst: string) -> CopyOutcome ![io] {
    let read_mode: string = "rb";
    let fin: *File = fopen(src as *u8, read_mode as *u8);
    if fin as i64 == 0 {
        return CopyOutcome { ok: false, bytes: 0 };
    }
    let write_mode: string = "wb";
    let fout: *File = fopen(dst as *u8, write_mode as *u8);
    if fout as i64 == 0 {
        fclose(fin);
        return CopyOutcome { ok: false, bytes: 0 };
    }

    let chunk: i64 = 65536;
    let buf: *u8 = malloc(chunk as usize);
    if buf as i64 == 0 {
        fclose(fin);
        fclose(fout);
        return CopyOutcome { ok: false, bytes: 0 };
    }

    let mut ok: boolean = true;
    let mut total: i64 = 0;
    let mut guard: i64 = 0;
    // At 64 KiB a chunk this bounds the copy at ~61 GiB, far above any
    // plausible object file.
    let max_chunks: i64 = 1000000;
    loop {
        guard += 1;
        if guard > max_chunks {
            ok = false;
            break;
        }
        let got: i64 = fread(buf, 1 as usize, chunk as usize, fin) as i64;
        // A short read is EOF *or* a hard read error — `fread` alone
        // cannot tell them apart, so the `ferror` check after the loop
        // is what distinguishes them.
        if got <= 0 { break; }
        let mut written: i64 = 0;
        loop {
            if written >= got { break; }
            let part: *u8 = ((buf as i64) + written) as *u8;
            let w: i64 = fwrite(part, 1 as usize, (got - written) as usize, fout) as i64;
            if w <= 0 { break; }
            written += w;
            total += w;
        }
        if written < got {
            ok = false;
            break;
        }
    }

    // Interrogate the read stream before closing it: an EIO, or a
    // source truncated by a concurrent writer, otherwise looks exactly
    // like EOF and would publish a complete-looking partial artifact —
    // the #1011 corruption this path exists to prevent. The displaced
    // `cp` reported that failure through its exit status, so without
    // this the de-shelling would quietly lose error detection.
    if ferror(fin) != 0 { ok = false; }
    free(buf);
    fclose(fin);
    // Fold the destination's close into the result: buffered bytes are
    // only handed to the kernel once `fclose` flushes, so a failure
    // here means the copy is incomplete even though every `fwrite`
    // reported success.
    if fclose(fout) != 0 { ok = false; }
    return CopyOutcome { ok: ok, bytes: total };
}

// Thin wrapper over `_copy_file_counted` for callers that only need the
// pass/fail result — kept so there is exactly one copy loop.
fn _copy_file(src: string, dst: string) -> boolean ![io] {
    return _copy_file_counted(src, dst).ok;
}

// `_copy_file` plus the source's low-12 mode — the faithful replacement
// for `cp -f`, which creates its destination from the source's mode.
// `_copy_file` alone does not: it is `fopen(dst, "wb")`, whose
// 0666-and-umask default is 0644, so a copied executable arrives
// unrunnable. `_selfhost_promote_binary` (`compiler/src/cli_selfhost.sfn`)
// documents the same trap and carries the mode for the same reason.
//
// The `> 0` guard is load-bearing, not padding: `fs.get_perms` reports
// `-1` on any error and `fs.set_perms` masks to 12 bits, so chmod-ing an
// unchecked `-1` would quietly set 0o7777 — setuid, setgid, sticky and
// world-writable. The Windows `get_perms` lowering is a fixed `-1` stub,
// so the guard is also what disables the carry there; no
// `host_is_windows()` gate is needed, and none would be right, since
// Windows has no execute bit to carry.
//
// The carry is best-effort and does not fail the copy: the bytes are the
// deliverable, and a host that cannot report or set a mode is the same
// host on which the copy's default already stands. Callers that must not
// publish an unrunnable binary check the mode themselves —
// `_selfhost_promote_binary` does, because it is staging the compiler
// over itself.
fn _copy_file_preserving_mode(src: string, dst: string) -> boolean ![io] {
    if !_copy_file(src, dst) { return false; }
    let mode = fs.get_perms(src);
    if mode > 0 { fs.set_perms(dst, mode); }
    return true;
}

// `path`'s size in bytes, the shell-free replacement for `wc -c < path`.
// Returns `0` on any failure — a missing file, an unreadable one, or a
// read error — matching the contract the `wc` spawn it displaces already
// had, so no caller changes.
//
// Reads and discards the bytes rather than seeking. `fseek(SEEK_END)` +
// `ftell` would be O(1) instead of O(n), but `ftell` returns `long`,
// which is 32-bit on Win64: the size would silently truncate above 2 GiB
// and the correct Windows spelling is `_ftelli64`, a per-platform
// divergence needing a `platform/` sibling module. Not worth it for a
// probe that runs three times per `sfn package`; the same reasoning
// `runtime/sfn/adapters/filesystem.sfn` records for avoiding the
// seek/tell pair. `_read_file_bytes(path).length` is the other obvious
// answer and is wrong for a different reason: it slurps the whole file
// and hard-fails above its 512 MiB cap, so a large release artifact
// would report `0`.
//
// Chunk size, buffer discipline, and the `max_chunks` guard are
// `_copy_file_counted`'s, for the same reasons.
fn _file_size_of(path: string) -> int ![io] {
    let read_mode: string = "rb";
    let fin: *File = fopen(path as *u8, read_mode as *u8);
    if fin as i64 == 0 { return 0; }

    let chunk: i64 = 65536;
    let buf: *u8 = malloc(chunk as usize);
    if buf as i64 == 0 {
        fclose(fin);
        return 0;
    }

    let mut ok: boolean = true;
    let mut total: i64 = 0;
    let mut guard: i64 = 0;
    let max_chunks: i64 = 1000000;
    loop {
        guard += 1;
        if guard > max_chunks {
            ok = false;
            break;
        }
        let got: i64 = fread(buf, 1 as usize, chunk as usize, fin) as i64;
        // A short read is EOF *or* a hard read error; the `ferror` check
        // below is what tells them apart.
        if got <= 0 { break; }
        total += got;
    }

    if ferror(fin) != 0 { ok = false; }
    free(buf);
    fclose(fin);
    if !ok { return 0; }
    return total as int;
}

fn _toml_trim_cmd(text: string) -> string {
    let mut s: int = 0;
    let mut e: int = text.length;
    loop {
        if s >= e { break; }
        let c = substring(text, s, s + 1);
        let mut ws: boolean = false;
        if c == " " { ws = true; }
        if c == "\n" { ws = true; }
        if c == "\r" { ws = true; }
        if c == "\t" { ws = true; }
        if !ws { break; }
        s += 1;
    }
    loop {
        if e <= s { break; }
        let c = substring(text, e - 1, e);
        let mut ws: boolean = false;
        if c == " " { ws = true; }
        if c == "\n" { ws = true; }
        if c == "\r" { ws = true; }
        if c == "\t" { ws = true; }
        if !ws { break; }
        e -= 1;
    }
    return substring(text, s, e);
}

// Forward declare the arena-aware popen-based capture helper
// implemented in `runtime/sfn/io.sfn` (`fn sailfin_runtime_shell_capture`).
// The pre-existing
// implementation of `_shell_read_cmd` redirected the shell's stdout
// through `/tmp/.sfn_shell_read_cmd_tmp` — a single fixed path that
// raced under any cross-process concurrency (xargs-spawned emit
// workers, parallel `sfn test` invocations, `make compile`'s
// subprocess-stage import-context). One process truncating the file
// while another was mid-write produced silently-corrupt env reads,
// broken build-cache key hashes, and the
// `clang: error: no such file or directory: build/sailfin/capsules/<slug>.ll`
// flake that surfaced as "transient I/O-pressure" in
// `scripts/run_native_test.sh`'s retry table. Reading via popen
// avoids the tmp file entirely.
extern fn sailfin_runtime_shell_capture(cmd: *u8) -> *u8;

// Every command string handed to this helper is POSIX shell syntax
// (`command -v`, `||`, `2>/dev/null`, pipelines). On a Windows host
// `popen` shells through `cmd.exe /c`, which parses none of it: each
// call emits `The system cannot find the path specified.` (cmd.exe's
// ERROR_PATH_NOT_FOUND for an unresolvable `/dev/null`) and returns a
// meaningless result. Worse than the noise, cmd.exe may execute a
// *prefix* of the command with the wrong semantics, so mis-parsing is
// a correctness hazard, not only an ergonomic one. A host with no
// POSIX shell therefore refuses to run the command at all and returns
// the empty string — the same "probe unavailable" contract
// `_mktemp_sibling_cmd` already degrades to. File hashing does not use this
// helper; `_sha256_of_file` is binary-safe and in-process on every host.
// Callers must treat "" as "unknown" (SFN-486 made the build-path
// staging sites non-fatal); as each probe grows a native Windows
// implementation the guard shrinks to that probe.
fn _shell_read_cmd(cmd: string) -> string ![io] {
    if host_is_windows() { return ""; }
    let captured = sailfin_runtime_shell_capture(cmd);
    return _toml_trim_cmd(captured);
}

fn _ensure_dir_cmd(path: string) ![io] {
    if !fs.exists(path) { fs.createDirectory(path, true); }
}

fn _ensure_dir_recursive_cmd(path: string) -> void ![io] {
    if !fs.exists(path) { fs.createDirectory(path, true); }
}

fn _sanitize_filename_cmd(value: string) -> string {
    let mut result: string = "";
    let mut i: int = 0;
    loop {
        if i >= value.length { break; }
        let ch = substring(value, i, i + 1);
        let mut safe: boolean = true;
        if ch == "/" { safe = false; }
        if ch == "\\" { safe = false; }
        if ch == " " { safe = false; }
        if ch == "." { safe = false; }
        if safe { result = result + ch; } else { result = result + "_"; }
        i += 1;
    }
    return result;
}

fn _write_text_cmd(path: string, text: string) ![io] {
    fs.writeFile(path, text);
}

// Strip trailing slashes from a directory path so downstream BFS
// path concatenation (e.g. `dir + "/" + entry`) doesn't produce
// double-slashed paths like `compiler/src//ast.sfn`. Double slashes
// are filesystem-equivalent but trip downstream path-comparison
// and resolver-grouping logic; the historic symptom was
// `sfn check compiler/src/` SIGSEGVing at scale while
// `sfn check compiler/src` succeeded with the same file set.
//
// Preserves "/" (root) — refusing to strip it bare. Idempotent.
// Pure (no I/O) so it's covered by a fast unit test in
// `compiler/tests/unit/cli_path_normalization_test.sfn`.
fn _strip_trailing_slashes_cmd(path: string) -> string {
    let mut result: string = path;
    loop {
        if result.length <= 1 { break; }
        if !_ends_with_cmd(result, "/") { break; }
        result = substring(result, 0, result.length - 1);
    }
    return result;
}

// Can `path` actually be opened for enumeration, as opposed to being
// empty? `fs.listDirectory` answers both questions with `[]` — the
// substitution happens in the lowering, whose failure branch materializes
// an empty array (`codegen-llvm/.../core_call_emission/filesystem_list.sfn`;
// the runtime wrapper only sorts) — so a caller that must not fabricate
// success re-probes an empty listing with this.
//
// On POSIX `opendir` is the honest test because it is the very call whose
// failure that branch swallows: `EACCES`, fd exhaustion, `ENOMEM`. On the
// mingw leg the swallowed call is `FindFirstFileA` instead, so this probes
// an equivalent rather than an identical operation.
//
// A permission-bit reading via `fs.get_perms` would be cheaper and wrong
// in both directions — it cannot see fd pressure, and it answers
// "unreadable" for root, who may enumerate a mode-000 directory perfectly
// well.
fn _dir_is_enumerable(path: string) -> boolean ![io] {
    if path.length == 0 { return false; }
    let handle: *u8 = opendir(path as *u8);
    if handle as i64 == 0 { return false; }
    closedir(handle);
    return true;
}

fn _collect_sfn_files_cmd(root: string, max_depth: int) -> string[] ![io] {
    let mut results: string[] = [];
    // Single-file fast path — but only for a file that is actually there.
    // Returning a non-existent `.sfn` argument as a collected file made
    // `sfn fmt --write absent.sfn` mint a 0-byte stub and exit 0; because
    // module resolution probes `foo.sfn` before falling back to a `foo/`
    // directory, that stub silently shadows the folder that replaced a
    // split-up flat module (SFN-643). The directory walk below already
    // tolerates a missing path; this makes the two legs agree.
    //
    // The helper only filters — reporting the missing path is the
    // caller's job, so that dropping it never reads as "your typo was
    // quietly ignored". See `cli/commands/fmt.sfn` and `check/engine.sfn`.
    if _ends_with_cmd(root, ".sfn") {
        if !fs.exists(root) { return results; }
        return [root];
    }
    let root_norm: string = _strip_trailing_slashes_cmd(root);
    let mut queue: string[] = [root_norm];
    let mut depth: int = 0;
    loop {
        if depth >= max_depth { break; }
        if queue.length == 0 { break; }
        let mut next_queue: string[] = [];
        let mut qi: int = 0;
        loop {
            if qi >= queue.length { break; }
            let dir = queue[qi];
            if !fs.exists(dir) {
                qi += 1;
                continue;
            }
            let entries = fs.listDirectory(dir);
            let mut ei: int = 0;
            loop {
                if ei >= entries.length { break; }
                let entry = entries[ei];
                let full_path = dir + "/" + entry;
                if _ends_with_cmd(entry, ".sfn") {
                    results.push(full_path);
                } else {
                    let child_entries = fs.listDirectory(full_path);
                    if child_entries.length > 0 {
                        next_queue.push(full_path);
                    }
                }
                ei += 1;
            }
            qi += 1;
        }
        queue = next_queue;
        depth += 1;
    }
    return results;
}

fn _path_join_cmd(base: string, name: string) -> string {
    if base.length == 0 { return name; }
    if _is_path_sep(base[base.length - 1]) { return base + name; }
    return base + "/" + name;
}

// POSIX shell single-quote escape: wrap `value` in `'...'`, replacing
// any embedded `'` with `'\''` (close quote, escaped quote, reopen
// quote). Safe to interpolate verbatim into a shell command. Use
// this for any file path or other string handed to `_shell_read_cmd`
// or `process.run(["sh", "-c", ...])` — without it a path containing
// `'` (or other shell metacharacters) breaks quoting and creates a
// command-injection surface.
fn _shell_single_quote_arg(value: string) -> string {
    let mut out: string = "'";
    let mut i: int = 0;
    loop {
        if i >= value.length { break; }
        let ch = substring(value, i, i + 1);
        if ch == "'" { out = out + "'\\''"; } else { out = out + ch; }
        i += 1;
    }
    return out + "'";
}

// Binary-safe counterpart to `fs.readFile`, whose `i8*` return is
// coerced to a Sailfin string via the `string.length` descriptor
// (`sfn_str_len` -> bounded `strnlen`) in
// `compiler/capsules/codegen-llvm/src/expression_lowering/native/core_operands/pointer_coercion.sfn:42-83`,
// truncating at the first NUL. `addr`/`length` are used instead of an
// `int[]` because an `int[]` materialises one i64 per byte, which is
// the `-O0` blow-up SFEP-0048 §3.5 pre-forbids; consumers read bytes
// back with the `load_byte(addr) -> int` intrinsic.
//
// `status` codes: `0` ok, `1` not found, `2` unreadable or I/O error,
// `3` allocation failure, `4` exceeds the size cap, `5` the read made
// too little progress per call to terminate. `4` and `5` are split
// rather than folded: at a full chunk per read the size cap trips
// first, so `5` is reachable only from a source dribbling far less
// than a chunk per `fread` — reporting that as "too large" would
// misdirect anyone reading the failure.
//
// A genuinely empty file returns `status == 0`, `length == 0`, and a
// non-zero `addr`, so it stays distinguishable from every failure
// (which all return `addr == 0`) — the distinction `fs.readFile`
// collapses today by reporting both as `""` (SFN-659).
struct FileBytes {
    addr: int;
    length: int;
    status: int;
}

// Read the entire contents of `file_path` into a heap buffer without
// going through a Sailfin `string`, so embedded NUL bytes survive.
// Models the chunked-read loop in `_copy_file` above, growing the
// buffer geometrically instead of streaming to a second file.
fn _read_file_bytes(file_path: string) -> FileBytes ![io] {
    if !fs.exists(file_path) {
        return FileBytes { addr: 0, length: 0, status: 1 };
    }
    let mode: string = "rb";
    let f: *File = fopen(file_path as *u8, mode as *u8);
    if f as i64 == 0 {
        return FileBytes { addr: 0, length: 0, status: 2 };
    }

    let chunk: i64 = 65536;
    let mut capacity: i64 = 65536;
    // The `+ 1` is slack, not load-bearing: the growth check below runs
    // before every read, so `length < capacity` strictly holds at the
    // terminator write. Moving that check after the read would make
    // this `+ 1` the only thing preventing a one-byte heap overflow.
    let mut buf: *u8 = malloc((capacity + 1) as usize);
    if buf as i64 == 0 {
        fclose(f);
        return FileBytes { addr: 0, length: 0, status: 3 };
    }

    // 512 MiB. Geometric growth means the transient peak is ~2x the
    // buffer (and ~3x briefly, while `realloc` holds both blocks), so
    // this bounds one read near 1.5 GiB — deliberately under the smallest
    // per-job reserve any parallel fan-out budgets, the emit fan-out's
    // 2.5 GiB (`.claude/rules/compiler-safety.md`; the test pool reserves
    // 3 GiB since SFN-781). Anything larger fails closed rather than
    // risking a host kill while reading the file into the hashing path.
    let max_bytes: i64 = 536870912;
    // Backstop only: at a full 64 KiB chunk per read `max_bytes` trips
    // after ~8192 iterations, so this bounds a pathologically short-
    // reading source rather than a large file.
    let max_iters: i64 = 100000;
    let mut length: i64 = 0;
    let mut guard: i64 = 0;
    let mut status: i64 = 0;
    loop {
        guard += 1;
        if guard > max_iters {
            status = 5;
            break;
        }
        if length + chunk > capacity {
            let new_cap: i64 = capacity * 2;
            let nb: *u8 = realloc(buf, (new_cap + 1) as usize);
            if nb as i64 == 0 {
                free(buf);
                fclose(f);
                return FileBytes { addr: 0, length: 0, status: 3 };
            }
            buf = nb;
            capacity = new_cap;
        }
        let dst: *u8 = ((buf as i64) + length) as *u8;
        let got: i64 = fread(dst, 1 as usize, chunk as usize, f) as i64;
        // A short read is EOF *or* a hard read error — see the
        // `ferror` check below, mirroring `_copy_file`.
        if got <= 0 { break; }
        length += got;
        if length > max_bytes {
            status = 4;
            break;
        }
    }

    // Without this, a mid-read I/O error silently yields a truncated
    // buffer and a confidently-wrong digest — and a directory, which
    // opens cleanly and fails its first read, would be indistinguishable
    // from an empty file. Running it unconditionally is deliberate: it
    // may overwrite a cap status with `2`, which is correct, since a
    // stream that errored is a truer account than the cap it also hit.
    if ferror(f) != 0 { status = 2; }
    fclose(f);
    if status != 0 {
        free(buf);
        return FileBytes { addr: 0, length: 0, status: status };
    }

    // NUL-terminate past the data so the buffer doubles as a cstring
    // for incidental text callers; `length` stays authoritative.
    let term: *u8 = ((buf as i64) + length) as *u8;
    memset(term, 0, 1 as usize);
    return FileBytes { addr: buf as i64, length: length, status: 0 };
}

// Free the buffer behind a `FileBytes` result. Callers must call this
// exactly once per `status == 0` result; a no-op on any other status
// since those never allocate a surviving buffer.
fn _free_file_bytes(b: FileBytes) -> void {
    if b.addr != 0 { free(b.addr as *u8); }
}

// Compute a file's SHA-256 digest entirely in-process. `_read_file_bytes`
// preserves embedded NULs and distinguishes an empty file from every failure;
// `sha256_hex_of_bytes` streams from that buffer with O(1) working memory.
// The buffer is freed exactly once after hashing. Any read/allocation/size-cap
// failure maps to `""`, preserving the build driver's fail-closed contract.
fn _sha256_of_file(file_path: string) -> string ![io] {
    let bytes = _read_file_bytes(file_path);
    if bytes.status != 0 { return ""; }
    let digest = sha256_hex_of_bytes(bytes.addr, bytes.length);
    _free_file_bytes(bytes);
    return digest;
}

export {
    _dirname_cmd,
    _path_join_cmd,
    _strip_trailing_slashes_cmd,
    _ends_with_cmd,
    _sanitize_filename_cmd,
    _mktemp_sibling_cmd,
    _mktemp_from_template_cmd,
    _create_exclusive_cmd,
    CREATE_EXCLUSIVE_CREATED,
    CREATE_EXCLUSIVE_EXISTS,
    CREATE_EXCLUSIVE_ERROR,
    CREATE_EXCLUSIVE_MODE_FILE,
    CREATE_EXCLUSIVE_MODE_EXE,
    _cwd_cmd,
    _set_perms_or_skip,
    _atomic_rename_into_place,
    _publish_lines_atomic,
    _copy_file,
    _copy_file_preserving_mode,
    CopyOutcome,
    _copy_file_counted,
    _file_size_of,
    _dir_is_enumerable,
    _ensure_dir_cmd,
    _ensure_dir_recursive_cmd,
    _write_text_cmd,
    _collect_sfn_files_cmd,
    _toml_trim_cmd,
    _shell_read_cmd,
    _shell_single_quote_arg,
    _sha256_of_file,
    FileBytes,
    _read_file_bytes,
    _free_file_bytes
};
