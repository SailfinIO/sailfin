// compiler/src/build/fs.sfn
//
// Backend-shared filesystem, path, shell, and file-hash helpers
// relocated from `cli_commands_utils` (SFEP-0027 §3.5); leave the
// `compiler-common` boundary to #345.
import { substring } from "../string_utils";
import { sha256_hex_of_string } from "./hash";
import { host_is_windows } from "./target";

// libc primitives backing the staging path's temp-mint, atomic
// publish, and file copy. Declared module-locally rather than added
// as `fs.*` builtins: a plain `extern fn` over a libc symbol resolves
// against the pinned seed and needs no seed cut, whereas a new
// builtin is a compiler-emitted intrinsic sentinel + registry row the
// seed cannot resolve (`E0420`) and would force one (SFEP-0021 §5).
// The same reason `arena_relocate.sfn` declares `calloc`/`memcpy` and
// `cli/entry.sfn` declares `realpath` inline.
//
// Pass `string` arguments through an `as *u8` cast, never a `.ptr`
// field access — the latter typechecks green and then lowers to
// nothing, silently dropping the call. Drop this note when SFN-492
// makes that spelling either compile or fail loudly.
//
// `mkstemp` and `close` are POSIX spellings absent from the MSVC UCRT
// (which exports `_close`). The `host_is_windows()` guard below stops
// them being *called* there, but the `call` is still emitted and must
// resolve at link, so the native MSVC leg (SFEP-0021 M7) needs a
// `runtime/ir/windows_stubs.ll` entry for each — the same treatment
// `@realpath` already has there.
extern fn rename(oldpath: *u8, newpath: *u8) -> i32;

extern fn mkstemp(template: *u8) -> i32;

extern fn close(fd: i32) -> i32;

extern fn ferror(f: *File) -> i32;

extern fn fopen(path: *u8, mode: *u8) -> *File;

extern fn fclose(f: *File) -> i32;

extern fn fread(buf: *u8, size: usize, nmemb: usize, f: *File) -> usize;

extern fn fwrite(buf: *u8, size: usize, nmemb: usize, f: *File) -> usize;

extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn calloc(n: usize, sz: usize) -> *u8;

extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

fn _ends_with_cmd(value: string, suffix: string) -> boolean {
    if suffix.length == 0 { return true; }
    if value.length < suffix.length { return false; }
    let start = value.length - suffix.length;
    return substring(value, start, value.length) == suffix;
}

fn _dirname_cmd(path: string) -> string {
    let mut last_slash: int = -1;
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if substring(path, i, i + 1) == "/" { last_slash = i; }
        i += 1;
    }
    if last_slash < 0 { return "."; }
    if last_slash == 0 { return "/"; }
    return substring(path, 0, last_slash);
}

// Mint a unique temp path in the SAME directory as `dst_path`, so a
// subsequent `rename` onto `dst_path` is an atomic same-filesystem
// operation (a `/tmp` temp would force a non-atomic cross-device
// copy). The destination's directory must already exist. Returns the
// temp path, or "" when a temp cannot be minted (callers fall back to
// a direct, non-atomic write).
//
// `mkstemp` creates the file `O_EXCL` and rewrites the trailing
// `XXXXXX` of its argument in place, so the buffer must be writable
// heap, not a string literal: `calloc` zeroes it (supplying the
// trailing NUL) and `memcpy` fills the template. The resulting
// NUL-terminated buffer is returned directly as a `string`, the same
// `*u8`→`string` shape `arena_relocate.sfn::relocate_string_to_heap`
// relies on. The descriptor is closed immediately — the name is
// already exclusively ours, so the caller reopening it by path is not
// a TOCTOU window.
//
// No shell is involved, so `dst_path` deriving from
// `$SAILFIN_BUILD_CACHE_DIR` or a capsule path with shell
// metacharacters is no longer a quoting or injection concern.
fn _mktemp_sibling_cmd(dst_path: string) -> string ![io] {
    // A Windows host has no POSIX `mkstemp`; return "" so the caller
    // degrades to a direct, non-atomic in-place write. Race-free there
    // because a Windows host emits serially (`_cr_resolve_jobs` → 1).
    if host_is_windows() { return ""; }
    let dst_dir = _dirname_cmd(dst_path);
    let template = dst_dir + "/.sfn_stage.XXXXXX";
    let n: i64 = template.length as i64;
    let buf: *u8 = calloc((n + 1) as usize, 1 as usize);
    if buf as i64 == 0 { return ""; }
    memcpy(buf, template as *u8, n as usize);
    let fd: i32 = mkstemp(buf);
    if fd < 0 {
        free(buf);
        return "";
    }
    close(fd);
    return buf;
}

// Atomically publish an already-written temp file as `dst_path` via
// libc `rename(2)`. The rename is atomic only when `tmp_path` and
// `dst_path` share a filesystem — pair this with
// `_mktemp_sibling_cmd(dst_path)` so the temp lives beside the
// destination. A concurrent reader then observes `dst_path` as either
// the prior complete file or the new complete file, never a partial
// write — the invariant that fixes the parallel-emit staging race
// (#1011) and the cache race (#1034). On failure the temp is removed
// and false returned.
fn _atomic_rename_into_place(tmp_path: string, dst_path: string) -> boolean ![io] {
    if rename(tmp_path as *u8, dst_path as *u8) != 0 {
        fs.deleteFile(tmp_path);
        return false;
    }
    return true;
}

// Copy `src` to `dst` byte-for-byte through libc stdio, replacing any
// existing `dst`. Returns false on any open, short-write, or close
// failure, leaving `dst` in whatever state the partial write reached
// — callers publish through `_atomic_rename_into_place` so a failed
// copy never becomes the visible artifact.
//
// Chunked rather than a single sized read: the cache stores multi-
// megabyte `.o` and `.ll` artifacts, and a whole-file buffer would
// scale the compiler's peak RSS with the largest object under the
// 8 GiB self-cap. `guard` bounds the loop so a pathological stream
// that never reports EOF terminates instead of spinning forever.
fn _copy_file(src: string, dst: string) -> boolean ![io] {
    let read_mode: string = "rb";
    let fin: *File = fopen(src as *u8, read_mode as *u8);
    if fin as i64 == 0 { return false; }
    let write_mode: string = "wb";
    let fout: *File = fopen(dst as *u8, write_mode as *u8);
    if fout as i64 == 0 {
        fclose(fin);
        return false;
    }

    let chunk: i64 = 65536;
    let buf: *u8 = malloc(chunk as usize);
    if buf as i64 == 0 {
        fclose(fin);
        fclose(fout);
        return false;
    }

    let mut ok: boolean = true;
    let mut guard: i64 = 0;
    // At 64 KiB a chunk this bounds the copy at ~61 GiB, far above any
    // plausible object file.
    let max_chunks: i64 = 1000000;
    loop {
        guard += 1;
        if guard > max_chunks {
            ok = false;
            break;
        }
        let got: i64 = fread(buf, 1 as usize, chunk as usize, fin) as i64;
        // A short read is EOF *or* a hard read error — `fread` alone
        // cannot tell them apart, so the `ferror` check after the loop
        // is what distinguishes them.
        if got <= 0 { break; }
        let mut written: i64 = 0;
        loop {
            if written >= got { break; }
            let part: *u8 = ((buf as i64) + written) as *u8;
            let w: i64 = fwrite(part, 1 as usize, (got - written) as usize, fout) as i64;
            if w <= 0 { break; }
            written += w;
        }
        if written < got {
            ok = false;
            break;
        }
    }

    // Interrogate the read stream before closing it: an EIO, or a
    // source truncated by a concurrent writer, otherwise looks exactly
    // like EOF and would publish a complete-looking partial artifact —
    // the #1011 corruption this path exists to prevent. The displaced
    // `cp` reported that failure through its exit status, so without
    // this the de-shelling would quietly lose error detection.
    if ferror(fin) != 0 { ok = false; }
    free(buf);
    fclose(fin);
    // Fold the destination's close into the result: buffered bytes are
    // only handed to the kernel once `fclose` flushes, so a failure
    // here means the copy is incomplete even though every `fwrite`
    // reported success.
    if fclose(fout) != 0 { ok = false; }
    return ok;
}

fn _toml_trim_cmd(text: string) -> string {
    let mut s: int = 0;
    let mut e: int = text.length;
    loop {
        if s >= e { break; }
        let c = substring(text, s, s + 1);
        let mut ws: boolean = false;
        if c == " " { ws = true; }
        if c == "\n" { ws = true; }
        if c == "\r" { ws = true; }
        if c == "\t" { ws = true; }
        if !ws { break; }
        s += 1;
    }
    loop {
        if e <= s { break; }
        let c = substring(text, e - 1, e);
        let mut ws: boolean = false;
        if c == " " { ws = true; }
        if c == "\n" { ws = true; }
        if c == "\r" { ws = true; }
        if c == "\t" { ws = true; }
        if !ws { break; }
        e -= 1;
    }
    return substring(text, s, e);
}

// Forward declare the arena-aware popen-based capture helper
// implemented in `runtime/sfn/io.sfn` (`fn sailfin_runtime_shell_capture`).
// The pre-existing
// implementation of `_shell_read_cmd` redirected the shell's stdout
// through `/tmp/.sfn_shell_read_cmd_tmp` — a single fixed path that
// raced under any cross-process concurrency (xargs-spawned emit
// workers, parallel `sfn test` invocations, `make compile`'s
// subprocess-stage import-context). One process truncating the file
// while another was mid-write produced silently-corrupt env reads,
// broken build-cache key hashes, and the
// `clang: error: no such file or directory: build/sailfin/capsules/<slug>.ll`
// flake that surfaced as "transient I/O-pressure" in
// `scripts/run_native_test.sh`'s retry table. Reading via popen
// avoids the tmp file entirely.
extern fn sailfin_runtime_shell_capture(cmd: *u8) -> *u8;

fn _shell_read_cmd(cmd: string) -> string ![io] {
    let captured = sailfin_runtime_shell_capture(cmd);
    return _toml_trim_cmd(captured);
}

fn _ensure_dir_cmd(path: string) ![io] {
    if !fs.exists(path) { process.run(["mkdir", "-p", path]); }
}

fn _ensure_dir_recursive_cmd(path: string) -> void ![io] {
    if !fs.exists(path) { process.run(["mkdir", "-p", path]); }
}

fn _sanitize_filename_cmd(value: string) -> string {
    let mut result: string = "";
    let mut i: int = 0;
    loop {
        if i >= value.length { break; }
        let ch = substring(value, i, i + 1);
        let mut safe: boolean = true;
        if ch == "/" { safe = false; }
        if ch == " " { safe = false; }
        if ch == "." { safe = false; }
        if safe { result = result + ch; } else { result = result + "_"; }
        i += 1;
    }
    return result;
}

fn _write_text_cmd(path: string, text: string) ![io] {
    fs.writeFile(path, text);
}

// Strip trailing slashes from a directory path so downstream BFS
// path concatenation (e.g. `dir + "/" + entry`) doesn't produce
// double-slashed paths like `compiler/src//ast.sfn`. Double slashes
// are filesystem-equivalent but trip downstream path-comparison
// and resolver-grouping logic; the historic symptom was
// `sfn check compiler/src/` SIGSEGVing at scale while
// `sfn check compiler/src` succeeded with the same file set.
//
// Preserves "/" (root) — refusing to strip it bare. Idempotent.
// Pure (no I/O) so it's covered by a fast unit test in
// `compiler/tests/unit/cli_path_normalization_test.sfn`.
fn _strip_trailing_slashes_cmd(path: string) -> string {
    let mut result: string = path;
    loop {
        if result.length <= 1 { break; }
        if !_ends_with_cmd(result, "/") { break; }
        result = substring(result, 0, result.length - 1);
    }
    return result;
}

fn _collect_sfn_files_cmd(root: string, max_depth: int) -> string[] ![io] {
    let mut results: string[] = [];
    if _ends_with_cmd(root, ".sfn") { return [root]; }
    let root_norm: string = _strip_trailing_slashes_cmd(root);
    let mut queue: string[] = [root_norm];
    let mut depth: int = 0;
    loop {
        if depth >= max_depth { break; }
        if queue.length == 0 { break; }
        let mut next_queue: string[] = [];
        let mut qi: int = 0;
        loop {
            if qi >= queue.length { break; }
            let dir = queue[qi];
            if !fs.exists(dir) {
                qi += 1;
                continue;
            }
            let entries = fs.listDirectory(dir);
            let mut ei: int = 0;
            loop {
                if ei >= entries.length { break; }
                let entry = entries[ei];
                let full_path = dir + "/" + entry;
                if _ends_with_cmd(entry, ".sfn") {
                    results.push(full_path);
                } else {
                    let child_entries = fs.listDirectory(full_path);
                    if child_entries.length > 0 {
                        next_queue.push(full_path);
                    }
                }
                ei += 1;
            }
            qi += 1;
        }
        queue = next_queue;
        depth += 1;
    }
    return results;
}

fn _path_join_cmd(base: string, name: string) -> string {
    if base.length == 0 { return name; }
    if base[base.length - 1] == "/" { return base + name; }
    return base + "/" + name;
}

// POSIX shell single-quote escape: wrap `value` in `'...'`, replacing
// any embedded `'` with `'\''` (close quote, escaped quote, reopen
// quote). Safe to interpolate verbatim into a shell command. Use
// this for any file path or other string handed to `_shell_read_cmd`
// or `process.run(["sh", "-c", ...])` — without it a path containing
// `'` (or other shell metacharacters) breaks quoting and creates a
// command-injection surface.
fn _shell_single_quote_arg(value: string) -> string {
    let mut out: string = "'";
    let mut i: int = 0;
    loop {
        if i >= value.length { break; }
        let ch = substring(value, i, i + 1);
        if ch == "'" { out = out + "'\\''"; } else { out = out + ch; }
        i += 1;
    }
    return out + "'";
}

// Compute the sha256 hex digest of a file. Tries `sha256sum` first
// (universally available on Linux); falls back to `shasum -a 256` on
// systems without coreutils (notably default macOS). Mirrors the
// fallback ladder `tools/package.sh` used historically. Returns
// `""` if neither tool is available or the file can't be read.
//
// `file_path` is properly shell-quoted so paths containing `'` or
// other shell metacharacters can't break the command.
fn _sha256_of_file_cmd(file_path: string) -> string ![io] {
    // A Windows host has neither `sha256sum` nor `shasum`; return "" (the
    // existing "no hasher" contract) so the digest falls back to the
    // version stamp. `_sha256_of_text_file` uses the in-process hasher
    // for NUL-free artifacts on Windows, keeping content-addressed caching.
    if host_is_windows() { return ""; }
    let q = _shell_single_quote_arg(file_path);
    let cmd = "(command -v sha256sum >/dev/null 2>&1 && sha256sum " + q
        + " || shasum -a 256 "
        + q
        + ") | cut -d' ' -f1";
    return _shell_read_cmd(cmd);
}

// Compute the SHA-256 hex digest of a NUL-free text file in-process,
// without spawning a subprocess. Returns `""` when the file does not
// exist or cannot be read, preserving the `_sha256_of_file_cmd`
// failure contract (empty digest → not content-addressable → recompile).
//
// SOUND ONLY for NUL-free text artifacts: .sfn source, .ll LLVM IR,
// .toml manifests, .h/.c headers, layout manifests. `fs.readFile`
// coerces the `i8*` return to a Sailfin string via `strlen`
// (core_operands.sfn:1013–1043), which truncates at the first NUL byte.
// Binary artifacts (compiled binaries, tarballs, archives) MUST use
// `_sha256_of_file_cmd`. When #1999 lands a binary-safe `fs.readBinary`
// builtin, this split can be collapsed: replace `_sha256_of_text_file`
// with a single in-process path over `fs.readBinary` and retire
// `_sha256_of_file_cmd` from all hashing callers (#1995, #1999).
//
// Inputs larger than 64 KiB fall back to the subprocess pipeline: the
// vendored hasher's byte loop collapses under -O0 compiler builds (the
// CI shard configuration) — hashing multi-hundred-KB .ll files
// in-process pushed the linux int-caps shard from ~6 min to ~23 min and
// drove selfhost_diff_test.sfn into its 300 s per-file kill (PR #2000
// triage). One popen (~30 ms) beats seconds of -O0 hashing; the
// in-process win is the many small .sfn/.toml sources, which stay under
// the threshold. Retire the threshold together with the split (#1999),
// or earlier if CI shard builds move off -O0.
fn _sha256_of_text_file(file_path: string) -> string ![io] {
    if !fs.exists(file_path) { return ""; }
    let contents = fs.readFile(file_path);
    let inprocess_max = 65536;
    if contents.length > inprocess_max {
        // On a Windows host the subprocess hasher returns "" (no
        // `sha256sum`), so hash in-process to keep the >64 KiB artifacts
        // content-addressable. The POSIX host keeps the popen fast path
        // (the -O0 CI-shard cost the threshold exists to avoid).
        if host_is_windows() { return sha256_hex_of_string(contents); }
        return _sha256_of_file_cmd(file_path);
    }
    if contents.length == 0 {
        // Distinguish "empty file" from "read error": an empty file has
        // the well-known empty-string digest; an unreadable file should
        // return "" to signal the caller. fs.readFile returns "" on read
        // failure, so we treat zero-length as a miss (recompile). Files
        // with real zero-byte content produce the same cache-miss outcome
        // as they would under _sha256_of_file_cmd ("" on failure).
        return "";
    }
    return sha256_hex_of_string(contents);
}

export {
    _dirname_cmd,
    _path_join_cmd,
    _strip_trailing_slashes_cmd,
    _ends_with_cmd,
    _sanitize_filename_cmd,
    _mktemp_sibling_cmd,
    _atomic_rename_into_place,
    _copy_file,
    _ensure_dir_cmd,
    _ensure_dir_recursive_cmd,
    _write_text_cmd,
    _collect_sfn_files_cmd,
    _toml_trim_cmd,
    _shell_read_cmd,
    _shell_single_quote_arg,
    _sha256_of_file_cmd,
    _sha256_of_text_file
};
