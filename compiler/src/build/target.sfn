// compiler/src/build/target.sfn
//
// Build target descriptor (SFN-52 / SFEP-0021 §4.2(A), M6). One resolved
// target-OS string drives every target-divergent build decision — the
// clang `-target` triple, the link libraries, the linker choice, and the
// runtime module set — so a future first-class `sfn build --target`
// (Makefile:988 promise) only has to seed that string instead of
// special-casing Windows inline across the driver.
//
// The target OS is the `SAILFIN_TARGET_OS` override (the cross-compile +
// e2e-test hook) else a non-shelling host probe. `build_host_os` below is
// the single host resolver. The driver snapshots this resolver into the
// explicit LLVM provider context, so emitted platform legs cannot disagree
// with the target this resolves.
// Values are uname-style: "Linux" | "Darwin" | "Windows".
//
// Zero-behaviour contract (#1112): every non-Windows target returns an
// identity/empty result here, so the assembled clang argv and link inputs
// on Linux and macOS are byte-identical to the pre-target-conditioning
// driver. `-target` is only ever added when its triple is non-empty
// (Windows only today), `-lm`/`-lpthread` are only ever dropped for a
// Windows target, and the runtime module set is only ever rewritten for a
// Windows target.
import { _get_env_cmd } from "../build_flags";
import { ends_with } from "../string_utils";
import { _dirname, _path_basename, _path_join } from "./paths";
// SFN-774 / SFEP-0068 §3.2: the `--target` process cell. `build_target_triple`
// below checks it FIRST, ahead of the env-var/host-probe fallbacks, so an
// explicit flag always wins for the running invocation.
import { active_build_target } from "./target_state";

// The resolved build HOST OS — the OS the compile is running on, as
// opposed to the artifact target (`build_target_os`). Host-parallelism
// helpers (`_mktemp_sibling_cmd`, `_cr_resolve_jobs`) gate on this so a
// Linux-host→Windows-target cross-build keeps host behaviour.
//
// The `SAILFIN_HOST_OS` override wins (a test seam mirroring
// `SAILFIN_TARGET_OS`, so every Windows-host leg is unit-testable on a
// Linux runner). Otherwise the non-shelling probe of the SFN-49 de-shell:
// a `/proc/self/status` probe for Linux, a `/System/Library/CoreServices`
// probe for Darwin, then the `SystemRoot` env var for Windows, defaulting
// to Linux. No `uname`/`sh` subprocess — native Windows has neither.
//
// This is the one host resolver in the compiler. The LLVM provider-context
// resolver snapshots its result so emit-time platform legs and every
// `target_os`-keyed build decision — including the SFN-677 `.ll` cache-key
// fold — resolve identically.
//
// The override is returned VERBATIM and unvalidated. That is deliberate: an
// unrecognized value must reach every consumer unchanged so they all
// classify it the same way (`target_os_is_windows` is an exact match, so a
// typo simply reads as non-Windows everywhere). Validating here would make
// this resolver disagree with a consumer that does not.
fn build_host_os() -> string ![io] {
    let host_override = _get_env_cmd("SAILFIN_HOST_OS");
    if host_override.length > 0 { return host_override; }
    if fs.exists("/proc/self/status") { return "Linux"; }
    if fs.exists("/System/Library/CoreServices") { return "Darwin"; }
    if _get_env_cmd("SystemRoot").length > 0 { return "Windows"; }
    return "Linux";
}

// True when the compile is running on a Windows host. Gates the
// host-parallelism / host-probe leaf helpers off the POSIX shell path.
fn host_is_windows() -> boolean ![io] { return build_host_os() == "Windows"; }

// The resolved build target OS (SFN-774 / SFEP-0068 §3.2). Precedence
// relative to `build_target_triple()` below: the `SAILFIN_TARGET_OS`
// override is checked FIRST, ahead of the triple, so the pre-existing
// verbatim-override contract (see `build_host_os` above) survives
// unchanged — an unrecognized override reaches every OS-keyed consumer
// unvalidated, exactly as before. Once that override is absent, this
// derives its answer FROM the triple (`build_target_triple` ->
// `triple_target_os`) rather than probing the host a second time, so
// `--target=<triple>` alone (with no `SAILFIN_TARGET_OS` set) is enough to
// flip every OS-keyed decision — runtime module swap, `.exe` naming, the
// direct-lld gate — consistently with the ABI-keyed decisions that were
// already triple-driven. This is the one deliberate divergence between the
// two resolvers: for an UNRECOGNIZED `SAILFIN_TARGET_OS`, this function
// returns it verbatim (the override branch above), while
// `build_target_triple()` has no such override to check and falls through
// to the host probe instead — the two are not expected to agree on a typo,
// only on every value both recognize.
fn build_target_os() -> string ![io] {
    let target_override = _get_env_cmd("SAILFIN_TARGET_OS");
    if target_override.length > 0 { return target_override; }
    let triple = build_target_triple();
    let os = triple_target_os(triple);
    if os.length > 0 { return os; }
    return build_host_os();
}

fn target_os_is_windows(target_os: string) -> boolean {
    return target_os == "Windows";
}

// ----------------------------------------------------------------
// The triple axis (SFN-774 / SFEP-0068 §3.1)
// ----------------------------------------------------------------
//
// A closed set of `sfn build --target=<triple>` values. Unknown triples are
// REJECTED at the flag (`cli/commands/build.sfn`), never coerced — a typo'd
// triple must fail loudly rather than silently fall back to a host default.
// `target_os_is_windows` above and `target_condition_runtime_sfn_sources`
// below stay keyed on the OS component: both Windows triples need the
// identical POSIX->Win32 runtime-module swap and the identical `.exe`
// naming. The ABI component (`triple_abi`) keys only the four link
// decisions that genuinely diverge between the two Windows ABIs —
// `target_clang_triple`, `target_forced_linker_flag`,
// `target_uses_gnu_link_gc`, `target_filter_link_libs` /
// `target_extra_link_libs` below.
fn triple_is_supported(triple: string) -> boolean {
    if triple == "x86_64-unknown-linux-gnu" { return true; }
    if triple == "aarch64-unknown-linux-gnu" { return true; }
    if triple == "x86_64-apple-darwin" { return true; }
    if triple == "arm64-apple-darwin" { return true; }
    if triple == "x86_64-pc-windows-msvc" { return true; }
    if triple == "x86_64-w64-mingw32" { return true; }
    return false;
}

// The `build_target_os()`-shaped OS component of a triple ("Linux" |
// "Darwin" | "Windows"), or "" for a triple outside the closed set.
fn triple_target_os(triple: string) -> string {
    if triple == "x86_64-unknown-linux-gnu" { return "Linux"; }
    if triple == "aarch64-unknown-linux-gnu" { return "Linux"; }
    if triple == "x86_64-apple-darwin" { return "Darwin"; }
    if triple == "arm64-apple-darwin" { return "Darwin"; }
    if triple == "x86_64-pc-windows-msvc" { return "Windows"; }
    if triple == "x86_64-w64-mingw32" { return "Windows"; }
    return "";
}

// The arch component of a triple ("x86_64" | "aarch64"), or "" for a
// triple outside the closed set (SFN-923). Mirrors `triple_target_os`
// above — `_resolve_llvm_target_arch` (`./llvm_provider_context.sfn`)
// consults this before falling back to its host probe, so an aarch64
// target resolves aarch64 codegen even on an x86_64 host, matching the
// vocabulary `stat_st_mode_offset_value` and `syscall_contract_error`
// already use for the arch axis.
fn triple_target_arch(triple: string) -> string {
    if triple == "x86_64-unknown-linux-gnu" { return "x86_64"; }
    if triple == "aarch64-unknown-linux-gnu" { return "aarch64"; }
    if triple == "x86_64-apple-darwin" { return "x86_64"; }
    if triple == "arm64-apple-darwin" { return "aarch64"; }
    if triple == "x86_64-pc-windows-msvc" { return "x86_64"; }
    if triple == "x86_64-w64-mingw32" { return "x86_64"; }
    return "";
}

// The ABI component of a triple ("gnu" | "mach" | "msvc"), or "" for a
// triple outside the closed set. Only the two Windows triples diverge on
// ABI (`msvc` vs `gnu`) — every other target has exactly one ABI in this
// table, so this exists to key the link decisions in SFEP-0068 §3.1's
// table, not to express a general multi-ABI-per-OS model.
fn triple_abi(triple: string) -> string {
    if triple == "x86_64-pc-windows-msvc" { return "msvc"; }
    if triple == "x86_64-w64-mingw32" { return "gnu"; }
    if triple == "x86_64-unknown-linux-gnu" { return "gnu"; }
    if triple == "aarch64-unknown-linux-gnu" { return "gnu"; }
    if triple == "x86_64-apple-darwin" { return "mach"; }
    if triple == "arm64-apple-darwin" { return "mach"; }
    return "";
}

// The path-safe on-disk artifact tag for a triple (SFEP-0068 §3.1's
// "Artifact tag" column). Unlike the OS-only `target_artifact_tag` this
// replaces, `windows-msvc` and `windows-gnu` are DISTINCT tags — the
// non-optional half of §3.6's cache-key correctness fix: without separate
// tags an msvc build and a mingw build would overwrite each other's
// runtime objects on disk even after their cache keys stopped colliding.
// Unknown triples collapse to `"other"`, deliberately: correctness comes
// from the cache key (`_runtime_obj_key_with_target`), which carries the
// raw triple, so two unknown triples sharing a filename still mismatch on
// key and recompile rather than cross-link.
fn _triple_artifact_tag(triple: string) -> string {
    if triple == "x86_64-unknown-linux-gnu" { return "linux-x86_64"; }
    if triple == "aarch64-unknown-linux-gnu" { return "linux-aarch64"; }
    if triple == "x86_64-apple-darwin" { return "darwin-x86_64"; }
    if triple == "arm64-apple-darwin" { return "darwin-arm64"; }
    if triple == "x86_64-pc-windows-msvc" { return "windows-msvc"; }
    if triple == "x86_64-w64-mingw32" { return "windows-gnu"; }
    return "other";
}

// The complete closed set of tags `_triple_artifact_tag`/`target_artifact_tag`
// can return — every supported triple's tag, plus the `"other"` fallback
// for an unrecognized triple. Single source of truth for anything that
// must sweep or enumerate every possible tag (SFN-774): `target_artifact_tag`
// itself is derived from `triple_is_supported`'s set below, and
// `clean_runtime_object_cache` (`./runtime_objs.sfn`) sweeps exactly this
// list rather than hand-maintaining a parallel literal that can drift out
// of sync with the tag function (the SFN-14 regression this closes).
fn triple_artifact_tags() -> string[] {
    return ["linux-x86_64", "linux-aarch64", "darwin-x86_64", "darwin-arm64", "windows-msvc", "windows-gnu", "other"];
}

// Map a `build_host_os()`-shaped OS string to its default triple in the
// closed set, assuming the x86_64 architecture — except on a Linux host,
// which additionally probes for aarch64 the same non-shelling way
// `build/llvm_provider_context.sfn:_resolve_llvm_target_arch` does, so a
// build with no explicit target on an aarch64 Linux box still resolves its
// own host triple rather than x86_64's. Shared by the `SAILFIN_TARGET_OS`
// legacy alias and the final host-probe fallback in `build_target_triple`
// below, so both spell a Linux/Darwin/Windows OS string the same triple.
// The three `SAILFIN_TARGET_ARCH` probes (here, `_resolve_llvm_target_arch`
// in `./llvm_provider_context.sfn`, and `resolve_direct_ld_lld` in
// `./direct_link.sfn`) must agree on the override precedence and the
// non-shelling aarch64 fallback probe (SFN-774) — a mismatch would let two
// of the three resolve one arch while the third resolves another for the
// identical process environment.
fn _host_default_triple(os: string) -> string ![io] {
    if os == "Windows" { return "x86_64-pc-windows-msvc"; }
    // Known limitation: hardcodes the x86_64 Darwin triple, so an Apple
    // Silicon host mislabels its own tag. Not fixed here (SFN-774, Slice
    // A1) — Darwin arm64 host detection is out of scope for this slice.
    if os == "Darwin" { return "x86_64-apple-darwin"; }
    let mut arch = _get_env_cmd("SAILFIN_TARGET_ARCH");
    if arch.length == 0 {
        arch = "x86_64";
        if fs.exists("/lib/ld-linux-aarch64.so.1") { arch = "aarch64"; }
    }
    if arch == "aarch64" { return "aarch64-unknown-linux-gnu"; }
    return "x86_64-unknown-linux-gnu";
}

// The resolved build target TRIPLE (SFN-774 / SFEP-0068 §3.2). Resolution
// order: the explicit `--target` process cell (`set_build_target`,
// `./target_state`) wins first, then the `SAILFIN_TARGET_TRIPLE` override,
// then `SAILFIN_TARGET_OS` as a legacy alias (so every existing
// `SAILFIN_TARGET_OS=Windows` e2e seam keeps resolving to the msvc triple
// unchanged), then a non-shelling host probe. This is the primary target
// resolver for every ABI-conditioned decision (`target_clang_triple`,
// `target_forced_linker_flag`, `target_uses_gnu_link_gc`,
// `target_filter_link_libs`/`target_extra_link_libs`, `target_artifact_tag`);
// `build_target_os()` above remains the OS-only resolver for the decisions
// that stay OS-keyed (`target_exe_name`, `target_condition_runtime_sfn_sources`).
fn build_target_triple() -> string ![io] {
    let active = active_build_target();
    if active.length > 0 { return active; }
    let triple_override = _get_env_cmd("SAILFIN_TARGET_TRIPLE");
    if triple_override.length > 0 { return triple_override; }
    let os_override = _get_env_cmd("SAILFIN_TARGET_OS");
    if os_override.length > 0 { return _host_default_triple(os_override); }
    return _host_default_triple(build_host_os());
}

// Appends `.exe` to a COMPILER-DERIVED executable name when `target_os` is
// Windows; every other target returns `name` unchanged. This applies only
// to names the compiler itself derives (`build/sailfin/program`, a
// capsule's artifact path, a test/run scratch binary) — an explicit
// user-supplied `-o` is honored verbatim, matching Windows `clang.exe`'s
// own behaviour of never rewriting an explicit output path.
//
// The suffix is required, not cosmetic: every runtime spawn site
// (`runtime/sfn/platform/process_windows.sfn`) calls `CreateProcessA` with
// `lpApplicationName = null`, so Win32 derives the module name by parsing
// the command line and appends `.exe` only when the parsed name already
// has no extension of its own — an extensionless PE built by this
// compiler is otherwise unlaunchable (SFN-693).
//
// Idempotent: a name already ending in `.exe` is left alone.
fn target_exe_name(name: string, target_os: string) -> string {
    if !target_os_is_windows(target_os) { return name; }
    if ends_with(name, ".exe") { return name; }
    return name + ".exe";
}

// `target_exe_name` gated on the HOST rather than the target (SFN-701),
// for a binary THIS machine must execute — the installed compiler, a
// self-host stage's own output — as opposed to `target_exe_name` above,
// which names what a build emits FOR its target. Using the target gate
// here would be wrong: a cross-build names its output for the target it's
// building for, but a self-host stage binary has to actually run on the
// host that just built it, regardless of what target that build is aimed
// at.
fn host_exe_name(name: string) -> string ![io] {
    return target_exe_name(name, build_host_os());
}

// The clang `-target` triple to pass for `triple`, or "" to use clang's
// host default. Only the two Windows triples diverge: `x86_64-pc-windows-
// msvc` and `x86_64-w64-mingw32` are each returned verbatim (linking
// `lld-link`+UCRT and mingw-w64+MinGW CRT respectively); every other
// target keeps the host default so no `-target` flag is added at all.
//
// Deliberate scope limit (SFN-774, Slice A1): a non-Windows CROSS triple
// (e.g. an aarch64-linux-gnu build run on an x86_64-linux-gnu host) still
// resolves "" here — `triple_target_os`/`triple_abi` decompose the triple,
// but this function only branches on "is this triple Windows", so a
// non-Windows cross build gets no `-target` flag and silently compiles for
// the HOST arch/OS instead of the requested one. Wiring an actual
// non-Windows `-target` is a follow-up (SFN-775 / a later SFEP-0068
// slice), not part of promoting the axis itself.
fn target_clang_triple(triple: string) -> string {
    if triple_target_os(triple) == "Windows" { return triple; }
    return "";
}

// The `-target <triple>` clang flag pair for `triple`, or [] when the host
// default is used (non-Windows). Pure — callers resolve `triple` via
// `build_target_triple()` in an `![io]` context and pass it in.
fn target_clang_flags(triple: string) -> string[] {
    let clang_triple = target_clang_triple(triple);
    if clang_triple.length == 0 { return []; }
    return ["-target", clang_triple];
}

// The `-fuse-ld=` flag a target forces regardless of host auto-detection.
// A Windows MSVC-ABI triple links with `lld-link` via `-fuse-ld=lld`;
// every other target returns "" so the driver's existing Linux-only
// mold/lld auto-detect (and the `SAILFIN_LINKER` override) is unchanged.
//
// The windows-gnu ABI (`x86_64-w64-mingw32`) needs its OWN linker driver
// (`x86_64-w64-mingw32-gcc -static`), not a `-fuse-ld=` flag on clang, so
// it cannot be expressed by this function's return shape. The branch is
// structured on ABI here so SFN-775 (A2) only has to fill the `gnu` arm
// in; deliberately still `""` (no forced flag) until that lands — do not
// invent the mingw link path in this slice.
fn target_forced_linker_flag(triple: string) -> string {
    let abi = triple_abi(triple);
    if abi == "msvc" { return "-fuse-ld=lld"; }
    return "";
}

// `lld-link` stamps a live epoch `TimeDateStamp` into the COFF header by
// default, so two links of identical input differ; `/Brepro` substitutes a
// content hash and makes the link reproducible (SFN-920). msvc-only: the
// windows-gnu (mingw) ABI links with a GNU `ld`-family linker that does not
// accept this flag.
fn target_reproducible_link_flag(triple: string) -> string {
    let abi = triple_abi(triple);
    if abi == "msvc" { return "-Wl,/Brepro"; }
    return "";
}

// True when a target's linker rejects the GNU-style section-GC and
// force-undefined flags (`-Wl,--gc-sections`, `-Wl,-u,<sym>`) the POSIX
// link path emits. `lld-link` (the MSVC linker) uses `/OPT:REF` /
// `/INCLUDE:` instead, so for the msvc ABI the driver skips the GNU
// dead-strip + retain-root flags rather than emit inputs `lld-link` would
// reject. (The MSVC-native equivalents are tuned against a real link in
// SFEP-0021 M7; here the point is a clean lld-link invocation.) The
// windows-gnu ABI links with a GNU `ld`-family linker via mingw, which
// DOES accept the GNU flags, so it stays on (SFEP-0068 §3.1). Every other
// target keeps the GNU flags too → byte-identical link (#1112).
fn target_uses_gnu_link_gc(triple: string) -> boolean {
    return triple_abi(triple) != "msvc";
}

// Drop POSIX-only link libraries for the msvc ABI (UCRT): `-lm`/
// `-lpthread` have no MSVC equivalent (`ws2_32`/`kernel32` are
// auto-linked by clang). The windows-gnu ABI links against mingw-w64's
// POSIX-compatible CRT, so it KEEPS `-lm`/`-lpthread` (SFEP-0068 §3.1) —
// only msvc filters. Every other target returns the list unchanged
// (identity → byte-identical link).
fn target_filter_link_libs(libs: string[], triple: string) -> string[] {
    if triple_abi(triple) != "msvc" { return libs; }
    let mut kept: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= libs.length { break; }
        let lib = libs[i];
        let posix = lib == "-lm" || lib == "-lpthread";
        if !posix { kept.push(lib); }
        i += 1;
    }
    return kept;
}

// Extra link libraries a target REQUIRES beyond `libs` — the reverse of
// `target_filter_link_libs` above, which only ever drops. Windows needs
// three:
//
//   `-lbcrypt`  — bcrypt.dll's import lib, for
//                 `platform/rand_windows.sfn`'s `BCryptGenRandom`
//                 (SFN-549).
//   `-lcrypt32` — crypt32.dll's import lib, for
//                 `platform/cert_roots_windows.sfn`'s
//                 `CertOpenSystemStoreA`/`CertEnumCertificatesInStore`/
//                 `CertFreeCertificateContext`/`CertCloseStore` (SFN-808).
//   `-lws2_32`  — Winsock2's import lib. On POSIX the socket surface is
//                 in libc, so `runtime/sfn/adapters/net.sfn` and
//                 `websocket.sfn` declare `socket`/`bind`/`listen`/
//                 `accept`/`connect`/`send`/`recv`/`setsockopt`/
//                 `getsockname`/`getaddrinfo`/`freeaddrinfo` as bare
//                 externs and link them for free. Windows exports the
//                 same 11 names from ws2_32.dll instead, so without this
//                 every native Windows link fails on all 11 — even for a
//                 program that opens no socket, because COFF resolves
//                 all external references before dead-stripping and the
//                 net/websocket runtime modules are always linked in
//                 (SFN-649).
//
// `-lws2_32` and `-lcrypt32` are needed by BOTH Windows ABIs (Winsock2 and
// Crypt32 are the same DLLs either way, and unlike bcrypt neither is in
// mingw-w64's default auto-linked import-lib set); `-lbcrypt` is msvc-only
// — the windows-gnu ABI's mingw-w64 CRT resolves `BCryptGenRandom` through
// its own import libs, so adding it there would be a redundant (harmless
// but incorrect-by-omission) flag. No other target links any of the
// three, so every non-Windows target returns `[]` (identity →
// byte-identical link, #1112).
fn target_extra_link_libs(triple: string) -> string[] {
    let abi = triple_abi(triple);
    if abi == "msvc" { return ["-lbcrypt", "-lcrypt32", "-lws2_32"]; }
    if abi == "gnu" && triple_target_os(triple) == "Windows" {
        return ["-lcrypt32", "-lws2_32"];
    }
    return [];
}

// Rewrite the runtime capsule's `sfn-sources` list for `target_os`. On
// Windows, POSIX-only modules are swapped for their Win32 siblings:
// `process.sfn` (posix_spawnp/waitpid) for `platform/process_windows.sfn`,
// `rlimit.sfn` (getrlimit/setrlimit) for `platform/rlimit_windows.sfn`
// (SFN-549 — previously dropped outright, leaving
// `apply_default_mem_limit` unresolved once `windows_stubs.ll` stopped
// linking on the native path), `terminal.sfn` (`isatty`) for
// `platform/terminal_windows.sfn` (`_isatty`), `rand.sfn`
// (getentropy/`/dev/urandom`) for
// `platform/rand_windows.sfn` (SFN-549, `BCryptGenRandom`), and
// `fs_exec_mode.sfn` (POSIX `X_OK`) for
// `platform/fs_exec_mode_windows.sfn` (SFN-649 — `X_OK` is not a legal
// UCRT `_access` mode and terminates the process via
// `_invalid_parameter_noinfo` -> `__fastfail` instead of returning an
// error; the sibling supplies `F_OK`, the strongest question Windows
// can answer where no execute permission bit exists), and `cert_roots.sfn`
// (returns null; POSIX's trust store is a CA-bundle file, already covered
// by `trust_store_default_paths()`) for `platform/cert_roots_windows.sfn`
// (SFN-808 — Windows has no CA-bundle file anywhere, so the system `ROOT`
// certificate store reached through Crypt32 is the only trust source
// there). Five further modules —
// `platform/realpath_windows.sfn`, `platform/clock_windows.sfn`,
// `platform/pthread_windows.sfn`, `platform/popen_windows.sfn`, and
// `platform/mkstemp_windows.sfn` (all SFN-549) — are APPENDED rather than
// swapped, since none has a POSIX `.sfn` module to swap FROM (each backs
// a bare libc/pthreads symbol, not a Sailfin-authored runtime module);
// see the note below the loop. This mirrors the mingw Makefile
// `RUNTIME_MODS` swap and is the extensible seam for the broader MSVC
// exclusion set, finalized empirically against a real native link in
// SFEP-0021 M7. Every other target returns the list unchanged.
//
// `sources` are already runtime-root-resolved absolute paths; match on the
// basename so the manifest-root prefix is irrelevant, and rebuild the
// swapped path from the source's own directory so it stays correctly
// rooted (`<root>/sfn/process.sfn` → `<root>/sfn/platform/process_windows.sfn`).
// `rlimit.sfn`/`terminal.sfn`/`rand.sfn`/`fs_exec_mode.sfn`/`fd_io.sfn`/
// `socket_ops.sfn`/`rename_ops.sfn`/`cert_roots.sfn` already live in
// `platform/`, so their siblings are joined directly onto that same
// directory rather than appending another `platform/` segment.
fn target_condition_runtime_sfn_sources(sources: string[], target_os: string) -> string[] {
    if !target_os_is_windows(target_os) { return sources; }
    let mut out: string[] = [];
    // Anchor for the append block below — the `platform/` directory,
    // discovered from whichever of rlimit.sfn/terminal.sfn/rand.sfn/tls.sfn/
    // fs_exec_mode.sfn/fd_io.sfn/socket_ops.sfn/rename_ops.sfn/cert_roots.sfn/
    // exec.sfn happens to be present in `sources`, since none of these
    // is guaranteed by this function's own contract.
    let mut platform_dir: string = "";
    let mut i: int = 0;
    loop {
        if i >= sources.length { break; }
        let src = sources[i];
        let base = _path_basename(src);
        if base == "rlimit.sfn" {
            // Already in platform/ (unlike process.sfn below): the sibling
            // sits next to it, not one level down.
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "rlimit_windows.sfn"));
        } else if base == "terminal.sfn" {
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "terminal_windows.sfn"));
        } else if base == "process.sfn" {
            out.push(_path_join(_dirname(src), "platform/process_windows.sfn"));
        } else if base == "rand.sfn" {
            // Already in platform/ — same as rlimit.sfn above.
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "rand_windows.sfn"));
        } else if base == "tls.sfn" {
            // NOT swapped (SFN-341): the module's OpenSSL externs are gone,
            // replaced by the native TLS 1.3 stack over `sfn/crypto`, so
            // there is no OpenSSL-backed module left to fail closed for and
            // `openssl_absent_windows.sfn` is deleted. It still anchors
            // `platform_dir` for the append block below, and passes through
            // to the emitted list unchanged.
            platform_dir = _dirname(src);
            out.push(src);
        } else if base == "fs_exec_mode.sfn" {
            // Already in platform/ — same as rlimit.sfn/rand.sfn above.
            // POSIX `X_OK` (1) is not a legal UCRT `_access` mode and
            // fastfails the process rather than returning an error, so
            // the Windows sibling supplies `F_OK` (0) instead (SFN-649).
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "fs_exec_mode_windows.sfn"));
        } else if base == "fd_io.sfn" {
            // Already in platform/ — same as the four above. The UCRT's
            // `_read`/`_write` are `int` (32-bit) rather than POSIX's
            // `ssize_t` (64-bit), so a raw `-> i64` extern silently
            // promotes a `-1` error into `4294967295`, defeating every
            // downstream `<= 0`/`< 0` guard in `io.sfn`/`assert.sfn`
            // (SFN-927 — the generic-fd counterpart of `socket_ops.sfn`'s
            // `recv`/`send` fix below; kept in a separate module because
            // `socket_ops.sfn` is gated behind the `net` effect and
            // `io.sfn`/`assert.sfn` are not).
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "fd_io_windows.sfn"));
        } else if base == "socket_ops.sfn" {
            // Already in platform/ — same as the four above. POSIX
            // `close` on a Winsock `SOCKET` fastfails the process
            // (`0xC0000409`) exactly like `X_OK` above, and Winsock
            // additionally refuses every call until `WSAStartup` runs,
            // which nothing did — so sockets were non-functional on
            // native Windows rather than merely leaky. The sibling
            // supplies `closesocket` and the missing initialization
            // (SFN-671).
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "socket_ops_windows.sfn"));
        } else if base == "rename_ops.sfn" {
            // Already in platform/ — same as the four above. The CRT's
            // `rename()` fails EEXIST on an existing destination where
            // POSIX `rename(2)` replaces atomically, so every
            // publish-into-place in the toolchain worked once per
            // destination and then failed forever. The sibling uses
            // `MoveFileExA` + `MOVEFILE_REPLACE_EXISTING` (SFN-720).
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "rename_ops_windows.sfn"));
        } else if base == "cert_roots.sfn" {
            // Already in platform/ — same as the five above. POSIX has no
            // enumerable trust store to swap in for: the CA bundle is a
            // file, already covered by `trust_store_default_paths()`, so
            // the POSIX leg returns null and the caller falls through to
            // that path probe. Windows has no CA-bundle file anywhere, so
            // the system `ROOT` certificate store reached through Crypt32
            // is the only trust source there — the sibling enumerates it
            // via `CertOpenSystemStoreA`/`CertEnumCertificatesInStore`
            // (SFN-808).
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "cert_roots_windows.sfn"));
        } else if base == "exec.sfn" {
            // exec.sfn itself is unchanged (its `realpath` extern is
            // satisfied by the appended sibling below, not by swapping
            // exec.sfn out) — captured here only as a fourth possible
            // anchor for platform_dir.
            platform_dir = _dirname(src);
            out.push(src);
        } else { out.push(src); }
        i += 1;
    }
    // `realpath_windows.sfn`, `clock_windows.sfn`, `pthread_windows.sfn`,
    // `popen_windows.sfn`, `mkstemp_windows.sfn`, `strcasestr_windows.sfn`,
    // `opendir_windows.sfn`, and `mkdtemp_windows.sfn` have no POSIX
    // `.sfn` counterpart to swap FROM (SFN-549, SFN-903, SFN-993):
    // `realpath(3)`, `clock_gettime`/`nanosleep`, the `pthread_*`/
    // `sysconf` surface, `popen`/`pclose`/`mkstemp`, `strcasestr(3)`,
    // `opendir`/`closedir`, and `mkdtemp(3)` are bare libc/pthreads
    // symbols on POSIX, not Sailfin-authored runtime modules, so — unlike
    // the swaps above — these are pure ADDITIONS with nothing in `sources`
    // to replace. Each satisfies its `extern fn` declaration(s) elsewhere
    // in the runtime via ordinary link-time symbol resolution; see each
    // module's own header for the full rationale. Skipped (rather than
    // guessing a path) if none of the eight platform/ modules above were
    // present to anchor on.
    if platform_dir.length > 0 {
        out.push(_path_join(platform_dir, "realpath_windows.sfn"));
        out.push(_path_join(platform_dir, "clock_windows.sfn"));
        out.push(_path_join(platform_dir, "pthread_windows.sfn"));
        out.push(_path_join(platform_dir, "popen_windows.sfn"));
        out.push(_path_join(platform_dir, "mkstemp_windows.sfn"));
        out.push(_path_join(platform_dir, "strcasestr_windows.sfn"));
        out.push(_path_join(platform_dir, "opendir_windows.sfn"));
        // The compiler that emits the Windows leg is always CURRENT-TREE,
        // never the pinned seed: there is no released native Windows seed
        // yet (`docs/runbooks/windows-native.md`), so this append carries
        // no seed dependency (`.claude/rules/seed-dependency.md`). Once a
        // real Windows seed ships, a change to Windows-leg codegen itself
        // (as opposed to an ordinary runtime-source append like this one)
        // acquires a genuine seed dependency and this reasoning stops
        // holding — it must be re-evaluated at that point, not assumed.
        out.push(_path_join(platform_dir, "mkdtemp_windows.sfn"));
    }
    return out;
}

// A path-safe token for a build TRIPLE, for use in cache-artifact
// filenames (SFN-617, promoted to the triple axis by SFN-774 /
// SFEP-0068 §3.6). A resolved triple may originate from
// `SAILFIN_TARGET_TRIPLE`/`SAILFIN_TARGET_OS` — unvalidated environment
// strings — so it must never be interpolated into a filesystem path
// directly; this delegates to `_triple_artifact_tag`'s closed set of
// path-safe tokens. `windows-msvc` and `windows-gnu` are now DISTINCT
// tags, which is the on-disk half of the §3.6 correctness fix: before
// this, both Windows ABIs shared the single `"windows"` tag and could
// overwrite each other's cached runtime objects even after the cache-key
// fold below stopped colliding them. See `_triple_artifact_tag` for the
// unknown-triple fallback rationale.
fn target_artifact_tag(triple: string) -> string {
    return _triple_artifact_tag(triple);
}

export {
    build_host_os,
    host_is_windows,
    build_target_os,
    build_target_triple,
    target_os_is_windows,
    target_exe_name,
    host_exe_name,
    target_clang_triple,
    target_clang_flags,
    target_forced_linker_flag,
    target_reproducible_link_flag,
    target_uses_gnu_link_gc,
    target_filter_link_libs,
    target_extra_link_libs,
    target_condition_runtime_sfn_sources,
    target_artifact_tag,
    triple_abi,
    triple_artifact_tags,
    triple_is_supported,
    triple_target_arch,
    triple_target_os
};
