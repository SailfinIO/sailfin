// compiler/src/build/target.sfn
//
// Build target descriptor (SFN-52 / SFEP-0021 §4.2(A), M6). One resolved
// target-OS string drives every target-divergent build decision — the
// clang `-target` triple, the link libraries, the linker choice, and the
// runtime module set — so a future first-class `sfn build --target`
// (Makefile:988 promise) only has to seed that string instead of
// special-casing Windows inline across the driver.
//
// The target OS is the `SAILFIN_TARGET_OS` override (the cross-compile +
// e2e-test hook) else a non-shelling host probe. `build_host_os` below is
// the single host resolver: the emit-time `_host_os()` locator in
// `llvm/lowering_debug_state.sfn` (SFN-49, M1) delegates to it rather than
// repeating the probe, so a module's emitted platform legs cannot disagree
// with the target this resolves (SFN-682 — they were two bodies that
// diverged on the `SAILFIN_HOST_OS` override).
// Values are uname-style: "Linux" | "Darwin" | "Windows".
//
// Zero-behaviour contract (#1112): every non-Windows target returns an
// identity/empty result here, so the assembled clang argv and link inputs
// on Linux and macOS are byte-identical to the pre-target-conditioning
// driver. `-target` is only ever added when its triple is non-empty
// (Windows only today), `-lm`/`-lpthread` are only ever dropped for a
// Windows target, and the runtime module set is only ever rewritten for a
// Windows target.
import { _get_env_cmd } from "../build_flags";
import { ends_with } from "../string_utils";
import { _dirname, _path_basename, _path_join } from "./paths";

// The resolved build HOST OS — the OS the compile is running on, as
// opposed to the artifact target (`build_target_os`). Host-parallelism
// helpers (`_mktemp_sibling_cmd`, `_cr_resolve_jobs`) and the host link
// probes (`_openssl_link_search_flags`) gate on this so a
// Linux-host→Windows-target cross-build keeps host behaviour.
//
// The `SAILFIN_HOST_OS` override wins (a test seam mirroring
// `SAILFIN_TARGET_OS`, so every Windows-host leg is unit-testable on a
// Linux runner). Otherwise the non-shelling probe of the SFN-49 de-shell:
// a `/proc/self/status` probe for Linux, a `/System/Library/CoreServices`
// probe for Darwin, then the `SystemRoot` env var for Windows, defaulting
// to Linux. No `uname`/`sh` subprocess — native Windows has neither.
//
// This is the one host resolver in the compiler; `_host_os()` in
// `llvm/lowering_debug_state.sfn` delegates here (SFN-682) so the emit-time
// platform legs and every `target_os`-keyed build decision — including the
// SFN-677 `.ll` cache-key fold — resolve identically.
//
// The override is returned VERBATIM and unvalidated. That is deliberate: an
// unrecognized value must reach every consumer unchanged so they all
// classify it the same way (`target_os_is_windows` is an exact match, so a
// typo simply reads as non-Windows everywhere). Validating here would make
// this resolver disagree with a consumer that does not.
fn build_host_os() -> string ![io] {
    let host_override = _get_env_cmd("SAILFIN_HOST_OS");
    if host_override.length > 0 { return host_override; }
    if fs.exists("/proc/self/status") { return "Linux"; }
    if fs.exists("/System/Library/CoreServices") { return "Darwin"; }
    if _get_env_cmd("SystemRoot").length > 0 { return "Windows"; }
    return "Linux";
}

// True when the compile is running on a Windows host. Gates the
// host-parallelism / host-probe leaf helpers off the POSIX shell path.
fn host_is_windows() -> boolean ![io] { return build_host_os() == "Windows"; }

// The resolved build target OS: the `SAILFIN_TARGET_OS` override wins (the
// cross-compile + e2e-test hook the emit-time locators already honor),
// else the host OS.
fn build_target_os() -> string ![io] {
    let target_override = _get_env_cmd("SAILFIN_TARGET_OS");
    if target_override.length > 0 { return target_override; }
    return build_host_os();
}

fn target_os_is_windows(target_os: string) -> boolean {
    return target_os == "Windows";
}

// Appends `.exe` to a COMPILER-DERIVED executable name when `target_os` is
// Windows; every other target returns `name` unchanged. This applies only
// to names the compiler itself derives (`build/sailfin/program`, a
// capsule's artifact path, a test/run scratch binary) — an explicit
// user-supplied `-o` is honored verbatim, matching Windows `clang.exe`'s
// own behaviour of never rewriting an explicit output path.
//
// The suffix is required, not cosmetic: every runtime spawn site
// (`runtime/sfn/platform/process_windows.sfn`) calls `CreateProcessA` with
// `lpApplicationName = null`, so Win32 derives the module name by parsing
// the command line and appends `.exe` only when the parsed name already
// has no extension of its own — an extensionless PE built by this
// compiler is otherwise unlaunchable (SFN-693).
//
// Idempotent: a name already ending in `.exe` is left alone.
fn target_exe_name(name: string, target_os: string) -> string {
    if !target_os_is_windows(target_os) { return name; }
    if ends_with(name, ".exe") { return name; }
    return name + ".exe";
}

// The clang `-target` triple for `target_os`, or "" to use clang's host
// default. Only Windows diverges (the MSVC ABI: `x86_64-pc-windows-msvc`,
// linking `lld-link` + the UCRT); every other target keeps the host
// default so no `-target` flag is added at all.
fn target_clang_triple(target_os: string) -> string {
    if target_os_is_windows(target_os) { return "x86_64-pc-windows-msvc"; }
    return "";
}

// The `-target <triple>` clang flag pair for `target_os`, or [] when the
// host default is used (non-Windows). Pure — callers resolve `target_os`
// via `build_target_os()` in an `![io]` context and pass it in.
fn target_clang_flags(target_os: string) -> string[] {
    let triple = target_clang_triple(target_os);
    if triple.length == 0 { return []; }
    return ["-target", triple];
}

// The `-fuse-ld=` flag a target forces regardless of host auto-detection.
// A Windows (MSVC) target links with `lld-link` via `-fuse-ld=lld`; every
// other target returns "" so the driver's existing Linux-only mold/lld
// auto-detect (and the `SAILFIN_LINKER` override) is unchanged.
fn target_forced_linker_flag(target_os: string) -> string {
    if target_os_is_windows(target_os) { return "-fuse-ld=lld"; }
    return "";
}

// True when a target's linker rejects the GNU-style section-GC and
// force-undefined flags (`-Wl,--gc-sections`, `-Wl,-u,<sym>`) the POSIX
// link path emits. `lld-link` (the MSVC linker) uses `/OPT:REF` /
// `/INCLUDE:` instead, so for a Windows target the driver skips the GNU
// dead-strip + retain-root flags rather than emit inputs `lld-link` would
// reject. (The MSVC-native equivalents are tuned against a real link in
// SFEP-0021 M7; here the point is a clean lld-link invocation.) Every
// non-Windows target keeps the GNU flags → byte-identical link.
fn target_uses_gnu_link_gc(target_os: string) -> boolean {
    return !target_os_is_windows(target_os);
}

// Drop POSIX-only link libraries for a Windows (MSVC/UCRT) target:
// `-lm`/`-lpthread` are POSIX, and `-lssl`/`-lcrypto` have no Windows host
// package to link against (`platform/openssl_absent_windows.sfn` swaps
// out `tls.sfn`'s OpenSSL externs entirely for that target — see
// `target_condition_runtime_sfn_sources` below — rather than relying on
// a linked-but-stubbed library), so none are passed to the MSVC link
// (`ws2_32`/`kernel32` are auto-linked by clang). Every other target
// returns the list unchanged (identity → byte-identical link).
fn target_filter_link_libs(libs: string[], target_os: string) -> string[] {
    if !target_os_is_windows(target_os) { return libs; }
    let mut kept: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= libs.length { break; }
        let lib = libs[i];
        let posix = lib == "-lm" || lib == "-lpthread" || lib == "-lssl" || lib == "-lcrypto";
        if !posix { kept.push(lib); }
        i += 1;
    }
    return kept;
}

// Extra link libraries a target REQUIRES beyond `libs` — the reverse of
// `target_filter_link_libs` above, which only ever drops. Windows needs
// two:
//
//   `-lbcrypt`  — bcrypt.dll's import lib, for
//                 `platform/rand_windows.sfn`'s `BCryptGenRandom`
//                 (SFN-549).
//   `-lws2_32`  — Winsock2's import lib. On POSIX the socket surface is
//                 in libc, so `runtime/sfn/adapters/net.sfn` and
//                 `websocket.sfn` declare `socket`/`bind`/`listen`/
//                 `accept`/`connect`/`send`/`recv`/`setsockopt`/
//                 `getsockname`/`getaddrinfo`/`freeaddrinfo` as bare
//                 externs and link them for free. Windows exports the
//                 same 11 names from ws2_32.dll instead, so without this
//                 every native Windows link fails on all 11 — even for a
//                 program that opens no socket, because COFF resolves
//                 all external references before dead-stripping and the
//                 net/websocket runtime modules are always linked in
//                 (SFN-649).
//
// No other target links either, so every non-Windows target returns `[]`
// (identity → byte-identical link, #1112).
fn target_extra_link_libs(target_os: string) -> string[] {
    if target_os_is_windows(target_os) { return ["-lbcrypt", "-lws2_32"]; }
    return [];
}

// SFN-647: Windows x64 has no one-argument `setjmp`. The UCRT header maps
// `setjmp(buf)` onto `_setjmp(buf, frame)`, and MSVC's `longjmp` reads that
// second argument back out of `_JUMP_BUFFER.Frame`: a NON-ZERO `Frame` sends
// the restore down `RtlUnwindEx` (a full SEH unwind) instead of the plain
// register restore. Emitting the POSIX one-argument call left `rdx` holding
// whatever the caller happened to leave there, so the first `throw` in a
// natively-built program unwound against a garbage frame and the process died
// before reaching any catch block — `try-catch-finally.sfn` exited 40 having
// printed nothing, while `hello-world.sfn` survived only because it never
// throws.
//
// A NULL second argument is what selects longjmp's non-unwinding path, and it
// is the correct choice here: Sailfin's exception model does no SEH unwinding
// — `sfn_throw` `longjmp`s straight to the matching save point. (clang passes
// `llvm.frameaddress(0)` when compiling C because C's `longjmp` must run SEH
// unwind handlers on the way out; Sailfin has none to run.)
//
// Every non-Windows target keeps the one-argument POSIX form, so their IR is
// byte-identical.
fn target_setjmp_symbol(target_os: string) -> string {
    if target_os_is_windows(target_os) { return "_setjmp"; }
    return "setjmp";
}

// The module-scope `declare` for `target_os`'s `setjmp`. On Windows the
// registry's POSIX `declare i32 @setjmp(i8*)` (`runtime_helpers/
// registry_values.sfn`) is left in place and simply goes unreferenced —
// LLVM drops an unused declaration — so the registry needs no target
// threading.
fn target_setjmp_declare(target_os: string) -> string {
    if target_os_is_windows(target_os) {
        return "declare i32 @_setjmp(i8*, i8*)";
    }
    return "declare i32 @setjmp(i8*)";
}

// One `<result_temp> = call i32 @<setjmp>(...)` line saving into
// `jmpbuf_operand` (the `i8*` value text of the jmpbuf pointer).
fn target_setjmp_call_line(target_os: string, result_temp: string, jmpbuf_operand: string) -> string {
    if target_os_is_windows(target_os) {
        return "  " + result_temp + " = call i32 @_setjmp(i8* " + jmpbuf_operand
            + ", i8* null)";
    }
    return "  " + result_temp + " = call i32 @setjmp(i8* " + jmpbuf_operand
        + ")";
}

// Rewrite the runtime capsule's `sfn-sources` list for `target_os`. On
// Windows, five POSIX-only modules are swapped for their Win32 siblings:
// `process.sfn` (posix_spawnp/waitpid) for `platform/process_windows.sfn`,
// `rlimit.sfn` (getrlimit/setrlimit) for `platform/rlimit_windows.sfn`
// (SFN-549 — previously dropped outright, leaving
// `apply_default_mem_limit` unresolved once `windows_stubs.ll` stopped
// linking on the native path), `rand.sfn` (getentropy/`/dev/urandom`) for
// `platform/rand_windows.sfn` (SFN-549, `BCryptGenRandom`), and `tls.sfn`
// (the OpenSSL `SSL_*`/`TLS_*`/`EVP_*` surface) for
// `platform/openssl_absent_windows.sfn` (SFN-549 — the Windows target has
// no OpenSSL to link, so the fail-closed native module replaces it
// rather than the link merely dropping `-lssl -lcrypto` and leaving the
// externs unresolved), and `fs_exec_mode.sfn` (POSIX `X_OK`) for
// `platform/fs_exec_mode_windows.sfn` (SFN-649 — `X_OK` is not a legal
// UCRT `_access` mode and terminates the process via
// `_invalid_parameter_noinfo` -> `__fastfail` instead of returning an
// error; the sibling supplies `F_OK`, the strongest question Windows
// can answer where no execute permission bit exists). Five further
// modules —
// `platform/realpath_windows.sfn`, `platform/clock_windows.sfn`,
// `platform/pthread_windows.sfn`, `platform/popen_windows.sfn`, and
// `platform/mkstemp_windows.sfn` (all SFN-549) — are APPENDED rather than
// swapped, since none has a POSIX `.sfn` module to swap FROM (each backs
// a bare libc/pthreads symbol, not a Sailfin-authored runtime module);
// see the note below the loop. This mirrors the mingw Makefile
// `RUNTIME_MODS` swap and is the extensible seam for the broader MSVC
// exclusion set, finalized empirically against a real native link in
// SFEP-0021 M7. Every other target returns the list unchanged.
//
// `sources` are already runtime-root-resolved absolute paths; match on the
// basename so the manifest-root prefix is irrelevant, and rebuild the
// swapped path from the source's own directory so it stays correctly
// rooted (`<root>/sfn/process.sfn` → `<root>/sfn/platform/process_windows.sfn`).
// `rlimit.sfn`/`rand.sfn`/`tls.sfn`/`fs_exec_mode.sfn` already live in
// `platform/`, so their
// siblings are joined directly onto that same directory rather than
// appending another `platform/` segment.
fn target_condition_runtime_sfn_sources(sources: string[], target_os: string) -> string[] {
    if !target_os_is_windows(target_os) { return sources; }
    let mut out: string[] = [];
    // Anchor for the append block below — the `platform/` directory,
    // discovered from whichever of
    // rlimit.sfn/rand.sfn/tls.sfn/fs_exec_mode.sfn/exec.sfn happens to
    // be present in `sources`, since none of the five is guaranteed by
    // this function's own contract.
    let mut platform_dir: string = "";
    let mut i: int = 0;
    loop {
        if i >= sources.length { break; }
        let src = sources[i];
        let base = _path_basename(src);
        if base == "rlimit.sfn" {
            // Already in platform/ (unlike process.sfn below): the sibling
            // sits next to it, not one level down.
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "rlimit_windows.sfn"));
        } else if base == "process.sfn" {
            out.push(_path_join(_dirname(src), "platform/process_windows.sfn"));
        } else if base == "rand.sfn" {
            // Already in platform/ — same as rlimit.sfn above.
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "rand_windows.sfn"));
        } else if base == "tls.sfn" {
            // Already in platform/ — same as rlimit.sfn/rand.sfn above.
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "openssl_absent_windows.sfn"));
        } else if base == "fs_exec_mode.sfn" {
            // Already in platform/ — same as rlimit.sfn/rand.sfn/tls.sfn.
            // POSIX `X_OK` (1) is not a legal UCRT `_access` mode and
            // fastfails the process rather than returning an error, so
            // the Windows sibling supplies `F_OK` (0) instead (SFN-649).
            platform_dir = _dirname(src);
            out.push(_path_join(platform_dir, "fs_exec_mode_windows.sfn"));
        } else if base == "exec.sfn" {
            // exec.sfn itself is unchanged (its `realpath` extern is
            // satisfied by the appended sibling below, not by swapping
            // exec.sfn out) — captured here only as a fourth possible
            // anchor for platform_dir.
            platform_dir = _dirname(src);
            out.push(src);
        } else { out.push(src); }
        i += 1;
    }
    // `realpath_windows.sfn`, `clock_windows.sfn`, `pthread_windows.sfn`,
    // `popen_windows.sfn`, `mkstemp_windows.sfn`, and
    // `strcasestr_windows.sfn` have no POSIX `.sfn` counterpart to swap
    // FROM (SFN-549): `realpath(3)`, `clock_gettime`/`nanosleep`, the
    // `pthread_*`/`sysconf` surface, `popen`/`pclose`/`mkstemp`, and
    // `strcasestr(3)` are bare libc/pthreads symbols on POSIX, not
    // Sailfin-authored runtime modules, so — unlike the swaps above —
    // these are pure ADDITIONS with nothing in `sources` to replace. Each
    // satisfies its `extern fn` declaration(s) elsewhere in the runtime
    // via ordinary link-time symbol resolution; see each module's own
    // header for the full rationale. Skipped (rather than guessing a
    // path) if none of the four platform/ modules above were present to
    // anchor on.
    if platform_dir.length > 0 {
        out.push(_path_join(platform_dir, "realpath_windows.sfn"));
        out.push(_path_join(platform_dir, "clock_windows.sfn"));
        out.push(_path_join(platform_dir, "pthread_windows.sfn"));
        out.push(_path_join(platform_dir, "popen_windows.sfn"));
        out.push(_path_join(platform_dir, "mkstemp_windows.sfn"));
        out.push(_path_join(platform_dir, "strcasestr_windows.sfn"));
    }
    return out;
}

// A path-safe token for `target_os`, for use in cache-artifact filenames
// (SFN-617). `SAILFIN_TARGET_OS` is an unvalidated environment string, so
// it must never be interpolated into a filesystem path directly; this maps
// it to a closed set of path-safe tokens. Unknown targets collapse to
// `"other"` deliberately — correctness comes from the cache key (the
// runtime-object key fold in `build/runtime_objs.sfn`), which carries the
// raw target, so two unknown targets sharing a filename still mismatch on
// key and recompile rather than cross-link. Note what that means on disk:
// unknown targets SHARE a path and overwrite each other, trading the
// coexistence known targets get for a recompile on every switch. That is
// only sound while `target_clang_triple` returns "" for every non-Windows
// target, which makes their objects byte-identical anyway; the day an
// unknown target contributes clang flags, this bucket needs splitting
// rather than documenting.
fn target_artifact_tag(target_os: string) -> string {
    if target_os == "Windows" { return "windows"; }
    if target_os == "Darwin" { return "darwin"; }
    if target_os == "Linux" { return "linux"; }
    return "other";
}

export {
    build_host_os,
    host_is_windows,
    build_target_os,
    target_os_is_windows,
    target_exe_name,
    target_clang_triple,
    target_clang_flags,
    target_forced_linker_flag,
    target_uses_gnu_link_gc,
    target_filter_link_libs,
    target_extra_link_libs,
    target_setjmp_symbol,
    target_setjmp_declare,
    target_setjmp_call_line,
    target_condition_runtime_sfn_sources,
    target_artifact_tag
};
