// compiler/src/build/paths.sfn
//
// Leaf path/string helpers shared by the build driver (SFEP-0027 §3.1,
// issue #1730). These were private utilities in `cli_main.sfn`; the
// runtime-object extraction (`build/runtime_objs.sfn`) needs them too,
// so they live in this dependency-free leaf module that both
// `cli_main` and `build/runtime_objs` import. Keeping them in a leaf
// (no local imports) breaks what would otherwise be a
// `cli_main <-> build/runtime_objs` mutual import cycle, leaving a
// clean one-directional `cli_main -> build/runtime_objs` DAG that the
// cold self-host build stages without ordering hazards.
//
// Originally a behavior-preserving move: every body arrived verbatim
// from cli_main.sfn. `_path_join`, `_dirname`, and `_path_basename`
// have since diverged — they recognize `\` as a separator alongside
// `/` (SFN-919). Every other body is still verbatim.
//
// `exe_path` is declared here rather than imported: this module's leaf
// property (no local imports) is what breaks the `cli_main <->
// build/runtime_objs` cycle described above, and an `extern fn` costs
// nothing against it. Redeclared per-module per the #306 cross-module
// extern limit, matching `cli/entry.sfn:36`.
extern fn exe_path() -> *u8;

// True iff `ch` is a path separator. Windows accepts `/` and `\`
// interchangeably in every Win32 file API, and `GetModuleFileNameA` —
// which is what `exe_path()` resolves to on Windows — hands back `\`.
// A path reaching this module on Windows therefore routinely carries
// either, or both in one string. Unconditional on host, matching the
// `_rcr_is_sep` precedent (`runtime_capsule_resolver.sfn`, SFN-642):
// this module is a dependency-free leaf (see the header note), so it
// cannot import `host_is_windows()` from `build/target.sfn` without
// reintroducing the `cli_main <-> build/runtime_objs` cycle (SFN-919).
fn _is_path_sep(ch: string) -> boolean { return ch == "/" || ch == "\\"; }

// Compare two paths for equality, treating `/` and `\` as the same
// separator.
//
// Not the load-bearing half of SFN-919 — that is `_is_path_sep` in
// `_dirname` below. On the primary path the two sides already agree
// byte for byte: `binary_dir` is produced by the runtime's own
// `binary_dir()` (`runtime/sfn/platform/exec.sfn:177`), which scans
// for both separators too, so it and `_dirname(exe_path())` cut the
// same string at the same index.
//
// This guards the case where `binary_dir` did not come from there —
// an externally supplied `--binary-dir`, which reaches
// `_resolve_self_path` verbatim (`cli/context.sfn:71`) and may spell
// its separators however the caller pleased. A raw string compare
// would fail such a path on spelling alone.
//
// Known limitation, deliberate: this compares length-first, so a
// trailing separator on one side is still unequal. No in-tree
// producer emits one (`exec.sfn:205` cuts before the separator), and
// normalizing here would make the function silently accept paths that
// are not the same string for reasons unrelated to spelling.
fn _paths_equal_ignoring_sep(a: string, b: string) -> boolean {
    if a.length != b.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= a.length { break; }
        let ca = a[i];
        let cb = b[i];
        if ca != cb {
            if !_is_path_sep(ca) { return false; }
            if !_is_path_sep(cb) { return false; }
        }
        i += 1;
    }
    return true;
}

// Deliberately does NOT carry the bare-drive-root carve-out its
// `_rcr_path_join` sibling has (`runtime_capsule_resolver.sfn`,
// SFN-642), which distinguishes `C:sfn` (cwd on drive C) from `C:/sfn`
// (drive root). Nothing here can produce a bare `C:` base: the only
// `binary_dir` producer cuts before the final separator
// (`runtime/sfn/platform/exec.sfn:205`), so a drive-root binary
// arrives as `C:/` or `C:\`, never `C:`. Importing the rule on
// speculation would add an untested branch; if a real caller ever
// yields a bare drive root, take the sibling's version wholesale
// rather than reinventing it here.
fn _path_join(base: string, name: string) -> string {
    if base.length == 0 { return name; }
    if _is_path_sep(base[base.length - 1]) { return base + name; }
    return base + "/" + name;
}

fn _dirname(path: string) -> string {
    let mut last_slash: int = -1;
    let mut index: int = 0;
    loop {
        if index >= path.length { break; }
        if _is_path_sep(path[index]) { last_slash = index; }
        index += 1;
    }
    if last_slash < 0 { return "."; }
    // Preserve the separator the caller actually used, so a Windows
    // root keeps its `\` spelling rather than being rewritten to `/`.
    if last_slash == 0 { return substring(path, 0, 1); }
    return substring(path, 0, last_slash);
}

fn _path_basename(path: string) -> string {
    let mut last_slash: int = -1;
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if _is_path_sep(path[i]) { last_slash = i; }
        i += 1;
    }
    if last_slash < 0 { return path; }
    return substring(path, last_slash + 1, path.length);
}

fn _find_substring_from(haystack: string, needle: string, from: int) -> int {
    if needle.length == 0 { return from; }
    if from < 0 { return -1; }
    if from > haystack.length { return -1; }
    let limit = haystack.length - needle.length;
    if from > limit { return -1; }
    let mut i: int = from;
    loop {
        if i > limit { break; }
        let mut j: int = 0;
        let mut matches: boolean = true;
        loop {
            if j >= needle.length { break; }
            if haystack[i + j] != needle[j] {
                matches = false;
                break;
            }
            j += 1;
        }
        if matches { return i; }
        i += 1;
    }
    return -1;
}

fn _ensure_dir(path: string) ![io] {
    // best-effort; ignore false.
    fs.createDirectory(path, true);
}

fn _read_import_deps(context_root: string, slug: string) -> string[] ![io] {
    let mut out: string[] = [];
    let deps_path = context_root + "/" + slug + ".import-deps";
    if !fs.exists(deps_path) { return out; }
    let content = fs.readFile(deps_path);
    let mut pos: int = 0;
    loop {
        if pos >= content.length { break; }
        let nl = _find_substring_from(content, "\n", pos);
        let mut end = content.length;
        if nl >= 0 { end = nl; }
        let line = substring(content, pos, end);
        if line.length > 0 { out.push(line); }
        if nl < 0 { break; }
        pos = nl + 1;
    }
    return out;
}

fn _ends_with(value: string, suffix: string) -> boolean {
    if suffix.length == 0 { return true; }
    if value.length < suffix.length { return false; }
    let start = value.length - suffix.length;
    return substring(value, start, value.length) == suffix;
}

fn _resolve_self_path(binary_dir: string) -> string ![io] {
    if binary_dir.length > 0 {
        // Try each known compiler-binary name in order. The bare
        // `sailfin` / `sfn` names cover the dev-tree and installed
        // POSIX layouts; the `.exe`-suffixed variants cover native
        // Windows, where `GetModuleFileNameA` resolves the running
        // binary as `sailfin.exe` and the suffixless join would miss
        // it (#1482, epic #1485 M2). The Windows variants never match
        // on POSIX (no such file), so the ordering is host-neutral.
        // Probe the canonical name before legacy `sailfin`. A POSIX
        // directory with search permission satisfies access(X_OK), and
        // self-host work roots contain exactly such a `sailfin` cache
        // directory beside the published `sfn` binary (SFN-579).
        // The `!fs.is_directory` guard is load-bearing, not defensive
        // filler: `fs.is_executable` is `_access(path, 0)` on Windows
        // (SFN-649) — identical to `fs.exists`, so it cannot itself tell
        // a file from a directory — and a self-host work root's `sailfin`
        // cache directory sits right beside the published `sfn` binary
        // (the SFN-579 note above). Without this guard, a probe order
        // that reaches `sailfin` before it reaches a real executable
        // would return that directory, and every isolated-emit child
        // spawned against it would fail exactly like the fabricated
        // path this function replaces (SFN-904).
        let names: string[] = ["sfn", "sfn.exe", "sailfin", "sailfin.exe"];
        let mut i: int = 0;
        loop {
            if i >= names.length { break; }
            let candidate = _path_join(binary_dir, names[i]);
            if fs.is_executable(candidate) {
                if !fs.is_directory(candidate) { return candidate; }
            }
            i += 1;
        }
        // SFN-904 last resort: the name probe above only knows the four
        // canonical spellings, so it finds nothing when the running
        // compiler is named anything else — `build/sailfin/program` (the
        // output of `sfn build -p compiler`) being the case that motivated
        // this. When the directory being asked about IS the running
        // binary's own directory, no probing is needed: `exe_path()` names
        // the exact file that answered this invocation.
        //
        // The dirname equality guard is what keeps this honest. This
        // function answers "which compiler lives in `binary_dir`", and for
        // some other directory the running binary is not the answer —
        // returning it there would swap a fabricated path for a plausible
        // wrong one, which is harder to notice.
        //
        // `exe_path()` resolves on every host via the
        // `sailfin_intrinsic_exe_path` sentinel (#967) — `readlink` on
        // Linux, `_NSGetExecutablePath` on Darwin, `GetModuleFileNameA` on
        // Windows — and returns "" only when the host lookup genuinely
        // fails, which falls through to the same "" as before.
        // (`cli/entry.sfn:105` still claims macOS/Windows return "";
        // that comment is stale, contradicted by `:200` in its own file.)
        let self_raw: *u8 = exe_path();
        let self_str: string = self_raw as string;
        if self_str.length > 0 {
            if _paths_equal_ignoring_sep(_dirname(self_str), binary_dir) {
                if fs.is_executable(self_str) {
                    if !fs.is_directory(self_str) { return self_str; }
                }
            }
        }
    }
    return "";
}

export {
    _dirname,
    _ends_with,
    _ensure_dir,
    _find_substring_from,
    _is_path_sep,
    _path_basename,
    _path_join,
    _paths_equal_ignoring_sep,
    _read_import_deps,
    _resolve_self_path
};
