// compiler/src/build/runtime_selection.sfn
//
// SFN-882: demand-driven runtime `sfn-sources` selection.
//
// `runtime/capsule.toml` declares every runtime module unconditionally, so a
// `print`-only hello-world compiled the whole TLS 1.3 stack — 69 staged
// modules, 38 of them the `sfn/crypto` capsule, for a program that cannot
// reach a socket. This module narrows that set to what the build's declared
// effect surface actually demands.
//
// The demand set is computed ONCE, at resolution, and threaded to all three
// consumers (SFEP-0070 §3.5 layer 2 is the governing precedent). It is never
// recomputed per consumer, because the three consumers sit in two different
// phases — root seeding runs in the resolver before emission, dep staging and
// the link run in the driver after it — and a signal recomputed independently
// in each would be free to disagree.
//
// FAIL-OPEN IS THE INVARIANT. The failure mode of an over-narrow selection is
// an undefined symbol at link, so every uncertain case must widen:
//
//   - The selector may only ever REMOVE sources. It never adds one and never
//     reorders. `select_runtime_sfn_sources(caps, ["*"])` is the identity.
//   - A source named in no gate is retained.
//   - A gate key that is not a canonical effect is never read, so its sources
//     are retained (`_rcr_resolve_source_gates` only consults the canonical
//     six).
//   - A source that is ABSENT during the demand scan escalates the whole build
//     to `"*"` rather than contributing nothing. This is the one place this
//     module is deliberately stricter than the reachability filter it otherwise
//     mirrors: there, a missed edge costs a retained module; here, a missed
//     effect annotation costs a link.
//
//     The residual, stated rather than papered over: the escalation triggers on
//     `fs.exists`, not on read failure. A file that exists but cannot be read
//     (permissions, an I/O error, a directory) yields `""` and is
//     indistinguishable from a genuinely empty source, so it contributes no
//     tokens and the build proceeds narrowed. Closing this needs a `readFile`
//     that reports failure distinctly from empty content; until then the gap is
//     bounded to sources that pass an existence check and then fail to read.
//
// There is deliberately no `fault` mode. The reachability filter needs one
// because it has a closure invariant to violate; this selector has no fixed
// point to verify — its output is a direct function of a declared table.
import { effect_root } from "sfn/analyzer/effect_taxonomy";
import { int_to_string } from "sfn/strings";

import { _env_flag, _get_env_cmd } from "../build_flags";
import { collect_effect_tokens, collect_scoped_import_specs } from "../capsule_import_scan";
import { RuntimeCapsuleArtifacts } from "../runtime_capsule_resolver";
import { contains_string, substring } from "../string_utils";

// The retain-everything sentinel. A demand set containing it makes every
// selection an identity — the pre-SFN-882 behaviour, exactly.
let _RS_ALL: string = "*";

fn runtime_demand_all() -> string[] { return [_RS_ALL]; }

fn runtime_demand_is_all(demand: string[]) -> boolean {
    return contains_string(demand, _RS_ALL);
}

// `SAILFIN_RUNTIME_SOURCE_GATES=off` (also `0` / `false`) forces `"*"`,
// reproducing today's artifact set exactly. This is the bisect handle — the
// same shape as `SAILFIN_CAPSULE_FILTER` for the reachability filter. Anyone
// debugging a suspected undefined-symbol regression sets this first; if it goes
// away, the gate table is the cause and the trace toggle says which source.
fn runtime_source_gates_disabled() -> boolean ![io] {
    let raw = _get_env_cmd("SAILFIN_RUNTIME_SOURCE_GATES");
    if raw.length == 0 { return false; }
    if raw == "off" { return true; }
    if raw == "0" { return true; }
    return raw == "false";
}

fn runtime_gates_trace_enabled() -> boolean ![io] {
    return _env_flag("SAILFIN_TRACE_RUNTIME_GATES");
}

// The gate effect governing `src`, or `""` when the source is ungated.
// `gates` are `"<effect>\t<absolute-path>"` records built by
// `_rcr_resolve_source_gates` at manifest-parse time, so both sides of the
// comparison are already absolute and normalized.
fn runtime_source_gate_effect(gates: string[], src: string) -> string {
    let mut i: int = 0;
    loop {
        if i >= gates.length { break; }
        let record = gates[i];
        let mut tab: int = -1;
        let mut scan: int = 0;
        loop {
            if scan >= record.length { break; }
            if record[scan] == "\t" {
                tab = scan;
                break;
            }
            scan += 1;
        }
        if tab > 0 {
            if substring(record, tab + 1, record.length) == src {
                return substring(record, 0, tab);
            }
        }
        i += 1;
    }
    return "";
}

// Retention rule, in order: `"*"` retains; an ungated source retains; a gated
// source retains iff its gate effect is demanded; otherwise drop.
fn _rs_retains(gates: string[], demand: string[], src: string) -> boolean {
    if runtime_demand_is_all(demand) { return true; }
    let gate = runtime_source_gate_effect(gates, src);
    if gate.length == 0 { return true; }
    return contains_string(demand, gate);
}

// Rebuild each capsule with `sfn_sources` narrowed; every other field passes
// through untouched, `sfn_source_gates` included — the table stays available to
// downstream consumers that re-select after target conditioning.
fn select_runtime_sfn_sources(caps: RuntimeCapsuleArtifacts[], demand: string[]) -> RuntimeCapsuleArtifacts[] {
    if runtime_demand_is_all(demand) { return caps; }
    let mut out: RuntimeCapsuleArtifacts[] = [];
    let mut i: int = 0;
    loop {
        if i >= caps.length { break; }
        let c = caps[i];
        let mut kept: string[] = [];
        let mut s: int = 0;
        loop {
            if s >= c.sfn_sources.length { break; }
            if _rs_retains(c.sfn_source_gates, demand, c.sfn_sources[s]) {
                kept.push(c.sfn_sources[s]);
            }
            s += 1;
        }
        out.push(RuntimeCapsuleArtifacts {
            capsule_name: c.capsule_name, manifest_dir: c.manifest_dir, c_sources: c.c_sources, ll_sources: c.ll_sources, sfn_sources: kept, include_dirs: c.include_dirs, link_libs: c.link_libs, prelude_entry: c.prelude_entry, capsule_deps: c.capsule_deps, sfn_source_gates: c.sfn_source_gates
        });
        i += 1;
    }
    return out;
}

// Fold one source's `![ ... ]` annotations into `demand`.
//
// Every token is normalized through `effect_root` before it is recorded, which
// is load-bearing and NOT what a first reading of the gate table suggests: the
// `net`-rooted intrinsics are declared as sub-effects — `http.get` requires
// `![net.http]` and `websocket.*` require `![net.ws]` (SFEP-0017 D1) — and only
// `serve` requires bare `![net]`. Matching gate keys against raw tokens would
// miss `net.http` entirely, close the `net` gate on a program that calls
// `http.get`, and fail the link with an undefined `sfn_http_get`.
fn _rs_absorb_tokens(demand: string[], source_text: string) -> string[] {
    let mut out = demand;
    let tokens = collect_effect_tokens(source_text);
    let mut i: int = 0;
    loop {
        if i >= tokens.length { break; }
        let root = effect_root(tokens[i]);
        if root.length > 0 {
            if !contains_string(out, root) { out.push(root); }
        }
        i += 1;
    }
    return out;
}

// The build's demand set: canonical effect roots, or the `"*"` sentinel.
//
// `source_paths` is the UNFILTERED deduped set plus the entry paths. Scanning
// the filtered closure would be circular — the closure depends on the runtime
// roots, which depend on the demand set — so one pass over the unfiltered set
// breaks the cycle at the cost of over-approximating. That over-approximation
// measures at zero on the sets that actually appear in a hello-world or e2e
// test build (`sfn/crypto`, `sfn/strings`, `sfn/test` declare no `net`).
//
// Takes plain paths rather than the resolver's `CapsuleSource[]` deliberately:
// this module sits under `build/` and the resolver imports it, so taking a
// resolver type here would close an import cycle.
//
// Returns `"*"` on `full_runtime`, on the env kill-switch, or on any source it
// cannot read — see the fail-open note in this module's header for why an
// unreadable source escalates instead of contributing nothing.
fn compute_runtime_demand(source_paths: string[], capabilities_required: string[], full_runtime: boolean) -> string[] ![io] {
    if full_runtime { return runtime_demand_all(); }
    if runtime_source_gates_disabled() { return runtime_demand_all(); }
    let mut demand: string[] = [];
    let mut c: int = 0;
    loop {
        if c >= capabilities_required.length { break; }
        let root = effect_root(capabilities_required[c]);
        if root.length > 0 {
            if !contains_string(demand, root) { demand.push(root); }
        }
        c += 1;
    }
    let mut i: int = 0;
    loop {
        if i >= source_paths.length { break; }
        let path = source_paths[i];
        i += 1;
        if path.length == 0 { continue; }
        if !fs.exists(path) { return runtime_demand_all(); }
        demand = _rs_absorb_tokens(demand, fs.readFile(path));
    }
    if runtime_gates_trace_enabled() {
        let mut line: string = "[runtime-gates] demand:";
        let mut d: int = 0;
        loop {
            if d >= demand.length { break; }
            line = line + " " + demand[d];
            d += 1;
        }
        print.err(line + " (scanned " + int_to_string(source_paths.length)
            + " sources)");
    }
    return demand;
}

// Every scoped-import spec appearing in the SELECTED sources of `caps`.
//
// One function serves two callers by construction: the dep-capsule staging loop
// (which must not stage a capsule no selected source imports) and the link
// contract (which must not require one to reach the link). Those two decisions
// have to agree — a staging pass that skips `sfn/crypto` while the contract
// still demands it fails every gated build before the backend runs — so they
// read the same answer rather than deriving it twice.
fn runtime_demanded_dep_specs(caps: RuntimeCapsuleArtifacts[]) -> string[] ![io] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= caps.length { break; }
        let c = caps[i];
        let mut s: int = 0;
        loop {
            if s >= c.sfn_sources.length { break; }
            let path = c.sfn_sources[s];
            s += 1;
            if !fs.exists(path) { continue; }
            let text = fs.readFile(path);
            let specs = collect_scoped_import_specs(text);
            let mut k: int = 0;
            loop {
                if k >= specs.length { break; }
                if !contains_string(out, specs[k]) {
                    out.push(specs[k]);
                }
                k += 1;
            }
        }
        i += 1;
    }
    return out;
}
