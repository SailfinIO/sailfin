import { parse_native_imports_for_import } from "sfn/ir";
import { int_to_string } from "sfn/strings";

// compiler/src/build/runtime_objs.sfn
//
// Runtime-object compile/cache orchestration extracted from
// cli_main.sfn (SFEP-0027 §3.1, issue #1730). Behavior-preserving
// move: bodies are verbatim; this module is pure `![io]` build-driver
// orchestration (no fixups, no post-processing of compiler output).
import {
    CacheStats,
    cache_compiler_identity,
    cache_copy_artifact_to,
    cache_lookup_artifact,
    cache_store_artifact,
    empty_cache_stats,
    merge_cache_stats,
    runtime_object_cache_key,
    runtime_object_cache_key_with_identity,
    runtime_object_entry_key_from_str
} from "../build_cache";
import { _env_flag } from "../build_flags";
import { ParallelProcessTask, _cr_resolve_jobs, _cr_run_bounded_processes } from "../capsule_emit_parallel";
import { locate_runtime_dep_capsule_src } from "../capsule_resolver/locate";
import {
    SourceIdentityOwner,
    module_name_from_path,
    source_identity_for,
    source_role_library,
    source_role_runtime_provider
} from "../module_paths";
import { RuntimeCapsuleArtifacts, RuntimeTargetArtifacts } from "../runtime_capsule_resolver";
import { contains_string } from "../string_utils";
import { resolve_compiler_version } from "../version";
import { llvm_assemble, llvm_assemble_argv } from "./clang_argv";
import {
    _atomic_rename_into_place,
    _collect_sfn_files_cmd,
    _mktemp_sibling_cmd,
    _sha256_of_file
} from "./fs";
import { sha256_hex_of_string } from "./hash";
import {
    _dirname,
    _ensure_dir,
    _find_substring_from,
    _path_basename,
    _path_join,
    _read_import_deps,
    _resolve_self_path
} from "./paths";
import { runtime_demanded_dep_specs } from "./runtime_selection";
// Target conditioning (SFN-52, SFEP-0021 §4.2(A)): both Windows ABIs select
// their runtime providers from `runtime/capsule.toml [targets.<triple>]`.
// Identity off Windows, so Linux/macOS link inputs are byte-identical.
import {
    build_target_os,
    build_target_triple,
    target_artifact_tag,
    target_os_is_windows,
    triple_artifact_tags
} from "./target";

// Issue #940: validate the declarative runtime bundle by the
// presence of `<root>/capsule.toml` (the manifest the implicit
// runtime-capsule resolver reads). Previously this probed for a
// Makefile-staged `prelude.o` via `_runtime_prelude_path`; with the
// prelude now emitted from source via the capsule's `prelude-entry`,
// the manifest is the load-bearing artifact, and `_runtime_prelude_path`
// is gone. #822 deleted the C runtime source; #823 deleted the
// `runtime/native/` directory and moved the manifest up to the runtime
// root, so the manifest is the sole bundle anchor (`ll-sources` is now
// empty — there is no `.ll` to probe).
fn _runtime_bundle_exists(root: string) -> boolean ![io] {
    if root.length == 0 { return false; }
    let manifest = _path_join(root, "capsule.toml");
    return fs.exists(manifest);
}

// Stage D PR2: aggregated link-phase inputs from a project's
// `kind = "runtime"` dep capsules. `object_paths` are the cached
// `.o`s the runtime capsule's c-sources / ll-sources compiled
// to; `link_libs` are the linker flags (e.g. `-lm`, `-lpthread`)
// to append after the `.ll` inputs in the final clang invocation.
// `success` is `false` when any clang sub-invocation exited
// non-zero — the caller bails before invoking the final link.
struct RuntimeLinkInputs {
    object_paths: string[];
    link_libs: string[];
    success: boolean;
    // Runtime C/LL/sfn object-cache activity accumulated while
    // compiling this capsule set (#915). Folded into the build-wide
    // `CacheStats` so the end-of-build `[cache]` summary reflects
    // runtime-object hits/misses, not just the `.ll` module cache.
    stats: CacheStats;
}

fn _failed_runtime_link_inputs() -> RuntimeLinkInputs {
    let empty: string[] = [];
    let empty2: string[] = [];
    return RuntimeLinkInputs {
        object_paths: empty,
        link_libs: empty2,
        success: false,
        stats: empty_cache_stats()
    };
}

// Compose a per-capsule cache-key prefix for the runtime-capsule
// `.o` outputs. `"sfn/runtime-native"` → `"sfn__runtime-native__"`;
// the trailing `__` separates the prefix from the source basename
// in the cached object's filename. Empty input returns `""` so
// the legacy hardcoded `_clang_compile_runtime_objects` path
// stays bit-identical when no capsule artifacts are present.
fn _runtime_obj_prefix(capsule_name: string) -> string {
    if capsule_name.length == 0 { return ""; }
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= capsule_name.length { break; }
        let ch = substring(capsule_name, i, i + 1);
        if ch == "/" { out = out + "__"; } else { out = out + ch; }
        i += 1;
    }
    return out + "__";
}

// SFN-617: the single stem composer for a cached runtime object's
// filename. Before this, the stem (`cap_prefix + basename + opt_flag`) was
// recomposed inline at four call sites, and `clean_runtime_object_cache`'s
// own header already warned the derivation there "MIRRORS the compile
// paths ... keep the two in sync" — a drift hazard that is exactly how the
// target identity got dropped for so long. Centralizing here means a
// filename addition (this `target_tag`, or a future one) touches one
// function. `target_tag` sits between the basename and `opt_flag` so a
// path listing still visually clusters same-source objects, e.g.
// `sfn__runtime-native__clock.sfn-linux-O2`.
fn _runtime_obj_stem(cap_prefix: string, src: string, opt_flag: string, target_tag: string) -> string {
    return cap_prefix + _path_basename(src) + "-" + target_tag + opt_flag;
}

// Derive runtime provider identity from its declared physical root and stable
// virtual prefix. Relocating the provider therefore preserves its ABI names.
fn _runtime_module_slug(cap: RuntimeCapsuleArtifacts, src: string) -> string {
    let owner = SourceIdentityOwner {
        manifest_name: cap.capsule_name,
        member_root: cap.manifest_dir,
        source_root: cap.sfn_source_root,
        module_prefix: cap.sfn_module_prefix
    };
    let identity = source_identity_for(src, owner, source_role_runtime_provider());
    if identity.ok { return identity.module_name; }
    // The prelude entry remains outside the declared runtime source root until
    // SFEP-0072's dedicated adoption slice. Route that compatibility entry
    // through the same service with its historical manifest-root role.
    let legacy_owner = SourceIdentityOwner {
        manifest_name: cap.capsule_name,
        member_root: cap.manifest_dir,
        source_root: _dirname(cap.sfn_source_root),
        module_prefix: "runtime"
    };
    let legacy = source_identity_for(src, legacy_owner, source_role_runtime_provider());
    if legacy.ok { return legacy.module_name; }
    return module_name_from_path(src);
}

// Content-addressed cache gate for a runtime object compile (#632).
// A previously-compiled `.o` at `obj_path` may be reused iff the
// object exists AND the sidecar `<obj_path>.key` records a content
// key byte-identical to the current source's key. A content edit
// changes the key (via `runtime_object_cache_key`'s source SHA-256),
// busting the cache and forcing a recompile; a pure mtime touch
// leaves the bytes — hence the key — unchanged, so the cache still
// hits. An empty key (unhashable source) is treated as a miss so a
// hash failure never serves a stale object. Before this gate the
// caller keyed solely on `fs.exists(obj_path)`, which silently
// reused a stale `.o` after any source-content edit.
fn _runtime_obj_cache_hit(obj_path: string, key: string) -> boolean ![io] {
    if key.length == 0 { return false; }
    if !fs.exists(obj_path) { return false; }
    let sidecar = obj_path + ".key";
    if !fs.exists(sidecar) { return false; }
    return fs.readFile(sidecar) == key;
}

// Persist the content key alongside a freshly-compiled `.o` so the
// next build's `_runtime_obj_cache_hit` can validate it. No-op on an
// empty key (the gate already forced an uncached recompile).
fn _runtime_obj_cache_record(obj_path: string, key: string) ![io] {
    if key.length == 0 { return; }
    fs.writeFile(obj_path + ".key", key);
}

// Shared content-addressed cache lookup for a runtime artifact (#1096,
// SFN-861). When the shared cache is enabled (`shared_cache_root`
// non-empty) and holds the artifact for this content key, copy it into
// the work-dir `obj_path`, write the work-dir sidecar so a same-work-dir
// rebuild can fast-path it, and return true (the caller counts a HIT and
// skips the compile/emit). Returns false on a disabled cache, an
// empty/unhashable key, or a miss — leaving the caller to produce it
// fresh. `hash_suffix` is INERT: it reaches `_sha256_of_string`
// (`build_cache.sfn`), whose body is `sha256_hex_of_string(input)` and
// never reads its `unique_suffix` argument — the parameter is retained
// only for signature compatibility with that entry point, not because
// it distinguishes cache entries. `kind` selects the artifact filename
// within the shared entry directory (`runtime-obj` for a compiled `.o`,
// `sfn-asm` for a staged import-context module) so the two layers never
// alias within one entry.
fn _runtime_obj_shared_cache_fetch(shared_cache_root: string, key: string, obj_path: string, hash_suffix: string, kind: string) -> boolean ![io] {
    if shared_cache_root.length == 0 { return false; }
    if key.length == 0 { return false; }
    let ck = runtime_object_entry_key_from_str(key, hash_suffix);
    if !cache_lookup_artifact(shared_cache_root, ck, kind) { return false; }
    if !cache_copy_artifact_to(shared_cache_root, ck, kind, obj_path) {
        return false;
    }
    _runtime_obj_cache_record(obj_path, key);
    return true;
}

// Publish a freshly-produced runtime artifact into the shared
// content-addressed cache so sibling work-dirs and CI cache restores
// can warm-hit it (#1096, SFN-861). No-op when the shared cache is
// disabled or the key is unhashable. A store failure is non-fatal — the
// artifact already exists at `obj_path` for this build's link/emit.
fn _runtime_obj_shared_cache_publish(shared_cache_root: string, key: string, obj_path: string, hash_suffix: string, kind: string) ![io] {
    if shared_cache_root.length == 0 { return; }
    if key.length == 0 { return; }
    let ck = runtime_object_entry_key_from_str(key, hash_suffix);
    cache_store_artifact(shared_cache_root, ck, kind, obj_path);
}

struct PendingRuntimeObjectAssembly {
    cache_key: string;
    cache_suffix: string;
    object_path: string;
    source_kind: string;
    source_path: string;
    staged_path: string;
    task: ParallelProcessTask;
}

// Compile every `c-sources` / `ll-sources` entry from a list of
// `kind = "runtime"` capsule artifacts and return the resulting
// `.o` paths plus the accumulated `link-libs`. Caches `.o` outputs
// under `out_dir` keyed by source content SHA-256 + `opt_flag`
// (#632) so a content edit recompiles while repeat builds skip clang.
//
// Used only when the resolver returns at least one runtime capsule
// artifact (i.e. the project's `[dependencies]` declared a
// `kind = "runtime"` workspace member). For end-user `sfn build`
// without a runtime dep, the caller falls through to the legacy
// `_clang_compile_runtime_objects` helper that uses the
// hardcoded `runtime_root/native/...` layout.
fn _clang_compile_runtime_capsule_objects(runtime_capsules: RuntimeCapsuleArtifacts[], out_dir: string, opt_flag: string, shared_cache_root: string, jobs: int, target_triple: string) -> RuntimeLinkInputs ![io] {
    let target_tag = target_artifact_tag(target_triple);
    let mut objects: string[] = [];
    let mut link_libs: string[] = [];
    let mut pending: PendingRuntimeObjectAssembly[] = [];
    let mut can_parallel: boolean = true;
    // Per-call cache-stat accumulator (#915). Counting mirrors the
    // `.ll` module cache (`capsule_resolver.sfn::_cr_compile_one`): a
    // valid-key reuse is a `hit`; any recompile (the producer ran) is
    // a `miss`; a successful `_runtime_obj_cache_record` is a `store`.
    // An unhashable (empty) key additionally bumps `invalid_keys` —
    // NOT disjoint from `misses`, matching the `.ll` layer where an
    // invalid digest counts as both a miss and an invalid key
    // (`lookup_attempted` stays true while `is_valid_digest` is
    // false). It does not `store`: `_runtime_obj_cache_record` no-ops
    // on an empty key.
    let mut stats = empty_cache_stats();
    let mut i: int = 0;
    loop {
        if i >= runtime_capsules.length { break; }
        let cap = runtime_capsules[i];
        // `-I<dir>` for every include root the capsule declares.
        // Threaded into every c-source compile in this capsule.
        let mut include_flags: string[] = [];
        let mut idi: int = 0;
        loop {
            if idi >= cap.include_dirs.length { break; }
            include_flags.push("-I" + cap.include_dirs[idi]);
            idi += 1;
        }
        // Per-capsule prefix for cached `.o` filenames. Replaces
        // `/` with `__` so the capsule name maps cleanly to a
        // filesystem segment. With this prefix two capsules can
        // declare same-basename sources without colliding (e.g.
        // both shipping a `util.c`).
        let cap_prefix = _runtime_obj_prefix(cap.capsule_name);
        // c-sources: clang -c each, cached by capsule-prefix +
        // full basename (extension included so `foo.c` and
        // `foo.ll` from the same capsule don't collide on the
        // same `.o` output).
        let mut ci: int = 0;
        loop {
            if ci >= cap.c_sources.length { break; }
            let src = cap.c_sources[ci];
            let base = _runtime_obj_stem(cap_prefix, src, opt_flag, target_tag);
            let obj = _path_join(out_dir, base + ".o");
            let key = _runtime_obj_key_with_target(runtime_object_cache_key(src, opt_flag), target_triple);
            if key.length == 0 {
                stats.invalid_keys = stats.invalid_keys + 1;
            }
            if _runtime_obj_cache_hit(obj, key) {
                stats.hits = stats.hits + 1;
            } else if _runtime_obj_shared_cache_fetch(shared_cache_root, key, obj, base, "runtime-obj") {
                stats.hits = stats.hits + 1;
            } else {
                stats.misses = stats.misses + 1;
                // Write to a sibling temp then atomically rename into
                // place (SFN-87, #1726): `out_dir` is a shared, best-effort
                // prewarmed objdir (`SAILFIN_TEST_RUNTIME_OBJDIR`), so a
                // prewarm miss can put two pool children in this branch
                // for the same `obj` concurrently. An in-place write let
                // a torn `.o` reach `_runtime_obj_cache_record`'s `.key`
                // sidecar as if it were complete.
                // An empty temp is the documented no-shell degrade
                // (SFN-478): write in place instead of aborting. Race-free
                // on that path because such a host emits serially
                // (`_cr_resolve_jobs` returns 1).
                let obj_tmp = _mktemp_sibling_cmd(obj);
                let mut obj_target = obj;
                if obj_tmp.length > 0 { obj_target = obj_tmp; }
                if obj_tmp.length == 0 { can_parallel = false; }
                // Per-function/per-datum sections (in `assemble`) let the
                // final link's dead-strip drop unreferenced definitions
                // (#1047). Compilation is queued so c/ll misses share the
                // bounded emit-worker window (SFN-612).
                pending.push(PendingRuntimeObjectAssembly {
                    cache_key: key, cache_suffix: base, object_path: obj, source_kind: "c", source_path: src, staged_path: obj_tmp, task: ParallelProcessTask {
                        argv: llvm_assemble_argv(src, obj_target, opt_flag, include_flags)
                    }
                });
            }
            objects.push(obj);
            ci += 1;
        }
        // ll-sources: assemble each via clang, also cached with
        // the capsule prefix + full basename. `foo.ll` ≠
        // `foo.c` because the basename includes the extension.
        let mut li: int = 0;
        loop {
            if li >= cap.ll_sources.length { break; }
            let src = cap.ll_sources[li];
            let base = _runtime_obj_stem(cap_prefix, src, opt_flag, target_tag);
            let obj = _path_join(out_dir, base + ".o");
            let key = _runtime_obj_key_with_target(runtime_object_cache_key(src, opt_flag), target_triple);
            if key.length == 0 {
                stats.invalid_keys = stats.invalid_keys + 1;
            }
            if _runtime_obj_cache_hit(obj, key) {
                stats.hits = stats.hits + 1;
            } else if _runtime_obj_shared_cache_fetch(shared_cache_root, key, obj, base, "runtime-obj") {
                stats.hits = stats.hits + 1;
            } else {
                stats.misses = stats.misses + 1;
                let no_includes: string[] = [];
                // Sibling temp + atomic rename (SFN-87, #1726) — see the
                // matching c-source branch above for why the shared,
                // best-effort prewarmed objdir needs this.
                let obj_tmp = _mktemp_sibling_cmd(obj);
                let mut obj_target = obj;
                if obj_tmp.length > 0 { obj_target = obj_tmp; }
                if obj_tmp.length == 0 { can_parallel = false; }
                pending.push(PendingRuntimeObjectAssembly {
                    cache_key: key, cache_suffix: base, object_path: obj, source_kind: "ll", source_path: src, staged_path: obj_tmp, task: ParallelProcessTask {
                        argv: llvm_assemble_argv(src, obj_target, opt_flag, no_includes)
                    }
                });
            }
            objects.push(obj);
            li += 1;
        }
        // link-libs flow through verbatim (resolver doesn't
        // path-resolve these — they're linker flags like `-lm`).
        let mut bi: int = 0;
        loop {
            if bi >= cap.link_libs.length { break; }
            link_libs.push(cap.link_libs[bi]);
            bi += 1;
        }
        i += 1;
    }
    let mut effective_jobs = jobs;
    if !can_parallel { effective_jobs = 1; }
    let results = _cr_run_bounded_processes(_runtime_object_tasks(pending), effective_jobs);
    let mut pi: int = 0;
    loop {
        if pi >= pending.length { break; }
        if results[pi] != 0 {
            let item = pending[pi];
            _delete_runtime_object_staging(pending);
            if item.source_kind == "c" {
                print("sfn build: failed to compile runtime c-source " + item.source_path);
            } else {
                print("sfn build: failed to assemble runtime ll-source " + item.source_path);
            }
            return _failed_runtime_link_inputs();
        }
        pi += 1;
    }
    pi = 0;
    loop {
        if pi >= pending.length { break; }
        let item = pending[pi];
        if item.staged_path.length > 0 && !_atomic_rename_into_place(item.staged_path, item.object_path) {
            _delete_runtime_object_staging(pending);
            print("sfn build: failed to stage runtime " + item.source_kind
                + "-source object "
                + item.object_path);
            return _failed_runtime_link_inputs();
        }
        _runtime_obj_cache_record(item.object_path, item.cache_key);
        if item.cache_key.length > 0 {
            stats.stores = stats.stores + 1;
            _runtime_obj_shared_cache_publish(shared_cache_root, item.cache_key, item.object_path, item.cache_suffix, "runtime-obj");
        }
        pi += 1;
    }
    return RuntimeLinkInputs {
        object_paths: objects,
        link_libs: link_libs,
        success: true,
        stats: stats
    };
}

fn _delete_runtime_object_staging(pending: PendingRuntimeObjectAssembly[]) ![io] {
    let mut i: int = 0;
    loop {
        if i >= pending.length { break; }
        if pending[i].staged_path.length > 0 {
            fs.deleteFile(pending[i].staged_path);
        }
        i += 1;
    }
}

fn _runtime_object_tasks(pending: PendingRuntimeObjectAssembly[]) -> ParallelProcessTask[] {
    let mut tasks: ParallelProcessTask[] = [];
    let mut i: int = 0;
    loop {
        if i >= pending.length { break; }
        tasks.push(pending[i].task);
        i += 1;
    }
    return tasks;
}

// ----------------------------------------------------------------
// Invocation-scoped runtime identity stamp (#1996, SFEP-0044 §3-A)
// ----------------------------------------------------------------
// The multi-file test runner's parent warms the runtime objects once
// per invocation, then forks a child per test file. Without the stamp,
// every child re-derives every runtime-object cache key (hashing each
// source + its sibling deps) purely to compare against the `.key`
// sidecar — invocation-constant work repeated per test file. The
// parent instead writes `<objdir>/.runtime-identity.stamp` after a
// successful warm: a `v1` line, the invocation nonce, the folded
// runtime identity, and one `sha256(full key)` per runtime object /
// staged `.sfn-asm`. A child whose `SAILFIN_TEST_RUNTIME_STAMP` env
// nonce matches the stamp's `invocation=` line compares
// `sha256(sidecar)` against the stamped hash instead of re-hashing
// the runtime tree.
//
// Soundness: the stamp supplies only the EXPECTED key hash — the
// on-disk `.key` sidecar compare remains the freshness authority, so
// a corrupt/stale object still misses and recompiles (a stamp can
// cause miss-when-hit-was-possible, never hit-when-stale). The nonce
// closes cross-invocation leakage: a child only trusts a stamp its
// own parent wrote this run (a stale stamp in a reused pinned objdir
// fails the nonce compare and the child falls back to full hashing —
// the pre-stamp behavior). Single-file leaf runs have no parent, no
// nonce env, and are byte-for-byte unchanged.
fn _runtime_stamp_path(objdir: string) -> string {
    return _path_join(objdir, ".runtime-identity.stamp");
}

// Look up one `entry=` value in the stamp, gated on the nonce. Returns
// "" when the stamp is absent, unversioned, nonce-mismatched (or the
// child carries no nonce at all), or the entry is missing — every
// failure mode degrades to the caller's full key computation.
fn _runtime_stamp_value(objdir: string, entry: string) -> string ![io] {
    let nonce = env.get("SAILFIN_TEST_RUNTIME_STAMP");
    if nonce.length == 0 { return ""; }
    let stamp_path = _runtime_stamp_path(objdir);
    if !fs.exists(stamp_path) { return ""; }
    let content = fs.readFile(stamp_path);
    let mut versioned: boolean = false;
    let mut nonce_ok: boolean = false;
    let mut value: string = "";
    let mut pos: int = 0;
    loop {
        if pos >= content.length { break; }
        let nl = _find_substring_from(content, "\n", pos);
        let mut end = content.length;
        if nl >= 0 { end = nl; }
        let line = substring(content, pos, end);
        if pos == 0 {
            if line == "v1" { versioned = true; }
        } else if line.length > 11 && substring(line, 0, 11) == "invocation=" {
            if substring(line, 11, line.length) == nonce { nonce_ok = true; }
        } else {
            let probe = entry + "=";
            if line.length > probe.length && substring(line, 0, probe.length) == probe {
                value = substring(line, probe.length, line.length);
            }
        }
        if nl < 0 { break; }
        pos = nl + 1;
    }
    if !versioned { return ""; }
    if !nonce_ok { return ""; }
    return value;
}

// Exported for `_test_bin_runtime_identity` (cli/commands/test/cache_scratch.sfn):
// the stamped invocation-wide runtime identity, or "" when the stamp
// does not validate for this child.
fn runtime_stamp_identity(objdir: string) -> string ![io] {
    return _runtime_stamp_value(objdir, "identity");
}

// Write the stamp after a successful parent warm. Recomputes each
// runtime object's cache key with EXACTLY the derivation
// `_prepare_runtime_sfn_object` / `_stage_one_runtime_sfn_import_context`
// use (same key functions, same ctx_root, same compiler identity) —
// any drift between the two produces a stamped hash that mismatches
// the sidecar, i.e. a fail-safe cache miss, never a stale hit. The
// second hashing pass over the runtime sources runs once per
// invocation in the parent (page-cache-hot, in-process) — the point is
// that the ~34-source derivation stops running once per CHILD.
// An entry with an unhashable ("") key is simply omitted.
fn write_runtime_identity_stamp(runtime_capsules: RuntimeCapsuleArtifacts[], out_dir: string, opt_flag: string, binary_dir: string, nonce: string, runtime_identity: string, target_triple: string) -> boolean ![io] {
    if nonce.length == 0 { return false; }
    let self_path = _resolve_self_path(binary_dir);
    if self_path.length == 0 { return false; }
    let compiler_identity = cache_compiler_identity(resolve_compiler_version(""), self_path);
    let ctx_root = _runtime_sfn_ctx_root(out_dir);
    let target_tag = target_artifact_tag(target_triple);
    let mut text: string = "v1\ninvocation=" + nonce + "\n";
    if runtime_identity.length > 0 {
        text = text + "identity=" + runtime_identity + "\n";
    }
    let mut ci: int = 0;
    loop {
        if ci >= runtime_capsules.length { break; }
        let cap = runtime_capsules[ci];
        let cap_prefix = _runtime_obj_prefix(cap.capsule_name);
        let mut srcs: string[] = [];
        let mut si: int = 0;
        loop {
            if si >= cap.sfn_sources.length { break; }
            srcs.push(cap.sfn_sources[si]);
            si += 1;
        }
        if cap.prelude_entry.length > 0 { srcs.push(cap.prelude_entry); }
        let mut sj: int = 0;
        loop {
            if sj >= srcs.length { break; }
            let src = srcs[sj];
            let slug = _runtime_module_slug(cap, src);
            let obj_base = _runtime_obj_stem(cap_prefix, src, opt_flag, target_tag)
                + ".o";
            // SFN-870: the slug fold sits inside the target fold, exactly
            // as `_prepare_runtime_sfn_object` composes it. The stamped
            // fast path compares against this hash, so any divergence
            // between the two compositions silently demotes every stamped
            // lookup to a full derivation.
            let obj_key = _runtime_obj_key_with_target(_runtime_obj_key_with_slug(_runtime_obj_key_with_sibling_deps(runtime_object_cache_key_with_identity(src, opt_flag, compiler_identity), ctx_root, slug), slug), target_triple);
            if obj_key.length > 0 {
                text = text + "obj/" + obj_base + "=" + sha256_hex_of_string(obj_key)
                    + "\n";
            }
            // The prelude entry is never staged (#1288), so it has no
            // `.sfn-asm` context entry to stamp.
            if sj < cap.sfn_sources.length {
                let asm_key = runtime_asm_cache_key(src, slug, compiler_identity);
                if asm_key.length > 0 {
                    text = text + "asm/" + slug + "=" + sha256_hex_of_string(asm_key)
                        + "\n";
                }
            }
            sj += 1;
        }
        ci += 1;
    }
    fs.writeFile(_runtime_stamp_path(out_dir), text);
    return fs.exists(_runtime_stamp_path(out_dir));
}

// Stamped-key fast path shared by the `.o` emit and the `.sfn-asm`
// staging: when the stamp validates and carries this entry, a hit is
// `sha256(sidecar) == stamped` — zero source/sibling hashing. Any
// mismatch (or absent artifact/sidecar) returns false and the caller
// runs the full derivation.
fn _runtime_stamp_cache_hit(objdir: string, entry: string, artifact_path: string) -> boolean ![io] {
    let stamped = _runtime_stamp_value(objdir, entry);
    if stamped.length == 0 { return false; }
    if !fs.exists(artifact_path) { return false; }
    let sidecar = artifact_path + ".key";
    if !fs.exists(sidecar) { return false; }
    return sha256_hex_of_string(fs.readFile(sidecar)) == stamped;
}

// Prepared runtime `.sfn` object work. Cache hits are complete plans;
// misses have emitted and published their `.ll`, then carry one staged
// `clang -c` task for the shared bounded pool (SFN-612).
struct RuntimeSfnObjectPlan {
    cache_key: string;
    cache_suffix: string;
    needs_compile: boolean;
    obj_path: string;
    staged_path: string;
    stats: CacheStats;
    task: ParallelProcessTask;
}

// #1288: fold staged sibling-dep content into the runtime object
// cache key. The emitted `.ll`/`.o` of a module with sibling imports
// depends on those siblings' signatures/layouts, so editing a
// sibling (e.g. a future `ownedbuf.sfn`) must bust the cached `.o`
// of every module that imports it — otherwise the link silently
// reuses a stale-ABI object. Modules without a `.import-deps`
// sidecar keep the base key byte-for-byte (the pre-#1288 contract).
// An unhashable dep returns "" so the caller falls back to the
// always-recompile path, mirroring `runtime_object_cache_key`.
fn _runtime_obj_key_with_sibling_deps(base_key: string, ctx_root: string, slug: string) -> string ![io] {
    if base_key.length == 0 { return ""; }
    let deps = _read_import_deps(ctx_root, slug);
    let mut key = base_key;
    let mut i: int = 0;
    loop {
        if i >= deps.length { break; }
        let dep_hash = _sha256_of_file(deps[i]);
        if dep_hash.length == 0 { return ""; }
        key = key + "\n" + dep_hash;
        i += 1;
    }
    return key;
}

// SFN-870: fold the module SLUG into the runtime `.o` cache key. This is
// the `.o`-side twin of `runtime_asm_cache_key`'s `asm1:` fold (SFN-861),
// and closes the gap that fold's comment recorded as still open on this
// key space since #1096.
//
// The object is not a pure function of the source bytes: it is compiled
// from a `.ll` whose symbol names derive from the module slug, emitted in
// turn from a `.sfn-asm` whose first directive is literally `.module
// <slug>` (`_emit_native_state`,
// `compiler/capsules/codegen/src/emit_native.sfn:117-122`). Two
// byte-identical sources built under different slugs therefore produce
// DIFFERENT object bytes while, without this fold, hashing to the SAME
// address — so one module's `.o` could be served for another's link,
// surfacing as a wrong-symbol link or a silently wrong module rather than
// a clean error.
//
// Neither preceding fold closes this. `runtime_object_cache_key_with_identity`
// hashes only source bytes, an opt-flag tag and the compiler identity, and
// `_runtime_obj_key_with_sibling_deps` takes a `slug` argument but spends it
// solely on the `.import-deps` LOOKUP — a module without that sidecar keeps
// the base key byte-for-byte. Nor does the `hash_suffix` the callers thread
// into `_runtime_obj_shared_cache_fetch`/`_publish`, which is inert for the
// reason `runtime_asm_cache_key` records below. The slug only counts when
// it is inside the hashed string.
//
// Callers compose this INSIDE `_runtime_obj_key_with_target`, leaving the
// unvalidated target triple last with nothing after it (see that fold's
// absorption note). Placing the slug immediately before the following
// target component mirrors `cache_key_for` in `build_cache.sfn`, which has
// had that adjacency since SFN-677 introduced its target fold after the
// existing `slug` component (marker `tgt1:` -> `tgt2:` per SFN-774 /
// SFEP-0068 §3.6). Unlike the triple, a slug is derived from repository
// paths by `_runtime_module_slug`, not from the environment.
//
// Adding the component reshapes every `.sfn`-source object key, so
// pre-SFN-870 entries are orphaned rather than mismatched — the same
// no-collision property the `tgt1:` -> `tgt2:` bump relied on. Empty base
// propagates empty, matching the folds either side of it.
fn _runtime_obj_key_with_slug(base_key: string, slug: string) -> string {
    if base_key.length == 0 { return ""; }
    return base_key + "\nobj1:" + slug;
}

// SFN-617: fold the build TARGET into the runtime object cache key. The
// source-content hash `runtime_object_cache_key`/`_with_identity` folds
// cannot see the target any more than they could see the compile flags
// (`secsplit1`), the codegen ABI (`strabi1`), or the compiler identity
// (#1197) — this is the same defect class: an object compiled for one
// target (e.g. Windows COFF) was served to a link for a different target
// (e.g. Linux ELF) because nothing in its identity recorded which target
// produced it. Empty base propagates empty, mirroring
// `_runtime_obj_key_with_sibling_deps`'s always-recompile fallback.
//
// SFN-774 / SFEP-0068 §3.6: the fold moved from `target_os` to the
// TRIPLE, and the marker bumped `tgt1:` -> `tgt2:` so a pre-SFN-774 entry
// (keyed on the coarser OS string) can never collide with a post-SFN-774
// one — a stale entry is orphaned, never mismatched, matching the
// no-bump precedent SFN-677 itself set. The OS-only key could not tell
// an msvc runtime object from a mingw one (both fold to `"Windows"`),
// so a build alternating `--target=x86_64-pc-windows-msvc` and
// `--target=x86_64-w64-mingw32` would silently reuse one ABI's object
// for the other's link — the very defect this fold exists to stop, now
// one axis wider.
//
// SFN-677: `target_triple` goes LAST and nothing follows it. It may
// originate from an unvalidated `SAILFIN_TARGET_TRIPLE`/`SAILFIN_TARGET_OS`
// env string, so anything appended after it can be spelled by a crafted
// value instead. This originally also folded `target_clang_flags(target_os)`
// space-joined behind it, which made `"Windows"` and the literal `"Windows
// -target x86_64-pc-windows-msvc"` produce the same key while compiling to
// different objects — the very cross-target reuse this exists to stop.
// Those flags never added anything beyond what the triple itself already
// determines: `target_clang_flags` is a total function of the triple, so
// appending `f(x)` after `x` cannot separate tuples that `x` does not.
// Every caller composes this fold OUTERMOST, which is what keeps
// `target_triple` last; keep it that way. Should a target-derived input
// ever depend on something NOT derived from the triple, that input must
// be folded in on its own.
// SFN-923: this marker deliberately did NOT bump alongside
// `build_cache.sfn:cache_key_for`'s `tgt2:` -> `tgt3:` move. That module
// key needed the bump because a Windows-keyed entry could hold IR a
// HOST-flavoured emit child actually produced (`emit_child_argv` did not
// exist yet, so the per-module emit subprocess silently ignored the
// parent's resolved target). This runtime-object key is not exposed to
// that failure mode the same way: every runtime `.sfn` emit child already
// received the target via `SAILFIN_TARGET_TRIPLE` injection
// (`_runtime_emit_child_env`, `:818-836`), so a pre-SFN-923 runtime object
// keyed under `tgt2:` was genuinely built for the triple its key records —
// UNLIKE the module-emit poisoning this fix closes. Reachability of a
// mismatch here is additionally low for a non-Windows-msvc target:
// `target_clang_triple` (`./target.sfn`) returns `""` for every non-Windows
// triple, so the pre-fix aarch64-cross-Linux arch defect (§2.2/§5 row 11)
// baked the WRONG arch into a runtime object while still keying it under a
// correct-LOOKING triple string — a real but narrower gap than the module
// key's. A marker bump here WOULD close it: a bump orphans every pre-bump
// entry by changing the hashed input, so the stale entries become
// unreachable regardless of what their triple field reads (the same
// orphan-never-mismatch property `build_cache.sfn:cache_key_for` relies
// on). It is left unbumped on reachability grounds alone: because
// `target_clang_triple` returns `""` for every non-Windows triple, the
// aarch64 and Darwin cross paths were never wired, so the poisoned
// entries are near-unreachable and a second orphan sweep would cost more
// than the residual it clears.
fn _runtime_obj_key_with_target(base_key: string, target_triple: string) -> string {
    if base_key.length == 0 { return ""; }
    return base_key + "\ntgt2:" + target_triple;
}

// SFN-861 review follow-up: fold the module SLUG into the `sfn-asm`
// staging key. The emitted native text's first directive is
// `.module <slug>` (`_emit_native_state`,
// `compiler/capsules/codegen/src/emit_native.sfn:117-122`), so two
// byte-identical sources staged under different slugs (e.g. a
// `runtime/sfn/util.sfn` re-exported into a dep capsule's own
// namespace) produce DIFFERENT artifact bytes but, without this fold,
// hashed to the SAME address — `runtime_object_cache_key_with_identity`
// hashes only source bytes + a flag tag + the compiler identity, never
// the slug the caller passes to name the artifact. The `hash_suffix`
// argument threaded through `_runtime_obj_shared_cache_fetch`/`_publish`
// does NOT close this gap: it reaches `_sha256_of_string`, whose body is
// `sha256_hex_of_string(input)` — the suffix is documented there as
// unused. `asm1:` domain-separates this key space from the `.o` key,
// which carries its own slug fold under `obj1:`
// (`_runtime_obj_key_with_slug`) — the `.o`-side gap this comment
// originally recorded as open (#1096) was closed by SFN-870.
fn runtime_asm_cache_key(src_path: string, slug: string, compiler_identity: string) -> string ![io] {
    let base = runtime_object_cache_key_with_identity(src_path, "", compiler_identity);
    if base.length == 0 { return ""; }
    return base + "\nasm1:" + slug;
}

// SFN-50: the child compiler's environment for a runtime sfn-source
// emit — the parent's full environment (PATH, HOME, the macOS
// SDK/toolchain vars the child's clang/ld need, …) with the four
// build/debug toggles cleared and the legacy-flag-file probe guard
// forced on. This is the argv-array replacement for the former
// `sh -c "SAILFIN_X= … SAILFIN_NO_LEGACY_PROBE=1 <self> emit …"` prefix
// (`sh` is unavailable on native Windows — epic #1485,
// `docs/proposals/windows-native-selfhost.md` §4.2(C)). `run_capture`
// takes the child env explicitly (an empty array is the empty
// environment, never "inherit"), so the parent env is enumerated via
// `process.environ()` and the managed keys are dropped before the
// canonical value is appended. Clearing a toggle is a drop, not a
// `KEY=` empty entry: `_env_flag` (`build_flags.sfn`) reads both an
// unset and an empty var as false, and dropping avoids a duplicate
// `KEY=` pair that POSIX `getenv` (first-match) would otherwise let the
// inherited value shadow.
//
// SFN-774 / SFEP-0068 §3.2: re-externalize the resolved `--target` cell
// for the child. The cell (`build/target_state.sfn`) is process-local
// state, so a child spawned via `run_capture` — which starts a fresh
// process with the explicit env below, not the parent's cell — would
// otherwise resolve the plain host default regardless of what `--target`
// the parent build was given. `SAILFIN_TARGET_TRIPLE` closes that gap:
// the child's OWN `build_target_triple()` reads it ahead of a host probe.
// This is the like-for-like driver-native replacement for the former
// Makefile per-module `SAILFIN_TARGET_OS=Windows` re-emit override. That
// recipe re-exported the target on exactly three modules; here every runtime
// sfn-source emit gets it uniformly. `SAILFIN_TARGET_OS` is ALSO kept in
// the child env
// (not cleared, unlike the four toggles above) so a version-skewed child
// binary that only understands the legacy alias still resolves the
// correct target.
fn _runtime_emit_child_env() -> string[] ![io] {
    let base = process.environ();
    let mut child_env: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= base.length { break; }
        let entry = base[i];
        if !_runtime_env_entry_has_key(entry, "SAILFIN_TRACE_EMIT") && !_runtime_env_entry_has_key(entry, "SAILFIN_SKIP_TYPECHECK")
            && !_runtime_env_entry_has_key(entry, "SAILFIN_TRACE_TEST_RUNNER")
            && !_runtime_env_entry_has_key(entry, "SAILFIN_DUMP_TEST_SOURCES")
            && !_runtime_env_entry_has_key(entry, "SAILFIN_NO_LEGACY_PROBE")
            && !_runtime_env_entry_has_key(entry, "SAILFIN_TARGET_TRIPLE") {
            child_env.push(entry);
        }
        i += 1;
    }
    child_env.push("SAILFIN_NO_LEGACY_PROBE=1");
    child_env.push("SAILFIN_TARGET_TRIPLE=" + build_target_triple());
    return child_env;
}

// True when `entry` ("KEY=VALUE" or a bare "KEY") names exactly `key`.
// Mirrors `cli/commands/test/exec.sfn::_env_entry_has_key`; a private copy
// keeps this build-driver module self-contained (the two share no
// env-utility module).
fn _runtime_env_entry_has_key(entry: string, key: string) -> boolean {
    let klen: int = key.length;
    if entry.length < klen { return false; }
    if !strings_equal(substring(entry, 0, klen), key) { return false; }
    if entry.length == klen { return true; }
    return strings_equal(substring(entry, klen, klen + 1), "=");
}

// SFN-50: re-emit a child emit's captured stdout/stderr on the parent's
// matching stream. The former `sh -c` path let the child inherit the
// parent's stdio, so an emit failure's diagnostics reached the terminal
// directly; `run_capture` stashes them instead, so they are drained and
// re-printed to preserve that visibility. `print` / `print.err` append
// a newline, so one trailing newline is stripped for a byte-faithful
// round-trip; an empty capture prints nothing. Mirrors
// `cli/commands/test/exec.sfn::_emit_captured_stream`.
fn _runtime_emit_captured_stream(text: string, to_stderr: boolean) -> void ![io] {
    if text.length == 0 { return; }
    let mut out = text;
    if substring(out, out.length - 1, out.length) == "\n" {
        out = substring(out, 0, out.length - 1);
    }
    if to_stderr { print.err(out); } else { print(out); }
}

fn _prepare_runtime_sfn_object(self_path: string, cap_prefix: string, src: string, out_dir: string, opt_flag: string, shared_cache_root: string, ctx_root: string, compiler_identity: string, cap: RuntimeCapsuleArtifacts, target_triple: string) -> RuntimeSfnObjectPlan ![io] {
    let mut stats = empty_cache_stats();
    let slug = _runtime_module_slug(cap, src);
    let target_tag = target_artifact_tag(target_triple);
    let stem = _runtime_obj_stem(cap_prefix, src, opt_flag, target_tag);
    let ll_path = _path_join(out_dir, stem + ".ll");
    let obj_path = _path_join(out_dir, stem + ".o");
    // Content-addressed cache (#632 / #969): a previously-emitted
    // `.o` may only be reused when its sidecar `.key` matches the
    // current source content. The prior bare `fs.exists(ll_path)` /
    // `fs.exists(obj_path)` checks silently reused a stale `.o`/`.ll`
    // after the source gained new functions (e.g. #905's
    // `sfn_clock_millis`, #935's `sfn_log_execution` /
    // `sfn_to_debug_string` / `sfn_is_void`), so the freshly-emitted
    // prelude called symbols the stale runtime objects never defined —
    // surfacing as `Undefined symbols ... link failed` (#969). This
    // mirrors the `_clang_compile_runtime_capsule_objects` c-source
    // path so the sfn-source + prelude emit invalidates identically.
    // #1996 / SFEP-0044 §3-A: stamped fast path. When the parent's
    // invocation stamp validates for this child and carries this
    // object's key hash, a sidecar-hash compare replaces the full
    // source + sibling-dep key derivation. Any mismatch falls through
    // to the full derivation below (fail-safe: the sidecar compare in
    // `_runtime_obj_cache_hit` remains the freshness authority).
    if _runtime_stamp_cache_hit(out_dir, "obj/" + stem + ".o", obj_path) {
        stats.hits = stats.hits + 1;
        return _ready_runtime_sfn_object(obj_path, stats);
    }
    // #1197: fold the emitting compiler's identity into the key so a
    // codegen change in `compiler/src` busts the cached runtime object
    // even when the runtime source bytes are unchanged. See
    // `runtime_object_cache_key_with_identity`.
    // SFN-617: the target fold wraps OUTSIDE the sibling-deps fold, same
    // ordering `write_runtime_identity_stamp` uses for its stamped entry.
    // SFN-870: the slug fold sits between them, in that same shared
    // ordering — the stamp writer must compose these identically.
    let key = _runtime_obj_key_with_target(_runtime_obj_key_with_slug(_runtime_obj_key_with_sibling_deps(runtime_object_cache_key_with_identity(src, opt_flag, compiler_identity), ctx_root, slug), slug), target_triple);
    if key.length == 0 { stats.invalid_keys = stats.invalid_keys + 1; }
    let shared_suffix = stem;
    if _runtime_obj_cache_hit(obj_path, key) {
        stats.hits = stats.hits + 1;
        return _ready_runtime_sfn_object(obj_path, stats);
    }
    // Shared content-addressed cache hit (#1096): a sibling work-dir or
    // a CI cache restore may already hold this object even though the
    // local sidecar above missed. Skip the re-emit + clang entirely.
    if _runtime_obj_shared_cache_fetch(shared_cache_root, key, obj_path, shared_suffix, "runtime-obj") {
        stats.hits = stats.hits + 1;
        return _ready_runtime_sfn_object(obj_path, stats);
    }
    stats.misses = stats.misses + 1;
    // Cache miss: regenerate the `.ll` unconditionally (a cached one
    // is stale by definition here), then compile the `.o` and record
    // the key. The child emit spawns shell-free via `run_capture` with
    // an explicit argv and the cleared-toggle child env
    // (`_runtime_emit_child_env`, SFN-50); no argument quoting is needed
    // since no shell tokenizes the argv.
    // #1288: `--import-context` points at the private rt-import-context
    // root. A module with a staged `.import-deps` sidecar threads its
    // sibling sfn-source signatures into the emit
    // (`compile_to_llvm_file_with_module_imports`, #957/#999); a module
    // without one — including the `prelude-entry`, which shares this
    // emit path but is never staged — reads an absent sidecar, gets an
    // empty dep list, and degrades to the exact pre-#1288 legacy emit.
    // Sibling temp + atomic rename for both the `.ll` and the `.o`
    // (SFN-87, #1726): `out_dir` is a shared, best-effort prewarmed
    // objdir (`SAILFIN_TEST_RUNTIME_OBJDIR`), so a prewarm miss can put
    // two pool children in this cache-miss branch for the same source
    // concurrently. Emitting/assembling in place let a torn `.ll`/`.o`
    // reach `_runtime_obj_cache_record`'s `.key` sidecar as if complete.
    // An empty temp is the documented no-shell degrade (SFN-478): emit
    // and assemble directly into the destination rather than aborting.
    let ll_tmp = _mktemp_sibling_cmd(ll_path);
    let mut ll_target = ll_path;
    if ll_tmp.length > 0 { ll_target = ll_tmp; }
    let emit_argv: string[] = [self_path, "emit", "--module-name", slug, "--import-context", ctx_root, "-o", ll_target, "llvm", src];
    let rc = process.run_capture(emit_argv, _runtime_emit_child_env());
    _runtime_emit_captured_stream(process.capture_take_stdout(), false);
    _runtime_emit_captured_stream(process.capture_take_stderr(), true);
    if rc != 0 {
        if ll_tmp.length > 0 { fs.deleteFile(ll_tmp); }
        print("sfn build: failed to emit runtime sfn-source " + src
            + " (child exit="
            + int_to_string(rc)
            + ")");
        return _ready_runtime_sfn_object("", stats);
    }
    if ll_tmp.length > 0 && !_atomic_rename_into_place(ll_tmp, ll_path) {
        print("sfn build: failed to stage runtime sfn-source ir " + ll_path);
        return _ready_runtime_sfn_object("", stats);
    }
    let no_includes: string[] = [];
    let obj_tmp = _mktemp_sibling_cmd(obj_path);
    let mut obj_target = obj_path;
    if obj_tmp.length > 0 { obj_target = obj_tmp; }
    return RuntimeSfnObjectPlan {
        cache_key: key,
        cache_suffix: shared_suffix,
        needs_compile: true,
        obj_path: obj_path,
        staged_path: obj_tmp,
        stats: stats,
        task: ParallelProcessTask {
            argv: llvm_assemble_argv(ll_path, obj_target, opt_flag, no_includes)
        }
    };
}

fn _ready_runtime_sfn_object(obj_path: string, stats: CacheStats) -> RuntimeSfnObjectPlan {
    let no_argv: string[] = [];
    return RuntimeSfnObjectPlan {
        cache_key: "",
        cache_suffix: "",
        needs_compile: false,
        obj_path: obj_path,
        staged_path: "",
        stats: stats,
        task: ParallelProcessTask { argv: no_argv }
    };
}

fn _finish_runtime_sfn_objects(plans: RuntimeSfnObjectPlan[], jobs: int, shared_cache_root: string) -> RuntimeLinkInputs ![io] {
    let mut effective_jobs = jobs;
    let mut can_parallel: boolean = true;
    let mut probe: int = 0;
    loop {
        if probe >= plans.length { break; }
        if plans[probe].needs_compile && plans[probe].staged_path.length == 0 {
            can_parallel = false;
            break;
        }
        probe += 1;
    }
    if !can_parallel { effective_jobs = 1; }
    let results = _cr_run_bounded_processes(_runtime_sfn_object_tasks(plans), effective_jobs);
    let mut objects: string[] = [];
    let empty_libs: string[] = [];
    let mut stats = empty_cache_stats();
    let mut result_index: int = 0;
    let mut i: int = 0;
    loop {
        if i >= plans.length { break; }
        let item = plans[i];
        if item.needs_compile {
            if results[result_index] != 0 {
                _delete_runtime_sfn_object_staging(plans);
                print("sfn build: failed to compile runtime sfn-source object "
                    + item.obj_path);
                return _failed_runtime_link_inputs();
            }
            result_index += 1;
        }
        i += 1;
    }
    result_index = 0;
    i = 0;
    loop {
        if i >= plans.length { break; }
        let item = plans[i];
        stats = merge_cache_stats(stats, item.stats);
        if item.obj_path.length == 0 { return _failed_runtime_link_inputs(); }
        if item.needs_compile {
            if item.staged_path.length > 0 && !_atomic_rename_into_place(item.staged_path, item.obj_path) {
                _delete_runtime_sfn_object_staging(plans);
                print("sfn build: failed to stage runtime sfn-source object "
                    + item.obj_path);
                return _failed_runtime_link_inputs();
            }
            _runtime_obj_cache_record(item.obj_path, item.cache_key);
            if item.cache_key.length > 0 {
                stats.stores = stats.stores + 1;
                _runtime_obj_shared_cache_publish(shared_cache_root, item.cache_key, item.obj_path, item.cache_suffix, "runtime-obj");
            }
            result_index += 1;
        }
        objects.push(item.obj_path);
        i += 1;
    }
    return RuntimeLinkInputs {
        object_paths: objects,
        link_libs: empty_libs,
        success: true,
        stats: stats
    };
}

fn _delete_runtime_sfn_object_staging(plans: RuntimeSfnObjectPlan[]) ![io] {
    let mut i: int = 0;
    loop {
        if i >= plans.length { break; }
        if plans[i].staged_path.length > 0 {
            fs.deleteFile(plans[i].staged_path);
        }
        i += 1;
    }
}

fn _runtime_sfn_object_tasks(plans: RuntimeSfnObjectPlan[]) -> ParallelProcessTask[] {
    let mut tasks: ParallelProcessTask[] = [];
    let mut i: int = 0;
    loop {
        if i >= plans.length { break; }
        if plans[i].needs_compile { tasks.push(plans[i].task); }
        i += 1;
    }
    return tasks;
}

// #1288 (Gap 1 of #1283): root of the PRIVATE import-context tree
// for runtime sfn-source emits, sibling to the runtime `.o` cache
// under `out_dir` (`build/sailfin` by default, work-dir aware).
//
// Deliberately NOT the shared cwd-relative
// `build/compiler/import-context/` tree: artifacts staged there are
// consulted by the driver-owned import-context loader during EVERY emit in
// that cwd. The prelude imports
// the runtime modules (`runtime/prelude.sfn` → `./sfn/array`,
// `./sfn/string`, …), so publishing runtime `.sfn-asm` into the
// shared tree makes the prelude's lowering load those entries and
// render imported-signature `declare`s that conflict with the
// runtime-helper descriptor declares it also emits (e.g.
// `declare i8* @sfn_array_push_string(i8*, i8*)` vs the
// descriptor's `{ i8**, i64, i64 }*` form — clang then rejects the
// IR with "invalid redefinition"). A private root threaded
// explicitly via `--import-context` reaches exactly the sfn-source
// child emits and nothing else.
fn _runtime_sfn_ctx_root(out_dir: string) -> string {
    return _path_join(out_dir, "rt-import-context");
}

// Stage one runtime sfn-source's native `.sfn-asm` into the private
// import-context root so a SIBLING sfn-source importing a
// struct-returning fn (e.g. `string.sfn` → `./memory/ownedbuf`)
// resolves the callee's signature via the #957/#999 threading
// (`--import-context` → `.import-deps` →
// `compile_to_llvm_file_with_module_imports`). This is the
// runtime-emit-path mirror of the resolver's capsule staging; the
// Makefile's #812 loop provides on-disk artifacts for the four
// `runtime/sfn/platform/*` extern modules only, which is why
// `clock.sfn → ./platform/posix` worked while a struct-returning
// sibling import died at `core_call_emission/dispatch.sfn`'s "cannot resolve
// return type" fatal. A pointer/i64-returning callee can be worked
// around with an inline `extern fn`; a struct-by-value return
// cannot (E0805) — staging, not per-module duplication, is the fix.
// No `.layout-manifest` sidecar is needed on this path: the struct
// shape travels inside the threaded native text.
//
// Content-keyed with the #632-style `.key` sidecar so warm builds
// skip the child emit, and published via temp + atomic rename
// (#1011) so a concurrent reader never observes a torn artifact.
// The `native` emit stage is import-context-free by design (#906),
// so staging order across the sfn-sources list does not matter.
fn _stage_one_runtime_sfn_import_context(self_path: string, src: string, slug: string, ctx_root: string, compiler_identity: string, shared_cache_root: string) -> boolean ![io] {
    let asm_path = ctx_root + "/" + slug + ".sfn-asm";
    // #1996 / SFEP-0044 §3-A: stamped fast path — same shape as the
    // `.o` emit hook. The stamp lives in the warm objdir, which is the
    // ctx root's parent (`_runtime_sfn_ctx_root`).
    if _runtime_stamp_cache_hit(_dirname(ctx_root), "asm/" + slug, asm_path) {
        return true;
    }
    // #1197: the staged `.sfn-asm` import-context is emitted by the
    // compiler too, so a codegen change must bust it on the same identity
    // basis as the `.o` emit below — otherwise a stale staged context
    // feeds outdated sibling signatures into `_prepare_runtime_sfn_object`.
    // SFN-861 review follow-up: `runtime_asm_cache_key` (not the bare
    // `_with_identity` key) folds `slug` in, because the emitted native
    // text's `.module <slug>` directive makes the slug part of the
    // artifact's content — see that helper's header for the full defect.
    // Used for BOTH the fetch and the publish below via this one `key`
    // binding so the two addresses can never diverge.
    let key = runtime_asm_cache_key(src, slug, compiler_identity);
    if _runtime_obj_cache_hit(asm_path, key) { return true; }
    // SFN-861 review follow-up: an empty `compiler_identity` is a caller
    // bug (the production caller always resolves a real one), but this
    // function is now on the export surface with no way to enforce that
    // at the call site — defend in-function, mirroring
    // `_cr_resolve_stage_cache_ctx`'s equivalent guard on the capsule
    // staging path (`capsule_resolver/staging.sfn`), which disables its
    // shared-cache context under the same condition. Folding this into
    // one `effective_shared_cache_root` reuses the existing "empty root
    // disables both the fetch and the publish" behavior already built
    // into `_runtime_obj_shared_cache_fetch`/`_publish` rather than
    // adding a second disable path.
    let mut effective_shared_cache_root = shared_cache_root;
    if compiler_identity.length == 0 { effective_shared_cache_root = ""; }
    // SFN-861: the local `.key` sidecar lives NEXT TO `asm_path`, so it
    // only ever hits inside the work dir that staged it — a fresh work
    // dir (the common case: CI runs ~1,285 nested builds each in a fresh
    // scratch dir) misses here on every one of the ~68 runtime sfn-source
    // modules regardless of what the shared cache already holds. Probe it
    // before paying for a child emit, exactly as the capsule staging path
    // does in `_cr_stage_one_outcome`. `slug` is passed as the
    // `hash_suffix` argument here, but that argument is INERT (see
    // `_runtime_obj_shared_cache_fetch`'s header) — it does not fold
    // `slug` into the key. The slug fold that actually matters for
    // correctness lives in `runtime_asm_cache_key` above, in `key`
    // itself.
    if _runtime_obj_shared_cache_fetch(effective_shared_cache_root, key, asm_path, slug, "sfn-asm") {
        // SFN-861 review follow-up: `_cache_atomic_copy`
        // (`build_cache.sfn:823-834`) degrades to a non-atomic copy when
        // `_mktemp_sibling_cmd` returns empty, so an interrupted or
        // disk-full store write under that degrade can leave a truncated
        // `ir.sfn-asm` in the shared store. A restored artifact must be
        // verified non-empty before it is trusted — mirrors the
        // restore-then-verify shape of `_cr_stage_one_outcome`
        // (`capsule_resolver/staging.sfn`), which checks the SAME degrade
        // on its restored `.sfn-asm` before blessing the pair.
        if fs.readFile(asm_path).length > 0 { return true; }
        fs.deleteFile(asm_path);
        fs.deleteFile(asm_path + ".key");
    }
    _ensure_dir(_dirname(asm_path));
    let staged = _mktemp_sibling_cmd(asm_path);
    let mut emit_target: string = asm_path;
    if staged.length > 0 { emit_target = staged; }
    // Same shell-free child-emit contract as `_prepare_runtime_sfn_object`
    // (explicit argv + `_runtime_emit_child_env`, SFN-50; see the
    // race-safety note on `_compile_runtime_sfn_sources`).
    // `--no-resolve-gate` (#906): this is a build-internal per-module
    // NATIVE emit with no import context of its own, so the lowering
    // dry-run gate would falsely reject the very cross-module calls
    // this staging exists to resolve; the build's LLVM emit stage
    // owns fail-closed.
    let emit_argv: string[] = [self_path, "emit", "--module-name", slug, "--no-resolve-gate", "-o", emit_target, "native", src];
    let rc = process.run_capture(emit_argv, _runtime_emit_child_env());
    _runtime_emit_captured_stream(process.capture_take_stdout(), false);
    _runtime_emit_captured_stream(process.capture_take_stderr(), true);
    if rc != 0 {
        print("sfn build: failed to stage runtime sfn-source import-context for "
            + src
            + " (child exit="
            + int_to_string(rc)
            + ")");
        if staged.length > 0 { fs.deleteFile(staged); }
        return false;
    }
    // Empty-output probe, mirroring the Makefile #812 staging's
    // `[ -s "$asm_path" ]` guard.
    let probe = fs.readFile(emit_target);
    if probe.length == 0 {
        print("sfn build: staged runtime sfn-source import-context is empty for "
            + src);
        if staged.length > 0 { fs.deleteFile(staged); }
        return false;
    }
    if staged.length > 0 {
        if !_atomic_rename_into_place(staged, asm_path) {
            print("sfn build: failed to publish runtime sfn-source import-context for "
                + src);
            fs.deleteFile(staged);
            return false;
        }
    }
    _runtime_obj_cache_record(asm_path, key);
    // SFN-861: publish the freshly-staged artifact so a sibling work dir
    // or a warm CI cache restore can skip this emit entirely next time.
    // Best-effort — a store failure never fails the build.
    _runtime_obj_shared_cache_publish(effective_shared_cache_root, key, asm_path, slug, "sfn-asm");
    return true;
}

// Resolve an import's slug against the staged import-context slugs, mirroring
// `resolve_import_provider_module_name`
// (`llvm/lowering/lowering_helpers_mangling.sfn`):
// exact match first, then the `<slug>/mod` entry-module fallback. A bare
// capsule spec (`from "sfn/crypto"`) resolves to the slug `sfn/crypto` while
// the capsule's entry module stages as `sfn/crypto/mod`. Without the fallback
// the dep is dropped from the sidecar with no diagnostic and the emit loses
// the provider's signatures — the sidecar and the mangler must agree on who
// the provider is (SFN-773).
fn _runtime_staged_slug_for_dep(dep_slug: string, staged_slugs: string[]) -> string {
    if dep_slug.length == 0 { return ""; }
    let mut si: int = 0;
    loop {
        if si >= staged_slugs.length { break; }
        if staged_slugs[si] == dep_slug { return dep_slug; }
        si += 1;
    }
    let mod_slug = dep_slug + "/mod";
    let mut mi: int = 0;
    loop {
        if mi >= staged_slugs.length { break; }
        if staged_slugs[mi] == mod_slug { return mod_slug; }
        mi += 1;
    }
    return "";
}

// Expand a staged provider slug into itself plus every staged module
// reachable through its `export … from` chain (SFN-800).
//
// A library capsule's entry module is normally a pure re-export surface —
// `capsules/sfn/crypto/src/mod.sfn` re-exports ~25 siblings and defines
// only a handful of symbols itself. A consumer importing the bare spec
// (`from "sfn/crypto"`) resolves to that surface, so without this walk the
// sidecar records a dependency ONLY on `sfn/crypto/mod.sfn-asm` — whose
// text does not change when the *defining* submodule is edited. The
// consumer's object cache key (`_runtime_obj_key_with_sibling_deps`) then
// stays constant across a provider signature change and the link silently
// reuses a stale-ABI object: exactly the defect class that fold exists to
// prevent (#1288), one re-export hop wide. The same list feeds the
// cross-module effect table (`load_imported_interfaces_from_paths`), so an
// unfollowed chain also under-approximates callee-effect transitivity.
//
// A `.export` with no `from` clause carries an empty module and is dropped
// by `_runtime_staged_slug_for_dep`'s empty guard.
//
// The closure stops at the CAPSULE boundary, not at the re-export chain's
// end: `_runtime_staged_slug_for_dep` only matches `staged_slugs`, and
// `_stage_runtime_sfn_import_context` deliberately does not walk transitive
// capsule deps (see the note on its `capsule_deps` loop). So a provider
// re-exporting from a *different* capsule resolves to an unstaged slug and
// that edge is dropped. Deliberate — widening it means staging the
// transitive dep closure, which is a separate decision — but it does mean
// this closure is complete only within one capsule.
//
// Membership is checked at the PUSH site, so `queue` can never exceed
// `staged_slugs` and the walk terminates on a re-export cycle. `guard` is a
// backstop for that invariant rather than the primary bound (a dequeue-time
// check would let the queue grow to the number of export EDGES, which for a
// wide capsule is O(modules x re-exports) and could silently truncate) — it
// prints rather than truncating in silence, because a truncated closure
// reinstates exactly the stale-object defect this function exists to fix.
fn _runtime_reexport_closure(ctx_root: string, root_slug: string, staged_slugs: string[]) -> string[] ![io] {
    let mut out: string[] = [];
    out.push(root_slug);
    let mut queue_index: int = 0;
    let mut guard: int = 0;
    loop {
        if queue_index >= out.length { break; }
        guard += 1;
        if guard > 4096 {
            print("sfn build: re-export closure for `" + root_slug
                + "` exceeded its guard; the `.import-deps` sidecar may be incomplete");
            break;
        }
        let current = out[queue_index];
        queue_index += 1;
        let current_asm = ctx_root + "/" + current + ".sfn-asm";
        if !fs.exists(current_asm) { continue; }
        let entries = parse_native_imports_for_import(fs.readFile(current_asm));
        let mut entry_index: int = 0;
        loop {
            if entry_index >= entries.length { break; }
            if entries[entry_index].kind == "export" {
                let target = resolve_import_module_slug_for_module(entries[entry_index].module, current);
                let staged = _runtime_staged_slug_for_dep(target, staged_slugs);
                if staged.length > 0 && !_slug_already_staged(out, staged) {
                    out.push(staged);
                }
            }
            entry_index += 1;
        }
    }
    return out;
}

// Write a module's `.import-deps` sidecar (one staged `.sfn-asm`
// path per line — the exact shape `_read_import_deps` parses and the
// resolver's `_cr_stage_import_deps` writes). An import is listed
// when its resolved slug is in `staged_slugs`: a staged sibling
// sfn-source, or (SFN-344) an imported platform extern module staged
// by `_stage_imported_platform_externs` (e.g. `runtime/sfn/clock.sfn`
// -> `./platform/posix` for nanosleep/clock_gettime). A module with
// no such imports gets no sidecar at all — its child emit then
// degrades to the exact pre-#1288 legacy path.
//
// SFN-800: each resolved import expands to its provider's re-export
// closure, not just the provider itself, so a symbol reached through
// `export … from` records the module that DEFINES it. Both consumers of
// this sidecar need that: `_runtime_obj_key_with_sibling_deps` cannot bust
// a consumer's cached `.o` on a provider edit it never hashed, and the
// cross-module effect table (`load_imported_interfaces_from_paths`, via
// `cli/commands/emit.sfn`) cannot enforce callee-effect transitivity for a
// callee whose defining artifact it never loaded.
fn _write_runtime_sfn_import_deps(asm_path: string, slug: string, ctx_root: string, staged_slugs: string[]) -> void ![io] {
    let deps_path = ctx_root + "/" + slug + ".import-deps";
    let asm_text = fs.readFile(asm_path);
    let entries = parse_native_imports_for_import(asm_text);
    // Deduplicated: two imports of the same capsule expand to overlapping
    // re-export closures, and a repeated path would be hashed twice into the
    // consumer's cache key for no added discrimination.
    let mut dep_slugs: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        if entries[i].kind == "import" {
            let dep_slug = resolve_import_module_slug_for_module(entries[i].module, slug);
            let staged = _runtime_staged_slug_for_dep(dep_slug, staged_slugs);
            if staged.length > 0 {
                let closure = _runtime_reexport_closure(ctx_root, staged, staged_slugs);
                let mut ci: int = 0;
                loop {
                    if ci >= closure.length { break; }
                    // A cycle back through the importer would otherwise make
                    // the module its own dep.
                    if closure[ci] != slug && !_slug_already_staged(dep_slugs, closure[ci]) {
                        dep_slugs.push(closure[ci]);
                    }
                    ci += 1;
                }
            }
        }
        i += 1;
    }
    let mut deps: string = "";
    let mut di: int = 0;
    loop {
        if di >= dep_slugs.length { break; }
        deps = deps + ctx_root + "/" + dep_slugs[di] + ".sfn-asm\n";
        di += 1;
    }
    if deps.length == 0 {
        // No sibling imports: drop any stale sidecar from a previous
        // build so the emit can't thread context the module no longer
        // declares.
        if fs.exists(deps_path) { fs.deleteFile(deps_path); }
        return;
    }
    // #1011: a concurrent `--import-context` emit reads this sidecar;
    // publish atomically (temp sibling + rename) so a peer never sees
    // a partial dep list. Mirrors `_cr_stage_import_deps`'s publish,
    // including its plain-write fallback when `mktemp` is unavailable.
    let tmp = _mktemp_sibling_cmd(deps_path);
    if tmp.length == 0 {
        fs.writeFile(deps_path, deps);
        return;
    }
    fs.writeFile(tmp, deps);
    if !_atomic_rename_into_place(tmp, deps_path) {
        print("sfn build: failed to publish runtime sfn-source import-deps for "
            + slug);
        fs.deleteFile(tmp);
    }
}

// Stage import-context artifacts + `.import-deps` sidecars for EVERY
// sfn-source across the runtime capsules before any of them is
// emitted to LLVM. Runs inside `_compile_runtime_sfn_sources` (and
// therefore inside its `SAILFIN_DISABLE_RUNTIME_SFN_SOURCES` gate).
// Fail-closed: a staging failure aborts the link the same way an
// emit failure does — a missing sibling artifact would otherwise
// surface later as the far less actionable "cannot resolve return
// type" fatal in whichever module imports it.
fn _stage_runtime_sfn_import_context(self_path: string, runtime_capsules: RuntimeCapsuleArtifacts[], ctx_root: string, compiler_identity: string, shared_cache_root: string) -> boolean ![io] {
    let mut staged_slugs: string[] = [];
    let mut staged_asm_paths: string[] = [];
    let mut staged_src_paths: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= runtime_capsules.length { break; }
        let cap = runtime_capsules[i];
        let mut si: int = 0;
        loop {
            if si >= cap.sfn_sources.length { break; }
            let src = cap.sfn_sources[si];
            let slug = _runtime_module_slug(cap, src);
            if !_stage_one_runtime_sfn_import_context(self_path, src, slug, ctx_root, compiler_identity, shared_cache_root) {
                return false;
            }
            staged_slugs.push(slug);
            staged_asm_paths.push(ctx_root + "/" + slug + ".sfn-asm");
            staged_src_paths.push(src);
            si += 1;
        }
        i += 1;
    }
    // SFN-773: stage the runtime capsule's declared `[dependencies]` closure.
    // A runtime module importing a capsule provider needs that provider's
    // `.sfn-asm` in this context or its emit cannot resolve the callee's
    // signature — the same reason siblings are staged above.
    //
    // Driven off `capsule_deps` rather than the project's resolved source
    // set: that stages exactly the runtime's own closure by construction, so
    // an unrelated project dependency never pays a staging emit. Transitive
    // deps are deliberately NOT walked — `_stage_one_runtime_sfn_import_context`
    // emits each module standalone under `--no-resolve-gate`, so staging
    // `sfn/crypto` does not require `sfn/strings` staged for it.
    //
    // Fail-closed like every other staging step: a declared dep that cannot
    // be located is a build error here, not a missing signature discovered
    // later as the far less actionable "cannot resolve return type" fatal.
    //
    // SFN-882: narrowing `sfn_sources` alone does not stop this loop — it
    // iterates `capsule_deps`, which is the raw manifest declaration and still
    // names `sfn/crypto` after every one of its importers has been dropped.
    // Skip a dep no SELECTED source imports; that is the intended outcome, not
    // a failure, so it must not trip the fail-closed branch below. The
    // demanded set comes from the same helper the link contract reads, because
    // a staging pass and a contract that disagree about the same capsule
    // present as an unexplained link-contract failure on a correct tree.
    let demanded_specs = runtime_demanded_dep_specs(runtime_capsules);
    let mut ci: int = 0;
    loop {
        if ci >= runtime_capsules.length { break; }
        let cap2 = runtime_capsules[ci];
        ci += 1;
        let mut dsi: int = 0;
        loop {
            if dsi >= cap2.capsule_deps.length { break; }
            let spec = cap2.capsule_deps[dsi];
            dsi += 1;
            if !contains_string(demanded_specs, spec) { continue; }
            let located = locate_runtime_dep_capsule_src(cap2.manifest_dir, spec);
            if located.src_dir.length == 0 {
                print("sfn build: runtime capsule `" + cap2.capsule_name
                    + "` declares dependency `"
                    + spec
                    + "` but its sources were not found next to "
                    + cap2.manifest_dir);
                return false;
            }
            let dep_files = _collect_sfn_files_cmd(located.src_dir, 16);
            let prefix = located.src_dir + "/";
            let mut fi: int = 0;
            loop {
                if fi >= dep_files.length { break; }
                let dep_src = dep_files[fi];
                fi += 1;
                if dep_src.length <= prefix.length { continue; }
                if substring(dep_src, 0, prefix.length) != prefix { continue; }
                let identity = source_identity_for(dep_src, SourceIdentityOwner {
                    manifest_name: spec, member_root: _dirname(located.src_dir), source_root: located.src_dir, module_prefix: ""
                }, source_role_library());
                if !identity.ok { return false; }
                let dep_slug = identity.module_name;
                if !_stage_one_runtime_sfn_import_context(self_path, dep_src, dep_slug, ctx_root, compiler_identity, shared_cache_root) {
                    return false;
                }
                staged_slugs.push(dep_slug);
                staged_asm_paths.push(ctx_root + "/" + dep_slug + ".sfn-asm");
                staged_src_paths.push(dep_src);
            }
        }
    }
    // SFN-344: stage imported platform extern modules (all siblings are
    // staged above, so their `.import` entries are now readable). A
    // runtime sfn-source may import a pure `extern fn` platform module
    // that is not itself an sfn-source — e.g. `runtime/sfn/clock.sfn` ->
    // `./platform/posix` for `nanosleep`/`clock_gettime`. Without staging
    // it here the importer's LLVM emit falls back to the opaque #414
    // descriptor; staging lets it render the source-of-truth signature.
    if !_stage_imported_platform_externs(self_path, staged_src_paths, staged_slugs, staged_asm_paths, ctx_root, compiler_identity, shared_cache_root) {
        return false;
    }
    // Second pass (all siblings + imported platform externs now staged):
    // derive each module's deps from its own `.import` entries.
    let mut di: int = 0;
    loop {
        if di >= staged_slugs.length { break; }
        _write_runtime_sfn_import_deps(staged_asm_paths[di], staged_slugs[di], ctx_root, staged_slugs);
        di += 1;
    }
    return true;
}

// SFN-344: discover and stage the platform extern modules imported by
// the runtime sfn-sources. `staged_slugs` / `staged_asm_paths` grow in
// place so the caller's deps-writing pass lists these modules in the
// importer's `.import-deps` sidecar, and the child `--import-context`
// emit resolves the extern's real return type (e.g. `nanosleep`'s
// `%Timespec*` signature) instead of the opaque #414 descriptor.
//
// The extern module is staged at the slug the deps writer resolves the
// import to (`resolve_import_module_slug_for_module`), not at
// `module_name_from_path` of its source — the two agree for a runtime
// relative import, but staging at the resolved slug keeps them aligned
// even when the source lives in a relocated workspace (the consumer
// e2e).
//
// Fail-closed applies to a DISCOVERED stageable extern: once a
// non-sibling relative import resolves to an existing `.sfn`, a failed
// emit aborts the whole staging pass (return false), exactly like the
// sibling loop. A relative import whose reconstructed source does NOT
// exist is intentionally skipped rather than fataled: `_resolve_relative
// _import_source` yields a candidate path for every relative import, but
// a non-existent one is not a file-backed platform extern to stage here
// (a bare capsule spec — `dep_src == ""` — or a directory/aliased import
// resolved by other staging), so fataling would break legitimate
// non-platform imports. Any genuinely un-stageable extern degrades to
// the retained #414 fallback descriptor, and the consumer e2e asserts
// the canonical `%Timespec*` form so a staging regression fails a test
// rather than passing silently.
fn _stage_imported_platform_externs(self_path: string, staged_src_paths: string[], staged_slugs: string[], staged_asm_paths: string[], ctx_root: string, compiler_identity: string, shared_cache_root: string) -> boolean ![io] {
    let source_count = staged_slugs.length;
    let mut pi: int = 0;
    loop {
        if pi >= source_count { break; }
        let importer_src = staged_src_paths[pi];
        let importer_slug = staged_slugs[pi];
        let asm_text = fs.readFile(staged_asm_paths[pi]);
        let entries = parse_native_imports_for_import(asm_text);
        let mut ei: int = 0;
        loop {
            if ei >= entries.length { break; }
            if entries[ei].kind == "import" {
                let dep_slug = resolve_import_module_slug_for_module(entries[ei].module, importer_slug);
                if dep_slug.length > 0 && !_slug_already_staged(staged_slugs, dep_slug) {
                    let dep_src = _resolve_relative_import_source(importer_src, entries[ei].module);
                    if dep_src.length > 0 && fs.exists(dep_src) {
                        if !_stage_one_runtime_sfn_import_context(self_path, dep_src, dep_slug, ctx_root, compiler_identity, shared_cache_root) {
                            return false;
                        }
                        staged_slugs.push(dep_slug);
                        staged_asm_paths.push(ctx_root + "/" + dep_slug
                            + ".sfn-asm");
                    }
                }
            }
            ei += 1;
        }
        pi += 1;
    }
    return true;
}

fn _slug_already_staged(staged_slugs: string[], slug: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= staged_slugs.length { break; }
        if staged_slugs[i] == slug { return true; }
        i += 1;
    }
    return false;
}

// Resolve a relative import string (`./platform/posix`,
// `../platform/pthread_layout`) against the importing source's
// directory, returning the `.sfn` source path. A non-relative module
// (a bare capsule spec) is not a sibling source and returns "".
fn _resolve_relative_import_source(importer_src: string, module: string) -> string {
    if !_has_prefix(module, "./") {
        if !_has_prefix(module, "../") { return ""; }
    }
    let mut base = _dirname(importer_src);
    let mut rel = module;
    loop {
        if _has_prefix(rel, "./") {
            rel = substring(rel, 2, rel.length);
            continue;
        }
        if _has_prefix(rel, "../") {
            base = _dirname(base);
            rel = substring(rel, 3, rel.length);
            continue;
        }
        break;
    }
    return _path_join(base, rel) + ".sfn";
}

fn _has_prefix(s: string, prefix: string) -> boolean {
    if s.length < prefix.length { return false; }
    return substring(s, 0, prefix.length) == prefix;
}

fn _compile_runtime_sfn_sources(runtime_capsules: RuntimeCapsuleArtifacts[], out_dir: string, opt_flag: string, binary_dir: string, shared_cache_root: string, jobs: int, target_triple: string) -> RuntimeLinkInputs ![io] {
    let mut objects: string[] = [];
    let empty_libs: string[] = [];
    let mut stats = empty_cache_stats();
    if _env_flag("SAILFIN_DISABLE_RUNTIME_SFN_SOURCES") {
        return RuntimeLinkInputs {
            object_paths: objects,
            link_libs: empty_libs,
            success: true,
            stats: stats
        };
    }
    // Quick path: nothing to do if no capsule declares sfn_sources.
    // (`prelude-entry` is handled separately by
    // `assemble_runtime_capsule_link_inputs`, independent of the
    // disable gate above — see #940.)
    let mut has_any: boolean = false;
    let mut probe: int = 0;
    loop {
        if probe >= runtime_capsules.length { break; }
        if runtime_capsules[probe].sfn_sources.length > 0 {
            has_any = true;
            break;
        }
        probe += 1;
    }
    if !has_any {
        return RuntimeLinkInputs {
            object_paths: objects,
            link_libs: empty_libs,
            success: true,
            stats: stats
        };
    }
    let self_path = _resolve_self_path(binary_dir);
    if self_path.length == 0 {
        print("sfn build: cannot resolve self path for runtime sfn-source emit");
        print("           probed sfn/sfn.exe/sailfin/sailfin.exe in, and");
        print("           exe_path() against, binary_dir=\"" + binary_dir + "\"");
        return _failed_runtime_link_inputs();
    }
    // #1197: the emitting compiler's identity, computed once and threaded
    // into every runtime object/import-context cache key so a codegen
    // change busts the cache without a manual `rm`. `self_path` is the
    // binary doing the emit, so its content hash (for `.dirty` stamps) is
    // exactly the right codegen fingerprint; tagged / clean-commit stamps
    // carry the commit hash in the version. Computed once here (not per
    // source) so the binary is hashed at most once per build.
    let compiler_identity = cache_compiler_identity(resolve_compiler_version(""), self_path);
    // #1288: stage every sfn-source's import-context artifacts FIRST
    // so each module's llvm emit below can resolve sibling imports.
    let ctx_root = _runtime_sfn_ctx_root(out_dir);
    if !_stage_runtime_sfn_import_context(self_path, runtime_capsules, ctx_root, compiler_identity, shared_cache_root) {
        return _failed_runtime_link_inputs();
    }
    let mut plans: RuntimeSfnObjectPlan[] = [];
    let mut i: int = 0;
    loop {
        if i >= runtime_capsules.length { break; }
        let cap = runtime_capsules[i];
        let cap_prefix = _runtime_obj_prefix(cap.capsule_name);
        let mut si: int = 0;
        loop {
            if si >= cap.sfn_sources.length { break; }
            let src = cap.sfn_sources[si];
            let plan = _prepare_runtime_sfn_object(self_path, cap_prefix, src, out_dir, opt_flag, shared_cache_root, ctx_root, compiler_identity, cap, target_triple);
            if plan.obj_path.length == 0 {
                _delete_runtime_sfn_object_staging(plans);
                return _failed_runtime_link_inputs();
            }
            plans.push(plan);
            si += 1;
        }
        i += 1;
    }
    return _finish_runtime_sfn_objects(plans, jobs, shared_cache_root);
}

// Issue #940: assemble the full runtime object + link-lib set for a
// resolved runtime capsule (implicit or declared). Compiles the
// capsule's `c-sources` + `ll-sources`, then its `sfn-sources` and
// `prelude-entry` (both via the child-compiler emit path), and
// returns the combined `.o` paths + `link-libs`. `success = false`
// on any clang/emit failure. Shared by the build/run link path
// (`_clang_link_multi_with_opt`) and the `sfn test` link path
// (`cli_commands.sfn::_clang_link_test_cmd_with_deps`, which imports
// this through the `cli_main <-> cli_commands` cycle) so the two
// paths resolve the runtime identically.
// Resolve the manifest-owned artifact set for the exact target triple
// (SFN-775, SFN-777). The `link_libs` POSIX filter is applied once at the
// final link (`LlvmTextBackend.link`), so it covers the `sfn test` link
// layout too. A missing Windows target table fails closed before compilation;
// targets without a matching table retain the base artifact set unchanged.
fn _runtime_target_artifacts(targets: RuntimeTargetArtifacts[], triple: string) -> RuntimeTargetArtifacts {
    let mut i: int = 0;
    loop {
        if i >= targets.length { break; }
        if targets[i].triple == triple { return targets[i]; }
        i += 1;
    }
    let empty: string[] = [];
    let empty2: string[] = [];
    let empty3: string[] = [];
    let empty4: string[] = [];
    let empty5: string[] = [];
    let empty6: string[] = [];
    return RuntimeTargetArtifacts {
        triple: "",
        valid: true,
        sfn_source_replacements: empty,
        sfn_sources_add: empty2,
        sfn_sources_drop: empty3,
        ll_sources_add: empty4,
        link_libs_add: empty5,
        link_libs_drop: empty6
    };
}

fn _runtime_replace_source(src: string, replacements: string[]) -> string {
    let mut i: int = 0;
    loop {
        if i >= replacements.length { break; }
        let record = replacements[i];
        let mut tab: int = -1;
        let mut j: int = 0;
        loop {
            if j >= record.length { break; }
            if substring(record, j, j + 1) == "\t" {
                tab = j;
                break;
            }
            j += 1;
        }
        if tab > 0 && substring(record, 0, tab) == src {
            return substring(record, tab + 1, record.length);
        }
        i += 1;
    }
    return src;
}

fn _runtime_condition_paths(base: string[], replacements: string[], drops: string[], adds: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= base.length { break; }
        let src = _runtime_replace_source(base[i], replacements);
        if !contains_string(drops, src) && !contains_string(out, src) {
            out.push(src);
        }
        i += 1;
    }
    i = 0;
    loop {
        if i >= adds.length { break; }
        if !contains_string(drops, adds[i]) && !contains_string(out, adds[i]) {
            out.push(adds[i]);
        }
        i += 1;
    }
    return out;
}

fn _runtime_condition_values(base: string[], drops: string[], adds: string[]) -> string[] {
    let empty: string[] = [];
    return _runtime_condition_paths(base, empty, drops, adds);
}

fn _condition_runtime_capsules(caps: RuntimeCapsuleArtifacts[], target_os: string, target_triple: string) -> RuntimeCapsuleArtifacts[] {
    let mut out: RuntimeCapsuleArtifacts[] = [];
    let mut i: int = 0;
    loop {
        if i >= caps.length { break; }
        let c = caps[i];
        let target = _runtime_target_artifacts(c.target_artifacts, target_triple);
        let mut sfn_sources = c.sfn_sources;
        let mut ll_sources = c.ll_sources;
        let mut link_libs = c.link_libs;
        if target.triple.length > 0 {
            sfn_sources = _runtime_condition_paths(c.sfn_sources, target.sfn_source_replacements, target.sfn_sources_drop, target.sfn_sources_add);
            let no_replacements: string[] = [];
            let no_drops: string[] = [];
            ll_sources = _runtime_condition_paths(c.ll_sources, no_replacements, no_drops, target.ll_sources_add);
            link_libs = _runtime_condition_values(c.link_libs, target.link_libs_drop, target.link_libs_add);
        } else if target_os_is_windows(target_os) {
            // SFN-777: Windows runtime conditioning is manifest-only. Returning
            // no capsules makes a missing target table fail closed instead of
            // silently compiling the POSIX providers into a Windows binary.
            return [];
        }
        out.push(RuntimeCapsuleArtifacts {
            capsule_name: c.capsule_name, manifest_dir: c.manifest_dir, c_sources: c.c_sources, ll_sources: ll_sources, sfn_sources: sfn_sources, include_dirs: c.include_dirs, link_libs: link_libs, prelude_entry: c.prelude_entry, sfn_source_root: c.sfn_source_root, sfn_module_prefix: c.sfn_module_prefix, capsule_deps: c.capsule_deps, sfn_source_gates: c.sfn_source_gates, target_artifacts: c.target_artifacts
        });
        i += 1;
    }
    return out;
}

// Shared target-conditioning boundary for runtime compilation and every cache
// identity that represents its outputs. Keeping one transformation prevents a
// target replacement/addition or link-lib change from compiling one input set
// while the linked-test cache hashes another.
fn condition_runtime_capsules_for_target(caps: RuntimeCapsuleArtifacts[], target_os: string, target_triple: string) -> RuntimeCapsuleArtifacts[] ![io] {
    let conditioned = _condition_runtime_capsules(caps, target_os, target_triple);
    if target_os_is_windows(target_os) && conditioned.length != caps.length {
        print("sfn build: runtime capsule manifest has no [targets."
            + target_triple
            + "] section");
    }
    return conditioned;
}

fn assemble_runtime_capsule_link_inputs(runtime_capsules: RuntimeCapsuleArtifacts[], out_dir: string, opt_flag: string, binary_dir: string, shared_cache_root: string) -> RuntimeLinkInputs ![io] {
    // SFN-775/SFN-777 (SFEP-0068 §3.3): apply the exact triple's manifest
    // table before any compile iterates the runtime capsule set. A missing
    // Windows table returns a sentinel length mismatch and fails immediately.
    let target_os = build_target_os();
    let target_triple = build_target_triple();
    let capsules = condition_runtime_capsules_for_target(runtime_capsules, target_os, target_triple);
    if capsules.length != runtime_capsules.length {
        return _failed_runtime_link_inputs();
    }
    // One resolution feeds every clang phase, preserving the emit pool's
    // CPU/RAM ceiling and the SAILFIN_BUILD_JOBS=1 bisect path (SFN-612).
    let jobs = _cr_resolve_jobs();
    let inputs = _clang_compile_runtime_capsule_objects(capsules, out_dir, opt_flag, shared_cache_root, jobs, target_triple);
    if !inputs.success { return _failed_runtime_link_inputs(); }
    let mut objects: string[] = inputs.object_paths;
    let mut link_libs: string[] = [];
    let mut lli: int = 0;
    loop {
        if lli >= inputs.link_libs.length { break; }
        link_libs.push(inputs.link_libs[lli]);
        lli += 1;
    }
    // Fold the c-source / ll-source layer's cache stats; the
    // sfn-source and prelude-entry layers merge in below (#915).
    let mut stats = inputs.stats;
    // `sfn-sources` + `prelude-entry` are materialized here (the
    // prelude rides the same emit path as of #940).
    let sfn_inputs = _compile_runtime_sfn_sources(capsules, out_dir, opt_flag, binary_dir, shared_cache_root, jobs, target_triple);
    if !sfn_inputs.success { return _failed_runtime_link_inputs(); }
    stats = merge_cache_stats(stats, sfn_inputs.stats);
    let mut soi: int = 0;
    loop {
        if soi >= sfn_inputs.object_paths.length { break; }
        objects.push(sfn_inputs.object_paths[soi]);
        soi += 1;
    }
    // #940: emit each capsule's `prelude-entry` on the same
    // child-compiler path as `sfn-sources`, but deliberately OUTSIDE
    // `_compile_runtime_sfn_sources` so the prelude is NOT gated by
    // `SAILFIN_DISABLE_RUNTIME_SFN_SOURCES`. The prelude predates the
    // sfn-sources migration and must always link (its `sleep` wrapper
    // emits `@sfn_sleep` unconditionally, etc.); the rollback flag is
    // only meant to short-circuit the migrated runtime modules. The
    // slug resolves to `runtime/prelude` (prefix kept → symbols stay
    // unmangled), matching the Makefile-staged `prelude.o` this
    // replaces. Linked exactly once — the standalone
    // `_runtime_prelude_path` append was removed atomically (Risk R1).
    let mut has_prelude: boolean = false;
    let mut pp: int = 0;
    loop {
        if pp >= capsules.length { break; }
        if capsules[pp].prelude_entry.length > 0 {
            has_prelude = true;
            break;
        }
        pp += 1;
    }
    if has_prelude {
        let self_path = _resolve_self_path(binary_dir);
        if self_path.length == 0 {
            print("sfn build: cannot resolve self path for runtime prelude-entry emit");
            print("           probed sfn/sfn.exe/sailfin/sailfin.exe in, and");
            print("           exe_path() against, binary_dir=\"" + binary_dir
                + "\"");
            return _failed_runtime_link_inputs();
        }
        // #1197: same compiler-identity fold as the sfn-sources emit, so a
        // codegen change busts the cached prelude object too.
        let compiler_identity = cache_compiler_identity(resolve_compiler_version(""), self_path);
        let mut prelude_plans: RuntimeSfnObjectPlan[] = [];
        let mut pi: int = 0;
        loop {
            if pi >= capsules.length { break; }
            let cap = capsules[pi];
            if cap.prelude_entry.length > 0 {
                let cap_prefix = _runtime_obj_prefix(cap.capsule_name);
                // #1288: the prelude is never staged, so it has no
                // `.import-deps` sidecar — the threaded context root
                // is inert here and the prelude keeps its legacy
                // descriptor-based emit byte-for-byte (#940 Risk R2).
                let prelude_plan = _prepare_runtime_sfn_object(self_path, cap_prefix, cap.prelude_entry, out_dir, opt_flag, shared_cache_root, _runtime_sfn_ctx_root(out_dir), compiler_identity, cap, target_triple);
                if prelude_plan.obj_path.length == 0 {
                    _delete_runtime_sfn_object_staging(prelude_plans);
                    return _failed_runtime_link_inputs();
                }
                prelude_plans.push(prelude_plan);
            }
            pi += 1;
        }
        let prelude_inputs = _finish_runtime_sfn_objects(prelude_plans, jobs, shared_cache_root);
        if !prelude_inputs.success { return _failed_runtime_link_inputs(); }
        stats = merge_cache_stats(stats, prelude_inputs.stats);
        let mut poi: int = 0;
        loop {
            if poi >= prelude_inputs.object_paths.length { break; }
            objects.push(prelude_inputs.object_paths[poi]);
            poi += 1;
        }
    }
    return RuntimeLinkInputs {
        object_paths: objects,
        link_libs: link_libs,
        success: true,
        stats: stats
    };
}

// SFN-617/SFN-641: append `path` to the removal argv only when it exists.
// Sweeping the closed target tag set multiplies the candidate list by the
// number of targets, and measured against the real 29-source runtime
// manifest that is 9,202 bytes of argv per tag — 36,808 across four, past
// the 32,767-byte Windows `CreateProcess` lpCommandLine cap SFN-641
// tracks. `rm -f` tolerates a missing path, so the unfiltered form was
// correct but oversized; a tree only ever holds artifacts for the targets
// it actually built, so filtering restores the single-target argv to its
// pre-sweep size instead of 4x while still sweeping every target really
// present. Arrays are reference-semantic here (same in-place growth idiom
// as `_stage_imported_platform_externs`), so this mutates the caller's
// argv directly rather than returning a copy.
fn _push_if_present(argv: string[], path: string) ![io] {
    if !fs.exists(path) { return; }
    argv.push(path);
}

// SFN-14: force a from-scratch runtime-object rebuild for `sfn build
// --clean`. `cache_clean` (`build_cache.sfn`) wipes only the
// content-addressed cache root (`cache_root()` → `build/cache/<schema>`);
// the per-work-dir runtime object cache lives under `out_dir`
// (`build/sailfin/`, or `<work-dir>/sailfin/`), outside that root, so a
// `--clean` build otherwise reused cached runtime `.o`s. This removes
// exactly the runtime artifacts the compile paths write into `out_dir` —
// the `.o`, its content-key `.key` sidecar, and (for the sfn-source /
// prelude-entry emit path) the `.ll` intermediate — leaving `out_dir`'s
// unrelated, shared artifacts (`program.ll`/`.o`, the rt-import-context
// tree) untouched. The filename derivation MIRRORS `_runtime_obj_stem`,
// the single stem composer every compile path now shares; keep the two in
// sync. SFN-617: the stem is now target-tagged, so cleaning only the
// active target's stem would leave a stale other-target object behind;
// the sweep therefore covers `triple_artifact_tags()` (`./target.sfn`) —
// the single source of truth for the closed tag set `target_artifact_tag`
// can produce — rather than a hand-maintained literal that can drift out
// of sync with it (SFN-774: a stale `["linux", "darwin", "windows",
// "other"]` literal silently stopped matching once `target_artifact_tag`
// grew per-arch/per-ABI tags, resurrecting SFN-14).
//
// The sweep is complete on the TARGET axis only. It resolves stems from
// the capsule set as handed in, which the `--clean` call site
// (`cli/commands/build.sfn`) passes unconditioned, so a Windows target's
// swapped-in and appended `platform/*_windows` modules are not named here
// and survive `--clean`; it is likewise `-O2`-only, so the `sfn test`
// link path's `-O0` objects are missed. Both gaps predate the tag sweep
// and are tracked in SFN-678 — do not read this function as a total
// clean until that lands. Scope is otherwise the current runtime source
// set: a source removed since the last build leaves an orphaned `.o`,
// which is inert (never linked, never reused — the link consumes the
// freshly-computed object paths and every reuse is content-key gated).
// `rm -f` is idempotent, so an unpopulated cache is a clean no-op.
fn clean_runtime_object_cache(runtime_capsules: RuntimeCapsuleArtifacts[], out_dir: string, opt_flag: string) ![io] {
    let tags = triple_artifact_tags();
    let mut argv: string[] = ["rm", "-f"];
    let mut i: int = 0;
    loop {
        if i >= runtime_capsules.length { break; }
        let cap = runtime_capsules[i];
        let cap_prefix = _runtime_obj_prefix(cap.capsule_name);
        let mut ti: int = 0;
        loop {
            if ti >= tags.length { break; }
            let tag = tags[ti];
            // c-sources / ll-sources: `.o` + `.key` (no `.ll` intermediate).
            let mut ci: int = 0;
            loop {
                if ci >= cap.c_sources.length { break; }
                let obj = _path_join(out_dir, _runtime_obj_stem(cap_prefix, cap.c_sources[ci], opt_flag, tag)
                    + ".o");
                _push_if_present(argv, obj);
                _push_if_present(argv, obj + ".key");
                ci += 1;
            }
            let mut li: int = 0;
            loop {
                if li >= cap.ll_sources.length { break; }
                let obj = _path_join(out_dir, _runtime_obj_stem(cap_prefix, cap.ll_sources[li], opt_flag, tag)
                    + ".o");
                _push_if_present(argv, obj);
                _push_if_present(argv, obj + ".key");
                li += 1;
            }
            // sfn-sources: `.o` + `.key` + the emitted `.ll` intermediate.
            let mut si: int = 0;
            loop {
                if si >= cap.sfn_sources.length { break; }
                let base = _runtime_obj_stem(cap_prefix, cap.sfn_sources[si], opt_flag, tag);
                _push_if_present(argv, _path_join(out_dir, base + ".o"));
                _push_if_present(argv, _path_join(out_dir, base + ".o.key"));
                _push_if_present(argv, _path_join(out_dir, base + ".ll"));
                si += 1;
            }
            // prelude-entry rides the same sfn emit path (`.o`/`.key`/`.ll`).
            if cap.prelude_entry.length > 0 {
                let base = _runtime_obj_stem(cap_prefix, cap.prelude_entry, opt_flag, tag);
                _push_if_present(argv, _path_join(out_dir, base + ".o"));
                _push_if_present(argv, _path_join(out_dir, base + ".o.key"));
                _push_if_present(argv, _path_join(out_dir, base + ".ll"));
            }
            ti += 1;
        }
        i += 1;
    }
    // No runtime sources resolved → nothing to remove.
    if argv.length <= 2 { return; }
    process.run(argv);
}

export {
    RuntimeLinkInputs,
    RuntimeSfnObjectPlan,
    assemble_runtime_capsule_link_inputs,
    clean_runtime_object_cache,
    condition_runtime_capsules_for_target,
    runtime_stamp_identity,
    write_runtime_identity_stamp,
    _runtime_bundle_exists,
    _runtime_obj_stem,
    _runtime_obj_key_with_target,
    _runtime_obj_key_with_slug,
    _prepare_runtime_sfn_object,
    _stage_one_runtime_sfn_import_context,
    runtime_asm_cache_key
};
