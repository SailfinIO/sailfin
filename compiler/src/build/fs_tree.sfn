// compiler/src/build/fs_tree.sfn
//
// Tree-shaped filesystem composition — the counterpart to `build/fs.sfn`
// (single-file atomic publish + hashing). Everything here composes over
// already-shipped `fs.*` intrinsics; no new extern, builtin, or intrinsic
// sentinel is introduced (SFN-494 groundwork).
//
// Entry classification differs per function, and each documents which
// probe it uses and why:
//
//   * `remove_tree` may delete anything under `path`, so it classifies by
//     attempting `fs.deleteFile` first (only a file/symlink succeeds) and
//     falling back to directory handling — the same shape
//     `_selfhost_remove_tree` (`compiler/src/cli_selfhost.sfn`) already
//     uses. `fs.is_directory` would cost an extra syscall per entry to
//     reach the same outcome, since the `deleteFile` this walk must issue
//     anyway already answers the question.
//   * `remove_empty_dirs_under` must never delete a non-empty directory or
//     a file, so it classifies by attempting `fs.removeDirectory` (which
//     only ever succeeds on an empty directory) and falls back to treating
//     a non-empty `fs.listDirectory` result as "directory with children to
//     explore" — anything left over is a file and is left untouched. Same
//     reasoning as `remove_tree`: the destructive probe is the operation,
//     not an extra cost paid for classification.
//   * `walk_dirs` is read-only, so neither destructive probe is available.
//     It uses `fs.is_directory` (SFN-755's non-destructive
//     `sailfin_intrinsic_fs_is_directory` sentinel, wired to its runtime
//     wrapper in SFN-756) — a single `stat`/`GetFileAttributesA` per
//     entry that answers correctly for an EMPTY directory, which the
//     previous `fs.listDirectory(entry).length > 0` heuristic could not:
//     it reported an empty directory as a file, making it invisible to
//     the walk.
//   * `copy_tree` reads but also writes, and its write is not a
//     classification probe — creating a directory tells you nothing about
//     whether the source was one. So, like `walk_dirs`, it classifies with
//     `fs.is_directory`. Unlike `walk_dirs` the extra `stat` is not a cost
//     paid for correctness at empty directories; it is the only available
//     answer, because neither destructive probe (`fs.deleteFile`,
//     `fs.removeDirectory`) may be pointed at a source tree a copy must
//     leave intact.
//
// Symlinks: `fs.deleteFile` is `unlink(2)`, which removes a
// symlink-to-directory without following it, so `remove_tree`'s deletion
// pass can never escape `path`. `fs.listDirectory` is `opendir`, which DOES
// follow, so `walk_dirs` may report paths reached through a symlink and
// `remove_empty_dirs_under` may `rmdir` an empty directory outside `root`
// — neither of which `find` does without `-L`. `FS_TREE_MAX_DEPTH` is what
// makes a symlink cycle terminate rather than spin.
//
// `copy_tree` DOES NOT PRESERVE SYMLINKS — it copies what they resolve
// to, a real behavioural divergence from `cp -R`, which recreates them as
// links. This is a capability limit rather than a preference: classifying
// an entry needs `fs.is_directory` (`stat`, follows) and enumeration is
// `opendir` (follows), there is no `is_symlink` predicate and no `lstat`,
// and `fs.read_link` (SFN-46) returns `""` for both "not a link" and
// "failed" so it cannot classify either. Link preservation is not
// expressible today. It is benign for the staging trees in scope, which
// contain no links, and is the better answer for a tree destined for a
// tarball, where a relative link would land dangling in the consumer's
// install. A symlink CYCLE terminates on `FS_TREE_MAX_DEPTH`, having
// copied 16 levels of it; cleaning up that partial tree is the caller's
// job (see the failure contract below).
//
// Bounds: every traversal below is iterative (an explicit worklist, never
// recursion), bounded by `FS_TREE_MAX_DEPTH` (16 levels) and
// `FS_TREE_MAX_NODES` (200000 parent directories expanded). The node count
// covers expansions only, so the true syscall ceiling depends on how a
// function classifies: `remove_empty_dirs_under` may issue a second
// `fs.listDirectory` per entry encountered on top of it, while `walk_dirs`
// classifies with a single `fs.is_directory` (`stat`) per entry and
// `remove_tree` with the `fs.deleteFile` it must issue anyway.
// These are not user-source inputs, so hitting a bound is never a panic or
// a `Diagnostic`; it degrades to best-effort.
//
// The degradation is reported where a false success would mislead and
// silent where truncation is safe. `remove_tree` returns `false`, because a
// fabricated `true` would let `cache_clean` claim it wiped a tree that
// survived. `copy_tree` returns `false` on either bound for the same
// reason, and the stakes there are the module's highest: a fabricated
// `true` would let `sfn package` tar a truncated tree and publish it as a
// release artifact. `remove_empty_dirs_under` returns a short count.
// `walk_dirs` truncates silently: a short result set makes its callers do
// strictly less work — `cache_info` under-reports, `cache_prune`
// under-prunes — and neither is unsafe.
//
// A THIRD truncation source is a directory that could not be enumerated
// at all — `EACCES`, fd exhaustion, `ENOMEM`. `fs.listDirectory` reports
// that as `[]`, indistinguishable from a genuinely empty directory, so a
// copy would drain its loop over nothing and report success where `cp -R`
// exits non-zero. `copy_tree` does not inherit that blindness: it re-probes
// an empty listing with `_dir_is_enumerable` and returns `false` when the
// directory will not open (SFN-892). The probe is `opendir`, the call whose
// failure `fs.listDirectory` swallowed in the first place, so it tests the
// real condition rather than approximating it from permission bits.
//
// The destructive walkers never needed the probe: they end on a
// post-condition (`remove_tree`'s `!fs.exists(path)`), and a directory that
// failed to enumerate also fails to `rmdir`, so the answer is already
// `false`. A copy has no post-condition available — its only `true` is
// "the loop drained" — which is why it is the one walker that had to ask.
import { starts_with } from "../string_utils";
import { _copy_file_preserving_mode, _dir_is_enumerable, _dirname_cmd } from "./fs";

let FS_TREE_MAX_DEPTH: int = 16;

let FS_TREE_MAX_NODES: int = 200000;

// The depth-1 directories directly under `dir`.
fn list_child_dirs(dir: string) -> string[] ![io] {
    return walk_dirs(dir, 1, 1);
}

// Directory paths under `root` at depth in `[min_depth, max_depth]`
// inclusive, where `root` itself is depth 0. Order need not match `find`'s.
// Returns `[]` if `root` does not exist. An empty directory IS visible
// (SFN-756); see the module header for the classification probe.
fn walk_dirs(root: string, min_depth: int, max_depth: int) -> string[] ![io] {
    let mut results: string[] = [];
    if !fs.exists(root) { return results; }
    // Clamped so the depth bound is enforced by the single loop condition
    // below rather than by a second check that could drift from it.
    let mut effective_max = max_depth;
    if effective_max > FS_TREE_MAX_DEPTH { effective_max = FS_TREE_MAX_DEPTH; }
    if 0 >= min_depth && 0 <= effective_max { results.push(root); }
    let mut level: string[] = [root];
    let mut depth: int = 0;
    let mut nodes: int = 0;
    let mut hit_bound: boolean = false;
    loop {
        if level.length == 0 { break; }
        // Listing a level at `depth` can only yield entries at `depth + 1`,
        // so the last level worth listing is `effective_max - 1`. Stopping
        // at `>` instead would list one level too many, costing an
        // `fs.listDirectory` on every directory at the boundary depth plus
        // an `fs.is_directory` on each of its entries — for
        // `walk_dirs(root, 2, 2)` over a cache, one `opendir` per stored
        // entry directory and a `stat` per artifact, all discarded.
        if depth >= effective_max { break; }
        let mut next_level: string[] = [];
        let mut li: int = 0;
        loop {
            if li >= level.length { break; }
            if nodes >= FS_TREE_MAX_NODES {
                hit_bound = true;
                break;
            }
            let dir = level[li];
            nodes += 1;
            let entries = fs.listDirectory(dir);
            let mut ei: int = 0;
            loop {
                if ei >= entries.length { break; }
                let full = dir + "/" + entries[ei];
                if fs.is_directory(full) {
                    if depth + 1 >= min_depth { results.push(full); }
                    next_level.push(full);
                }
                ei += 1;
            }
            li += 1;
        }
        if hit_bound { break; }
        level = next_level;
        depth += 1;
    }
    return results;
}

// Delete `path` and everything beneath it, the shell-free replacement for
// `rm -rf`. Guards match `_rm_rf_dir` and `cache_clean`
// (`compiler/src/build_cache.sfn`): an empty path or
// `"/"` returns `false` and deletes nothing. A path that does not exist
// returns `true` (already gone). Returns whether `path` is gone afterward,
// or `false` on hitting a traversal bound (best-effort; some of the tree
// may remain).
fn remove_tree(path: string) -> boolean ![io] {
    if path.length == 0 { return false; }
    if path == "/" { return false; }
    if !fs.exists(path) { return true; }
    // A file root has no entries to walk; `fs.removeDirectory` would
    // refuse it.
    if fs.deleteFile(path) { return true; }

    // BFS by level so children are discovered strictly after their
    // parent, in `dirs` (an append-only, discovery-order record). Every
    // directory therefore sits at a smaller index than its own children,
    // so removing `dirs` in reverse always empties children before their
    // parent — the same invariant `_selfhost_remove_tree`
    // (`compiler/src/cli_selfhost.sfn`) relies on. That helper is not
    // interchangeable with this one: it has no depth limit, so it still
    // suits the deeper `build/` stage trees this module's bound would cut.
    let mut dirs: string[] = [path];
    let mut level: string[] = [path];
    let mut depth: int = 0;
    let mut nodes: int = 0;
    let mut hit_bound: boolean = false;
    loop {
        if level.length == 0 { break; }
        if depth >= FS_TREE_MAX_DEPTH {
            hit_bound = true;
            break;
        }
        let mut next_level: string[] = [];
        let mut li: int = 0;
        loop {
            if li >= level.length { break; }
            if nodes >= FS_TREE_MAX_NODES {
                hit_bound = true;
                break;
            }
            let dir = level[li];
            nodes += 1;
            let entries = fs.listDirectory(dir);
            let mut ei: int = 0;
            loop {
                if ei >= entries.length { break; }
                let full = dir + "/" + entries[ei];
                if !fs.deleteFile(full) {
                    dirs.push(full);
                    next_level.push(full);
                }
                ei += 1;
            }
            li += 1;
        }
        if hit_bound { break; }
        level = next_level;
        depth += 1;
    }

    let mut ri: int = dirs.length - 1;
    loop {
        if ri < 0 { break; }
        fs.removeDirectory(dirs[ri]);
        ri -= 1;
    }
    if hit_bound { return false; }
    return !fs.exists(path);
}

// Copy `src` to `dst` recursively, the shell-free replacement for
// `cp -R`. `dst` is the destination ITSELF, never a container:
// `copy_tree("runtime/sfn", staging + "/sfn")` produces
// `staging/sfn/<entries>`, matching `cp -R src dst` where `dst` does not
// exist. An existing `dst` is MERGED into rather than replaced —
// same-named entries are overwritten, extra entries in `dst` survive;
// callers wanting replace semantics call `remove_tree(dst)` first.
//
// Returns `false` having copied nothing when `src` or `dst` is empty,
// `src` does not exist, `dst == src`, or `dst` lies inside `src` (which
// would otherwise recurse into its own output until the depth bound cut
// it off, 16 levels of garbage later). Unlike `remove_tree`, a missing
// `src` is a failure rather than a satisfied post-condition: "already
// gone" fulfils a delete, nothing fulfils a copy.
//
// On any other failure it stops at the first one, returns `false`, and
// DELETES NOTHING: continuing multiplies the damage, and rolling back
// would mean deleting a pre-existing `dst` that was never ours to
// remove. `dst` is left holding a partial tree and cleanup is the
// caller's — the shape every call site already has for the `cp` this
// replaces. Hitting a traversal bound is also `false`; see the header.
fn copy_tree(src: string, dst: string) -> boolean ![io] {
    if src.length == 0 { return false; }
    if dst.length == 0 { return false; }
    if !fs.exists(src) { return false; }
    if dst == src { return false; }
    if starts_with(dst, src + "/") { return false; }

    // A file root copies as one file, matching `cp -R <file> <dst>`.
    if !fs.is_directory(src) {
        let parent = _dirname_cmd(dst);
        if parent.length > 0 { ensure_dir_p(parent); }
        return _copy_file_preserving_mode(src, dst);
    }

    if !ensure_dir_p(dst) { return false; }

    // BFS over two parallel level arrays indexed together — the same
    // parallel-array shape `package.sfn` uses for its dependency queue,
    // keeping this module free of struct types. Each destination
    // directory is created BEFORE its source is listed, so creation
    // order is discovery order and no second pass is needed: the mirror
    // image of `remove_tree`, where a delete must empty children before
    // parents and so walks its discovery record backwards.
    let mut level_src: string[] = [src];
    let mut level_dst: string[] = [dst];
    let mut depth: int = 0;
    let mut nodes: int = 0;
    loop {
        if level_src.length == 0 { break; }
        if depth >= FS_TREE_MAX_DEPTH { return false; }
        let mut next_src: string[] = [];
        let mut next_dst: string[] = [];
        let mut li: int = 0;
        loop {
            if li >= level_src.length { break; }
            if nodes >= FS_TREE_MAX_NODES { return false; }
            let dir_src = level_src[li];
            let dir_dst = level_dst[li];
            nodes += 1;
            let entries = fs.listDirectory(dir_src);
            // An empty listing is either a genuinely empty directory or
            // one that could not be opened; `fs.listDirectory` spells
            // both `[]`. Probing only in that case costs one
            // `opendir`/`closedir` pair per empty directory, and a
            // non-empty listing has already proved the open succeeded.
            if entries.length == 0 {
                if !_dir_is_enumerable(dir_src) { return false; }
            }
            let mut ei: int = 0;
            loop {
                if ei >= entries.length { break; }
                let child_src = dir_src + "/" + entries[ei];
                let child_dst = dir_dst + "/" + entries[ei];
                if fs.is_directory(child_src) {
                    if !ensure_dir_p(child_dst) { return false; }
                    next_src.push(child_src);
                    next_dst.push(child_dst);
                } else {
                    if !_copy_file_preserving_mode(child_src, child_dst) {
                        return false;
                    }
                }
                ei += 1;
            }
            li += 1;
        }
        level_src = next_src;
        level_dst = next_dst;
        depth += 1;
    }
    return true;
}

// Remove every directory strictly under `root` that is empty, or becomes
// empty once its own empty descendants are removed — the shell-free
// replacement for `find <root> -mindepth 1 -type d -empty -delete`.
// `root` itself is never removed. Returns the count removed, or a short
// count on hitting a traversal bound (best-effort).
fn remove_empty_dirs_under(root: string) -> int ![io] {
    if !fs.exists(root) { return 0; }

    // Two passes, mirroring `remove_tree`'s discovery-order/reverse-order
    // trick: a directory found empty at discovery time is removed
    // immediately (via the `fs.removeDirectory` probe, which only
    // succeeds on an empty directory); anything else with children is
    // recorded in `dirs` (discovery order — parent before child) and
    // retried in reverse once its own children have had a chance to empty
    // out. A `fs.listDirectory` result with entries left over after the
    // `removeDirectory` probe fails is a non-empty directory to descend
    // into; a result with no entries left over is a file, and is left
    // untouched.
    let mut removed: int = 0;
    let mut dirs: string[] = [];
    let mut level: string[] = [root];
    let mut depth: int = 0;
    let mut nodes: int = 0;
    let mut hit_bound: boolean = false;
    loop {
        if level.length == 0 { break; }
        if depth >= FS_TREE_MAX_DEPTH { break; }
        let mut next_level: string[] = [];
        let mut li: int = 0;
        loop {
            if li >= level.length { break; }
            if nodes >= FS_TREE_MAX_NODES {
                hit_bound = true;
                break;
            }
            let dir = level[li];
            nodes += 1;
            let entries = fs.listDirectory(dir);
            let mut ei: int = 0;
            loop {
                if ei >= entries.length { break; }
                let full = dir + "/" + entries[ei];
                if fs.removeDirectory(full) {
                    removed += 1;
                    ei += 1;
                    continue;
                }
                let child_entries = fs.listDirectory(full);
                if child_entries.length > 0 {
                    dirs.push(full);
                    next_level.push(full);
                }
                ei += 1;
            }
            li += 1;
        }
        if hit_bound { break; }
        level = next_level;
        depth += 1;
    }

    let mut ri: int = dirs.length - 1;
    loop {
        if ri < 0 { break; }
        if fs.removeDirectory(dirs[ri]) { removed += 1; }
        ri -= 1;
    }
    return removed;
}

// Thin wrapper over `fs.createDirectory(path, true)` for surface symmetry
// with the rest of this module.
fn ensure_dir_p(path: string) -> boolean ![io] {
    return fs.createDirectory(path, true);
}

export {
    walk_dirs,
    list_child_dirs,
    remove_tree,
    copy_tree,
    remove_empty_dirs_under,
    ensure_dir_p
};
