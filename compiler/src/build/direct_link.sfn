// compiler/src/build/direct_link.sfn
//
// Sailfin owns the Link role on Linux x86-64/aarch64 (SFEP-0066 §3.1 role
// table; mirror #2550). SFN-453 made
// `Backend.link` object-only; this leaf owns the Linux x86-64/aarch64 final-link
// contract directly instead of delegating it to clang's driver: it resolves
// the startup objects, dynamic linker, library search paths, and runtime
// libraries the SysV ABI needs, then constructs a bare `ld.lld` argv.
//
// The clang driver historically supplied all of this implicitly (CRT
// objects, `-dynamic-linker`, `-L` search dirs, libc/libgcc). None of it
// lived in the tree — this module makes it explicit and probes the host so
// the final link no longer needs clang on PATH. Every prerequisite is
// checked before the direct path is chosen; a missing one yields a
// controlled fallback (`ok=false` + `reason`) to the clang driver rather
// than a silent ABI change.
//
// Scope is deliberately glibc Linux x86-64 and aarch64. macOS, Windows,
// musl, and other arches resolve `ok=false` and keep the clang link path.
// Self-host note: every argv builder is a free function calling the array
// builtin `.push`, matching `backend.sfn`'s shape (the struct-method `.push`
// lowering the self-hosting compiler does not resolve, #1389).
import { _env_flag, _get_env_cmd } from "../build_flags";
import { starts_with, substring } from "../string_utils";
import { user_config_linker, user_config_linker_origin } from "../user_config";
import { _shell_read_cmd } from "./fs";
import { build_target_triple, triple_target_arch } from "./target";

// The resolved Linux link contract. `ok` gates the direct path;
// when false, `reason` names why the driver falls back to clang. Every
// path field is absolute and verified to exist during resolution.
struct DirectLinkContract {
    ok: boolean;
    reason: string;
    // GNU/LLD linker emulation (`elf_x86_64` or `aarch64linux`).
    linker_emulation: string;
    // The architecture's glibc ELF interpreter for -pie. Empty under
    // `static_link` — a static executable has no ELF interpreter, which is
    // the whole point of the contract (SFN-1268).
    dynamic_linker: string;
    // Whether this contract links a self-contained, non-PIE executable
    // against glibc's static archives (`sfn build --static`, SFN-1268).
    // Selects the CRT family below and the argv shape in
    // `direct_ld_lld_argv`; the two must never be mixed.
    static_link: boolean;
    // Startup objects, taken as a family. Dynamic/PIE:
    // Scrt1.o/crti.o/crtn.o (multiarch libdir) wrap crtbeginS.o/crtendS.o
    // (gcc install dir). Static: crt1.o/crti.o/crtn.o wrap
    // crtbeginT.o/crtend.o. Mixing the two families links cleanly and
    // segfaults before `main`, so resolution takes all of one or fails.
    crt1: string;
    crti: string;
    crtn: string;
    crtbegin: string;
    crtend: string;
    // -L search directories (gcc dir first, then the multiarch/system dirs)
    // that resolve libc/libgcc/-l runtime libraries.
    search_dirs: string[];
}

fn _direct_fail(reason: string) -> DirectLinkContract {
    return DirectLinkContract {
        ok: false,
        reason: reason,
        linker_emulation: "",
        dynamic_linker: "",
        static_link: false,
        crt1: "",
        crti: "",
        crtn: "",
        crtbegin: "",
        crtend: "",
        search_dirs: []
    };
}

// Candidate multiarch/system directories that hold Scrt1.o/crti.o/crtn.o,
// in Debian/Ubuntu-then-RHEL/Arch preference order.
fn _multiarch_libdirs(arch: string) -> string[] {
    if arch == "aarch64" {
        return ["/usr/lib/aarch64-linux-gnu", "/lib/aarch64-linux-gnu", "/usr/lib64", "/lib64", "/usr/lib", "/lib"];
    }
    return ["/usr/lib/x86_64-linux-gnu", "/lib/x86_64-linux-gnu", "/usr/lib64", "/lib64", "/usr/lib", "/lib"];
}

// First candidate directory that contains `filename`, or "" if none do.
fn _first_libdir_with(dirs: string[], filename: string) -> string ![io] {
    let mut i: int = 0;
    loop {
        if i >= dirs.length { break; }
        let candidate = dirs[i] + "/" + filename;
        if fs.exists(candidate) { return dirs[i]; }
        i += 1;
    }
    return "";
}

// Resolve the native gcc install directory that holds `crt_name` — the
// begin-CRT of the requested family (crtbeginS.o for the PIE link,
// crtbeginT.o for the static one), e.g. /usr/lib/gcc/x86_64-linux-gnu/13 or
// /usr/lib/gcc/aarch64-linux-gnu/13. gcc's minor version varies by distro,
// so probe the filesystem and pick the highest version present. Returns ""
// when no gcc CRT directory matching `arch` is found.
//
// Keyed on the begin-CRT rather than a fixed name (SFN-1268) so the static
// family resolves its own directory: a host can ship crtbeginS.o without
// crtbeginT.o (the static libgcc split across distro packages), and probing
// for the wrong one would resolve a directory whose end-CRT is absent.
//
// The denylist excludes non-native ABI/libc variants and cross-compilers
// that may co-exist on a development machine. Without it, the version sort
// can select a mismatched crtbegin + `-lgcc` where clang's native-triple
// resolution would have succeeded.
fn _gcc_crt_dir(arch: string, crt_name: string) -> string ![io] {
    let found = _shell_read_cmd("find /usr/lib/gcc /usr/lib64/gcc -maxdepth 3 -name "
        + crt_name
        + " 2>/dev/null | grep "
        + arch
        + " | grep -Ev 'gnux32|musl|uclibc|mingw|w64|-none-|-elf|-eabi|android' | sort -V | tail -1");
    if found.length == 0 { return ""; }
    // Strip the trailing "/<crt_name>" to get the directory.
    let suffix_len: int = crt_name.length + 1;
    if found.length <= suffix_len { return ""; }
    return substring(found, 0, found.length - suffix_len);
}

// Append `dir` to `dirs` when it exists on disk and is not already present.
fn _push_dir_if_new(dirs: string[], dir: string) -> string[] ![io] {
    let mut out: string[] = dirs;
    if dir.length == 0 { return out; }
    if !fs.exists(dir) { return out; }
    let mut i: int = 0;
    loop {
        if i >= out.length { break; }
        if out[i] == dir { return out; }
        i += 1;
    }
    out.push(dir);
    return out;
}

// Resolve `command -v <name>`, or "" when not on PATH.
fn _which(name: string) -> string ![io] {
    return _shell_read_cmd("command -v " + name + " 2>/dev/null");
}

// Target-profile selection for the Link role (SFEP-0066 section 3.6): one
// entry point picks the platform's direct linker. Darwin and Windows
// MSVC/COFF resolve to a structured not-yet-owned reason until SFN-954 and
// SFN-955 implement their argv; both defer to the migration clang oracle
// rather than failing the build.
fn resolve_link_contract(target_os: string, static_link: boolean) -> DirectLinkContract ![io] {
    if target_os == "Linux" {
        return resolve_direct_ld_lld(target_os, static_link);
    }
    // Every arm echoes `target_os` verbatim in a `(<os>)` group. That is
    // load-bearing, not cosmetic: `build_target_os()` returns an
    // unrecognized `SAILFIN_TARGET_OS` override unvalidated (`./target.sfn`
    // 68-84), and the trace echoing it back is what lets a caller see which
    // value was actually resolved. `target_flag_cache_key_test.sfn` pins the
    // recognized/unrecognized contrast on exactly that echo.
    if target_os == "Darwin" {
        return _direct_fail("target os (" + target_os
            + ") has no owned direct linker yet (SFN-954)");
    }
    if target_os == "Windows" {
        return _direct_fail("target os (" + target_os
            + ") has no owned direct linker yet (SFN-955)");
    }
    return _direct_fail("target os (" + target_os
        + ") has no direct-link target profile");
}

// Resolve the direct glibc Linux `ld.lld` link contract, or a
// fallback (`ok=false`) with a reason. Gates, in order: target OS is
// Linux; host arch is x86_64 or aarch64; `SAILFIN_LINKER` is unset or
// `lld`/`ld.lld` (any other value defers to the clang path so mold/system
// overrides are honored); `ld.lld` is on PATH; then the family-specific
// artifacts (dynamic linker + PIE CRTs, or the static CRTs + libc.a).
// Re-probed per link (cheap shell calls dwarfed by the link itself); env
// is stable per process.
//
// `static_link` selects the self-contained non-PIE contract (SFN-1268).
// Note what `ok=false` MEANS differs by leg: on the dynamic leg it is a
// controlled fallback to the clang driver; on the static leg the caller
// must fail closed with `E0626` instead, because a dynamic binary is
// precisely the outcome `--static` exists to prevent
// (`cli/commands/build.sfn`, `backend.sfn:link`).
fn resolve_direct_ld_lld(target_os: string, static_link: boolean) -> DirectLinkContract ![io] {
    if target_os != "Linux" {
        return _direct_fail("target is not Linux (" + target_os + ")");
    }
    // Mirror SFN-471's non-shelling host-arch seam: the override is the
    // cross-emit/e2e hook, then the resolved TARGET triple (SFN-923 — this
    // previously probed only the HOST here, disagreeing with
    // `_resolve_llvm_target_arch`'s triple-first resolution on the
    // identical axis, per the three-probes-must-agree note at
    // `./target.sfn:189-193`), then the aarch64 glibc loader marker, with
    // x86_64 as the dominant Tier-1 default.
    let mut arch = _get_env_cmd("SAILFIN_TARGET_ARCH");
    if arch.length == 0 {
        arch = triple_target_arch(build_target_triple());
    }
    if arch.length == 0 {
        arch = "x86_64";
        if fs.exists("/lib/ld-linux-aarch64.so.1") { arch = "aarch64"; }
    }
    if arch != "x86_64" && arch != "aarch64" {
        return _direct_fail("host arch is unsupported (" + arch + ")");
    }
    // SFEP-0076 section 3.3: rung 2 (environment) above rung 4 (user config).
    // Threaded here as well as in `build/link.sfn` so the two link paths cannot
    // disagree about which linker the user asked for.
    let mut forced = _get_env_cmd("SAILFIN_LINKER");
    let mut forced_origin: string = "SAILFIN_LINKER";
    if forced.length == 0 {
        let config_triple = build_target_triple();
        forced = user_config_linker(config_triple);
        forced_origin = user_config_linker_origin(config_triple);
    }
    if forced.length > 0 {
        if forced != "lld" && forced != "ld.lld" {
            return _direct_fail(forced_origin + "=" + forced
                + " defers to clang");
        }
    }
    if _which("ld.lld").length == 0 {
        return _direct_fail("ld.lld not on PATH");
    }
    let mut emulation = "elf_x86_64";
    if arch == "aarch64" { emulation = "aarch64linux"; }
    if static_link { return _resolve_static_contract(arch, emulation); }
    let mut dyn = "/lib64/ld-linux-x86-64.so.2";
    if arch == "aarch64" { dyn = "/lib/ld-linux-aarch64.so.1"; }
    if !fs.exists(dyn) {
        return _direct_fail("dynamic linker missing (" + dyn + ")");
    }
    let libdir = _first_libdir_with(_multiarch_libdirs(arch), "Scrt1.o");
    if libdir.length == 0 {
        return _direct_fail("Scrt1.o not found in standard libdirs");
    }
    if !fs.exists(libdir + "/crti.o") || !fs.exists(libdir + "/crtn.o") {
        return _direct_fail("crti.o/crtn.o not found in " + libdir);
    }
    let gccdir = _gcc_crt_dir(arch, "crtbeginS.o");
    if gccdir.length == 0 {
        return _direct_fail("crtbeginS.o not found in a gcc libdir");
    }
    if !fs.exists(gccdir + "/crtendS.o") {
        return _direct_fail("crtendS.o not found in " + gccdir);
    }
    return DirectLinkContract {
        ok: true,
        reason: "",
        linker_emulation: emulation,
        dynamic_linker: dyn,
        static_link: false,
        crt1: libdir + "/Scrt1.o",
        crti: libdir + "/crti.o",
        crtn: libdir + "/crtn.o",
        crtbegin: gccdir + "/crtbeginS.o",
        crtend: gccdir + "/crtendS.o",
        search_dirs: _link_search_dirs(arch, gccdir, libdir, "")
    };
}

// The `-L` search list: the gcc CRT dir first, then the multiarch libdir
// that supplied the startup objects, then `libc_dir` (the static path's
// libc.a home, which can differ from the CRT libdir; "" on the dynamic
// path, where `_push_dir_if_new` drops it), then the arch's multiarch and
// system dirs. Shared by both contracts so the two cannot drift; with
// `libc_dir` empty the sequence is byte-identical to the pre-SFN-1268 one.
fn _link_search_dirs(arch: string, gccdir: string, libdir: string, libc_dir: string) -> string[] ![io] {
    let mut dirs: string[] = [];
    dirs = _push_dir_if_new(dirs, gccdir);
    dirs = _push_dir_if_new(dirs, libdir);
    dirs = _push_dir_if_new(dirs, libc_dir);
    if arch == "aarch64" {
        dirs = _push_dir_if_new(dirs, "/usr/lib/aarch64-linux-gnu");
        dirs = _push_dir_if_new(dirs, "/lib/aarch64-linux-gnu");
    } else {
        dirs = _push_dir_if_new(dirs, "/usr/lib/x86_64-linux-gnu");
        dirs = _push_dir_if_new(dirs, "/lib/x86_64-linux-gnu");
    }
    dirs = _push_dir_if_new(dirs, "/usr/lib64");
    dirs = _push_dir_if_new(dirs, "/lib64");
    dirs = _push_dir_if_new(dirs, "/usr/lib");
    dirs = _push_dir_if_new(dirs, "/lib");
    return dirs;
}

// Resolve the static (`sfn build --static`, SFN-1268) leg of the contract,
// reached only after the shared Linux/arch/forced-linker/`ld.lld` gates
// above have passed. No dynamic-linker probe: a static executable has no
// ELF interpreter.
//
// Every prerequisite the contract itself names is checked here — the CRT
// family, libc.a, and the libgcc archives — and each `reason` names the ONE
// artifact that was missing. A development host with libc.so but no libc.a
// is the common case, and the caller surfaces this reason verbatim in
// `E0626` — "libc.a not found in standard libdirs" tells the user to
// install glibc-static; `ld.lld: error: unable to find library -lc` does
// not. `-l` entries arriving from `LinkPlan.libs` (`-lm`, `-lpthread`) are
// resolved by `ld.lld` against `search_dirs` and are not probed here,
// because this resolver does not see the plan (SFN-1268).
fn _resolve_static_contract(arch: string, emulation: string) -> DirectLinkContract ![io] {
    let libdirs = _multiarch_libdirs(arch);
    let libdir = _first_libdir_with(libdirs, "crt1.o");
    if libdir.length == 0 {
        return _direct_fail("crt1.o not found in standard libdirs");
    }
    if !fs.exists(libdir + "/crti.o") || !fs.exists(libdir + "/crtn.o") {
        return _direct_fail("crti.o/crtn.o not found in " + libdir);
    }
    // Probed independently of the CRT libdir: a host can carry the startup
    // objects in the multiarch dir and libc.a in /usr/lib64, and the `-L`
    // list must cover both or the `--start-group` tail cannot resolve.
    let libc_dir = _first_libdir_with(libdirs, "libc.a");
    if libc_dir.length == 0 {
        return _direct_fail("libc.a not found in standard libdirs");
    }
    let gccdir = _gcc_crt_dir(arch, "crtbeginT.o");
    if gccdir.length == 0 {
        return _direct_fail("crtbeginT.o not found in a gcc libdir");
    }
    if !fs.exists(gccdir + "/crtend.o") {
        return _direct_fail("crtend.o not found in " + gccdir);
    }
    // The static tail's `--start-group -lgcc -lgcc_eh` resolves these two
    // by name, and a distro can ship crtbeginT.o without the static
    // libgcc split (libgcc_eh.a in particular is packaged separately on
    // some distros), so probing them here is what makes the "one named
    // artifact" promise of E0626 true rather than deferring to an
    // `ld.lld: unable to find library` error (SFN-1268).
    if !fs.exists(gccdir + "/libgcc.a") {
        return _direct_fail("libgcc.a not found in " + gccdir);
    }
    if !fs.exists(gccdir + "/libgcc_eh.a") {
        return _direct_fail("libgcc_eh.a not found in " + gccdir);
    }
    return DirectLinkContract {
        ok: true,
        reason: "",
        linker_emulation: emulation,
        dynamic_linker: "",
        static_link: true,
        crt1: libdir + "/crt1.o",
        crti: libdir + "/crti.o",
        crtn: libdir + "/crtn.o",
        crtbegin: gccdir + "/crtbeginT.o",
        crtend: gccdir + "/crtend.o",
        search_dirs: _link_search_dirs(arch, gccdir, libdir, libc_dir)
    };
}

// Split `s` on ',' into its comma-separated pieces (empty pieces kept).
fn _split_on_comma(s: string) -> string[] {
    let mut out: string[] = [];
    let mut start: int = 0;
    let mut i: int = 0;
    loop {
        if i >= s.length { break; }
        if substring(s, i, i + 1) == "," {
            out.push(substring(s, start, i));
            start = i + 1;
        }
        i += 1;
    }
    out.push(substring(s, start, s.length));
    return out;
}

// Translate the LinkPlan's clang-driver `link_flags` into raw linker
// arguments. `-Wl,x,y` passthrough (`--gc-sections`, `-u <sym>`) becomes
// bare `x y`; clang-only compile/driver flags (`-fuse-ld=…`,
// `-ffunction-sections`, `-fdata-sections`) are dropped — they mean
// nothing to `ld.lld`, which *is* the linker and links already-compiled
// objects.
fn _translate_link_flags(link_flags: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= link_flags.length { break; }
        let f = link_flags[i];
        if starts_with(f, "-Wl,") {
            let rest = substring(f, 4, f.length);
            let parts = _split_on_comma(rest);
            let mut j: int = 0;
            loop {
                if j >= parts.length { break; }
                if parts[j].length > 0 { out.push(parts[j]); }
                j += 1;
            }
        }
        // else: a clang-driver-only flag — dropped for the direct link.
        i += 1;
    }
    return out;
}

// Sanitize the LinkPlan's `libs` for a bare `ld.lld` invocation: the
// compile-driver `-pthread` spelling becomes `-lpthread`; `-l…`/`-L…`
// pass through unchanged.
fn _sanitize_direct_libs(libs: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= libs.length { break; }
        let l = libs[i];
        if l == "-pthread" { out.push("-lpthread"); } else { out.push(l); }
        i += 1;
    }
    return out;
}

// Build the bare `ld.lld` argv for a glibc Linux link. The flag set and
// object/library ordering mirror what clang's driver passes to the linker
// (hardening defaults, target emulation, `-dynamic-linker`, the
// Scrt1/crti/crtbegin … crtend/crtn wrap, and the libc/libgcc tail) so target
// identity and provider-symbol retention match the previous clang-driven
// behavior. `link_flags` is empty for the `sfn test` layout, so the same
// builder serves both program and test links.
//
// `contract.static_link` (SFN-1268) selects the self-contained non-PIE
// form. Only the three positions marked below differ; the CRT paths
// themselves already carry the right family from resolution, so this
// builder never picks a filename. With `static_link` false the argv is
// byte-identical to the pre-SFN-1268 one — the zero-behaviour gate
// (`compiler/tests/unit/direct_link_argv_test.sfn`).
fn direct_ld_lld_argv(contract: DirectLinkContract, objects: string[], out_path: string, libs: string[], link_flags: string[]) -> string[] {
    // Position 1: `-static` replaces `-pie`, and `-dynamic-linker <loader>`
    // is dropped — a static executable has no ELF interpreter to name.
    let mut a: string[] = ["ld.lld"];
    if contract.static_link { a.push("-static"); } else { a.push("-pie"); }
    a.push("--eh-frame-hdr");
    a.push("-z");
    a.push("relro");
    a.push("--hash-style=gnu");
    a.push("--build-id");
    a.push("-m");
    a.push(contract.linker_emulation);
    if !contract.static_link {
        a.push("-dynamic-linker");
        a.push(contract.dynamic_linker);
    }
    a.push("-o");
    a.push(out_path);
    a.push(contract.crt1);
    a.push(contract.crti);
    a.push(contract.crtbegin);
    let mut di: int = 0;
    loop {
        if di >= contract.search_dirs.length { break; }
        a.push("-L" + contract.search_dirs[di]);
        di += 1;
    }
    let raw_flags = _translate_link_flags(link_flags);
    let mut ri: int = 0;
    loop {
        if ri >= raw_flags.length { break; }
        a.push(raw_flags[ri]);
        ri += 1;
    }
    let mut oi: int = 0;
    loop {
        if oi >= objects.length { break; }
        a.push(objects[oi]);
        oi += 1;
    }
    let sanitized = _sanitize_direct_libs(libs);
    let mut li: int = 0;
    loop {
        if li >= sanitized.length { break; }
        a.push(sanitized[li]);
        li += 1;
    }
    // Position 2: the libc/libgcc tail.
    //
    // Dynamic (mirrors clang's SysV link line): the --as-needed toggle
    // keeps libgcc_s out of the DT_NEEDED set unless a symbol actually
    // pulls it in, matching the driver's behavior.
    //
    // Static: libgcc_s is the SHARED unwinder and has no place here, so
    // the --as-needed pairs are dropped and libgcc_eh (its static
    // counterpart) takes over. libc.a and libgcc_eh.a are mutually
    // recursive — libc's stack unwinding calls into libgcc_eh, which calls
    // back into libc — so the doubled single-pass tail cannot resolve them
    // and --start-group/--end-group re-scans until closure.
    if contract.static_link {
        a.push("--start-group");
        a.push("-lgcc");
        a.push("-lgcc_eh");
        a.push("-lc");
        a.push("--end-group");
    } else {
        a.push("-lgcc");
        a.push("--as-needed");
        a.push("-lgcc_s");
        a.push("--no-as-needed");
        a.push("-lc");
        a.push("-lgcc");
        a.push("--as-needed");
        a.push("-lgcc_s");
        a.push("--no-as-needed");
    }
    // Position 3 is not here: the end-CRT pair reads its family from the
    // contract (crtendS.o/crtend.o), resolved together with crtbegin.
    a.push(contract.crtend);
    a.push(contract.crtn);
    return a;
}

// Env-gated (`SAILFIN_TRACE_LINK`) stderr note that the direct link path
// was unavailable and the clang driver is used instead — so a fallback is
// never a silent ABI change. Matches the `_llvm_text_trace_link` toggle
// semantics; string work is skipped when the flag is unset.
fn trace_direct_link_fallback(reason: string) ![io] {
    if !_env_flag("SAILFIN_TRACE_LINK") { return; }
    print.err("[trace-link] direct linker unavailable: " + reason
        + "; using clang driver");
}

export {
    DirectLinkContract,
    resolve_direct_ld_lld,
    resolve_link_contract,
    direct_ld_lld_argv,
    trace_direct_link_fallback
};
