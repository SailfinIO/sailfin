// compiler/src/build/clang_argv.sfn
//
// Leaf: batched LLVM-artifact assembly ahead of the final link
// (SFEP-0027 §3.1, issue #1730). The argv shapes themselves moved to
// `./artifact_compile` when SFN-950 split LLVM-artifact lowering from
// foreign-C compilation; this module now owns only the cached, pooled
// batch that turns a link plan's `.ll` inputs into objects.
//
// Why this leaf exists. Build-driver modules under `compiler/src/build/`
// (e.g. `build/runtime_objs.sfn`) need to assemble `.ll` → `.o`, but they
// must NOT import `backend.sfn`: importing it pulls the `Backend`-interface-
// implementing `LlvmTextBackend` struct into the consumer module, and the
// pinned seed emits that struct's interface vtable as a module-local
// `internal constant` referencing every interface-method symbol while only
// emitting a `declare` for the methods the consumer actually calls. A module
// that assembles but never links (`build/runtime_objs`) thus leaves the
// `link` method symbol undefined and produces invalid LLVM IR
// (`use of undefined value @LlvmTextBackendlink`), failing the cold
// self-host build. Routing the assemble path through struct-free leaves
// keeps `LlvmTextBackend` out of the consumer's type universe, so no vtable
// is emitted there. (The underlying seed vtable-lowering bug is tracked
// separately; this leaf is the source-level avoidance.)
//
// The historical filename is retained to avoid a structural module-graph
// change during the migration. Assemble/object emission now resolves one
// coherent LLVM family and runs llvm-as, opt, and llc; clang is reachable only
// through the explicitly configured migration oracle (SFN-952).
import {
    ParallelProcessPipelineTask,
    _cr_resolve_jobs,
    _cr_run_bounded_process_pipelines
} from "../capsule_emit_parallel";
import {
    LlvmArtifactRequest,
    LlvmObjectPipeline,
    LlvmObjectProvider,
    classify_object_source,
    llvm_artifact_request_cache_key,
    llvm_object_provider_failure,
    prepare_llvm_object_pipeline,
    resolve_llvm_object_provider_for_target,
    run_llvm_artifact_with_provider
} from "./artifact_compile";
import {
    _ensure_dir_cmd,
    _mktemp_sibling_cmd,
    _rename_noreplace_preserving_source_on_failure,
    _sha256_of_file
} from "./fs";
import { sha256_hex_of_string } from "./hash";
import { build_target_triple } from "./target";

// Result of separating LLVM assembly from the final link. `object_paths`
// preserves the input order exactly; callers splice the returned objects
// wherever the corresponding `.ll` inputs appeared in their historical link
// layout.
struct LinkObjectAssembly {
    success: boolean;
    object_paths: string[];
}

struct PendingLinkObjectAssembly {
    fallback_path: string;
    ll_path: string;
    object_index: int;
    object_path: string;
    staged_path: string;
    pipeline: LlvmObjectPipeline;
}

fn _link_input_pipeline(ll_path: string, out_path: string, opt_flag: string, provider: LlvmObjectProvider) -> LlvmObjectPipeline ![io] {
    return prepare_llvm_object_pipeline(LlvmArtifactRequest {
        ir_path: ll_path, object_path: out_path, opt_flag: opt_flag
    }, provider);
}

// Assemble a list of textual LLVM modules before the final link (SFN-453).
//
// The content-addressed key covers IR bytes, optimization, the complete LLVM
// family fingerprint, target/object profile, and pipeline schema. The
// LLVM-artifact namespace fold keeps these objects out of the foreign-C key
// space. Objects live under the caller's work/shared cache. If
// that cache is unwritable, use an ephemeral object beside the `.ll` input
// instead of falling back to feeding raw IR into the final link; the
// object-only backend boundary is invariant.
fn assemble_link_inputs_with_provider(ll_paths: string[], object_dir: string, opt_flag: string, provider: LlvmObjectProvider) -> LinkObjectAssembly ![io] {
    // Fail closed on a misrouted artifact before any cache or spawn work
    // (SFN-950, SFEP-0066 §3.3): this provider owns LLVM text only, so a
    // `c-sources` entry that reached a link plan is rejected here rather
    // than compiled through the LLVM path.
    let mut ci: int = 0;
    loop {
        if ci >= ll_paths.length { break; }
        if classify_object_source(ll_paths[ci]) != "llvm" {
            print("sfn build: link input is not an LLVM artifact: " + ll_paths[ci]);
            return LinkObjectAssembly { success: false, object_paths: [] };
        }
        ci += 1;
    }
    _ensure_dir_cmd(object_dir);
    if !provider.ok {
        print.err(provider.diagnostic);
        return LinkObjectAssembly { success: false, object_paths: [] };
    }
    let mut objects: string[] = [];
    let mut pending: PendingLinkObjectAssembly[] = [];
    let mut can_parallel: boolean = true;
    let mut i: int = 0;
    loop {
        if i >= ll_paths.length { break; }
        let ll_path = ll_paths[i];
        let content_hash = _sha256_of_file(ll_path);
        let request = LlvmArtifactRequest {
            ir_path: ll_path,
            object_path: "",
            opt_flag: opt_flag
        };
        let request_key = llvm_artifact_request_cache_key(content_hash, request, provider);
        if content_hash.length == 0 {
            let fallback_key = sha256_hex_of_string(ll_path + "\n" + opt_flag
                + "\n"
                + provider.fingerprint);
            let fallback = ll_path + ".link-" + fallback_key + ".o";
            objects.push(fallback);
            can_parallel = false;
            pending.push(PendingLinkObjectAssembly {
                fallback_path: fallback, ll_path: ll_path, object_index: objects.length - 1, object_path: "", staged_path: "", pipeline: _link_input_pipeline(ll_path, fallback, opt_flag, provider)
            });
            i += 1;
            continue;
        }
        let key_hash = sha256_hex_of_string(request_key);
        let obj_path = object_dir + "/" + key_hash + ".o";
        if fs.exists(obj_path) {
            objects.push(obj_path);
            i += 1;
            continue;
        }

        let tmp = _mktemp_sibling_cmd(obj_path);
        let fallback = ll_path + ".link-" + key_hash + ".o";
        if tmp.length > 0 {
            objects.push(obj_path);
            pending.push(PendingLinkObjectAssembly {
                fallback_path: fallback, ll_path: ll_path, object_index: objects.length - 1, object_path: obj_path, staged_path: tmp, pipeline: _link_input_pipeline(ll_path, tmp, opt_flag, provider)
            });
        } else {
            // Cache publication cannot be staged without a sibling temp. The
            // source scratch is the recoverable fallback location and is
            // cleaned with the owning build/test invocation.
            objects.push(fallback);
            can_parallel = false;
            pending.push(PendingLinkObjectAssembly {
                fallback_path: fallback, ll_path: ll_path, object_index: objects.length - 1, object_path: obj_path, staged_path: "", pipeline: _link_input_pipeline(ll_path, fallback, opt_flag, provider)
            });
        }
        i += 1;
    }

    let mut jobs = _cr_resolve_jobs();
    if !can_parallel { jobs = 1; }
    let run = _cr_run_bounded_process_pipelines(_link_object_tasks(pending), jobs);
    let mut pi: int = 0;
    loop {
        if pi >= pending.length { break; }
        if run.exit_codes[pi] != 0 {
            print.err(llvm_object_provider_failure(provider, pending[pi].pipeline, run.failed_stages[pi], pending[pi].ll_path, run.exit_codes[pi]));
            _delete_link_object_staging(pending);
            return LinkObjectAssembly { success: false, object_paths: [] };
        }
        pi += 1;
    }
    pi = 0;
    loop {
        if pi >= pending.length { break; }
        let item = pending[pi];
        if item.staged_path.length > 0 {
            // Object-cache entries are immutable and content-addressed. A
            // concurrent compiler may have published this exact key while
            // our pipeline was running, so never replace the destination:
            // on Windows that can displace an object while lld-link has it
            // open (LNK1104), and on every host it does needless filesystem
            // work. First writer wins; a complete destination after a lost
            // race is the successful result for this request.
            if _rename_noreplace_preserving_source_on_failure(item.staged_path, item.object_path) {
                objects[item.object_index] = item.object_path;
            } else if fs.exists(item.object_path) {
                fs.deleteFile(item.staged_path);
                objects[item.object_index] = item.object_path;
            } else {
                fs.deleteFile(item.staged_path);
                if run_llvm_artifact_with_provider(LlvmArtifactRequest {
                    ir_path: item.ll_path, object_path: item.fallback_path, opt_flag: opt_flag
                }, provider) != 0 {
                    _delete_link_object_staging(pending);
                    return LinkObjectAssembly {
                        success: false,
                        object_paths: []
                    };
                }
                objects[item.object_index] = item.fallback_path;
            }
        }
        pi += 1;
    }
    _delete_link_object_intermediates(pending);
    return LinkObjectAssembly { success: true, object_paths: objects };
}

fn assemble_link_inputs(ll_paths: string[], object_dir: string, opt_flag: string) -> LinkObjectAssembly ![io] {
    return assemble_link_inputs_with_provider(ll_paths, object_dir, opt_flag, resolve_llvm_object_provider_for_target(build_target_triple()));
}

fn _delete_link_object_intermediates(pending: PendingLinkObjectAssembly[]) ![io] {
    let mut i: int = 0;
    loop {
        if i >= pending.length { break; }
        if pending[i].pipeline.verified_path.length > 0 && fs.exists(pending[i].pipeline.verified_path) {
            fs.deleteFile(pending[i].pipeline.verified_path);
        }
        if pending[i].pipeline.optimized_path.length > 0 && fs.exists(pending[i].pipeline.optimized_path) {
            fs.deleteFile(pending[i].pipeline.optimized_path);
        }
        if pending[i].pipeline.profiled_path.length > 0 && fs.exists(pending[i].pipeline.profiled_path) {
            fs.deleteFile(pending[i].pipeline.profiled_path);
        }
        i += 1;
    }
}

fn _delete_link_object_staging(pending: PendingLinkObjectAssembly[]) ![io] {
    let mut i: int = 0;
    loop {
        if i >= pending.length { break; }
        if pending[i].staged_path.length > 0 {
            fs.deleteFile(pending[i].staged_path);
        }
        i += 1;
    }
    _delete_link_object_intermediates(pending);
}

fn _link_object_tasks(pending: PendingLinkObjectAssembly[]) -> ParallelProcessPipelineTask[] {
    let mut tasks: ParallelProcessPipelineTask[] = [];
    let mut i: int = 0;
    loop {
        if i >= pending.length { break; }
        tasks.push(ParallelProcessPipelineTask {
            stages: pending[i].pipeline.stages
        });
        i += 1;
    }
    return tasks;
}

export {
    LinkObjectAssembly,
    assemble_link_inputs,
    assemble_link_inputs_with_provider
};
