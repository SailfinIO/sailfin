// compiler/src/build/clang_argv.sfn
//
// Leaf: batched LLVM-artifact assembly ahead of the final link
// (SFEP-0027 §3.1, issue #1730). The argv shapes themselves moved to
// `./artifact_compile` when SFN-950 split LLVM-artifact lowering from
// foreign-C compilation; this module now owns only the cached, pooled
// batch that turns a link plan's `.ll` inputs into objects.
//
// Why this leaf exists. Build-driver modules under `compiler/src/build/`
// (e.g. `build/runtime_objs.sfn`) need to assemble `.ll` → `.o`, but they
// must NOT import `backend.sfn`: importing it pulls the `Backend`-interface-
// implementing `LlvmTextBackend` struct into the consumer module, and the
// pinned seed emits that struct's interface vtable as a module-local
// `internal constant` referencing every interface-method symbol while only
// emitting a `declare` for the methods the consumer actually calls. A module
// that assembles but never links (`build/runtime_objs`) thus leaves the
// `link` method symbol undefined and produces invalid LLVM IR
// (`use of undefined value @LlvmTextBackendlink`), failing the cold
// self-host build. Routing the assemble path through struct-free leaves
// keeps `LlvmTextBackend` out of the consumer's type universe, so no vtable
// is emitted there. (The underlying seed vtable-lowering bug is tracked
// separately; this leaf is the source-level avoidance.)
//
// The Assemble role deliberately keeps a bare `clang` resolved through PATH.
// On macOS, Homebrew LLVM is placed there so `llvm-link`, `llvm-as`, and clang
// come from one compatible toolchain; compiling LLVM IR to a Mach-O object does
// not ask clang to own the Darwin SDK/linker contract. The final Link role is
// separate and resolves Apple's driver in `backend.sfn` (SFN-1077).
import { ParallelProcessTask, _cr_resolve_jobs, _cr_run_bounded_processes } from "../capsule_emit_parallel";
import {
    LlvmArtifactRequest,
    classify_object_source,
    llvm_artifact_argv,
    llvm_artifact_cache_key,
    run_llvm_artifact
} from "./artifact_compile";
import {
    _atomic_rename_into_place,
    _ensure_dir_cmd,
    _mktemp_sibling_cmd,
    _sha256_of_file,
    _shell_read_cmd
} from "./fs";
import { sha256_hex_of_string } from "./hash";
import { build_target_triple, host_target_triple, target_clang_flags } from "./target";

// Result of separating LLVM assembly from the final link. `object_paths`
// preserves the input order exactly; callers splice the returned objects
// wherever the corresponding `.ll` inputs appeared in their historical link
// layout.
struct LinkObjectAssembly {
    success: boolean;
    object_paths: string[];
}

struct PendingLinkObjectAssembly {
    fallback_path: string;
    ll_path: string;
    object_index: int;
    object_path: string;
    staged_path: string;
    task: ParallelProcessTask;
}

fn _link_input_task(ll_path: string, out_path: string, opt_flag: string) -> ParallelProcessTask ![io] {
    return ParallelProcessTask {
        argv: llvm_artifact_argv(LlvmArtifactRequest {
            ir_path: ll_path, object_path: out_path, opt_flag: opt_flag
        })
    };
}

// Assemble a list of textual LLVM modules before the final link (SFN-453).
//
// The content-addressed key covers every input that changes clang's object
// output: IR bytes, optimization level, target flags, clang identity, and the
// section-splitting flag scheme owned by `_clang_object_argv`. The
// LLVM-artifact namespace fold (SFN-950) keeps these objects out of the
// foreign-C key space. Objects live under the caller's work/shared cache. If
// that cache is unwritable, use an ephemeral object beside the `.ll` input
// instead of falling back to feeding raw IR into the final link; the
// object-only backend boundary is invariant.
fn assemble_link_inputs(ll_paths: string[], object_dir: string, opt_flag: string) -> LinkObjectAssembly ![io] {
    // Fail closed on a misrouted artifact before any cache or spawn work
    // (SFN-950, SFEP-0066 §3.3): this provider owns LLVM text only, so a
    // `c-sources` entry that reached a link plan is rejected here rather
    // than compiled through the LLVM path.
    let mut ci: int = 0;
    loop {
        if ci >= ll_paths.length { break; }
        if classify_object_source(ll_paths[ci]) != "llvm" {
            print("sfn build: link input is not an LLVM artifact: " + ll_paths[ci]);
            return LinkObjectAssembly { success: false, object_paths: [] };
        }
        ci += 1;
    }
    _ensure_dir_cmd(object_dir);
    let triple = build_target_triple();
    let target_flags = target_clang_flags(triple, host_target_triple());
    let clang_line = _shell_read_cmd("clang --version 2>/dev/null | head -n 1");
    let mut target_key: string = triple;
    let mut ti: int = 0;
    loop {
        if ti >= target_flags.length { break; }
        target_key = target_key + "\n" + target_flags[ti];
        ti += 1;
    }
    let toolchain_key = llvm_artifact_cache_key(clang_line + "\n" + target_key
        + "\nlink-obj-v1-secsplit1");
    let mut objects: string[] = [];
    let mut pending: PendingLinkObjectAssembly[] = [];
    let mut can_parallel: boolean = true;
    let mut i: int = 0;
    loop {
        if i >= ll_paths.length { break; }
        let ll_path = ll_paths[i];
        let content_hash = _sha256_of_file(ll_path);
        if content_hash.length == 0 {
            let fallback_key = sha256_hex_of_string(ll_path + "\n" + opt_flag
                + "\n"
                + toolchain_key);
            let fallback = ll_path + ".link-" + fallback_key + ".o";
            objects.push(fallback);
            can_parallel = false;
            pending.push(PendingLinkObjectAssembly {
                fallback_path: fallback, ll_path: ll_path, object_index: objects.length - 1, object_path: "", staged_path: "", task: _link_input_task(ll_path, fallback, opt_flag)
            });
            i += 1;
            continue;
        }
        let cache_key = content_hash + "\n" + opt_flag + "\n" + toolchain_key;
        let key_hash = sha256_hex_of_string(cache_key);
        let obj_path = object_dir + "/" + key_hash + ".o";
        if fs.exists(obj_path) {
            objects.push(obj_path);
            i += 1;
            continue;
        }

        let tmp = _mktemp_sibling_cmd(obj_path);
        let fallback = ll_path + ".link-" + key_hash + ".o";
        if tmp.length > 0 {
            objects.push(obj_path);
            pending.push(PendingLinkObjectAssembly {
                fallback_path: fallback, ll_path: ll_path, object_index: objects.length - 1, object_path: obj_path, staged_path: tmp, task: _link_input_task(ll_path, tmp, opt_flag)
            });
        } else {
            // Cache publication cannot be staged without a sibling temp. The
            // source scratch is the recoverable fallback location and is
            // cleaned with the owning build/test invocation.
            objects.push(fallback);
            can_parallel = false;
            pending.push(PendingLinkObjectAssembly {
                fallback_path: fallback, ll_path: ll_path, object_index: objects.length - 1, object_path: obj_path, staged_path: "", task: _link_input_task(ll_path, fallback, opt_flag)
            });
        }
        i += 1;
    }

    let mut jobs = _cr_resolve_jobs();
    if !can_parallel { jobs = 1; }
    let results = _cr_run_bounded_processes(_link_object_tasks(pending), jobs);
    let mut pi: int = 0;
    loop {
        if pi >= pending.length { break; }
        if results[pi] != 0 {
            _delete_link_object_staging(pending);
            return LinkObjectAssembly { success: false, object_paths: [] };
        }
        pi += 1;
    }
    pi = 0;
    loop {
        if pi >= pending.length { break; }
        let item = pending[pi];
        if item.staged_path.length > 0 {
            if _atomic_rename_into_place(item.staged_path, item.object_path) {
                objects[item.object_index] = item.object_path;
            } else {
                if run_llvm_artifact(LlvmArtifactRequest {
                    ir_path: item.ll_path, object_path: item.fallback_path, opt_flag: opt_flag
                }) != 0 {
                    _delete_link_object_staging(pending);
                    return LinkObjectAssembly {
                        success: false,
                        object_paths: []
                    };
                }
                objects[item.object_index] = item.fallback_path;
            }
        }
        pi += 1;
    }
    return LinkObjectAssembly { success: true, object_paths: objects };
}

fn _delete_link_object_staging(pending: PendingLinkObjectAssembly[]) ![io] {
    let mut i: int = 0;
    loop {
        if i >= pending.length { break; }
        if pending[i].staged_path.length > 0 {
            fs.deleteFile(pending[i].staged_path);
        }
        i += 1;
    }
}

fn _link_object_tasks(pending: PendingLinkObjectAssembly[]) -> ParallelProcessTask[] {
    let mut tasks: ParallelProcessTask[] = [];
    let mut i: int = 0;
    loop {
        if i >= pending.length { break; }
        tasks.push(pending[i].task);
        i += 1;
    }
    return tasks;
}

export { LinkObjectAssembly, assemble_link_inputs };
