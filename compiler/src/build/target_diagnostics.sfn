// compiler/src/build/target_diagnostics.sfn
//
// The E0614 "unsupported --target triple" diagnostic, shared by `sfn build
// --target` and `sfn emit --target` (SFN-923 review C1). Previously
// duplicated as two message literals (`cli/commands/build.sfn` and
// `cli/commands/emit.sfn`), so the supported-triple list lived in two
// places that a future addition to `triple_is_supported`'s closed set
// (`./target.sfn`) could silently diverge — the exact drift sharing a
// diagnostic is meant to prevent. One source of truth; both commands now
// render byte-identical text for the identical mistake.
//
// Also holds the `sfn build --static` (SFN-1268) diagnostics: E0625 for the
// closed triple set static linking supports, E0626 for a resolvable target
// whose static prerequisites are missing on the host; and E0628, the
// ordinary dynamic link's equivalent of E0626 on a target that owns Link
// (SFN-953).
import { Diagnostic } from "sfn/analyzer/typecheck_types";

import { index_of } from "../string_utils";

// The closed-set hint text shared by every "unsupported triple" message,
// regardless of the value's provenance (`--target` flag vs. an ambient
// `SAILFIN_TARGET_TRIPLE`, `cli/commands/build.sfn`) — one literal for
// `triple_is_supported`'s (`./target.sfn`) closed set instead of one per
// message.
fn supported_targets_hint() -> string {
    return "(supported: x86_64-unknown-linux-gnu, aarch64-unknown-linux-gnu, "
        + "x86_64-apple-darwin, arm64-apple-darwin, x86_64-pc-windows-msvc, "
        + "x86_64-w64-mingw32)";
}

fn unsupported_target_diagnostic(triple: string) -> Diagnostic {
    return Diagnostic {
        code: "E0614",
        severity: "error",
        message: "unsupported --target triple: \"" + triple + "\" "
            + supported_targets_hint(),
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// --static supports a narrower closed set than --target (Linux glibc only,
// SFN-1268) — deliberately not `supported_targets_hint()`, whose wider
// --target set includes triples --static rejects.
fn static_unsupported_target_diagnostic(triple: string) -> Diagnostic {
    return Diagnostic {
        code: "E0625",
        severity: "error",
        message: "--static is not supported for target triple: \"" + triple
            + "\" (supported: x86_64-unknown-linux-gnu, aarch64-unknown-linux-gnu)",
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// `resolve_direct_ld_lld`'s `reason` for a linker override (`SAILFIN_LINKER`
// or a user-config pin) other than lld/ld.lld reads "<origin>=<value> defers
// to clang" — a host-configuration choice, not a missing static artifact.
// Sending that case the glibc-install hint would tell a developer with a
// fully-provisioned host to install packages they already have, so the hint
// branches on the reason class instead (SFN-1268).
fn _static_prerequisite_hint(reason: string) -> string {
    // Since SFN-953 the provider override is resolved ahead of the OS
    // dispatch, so `--static` can now surface a SAILFIN_LINK_PROVIDER
    // reason here. Without this branch it would reach the glibc-static
    // hint below and tell the user to install packages that have nothing
    // to do with the knob they actually set.
    if index_of(reason, "SAILFIN_LINK_PROVIDER") >= 0 {
        return " (hint: --static requires the direct ld.lld path; unset SAILFIN_LINK_PROVIDER or set it to `direct`)";
    }
    if index_of(reason, "defers to clang") >= 0 {
        return " (hint: --static requires the direct ld.lld path; unset SAILFIN_LINKER or remove the [linker] pin from your user config)";
    }
    return " (hint: install your distribution's static glibc and libgcc packages, e.g. glibc-static / libc6-dev + libgcc-*-dev)";
}

// Fail-closed refusal: for the embedded targets --static serves, a dynamic
// binary is a worse outcome than a build error, so a missing static
// prerequisite on the host is an error rather than a silent fallback to a
// dynamic link.
fn static_prerequisites_diagnostic(triple: string, reason: string) -> Diagnostic {
    return Diagnostic {
        code: "E0626",
        severity: "error",
        message: "--static could not resolve its static link prerequisites for "
            + triple
            + ": "
            + reason
            + _static_prerequisite_hint(reason),
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// `resolve_direct_ld_lld`'s reasons fall into three remediation classes, and
// sending the wrong hint is worse than sending none: telling a developer to
// install glibc packages they already have is the exact failure
// `_static_prerequisite_hint` was split to avoid (SFN-1268).
fn _direct_link_prerequisite_hint(triple: string, reason: string) -> string {
    if index_of(reason, "SAILFIN_LINK_PROVIDER") >= 0 {
        return " (hint: unset SAILFIN_LINK_PROVIDER, or set it to `direct` or `clang-oracle`)";
    }
    if triple == "arm64-apple-darwin" {
        return " (hint: select a complete Xcode or Command Line Tools installation and check SDKROOT, SAILFIN_LINKER, and MACOSX_DEPLOYMENT_TARGET)";
    }
    if index_of(reason, "ld.lld") >= 0 {
        // Name the escape hatch too. A mold-only host is the common way to
        // hit this, and `SAILFIN_LINKER=mold` is a supported selection that
        // keeps it building (SFEP-0066 §3.1 exempts an explicitly chosen
        // provider from the ownership claim) — telling such a developer
        // only to install lld would send them to change a machine that is
        // configured the way the docs told them to configure it.
        return " (hint: install your distribution's lld package, e.g. lld / llvm, so ld.lld is on PATH; or select another linker explicitly with SAILFIN_LINKER=<name>)";
    }
    return " (hint: install your distribution's C development packages, e.g. libc6-dev + gcc / glibc-devel + libgcc, which supply the startup objects and ELF loader)";
}

// Fail-closed refusal for the Link role on a target Sailfin OWNS (SFEP-0066
// §3.2: glibc Linux x86-64 and aarch64). Falling back to the clang driver
// here would mean the provider that executed is not the provider claimed,
// which is the precise thing §3.1 forbids — "fallback is not ownership".
//
// Only reached when `requires_direct_link` is true, so an unowned target
// (Darwin/SFN-954, Windows/SFN-955) and an explicit provider selection
// still take the legacy route without seeing this diagnostic.
fn direct_link_prerequisites_diagnostic(triple: string, reason: string) -> Diagnostic {
    let mut owner = "direct ld.lld";
    if triple == "arm64-apple-darwin" { owner = "direct Apple ld"; }
    return Diagnostic {
        code: "E0628",
        severity: "error",
        message: "could not resolve the " + owner + " link prerequisites for "
            + triple
            + ": "
            + reason
            + _direct_link_prerequisite_hint(triple, reason),
        file_path: "",
        primary: null,
        suggestion: null
    };
}

export {
    direct_link_prerequisites_diagnostic,
    static_prerequisites_diagnostic,
    static_unsupported_target_diagnostic,
    supported_targets_hint,
    unsupported_target_diagnostic
};
