// compiler/src/build/llvm_provider_context.sfn
//
// Driver-side resolution for the LLVM provider's primitive input context.
// Target and debug/test state remain compiler-driver concerns; codegen-LLVM
// receives the resolved snapshot and owns only pure lowering decisions.
import { LLVMProviderContext } from "sfn/codegen-llvm";
import { ImportedModuleContext } from "sfn/ir";

import { _env_flag, _get_env_cmd, _legacy_flag_file } from "../build_flags";
import { test_runner_active, test_runner_trace } from "../test_runner_state";
import { build_target_os, build_target_triple, triple_target_arch } from "./target";

// SFN-923: consults the resolved TARGET triple before falling back to a
// host probe. Previously this probed the HOST unconditionally, so
// `--target=aarch64-unknown-linux-gnu` on an x86_64 host resolved
// `x86_64` codegen — in the parent as well as every emit child, since the
// wrong value was baked into the LLVM provider context both sides
// installed. `SAILFIN_TARGET_ARCH` keeps top precedence (the existing
// override contract, mirrored by `direct_link.sfn`'s own arch probe per
// the three-probes-must-agree note at `target.sfn:189-193`).
fn _resolve_llvm_target_arch() -> string ![io] {
    let target_override = _get_env_cmd("SAILFIN_TARGET_ARCH");
    if target_override.length > 0 { return target_override; }
    let from_triple = triple_target_arch(build_target_triple());
    if from_triple.length > 0 { return from_triple; }
    if fs.exists("/lib/ld-linux-aarch64.so.1") { return "aarch64"; }
    return "x86_64";
}

fn resolve_llvm_provider_context() -> LLVMProviderContext ![io] {
    return LLVMProviderContext {
        target_os: build_target_os(),
        target_arch: _resolve_llvm_target_arch(),
        trace_lowering: _env_flag("SAILFIN_TRACE_LOWERING") || _legacy_flag_file("build/sailfin/.trace_lowering"),
        trace_call_lowering: _env_flag("SAILFIN_TRACE_CALL_LOWERING")
            || _legacy_flag_file("build/sailfin/.trace_call_lowering"),
        skip_module_globals: _env_flag("SAILFIN_SKIP_MODULE_GLOBALS")
            || _legacy_flag_file("build/sailfin/.skip_module_globals"),
        test_runner_active: test_runner_active(),
        test_runner_trace: test_runner_trace()
    };
}

fn empty_llvm_import_context() -> ImportedModuleContext {
    return ImportedModuleContext {
        manifests: [],
        native_texts: [],
        diagnostics: [],
        module_aliases: []
    };
}

export { empty_llvm_import_context, resolve_llvm_provider_context };
