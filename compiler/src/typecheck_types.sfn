// compiler/src/typecheck_types.sfn
//
// Struct, enum, interface, and model validation helpers for typechecking.
// Extracted from typecheck.sfn to keep file sizes manageable.
import {
    EnumVariant,
    Expression,
    FieldDeclaration,
    FunctionSignature,
    InterfaceFieldMember,
    MethodDeclaration,
    SourceSpan,
    Statement,
    TypeAnnotation,
    TypeParameter
} from "./ast";
import { Diag, FixSuggestion, diag_from_typecheck } from "./diagnostic";
import {
    char_code_at_text,
    contains_string,
    ends_with,
    index_of,
    starts_with,
    strings_equal,
    strip_prefix,
    substring
} from "./string_utils";
import { Token, TokenKind } from "./token";
import {
    check_bare_fn_type_annotation,
    check_malformed_array_annotation,
    check_unknown_type_annotation,
    type_parameter_names
} from "./typecheck_types/annotation_shape_checks";
import {
    extern_type_contains_array_brackets,
    extern_type_uses_string,
    is_c_abi_parameter_type,
    is_c_abi_return_type,
    make_extern_effects_diagnostic,
    make_extern_parameter_missing_type_diagnostic,
    make_extern_parameter_type_diagnostic,
    make_extern_return_type_diagnostic,
    make_extern_type_parameters_diagnostic,
    make_extern_var_missing_type_diagnostic,
    make_extern_var_type_diagnostic
} from "./typecheck_types/extern_abi";
import {
    format_interface_signature,
    parse_type_arguments,
    resolve_interface_annotation
} from "./typecheck_types/interface_and_generics";
import { SymbolEntry, find_symbol, make_duplicate_symbol_diagnostic } from "./typecheck_types/symbol_table_and_raw_exprs";
import {
    extract_generic_argument_block,
    find_matching_paren,
    is_ascii_upper,
    is_identifier_char,
    join_with_separator,
    number_to_string,
    slice_text,
    split_generic_argument_list,
    split_top_level_ampersand,
    split_top_level_commas,
    token_from_name,
    trim_text
} from "./typecheck_types/text_utils";

struct Diagnostic {
    code: string;
    severity: string;
    message: string;
    file_path: string;
    primary: Token?;
    // B3: optional structured fix-it. `null` for diagnostics that
    // don't carry an automatic fix today (W01xx load warnings,
    // typecheck factories until B3 stage 2 promotes them). Appended
    // last so the seed compiler's positional GEP indexing stays
    // stable for existing field reads — the canonical re-export RCA
    // (`docs/rca/2026-04-18-reexport-diagnostic-gep.md`) bit this
    // struct hard once already; the `_reject_reexport_violations`
    // gate now backstops it but we still respect the discipline.
    suggestion: FixSuggestion?;
}

// Frontend-only typed wrapper around the leaf module's primitive converter.
// Token → Span uses the historical renderer width: end column is the start
// column plus the token lexeme length.
fn diagnostic_to_diag(diagnostic: Diagnostic, stage: string) -> Diag {
    let mut primary_line: int = 0;
    let mut primary_column: int = 0;
    let mut primary_lexeme_length: int = 0;
    let mut has_primary: boolean = false;
    if diagnostic.primary != null {
        let primary: Token? = diagnostic.primary;
        primary_line = primary.line;
        primary_column = primary.column;
        primary_lexeme_length = primary.lexeme.length;
        has_primary = true;
    }
    return diag_from_typecheck(diagnostic.code, diagnostic.severity, diagnostic.message, diagnostic.file_path, primary_line, primary_column, primary_lexeme_length, has_primary, stage, diagnostic.suggestion);
}

// SFN-385: the closed set of genuine method-call forms per primitive receiver —
// names the lowerer dispatches via a runtime *method descriptor* rather than by
// fusing the receiver into a free function. Source of truth is the descriptor
// table in `llvm/runtime_helpers.sfn` (string descriptors: `substring`,
// `substring_unchecked`, `grapheme_at`); ported by name only (no `llvm/` import)
// so typecheck can consult it. Every other valid "method" resolves through
// free-function fusion, handled by the caller's callable gate — so this table
// stays small on purpose. When runtime_helpers.sfn adds a primitive method
// descriptor, mirror the name here (the same mirror-on-add contract
// `channel_element_kind` carries). Numeric/boolean primitives have no method
// descriptors (their operations are operators / free functions).
fn primitive_has_method(prim: string, name: string) -> boolean {
    if strings_equal(prim, "string") {
        if strings_equal(name, "substring") { return true; }
        if strings_equal(name, "substring_unchecked") { return true; }
        if strings_equal(name, "grapheme_at") { return true; }
        return false;
    }
    return false;
}

// E0012: a method call on a primitive receiver that resolves to no primitive
// method and no in-scope free function. The fix-it steers `string` uppercase /
// lowercase attempts to the free functions `ascii_uppercase` / `ascii_lowercase`
// (`sfn/strings`); otherwise it points at the free-function form (SFN-385).
fn make_unknown_primitive_method_diagnostic(prim: string, member: string, anchor: Token?) -> Diagnostic {
    let mut fix_message: string = "call it as a free function `" + member
        + "(<receiver>, ...)` if one exists, or check the spelling";
    if strings_equal(prim, "string") {
        if strings_equal(member, "to_uppercase") {
            fix_message = "`string` has no `to_uppercase` method; import and call the free function `ascii_uppercase(<receiver>)` from `sfn/strings`";
        } else if strings_equal(member, "to_lowercase") {
            fix_message = "`string` has no `to_lowercase` method; import and call the free function `ascii_lowercase(<receiver>)` from `sfn/strings`";
        }
    }
    let fix = FixSuggestion { message: fix_message, edits: [] };
    return Diagnostic {
        code: "E0012",
        severity: "error",
        message: "method `" + member + "` does not exist on `" + prim + "`; `"
            + prim
            + "` has no such method and no function `"
            + member
            + "` is in scope",
        file_path: "",
        primary: anchor,
        suggestion: fix
    };
}

// E0306: arithmetic that mixes an `int` and a `float` operand. Sailfin does not
// implicitly convert between the two; the fix-it echoes the emitter's own
// guidance (`as float` / `as int`) so users see one voice (SFN-385).
fn make_mixed_arithmetic_diagnostic(left_kind: string, right_kind: string, op: string, span: SourceSpan?) -> Diagnostic {
    let fix = FixSuggestion {
        message: "add `as float` or `as int` to one operand so both sides are the same numeric type",
        edits: []
    };
    return Diagnostic {
        code: "E0306",
        severity: "error",
        message: "arithmetic `" + op + "` mixes `" + left_kind + "` and `"
            + right_kind
            + "`; Sailfin does not implicitly convert between `int` and `float`",
        file_path: "",
        primary: token_from_name(op, span),
        suggestion: fix
    };
}

// E0307: array arithmetic has no language-defined meaning. Array
// concatenation remains available explicitly through `.concat`; rejecting the
// operator here keeps aggregate values out of scalar LLVM arithmetic.
fn make_array_arithmetic_diagnostic(op: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0307",
        severity: "error",
        message: "operator `" + op
            + "` is not defined for array operands; use `.concat(...)` for array concatenation",
        file_path: "",
        primary: token_from_name(op, span),
        suggestion: null
    };
}

// E0308: arithmetic operators have no language-defined meaning for structs.
// The caller proves both operands are explicitly typed bindings whose
// annotations resolve to top-level struct declarations (SFN-584).
fn make_struct_arithmetic_diagnostic(left_type: string, right_type: string, op: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0308",
        severity: "error",
        message: "operator `" + op + "` is not defined for struct operands `"
            + left_type
            + "` and `"
            + right_type
            + "`",
        file_path: "",
        primary: token_from_name(op, span),
        suggestion: null
    };
}

// -------------------------------------------------------------------
// SFEP-0039 (#1860): nominal object model — honest rejection of the
// TypeScript-shaped data constructs the nominal backend never
// implemented. E0828 rejects a bare object literal without a concrete
// `struct` target; E0829 rejects `A & B` used as a data / value type.
// Data is only ever constructed through a concrete `struct` (the #1855
// object-literal path). Design record:
// docs/proposals/0039-nominal-object-model.md.
// -------------------------------------------------------------------
// A type annotation is an intersection when two or more operands are
// joined by a top-level `&` (`A & B`, `Admin & User`). A stray leading
// or trailing `&`, or a `&` only inside generic arguments, yields
// fewer than two operands and is not treated as an intersection.
fn type_annotation_is_intersection(text: string) -> boolean {
    return split_top_level_ampersand(text).length >= 2;
}

// E0829: an intersection `A & B` used as a data / value type. The
// fix-it steers to the two sanctioned paths — a concrete `struct`
// implementing both interfaces, or a generic bound when the intent is
// "a value satisfying both" (SFEP-0038 bounds are `+`-separated).
fn make_intersection_value_type_diagnostic(type_text: string, anchor: Token?) -> Diagnostic {
    let bare = trim_text(type_text);
    let fix = FixSuggestion {
        message: "declare a concrete `struct` that implements both interfaces and annotate with it; "
            + "for a value satisfying both interfaces in a generic context, use a `+`-separated bound "
            + "such as `<T: A + B>` (SFEP-0038)",
        edits: []
    };
    return Diagnostic {
        code: "E0829",
        severity: "error",
        message: "intersection type `" + bare
            + "` is not a data type; `A & B` is reserved for generic trait bounds",
        file_path: "",
        primary: anchor,
        suggestion: fix
    };
}

// Reject an intersection `A & B` in any value / type-annotation
// position (variable, parameter, struct/enum field, return type, and
// the RHS of a `type X = A & B` alias). Bound position (`<T: A + B>`)
// is resolved through `check_type_parameters`, never this helper, so
// generic bounds are untouched (SFEP-0039 §3.3).
fn check_intersection_value_type_annotation(annotation: TypeAnnotation?, anchor_name: string, anchor_span: SourceSpan?) -> Diagnostic[] {
    if annotation == null { return []; }
    if !type_annotation_is_intersection(annotation.text) { return []; }
    return [make_intersection_value_type_diagnostic(annotation.text, token_from_name(anchor_name, anchor_span))];
}

// E0827: a data-field-shaped interface member (`name: Type`). Interfaces
// are method-only contracts (SFEP-0039 §3.1); a data field belongs on a
// concrete `struct` that implements the interface, not on the interface.
// The parser (interface member loop) records the field-shaped members it
// could not parse as method signatures; this factory turns each into the
// diagnostic that was silently dropped before.
fn make_interface_field_member_diagnostic(name: string, span: SourceSpan?) -> Diagnostic {
    let fix = FixSuggestion {
        message: "declare a `struct` with this field and have the struct implement the "
            + "interface (interfaces carry only method signatures)",
        edits: []
    };
    return Diagnostic {
        code: "E0827",
        severity: "error",
        message: "interface members must be method signatures; `" + name
            + "` is a data field",
        file_path: "",
        primary: token_from_name(name, span),
        suggestion: fix
    };
}

// Turn every field-shaped interface member the parser captured into an
// `E0827` diagnostic. A method-only interface captures none, so this
// returns empty and leaves such interfaces unaffected.
fn check_interface_field_members(field_members: InterfaceFieldMember[]) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];
    let mut _fmi: int = 0;
    loop {
        if _fmi >= field_members.length { break; }
        let fm = field_members[_fmi];
        diagnostics.push(make_interface_field_member_diagnostic(fm.name, fm.name_span));
        _fmi += 1;
    }
    return diagnostics;
}

// E0828: a bare object literal whose target is not a concrete `struct`.
// `kind` selects the wording: "interface" (target names an interface),
// "array" (target is an array type `T[]` — an object literal never
// yields an array, so this fires regardless of the element type), or
// "uninferable" (unannotated binding with no contextual struct target).
fn make_object_literal_requires_struct_diagnostic(target: string, kind: string, anchor_name: string, anchor_span: SourceSpan?) -> Diagnostic {
    let anchor = token_from_name(anchor_name, anchor_span);
    let mut message: string = "";
    let mut fix_message: string = "declare a `struct` with these fields and annotate the binding with it "
        + "(data is constructed only through concrete structs)";
    if strings_equal(kind, "interface") {
        message = "object literal requires a concrete `struct` type; `"
            + trim_text(target)
            + "` is an interface, not a struct";
    } else if strings_equal(kind, "array") {
        message = "object literal requires a concrete `struct` type; `"
            + trim_text(target)
            + "` is an array type, and an object literal never yields an array";
        fix_message = "build each element and collect them into an array literal `[...]`, "
            + "or annotate with the concrete `struct` element type for a single value";
    } else {
        message = "object literal requires a concrete `struct` type annotation; "
            + "its target type cannot be inferred";
    }
    let fix = FixSuggestion { message: fix_message, edits: [] };
    return Diagnostic {
        code: "E0828",
        severity: "error",
        message: message,
        file_path: "",
        primary: anchor,
        suggestion: fix
    };
}

// Head type name of a value annotation, stripping a trailing optional
// marker (`Named?` -> `Named`) so an object literal targeting an
// optional interface is still classified by its head type. Array and
// generic-instantiation-head normalization is layered on top by the
// caller via `_object_literal_target_is_array` / `_object_literal_head_base`.
fn _object_literal_head_type(text: string) -> string {
    let mut head = trim_text(text);
    loop {
        if head.length == 0 { break; }
        if head[head.length - 1] == "?" {
            head = trim_text(substring(head, 0, head.length - 1));
        } else { break; }
    }
    return head;
}

// True when the object-literal target's head is an array type (`T[]`).
// An object literal never produces an array, so an array target is
// rejected regardless of the element type — the caller short-circuits
// on this before the head-symbol lookup (SFEP-0039 §3.2). Match the `[]`
// suffix specifically (not any trailing `]`) so a future `]`-terminated
// type form or a malformed annotation is not mistaken for an array.
fn _object_literal_target_is_array(head: string) -> boolean {
    if head.length < 2 { return false; }
    return head[head.length - 2] == "[" && head[head.length - 1] == "]";
}

// Base name of a possibly-generic head (`Box<int>` -> `Box`,
// `Named` -> `Named`), so a generic-instantiation target is classified
// by its base symbol rather than the raw instantiation text — which
// `find_symbol` would otherwise miss.
fn _object_literal_head_base(head: string) -> string {
    let mut index: int = 0;
    loop {
        if index >= head.length { break; }
        if head[index] == "<" {
            return trim_text(substring(head, 0, index));
        }
        index += 1;
    }
    return head;
}

// Reject a bare object literal (`{ ... }`) whose target type is not a
// registered concrete `struct`: an interface target, or an
// un-inferable unannotated binding. A direct or aliased intersection
// target is left to E0829, which takes precedence (SFEP-0039 §3.3); an
// unknown / type-alias / enum target is left unflagged (conservative —
// avoids false positives on imported or aliased names, and the
// alias-to-intersection case is already reported at the alias
// definition). The concrete-`struct` target is the sanctioned #1855
// construction path and compiles unchanged.
fn check_object_literal_target(initializer: Expression?, annotation: TypeAnnotation?, anchor_name: string, anchor_span: SourceSpan?, top_level: SymbolEntry[]) -> Diagnostic[] {
    if initializer == null { return []; }
    if initializer.variant != "Object" { return []; }
    if annotation == null {
        return [make_object_literal_requires_struct_diagnostic("", "uninferable", anchor_name, anchor_span)];
    }
    let text = trim_text(annotation.text);
    if type_annotation_is_intersection(text) { return []; }
    let head = _object_literal_head_type(text);
    if _object_literal_target_is_array(head) {
        return [make_object_literal_requires_struct_diagnostic(head, "array", anchor_name, anchor_span)];
    }
    let base = _object_literal_head_base(head);
    let target = find_symbol(top_level, base);
    if target == null { return []; }
    if strings_equal(target.kind, "interface") {
        // Name the full head (`Container<int>`) in the message so it
        // matches the source annotation verbatim, while still resolving the
        // symbol by `base` (`Container`).
        return [make_object_literal_requires_struct_diagnostic(head, "interface", anchor_name, anchor_span)];
    }
    return [];
}

fn check_struct_fields(fields: FieldDeclaration[], known: string[], type_params: string[]) -> Diagnostic[] {
    let mut seen: string[] = [];
    let mut diagnostics: Diagnostic[] = [];

    let mut _fi: int = 0;
    loop {
        if _fi >= fields.length { break; }
        let field = fields[_fi];
        let name = field.name;
        if contains_string(seen, name) {
            diagnostics.push(make_duplicate_symbol_diagnostic(name, "struct field", token_from_name(name, field.name_span)));
        } else { seen.push(name); }
        diagnostics = diagnostics.concat(check_bare_fn_type_annotation(field.type_annotation, name, field.name_span));
        diagnostics = diagnostics.concat(check_malformed_array_annotation(field.type_annotation, name, field.name_span));
        diagnostics = diagnostics.concat(check_unknown_type_annotation(field.type_annotation, name, field.name_span, known, type_params));
        diagnostics = diagnostics.concat(check_intersection_value_type_annotation(field.type_annotation, name, field.name_span));
        _fi += 1;
    }

    return diagnostics;
}

// === `?` operator (TryOperator) type support — issue #833, epic #371 (R.3) ===
//
// `?` unwraps a `Result<T, E>`: on `Ok` it yields `T`; on `Err` it early-
// returns the error. Per the proposal §Type rules (Q2):
//   1. the operand must be a `Result<T, E>`            -> else E0810
//   2. the enclosing fn must return `Result<U, F>`     -> else E0811
//   3. `E` must equal `F` exactly (no `From` coercion) -> else E0812
//   4. the expression's type is the unwrapped `T`.
// Types are plain strings throughout the checker (there is no expression-
// type inferencer — #829), so these operate on type-annotation text and
// reuse `parse_type_arguments` to split `Result<T, E>` into `[T, E]`. Like
// the #829 substitution primitives they are directly callable and driven
// by `result_question_typecheck_test.sfn`; the rule orchestration lives in
// `typecheck.sfn` (`check_try_operator` / `try_operator_result_type`).
// True when `type_text` names a bare `Result<T, E>` instantiation: the
// head identifier is exactly `Result`, exactly two type arguments are
// present, and the closing `>` is the final token. The trailing-`>` check
// rejects a nullable `Result<T, E>?` — an optional `Result` is not a
// `Result`, so `?` applied to it must still trip E0810.
fn type_is_result(type_text: string) -> boolean {
    let trimmed = trim_text(type_text);
    if !starts_with(trimmed, "Result<") { return false; }
    if !ends_with(trimmed, ">") { return false; }
    return parse_type_arguments(trimmed).length == 2;
}

// The `[T, E]` type-argument pair of a `Result<T, E>` annotation, or an
// empty array when `type_text` is not a 2-arg `Result`. Callers gate on
// `type_is_result` before indexing.
fn result_type_arguments(type_text: string) -> string[] {
    if !type_is_result(type_text) { return []; }
    return parse_type_arguments(trim_text(type_text));
}

// E0810 — `?` applied to a value whose type is not `Result<T, E>` (rule 1).
fn make_try_non_result_operand_diagnostic(operand_type: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0810",
        severity: "error",
        message: "`?` applied to a non-`Result` value of type `" + trim_text(operand_type)
            + "`; the `?` operator only unwraps `Result<T, E>`.",
        file_path: "",
        primary: token_from_name("?", span),
        suggestion: null
    };
}

// E0811 — `?` used in a function whose declared return type is not
// `Result<U, F>` (rule 2). `return_type` is the surface return-type text
// (or "void" when the function declares no return type).
fn make_try_non_result_fn_diagnostic(return_type: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0811",
        severity: "error",
        message: "`?` is only valid in a function returning `Result`, but"
            + " the enclosing function returns `"
            + trim_text(return_type)
            + "`. Change the return type to `Result<_, E>` or handle the"
            + " error with `match`.",
        file_path: "",
        primary: token_from_name("?", span),
        suggestion: null
    };
}

// E0812 — the operand's error type differs from the enclosing function's
// error type (rule 3). `?` requires an exact match — there is no `From`
// coercion yet (Q2, deferred until generic constraints land). Both types
// are named in the message.
fn make_try_error_type_mismatch_diagnostic(operand_error: string, fn_error: string, span: SourceSpan?) -> Diagnostic {
    let message = "`?` error type mismatch: the operand's error type `"
        + trim_text(operand_error)
        + "` differs from the enclosing function's error type `"
        + trim_text(fn_error)
        + "`. `?` requires an exact match (no `From` coercion yet).";
    return Diagnostic {
        code: "E0812",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name("?", span),
        suggestion: null
    };
}

// =============================================================================
// Ternary `Conditional` type rules (issue #1715, epic #1180)
// =============================================================================
// A ternary `cond ? then : else` (#1690's `Expression.Conditional`) requires a
// boolean condition and two branches that unify to one type. Types are plain
// strings throughout the checker (no expression-type inferencer — #829), so
// these operate on the literal-inferred type strings produced by
// `_conditional_branch_type` (`typecheck.sfn`); a branch or condition whose type
// cannot be inferred is left unconstrained rather than reported, so no valid
// program is rejected on a type the checker cannot yet see. Unification is
// exact/null-compatible only — branch coercion beyond that is deferred (#1715
// Out). The rule orchestration lives in `typecheck.sfn`
// (`check_conditional_types`).
// E0304 — a ternary's two branches have incompatible (non-unifiable) types.
fn make_conditional_branch_mismatch_diagnostic(then_type: string, else_type: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0304",
        severity: "error",
        message: "ternary branches have incompatible types: the `then` branch is `"
            + trim_text(then_type)
            + "` but the `else` branch is `"
            + trim_text(else_type)
            + "`. Both branches of a `?:` must produce the same type.",
        file_path: "",
        primary: token_from_name("?", span),
        suggestion: null
    };
}

// E0305 — a ternary's condition is not a boolean.
fn make_conditional_non_boolean_condition_diagnostic(condition_type: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0305",
        severity: "error",
        message: "ternary condition must be `boolean`, but has type `"
            + trim_text(condition_type)
            + "`. The condition of a `?:` must be a boolean expression.",
        file_path: "",
        primary: token_from_name("?", span),
        suggestion: null
    };
}

// =============================================================================
// Concurrency kind resolution (issue #1082, epic #965, M4 — decision B)
// =============================================================================
// Types are monomorphized into SIX future/channel kinds: void, number, int,
// bool, string, ptr (`runtime_helpers.sfn:463-516`). There is NO parametric
// `Future<T>` and NO generics prerequisite — the runtime never sees a
// parametric future. `spawn`/`await`/`channel` are typed by resolving a
// declared return-type / element-type annotation STRING to one of these six
// kinds; the resolved kind tags the AST node so emit-native (#1084) selects
// the matching `spawn_*`/`await_*`/`channel_*` helper.
//
// Like the `?`-operator rules above, these are driven against explicit type
// strings: the checker has no expression-type inferencer (#829), so live
// await/channel-send enforcement waits on that workstream. The unit tests in
// `concurrency_typecheck_test.sfn` exercise the helpers directly.
// Resolve a callee's declared return-type annotation to its future kind, one
// of "void"|"number"|"int"|"bool"|"string"|"ptr". Returns "" when the text is
// empty (no declared return type) — the caller turns that into E0813. This is
// the typecheck-side MIRROR of `llvm/type_mapping.sfn`'s
// `future_pointer_type_for_return_type` / `spawn_symbol_for_return_type`
// (`:831-905`); keep the two in lockstep so #1084's emission agrees with the
// kind tagged here. Like the canonical resolver, ownership wrappers
// (`Affine<T>`/`Linear<T>`) are stripped before classification so a callee
// declared `-> Affine<int>` tags `int`, not `ptr`.
fn spawn_future_kind(return_type_text: string) -> string {
    let trimmed = trim_text(return_type_text);
    if trimmed.length == 0 { return ""; }
    let normalized = unwrap_ownership_wrapper(trimmed);
    if strings_equal(normalized, "void") { return "void"; }
    if strings_equal(normalized, "number") { return "number"; }
    if strings_equal(normalized, "int") { return "int"; }
    if strings_equal(normalized, "i64") { return "int"; }
    if strings_equal(normalized, "u64") { return "int"; }
    if strings_equal(normalized, "usize") { return "int"; }
    if strings_equal(normalized, "isize") { return "int"; }
    if strings_equal(normalized, "bool") { return "bool"; }
    if strings_equal(normalized, "boolean") { return "bool"; }
    if strings_equal(normalized, "string") { return "string"; }
    // Unknown/user types (structs, arrays, pointers) lower through the opaque
    // pointer future — the canonical catch-all (`type_mapping.sfn:854`).
    return "ptr";
}

// Strip ownership wrappers (`Affine<T>`/`Linear<T>`) before kind
// classification, mirroring `llvm/type_mapping.sfn:unwrap_move_wrapper`
// (`:82-98`). Recurses so nested wrappers (`Affine<Linear<int>>`) resolve to
// the innermost type. Reuses `extract_generic_argument_block` to lift the
// `<...>` payload.
fn unwrap_ownership_wrapper(annotation: string) -> string {
    let trimmed = trim_text(annotation);
    if trimmed.length == 0 { return trimmed; }
    let mut is_wrapped: boolean = false;
    if starts_with(trimmed, "Affine<") { is_wrapped = true; }
    if starts_with(trimmed, "Linear<") { is_wrapped = true; }
    if !is_wrapped { return trimmed; }
    if !ends_with(trimmed, ">") { return trimmed; }
    let inner = extract_generic_argument_block(trimmed);
    if inner == null { return trimmed; }
    return unwrap_ownership_wrapper(trim_text(inner));
}

// True iff a type annotation names a uniquely-owned / affine value
// (`OwnedBuf`, `Affine<T>`, `Linear<T>`). Shared classifier so the
// ownership checker (`ownership_checker.sfn`) and the typecheck side
// stay in lockstep as new owned wrappers are added — the move rules key
// off this, mirroring the prefix set `unwrap_ownership_wrapper` strips.
// The codegen inverse (copy-vs-move) lives in
// `llvm/type_mapping.sfn:is_copy_type`; folding all three into one
// source of truth is tracked as ownership-epic (#1209) follow-up.
//
// The affine/linear wrappers are recognised only in their *parametric*
// form (`Affine<...>` / `Linear<...>`): they always wrap a payload type.
// A bare `Affine`/`Linear` is a user-defined type name (e.g. `struct
// Linear` in the `sfn/layers` capsule — a neural-net layer), so it must
// NOT be classified as a uniquely-owned wrapper, or the move rules would
// falsely move-track / `E0901` a `layer: Linear` passed to a call. This
// matches `is_linear_type` below, which is parametric-only for the same
// reason. `OwnedBuf` is a concrete (non-generic) runtime type used bare,
// so its bare spelling stays load-bearing.
fn is_owned_type(annotation: string) -> boolean {
    let trimmed = trim_text(annotation);
    if strings_equal(trimmed, "OwnedBuf") { return true; }
    if starts_with(trimmed, "OwnedBuf<") { return true; }
    if starts_with(trimmed, "Affine<") { return true; }
    if starts_with(trimmed, "Linear<") { return true; }
    return false;
}

// True iff a type annotation names a *linear* value (`Linear<T>`) — a
// uniquely-owned value that must be used *exactly once* (consumed before
// it leaves scope). The owned-but-not-linear wrappers (`OwnedBuf`,
// `Affine<T>`) are at-most-once and never trigger the must-consume sweep;
// only `Linear<T>` does. Kept beside `is_owned_type` so the linear test
// and the owned test can't drift — the ownership pass
// (`ownership_checker.sfn`) keys the `E0907` non-consumption rule off
// this.
//
// Only the *parametric* form `Linear<...>` is the ownership wrapper: it
// always wraps a payload type. A bare `Linear` is a user-defined type
// name (e.g. `struct Linear` in the `sfn/layers` capsule — a neural-net
// linear layer), so it must NOT be classified as the wrapper, or every
// `layer: Linear` parameter would falsely fire `E0907`. Requiring the
// `<` keeps the wrapper and the ordinary struct distinct.
fn is_linear_type(annotation: string) -> boolean {
    let trimmed = trim_text(annotation);
    if starts_with(trimmed, "Linear<") { return true; }
    return false;
}

// The element kind carried by a future type, or null when `type_text` is not
// one of the six future spellings. `await x` yields this kind (the await→T
// rule). Futures surface as the runtime pointer spellings
// (`%SailfinFuture<Kind>*`) the spawn lowering produces.
fn future_element_kind(type_text: string) -> string? {
    let trimmed = trim_text(type_text);
    if strings_equal(trimmed, "%SailfinFutureVoid*") { return "void"; }
    if strings_equal(trimmed, "%SailfinFutureNumber*") { return "number"; }
    if strings_equal(trimmed, "%SailfinFutureInt*") { return "int"; }
    if strings_equal(trimmed, "%SailfinFutureBool*") { return "bool"; }
    if strings_equal(trimmed, "%SailfinFutureString*") { return "string"; }
    if strings_equal(trimmed, "%SailfinFuturePtr*") { return "ptr"; }
    return null;
}

// The monomorphized element kind a `Channel<T>` type annotation carries
// (#1942), or null when `type_text` is not a channel type. The head name is
// matched before the first `<` so spacing in the captured annotation text
// (`Channel < int >`) still resolves. `T` is classified by the same six-kind
// resolver `spawn_future_kind` applies to spawn/future kinds, so channel-send
// checking agrees with the runtime's six channel kinds. Reuses
// `extract_generic_argument_block` for angle-depth-balanced payload lifting,
// so `Channel<fn() -> void>` resolves `fn() -> void` (→ the ptr catch-all).
fn channel_element_kind(type_text: string) -> string? {
    let trimmed = trim_text(type_text);
    let mut lt: int = -1;
    let mut index: int = 0;
    loop {
        if index >= trimmed.length { break; }
        if trimmed[index] == "<" {
            lt = index;
            break;
        }
        index += 1;
    }
    if lt < 0 { return null; }
    let head = trim_text(slice_text(trimmed, 0, lt));
    if !strings_equal(head, "Channel") { return null; }
    let inner = extract_generic_argument_block(trimmed);
    if inner == null { return null; }
    let resolved = spawn_future_kind(trim_text(inner));
    if resolved.length == 0 { return null; }
    return resolved;
}

// True when `type_text` names one of the six future types.
fn type_is_future(type_text: string) -> boolean {
    return future_element_kind(type_text) != null;
}

// E0813 — `spawn` target has no declared return type, so its future kind
// cannot be determined. Inferring the kind from a bare named-function call or
// an arbitrary expression body needs symbol/expression-type resolution that
// is out of scope (#829); annotate the spawned lambda/fn return type instead.
// E0816 — a parser-originated diagnostic (issue #1531). The expression
// parser emits an `Expression.ParseError` node carrying the message when it
// detects syntax that must fail closed (today: the internal-only
// `spawn:<type>` operator form). The typecheck walk wraps it here so a
// malformed construct surfaces as a real error and `sfn check` exits
// non-zero instead of silently dropping the statement. `message` is the
// full text supplied by the parser arm; `span` locates the offending token.
fn make_parse_error_diagnostic(message: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0816",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name("spawn", span),
        suggestion: null
    };
}

fn make_spawn_unresolvable_kind_diagnostic(span: SourceSpan?) -> Diagnostic {
    let head = "`spawn` target has no declared return type, so its future";
    let mid = " kind cannot be determined. Annotate the spawned lambda/fn";
    let tail = " return type (void, number, int, bool, string, or a"
        + " pointer/struct type).";
    let message = head + mid + tail;
    return Diagnostic {
        code: "E0813",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name("spawn", span),
        suggestion: null
    };
}

// E0814 — `await` applied to a value that is not a future.
fn make_await_non_future_diagnostic(operand_type: string, span: SourceSpan?) -> Diagnostic {
    let head = "`await` applied to a non-future value of type `";
    let tail = "`; `await` only unwraps a future produced by `spawn`.";
    let message = head + trim_text(operand_type) + tail;
    return Diagnostic {
        code: "E0814",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name("await", span),
        suggestion: null
    };
}

// E0815 — a value sent on a channel has a different element kind than the
// channel carries. Both kinds are named.
fn make_channel_send_mismatch_diagnostic(channel_kind: string, sent_kind: string, span: SourceSpan?) -> Diagnostic {
    let head = "channel send element-kind mismatch: the channel carries `";
    let mid = "` but the sent value has kind `";
    let tail = "`.";
    let message = head + trim_text(channel_kind) + mid + trim_text(sent_kind)
        + tail;
    return Diagnostic {
        code: "E0815",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name("channel", span),
        suggestion: null
    };
}

// E0831 — a `spawn` task handle is pushed into a local whose declared
// element kind is the inferred-empty-`[]` sentinel. The empty literal bakes
// the array's LLVM element type as `double`, so the pushed future pointer is
// stored through a double slot and corrupted (SFN-386). SFEP-0055 adds the
// writable `Task<T>` handle type, so the primary remediation is now to
// annotate the array (`let mut hs: Task<int>[] = []`); the two SFN-386
// fallbacks (seed non-empty / await directly) follow. The un-annotated `[]`
// still fails closed here — `Task<T>` opens the annotated path without
// weakening this guard.
fn make_spawn_handle_into_empty_array_diagnostic(name: string, span: SourceSpan?) -> Diagnostic {
    let message = "cannot push a `spawn` task handle into `" + name
        + "`, an inferred-empty `[]` array: it has no element type. Annotate the array with the handle type (`let mut "
        + name
        + ": Task<int>[] = []`, matching your `spawn`'s return type), then `join_all("
        + name
        + ")` to await in input order. Alternatively `await` each handle directly at the spawn site, or seed the array non-empty (`let mut hs = [spawn ...]`).";
    return Diagnostic {
        code: "E0831",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name("push", span),
        suggestion: null
    };
}

// E0836 — a `spawn` task handle whose result kind differs from a
// `Task<T>[]`'s declared element kind is pushed into it (SFEP-0055 §3.4). A
// handle array is homogeneous: every `Task<T>` handle it holds must share one
// `T`. This is the concurrency-specific surfacing of ordinary array element
// homogeneity, now that the element type is a concrete `Task<T>`.
fn make_spawn_handle_kind_mismatch_diagnostic(name: string, array_kind: string, pushed_kind: string, span: SourceSpan?) -> Diagnostic {
    let message = "cannot push a `spawn fn() -> " + trim_text(pushed_kind)
        + "` handle into `"
        + name
        + "`, a `Task<"
        + trim_text(array_kind)
        + ">[]`: a task-handle array is homogeneous — every handle must have result kind `"
        + trim_text(array_kind)
        + "`. Use a matching `spawn` return type, or a separate array per result type.";
    return Diagnostic {
        code: "E0836",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name("push", span),
        suggestion: null
    };
}

// The monomorphized element kind a `Task<T>[]` handle-array type annotation
// carries (SFEP-0055), or null when `type_text` is not a `Task<...>[]` array.
// Mirrors `channel_element_kind`: strip the trailing `[]`, match the `Task`
// head before the first `<`, lift the `<...>` payload, and classify it with
// the same six-kind resolver `spawn`/`channel` use — so a handle array's
// element kind agrees with the kind its `spawn` handles resolve to. The bare
// scalar `Task<T>` (a single handle binding) is intentionally NOT matched
// here: only the array form drives the `.push(spawn ...)` homogeneity check.
fn task_array_element_kind(type_text: string) -> string? {
    let trimmed = trim_text(type_text);
    if trimmed.length < 3 { return null; }
    if substring(trimmed, trimmed.length - 2, trimmed.length) != "[]" {
        return null;
    }
    let element = trim_text(substring(trimmed, 0, trimmed.length - 2));
    let mut lt: int = -1;
    let mut index: int = 0;
    loop {
        if index >= element.length { break; }
        if element[index] == "<" {
            lt = index;
            break;
        }
        index += 1;
    }
    if lt < 0 { return null; }
    let head = trim_text(slice_text(element, 0, lt));
    if !strings_equal(head, "Task") { return null; }
    let inner = extract_generic_argument_block(element);
    if inner == null { return null; }
    let resolved = spawn_future_kind(trim_text(inner));
    if resolved.length == 0 { return null; }
    return resolved;
}

// The `SymbolEntry.element_kind` marker for a `Task<T>[]` handle-array binding
// (SFEP-0055): the resolved kind under a `taskarr:` tag, so it is distinct
// from a `Channel<T>` element kind (a bare kind the E0815 send check reads)
// and the `empty_array` E0831 sentinel. The tag never equals `"empty_array"`,
// so E0831 is unaffected. `push_spawn_handle_diagnostics` reads it back to
// enforce handle-array homogeneity (E0836).
fn make_task_array_element_marker(kind: string) -> string {
    return "taskarr:" + kind;
}

// The handle kind carried by a `Task<T>[]` element marker, or null when
// `element_kind` is not one (a channel/empty/absent marker).
fn task_array_marker_kind(element_kind: string) -> string? {
    if !starts_with(element_kind, "taskarr:") { return null; }
    return slice_text(element_kind, 8, element_kind.length);
}

// SFN-404: reject a generic-struct static constructor whose instantiation is
// provably uninferable (`let n = List.new()`) at check time. The backend
// monomorphizer mangles a static-call receiver (`List.new()` -> `List$int.new()`)
// only when a same-line `List<..>` binding annotation names the instantiation;
// with none it leaves `List` unmangled and stage-6 lowering dies with a raw
// "cannot resolve return type for call to `List.new`" fatal (the #1389
// check-green-not-equal-build-green class). Mirror that non-firing condition as
// a silent-unless-certain frontend rejection: fire only when the receiver is a
// known local generic struct, the call has zero arguments (any argument might
// bind `T`, and the checker has no expression-type inferencer, #829, to prove
// otherwise), and the binding annotation does not spell `Struct<..>`.
fn check_uninferable_generic_constructor(statement: Statement, generic_struct_names: string[]) -> Diagnostic[] {
    if !strings_equal(statement.variant, "VariableDeclaration") { return []; }
    let init = statement.initializer;
    if init == null { return []; }
    if !strings_equal(init.variant, "Call") { return []; }
    if init.arguments.length > 0 { return []; }
    // Turbofish `List.new<int>()` (SFN-329) expresses instantiation intent; it
    // is inert in lowering but out of scope here, so do not misdirect on it.
    if init.type_arguments.length > 0 { return []; }
    let callee = init.callee;
    if !strings_equal(callee.variant, "Member") { return []; }
    let object = callee.object;
    if !strings_equal(object.variant, "Identifier") { return []; }
    let struct_name = object.name;
    if !contains_string(generic_struct_names, struct_name) { return []; }
    if _annotation_instantiates_struct(statement.type_annotation, struct_name) {
        return [];
    }
    return [make_uninferable_generic_constructor_diagnostic(struct_name, callee.member, callee.span)];
}

// True when `annotation` spells a generic instantiation `Struct<..>` of
// `struct_name` in its text, mirroring the monomorphizer's same-line textual
// match so the frontend stays silent exactly when the backend would mangle the
// receiver. A false negative (a contrived `OtherStruct<..>` whose name ends in
// `struct_name`) is safer than a false positive under the silent-unless-certain
// rule.
fn _annotation_instantiates_struct(annotation: TypeAnnotation?, struct_name: string) -> boolean {
    if annotation == null { return false; }
    let needle = struct_name + "<";
    let at = index_of(annotation.text, needle);
    if at < 0 { return false; }
    // Require a closing `>` after the `<` so a malformed spelling never counts.
    let rest = slice_text(annotation.text, at + needle.length, annotation.text.length);
    return index_of(rest, ">") >= 0;
}

fn make_uninferable_generic_constructor_diagnostic(struct_name: string, member: string, span: SourceSpan?) -> Diagnostic {
    let message = "cannot infer the generic instantiation of `" + struct_name
        + "` for the static call `"
        + struct_name
        + "."
        + member
        + "()`: there is no binding type annotation and no argument to infer the type parameter from. Annotate the binding type, e.g. `let n: "
        + struct_name
        + "<int> = "
        + struct_name
        + "."
        + member
        + "()`.";
    return Diagnostic {
        code: "E0833",
        severity: "error",
        message: message,
        file_path: "",
        primary: token_from_name(member, span),
        suggestion: null
    };
}

fn check_struct_methods(methods: MethodDeclaration[], interfaces: Statement[], top_level: SymbolEntry[], known: string[], type_params: string[]) -> Diagnostic[] {
    let mut seen: string[] = [];
    let mut diagnostics: Diagnostic[] = [];

    let mut _mi: int = 0;
    loop {
        if _mi >= methods.length { break; }
        let method = methods[_mi];
        let _sig_diags = check_function_signature(method.signature, interfaces, top_level, known, type_params);
        let mut _ci: int = 0;
        loop {
            if _ci >= _sig_diags.length { break; }
            diagnostics.push(_sig_diags[_ci]);
            _ci += 1;
        }
        let name = method.signature.name;
        if contains_string(seen, name) {
            diagnostics.push(make_duplicate_symbol_diagnostic(name, "method", token_from_name(name, method.signature.name_span)));
        } else { seen.push(name); }
        _mi += 1;
    }

    return diagnostics;
}

fn check_enum_variants(variants: EnumVariant[], known: string[], type_params: string[]) -> Diagnostic[] {
    let mut seen: string[] = [];
    let mut diagnostics: Diagnostic[] = [];

    let mut _vi: int = 0;
    loop {
        if _vi >= variants.length { break; }
        let variant = variants[_vi];
        let name = variant.name;
        if contains_string(seen, name) {
            diagnostics.push(make_duplicate_symbol_diagnostic(name, "enum variant", token_from_name(name, variant.name_span)));
        } else { seen.push(name); }
        let mut _evf: int = 0;
        loop {
            if _evf >= variant.fields.length { break; }
            let field = variant.fields[_evf];
            diagnostics = diagnostics.concat(check_bare_fn_type_annotation(field.type_annotation, field.name, field.name_span));
            diagnostics = diagnostics.concat(check_malformed_array_annotation(field.type_annotation, field.name, field.name_span));
            diagnostics = diagnostics.concat(check_unknown_type_annotation(field.type_annotation, field.name, field.name_span, known, type_params));
            diagnostics = diagnostics.concat(check_intersection_value_type_annotation(field.type_annotation, field.name, field.name_span));
            _evf += 1;
        }
        _vi += 1;
    }

    return diagnostics;
}

fn check_interface_members(members: FunctionSignature[], interfaces: Statement[], top_level: SymbolEntry[], known: string[], type_params: string[]) -> Diagnostic[] {
    let mut seen: string[] = [];
    let mut diagnostics: Diagnostic[] = [];

    let mut _mbi: int = 0;
    loop {
        if _mbi >= members.length { break; }
        let member = members[_mbi];
        let _sig_diags = check_function_signature(member, interfaces, top_level, known, type_params);
        let mut _ci: int = 0;
        loop {
            if _ci >= _sig_diags.length { break; }
            diagnostics.push(_sig_diags[_ci]);
            _ci += 1;
        }
        let name = member.name;
        if contains_string(seen, name) {
            diagnostics.push(make_duplicate_symbol_diagnostic(name, "interface member", token_from_name(name, member.name_span)));
        } else { seen.push(name); }
        _mbi += 1;
    }

    return diagnostics;
}

fn check_function_signature(signature: FunctionSignature, interfaces: Statement[], top_level: SymbolEntry[], known: string[], type_params: string[]) -> Diagnostic[] {
    // SFN-555: the signature's own type parameters are in scope for its
    // parameter and return annotations.
    let sig_type_params = type_params.concat(type_parameter_names(signature.type_parameters));
    let mut diagnostics = check_type_parameters(signature.type_parameters, interfaces, top_level);
    let mut _pi: int = 0;
    loop {
        if _pi >= signature.parameters.length { break; }
        let parameter = signature.parameters[_pi];
        diagnostics = diagnostics.concat(check_bare_fn_type_annotation(parameter.type_annotation, parameter.name, parameter.span));
        diagnostics = diagnostics.concat(check_malformed_array_annotation(parameter.type_annotation, parameter.name, parameter.span));
        diagnostics = diagnostics.concat(check_unknown_type_annotation(parameter.type_annotation, parameter.name, parameter.span, known, sig_type_params));
        diagnostics = diagnostics.concat(check_intersection_value_type_annotation(parameter.type_annotation, parameter.name, parameter.span));
        _pi += 1;
    }
    diagnostics = diagnostics.concat(check_bare_fn_type_annotation(signature.return_type, signature.name, signature.name_span));
    diagnostics = diagnostics.concat(check_malformed_array_annotation(signature.return_type, signature.name, signature.name_span));
    diagnostics = diagnostics.concat(check_unknown_type_annotation(signature.return_type, signature.name, signature.name_span, known, sig_type_params));
    diagnostics = diagnostics.concat(check_intersection_value_type_annotation(signature.return_type, signature.name, signature.name_span));
    return diagnostics;
}

// Validate an `extern fn` declaration's signature.
//
// Per docs/proposals/0025-native-runtime-architecture.md §3.6 (`#395-extern-function-lowering`), only
// C-ABI-compatible types may cross the extern boundary. Aggregate
// Sailfin types (`string`, `T[]`, structs, RC'd values) must be
// decomposed by an adapter layer before the call. This validator
// rejects non-C-ABI types in extern signatures with E0801–E0805
// diagnostics so authors learn the boundary at compile time, not
// at link time or runtime.
//
// Constraints enforced:
//   - No type parameters (E0803). Generic externs are nonsensical;
//     C has no type parameters.
//   - No effect annotations (E0804). Effects are enforced on the
//     wrapping adapter, not on the raw extern. The example
//     `examples/advanced/unsafe-extern-interop.sfn` already
//     demonstrates this pattern: `![unsafe, io]` lives on
//     `allocate_and_free`, not on `malloc`/`free`.
//   - Each parameter must carry a non-empty type annotation
//     (E0805). The extern boundary has no body for inference;
//     missing annotations would silently default to `i8*` in
//     LLVM lowering and produce an ABI-mismatched `declare`.
//   - `void` is permitted only as a return type, never as a
//     parameter type (E0805) — `void` parameters are invalid C
//     and produce ill-formed LLVM IR.
//   - Each parameter and return type must satisfy `is_c_abi_type`
//     (E0801 string, E0802 array, E0805 catch-all for unknown
//     names including `number`).
//
// The `unsafe` keyword on the declaration is intentionally not
// inspected here: `unsafe extern fn` and bare `extern fn` produce
// identical LLVM `declare` directives. `unsafe` is currently a
// documentation marker that may grow into an enforced
// "unsafe-required-to-call" gate in a future PR; this validator
// will care about it at that point.
fn check_extern_signature(signature: FunctionSignature) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];

    if signature.type_parameters.length > 0 {
        diagnostics.push(make_extern_type_parameters_diagnostic(signature.name));
    }

    if signature.effects.length > 0 {
        diagnostics.push(make_extern_effects_diagnostic(signature.name, signature.effects));
    }

    let mut _pi: int = 0;
    loop {
        if _pi >= signature.parameters.length { break; }
        let parameter = signature.parameters[_pi];
        if parameter.type_annotation == null {
            diagnostics.push(make_extern_parameter_missing_type_diagnostic(signature.name, parameter.name));
        } else {
            let annotation = parameter.type_annotation;
            let type_text = trim_text(annotation.text);
            if type_text.length == 0 {
                diagnostics.push(make_extern_parameter_missing_type_diagnostic(signature.name, parameter.name));
            } else {
                let kind = classify_extern_parameter_type(type_text);
                if !strings_equal(kind, "ok") {
                    diagnostics.push(make_extern_parameter_type_diagnostic(signature.name, parameter.name, type_text, kind));
                }
            }
        }
        _pi += 1;
    }

    if signature.return_type != null {
        let return_annotation = signature.return_type;
        let return_text = trim_text(return_annotation.text);
        if return_text.length > 0 {
            let return_kind = classify_extern_return_type(return_text);
            if !strings_equal(return_kind, "ok") {
                diagnostics.push(make_extern_return_type_diagnostic(signature.name, return_text, return_kind));
            }
        }
    }

    return diagnostics;
}

// Validate an `extern var NAME: TYPE;` declaration's type against the
// same C-ABI accept-list as extern fn signatures (E0801–E0805). An
// extern var binds a libc global symbol (e.g. `environ`), so its type
// must be a concrete C-ABI type with storage — `void` is rejected the
// same way it is in parameter position (a variable has storage; `void`
// has none). `* * u8` (for `environ`) is on the accept-list.
fn check_extern_var(name: string, type_annotation: TypeAnnotation?) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];
    if type_annotation == null {
        diagnostics.push(make_extern_var_missing_type_diagnostic(name));
        return diagnostics;
    }
    let type_text = trim_text(type_annotation.text);
    if type_text.length == 0 {
        diagnostics.push(make_extern_var_missing_type_diagnostic(name));
        return diagnostics;
    }
    let kind = classify_extern_parameter_type(type_text);
    if !strings_equal(kind, "ok") {
        diagnostics.push(make_extern_var_type_diagnostic(name, type_text, kind));
    }
    return diagnostics;
}

// Classify an extern type-annotation string used for a function
// *parameter*. Returns one of:
//   "ok"          — accepted by the v0 C-ABI rule set.
//   "string"      — rejected: Sailfin `string` is not C-ABI-compatible (E0801).
//   "array"       — rejected: `T[]` is not C-ABI-compatible (E0802).
//   "void"        — rejected: bare `void` is invalid for C parameters (E0805).
//   "unknown"     — rejected: unrecognized type name (E0805). Covers `number`.
//
// The matcher walks textual forms today; when integer types and
// generic constraints land it can be tightened. The accept-list is
// intentionally explicit so adding a new permitted type is one
// edit, never a regex change.
fn classify_extern_parameter_type(text: string) -> string {
    if text.length == 0 { return "ok"; }
    if extern_type_contains_array_brackets(text) { return "array"; }
    if extern_type_uses_string(text) { return "string"; }
    if strings_equal(text, "void") { return "void"; }
    if !is_c_abi_parameter_type(text) { return "unknown"; }
    return "ok";
}

// Classify an extern type-annotation string used for a function
// *return type*. Same shape as `classify_extern_parameter_type` but
// `void` is permitted (no "void" reject case).
fn classify_extern_return_type(text: string) -> string {
    if text.length == 0 { return "ok"; }
    if extern_type_contains_array_brackets(text) { return "array"; }
    if extern_type_uses_string(text) { return "string"; }
    if !is_c_abi_return_type(text) { return "unknown"; }
    return "ok";
}

// Split a type-parameter bound list ("Eq + Comparable<int>") on top-level
// `+`, respecting `(`/`)` and `<`/`>` nesting the same way
// `split_top_level_commas` does (#1868, SFEP-0038 §3.1). Empty segments are
// dropped and each segment is trimmed.
fn split_top_level_plus(text: string) -> string[] {
    let mut out: string[] = [];
    let mut current: string = "";
    let mut depth: int = 0;
    let mut index: int = 0;
    loop {
        if index >= text.length { break; }
        let ch = text[index];
        if ch == "(" {
            depth += 1;
            current = current + ch;
        } else if ch == ")" {
            if depth > 0 { depth -= 1; }
            current = current + ch;
        } else if ch == "<" {
            depth += 1;
            current = current + ch;
        } else if ch == ">" {
            if depth > 0 { depth -= 1; }
            current = current + ch;
        } else if ch == "+" {
            if depth == 0 {
                let trimmed = trim_text(current);
                if trimmed.length > 0 { out.push(trimmed); }
                current = "";
                index += 1;
                continue;
            }
            current = current + ch;
        } else { current = current + ch; }
        index += 1;
    }
    let trimmed_last = trim_text(current);
    if trimmed_last.length > 0 { out.push(trimmed_last); }
    return out;
}

fn check_type_parameters(type_parameters: TypeParameter[], interfaces: Statement[], top_level: SymbolEntry[]) -> Diagnostic[] {
    let mut seen: string[] = [];
    let mut diagnostics: Diagnostic[] = [];

    let mut _tpi: int = 0;
    loop {
        if _tpi >= type_parameters.length { break; }
        let type_parameter = type_parameters[_tpi];
        let name = type_parameter.name;
        if contains_string(seen, name) {
            diagnostics.push(make_duplicate_symbol_diagnostic(name, "type parameter", token_from_name(name, type_parameter.span)));
        } else { seen.push(name); }
        _tpi += 1;
    }

    // Declaration-time bound validation (SFEP-0038 §3.1/§3.2a, #1868).
    let mut _bpi: int = 0;
    loop {
        if _bpi >= type_parameters.length { break; }
        let tp = type_parameters[_bpi];
        let tp_bound = tp.bound;
        if tp_bound != null {
            let bound = tp_bound;
            let bound_refs = split_top_level_plus(bound.text);
            let mut _bri: int = 0;
            loop {
                if _bri >= bound_refs.length { break; }
                let ref_text = trim_text(bound_refs[_bri]);
                if ref_text.length > 0 {
                    let d = check_single_bound(ref_text, tp.name, tp.span, interfaces, top_level);
                    if d != null { diagnostics.push(d); }
                }
                _bri += 1;
            }
        }
        _bpi += 1;
    }

    return diagnostics;
}

// Returns the identifier before the first top-level `<` in a bound
// reference, trimmed ("From<int>" -> "From", "Comparable" -> "Comparable").
// Used to resolve a bound to a top-level struct/enum symbol for the E0821
// check (#1868, SFEP-0038 §3.1).
fn bound_base_name(text: string) -> string {
    let trimmed = trim_text(text);
    let mut index: int = 0;
    loop {
        if index >= trimmed.length { break; }
        if trimmed[index] == "<" { break; }
        index += 1;
    }
    return trim_text(substring(trimmed, 0, index));
}

// True if `symbols` contains an entry with this name AND kind.
fn symbol_has_kind(symbols: SymbolEntry[], name: string, kind: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= symbols.length { break; }
        if strings_equal(symbols[i].name, name) && strings_equal(symbols[i].kind, kind) {
            return true;
        }
        i += 1;
    }
    return false;
}

fn make_bound_not_interface_diagnostic(bound_name: string, param_name: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0821",
        severity: "error",
        message: "bound `" + bound_name + "` on type parameter `" + param_name
            + "` is not an interface",
        file_path: "",
        primary: token_from_name(param_name, span),
        suggestion: null
    };
}

fn make_bound_arity_diagnostic(bound_name: string, param_name: string, interface_signature: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0822",
        severity: "error",
        message: "bound `" + bound_name + "` on type parameter `" + param_name
            + "` must match "
            + interface_signature
            + " type arguments",
        file_path: "",
        primary: token_from_name(param_name, span),
        suggestion: null
    };
}

// Validate one bound reference from a `T: Bound1 + Bound2` list against the
// interface table and the top-level symbol table (#1868, SFEP-0038 §3.1).
// Returns `null` when the bound is OK. If the bound resolves to a known
// interface, validates its type-argument arity (E0822). If it does not
// resolve, E0821 fires only when the base name is a KNOWN struct/enum —
// an unresolved name may be a prelude/imported interface not visible in a
// single-file check, so it is left unflagged to avoid false positives on
// std-library bounds.
fn check_single_bound(ref_text: string, param_name: string, span: SourceSpan?, interfaces: Statement[], top_level: SymbolEntry[]) -> Diagnostic? {
    let annotation = TypeAnnotation { text: ref_text, span: null };
    let iface = resolve_interface_annotation(annotation, interfaces);
    if iface != null {
        let found = iface;
        let expected = found.type_parameters.length;
        let provided = parse_type_arguments(ref_text);
        if expected == 0 {
            if provided.length > 0 {
                return make_bound_arity_diagnostic(trim_text(ref_text), param_name, format_interface_signature(found), span);
            }
        } else {
            if provided.length != expected {
                return make_bound_arity_diagnostic(trim_text(ref_text), param_name, format_interface_signature(found), span);
            }
        }
        return null;
    }
    let base = bound_base_name(ref_text);
    if symbol_has_kind(top_level, base, "struct") {
        return make_bound_not_interface_diagnostic(base, param_name, span);
    }
    if symbol_has_kind(top_level, base, "enum") {
        return make_bound_not_interface_diagnostic(base, param_name, span);
    }
    return null;
}

// Locate a top-level interface declaration by its bare name.
fn find_interface_by_name(name: string, interfaces: Statement[]) -> Statement? {
    let mut i: int = 0;
    loop {
        if i >= interfaces.length { break; }
        if strings_equal(interfaces[i].name, name) { return interfaces[i]; }
        i += 1;
    }
    return null;
}

// Locate a top-level struct declaration by its bare name.
fn find_struct_by_name(name: string, structs: Statement[]) -> Statement? {
    let mut i: int = 0;
    loop {
        if i >= structs.length { break; }
        if strings_equal(structs[i].name, name) { return structs[i]; }
        i += 1;
    }
    return null;
}

// True if `struct_decl` declares a method named `method_name`.
fn struct_has_method(struct_decl: Statement, method_name: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= struct_decl.methods.length { break; }
        if strings_equal(struct_decl.methods[i].signature.name, method_name) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Locate a type parameter by name within an in-scope parameter list.
fn find_type_parameter(name: string, params: TypeParameter[]) -> TypeParameter? {
    let mut i: int = 0;
    loop {
        if i >= params.length { break; }
        if strings_equal(params[i].name, name) { return params[i]; }
        i += 1;
    }
    return null;
}

// True if type parameter `param` was itself declared with a bound whose
// base name is `bound_name` (the bound-propagation predicate, §3.1).
fn type_parameter_declares_bound(param: TypeParameter, bound_name: string) -> boolean {
    let b = param.bound;
    if b == null { return false; }
    let bound = b;
    let refs = split_top_level_plus(bound.text);
    let mut i: int = 0;
    loop {
        if i >= refs.length { break; }
        if strings_equal(bound_base_name(trim_text(refs[i])), bound_name) {
            return true;
        }
        i += 1;
    }
    return false;
}

// True iff `struct_decl` implements the interface named `interface_name`:
// it must (1) declare `implements I` nominally AND (2) structurally
// provide every interface member as a method. This is the reusable
// conformance predicate the SFEP calls `struct_implements`, sharing the
// exact nominal+structural test `check_struct_implements_interfaces`
// emits diagnostics for (SFEP-0038 §3.1/§3.2b, #1870) — factored so the
// satisfaction test can query conformance against an arbitrary interface
// without re-walking diagnostics. When the interface is not visible in
// this compilation unit, the nominal `implements` declaration is trusted
// (structural conformance is proven at the struct's own declaration).
fn struct_implements(struct_decl: Statement, interface_name: string, interfaces: Statement[]) -> boolean {
    let mut nominal: boolean = false;
    let mut _ai: int = 0;
    loop {
        if _ai >= struct_decl.implements_types.length { break; }
        if strings_equal(bound_base_name(struct_decl.implements_types[_ai].text), interface_name) {
            nominal = true;
            break;
        }
        _ai += 1;
    }
    if !nominal { return false; }
    let iface = find_interface_by_name(interface_name, interfaces);
    if iface == null { return true; }
    let found = iface;
    let mut _mi: int = 0;
    loop {
        if _mi >= found.members.length { break; }
        if !struct_has_method(struct_decl, found.members[_mi].name) {
            return false;
        }
        _mi += 1;
    }
    return true;
}

// True iff the concrete type argument `concrete` satisfies the single
// bound reference `bound_ref` (one interface, e.g. "Comparable" or
// "From<int>") at an instantiation site (SFEP-0038 §3.1/§3.2b, #1870):
//   1. If `concrete` names an in-scope type parameter, consult ITS own
//      declared bounds — bound propagation: satisfied iff that parameter
//      was itself declared with `bound_ref`.
//   2. Otherwise resolve `concrete` to a struct declaration and ask
//      whether it implements the bound interface.
// Conservative on names it cannot resolve: a bound that does not name a
// known interface, or a concrete type that is neither an in-scope
// parameter nor a known struct (a primitive, enum, or imported type), is
// treated as satisfied — mirroring `check_single_bound`'s leniency so
// std/imported surfaces are not falsely flagged.
fn type_satisfies_bound(concrete: string, bound_ref: string, interfaces: Statement[], structs: Statement[], in_scope_params: TypeParameter[]) -> boolean {
    let bound_name = bound_base_name(bound_ref);
    if find_interface_by_name(bound_name, interfaces) == null { return true; }
    let concrete_name = bound_base_name(concrete);
    let param = find_type_parameter(concrete_name, in_scope_params);
    if param != null {
        let p = param;
        return type_parameter_declares_bound(p, bound_name);
    }
    let struct_decl = find_struct_by_name(concrete_name, structs);
    if struct_decl == null { return true; }
    return struct_implements(struct_decl, bound_name, interfaces);
}

// E0820 — a concrete type argument does not satisfy a declared bound at a
// generic instantiation site (SFEP-0038 §3.2b, #1870). Names the full
// bound (with any type arguments), the offending type, and the type
// parameter. The fix-it hint adapts to the offending type: an in-scope
// type parameter needs a *bound* added (`T: I`), a concrete type needs an
// `implements I` clause. No primary token is set — an `implements`
// annotation carries no span (`TypeAnnotation` is text-only), and the
// enclosing site span does not correspond to the offending type-argument
// text, so a caret there would mis-highlight; the message carries the
// full context instead.
fn make_bound_not_satisfied_diagnostic(concrete: string, bound_display: string, param_name: string, decl_name: string, concrete_is_param: boolean) -> Diagnostic {
    let mut fix: string = "; add `implements " + bound_display + "` to `"
        + concrete
        + "`";
    if concrete_is_param {
        fix = "; add bound `" + bound_display + "` to type parameter `"
            + concrete
            + "`";
    }
    return Diagnostic {
        code: "E0820",
        severity: "error",
        message: "type `" + concrete + "` does not satisfy bound `"
            + bound_display
            + "` on type parameter `"
            + param_name
            + "` of `"
            + decl_name
            + "`"
            + fix,
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// Verify every concrete type argument at a generic instantiation site
// satisfies the bounds declared on the corresponding type parameter
// (SFEP-0038 §3.2b, #1870). `decl_type_parameters` are the instantiated
// declaration's parameters (carrying their bounds); `type_arguments` are
// the concrete arguments supplied at the site; `in_scope_params` are the
// type parameters visible at the site (for bound propagation). Emits one
// E0820 per unsatisfied (argument, bound) pair. Positions past the
// shorter of the two lists are ignored — arity is validated separately
// (E0822 at declaration; the interface/enum arity checks at use sites).
fn check_generic_instantiation(decl_name: string, decl_type_parameters: TypeParameter[], type_arguments: string[], interfaces: Statement[], structs: Statement[], in_scope_params: TypeParameter[]) -> Diagnostic[] {
    let mut diagnostics: Diagnostic[] = [];
    let mut limit: int = decl_type_parameters.length;
    if type_arguments.length < limit { limit = type_arguments.length; }
    let mut index: int = 0;
    loop {
        if index >= limit { break; }
        let param = decl_type_parameters[index];
        let concrete = trim_text(type_arguments[index]);
        let concrete_is_param = find_type_parameter(bound_base_name(concrete), in_scope_params) != null;
        let tp_bound = param.bound;
        if tp_bound != null {
            let bound = tp_bound;
            let refs = split_top_level_plus(bound.text);
            let mut _bri: int = 0;
            loop {
                if _bri >= refs.length { break; }
                let ref_text = trim_text(refs[_bri]);
                if ref_text.length > 0 {
                    if !type_satisfies_bound(concrete, ref_text, interfaces, structs, in_scope_params) {
                        diagnostics.push(make_bound_not_satisfied_diagnostic(concrete, ref_text, param.name, decl_name, concrete_is_param));
                    }
                }
                _bri += 1;
            }
        }
        index += 1;
    }
    return diagnostics;
}

// Match a removed AI block keyword at the start of a `Statement.Unknown` text.
// Returns the keyword if found, or "" otherwise. A keyword only matches if it
// is followed by a space (i.e. it is acting as a statement-introducer, not part
// of an identifier like `model_registry`).
fn detect_removed_ai_keyword(text: string) -> string {
    if starts_with(text, "model ") { return "model"; }
    if starts_with(text, "prompt ") { return "prompt"; }
    if starts_with(text, "tool ") { return "tool"; }
    if starts_with(text, "pipeline ") { return "pipeline"; }
    return "";
}

fn make_removed_keyword_diagnostic(keyword: string) -> Diagnostic {
    return Diagnostic {
        code: "E0410",
        severity: "error",
        message: "`" + keyword + "` block syntax was removed from the language;"
            + " AI functionality is planned for the post-1.0 `sfn/ai` library"
            + " capsule and the `![model]` effect remains as the capability gate",
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// E0420 — a `Call` whose callee is a bare identifier that resolves to
// neither an in-scope binding (parameter, local, or top-level
// function/extern/struct/enum/…), an imported function, nor a builtin.
// The enforcement flip for #616 (sub-issue #812). E04xx is the
// resolution/semantic diagnostic band (E0410 already lives here).
// The caret points at the callee identifier via `token_from_name`;
// member/method callees (`obj.method()`) never reach this factory — the
// walker's Member branch only recurses into `.object`.
fn make_undefined_function_diagnostic(name: string, span: SourceSpan?, provider_module: string) -> Diagnostic {
    let mut detail = "undefined function `" + name + "`";
    if provider_module.length > 0 {
        detail = detail + "; consider `import { " + name + " } from \""
            + provider_module
            + "\"`";
    }
    return Diagnostic {
        code: "E0420",
        severity: "error",
        message: detail,
        file_path: "",
        primary: token_from_name(name, span),
        suggestion: null
    };
}

fn make_syscall_builtin_diagnostic(name: string, message: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E1019",
        severity: "error",
        message: "invalid raw syscall builtin `" + name + "`: " + message,
        file_path: "",
        primary: token_from_name(name, span),
        suggestion: null
    };
}

// #1953: `sfn check` resolves each relative import against the staged
// import closure. A `from "./x"` spec that resolves to no module on disk
// mints E0430; a named specifier defined nowhere in the closure mints
// E0431 (Sailfin resolves imports globally by name, so this is a
// closure-wide existence check, not per-module export enforcement). Both
// carry no span — the `ImportDeclaration` AST node carries none (see
// ast.sfn) — so `primary` is null and the renderer falls back to a
// location-only line, matching the E0600 re-export diagnostics.
fn make_cannot_find_module_diagnostic(module_spec: string) -> Diagnostic {
    return Diagnostic {
        code: "E0430",
        severity: "error",
        message: "cannot find module `" + module_spec + "`",
        file_path: "",
        primary: null,
        suggestion: null
    };
}

fn make_symbol_not_exported_diagnostic(symbol: string, module_spec: string) -> Diagnostic {
    return Diagnostic {
        code: "E0431",
        severity: "error",
        message: "`" + symbol + "` is imported from `" + module_spec
            + "` but is not defined by any module in scope",
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// A nested / local `fn` is a non-capturing static item (SFEP-0042): its
// body may reference its own parameters, module-level items, and sibling
// nested `fn`s — never an enclosing local or parameter. Capturing one is
// rejected here, mirroring Rust `E0434`; the fix is to bind a closure,
// which is Sailfin's existing capturing form.
fn make_nested_fn_capture_diagnostic(name: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0421",
        severity: "error",
        message: "nested `fn` cannot capture `" + name
            + "` from the enclosing scope; bind a closure with `let f = fn(...) => ...` to capture it",
        file_path: "",
        primary: token_from_name(name, span),
        suggestion: null
    };
}

// `thread_local` is the storage-class annotation that flips a top-level
// `let mut` from `internal global` to `internal thread_local global` at
// LLVM lowering (#730). Immutable thread-local globals are useless — the
// whole point of TLS is per-thread mutation — so a `thread_local let x`
// (without `mut`) is rejected with E0807.
fn make_thread_local_requires_mut_diagnostic(name: string) -> Diagnostic {
    return Diagnostic {
        code: "E0807",
        severity: "error",
        message: "`thread_local let " + name
            + "` is missing `mut`; thread-local globals are per-thread"
            + " mutable storage, so an immutable thread-local is a"
            + " contradiction. Write `thread_local let mut "
            + name
            + ": <type> = <init>;` or drop the `thread_local` prefix.",
        file_path: "",
        primary: null,
        suggestion: null
    };
}

// E0819 — a nested (block-level) `Statement.Unknown` that no other pass
// already diagnosed. Top-level `Unknown` statements surface E0500 from the
// check driver (`tools/check.sfn`), whose walk covers only
// `program.statements`; a `Statement.Unknown` produced inside a block by
// `parse_unknown_statement` (reached via `parse_block`) is invisible to that
// walk and previously fell through `check_statement`'s `Unknown` arm with no
// diagnostic — contributing zero effects and being silently dropped at
// codegen, a fail-open hole in the effects pillar (#1691, epic #1180).
// Emitted from `check_statement` only for non-top-level statements and only
// when the removed-keyword diagnostic (E0410) did not already fire, so it
// never double-reports. `anchor` is the first
// token of the unparseable run; `near` quotes its lexeme for the message.
fn make_unparseable_statement_diagnostic(anchor: Token?, near: string) -> Diagnostic {
    return Diagnostic {
        code: "E0819",
        severity: "error",
        message: "parse error: unrecognized statement" + near,
        file_path: "",
        primary: anchor,
        suggestion: null
    };
}

// E0010 — `fn main` declared with too many parameters. The Sailfin
// entry point accepts at most one argument: the argv slice. The
// lowering pass (`compiler/src/llvm/lowering/emission.sfn`) emits a
// C-compatible `main(argc, argv)` wrapper for any top-level `fn main`,
// so any extra parameters would either be silently ignored today or
// (after M5.3) manifest as an LLVM-link mismatch. Validate at typecheck
// to surface a Sailfin diagnostic instead of an `lld` error. The
// diagnostic carets at the first extraneous parameter so the user can
// see exactly what to delete.
fn make_main_signature_param_count_diagnostic(param_count: int, parameter_name: string, span: SourceSpan?) -> Diagnostic {
    return Diagnostic {
        code: "E0010",
        severity: "error",
        message: "`fn main` accepts at most one parameter (`argv: string[]`),"
            + " got "
            + number_to_string(param_count)
            + ". Drop the extra parameters; values that vary per-run live in"
            + " environment variables, configuration files, or argv itself.",
        file_path: "",
        primary: token_from_name(parameter_name, span),
        suggestion: null
    };
}

// E0011 — `fn main`'s sole parameter must be the argv slice. The
// lowering wrapper passes argv as a `string[]`; any other type (including
// the legacy `number` alias) would produce a type-mismatch crash inside
// the wrapper or — once M5.3 emits a real argv-parsing prologue — at
// LLVM-link time. The fix-it tells the user to switch to `string[]` and
// to parse any structured arguments inside the body. The diagnostic
// carets at the parameter so the user can see exactly which slot to
// retype.
fn make_main_signature_param_type_diagnostic(parameter_name: string, actual_type: string, span: SourceSpan?) -> Diagnostic {
    let mut shown: string = actual_type;
    if shown.length == 0 { shown = "<missing>"; }
    return Diagnostic {
        code: "E0011",
        severity: "error",
        message: "`fn main` parameter `" + parameter_name
            + "` must be typed `string[]` (the argv slice), got `"
            + shown
            + "`. The lowering pass passes argv as `string[]`; parse"
            + " structured arguments inside the body.",
        file_path: "",
        primary: token_from_name(parameter_name, span),
        suggestion: null
    };
}
