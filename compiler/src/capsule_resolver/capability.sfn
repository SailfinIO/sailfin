// compiler/src/capsule_resolver/capability.sfn
//
// Workspace capability envelope and drift audit. Computes the effective
// `[workspace.capabilities]` envelope from the allow/deny/grant lists,
// audits each member's declared and inferred effects against it, and renders
// the resulting diagnostics. Also owns workspace-inherited version resolution
// and the lock-entry lookup that shares the same member-walk.
import { parse_program } from "sfn/syntax";

import { _collect_sfn_files_cmd } from "../build/fs";
import { render_diagnostic } from "../diagnostics_render";
import { inferred_public_effects } from "../effect_checker";
import { empty_import_symbols } from "../effect_imports";
import { effect_subsumes, is_canonical_effect } from "../effect_taxonomy";
import { _LockEntry } from "../lock";
import {
    toml_get_capabilities_required,
    toml_get_version,
    toml_get_workspace_capabilities_allow,
    toml_get_workspace_capabilities_deny,
    toml_get_workspace_capabilities_grant,
    toml_get_workspace_capabilities_mode,
    toml_get_workspace_package_version,
    toml_value_is_workspace_inherit
} from "../toml_parser";
import { Diagnostic, diagnostic_to_diag } from "../typecheck_types";
import {
    _cr_path_join,
    _cr_sort_strings,
    _cr_string_array_contains,
    _cr_string_lt
} from "./paths";
import { CapabilityDriftReport, MemberCapabilityAudit, WorkspaceMember } from "./types";
import { load_workspace_members } from "./workspace";

// SFEP-0051 Phase 4a — capability-envelope audit (declared surface).
//
// The workspace root declares an effect envelope in `[workspace.capabilities]`
// (allow/deny + per-member grants); the audit checks each member's declared
// `capsule.toml [capabilities] required` against it at resolve time — no
// compile needed. This is the workspace-tier sibling of the capsule-tier
// capability cross-check (E0403); membership reuses the SFEP-0017 subsumption
// lattice (`effect_subsumes`), so an `io` envelope entry covers an `io.fs`
// requirement. Phase 4a produces the report + diagnostics only; the
// build/check enforcement gate is Phase 4c (SFN-419).
// True iff some entry in `envelope` subsumes `required` under the SFEP-0017
// refinement lattice (an `io` entry covers an `io.fs` requirement). Reused
// for both the allow/grant cover test and the deny test.
fn _cr_effect_covered(envelope: string[], required: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= envelope.length { break; }
        if effect_subsumes(envelope[i], required) { return true; }
        i += 1;
    }
    return false;
}

// The drifting subset of `required` for a member granted `grant`, under the
// workspace `allow`/`deny`. `effective(M) = (allow ∪ grant) \ deny`, so a
// required effect drifts iff it is denied (deny wins — some deny entry
// subsumes it) or it is not covered by allow ∪ grant. Pure so resolver unit
// tests can exercise it directly without introducing filesystem effects.
fn workspace_effective_drift(allow: string[], deny: string[], grant: string[], required: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= required.length { break; }
        let r = required[i];
        i += 1;
        if _cr_effect_covered(deny, r) {
            out.push(r);
            continue;
        }
        if _cr_effect_covered(allow, r) { continue; }
        if _cr_effect_covered(grant, r) { continue; }
        out.push(r);
    }
    return out;
}

// Non-canonical entries in an envelope list. Envelope entries must be exact
// canonical effects (io, net, … — not dotted refinements), so validation
// uses exact `is_canonical_effect`, not root/subsumption membership. Pure.
fn workspace_envelope_noncanonical(effects: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= effects.length { break; }
        if !is_canonical_effect(effects[i]) { out.push(effects[i]); }
        i += 1;
    }
    return out;
}

// True iff `effects` is strictly ascending (alphabetical, no duplicates) —
// the canonical ordering effect lists must use (.claude/rules/code-style.md).
// Pure.
fn workspace_list_is_sorted(effects: string[]) -> boolean {
    let mut i: int = 1;
    loop {
        if i >= effects.length { break; }
        if !_cr_string_lt(effects[i - 1], effects[i]) { return false; }
        i += 1;
    }
    return true;
}

fn _cr_join_effects_csv(effects: string[]) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= effects.length { break; }
        if i > 0 { out = out + ", "; }
        out = out + effects[i];
        i += 1;
    }
    return out;
}

// E0405: a member's declared effect exceeds the workspace envelope. No source
// `Token` exists for a TOML manifest, so `primary` is null and the member
// path / offending effect / fix-it hint live in the message; `file_path`
// points at the member manifest that declared the excess effect.
fn _cr_capability_drift_diagnostic(member_name: string, member_manifest: string, effect: string, allow: string[]) -> Diagnostic {
    let envelope = _cr_join_effects_csv(allow);
    let message = "workspace member `" + member_name + "` requires effect `"
        + effect
        + "` which exceeds the workspace capability envelope !["
        + envelope
        + "]"
        + "\nnote: [workspace.capabilities] allow = ["
        + envelope
        + "]"
        + "\nsuggestion: add \""
        + member_name
        + "\" = [\""
        + effect
        + "\"] to [workspace.capabilities.grants], or remove !["
        + effect
        + "] from "
        + member_manifest;
    return Diagnostic {
        code: "E0405",
        severity: "error",
        message: message,
        file_path: member_manifest,
        primary: null,
        suggestion: null
    };
}

// E0406: an envelope list names a non-canonical effect.
fn _cr_envelope_noncanonical_diagnostic(list_name: string, effect: string, manifest: string) -> Diagnostic {
    let message = "`" + effect + "` in [workspace.capabilities] " + list_name
        + " is not a canonical effect (one of clock, gpu, io, model, net, rand)";
    return Diagnostic {
        code: "E0406",
        severity: "error",
        message: message,
        file_path: manifest,
        primary: null,
        suggestion: null
    };
}

// E0406: an envelope list is not in canonical alphabetical order.
fn _cr_envelope_unsorted_diagnostic(list_name: string, manifest: string) -> Diagnostic {
    let message = "[workspace.capabilities] " + list_name
        + " must be alphabetical (canonical effects in ascending order)";
    return Diagnostic {
        code: "E0406",
        severity: "error",
        message: message,
        file_path: manifest,
        primary: null,
        suggestion: null
    };
}

// SFEP-0051 Phase 4b (SFN-418): the inferred effect surface of one workspace
// member — the deduped union of the `![...]` effects across the public
// functions of every `.sfn` file under the member's `src/` dir, as computed by
// `effect_checker::inferred_public_effects`. Strengthens the declared surface
// (Phase 4a) so a member whose `capsule.toml [capabilities] required`
// under-reports its real effect use is still audited against the envelope.
// Best-effort at resolve time: a member with no `src/` dir contributes nothing.
// Uses `empty_import_symbols`, so cross-module callee propagation is not
// resolved here — direct effectful operations and same-file local callees still
// infer, and the public signatures' declared effects are always included.
fn _cr_member_inferred_effects(src_dir: string) -> string[] ![io] {
    let mut effects: string[] = [];
    if src_dir.length == 0 { return effects; }
    if !fs.exists(src_dir) { return effects; }
    let files = _collect_sfn_files_cmd(src_dir, 64);
    let mut fi: int = 0;
    loop {
        if fi >= files.length { break; }
        let path = files[fi];
        fi += 1;
        if !fs.exists(path) { continue; }
        let program = parse_program(fs.readFile(path));
        let file_effects = inferred_public_effects(program, empty_import_symbols());
        let mut ei: int = 0;
        loop {
            if ei >= file_effects.length { break; }
            let effect = file_effects[ei];
            ei += 1;
            if !_cr_string_array_contains(effects, effect) {
                effects.push(effect);
            }
        }
    }
    return effects;
}

// Deduped union of two effect lists, sorted into canonical (alphabetical)
// order. Folds a member's Phase 4b inferred surface into its declared
// `[capabilities] required` before the envelope diff, so `drift ⊆ required`
// stays an invariant of `MemberCapabilityAudit`.
fn _cr_union_effects(declared: string[], inferred: string[]) -> string[] {
    let mut merged: string[] = [];
    let mut di: int = 0;
    loop {
        if di >= declared.length { break; }
        if !_cr_string_array_contains(merged, declared[di]) {
            merged.push(declared[di]);
        }
        di += 1;
    }
    let mut ii: int = 0;
    loop {
        if ii >= inferred.length { break; }
        if !_cr_string_array_contains(merged, inferred[ii]) {
            merged.push(inferred[ii]);
        }
        ii += 1;
    }
    return _cr_sort_strings(merged);
}

// Audit every workspace member's effect surface against the
// `[workspace.capabilities]` envelope. A member's required set is its declared
// `[capabilities] required` (Phase 4a) unioned with the inferred `![...]`
// surface of its public functions (Phase 4b, SFN-418, parsed from the member's
// `src/`). Emits E0406 for a malformed envelope entry (non-canonical name or
// non-alphabetical list) and E0405 per drifting effect.
fn workspace_capability_audit(workspace_root: string) -> CapabilityDriftReport ![io] {
    let mut members_out: MemberCapabilityAudit[] = [];
    let mut diags: Diagnostic[] = [];
    let mut has_drift: boolean = false;
    if workspace_root.length == 0 {
        return CapabilityDriftReport {
            members: members_out,
            diagnostics: diags,
            has_drift: false
        };
    }
    let ws_manifest = _cr_path_join(workspace_root, "workspace.toml");
    if !fs.exists(ws_manifest) {
        return CapabilityDriftReport {
            members: members_out,
            diagnostics: diags,
            has_drift: false
        };
    }
    let ws_text = fs.readFile(ws_manifest);
    let allow = toml_get_workspace_capabilities_allow(ws_text);
    let deny = toml_get_workspace_capabilities_deny(ws_text);

    // Validate the envelope declarations themselves (E0406) before auditing.
    let bad_allow = workspace_envelope_noncanonical(allow);
    let mut ai: int = 0;
    loop {
        if ai >= bad_allow.length { break; }
        diags.push(_cr_envelope_noncanonical_diagnostic("allow", bad_allow[ai], ws_manifest));
        ai += 1;
    }
    let bad_deny = workspace_envelope_noncanonical(deny);
    let mut ni: int = 0;
    loop {
        if ni >= bad_deny.length { break; }
        diags.push(_cr_envelope_noncanonical_diagnostic("deny", bad_deny[ni], ws_manifest));
        ni += 1;
    }
    if !workspace_list_is_sorted(allow) {
        diags.push(_cr_envelope_unsorted_diagnostic("allow", ws_manifest));
    }
    if !workspace_list_is_sorted(deny) {
        diags.push(_cr_envelope_unsorted_diagnostic("deny", ws_manifest));
    }

    let members = load_workspace_members(workspace_root);
    let mut mi: int = 0;
    loop {
        if mi >= members.length { break; }
        let m = members[mi];
        mi += 1;
        let manifest = _cr_path_join(_cr_path_join(workspace_root, m.member_path), "capsule.toml");
        let mut required: string[] = [];
        if fs.exists(manifest) {
            required = toml_get_capabilities_required(fs.readFile(manifest));
        }
        let grant = toml_get_workspace_capabilities_grant(ws_text, m.name);

        // Validate this member's grant carve-out itself (E0406) — grants are
        // envelope entries too, so a non-canonical or unsorted grant effect is
        // a manifest error the author should hear, not silently ineffective.
        let grant_label = "grants.\"" + m.name + "\"";
        let bad_grant = workspace_envelope_noncanonical(grant);
        let mut gi: int = 0;
        loop {
            if gi >= bad_grant.length { break; }
            diags.push(_cr_envelope_noncanonical_diagnostic(grant_label, bad_grant[gi], ws_manifest));
            gi += 1;
        }
        if !workspace_list_is_sorted(grant) {
            diags.push(_cr_envelope_unsorted_diagnostic(grant_label, ws_manifest));
        }

        // Phase 4b (SFN-418): strengthen the declared surface with the inferred
        // `![...]` surface of the member's public functions, so a member that
        // under-declares its real effect use in `[capabilities] required` is
        // still caught. `src/` is rooted like `manifest` above for consistency.
        let member_src = _cr_path_join(_cr_path_join(workspace_root, m.member_path), "src");
        let inferred = _cr_member_inferred_effects(member_src);
        let required_union = _cr_union_effects(required, inferred);

        let drift = workspace_effective_drift(allow, deny, grant, required_union);
        members_out.push(MemberCapabilityAudit {
            member_name: m.name, member_path: m.member_path, required: required_union, drift: drift
        });
        if drift.length > 0 {
            has_drift = true;
            let mut ki: int = 0;
            loop {
                if ki >= drift.length { break; }
                diags.push(_cr_capability_drift_diagnostic(m.name, manifest, drift[ki], allow));
                ki += 1;
            }
        }
    }
    return CapabilityDriftReport {
        members: members_out,
        diagnostics: diags,
        has_drift: has_drift
    };
}

// SFEP-0051 Phase 4c: the capability envelope is opt-in. Enforcement is active
// only when the workspace declares a non-empty `allow` ceiling — that list is
// the ceiling `effective(M) = (allow ∪ grant) \ deny` is carved from, so with
// no `allow` there is nothing to audit against. A workspace with no
// `[workspace.capabilities]` block (the common case, including this repo) is
// therefore never retroactively broken by the gate: it opts in by declaring an
// `allow` list. Returns false for a missing manifest or an empty/absent allow.
fn workspace_capability_envelope_active(workspace_root: string) -> boolean ![io] {
    if workspace_root.length == 0 { return false; }
    let ws_manifest = _cr_path_join(workspace_root, "workspace.toml");
    if !fs.exists(ws_manifest) { return false; }
    let allow = toml_get_workspace_capabilities_allow(fs.readFile(ws_manifest));
    return allow.length > 0;
}

// SFEP-0051 Phase 4c: read the `[workspace.capabilities] mode` enforcement
// knob. "warn" reports drift without failing (a migration aid only); every
// other value — absent, empty, or a typo — resolves to the fail-closed
// "enforce" default so a misspelled mode can never silently disable the gate.
fn workspace_capability_mode(workspace_root: string) -> string ![io] {
    if workspace_root.length == 0 { return "enforce"; }
    let ws_manifest = _cr_path_join(workspace_root, "workspace.toml");
    if !fs.exists(ws_manifest) { return "enforce"; }
    let raw = toml_get_workspace_capabilities_mode(fs.readFile(ws_manifest));
    if strings_equal(raw, "warn") { return "warn"; }
    return "enforce";
}

// The effective capability envelope for a member: `(allow ∪ grant) \ deny`,
// deduplicated and sorted into canonical (alphabetical) order. Pure — the
// `sfn capabilities audit` command uses it for the per-member "effective"
// column. Deny wins via `_cr_effect_covered`, so a denied `io` masks an
// allowed or granted `io` (or `io.*`).
fn workspace_effective_envelope(allow: string[], deny: string[], grant: string[]) -> string[] {
    let mut merged: string[] = [];
    let mut ai: int = 0;
    loop {
        if ai >= allow.length { break; }
        let ea = allow[ai];
        ai += 1;
        if _cr_effect_covered(deny, ea) { continue; }
        if !_cr_string_array_contains(merged, ea) { merged.push(ea); }
    }
    let mut gi: int = 0;
    loop {
        if gi >= grant.length { break; }
        let eg = grant[gi];
        gi += 1;
        if _cr_effect_covered(deny, eg) { continue; }
        if !_cr_string_array_contains(merged, eg) { merged.push(eg); }
    }
    return _cr_sort_strings(merged);
}

// SFEP-0051 Phase 4c: the workspace capability-envelope enforcement gate
// shared by `sfn check` and `sfn build`. Runs the declared-surface audit and
// renders every E0405 (drift) / E0406 (malformed envelope) diagnostic to
// stderr. In `enforce` mode (default) a non-empty report fails the build
// (returns 1); in `warn` mode the same diagnostics are reported but the gate
// returns 0 — a migration bridge, not the marketed state. A non-workspace
// input (`workspace_root == ""`, or no `workspace.toml`) is a silent no-op,
// so single-capsule and single-file builds are unaffected.
fn workspace_capability_gate(workspace_root: string) -> int ![io] {
    if workspace_root.length == 0 { return 0; }
    // Opt-in: no declared `allow` ceiling ⇒ no envelope ⇒ no-op. Without this
    // an envelope-free workspace would report every member's declared effect as
    // drift (empty `allow` covers nothing), breaking every `sfn check`/`build`.
    if !workspace_capability_envelope_active(workspace_root) { return 0; }
    let report = workspace_capability_audit(workspace_root);
    if report.diagnostics.length == 0 { return 0; }
    let empty_lines: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= report.diagnostics.length { break; }
        print.err(render_diagnostic(diagnostic_to_diag(report.diagnostics[i], "capability"), empty_lines, "capability"));
        i += 1;
    }
    if strings_equal(workspace_capability_mode(workspace_root), "warn") {
        print.err("[workspace.capabilities] mode = \"warn\": capability drift reported, not enforced");
        return 0;
    }
    return 1;
}

// Look up a workspace member by canonical name (e.g. "sfn/http") and return
// its src_dir. Returns "" if no such member exists. The compiler binary
// itself, plus the prelude, may declare names that are not import-targets;
// the caller decides whether the lookup result is meaningful.
fn workspace_member_for_spec(members: WorkspaceMember[], spec: string) -> string {
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        if strings_equal(members[i].name, spec) {
            return members[i].src_dir;
        }
        i += 1;
    }
    return "";
}

// SFEP-0051 Phase 3: resolve a member's inherited `[capsule] version`. A member
// opts into workspace inheritance with `version = { workspace = true }` (parsed
// verbatim as the inline-table marker string by `toml_get_version`). When it
// does, the resolved version is the workspace root's `[workspace.package]
// version`; otherwise the member's own concrete version wins. Pure so resolver
// unit tests can exercise it directly without introducing filesystem effects.
fn resolve_inherited_version(member_version: string, workspace_version: string) -> string {
    if toml_value_is_workspace_inherit(member_version) {
        return workspace_version;
    }
    return member_version;
}

// Resolve the whole workspace member graph into the flat lock-entry set a
// writer (`workspace_lock_write`) can serialize. Returns one `_LockEntry`
// per resolved `[workspace].members` entry — after `load_workspace_members`
// has expanded any `/*` glob and de-duplicated — carrying the member's
// canonical name and version read from its own capsule.toml.
//
// Member selection mirrors `load_workspace_members`: unsafe paths and
// members whose capsule.toml is missing or has no [capsule].name are
// already dropped (with a `print.err` warning) before this fn sees them,
// so no entry is ever emitted for an unnamed member.
//
// Hash field: workspace members are path-pinned local source trees, not
// content-addressed external dependencies fetched into the capsule cache.
// A member is identified by its workspace-relative path (fixed by
// workspace.toml), so there is no packaged form to hash and the integrity
// hash is left empty. Hashes in the flat lock schema are populated only
// for external deps; an empty hash here means "path-pinned, not hashed".
fn resolve_workspace_lock_entries(workspace_root: string) -> _LockEntry[] ![io] {
    let mut out: _LockEntry[] = [];
    let members = load_workspace_members(workspace_root);
    // Read the workspace root's `[workspace.package]` once so members that
    // inherit (`version = { workspace = true }`, SFEP-0051 Phase 3) resolve to a
    // concrete version before the lock entry is written — the resolver never
    // carries an un-inherited manifest past resolution (SFEP-0006 §4.12).
    let ws_manifest = _cr_path_join(workspace_root, "workspace.toml");
    let mut ws_package_version: string = "";
    if fs.exists(ws_manifest) {
        ws_package_version = toml_get_workspace_package_version(fs.readFile(ws_manifest));
    }
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        let member = members[i];
        let manifest = _cr_path_join(_cr_path_join(workspace_root, member.member_path), "capsule.toml");
        let mut version: string = "";
        if fs.exists(manifest) {
            version = resolve_inherited_version(toml_get_version(fs.readFile(manifest)), ws_package_version);
        }
        out.push(_LockEntry {
            capsule: member.name, version: version, hash: ""
        });
        i += 1;
    }
    return out;
}
