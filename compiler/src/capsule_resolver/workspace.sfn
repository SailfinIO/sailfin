// compiler/src/capsule_resolver/workspace.sfn
//
// Workspace member discovery: parsing `[workspace].members`, expanding
// trailing-`/*` globs against the workspace tree, applying
// `exclude`/`default-members` selection (SFEP-0051 Phase 5), and loading
// each member's canonical name + `src/` directory into `WorkspaceMember[]`.
import { substring } from "../string_utils";
import {
    toml_get_name,
    toml_get_workspace_default_members,
    toml_get_workspace_exclude,
    toml_get_workspace_members
} from "../toml_parser";
import {
    _cr_dirname,
    _cr_ends_with,
    _cr_find_char,
    _cr_path_join,
    _cr_sort_strings
} from "./paths";
import { WorkspaceMember } from "./types";

// ---- Workspace discovery ----
// Parse the newline-separated member list returned by toml_get_workspace_members
// into a string array. Pure string utility — exported so tests can exercise it
// without writing a workspace.toml to disk.
fn parse_workspace_member_paths(members_text: string) -> string[] {
    let mut out: string[] = [];
    if members_text.length == 0 { return out; }
    let mut start: int = 0;
    let len = members_text.length;
    loop {
        if start >= len { break; }
        let mut end: int = start;
        loop {
            if end >= len { break; }
            if substring(members_text, end, end + 1) == "\n" { break; }
            end += 1;
        }
        if end > start {
            // Entries are returned verbatim, including trailing-`/*` globs
            // (e.g. "capsules/sfn/*"). `_cr_expand_member_globs` expands those
            // against the workspace tree in `load_workspace_members`, where the
            // filesystem is in scope; this pure splitter stays IO-free.
            out.push(substring(members_text, start, end));
        }
        start = end + 1;
    }
    return out;
}

// Walk up from start_dir looking for workspace.toml. Returns the directory
// containing it, or "" if none is found within 16 levels. The workspace
// root is independent of (and may differ from) the project root: a project
// inside a workspace has both, while a standalone capsule has only the
// project root.
fn discover_workspace_root(start_dir: string) -> string ![io] {
    let mut dir: string = start_dir;
    if dir.length == 0 { dir = "."; }
    let mut depth: int = 0;
    loop {
        if depth >= 16 { break; }
        let manifest = _cr_path_join(dir, "workspace.toml");
        if fs.exists(manifest) { return dir; }
        let parent = _cr_dirname(dir);
        if strings_equal(parent, dir) { break; }
        if parent.length == 0 { break; }
        dir = parent;
        depth += 1;
    }
    return "";
}

// Read the canonical name of a workspace member by loading its capsule.toml.
// Returns "" if the member directory has no capsule.toml or no [capsule].name.
fn _cr_read_member_name(workspace_root: string, member_path: string) -> string ![io] {
    let manifest = _cr_path_join(_cr_path_join(workspace_root, member_path), "capsule.toml");
    if !fs.exists(manifest) { return ""; }
    return toml_get_name(fs.readFile(manifest));
}

// Check that a workspace member path is safe to join onto the workspace
// root: relative, no `..` traversal, no backslashes. Absolute paths and
// `..` segments would let a manifest reach outside the workspace.
fn _cr_is_safe_member_path(path: string) -> boolean {
    if path.length == 0 { return false; }
    // Reject absolute paths.
    if substring(path, 0, 1) == "/" { return false; }
    // Reject backslashes (Windows-style separators are disallowed in
    // workspace.toml).
    if _cr_find_char(path, "\\", 0) >= 0 { return false; }
    // Reject any `..` segment. Walk segments separated by `/`.
    let mut start: int = 0;
    loop {
        if start >= path.length { break; }
        let mut end: int = start;
        loop {
            if end >= path.length { break; }
            if substring(path, end, end + 1) == "/" { break; }
            end += 1;
        }
        let segment = substring(path, start, end);
        if strings_equal(segment, "..") { return false; }
        if strings_equal(segment, ".") { return false; }
        start = end + 1;
    }
    return true;
}

// Array membership test — used to keep member expansion duplicate-free.
fn _cr_str_in(arr: string[], s: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= arr.length { break; }
        if strings_equal(arr[i], s) { return true; }
        i += 1;
    }
    return false;
}

// SFEP-0051 Phase 5: drop members whose path appears in the workspace
// `exclude` list (Cargo `workspace.exclude`). Pure over an already-expanded
// path list, so a `capsules/sfn/*` glob can skip a scratch/vendored subdir
// without enumerating its siblings. Applied only to glob-expanded members in
// `_cr_expand_member_globs`; explicit literal members are never excluded,
// matching Cargo. Order-preserving.
fn _cr_filter_excluded(paths: string[], exclude: string[]) -> string[] {
    if exclude.length == 0 { return paths; }
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= paths.length { break; }
        let p = paths[i];
        i += 1;
        if !_cr_str_in(exclude, p) { out.push(p); }
    }
    return out;
}

// SFEP-0051 Phase 5: select the member paths a bare root build/test targets
// (Cargo `workspace.default-members`). `defaults` is the glob-expanded,
// exclude-filtered `default-members` set; keep every entry of `all_paths`
// present in it, preserving `all_paths` order. An empty `defaults` means the
// manifest declares no `default-members`, so every member is a default target
// (Cargo's fallback). Pure over path lists; the IO wrapper that reads the
// manifest is `load_workspace_default_members`.
fn _cr_select_default_member_paths(all_paths: string[], defaults: string[]) -> string[] {
    if defaults.length == 0 { return all_paths; }
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= all_paths.length { break; }
        let p = all_paths[i];
        i += 1;
        if _cr_str_in(defaults, p) { out.push(p); }
    }
    return out;
}

// Expand `[workspace].members` glob entries against the workspace tree
// (SFEP-0006 §4.2). Only a trailing `/*` is supported — Cargo-style implicit
// members: every immediate subdirectory of the prefix that carries a
// `capsule.toml` becomes a member, in deterministic (sorted) order. Literal
// entries pass through untouched. A `*` anywhere but a trailing `/*` is left
// verbatim for the literal path checks downstream to reject. Output is
// de-duplicated so a member covered by both a literal entry and a glob (or by
// two overlapping globs) is emitted once — otherwise the duplicate would reach
// `workspace.lock` as a repeated entry (`resolve_workspace_lock_entries` maps
// members 1:1 and the lock writer does not dedup).
//
// SFEP-0051 Phase 5: `exclude` (Cargo `workspace.exclude`) drops matching
// subdirs from each glob's expansion before they join the member set, so a
// `capsules/sfn/*` glob can skip a scratch/vendored dir without listing every
// sibling. It filters glob-expanded members only; explicit literal entries are
// never excluded, matching Cargo. Pass `[]` for no exclusions.
fn _cr_expand_member_globs(workspace_root: string, paths: string[], exclude: string[]) -> string[] ![io] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= paths.length { break; }
        let entry = paths[i];
        i += 1;
        if !_cr_ends_with(entry, "/*") {
            if !_cr_str_in(out, entry) { out.push(entry); }
            continue;
        }
        let prefix = substring(entry, 0, entry.length - 2);
        if !_cr_is_safe_member_path(prefix) {
            print.err("workspace: skipping unsafe glob member \"" + entry
                + "\" (prefix must be relative, no `..`, no backslashes)");
            continue;
        }
        let base = _cr_path_join(workspace_root, prefix);
        if !fs.exists(base) { continue; }
        let names = _cr_sort_strings(fs.listDirectory(base));
        let mut expanded: string[] = [];
        let mut j: int = 0;
        loop {
            if j >= names.length { break; }
            let name = names[j];
            j += 1;
            let member_path = prefix + "/" + name;
            let cap = _cr_path_join(_cr_path_join(workspace_root, member_path), "capsule.toml");
            if fs.exists(cap) { expanded.push(member_path); }
        }
        let kept = _cr_filter_excluded(expanded, exclude);
        let mut ki: int = 0;
        loop {
            if ki >= kept.length { break; }
            let member_path = kept[ki];
            ki += 1;
            if !_cr_str_in(out, member_path) { out.push(member_path); }
        }
    }
    return out;
}

// Load every workspace member listed in `<workspace_root>/workspace.toml`
// into a WorkspaceMember[] with each member's canonical name pre-resolved.
// Unsafe paths and members whose capsule.toml is missing or unnamed are
// skipped with a `print.err` warning.
fn load_workspace_members(workspace_root: string) -> WorkspaceMember[] ![io] {
    let mut out: WorkspaceMember[] = [];
    if workspace_root.length == 0 { return out; }
    let manifest = _cr_path_join(workspace_root, "workspace.toml");
    if !fs.exists(manifest) { return out; }
    let text = fs.readFile(manifest);
    let members_text = toml_get_workspace_members(text);
    let exclude = toml_get_workspace_exclude(text);
    let paths = _cr_expand_member_globs(workspace_root, parse_workspace_member_paths(members_text), exclude);
    let mut i: int = 0;
    loop {
        if i >= paths.length { break; }
        let path = paths[i];
        if !_cr_is_safe_member_path(path) {
            print.err("workspace: skipping unsafe member path \"" + path
                + "\" (must be relative, no `..`, no backslashes)");
            i += 1;
            continue;
        }
        let name = _cr_read_member_name(workspace_root, path);
        if name.length == 0 {
            print.err("workspace: skipping member \"" + path
                + "\" — capsule.toml missing or has no [capsule].name");
            i += 1;
            continue;
        }
        let src = _cr_path_join(_cr_path_join(workspace_root, path), "src");
        out.push(WorkspaceMember {
            name: name, member_path: path, src_dir: src
        });
        i += 1;
    }
    return out;
}

// SFEP-0051 Phase 5: the workspace members a bare `sfn build`/`sfn test` at the
// workspace root targets when no `-p` is given (Cargo
// `workspace.default-members`). Returns the `default-members` subset when the
// manifest declares one, else every member (`load_workspace_members`, already
// glob-expanded and `exclude`-filtered) — Cargo's fallback. `default-members`
// entries may themselves be trailing-`/*` globs, expanded here against the same
// `exclude` list; an entry that does not resolve to a real member is ignored
// (the intersection with `load_workspace_members` is the source of truth for
// which members exist). The CLI fan-out that consumes this — bare-root
// build/test target selection in `cli/commands/{build,test}.sfn` — is a
// follow-up; this provides the resolver-tier selection primitive it will call.
fn load_workspace_default_members(workspace_root: string) -> WorkspaceMember[] ![io] {
    let all = load_workspace_members(workspace_root);
    if workspace_root.length == 0 { return all; }
    let manifest = _cr_path_join(workspace_root, "workspace.toml");
    if !fs.exists(manifest) { return all; }
    let text = fs.readFile(manifest);
    let defaults_raw = toml_get_workspace_default_members(text);
    if defaults_raw.length == 0 { return all; }
    let exclude = toml_get_workspace_exclude(text);
    let defaults = _cr_expand_member_globs(workspace_root, defaults_raw, exclude);
    // A declared `default-members` that resolves to nothing (a typo'd glob
    // prefix, or every entry excluded) is an empty default target set — NOT the
    // undeclared→all fallback above. Guard here so the pure selector's
    // empty-means-all contract never fires on a declared-but-unresolved set,
    // which would silently widen a narrowed bare-root build to the whole
    // workspace. Warn so a typo is diagnosable rather than silent.
    if defaults.length == 0 {
        print.err("workspace: [workspace].default-members matched no workspace member"
            + " — bare-root build/test has no default target");
        return [];
    }
    let mut all_paths: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= all.length { break; }
        all_paths.push(all[i].member_path);
        i += 1;
    }
    let selected = _cr_select_default_member_paths(all_paths, defaults);
    let mut out: WorkspaceMember[] = [];
    let mut k: int = 0;
    loop {
        if k >= all.length { break; }
        let m = all[k];
        k += 1;
        if _cr_str_in(selected, m.member_path) { out.push(m); }
    }
    return out;
}
