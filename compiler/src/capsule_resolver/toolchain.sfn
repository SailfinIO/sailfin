// compiler/src/capsule_resolver/toolchain.sfn
//
// Toolchain pin gate (SFEP-0046 Phase 1). Resolves the effective
// `[toolchain]` pin for an entry path — a `workspace.toml` pin is the
// default, a member `capsule.toml` pin overrides it per field — and decides
// whether the running compiler satisfies it. Unpinned projects are a no-op,
// so the feature stays additive.
import { _cwd_cmd } from "../build/fs";
import {
    SemVer,
    semver_is_exact_release,
    semver_is_valid,
    semver_parse,
    semver_satisfies_floor
} from "../semver";
import { substring } from "../string_utils";
import {
    toml_get_toolchain_channel,
    toml_get_toolchain_sfn,
    toml_get_toolchain_version
} from "../toml_parser";
import { resolve_compiler_version } from "../version";
import { _cr_dirname, _cr_path_join, discover_project_root } from "./paths";
import { discover_workspace_root } from "./workspace";

// Verify the running toolchain satisfies a manifest `[toolchain]` pin
// (floor semantics: running >= pin). A `workspace.toml` pin is the default;
// a member `capsule.toml` pin overrides it per field. Unpinned projects are
// a no-op so the feature is additive. `--skip-toolchain-check`,
// `SAILFIN_SKIP_TOOLCHAIN_CHECK`, and `SAILFIN_TOOLCHAIN=off` downgrade a
// mismatch to a warning and proceed. Returns 0 to proceed, 1 on an enforced
// mismatch.
fn _toolchain_start_dir(hint: string) -> string ![io] {
    let mut start: string = hint;
    let n = start.length;
    if n > 4 {
        if strings_equal(substring(start, n - 4, n), ".sfn") {
            start = _cr_dirname(start);
        }
    }
    // `discover_project_root`/`discover_workspace_root` ascend with
    // `_cr_dirname`, which maps "." to "." — so the walk terminates after
    // testing the starting directory itself and can never reach an ancestor
    // `workspace.toml`. Three ordinary invocations land on that "." start: an
    // empty hint (every early selection, since naming the entry file requires
    // a parse that has not run yet), `sfn build` with no path, and a bare
    // relative `main.sfn`. Resolving to a concrete directory first is what
    // lets a command run from inside a workspace member discover the
    // workspace it belongs to (SFN-1070).
    if start.length == 0 || strings_equal(start, ".") { return _cwd_cmd(); }
    return start;
}

fn _toolchain_leading_id(prerelease: string) -> string {
    if prerelease.length == 0 { return ""; }
    let mut i: int = 0;
    loop {
        if i >= prerelease.length { break; }
        if strings_equal(substring(prerelease, i, i + 1), ".") {
            return substring(prerelease, 0, i);
        }
        i += 1;
    }
    return prerelease;
}

// Channel precedence: stable > rc > beta > alpha. An unrecognized pin
// channel does not constrain (-1); an unrecognized running prerelease is
// treated as most-unstable (0) so a `stable` pin still rejects it.
fn _toolchain_channel_rank(name: string) -> int {
    if strings_equal(name, "stable") { return 3; }
    if strings_equal(name, "rc") { return 2; }
    if strings_equal(name, "beta") { return 1; }
    if strings_equal(name, "alpha") { return 0; }
    return -1;
}

fn _toolchain_running_channel_rank(running: SemVer) -> int {
    if running.prerelease.length == 0 { return 3; }
    let id = _toolchain_leading_id(running.prerelease);
    let rank = _toolchain_channel_rank(id);
    if rank < 0 { return 0; }
    return rank;
}

// Floor + channel evaluation for one candidate version, with no diagnostics.
// A malformed pin does not constrain (matching the warn-and-ignore behavior
// the gate has always had), so an unparseable `pin_sfn` or an unrecognized
// `pin_channel` is skipped rather than treated as unsatisfiable.
fn _toolchain_evaluate(pin_sfn: string, pin_channel: string, candidate: SemVer) -> boolean {
    let mut ok: boolean = true;
    if pin_sfn.length > 0 {
        let pin = semver_parse(pin_sfn);
        if semver_is_valid(pin) {
            if semver_satisfies_floor(candidate, pin) == false { ok = false; }
        }
    }
    if pin_channel.length > 0 {
        let pin_rank = _toolchain_channel_rank(pin_channel);
        if pin_rank >= 0 {
            if _toolchain_running_channel_rank(candidate) < pin_rank {
                ok = false;
            }
        }
    }
    return ok;
}

// The pin decision, split out of the gate (SFN-172) so the re-exec
// dispatcher (`cli/commands/toolchain.sfn`) reuses the same discovery +
// floor/channel evaluation before deciding to fetch-and-re-exec. `pinned` is
// false for an unpinned project (the additive no-op); `satisfied` is the
// floor+channel result for the *running* toolchain. `pin_sfn` carries the
// version pin verbatim (the dispatcher's default fetch target);
// `pin_desc`/`pin_source`/`running_str` back the diagnostics.
//
// `pin_channel` carries the channel pin verbatim so an explicitly *selected*
// version can be re-evaluated against the same requirement without
// rediscovering the manifest (SFEP-0073 §3.3: a one-shot or
// environment-selected compiler below the project minimum still errors).
// `satisfied` answers that question for the running toolchain only; use
// `toolchain_selection_satisfies` for any other candidate.
struct ToolchainDecision {
    pinned: boolean;
    satisfied: boolean;
    pin_sfn: string;
    pin_channel: string;
    pin_desc: string;
    pin_source: string;
    running_str: string;
    // SFEP-0073 §3.2, the additive exact selection. `pin_version` is the
    // root's `[toolchain] version` verbatim and is empty when absent, so an
    // SFEP-0046 manifest keeps its floor-only behavior untouched.
    // `version_source` names the manifest that supplied it, separately from
    // `pin_source`, because the exact field and the floor may come from
    // different files under per-field merging.
    //
    // `version_error` is the reason the field is unusable — malformed
    // (§3.2 rule 2) or below the root's own `sfn`/`channel` (§3.2 rule 4).
    // Carried rather than raised because discovery has no error channel; the
    // selection caller reports it and refuses *before* any fetch, so a
    // manifest never resolves a version it forbids itself.
    pin_version: string;
    version_source: string;
    version_error: string;
    // The manifest file `pin_version` was read from — the joined path this
    // function already computes as `ws_path`/`cap_path` — "" when absent.
    // `update --project` (SFEP-0073 §3.4, SFN-1071) rewrites that file
    // directly; `version_source` is a label ("capsule.toml"), not a path, and
    // cannot be joined back into one when the project root differs from cwd.
    version_path: string;
}

// Discover the manifest `[toolchain]` pin and evaluate the running toolchain
// against it (floor semantics: running >= pin; channel rank running >= pin).
// A `workspace.toml` pin is the default; a member `capsule.toml` pin overrides
// it per field. The running version is resolved only when a pin exists, so an
// unpinned project reads no version (preserving the gate's early return).
// Malformed pins warn and do not constrain, exactly as the gate did inline.
fn toolchain_decide(entry_hint: string, binary_dir: string) -> ToolchainDecision ![io] {
    let start = _toolchain_start_dir(entry_hint);
    let project_root = discover_project_root(start);
    let workspace_root = discover_workspace_root(start);

    // Track each field's origin separately so the mismatch diagnostic
    // attributes the pin accurately when a member capsule.toml overrides only
    // one field of a workspace.toml default.
    let mut pin_sfn: string = "";
    let mut pin_channel: string = "";
    let mut pin_version: string = "";
    let mut sfn_source: string = "";
    let mut channel_source: string = "";
    let mut version_source: string = "";
    let mut version_path: string = "";
    if workspace_root.length > 0 {
        let ws_path = _cr_path_join(workspace_root, "workspace.toml");
        if fs.exists(ws_path) {
            let ws_text = fs.readFile(ws_path);
            pin_sfn = toml_get_toolchain_sfn(ws_text);
            pin_channel = toml_get_toolchain_channel(ws_text);
            pin_version = toml_get_toolchain_version(ws_text);
            if pin_sfn.length > 0 { sfn_source = "workspace.toml"; }
            if pin_channel.length > 0 { channel_source = "workspace.toml"; }
            if pin_version.length > 0 {
                version_source = "workspace.toml";
                version_path = ws_path;
            }
        }
    }
    if project_root.length > 0 {
        let cap_path = _cr_path_join(project_root, "capsule.toml");
        if fs.exists(cap_path) {
            let cap_text = fs.readFile(cap_path);
            let m_sfn = toml_get_toolchain_sfn(cap_text);
            let m_channel = toml_get_toolchain_channel(cap_text);
            let m_version = toml_get_toolchain_version(cap_text);
            if m_sfn.length > 0 {
                pin_sfn = m_sfn;
                sfn_source = "capsule.toml";
            }
            if m_channel.length > 0 {
                pin_channel = m_channel;
                channel_source = "capsule.toml";
            }
            if m_version.length > 0 {
                pin_version = m_version;
                version_source = "capsule.toml";
                version_path = cap_path;
            }
        }
    }

    let mut d = ToolchainDecision {
        pinned: false,
        satisfied: true,
        pin_sfn: "",
        pin_channel: "",
        pin_desc: "",
        pin_source: "",
        running_str: "",
        pin_version: "",
        version_source: "",
        version_error: "",
        version_path: ""
    };
    if pin_sfn.length == 0 && pin_channel.length == 0 && pin_version.length == 0 {
        return d;
    }
    // `pinned` keeps its SFEP-0046 meaning — a floor and/or channel
    // requirement exists — so an exact-only root does not start reporting a
    // mismatch against a requirement it never stated. The exact field rides
    // alongside it and is consulted by selection, not by the floor gate.
    d.pinned = pin_sfn.length > 0 || pin_channel.length > 0;
    d.pin_sfn = pin_sfn;
    d.pin_channel = pin_channel;
    d.pin_version = pin_version;
    d.version_source = version_source;
    d.version_path = version_path;

    let running_str = resolve_compiler_version(binary_dir);
    let running = semver_parse(running_str);
    d.running_str = running_str;

    // Warnings stay here rather than in `_toolchain_evaluate` because a
    // malformed pin should be reported once per discovery, not once per
    // candidate evaluated against it.
    if pin_sfn.length > 0 {
        if !semver_is_valid(semver_parse(pin_sfn)) {
            print.err("warning: [toolchain] sfn = \"" + pin_sfn
                + "\" is not a valid version; ignoring the pin");
        }
    }
    if pin_channel.length > 0 {
        if _toolchain_channel_rank(pin_channel) < 0 {
            print.err("warning: [toolchain] channel = \"" + pin_channel
                + "\" is not a recognized channel (stable|rc|beta|alpha); ignoring the channel pin");
        }
    }
    d.satisfied = _toolchain_evaluate(pin_sfn, pin_channel, running);

    let mut pin_desc: string = "";
    if pin_sfn.length > 0 { pin_desc = "sfn >= " + pin_sfn; }
    // Only describe a channel that was actually enforced: an unrecognized
    // channel warns and does not constrain (above), so including it here would
    // make the mismatch diagnostic claim a requirement that was never applied.
    if pin_channel.length > 0 {
        if _toolchain_channel_rank(pin_channel) >= 0 {
            if pin_desc.length > 0 { pin_desc = pin_desc + " "; }
            pin_desc = pin_desc + "(" + pin_channel + " channel)";
        }
    }
    d.pin_desc = pin_desc;

    // Attribute the diagnostic to whichever file(s) actually contributed a
    // pinned field — both, when a member override and a workspace default each
    // supplied one.
    let mut pin_source: string = sfn_source;
    if channel_source.length > 0 {
        if pin_source.length == 0 { pin_source = channel_source; } else {
            if !strings_equal(pin_source, channel_source) {
                pin_source = pin_source + " + " + channel_source;
            }
        }
    }
    // Captured before the exact field joins the attribution below. The
    // "exact version is below its own minimum" diagnostic has to name where
    // that *minimum* came from; folding the version's own file into the string
    // first would point the reader at the manifest supplying the value being
    // rejected rather than the requirement rejecting it.
    let requirement_source = pin_source;

    // The exact field is a third contributor to the same requirement, so it
    // joins the attribution: under per-field merging a root can take its floor
    // from `workspace.toml` and its exact version from `capsule.toml`, and a
    // diagnostic naming only one of them sends the reader to the wrong file.
    if version_source.length > 0 {
        if pin_source.length == 0 { pin_source = version_source; } else {
            if !strings_equal(pin_source, version_source) {
                pin_source = pin_source + " + " + version_source;
            }
        }
    }
    if pin_source.length == 0 { pin_source = "capsule.toml"; }
    d.pin_source = pin_source;

    // SFEP-0073 §3.2 rules 2 and 4. Validated here, at discovery, so an
    // unusable exact field is refused before selection reaches the network:
    // a manifest must never fetch a version its own floor or stability
    // constraint forbids. A malformed *floor* still only warns (above) — that
    // is SFEP-0046 behavior this slice must not change — but the exact field
    // is new surface with no compatibility debt, so it fails closed.
    if pin_version.length > 0 {
        if !semver_is_exact_release(pin_version) {
            d.version_error = "is not an exact release version"
                + " (a complete release semver, no build metadata, no channel alias)";
        } else {
            if !_toolchain_evaluate(pin_sfn, pin_channel, semver_parse(pin_version)) {
                let mut req_src = requirement_source;
                if req_src.length == 0 { req_src = "capsule.toml"; }
                d.version_error = "does not satisfy the project's own requirement "
                    + pin_desc
                    + " ("
                    + req_src
                    + " [toolchain])";
            }
        }
    }

    return d;
}

// The fail-closed diagnostic for an unusable exact `[toolchain] version`
// (SFEP-0073 §3.2 rules 2 and 4). Separate from `toolchain_print_mismatch`:
// that one reports a *running* toolchain failing a valid requirement, this one
// reports a requirement that is itself invalid, which no installed toolchain
// could satisfy.
fn toolchain_print_version_error(d: ToolchainDecision) -> void ![io] {
    print.err("error: invalid [toolchain] version");
    print.err("  " + d.version_source + " sets version = \"" + d.pin_version
        + "\", which "
        + d.version_error);
    print.err("  correct the manifest, or select a toolchain explicitly: sfn +<version> <command>");
}

// Evaluate an explicitly *selected* version against the same pin the running
// toolchain was measured against (SFEP-0073 §3.3). `toolchain_decide` answers
// the floor question for the running compiler; a one-shot `+<version>` or an
// exact `SAILFIN_TOOLCHAIN` selects a different compiler, and that choice must
// clear the project's minimum too rather than inheriting the running
// toolchain's verdict.
//
// Fail-closed on an unparseable candidate: callers validate the selector with
// `toolchain_is_valid_install_version` first, so reaching this with a
// non-version string means the selector was never a version and cannot be
// shown to satisfy a floor.
fn toolchain_selection_satisfies(d: ToolchainDecision, candidate: string) -> boolean {
    if !d.pinned { return true; }
    let parsed = semver_parse(candidate);
    if !semver_is_valid(parsed) { return false; }
    return _toolchain_evaluate(d.pin_sfn, d.pin_channel, parsed);
}

// The 4-line fail-closed mismatch diagnostic — the enforced-error output of
// the pin gate. Shared by the dispatcher's `local`/no-fetch refusal path and
// its no-concrete-version fallback (SFN-172); the gate + dispatch entry point
// lives in `cli/commands/toolchain.sfn::toolchain_gate_or_dispatch`.
fn toolchain_print_mismatch(d: ToolchainDecision) -> void ![io] {
    print.err("error: toolchain mismatch");
    print.err("  this project pins " + d.pin_desc + " (" + d.pin_source
        + " [toolchain])");
    print.err("  but the running toolchain is " + d.running_str);
    print.err("  install the pinned toolchain, or re-run with --skip-toolchain-check to override");
}
