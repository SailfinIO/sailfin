// compiler/src/capsule_resolver/locate.sfn
//
// The manifest-driven capsule source locator: given a declared dep spec and
// version, find the on-disk `src/` directory that holds its `.sfn` sources.
//
// This lives in its own module rather than `paths.sfn` — which already holds
// every helper this locator uses — because `paths.sfn` is not usable for it:
// `paths.sfn` imports `./types`, and `types.sfn` imports
// `../runtime_capsule_resolver`. Hosting a locator consumed from outside the
// resolver (SFN-773) in `paths.sfn` would create a cycle for that consumer.
// `locate.sfn` imports from `paths`/`provenance`/`types` but is imported BY
// `discovery.sfn`, so it stays cycle-free. Do not merge this back into
// `paths.sfn`.
import { substring } from "../string_utils";
import {
    _cr_dirname,
    _cr_find_char,
    _cr_get_home,
    _cr_is_safe_segment,
    _cr_is_safe_version,
    _cr_path_join
} from "./paths";
import { capsule_origin_cache, capsule_origin_workspace } from "./provenance";
import { CapsuleLocation } from "./types";

// Locate the src/ directory for a capsule dep. Checks the in-tree
// capsules/<scope>/<name>/src/ first (compiler self-build and ecosystem
// development) and falls back to ~/.sfn/cache/capsules/<scope>/<name>/<version>/src/
// (end-user builds after `sfn add`).
//
// Returns the provenance alongside the path (SFN-715): the two branches differ
// in trust, and only the caller that knows which one matched can apply the
// private-capsule gate. A miss reports the least-trusted origin so a caller
// that ignores the empty `src_dir` cannot accidentally treat a miss as local.
export fn locate_capsule_src(project_root: string, spec: string, version: string) -> CapsuleLocation ![io] {
    let missing = CapsuleLocation {
        src_dir: "",
        origin: capsule_origin_cache()
    };
    let slash = _cr_find_char(spec, "/", 0);
    if slash <= 0 { return missing; }
    let slash2 = _cr_find_char(substring(spec, slash + 1, spec.length), "/", 0);
    if slash2 >= 0 { return missing; }
    let scope = substring(spec, 0, slash);
    let name = substring(spec, slash + 1, spec.length);
    if !_cr_is_safe_segment(scope) { return missing; }
    if !_cr_is_safe_segment(name) { return missing; }

    // Prefer in-tree source if we're inside a sailfin repo checkout.
    //
    // SFN-341: the probe is anchored on `project_root`, so it is only a probe
    // at all when there IS one. `_cr_path_join("", ...)` yields a bare
    // `capsules/<scope>/<name>/src`, which `fs.exists` resolves against the
    // PROCESS working directory — an anchor unrelated to the build. A
    // manifest-less build resolving the runtime's `[dependencies]` union has
    // `project_root == ""` by construction, and running it from a checkout
    // root made the union spell a capsule `capsules/sfn/strings/src/...` while
    // the workspace-implicit walk spelled the identical tree
    // `<abs workspace root>/capsules/sfn/strings/src/...`. Two spellings of
    // one file are two providers of one slug to the dedupe pass, which fails
    // the resolution as a slug collision and drops EVERY capsule source from
    // the link. Skipping the unanchored probe loses no resolution: the
    // manifest-less path reaches the same tree through
    // `locate_runtime_dep_capsule_src`, anchored on the runtime bundle.
    if project_root.length > 0 {
        let in_tree = _cr_path_join(project_root, "capsules/" + scope + "/"
            + name
            + "/src");
        if fs.exists(in_tree) {
            return CapsuleLocation {
                src_dir: in_tree,
                origin: capsule_origin_workspace()
            };
        }
    }

    // Fall back to the user cache populated by `sfn add`.
    if version.length == 0 { return missing; }
    if !_cr_is_safe_version(version) { return missing; }
    let home = _cr_get_home();
    if home.length == 0 { return missing; }
    let cached = home + "/.sfn/cache/capsules/" + scope + "/" + name + "/"
        + version
        + "/src";
    if fs.exists(cached) {
        return CapsuleLocation {
            src_dir: cached,
            origin: capsule_origin_cache()
        };
    }
    return missing;
}

// Locate a capsule that ships with the toolchain, resolved relative to the
// runtime capsule's manifest dir rather than the project root or the version
// cache.
//
// A runtime capsule's `[dependencies]` entry is not something the user
// declared or `sfn add`-ed — it ships alongside the runtime with the same
// provenance, and `"*"` is not a cacheable version. So neither leg of
// `locate_capsule_src` finds it once the toolchain is installed outside a repo
// checkout: `project_root` is the user's own project, and the cache leg needs a
// concrete version. Without this leg an installed toolchain fails to locate the
// dependency and link-fails every user program (SFN-773, design note
// `sfn-341-native-tls-runtime-swap.md` §3.1.4).
//
// One path shape covers both layouts, which is why this takes the manifest dir
// rather than a root: in-repo `<root>/runtime` yields `<root>/capsules/...`,
// and installed `<prefix>/runtime` yields `<prefix>/capsules/...`. Derived with
// `_cr_dirname` rather than a `..` segment so the result stays normalized and
// reads cleanly in diagnostics.
//
// Trust is `capsule_origin_workspace()`: these sources ship with the compiler,
// so they carry the runtime's own provenance, not a fetched capsule's.
export fn locate_runtime_dep_capsule_src(runtime_manifest_dir: string, spec: string) -> CapsuleLocation ![io] {
    let missing = CapsuleLocation {
        src_dir: "",
        origin: capsule_origin_cache()
    };
    if runtime_manifest_dir.length == 0 { return missing; }
    let slash = _cr_find_char(spec, "/", 0);
    if slash <= 0 { return missing; }
    let slash2 = _cr_find_char(substring(spec, slash + 1, spec.length), "/", 0);
    if slash2 >= 0 { return missing; }
    let scope = substring(spec, 0, slash);
    let name = substring(spec, slash + 1, spec.length);
    if !_cr_is_safe_segment(scope) { return missing; }
    if !_cr_is_safe_segment(name) { return missing; }
    let root = _cr_dirname(runtime_manifest_dir);
    let src_dir = _cr_path_join(root, "capsules/" + scope + "/" + name + "/src");
    if fs.exists(src_dir) {
        return CapsuleLocation {
            src_dir: src_dir,
            origin: capsule_origin_workspace()
        };
    }
    return missing;
}
