fn _cr_implicit_provider_asm_paths(provider_slugs: string[], work_dir: string) -> string[] {
    let context_root = _cr_import_context_root(work_dir);
    let mut paths: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= provider_slugs.length { break; }
        paths.push(context_root + "/" + provider_slugs[index] + ".sfn-asm");
        index += 1;
    }
    return paths;
}

// Struct definitions and their constructors live in `./capsule_resolver/types`
// and are NOT re-exported from here. Consumers import them from that module
// directly. A re-export — bare or with a `from` clause — leaves this module's
// `.sfn-asm` without a `.fn` signature for the symbol, so a consumer resolving
// through it cannot determine the callee's return type and the emit fails
// (`E0600`, `E1002`, docs/rca/2026-04-18-reexport-diagnostic-gep.md).
export {
    _cr_effective_isolation_exe,
    prepare_project_capsules,
    prepare_project_capsules_for_test,
    prepare_runtime_dep_capsules,
    stage_capsule_imports_for_emit
};

// ---- Dependency enumeration ----
// ---- Import-context staging ----
// ---- Cache wiring helpers (Stage C PR1b) ----
// ---- Capsule module compilation ----
// ---- Top-level orchestrator ----
// Resolve, stage, and compile every dependency reachable from
// `input_path`. Returns a `ProjectCapsuleResult` carrying the dep
// `.ll` paths and the per-build cache stats. `ll_paths` is empty
// when no dependencies are needed AND on slug collision or stage
// failure. Issue #991: the `success` flag disambiguates the two —
// `success = true` with empty `ll_paths` means "no deps" (a consumer
// can safely link the entry alone), while `success = false` means a
// collision/stage/compile failure left `ll_paths` empty. The `-p`
// build driver (`cli_main.sfn`) consults this flag and exits non-zero
// instead of linking the survivors. Other consumers that read only
// `ll_paths` (e.g. the `sfn run` path) do not yet check it and would
// need the same guard to propagate emit failures.
// #1405 Bug 2: minimum resolved-closure size at which a positional
// (non-`-p`) build or test opts into subprocess-per-module isolation.
// Below it, the closure compiles in-process (cheaper, and avoids
// perturbing the entry's in-process arena with `process.run` argv
// allocations — see the `walk_src` note in cli_main.sfn). At or above
// it, each module compiles in a child with a fresh arena that dies on
// exit, bounding peak RSS under the 8 GiB self-cap. A whole-compiler-
// importing source (e.g. a unit test importing `lower_to_llvm_ir_from_text`)
// resolves ~120 modules, far above this; a typical end-user build with a
// handful of capsule deps stays in-process.
fn _cr_positional_isolation_threshold() -> int { return 16; }

// #1405 Bug 2: choose the emit binary for a build/test. A `-p` build
// always threads a non-empty `sailfin_exe`, which is returned unchanged
// so the self-host path is byte-for-byte unaffected. A positional
// build/test arrives with an empty `sailfin_exe`; when a same-generation
// binary is available (`binary_dir`) and the resolved import closure is
// large, resolve a real, spawnable child path so `stage_capsule_imports` /
// `compile_capsule_modules` take their subprocess-per-module path
// instead of accumulating the entire closure in one never-freed bump
// arena (the ~15.5 GB cold-compile OOM this issue fixes).
//
// SFN-904: below the threshold, or with no `binary_dir`, this still
// returns `sailfin_exe` unchanged (empty on the positional path) rather
// than guessing a filename. The prior body fabricated `<binary_dir>/sfn`
// unconditionally — wrong whenever the running binary isn't literally
// named `sfn` (any `-o`-renamed build, e.g. `cp program; mv program sfn`
// skipped), which spawned every isolated-emit child against a
// nonexistent path and killed the build. `self_exe` — the actual running
// binary's own path, threaded by the caller (`ctx.compiler_path`) — is
// preferred over the `binary_dir` probe below because it names the exact
// file that answered this invocation, without the probe's ordering
// ambiguity; `_resolve_self_path` remains as the fallback for callers
// that have no `self_exe` to thread (e.g. `sfn check`).
fn _cr_effective_isolation_exe(sailfin_exe: string, self_exe: string, binary_dir: string, source_count: int) -> string ![io] {
    if sailfin_exe.length > 0 { return sailfin_exe; }
    if binary_dir.length == 0 { return sailfin_exe; }
    if source_count < _cr_positional_isolation_threshold() {
        return sailfin_exe;
    }
    if self_exe.length > 0 { return self_exe; }
    let resolved = _resolve_self_path(binary_dir);
    if resolved.length > 0 { return resolved; }
    // Deliberate graceful degrade, not a failure: no known-good child
    // path could be resolved, so isolated emit is skipped and the
    // closure compiles in-process instead — slower on a large closure,
    // but never broken the way a fabricated nonexistent path was.
    return "";
}

fn prepare_project_capsules(input_path: string, config: BuildCacheConfig, consumer: ResolverConsumer, sailfin_exe: string, self_exe: string, work_dir: string, binary_dir: string) -> ProjectCapsuleResult ![io] {
    let entry_paths: string[] = [input_path];
    return _cr_prepare(entry_paths, config, consumer, sailfin_exe, self_exe, work_dir, binary_dir);
}

// SFN-341: resolve a runtime capsule's own `[dependencies]` into a
// `ProjectCapsuleResult` with no project entry. A runtime capsule's
// `sfn-sources` land in every binary, so its declared deps must reach
// the link the same way a project's do — this delegates to the shared
// `_cr_prepare` tail with an empty `entry_paths` and
// `walk_project_src: false`, so the entry-indexing branches in that
// tail never fire.
//
// The returned `runtime_capsules` is always `[]`. The manifest-less
// runtime-union branch never assigns `manifest_dep_specs`, so the
// `enumerate_runtime_capsule_artifacts` call below is not reached. Only
// `ll_paths` is meaningful here; a caller that needs the runtime
// capsules themselves resolves them with `runtime_capsule_from_root`,
// as `run.sfn` already does when the resolver surfaces none.
fn prepare_runtime_dep_capsules(runtime_root: string, config: BuildCacheConfig, sailfin_exe: string, self_exe: string, work_dir: string, binary_dir: string) -> ProjectCapsuleResult ![io] {
    let empty_entry_paths: string[] = [];
    let consumer = ResolverConsumer {
        scope: "",
        name: "",
        walk_project_src: false,
        include_host_as_dep: false,
        runtime_root: runtime_root,
        retain_full_runtime: false
    };
    return _cr_prepare(empty_entry_paths, config, consumer, sailfin_exe, self_exe, work_dir, binary_dir);
}

// Shared tail of `prepare_project_capsules` / `prepare_runtime_dep_capsules`:
// resolve + dedupe, surface declared runtime capsules, stage, and compile.
fn _cr_prepare(entry_paths: string[], config: BuildCacheConfig, consumer: ResolverConsumer, sailfin_exe: string, self_exe: string, work_dir: string, binary_dir: string) -> ProjectCapsuleResult ![io] {
    let empty_paths: string[] = [];
    let empty_events: ModuleCacheEvent[] = [];
    let empty_runtime_capsules: RuntimeCapsuleArtifacts[] = [];
    // SFN-833: the build path resolves through the filtering wrapper, so
    // every list derived below — the staging input, `slug_universe_extra`'s
    // universe, `compile_capsule_modules`'s input — comes off the filtered
    // set. SFN-894 gives check the same single-list discipline through its
    // check-only facade, rooted in the explicitly requested files rather than
    // build's runtime/link roots (SFEP-0070 §3.6).
    let resolved = _cr_resolve_dedupe_filtered(entry_paths, consumer, binary_dir);
    if resolved.has_collision {
        // Slug collision is a setup error (already reported by
        // `_cr_resolve_and_dedupe`), not a "no deps" build.
        return ProjectCapsuleResult {
            ll_paths: empty_paths,
            entry_import_asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            success: false,
            stats: empty_cache_stats(),
            module_events: empty_events,
            runtime_capsules: empty_runtime_capsules,
            runtime_demand: resolved.runtime_demand
        };
    }
    // Stage D PR2: surface every `kind = "runtime"` workspace
    // member the project's `[dependencies]` declares. Filtered by
    // `manifest_dep_specs` so end-user builds (no runtime dep
    // declared) get an empty list and the link path falls through
    // to the legacy `_clang_compile_runtime_objects` helper.
    // Resolver-side discovery is the source of truth: the workspace
    // root + the manifest's declared deps both come from
    // `_cr_resolve_and_dedupe` already.
    let mut runtime_capsules: RuntimeCapsuleArtifacts[] = [];
    if resolved.workspace_root.length > 0 {
        if resolved.manifest_dep_specs.length > 0 {
            // SFN-882: narrow at the point of materialisation so every
            // `ProjectCapsuleResult` below carries the selected set and no
            // consumer has to remember to filter.
            runtime_capsules = select_runtime_sfn_sources(enumerate_runtime_capsule_artifacts(resolved.workspace_root, resolved.manifest_dep_specs), resolved.runtime_demand);
        }
    }
    if resolved.sources.length == 0 {
        // Legitimate "no capsule dependencies" — empty `ll_paths`
        // here is success, not a compile failure.
        return ProjectCapsuleResult {
            ll_paths: empty_paths,
            entry_import_asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            success: true,
            stats: empty_cache_stats(),
            module_events: empty_events,
            runtime_capsules: runtime_capsules,
            runtime_demand: resolved.runtime_demand
        };
    }

    // #1405 Bug 2: route a large-closure positional build onto the
    // subprocess-per-module path (fresh arena per child) when a
    // same-generation binary is available; `-p` builds (non-empty
    // `sailfin_exe`) are unchanged.
    let effective_exe = _cr_effective_isolation_exe(sailfin_exe, self_exe, binary_dir, resolved.sources.length);

    // SFN-872: `--clean` must also reach the LOCAL staged import-context
    // tree. `compile_capsule_modules` wipes `cache_root(...)` — which covers
    // the SFN-861 shared staging tier — but the tree `stage_capsule_imports`
    // reads is work-dir rooted and survives that wipe. Its local gate is the
    // `.srchash` sidecar, a hash of the SOURCE alone (no compiler identity,
    // no target), so an artifact emitted by a DIFFERENT compiler is served
    // straight back — exactly the staleness `--clean` exists to break.
    //
    // Wiped HERE, before staging, and deliberately NOT in
    // `compile_capsule_modules`'s own `config.clean` block: that block runs
    // after `_cr_stage_import_deps` and the `stage_capsule_imports` call
    // below have populated the tree, so a wipe there deletes the `.sfn-asm` /
    // `.layout-manifest` / `.import-deps` that `_cr_compile_one` is about to
    // read — losing cross-module effect enforcement via the W01xx
    // missing-artifact path rather than failing loudly.
    //
    // A workspace `sfn build --clean` re-enters this tail once per member
    // (`cli/commands/build.sfn` loops `_run_single_build` over the default
    // members in one process), so the tree is wiped per member rather than
    // once per invocation. That is correct but not free: each member
    // re-stages its own closure below before lowering, so members after the
    // first lose the `.srchash` fast path on shared deps. Cleaning per member
    // is the honest reading of `--clean`; collapsing it to once per process
    // would need state this tail does not otherwise carry.
    //
    // `sfn run` and `sfn build` both reach staging through this one call and
    // both had the hole. `rt-import-context` is deliberately untouched: it is
    // `.key`-keyed with the compiler identity folded in
    // (`runtime_asm_cache_key`) and re-checks artifact existence on hit, so
    // it has no equivalent stale-serve hole, and `clean_runtime_object_cache`
    // leaves it alone too.
    //
    // Fail-open, matching the sibling wipe's posture in `compile.sfn`: a tree
    // that cannot be removed warns but never fails the build. A surviving
    // content-keyed tree still yields correct artifacts; only `--clean`'s
    // "start fresh" guarantee is broken, and failing silently there would be
    // the same unearned all-clear this fix removes.
    if config.clean {
        let clean_ctx_root = _cr_import_context_root(work_dir);
        if !remove_tree(clean_ctx_root) {
            print.err("[cache] --clean: failed to wipe " + clean_ctx_root
                + " (staged import-context may be partially populated)");
        }
    }
    let staged = stage_capsule_imports(resolved.sources, config, effective_exe, work_dir);
    if !staged {
        print.err("capsule-resolver: failed to stage import-context for project capsules");
        return ProjectCapsuleResult {
            ll_paths: empty_paths,
            entry_import_asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            success: false,
            stats: empty_cache_stats(),
            module_events: empty_events,
            runtime_capsules: runtime_capsules,
            runtime_demand: resolved.runtime_demand
        };
    }

    // Stage D PR4: when `walk_project_src` is on, the binary-
    // capsule walker excludes the entry from enumeration (the
    // entry's `.ll` is produced separately by the caller's
    // `compile_to_llvm_file_with_module`, so it doesn't need a
    // capsule-side compile). But the entry's `.sfn-asm` IS
    // needed by every sibling module that imports from it —
    // without it staged, `<seed> emit --module-name <sibling>
    // llvm <sibling-src>` can't see the entry's exported symbol
    // signatures and emits dangling references. The compiler's
    // self-build is the canonical case: every module imports
    // `compile_to_llvm_file_with_module` / `compile_to_sailfin`
    // / etc. from `main.sfn`. Staging the entry separately keeps
    // the entry out of `compile_capsule_modules` (no double-
    // emit) while making its import-context available.
    // #984: the staged entry doubles as the extra slug universe for
    // `.import-deps` resolution, so siblings that import the entry get
    // its `.sfn-asm` listed in their sidecar and `sibling→entry`
    // effects are enforced on the build path. `[]` when the entry isn't
    // walk-excluded (non-`-p` builds resolve the entry as a normal
    // source already).
    let mut slug_universe_extra: CapsuleSource[] = [];
    // The length guard is not redundant with `walk_project_src`: the two
    // are independent, and the only thing keeping this index in range for
    // an entry-less resolution is that `prepare_runtime_dep_capsules`
    // happens to pass `walk_project_src: false`. Guard where the index is,
    // not where the caller is.
    if consumer.walk_project_src && entry_paths.length > 0 {
        let entry_path = entry_paths[0];
        if fs.exists(entry_path) {
            let entry_slug = module_name_for_source(entry_path);
            let mut entry_src: CapsuleSource[] = [];
            entry_src.push(CapsuleSource {
                spec: "", source_path: entry_path, slug: entry_slug, ll_path: "",
                // The build's own entry module.
                origin: capsule_origin_local()
            });
            let entry_staged = stage_capsule_imports(entry_src, config, effective_exe, work_dir);
            if !entry_staged {
                print.err("capsule-resolver: failed to stage entry import-context for "
                    + entry_path);
                return ProjectCapsuleResult {
                    ll_paths: empty_paths,
                    entry_import_asm_paths: empty_paths,
                    implicit_provider_asm_paths: empty_paths,
                    success: false,
                    stats: empty_cache_stats(),
                    module_events: empty_events,
                    runtime_capsules: runtime_capsules,
                    runtime_demand: resolved.runtime_demand
                };
            }
            slug_universe_extra = entry_src;
        }
    }

    // The entry is lowered by the build/run driver rather than by
    // `compile_capsule_modules`. Derive its direct-import effect artifacts
    // from the same resolved slug universe so that consumer effect checking
    // has parity with the capsule-module and `sfn check` paths.
    let mut entry_import_asm_paths: string[] = [];
    if entry_paths.length > 0 && fs.exists(entry_paths[0]) {
        let mut entry_sources: CapsuleSource[] = [];
        entry_sources.push(CapsuleSource {
            spec: "", source_path: entry_paths[0], slug: module_name_for_source(entry_paths[0]), ll_path: "", origin: capsule_origin_local()
        });
        let entry_dep_slugs = _cr_collect_per_source_dep_slugs(entry_sources, resolved.sources);
        let entry_dep_manifests = _cr_dep_manifest_paths_for_slugs(entry_dep_slugs, work_dir);
        if entry_dep_manifests.length > 0 {
            entry_import_asm_paths = _cr_manifests_to_asm_paths(entry_dep_manifests[0]);
        }
    }

    let implicit_provider_asm_paths = _cr_implicit_provider_asm_paths(resolved.implicit_provider_slugs, work_dir);
    let result = compile_capsule_modules(resolved.sources, slug_universe_extra, config, effective_exe, work_dir, resolved.implicit_provider_slugs);
    if !result.success {
        // A per-module emit failed (e.g. an effect-gate `E0402`).
        // The helper has already printed the diagnostic; surface the
        // failure so the driver exits non-zero instead of linking the
        // surviving modules.
        return ProjectCapsuleResult {
            ll_paths: empty_paths,
            entry_import_asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            success: false,
            stats: result.stats,
            module_events: result.module_events,
            runtime_capsules: runtime_capsules,
            runtime_demand: resolved.runtime_demand
        };
    }
    return ProjectCapsuleResult {
        ll_paths: result.ll_paths,
        entry_import_asm_paths: entry_import_asm_paths,
        implicit_provider_asm_paths: implicit_provider_asm_paths,
        success: true,
        stats: result.stats,
        module_events: result.module_events,
        runtime_capsules: runtime_capsules,
        runtime_demand: resolved.runtime_demand
    };
}

// #1370: import-context staging tailored for a user-facing `emit llvm`
// of a capsule consumer. Stages the consumer's declared capsule
// dependencies (e.g. `sfn/http`) into the import-context tree so the
// imported functions (e.g. `serve`) enter the lowering `functions` list
// — exactly as `check` / `build` / `run` already do — and the #1323
// builtin-serve gate selects the capsule fn instead of `@sfn_serve`.
//
// Gated on `manifest_dep_specs` being non-empty — i.e. the entry's
// `capsule.toml` declares `[dependencies]`. This deliberately EXCLUDES
// build-internal bare `emit llvm` calls on runtime modules
// (`runtime/prelude.sfn`, `runtime/sfn/*`),
// which have NO consumer manifest. Staging such a module's relative
// sibling closure into the shared import-context makes the subsequent
// in-process emit pick up the siblings' runtime-helper signatures and
// render imported-signature `declare`s that conflict with the
// descriptor declares (the documented pollution hazard — see
// `_runtime_sfn_ctx_root` in `cli_main.sfn`), producing invalid IR.
// Returns true when staging was a no-op (no declared deps) or
// succeeded; false on a slug collision or staging error.
fn stage_capsule_imports_for_emit(entry_path: string, sailfin_exe: string, work_dir: string) -> boolean ![io] {
    let entry_paths: string[] = [entry_path];
    let resolved = _cr_resolve_and_dedupe(entry_paths, empty_resolver_consumer(), "");
    if resolved.has_collision { return false; }
    // No declared capsule dependencies → nothing to stage. A bare
    // runtime/prelude emit (no consumer manifest) lands here untouched.
    if resolved.manifest_dep_specs.length == 0 { return true; }
    if resolved.sources.length == 0 { return true; }
    // SFN-861: this cold `sfn emit` staging path is a one-shot, single-
    // module call with no per-invocation build loop to amortise a shared-
    // cache lookup against — it does not participate in the shared cache.
    let disabled_cache: BuildCacheConfig = BuildCacheConfig {
        enabled: false,
        trace: false,
        clean: false,
        capsule_name: ""
    };
    return stage_capsule_imports(resolved.sources, disabled_cache, sailfin_exe, work_dir);
}

// Resolver pass tuned for `sfn test`: stages `.sfn-asm` import-context
// (so the typechecker import-loader can read interface declarations
// for cross-module conformance) AND compiles each capsule source to
// its own `.ll` (so clang link can resolve imported helper definitions
// directly).
//
// `entry_paths` is a list of test source files that share the same
// project + workspace roots. The CLI groups discovered tests by
// `(discover_project_root, discover_workspace_root)` and calls this
// once per group, mirroring the per-group resolution `check/engine.sfn`
// already performs. Resolution work is amortized across every test
// in the group; per-(group, capsule) staging + compilation runs at
// most once.
//
// Contract differences from `prepare_project_capsules`:
//   - On slug collision, returns `staging_failed = true` (caller
//     exits 2 to distinguish setup error from test failure).
//   - On `stage_capsule_imports` failure, same: `staging_failed = true`.
//   - On `compile_capsule_modules` failure, same: `staging_failed =
//     true`, `ll_paths = []`.
//   - Standalone test files outside any capsule.toml are valid input
//     and return an empty resolution (no error) — the test source's
//     own compile path still runs, and any relative-import walking
//     happens inside the per-entry `enumerate_relative_sources`
//     branch of `_cr_resolve_and_dedupe`.
fn prepare_project_capsules_for_test(entry_paths: string[], consumer: ResolverConsumer, sailfin_exe: string, work_dir: string, binary_dir: string) -> TestCapsuleResolution ![io] {
    let empty_paths: string[] = [];
    // SFN-833: the test path links, so it takes the filter too — and its
    // `asm_paths` derive from `resolved.sources` below, which keeps the
    // single-list discipline intact.
    let resolved = _cr_resolve_dedupe_filtered(entry_paths, consumer, binary_dir);
    // Phase F: thread `capabilities_required` through every exit
    // path. Same rationale as `prepare_project_capsules_for_check`:
    // staging failures are setup-time concerns, not manifest
    // semantics — the gate still needs to know the capability
    // surface to render `E0403` correctly on a clean retry.
    if resolved.has_collision {
        return TestCapsuleResolution {
            asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            ll_paths: empty_paths,
            capsule_count: 0,
            staging_failed: true,
            capabilities_required: resolved.capabilities_required,
            capabilities_declared: resolved.capabilities_declared,
            runtime_demand: resolved.runtime_demand
        };
    }
    if resolved.sources.length == 0 {
        return TestCapsuleResolution {
            asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            ll_paths: empty_paths,
            capsule_count: 0,
            staging_failed: false,
            capabilities_required: resolved.capabilities_required,
            capabilities_declared: resolved.capabilities_declared,
            runtime_demand: resolved.runtime_demand
        };
    }

    // Stage E PR1: thread `sailfin_exe` to subprocess-stage imports too.
    // #1405 Bug 2: the `sfn test` runner now threads a same-generation
    // `binary_dir`, so a large-closure test (e.g. one importing the whole
    // compiler via `lower_to_llvm_ir_from_text`) isolates per-module emit
    // in subprocesses (fresh arena per child) instead of accumulating the
    // entire closure in one never-freed bump arena and OOMing past the
    // 8 GiB self-cap on a cold test-bin cache. Small fixtures (below the
    // closure-size threshold) keep the in-process fast path; a non-empty
    // `sailfin_exe` is returned unchanged. `prepare_project_capsules_for_test`
    // has no running-binary path of its own to thread (SFN-904 only added
    // that parameter to the build/run path), so this passes "" and falls
    // through to `_cr_effective_isolation_exe`'s own `_resolve_self_path`
    // probe.
    let effective_exe = _cr_effective_isolation_exe(sailfin_exe, "", binary_dir, resolved.sources.length);
    // `sfn test` doesn't yet take a CLI cache config; pass the
    // env-driven default. When the test runner grows `--no-cache`
    // / `--clean`, thread the resolved config in here. Resolved before
    // staging so the same config governs the SFN-861 shared staging
    // cache and the `.ll` module cache below.
    let test_config = empty_build_cache_config();
    let staged = stage_capsule_imports(resolved.sources, test_config, effective_exe, work_dir);
    if !staged {
        print.err("capsule-resolver: failed to stage import-context for project capsules");
        return TestCapsuleResolution {
            asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            ll_paths: empty_paths,
            capsule_count: 0,
            staging_failed: true,
            capabilities_required: resolved.capabilities_required,
            capabilities_declared: resolved.capabilities_declared,
            runtime_demand: resolved.runtime_demand
        };
    }

    let test_context_root = _cr_import_context_root(work_dir);
    let mut asm_paths: string[] = [];
    let mut ai: int = 0;
    loop {
        if ai >= resolved.sources.length { break; }
        asm_paths.push(test_context_root + "/" + resolved.sources[ai].slug
            + ".sfn-asm");
        ai += 1;
    }
    // #984: `sfn test` resolves the entry as a normal source (no
    // walk-exclusion), so there is no extra slug universe to thread.
    let test_slug_universe_extra: CapsuleSource[] = [];
    let implicit_provider_asm_paths = _cr_implicit_provider_asm_paths(resolved.implicit_provider_slugs, work_dir);
    let result = compile_capsule_modules(resolved.sources, test_slug_universe_extra, test_config, effective_exe, work_dir, resolved.implicit_provider_slugs);
    // Surface a compile failure as `staging_failed = true` so the
    // test runner exits 2 instead of trying to link against
    // missing helper objects. (The PR1c stats are dropped on this
    // path — once the test runner needs them, the
    // `TestCapsuleResolution` struct gets a `cache_stats` field.)
    if !result.success {
        return TestCapsuleResolution {
            asm_paths: asm_paths,
            implicit_provider_asm_paths: implicit_provider_asm_paths,
            ll_paths: empty_paths,
            capsule_count: resolved.sources.length as int,
            staging_failed: true,
            capabilities_required: resolved.capabilities_required,
            capabilities_declared: resolved.capabilities_declared,
            runtime_demand: resolved.runtime_demand
        };
    }

    return TestCapsuleResolution {
        asm_paths: asm_paths,
        implicit_provider_asm_paths: implicit_provider_asm_paths,
        ll_paths: result.ll_paths,
        capsule_count: resolved.sources.length as int,
        staging_failed: false,
        capabilities_required: resolved.capabilities_required,
        capabilities_declared: resolved.capabilities_declared,
        runtime_demand: resolved.runtime_demand
    };
}
