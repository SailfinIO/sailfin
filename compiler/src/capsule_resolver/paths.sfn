// compiler/src/capsule_resolver/paths.sfn
//
// Leaf path/string helpers for the capsule resolver: filesystem path
// manipulation, slug mangling and `.ll` path routing, project-root
// discovery, and the array/string leaf predicates shared by the
// workspace and capability clusters (moved here to avoid a two-way
// dependency between them).
import { CapsuleArtifactLayout, ir_path_for_slug } from "../capsule_artifact";
import { char_code_at_text, substring } from "../string_utils";
import { test_runner_scratch_root } from "../test_runner_state";
import { CapsuleSource, ResolverConsumer } from "./types";

// ---- Path helpers ----
// True iff `ch` is a path separator. Windows accepts `/` and `\`
// interchangeably in every Win32 file API, and the paths reaching this module
// carry `\`: `--binary-dir` is derived from `GetModuleFileNameA`, which hands
// back a fully backslashed path. Unconditional on host, matching the two
// in-tree precedents this rule already has — `_is_path_sep`
// (`compiler/src/build/paths.sfn`, SFN-919) and `_rcr_is_sep`
// (`compiler/src/runtime_capsule_resolver.sfn`, SFN-642).
fn _cr_is_path_sep(ch: string) -> boolean { return ch == "/" || ch == "\\"; }

// Scanning for `/` alone made this return `"."` for every backslashed input,
// which on Windows is every absolute path (SFN-1114).
//
// `"."` is not a harmless default here. `discover_workspace_root(binary_dir)`
// (`./workspace.sfn`) walks parents looking for `workspace.toml`, and
// `dedupe.sfn` calls that walk "the one anchor deliberately independent of the
// CWD". Given `C:\...\build\bin` this yielded `"."` on the first step, so the
// probe read `./workspace.toml` — turning the CWD-independent anchor into a
// probe OF the CWD, and then terminating, since `_cr_dirname(".") == "."`.
//
// With no workspace root there is no member map, and the member map is the
// only thing that knows `stdlib/`: `workspace.toml [workspace].members`
// carries `"stdlib/*"`, expanded into `sfn/strings` -> `<ws>/stdlib/strings/src`.
// Both fallback locators (`./locate.sfn`) know only
// `capsules/<scope>/<name>/src`, so `sfn/strings` became unfindable, and
// `sfn/crypto` — which declares it — failed to lower with 72 fatals blaming
// `split` and `int_to_string`, symbols that exist and are correct.
//
// Measured: with the CWD outside the repo the compiler read a decoy
// `workspace.toml` planted in the CWD, an ancestor of neither the entry file
// nor the compiler binary. The same build from the repo root retained 34 of 34
// modules; from a scratch dir, 33 of 33 — the missing one being
// `sfn/strings/mod`.
//
// Every other `_cr_dirname` call site was returning `"."` for a backslashed
// input too, so widening the scan can only make more things resolve.
// A bare drive specifier (`C:`), which is what the walk above reaches after
// `_cr_dirname("C:\\repo")`. It has no separator, so without this it falls
// through to the `"."` no-directory sentinel below.
//
// Two characters ending in `:` cannot be anything else in this position: a
// path component may not contain `:` on Windows, and on POSIX a two-character
// name ending in `:` is not a root and never terminates a walk either way.
fn _cr_is_drive_spec(path: string) -> boolean {
    if path.length != 2 { return false; }
    return path[1] == ":";
}

// A drive specifier is its OWN parent — the fixed point `/` provides on POSIX,
// which every caller's walk-termination check (`strings_equal(parent, dir)`)
// depends on to stop.
//
// SFN-1114 widened the separator SCAN so a backslashed path stops collapsing to
// `"."` on the first step; it did not give the walk a place to stop. The result
// was the same defect one level further up: `C:\repo` -> `C:` -> `"."`, and
// `"."` is not equal to `C:`, so the walk does not terminate — it carries on
// and probes `./workspace.toml`, turning the anchor `dedupe.sfn` calls
// "deliberately independent of the CWD" into a probe OF the CWD. Running from
// anywhere inside this repository then finds the repository's own
// `workspace.toml` for an entry file in a scratch directory, and a spuriously
// non-empty workspace root gates off the cache-implicit source leg
// (`dedupe.sfn:566-593`), so a cached capsule's signatures are never staged and
// lowering reports the callee as unknown.
//
// POSIX is unaffected: `/` already terminates at `last_slash == 0` below.
fn _cr_dirname(path: string) -> string {
    let mut last_slash: int = -1;
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if _cr_is_path_sep(path[i]) { last_slash = i; }
        i += 1;
    }
    if last_slash < 0 {
        if _cr_is_drive_spec(path) { return path; }
        return ".";
    }
    // Preserve the separator the caller actually used, so a Windows root keeps
    // its `\` spelling rather than being rewritten to `/`.
    if last_slash == 0 { return substring(path, 0, 1); }
    return substring(path, 0, last_slash);
}

fn _cr_path_join(base: string, name: string) -> string {
    if base.length == 0 { return name; }
    if _cr_is_path_sep(base[base.length - 1]) { return base + name; }
    return base + "/" + name;
}

fn _cr_find_char(text: string, ch: string, start: int) -> int {
    let mut i: int = start;
    loop {
        if i >= text.length { break; }
        if substring(text, i, i + 1) == ch { return i; }
        i += 1;
    }
    return -1;
}

fn _cr_starts_with(text: string, prefix: string) -> boolean {
    if prefix.length > text.length { return false; }
    return strings_equal(substring(text, 0, prefix.length), prefix);
}

fn _cr_ends_with(text: string, suffix: string) -> boolean {
    if suffix.length > text.length { return false; }
    let start = text.length - suffix.length;
    return strings_equal(substring(text, start, text.length), suffix);
}

// `env.home` (not `env.get("HOME")`): the full `HOME` -> `USERPROFILE` ->
// `HOMEDRIVE`+`HOMEPATH` ladder (SFN-856), since `HOME` alone resolves to
// "" on a stock native Windows shell.
fn _cr_get_home() -> string ![io] { return env.home(); }

fn _cr_ensure_dir(path: string) -> void ![io] {
    if !fs.exists(path) { fs.createDirectory(path, true); }
}

// Resolve the import-context root (`.sfn-asm` + `.layout-manifest`
// staging area). When `work_dir` is empty (the default `sfn build`
// path with no `--work-dir`), this is the canonical `build/compiler/import-context`
// directory that `llvm/imports.sfn:_resolve_layout_manifest_path_for_slug`
// scans. When `work_dir` is non-empty (`sfn build --work-dir <root>`),
// the staging area moves under `<root>/compiler/import-context` so the
// build can be redirected away from CWD-relative `build/`.
//
// SFN-175 moved this from the legacy Python-bootstrap-era
// `build/native/import-context`; SFN-194 retired the one-release old-path
// read fallback + Makefile copy shim once a seed staging the new path was
// pinned, so this is now the single canonical location.
fn _cr_import_context_root(work_dir: string) -> string {
    if work_dir.length == 0 { return "build/compiler/import-context"; }
    return work_dir + "/compiler/import-context";
}

// Validate a capsule.toml path segment is safe (no traversal).
fn _cr_is_safe_segment(value: string) -> boolean {
    if value.length == 0 { return false; }
    if strings_equal(value, ".") { return false; }
    if strings_equal(value, "..") { return false; }
    if _cr_find_char(value, "/", 0) >= 0 { return false; }
    if _cr_find_char(value, "\\", 0) >= 0 { return false; }
    return true;
}

fn _cr_is_safe_version(value: string) -> boolean {
    if value.length == 0 { return false; }
    if _cr_find_char(value, "/", 0) >= 0 { return false; }
    if _cr_find_char(value, "\\", 0) >= 0 { return false; }
    // Guard against ".." anywhere
    let mut i: int = 0;
    loop {
        if i + 1 >= value.length { break; }
        if substring(value, i, i + 2) == ".." { return false; }
        i += 1;
    }
    return true;
}

// ---- Slug mangling ----
// Convert a slug like "sfn/cli/mod" to "sfn__cli__mod" for use as a
// filesystem-safe identifier (e.g. in .ll filenames).
fn mangle_slug(slug: string) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= slug.length { break; }
        let ch = substring(slug, i, i + 1);
        if ch == "/" { out = out + "__"; } else { out = out + ch; }
        i += 1;
    }
    return out;
}

// ---- LL path resolution (Stage C2b2) ----
// Resolve the scratch root used for `_cr_legacy_ll_path` and the
// `compile_capsule_modules` ensure-dir calls. Defaults to
// `"build/sailfin"`; honours `SAILFIN_TEST_SCRATCH` when set so that
// callers wanting per-invocation isolation can keep concurrent
// `sfn test` runs from racing on `build/sailfin/capsules/<slug>.ll`.
// The multi-file `sfn test` runner mints such a root via `fs.mkdtemp`
// (issue #850, replacing the retired `scripts/run_native_test.sh`)
// and hands it to each child via `env`. Single-file `sfn test` runs set
// the same root in process-local `test_runner_state`, because their
// resolver work runs in the current process and cannot mutate its own
// environment. The env var is read once via `env.get` (the same
// non-shelling read `_cr_resolve_jobs` uses for `SAILFIN_BUILD_JOBS`);
// an empty value falls through to the default so that
// `unset SAILFIN_TEST_SCRATCH` and `SAILFIN_TEST_SCRATCH=` behave
// identically (no surprise paths on a stripped env).
fn _cr_scratch_root() -> string ![io] {
    let active_test_root = test_runner_scratch_root();
    if active_test_root.length > 0 { return active_test_root; }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { return scratch; }
    return "build/sailfin";
}

// Legacy flat layout for the `.ll` of a slug. Used by the C2b2
// fallback path: positional builds, single-segment `[capsule].name`, and any
// source whose slug doesn't match a known
// dep prefix. One source of truth so the fallback never drifts
// across the two CapsuleSource construction sites.
fn _cr_legacy_ll_path(slug: string) -> string ![io] {
    return _cr_scratch_root() + "/capsules/" + mangle_slug(slug) + ".ll";
}

// Resolve the per-module `.ll` path under the given layout, falling
// back to the legacy flat layout when the layout doesn't classify
// the slug. Pure delegate to `ir_path_for_slug` from
// `capsule_artifact.sfn`; kept here so the resolver has a single
// site that owns the fallback policy.
fn _cr_resolve_ll_path(slug: string, layout: CapsuleArtifactLayout) -> string ![io] {
    let candidate = ir_path_for_slug(layout, slug);
    if candidate.length > 0 { return candidate; }
    return _cr_legacy_ll_path(slug);
}

// Compute the prefix that should be stripped from a relative-
// import slug before routing it under the consumer's per-capsule
// `ir/` tree. Returns `""` when the consumer isn't in safe
// scope-form (in which case the consumer-tree branch is dead and
// the prefix never matters) or when the `project_root` is empty
// (positional builds without a discoverable manifest).
//
// The trailing `/` on the prefix is intentional: stripping
// `project_root + "/"` (rather than `project_root`) keeps a
// sibling path like `<project_root>extra/util.sfn` from being
// mistakenly treated as intra-capsule.
fn _cr_consumer_root_prefix(project_root: string, consumer: ResolverConsumer) -> string {
    if consumer.scope.length == 0 { return ""; }
    if consumer.name.length == 0 { return ""; }
    if project_root.length == 0 { return ""; }
    return project_root + "/";
}

// Compute the slug used purely for `ll_path` routing. For
// intra-capsule (relative-import) sources whose path-shaped slug
// starts with the consumer-root prefix, strip the prefix so the
// routed path mirrors the source layout under the consumer's
// `ir/` tree. For everything else (manifest deps with `<scope>/
// <name>/<rest>` slugs, or any source where the prefix doesn't
// match), return the slug unchanged. The original slug is
// preserved on `CapsuleSource.slug` for cache keying, symbol
// mangling, and `.sfn-asm` staging.
fn _cr_routing_slug(cur: CapsuleSource, consumer_root_prefix: string) -> string {
    if cur.spec.length > 0 { return cur.slug; }
    if consumer_root_prefix.length == 0 { return cur.slug; }
    if cur.slug.length <= consumer_root_prefix.length { return cur.slug; }
    if substring(cur.slug, 0, consumer_root_prefix.length) != consumer_root_prefix {
        return cur.slug;
    }
    return substring(cur.slug, consumer_root_prefix.length, cur.slug.length);
}

// ---- Project discovery ----
// Walk up from start_dir looking for capsule.toml. Returns the directory
// containing it, or "" if no manifest is found within 16 levels.
fn discover_project_root(start_dir: string) -> string ![io] {
    let mut dir: string = start_dir;
    if dir.length == 0 { dir = "."; }
    let mut depth: int = 0;
    loop {
        if depth >= 16 { break; }
        let manifest = _cr_path_join(dir, "capsule.toml");
        if fs.exists(manifest) { return dir; }
        let parent = _cr_dirname(dir);
        if strings_equal(parent, dir) { break; }
        if parent.length == 0 { break; }
        dir = parent;
        depth += 1;
    }
    return "";
}

// Linear-search membership predicate. Sailfin's runtime has no
// `Set<string>`, so dedupe loops use parallel-array containment;
// at the typical N (~5-30 deps per source) the constant cost is
// dominated by the per-source filesystem read elsewhere.
// Linear-search membership predicate. Sailfin's runtime has no
// `Set<string>`, so dedupe loops use parallel-array containment;
// at the typical N (~5-30 deps per source) the constant cost is
// dominated by the per-source filesystem read elsewhere.
fn _cr_string_in_array(arr: string[], needle: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= arr.length { break; }
        if strings_equal(arr[i], needle) { return true; }
        i += 1;
    }
    return false;
}

// Membership predicate over `string[]`, distinct from
// `_cr_string_in_array` only in call-site naming; moved here (rather
// than left split between the capability and implicit-enumeration
// clusters) because both clusters need it and this module is the
// shared leaf dependency of both.
fn _cr_string_array_contains(items: string[], needle: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= items.length { break; }
        if strings_equal(items[i], needle) { return true; }
        i += 1;
    }
    return false;
}

// Lexicographic string comparison over character codes (mirrors
// `build_cache::_string_lt`), so member expansion is deterministic regardless
// of `fs.listDirectory` return order.
fn _cr_string_lt(a: string, b: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= a.length || i >= b.length { break; }
        let ca = char_code_at_text(a, i);
        let cb = char_code_at_text(b, i);
        if ca < cb { return true; }
        if ca > cb { return false; }
        i += 1;
    }
    return a.length < b.length;
}

// Insertion sort — member counts per glob are small (tens of capsules).
fn _cr_sort_strings(input: string[]) -> string[] {
    let mut out: string[] = [];
    let mut ci: int = 0;
    loop {
        if ci >= input.length { break; }
        out.push(input[ci]);
        ci += 1;
    }
    let mut k: int = 1;
    loop {
        if k >= out.length { break; }
        let cur = out[k];
        let mut j: int = k - 1;
        loop {
            if j < 0 { break; }
            if !_cr_string_lt(cur, out[j]) { break; }
            out[j + 1] = out[j];
            j -= 1;
        }
        out[j + 1] = cur;
        k += 1;
    }
    return out;
}
