// compiler/src/capsule_resolver/staging.sfn
//
// Import-context staging. Emits `.sfn-asm` + `.layout-manifest` for each
// capsule source into `<import-context>/<slug>.*` so the main module's
// lowering sees each capsule's layout and symbols, and computes the per-source
// dependency-manifest lists that key the module cache.
//
// Ordering is load-bearing and disk-mediated: this module WRITES the
// import-context tree that `compile_capsule_modules` later READS, and
// the driver later loads that same explicit root into an
// `ImportedModuleContext`. Callers must keep staging strictly before
// compilation; the data flow alone does not express that constraint.
import { int_to_string } from "sfn/strings";

import { _atomic_rename_into_place, _mktemp_sibling_cmd } from "../build/fs";
import { build_target_triple } from "../build/target";
import {
    BuildCacheConfig,
    CacheKey,
    cache_compiler_identity,
    cache_copy_artifact_to,
    cache_copy_artifact_to_untouched,
    cache_lookup_artifact,
    cache_root,
    cache_store_artifact,
    is_valid_digest,
    sha256_of_file,
    stage_cache_key_from_digest
} from "../build_cache";
import { _get_env_cmd } from "../build_flags";
import { ParallelEmitTask, _cr_resolve_jobs, _cr_run_parallel_emit } from "../capsule_emit_parallel";
import { _cr_find_substring } from "../capsule_import_scan";
import { module_name_from_path } from "../module_paths";
import { write_staged_native_text_file } from "../native_artifact_writer";
import { stage_native_text_with_retry } from "../native_emit_subprocess";
import { substring } from "../string_utils";
import { resolve_compiler_version_for_cache } from "../version";
import {
    _cr_dirname,
    _cr_ends_with,
    _cr_ensure_dir,
    _cr_import_context_root
} from "./paths";
import { capsule_origin_is_known } from "./provenance";
import { _cr_module_edge_slugs } from "./reachability";
import { _cr_canonicalise_path, enumerate_relative_sources } from "./relative";
import { CapsuleSource } from "./types";

// Emit .sfn-asm + .layout-manifest for a single capsule source. The
// driver-owned import-context loader (`import_context.sfn`) looks in
// build/compiler/import-context/<slug>.* so that's where we write.
//
// Cache invalidation contract: a staged `.sfn-asm` + `.layout-manifest`
// pair is a valid cache hit only when a `.srchash` sidecar written next to
// them matches the current SHA-256 of the module's source. A missing or
// stale sidecar (or an unreadable source) forces a fresh emit; the sidecar
// is (re)written after every fresh emit.
//
// This is content-addressed, not mtime-based, on purpose: Sailfin's emit is
// deterministic (proven by `make check`'s stage2 == stage3 byte-identical
// fixed-point), so byte-identical source <=> byte-identical IR, and the
// source hash is the canonical predicate. mtime is deliberately NOT used —
// `git checkout` resets mtimes to checkout time, so timestamps lie (#514).
// Because of this, the Makefile no longer wipes the staged IR by hand;
// `stage_capsule_imports` notices a changed source on its own.
// _cr_srchash_path: location of the source-content sidecar for a staged
// module, alongside its `.sfn-asm` / `.layout-manifest`.
fn _cr_srchash_path(context_root: string, slug: string) -> string {
    return context_root + "/" + slug + ".srchash";
}

// _cr_stage_cache_hit: true when the staged artifacts are a valid cache hit
// for `src_path` — both `.sfn-asm` and `.layout-manifest` exist AND the
// recorded `.srchash` matches the current SHA-256 of the source. A missing
// or stale sidecar, or an unreadable source, returns false (fresh emit).
fn _cr_stage_cache_hit(asm_path: string, manifest_path: string, srchash_path: string, src_path: string) -> boolean ![io] {
    if !fs.exists(asm_path) { return false; }
    if !fs.exists(manifest_path) { return false; }
    if !fs.exists(srchash_path) { return false; }
    let recorded = fs.readFile(srchash_path);
    if recorded.length == 0 { return false; }
    let current = sha256_of_file(src_path);
    if current.length == 0 { return false; }
    return strings_equal(recorded, current);
}

// _cr_write_srchash: record the source SHA-256 sidecar for a freshly staged
// module so the next run's cache-hit probe can detect an unchanged source.
// Best-effort: a hash failure leaves no sidecar, which forces a re-emit.
// Hashes `src_path` itself — callers that already hold the source's digest
// (from a shared-cache key derivation, e.g.) should call
// `_cr_write_srchash_digest` instead so the file isn't hashed twice for one
// publish (SFN-861).
fn _cr_write_srchash(srchash_path: string, src_path: string) ![io] {
    _cr_write_srchash_digest(srchash_path, sha256_of_file(src_path));
}

// Same sidecar write as `_cr_write_srchash`, but takes an ALREADY-COMPUTED
// source digest instead of hashing `src_path` again. `stage_cache_key_for`
// hashes through `sha256_of_file` too, so a digest obtained while deriving
// the cache key is a valid sidecar value here — one file read serves both.
// Both must stay on that one entry point; a second hash function that
// merely agrees today would make this reuse silently wrong the day it
// stopped agreeing.
fn _cr_write_srchash_digest(srchash_path: string, digest: string) ![io] {
    if digest.length == 0 { return; }
    // #1011: publish atomically. The srchash is the entry-complete gate
    // (`_cr_stage_cache_hit` only trusts an entry when it exists AND
    // matches), so it MUST be renamed last and as a unit — a concurrent
    // probe that sees a matching srchash is then guaranteed the
    // `.sfn-asm` + `.layout-manifest` are already fully published.
    let tmp = _mktemp_sibling_cmd(srchash_path);
    if tmp.length == 0 {
        fs.writeFile(srchash_path, digest);
        return;
    }
    fs.writeFile(tmp, digest);
    _atomic_rename_into_place(tmp, srchash_path);
}

// SFN-861: per-invocation shared-cache identity for the STAGING
// artifacts (`.sfn-asm` + `.layout-manifest`), resolved once by
// `stage_capsule_imports` and threaded down so every per-module probe
// avoids re-deriving the compiler identity / target triple / cache root.
// Mirrors `compile_capsule_modules`'s resolution of the same values
// (`capsule_resolver/compile.sfn`) via the same helpers, so the `.ll`
// cache and this staging cache can never disagree about compiler
// identity or target.
struct _StageCacheContext {
    enabled: boolean;
    trace: boolean;
    root: string;
    compiler_version: string;
    target_triple: string;
}

// A disabled ctx collapses every downstream check to the single
// `ctx.enabled` guard, so callers never special-case "config said no"
// versus "identity/root resolution failed" — both fail open the same
// way, onto the local `.srchash`-gated cache above (unaffected either
// way).
fn _cr_disabled_stage_cache_ctx() -> _StageCacheContext {
    return _StageCacheContext {
        enabled: false,
        trace: false,
        root: "",
        compiler_version: "",
        target_triple: ""
    };
}

// Resolve the shared-cache context once per `stage_capsule_imports`
// call. `config.enabled == false` short-circuits before touching the
// filesystem or env; an empty resolved compiler identity or cache root
// also disables the shared-cache path.
//
// An empty `sailfin_exe` must ALSO disable the shared cache, ahead of
// every other check: `sailfin_exe` is empty exactly on the in-process
// emit leg (`_cr_effective_isolation_exe` returns "" under the
// sub-16-module closure threshold — see `mod.sfn`), and
// `cache_compiler_identity` can only fold the emitting binary's SHA-256
// into the key when it is handed a non-empty `compiler_binary_path`.
// Without that fold, the key degrades to `{source, slug, bare version
// stamp, triple}` — identical across two DIFFERENT compiler binaries at
// an uncommitted (`.dirty`) revision. Because this cache is shared
// ACROSS work directories (unlike the local `.srchash` tree), a rebuilt
// compiler would then restore a PRIOR compiler's staged bytes, and since
// the `.ll` cache key hashes the restored `.layout-manifest` content, a
// byte-identical manifest restore makes the downstream `.ll` layer hit
// too — silent stale IR with no signal anywhere in the chain. This
// costs no measured performance: this leg is by construction the
// sub-16-module closure, while the large closures this cache targets
// take the subprocess branch and always carry a real `sailfin_exe`. The
// underlying identity gap is documented as a known residual in
// `docs/runbooks/build-cache-stale-ir.md` §3.
fn _cr_resolve_stage_cache_ctx(config: BuildCacheConfig, sailfin_exe: string) -> _StageCacheContext ![io] {
    if !config.enabled { return _cr_disabled_stage_cache_ctx(); }
    if sailfin_exe.length == 0 { return _cr_disabled_stage_cache_ctx(); }
    // SFN-861: `empty_build_cache_config()` (the `sfn test` leg's config)
    // hardcodes `enabled: true` and never consults these env vars the way
    // `resolve_build_cache_config` does, so this staging layer needs its
    // own kill switch and trace toggle rather than inheriting one that
    // was never read for it.
    if _get_env_cmd("SAILFIN_NO_CACHE") == "1" {
        return _cr_disabled_stage_cache_ctx();
    }
    let trace = config.trace || _get_env_cmd("SAILFIN_CACHE_TRACE") == "1";
    let compiler_version = cache_compiler_identity(resolve_compiler_version_for_cache(""), sailfin_exe);
    if compiler_version.length == 0 { return _cr_disabled_stage_cache_ctx(); }
    let root = cache_root(config.capsule_name);
    if root.length == 0 { return _cr_disabled_stage_cache_ctx(); }
    let target_triple = build_target_triple();
    return _StageCacheContext {
        enabled: true,
        trace: trace,
        root: root,
        compiler_version: compiler_version,
        target_triple: target_triple
    };
}

// Test-facing constructor for an ENABLED context, mirroring
// `_cr_stage_cache_hit` / `_cr_write_srchash`'s precedent of exposing
// the pure per-module primitives directly to tests rather than forcing
// them through `stage_capsule_imports`'s config/env plumbing.
fn _cr_stage_cache_ctx_for(root: string, compiler_version: string, target_triple: string) -> _StageCacheContext {
    return _StageCacheContext {
        enabled: true,
        trace: false,
        root: root,
        compiler_version: compiler_version,
        target_triple: target_triple
    };
}

// Per-module accounting for the shared-cache summary line, kept
// separate from `CacheStats` (the `.ll`/`.o` layer's summary, which
// SFN-861 does not touch) and from the local `.srchash` disk cache
// above, which has no counters of its own.
struct _StageCacheSummary {
    hits: int;
    misses: int;
    stores: int;
    restore_failed: int;
}

fn _cr_empty_stage_cache_summary() -> _StageCacheSummary {
    return _StageCacheSummary {
        hits: 0,
        misses: 0,
        stores: 0,
        restore_failed: 0
    };
}

fn _cr_print_stage_cache_summary(summary: _StageCacheSummary) ![io] {
    print.err("[stage cache] hits=" + int_to_string(summary.hits) + " misses="
        + int_to_string(summary.misses)
        + " stores="
        + int_to_string(summary.stores)
        + " restore_failed="
        + int_to_string(summary.restore_failed));
}

// Per-module outcome of `_cr_stage_one_outcome`, carrying the shared-cache
// event alongside the plain success/failure it exposes to
// its (test) callers. `stage_capsule_imports`'s serial loops fold this
// into a `_StageCacheSummary`.
struct _StageOneOutcome {
    ok: boolean;
    cache_hit: boolean;
    cache_miss: boolean;
    cache_stored: boolean;
    cache_restore_failed: boolean;
}

fn _cr_empty_stage_one_outcome() -> _StageOneOutcome {
    return _StageOneOutcome {
        ok: false,
        cache_hit: false,
        cache_miss: false,
        cache_stored: false,
        cache_restore_failed: false
    };
}

// Stage E PR1: stage one capsule source's import-context
// (`.sfn-asm` + `.layout-manifest`). When `sailfin_exe.length >
// 0`, the heavy native-text emit happens in a subprocess so the
// parent's arena doesn't accumulate ~138 modules' worth of AST +
// IR text — the same memory-bounding rationale that drove PR3's
// subprocess-per-module compile path. Empty `sailfin_exe` falls
// back to the in-process path that's worked since Stage B; the
// fallback is what `sfn check` and tests with small dep sets
// continue to use.
// Fail-closed provenance check for one source (SFN-715). Every source reaching
// staging must carry an origin stamped by the locator that resolved it. An
// empty or unrecognised origin means a construction site produced a
// `CapsuleSource` without declaring where it came from — the resolver cannot
// prove that source is locally declared, so it must not be staged. The
// private-capsule rejection itself happens earlier, during resolution; this is
// the structural backstop that keeps a future locator from bypassing it
// silently.
//
// `stage_capsule_imports` runs this over the whole set before it picks a
// staging strategy, because two of its three branches never reach
// `_cr_stage_one_outcome`, and the cache-hit probe inside it short-
// circuits before any per-source work. A guard placed anywhere downstream of
// either would be dead on the paths that matter.
fn _cr_check_provenance(src: CapsuleSource) -> boolean ![io.console] {
    if capsule_origin_is_known(src.origin) { return true; }
    print.err("capsule-resolver: refusing to stage " + src.source_path
        + " — unknown capsule provenance \""
        + src.origin
        + "\"");
    return false;
}

fn _cr_stage_one_outcome(src: CapsuleSource, ctx: _StageCacheContext, sailfin_exe: string, work_dir: string) -> _StageOneOutcome ![io] {
    let mut outcome = _cr_empty_stage_one_outcome();
    // Re-checked here so a direct caller of `_cr_stage_one_outcome` is
    // covered too. Must precede the cache-hit probe below, which returns
    // early.
    if !_cr_check_provenance(src) { return outcome; }
    let context_root = _cr_import_context_root(work_dir);
    let asm_path = context_root + "/" + src.slug + ".sfn-asm";
    let manifest_path = context_root + "/" + src.slug + ".layout-manifest";
    let srchash_path = _cr_srchash_path(context_root, src.slug);
    let asm_dir = _cr_dirname(asm_path);
    _cr_ensure_dir(asm_dir);

    // Cache hit: the asm + manifest are present AND the source-content
    // sidecar matches (see cache invalidation contract above). A stale or
    // missing sidecar falls through to a fresh emit.
    if _cr_stage_cache_hit(asm_path, manifest_path, srchash_path, src.source_path) {
        outcome.ok = true;
        return outcome;
    }

    // SFN-861: local disk cache missed — try the shared content-addressed
    // cache before paying for a fresh emit. `.sfn-asm` emit is a pure
    // function of {source text, slug, emitting compiler, target}
    // (`stage_cache_key_from_digest`), so a restore here is exactly as
    // valid as a locally-staged pair. `s_hash` is hashed once here and
    // reused both to derive `key` and, on a hit or a subsequent fresh
    // emit, to write the `.srchash` sidecar — otherwise the source would
    // be hashed a second time for the same publish (SFN-861). `key` is
    // remembered past this block so a subsequent fresh emit can store
    // under the same digest.
    let mut key: CacheKey = CacheKey { digest: "" };
    let mut s_hash: string = "";
    if ctx.enabled {
        s_hash = sha256_of_file(src.source_path);
        key = stage_cache_key_from_digest(s_hash, src.slug, ctx.compiler_version, ctx.target_triple);
        if is_valid_digest(key.digest) {
            let found = cache_lookup_artifact(ctx.root, key, "sfn-asm")
                && cache_lookup_artifact(ctx.root, key, "layout-manifest");
            if found {
                let mut restored = cache_copy_artifact_to(ctx.root, key, "sfn-asm", asm_path)
                    && cache_copy_artifact_to_untouched(ctx.root, key, "layout-manifest", manifest_path);
                // A restored pair must be verified non-empty before the
                // `.srchash` sidecar (the entry-complete gate) is written
                // over it — `_cache_atomic_copy` degrades to a non-atomic
                // in-place copy when `mktemp` is unavailable, so a torn
                // restore is reachable and would otherwise be blessed by a
                // matching sidecar. The manifest is deliberately NOT
                // probed here: it is legitimately empty for a module with
                // no `.layout` lines.
                if restored {
                    if fs.readFile(asm_path).length == 0 { restored = false; }
                }
                if restored {
                    outcome.ok = true;
                    outcome.cache_hit = true;
                    if ctx.trace {
                        print.err("[stage cache hit] " + src.slug);
                    }
                    // #1011: only a full pair restore reaches the
                    // entry-complete gate — write the sidecar LAST, same
                    // as the local fresh-emit path below.
                    _cr_write_srchash_digest(srchash_path, s_hash);
                    return outcome;
                }
                outcome.cache_restore_failed = true;
                if ctx.trace {
                    print.err("[stage cache restore-failed] " + src.slug);
                }
            } else {
                outcome.cache_miss = true;
                if ctx.trace {
                    print.err("[stage cache miss] " + src.slug);
                }
            }
        }
    }

    if !fs.exists(src.source_path) {
        print.err("capsule-resolver: missing source file: " + src.source_path);
        return outcome;
    }
    let mut ok: boolean = false;
    if sailfin_exe.length > 0 {
        // Subprocess path — fresh arena per child, parent stays
        // bounded. Mirror PR3's `_cr_compile_one` shape: pass the
        // slug via `--module-name` so the child's
        // `module_name_from_path` doesn't disagree with the slug
        // the resolver already computed (matters for cross-
        // capsule deps whose slug is `<scope>/<name>/<sub>`,
        // which `module_name_from_path` would NOT derive).
        //
        // #515: route through the shared subprocess retry helper so
        // a seed-emit flake on a `.sfn-asm` stage gets the same up-to-
        // 3 re-emit recovery the `.ll` path (`_cr_compile_one`) has.
        // `native` mode passes `validate=false` — the staged
        // `.sfn-asm` is not LLVM IR and must not round-trip through
        // `llvm-as` — so the helper's check stays "rc == 0 && non-
        // empty output", matching the prior single-attempt contract
        // on its success path. No import-context for the native stage
        // (`""`), and `trace=false` (this path has no `config`).
        ok = stage_native_text_with_retry(sailfin_exe, src.slug, src.source_path, asm_path, 3);
    } else {
        // #1333: publish the in-process `.sfn-asm` atomically, mirroring
        // the subprocess path (`emit_subprocess_with_retry`, #1011).
        // `write_native_text_file_with_module` rewrites its `-o` target in
        // place; under the parallel test pool two processes can cold-stage
        // the *same* shared import to this fixed `build/native/import-
        // context/<slug>.sfn-asm` concurrently, tearing each other's write
        // (`link failed` downstream). Emit to a sibling temp + atomic
        // rename so a peer reader sees a complete prior/new file — never a
        // partial. Falls back to in-place when `mktemp` is unavailable.
        let source = fs.readFile(src.source_path);
        let staged = _mktemp_sibling_cmd(asm_path);
        let mut emit_target: string = asm_path;
        if staged.length > 0 { emit_target = staged; }
        ok = write_staged_native_text_file(source, src.slug, emit_target);
        if ok {
            if staged.length > 0 {
                if !_atomic_rename_into_place(staged, asm_path) { ok = false; }
            }
        } else {
            if staged.length > 0 { fs.deleteFile(staged); }
        }
    }
    if !ok {
        print.err("capsule-resolver: failed to emit native text for " + src.slug);
        return outcome;
    }

    // Extract `.layout` lines into the sibling manifest. Shared
    // helper with the parallel-stage path so both routes produce
    // byte-identical manifests.
    _cr_extract_layout_manifest(asm_path, manifest_path);

    // SFN-861: publish the fresh pair into the shared cache under the key
    // computed above (empty/invalid when `ctx` was disabled or the source
    // was unhashable — `cache_store_artifact` rejects that as a no-op).
    // Best-effort: a store failure never fails the build.
    if ctx.enabled {
        if is_valid_digest(key.digest) {
            let stored = cache_store_artifact(ctx.root, key, "sfn-asm", asm_path)
                && cache_store_artifact(ctx.root, key, "layout-manifest", manifest_path);
            if stored {
                outcome.cache_stored = true;
                if ctx.trace {
                    print.err("[stage cache store] " + src.slug);
                }
            }
        }
    }

    // Record the source-content sidecar so the next run can detect an
    // unchanged source (best-effort; a hash failure simply re-emits later).
    // Reuse `s_hash` when it was already computed above (SFN-861) rather
    // than hashing the source a second time for this publish.
    if s_hash.length > 0 { _cr_write_srchash_digest(srchash_path, s_hash); } else {
        _cr_write_srchash(srchash_path, src.source_path);
    }
    outcome.ok = true;
    return outcome;
}

// #873: for every staged capsule source whose canonical slug differs
// from the path-shaped slug a relative importer derives from the file
// path (`module_name_from_path`), drop a `.slugalias` sidecar at the
// PATH-slug location mapping it to the canonical slug. A relative import
// (`../src/mod`) into a workspace member's source tree resolves to that
// path slug, which has no staged `.layout-manifest` (the module was
// staged under its canonical `sfn/crypto/mod` slug); the driver-owned
// import-context loader reads this sidecar and converges on the
// canonical slug so the call site mangles to the same symbol the capsule
// object defines.
//
// No sidecar is written when the slug already equals the path slug —
// which is every compiler-internal and non-capsule relative source — so
// the self-host staging emits none and the resolver branch is never taken
// while building the compiler.
fn _cr_write_capsule_slug_aliases(sources: CapsuleSource[], context_root: string) ![io] {
    let mut i: int = 0;
    loop {
        if i >= sources.length { break; }
        let src = sources[i];
        i += 1;
        if src.slug.length == 0 { continue; }
        if src.source_path.length == 0 { continue; }
        let path_slug = module_name_from_path(_cr_canonicalise_path(src.source_path));
        if path_slug.length == 0 { continue; }
        if strings_equal(path_slug, src.slug) { continue; }
        // Guard against path traversal / clobber: `module_name_from_path`
        // preserves `..` segments and a leading `/` when the source was
        // reached via a non-canonical or absolute path (e.g. building from
        // a different CWD via `../repo/...`). Such a slug would let
        // `alias_path` escape `context_root`. A consumer's import only ever
        // resolves to a clean relative slug, so a `..`/absolute sidecar
        // could never be read anyway — skip it rather than write outside
        // the staging root. The convergence simply falls back to the path
        // slug for that (unusual) source, which is the pre-#873 behaviour.
        if _cr_find_substring(path_slug, "..") >= 0 { continue; }
        if substring(path_slug, 0, 1) == "/" { continue; }
        let alias_path = context_root + "/" + path_slug + ".slugalias";
        _cr_ensure_dir(_cr_dirname(alias_path));
        fs.writeFile(alias_path, src.slug);
    }
}

// Extract `.layout` lines from a freshly-emitted `.sfn-asm` and
// write the sibling `.layout-manifest`. Split out of `_cr_stage_one_outcome`
// so the parallel-emit path can call it after xargs returns.
fn _cr_extract_layout_manifest(asm_path: string, manifest_path: string) ![io] {
    if !fs.exists(asm_path) { return; }
    let asm_text = fs.readFile(asm_path);
    let mut manifest: string = "";
    let mut line_start: int = 0;
    let len = asm_text.length;
    loop {
        if line_start >= len { break; }
        let mut line_end: int = line_start;
        loop {
            if line_end >= len { break; }
            if substring(asm_text, line_end, line_end + 1) == "\n" { break; }
            line_end += 1;
        }
        if line_end >= line_start + 7 {
            if substring(asm_text, line_start, line_start + 7) == ".layout" {
                manifest = manifest + substring(asm_text, line_start, line_end)
                    + "\n";
            }
        }
        line_start = line_end + 1;
    }
    // #1011: a reader resolving an imported module's struct layout must
    // never see a half-written `.layout-manifest` — publish atomically.
    let tmp = _mktemp_sibling_cmd(manifest_path);
    if tmp.length == 0 {
        fs.writeFile(manifest_path, manifest);
        return;
    }
    fs.writeFile(tmp, manifest);
    _atomic_rename_into_place(tmp, manifest_path);
}

// Stage import-context for every capsule source.
//
// Stage E PR1 (subprocess) → PR3 (parallel): when `sailfin_exe` is
// non-empty AND there's more than one source to emit AND
// `SAILFIN_BUILD_JOBS != 1`, the cache-miss subset is fanned across
// `_cr_resolve_jobs()` workers via `_cr_run_parallel_emit`.
// Single-process and `SAILFIN_BUILD_JOBS=1` paths fall through to
// the legacy serial loop (one `_cr_stage_one_outcome` call per source) so
// regression bisects keep the simple shape they had pre-PR3.
//
// Empty `sailfin_exe` keeps the in-process stage path that's
// load-bearing for callers that don't plumb `binary_dir` through
// (`sfn test` today; `sfn check` threads its exe since #1246).
//
// `config` gates the SFN-861 shared content-addressed cache for the
// staging artifacts (`.sfn-asm` + `.layout-manifest`) — a work-dir-
// independent layer on top of the local `.srchash`-gated cache above,
// which stays untouched and remains the first, cheapest probe. Pass a
// disabled config (`enabled: false`) for callers that don't want this
// build participating in the shared cache.
fn stage_capsule_imports(sources: CapsuleSource[], config: BuildCacheConfig, sailfin_exe: string, work_dir: string) -> boolean ![io] {
    let context_root = _cr_import_context_root(work_dir);
    if work_dir.length == 0 {
        _cr_ensure_dir("build");
        _cr_ensure_dir("build/native");
    }
    _cr_ensure_dir(context_root);

    if sources.length == 0 { return true; }

    // Validate provenance across the whole set before choosing a staging
    // strategy, so the guard covers the serial, jobs<=1, and parallel branches
    // alike and runs ahead of every cache-hit probe.
    let mut pi: int = 0;
    loop {
        if pi >= sources.length { break; }
        if !_cr_check_provenance(sources[pi]) { return false; }
        pi += 1;
    }

    // SFN-861: resolved ONCE per call so the per-module probes below never
    // repeat the env/hash work `_cr_resolve_stage_cache_ctx` does.
    let ctx = _cr_resolve_stage_cache_ctx(config, sailfin_exe);
    let mut summary = _cr_empty_stage_cache_summary();

    // Serial path — when no `sailfin_exe` (in-process emit) or the
    // task list is small enough that subprocess overhead would
    // dominate. Single-source builds never benefit from
    // parallelism.
    if sailfin_exe.length == 0 || sources.length == 1 {
        let mut si: int = 0;
        loop {
            if si >= sources.length { break; }
            let outcome = _cr_stage_one_outcome(sources[si], ctx, sailfin_exe, work_dir);
            if outcome.cache_hit { summary.hits = summary.hits + 1; }
            if outcome.cache_miss { summary.misses = summary.misses + 1; }
            if outcome.cache_stored { summary.stores = summary.stores + 1; }
            if outcome.cache_restore_failed {
                summary.restore_failed = summary.restore_failed + 1;
            }
            if !outcome.ok { return false; }
            si += 1;
        }
        _cr_write_capsule_slug_aliases(sources, context_root);
        if ctx.trace { _cr_print_stage_cache_summary(summary); }
        return true;
    }

    let jobs = _cr_resolve_jobs();
    if jobs <= 1 {
        // SAILFIN_BUILD_JOBS=1 (or unresolved nproc): keep the
        // legacy serial path. No xargs overhead, no temp file.
        let mut si: int = 0;
        loop {
            if si >= sources.length { break; }
            let outcome = _cr_stage_one_outcome(sources[si], ctx, sailfin_exe, work_dir);
            if outcome.cache_hit { summary.hits = summary.hits + 1; }
            if outcome.cache_miss { summary.misses = summary.misses + 1; }
            if outcome.cache_stored { summary.stores = summary.stores + 1; }
            if outcome.cache_restore_failed {
                summary.restore_failed = summary.restore_failed + 1;
            }
            if !outcome.ok { return false; }
            si += 1;
        }
        _cr_write_capsule_slug_aliases(sources, context_root);
        if ctx.trace { _cr_print_stage_cache_summary(summary); }
        return true;
    }

    // Parallel path: partition sources into already-staged
    // (cache hit) and needs-emit. Cache hit checks are O(2N)
    // file existence probes and run faster sequentially than
    // dispatching subprocesses for them. The needs-emit set
    // goes to `_cr_run_parallel_emit`, then a sequential pass
    // extracts each `.layout-manifest` (also fast — just file
    // read + grep, no subprocess).
    let mut needs_emit: ParallelEmitTask[] = [];
    let mut emit_indices: int[] = [];
    // SFN-861: parallel arrays to `emit_indices`, carrying the cache key
    // and source digest already computed for that module in the
    // partition loop below into the post-emit pass — mirrors
    // `compile.sfn`'s `emit_keys` pattern (its parallel-fan pass 1/pass 3
    // split) so the post-emit pass never rehashes a source it already
    // hashed once for the same publish.
    let mut emit_keys: CacheKey[] = [];
    let mut emit_source_digests: string[] = [];
    let mut si: int = 0;
    loop {
        if si >= sources.length { break; }
        let src = sources[si];
        let asm_path = context_root + "/" + src.slug + ".sfn-asm";
        let manifest_path = context_root + "/" + src.slug + ".layout-manifest";
        let srchash_path = _cr_srchash_path(context_root, src.slug);
        let asm_dir = _cr_dirname(asm_path);
        _cr_ensure_dir(asm_dir);
        // Cache hit requires asm + manifest present AND the source sidecar
        // to match (same content-hash contract as the serial path). This
        // local probe stays first and unchanged — it is the cheapest one.
        let cache_hit = _cr_stage_cache_hit(asm_path, manifest_path, srchash_path, src.source_path);
        if !cache_hit {
            // SFN-861: local miss — try the shared cache before queueing a
            // real emit. A restored pair is staged the same as a local hit,
            // so it never enters `needs_emit`. `s_hash` is hashed once and
            // reused for the key derivation and, on a hit, the sidecar
            // write below — and, on a miss, is carried into the post-emit
            // pass so a subsequent store + sidecar write need not rehash.
            let mut shared_hit: boolean = false;
            let mut key: CacheKey = CacheKey { digest: "" };
            let mut s_hash: string = "";
            if ctx.enabled {
                s_hash = sha256_of_file(src.source_path);
                key = stage_cache_key_from_digest(s_hash, src.slug, ctx.compiler_version, ctx.target_triple);
                if is_valid_digest(key.digest) {
                    let found = cache_lookup_artifact(ctx.root, key, "sfn-asm")
                        && cache_lookup_artifact(ctx.root, key, "layout-manifest");
                    if found {
                        let mut restored = cache_copy_artifact_to(ctx.root, key, "sfn-asm", asm_path)
                            && cache_copy_artifact_to_untouched(ctx.root, key, "layout-manifest", manifest_path);
                        // Same torn-restore guard as the serial path: verify
                        // the restored `.sfn-asm` is non-empty before the
                        // `.srchash` sidecar blesses it as complete. The
                        // manifest is deliberately not probed — legitimately
                        // empty for a module with no `.layout` lines.
                        if restored {
                            if fs.readFile(asm_path).length == 0 {
                                restored = false;
                            }
                        }
                        if restored {
                            shared_hit = true;
                            summary.hits = summary.hits + 1;
                            if ctx.trace {
                                print.err("[stage cache hit] " + src.slug);
                            }
                            _cr_write_srchash_digest(srchash_path, s_hash);
                        } else {
                            summary.restore_failed = summary.restore_failed + 1;
                            if ctx.trace {
                                print.err("[stage cache restore-failed] " + src.slug);
                            }
                        }
                    } else {
                        summary.misses = summary.misses + 1;
                        if ctx.trace {
                            print.err("[stage cache miss] " + src.slug);
                        }
                    }
                }
            }
            if !shared_hit {
                if !fs.exists(src.source_path) {
                    print.err("capsule-resolver: missing source file: " + src.source_path);
                    return false;
                }
                needs_emit.push(ParallelEmitTask {
                    slug: src.slug, output_path: asm_path, source_path: src.source_path
                });
                emit_indices.push(si);
                emit_keys.push(key);
                emit_source_digests.push(s_hash);
            }
        }
        si += 1;
    }

    if needs_emit.length > 0 {
        let emit_ok = _cr_run_parallel_emit(needs_emit, "native", sailfin_exe, jobs, "");
        if !emit_ok {
            print.err("capsule-resolver: one or more parallel stage emits failed");
            return false;
        }
        // Sequential post-pass: extract `.layout-manifest` for
        // each freshly-emitted `.sfn-asm`. Cheap (read + line
        // scan) so parallelizing this step would be pure
        // overhead.
        let mut ei: int = 0;
        loop {
            if ei >= emit_indices.length { break; }
            let src_idx = emit_indices[ei];
            let src = sources[src_idx];
            let asm_path = context_root + "/" + src.slug + ".sfn-asm";
            let manifest_path = context_root + "/" + src.slug
                + ".layout-manifest";
            let srchash_path = _cr_srchash_path(context_root, src.slug);
            _cr_extract_layout_manifest(asm_path, manifest_path);
            // SFN-861: publish the fresh pair into the shared cache using
            // the key already computed for this module in the partition
            // loop above — carried via `emit_keys` rather than recomputed,
            // so the source is not hashed a second time for one publish.
            let store_key = emit_keys[ei];
            let s_hash = emit_source_digests[ei];
            if ctx.enabled {
                if is_valid_digest(store_key.digest) {
                    let stored = cache_store_artifact(ctx.root, store_key, "sfn-asm", asm_path)
                        && cache_store_artifact(ctx.root, store_key, "layout-manifest", manifest_path);
                    if stored {
                        summary.stores = summary.stores + 1;
                        if ctx.trace {
                            print.err("[stage cache store] " + src.slug);
                        }
                    }
                }
            }
            // Record the source-content sidecar so a subsequent probe sees
            // this freshly-emitted module as a valid cache hit. Reuses
            // `s_hash` carried from the partition loop when present.
            if s_hash.length > 0 {
                _cr_write_srchash_digest(srchash_path, s_hash);
            } else { _cr_write_srchash(srchash_path, src.source_path); }
            ei += 1;
        }
    }
    // #873: alias sidecars are written for ALL sources (not just freshly-
    // emitted ones) so a cache-hit run still publishes the path→canonical
    // slug mapping the importer needs.
    _cr_write_capsule_slug_aliases(sources, context_root);
    if ctx.trace { _cr_print_stage_cache_summary(summary); }
    return true;
}

// Build the dep-manifest list once per `compile_capsule_modules`
// invocation. PR1e refines this from "all staged manifests"
// (conservative: any change anywhere busts every cache key) to a
// per-source list of the manifests that source's direct imports
// produce. The cache invalidation chain remains correct because
// each `.layout-manifest` captures a module's interface — when a
// transitive dep's interface changes, the consuming module's
// manifest changes, which busts its consumers' keys in turn.
//
// Granularity:
//   - Relative imports (`./util`, `../foo`) match by source path
//     and produce a single dep slug per import.
//   - Scoped imports (`sfn/math`, `sfn/http/client`) match by
//     capsule prefix (`scope/name`) and pull in EVERY submodule
//     of the imported capsule. This is intentionally coarse for
//     PR1e — refining to per-submodule precision lands separately
//     once the resolver retains submodule-resolution edges.
// For source `src`, return the slugs in `sources` that this source
// directly imports.
//
// SFN-833: the relation itself now lives in `reachability.sfn` and is
// shared with the import-reachability filter, so the filter and this
// cache-key/manifest derivation cannot disagree about what an edge is
// (SFEP-0070 §3.5, layer 1). Behaviour here is unchanged.
fn _cr_direct_import_slugs_for(src: CapsuleSource, sources: CapsuleSource[]) -> string[] ![io] {
    return _cr_module_edge_slugs(src, sources);
}

// For each source, compute the slugs of its direct imports. Result is
// a parallel array — index i is the dep slug list for `sources[i]`.
//
// These slugs are the provider identities the cache key mixes in
// (SFN-661) and the basis for the `.layout-manifest` paths derived by
// `_cr_dep_manifest_paths_for_slugs`.
//
// #984: slug resolution runs against `universe` (= `sources ++`
// the staged `-p` entry), not `sources`, so a sibling's direct import
// of the walk-excluded entry contributes the entry's `.layout-manifest`
// to its dep list — feeding both the cache key and the in-process
// enforcement fallback. Manifests are still emitted only for `sources`.
fn _cr_collect_per_source_dep_slugs(sources: CapsuleSource[], universe: CapsuleSource[]) -> string[][] ![io] {
    let mut out: string[][] = [];
    let mut i: int = 0;
    loop {
        if i >= sources.length { break; }
        out.push(_cr_direct_import_slugs_for(sources[i], universe));
        i += 1;
    }
    return out;
}

// Map the per-source dep slugs to the `.layout-manifest` paths that
// staging publishes for them. Pure string derivation over the result
// of `_cr_collect_per_source_dep_slugs` — kept separate so the one
// import scan feeds both the cache key's dep-slug component (SFN-661)
// and the manifest paths, rather than reading every source twice.
fn _cr_dep_manifest_paths_for_slugs(per_source_dep_slugs: string[][], work_dir: string) -> string[][] {
    let context_root = _cr_import_context_root(work_dir);
    let mut out: string[][] = [];
    let mut i: int = 0;
    loop {
        if i >= per_source_dep_slugs.length { break; }
        let dep_slugs = per_source_dep_slugs[i];
        let mut paths: string[] = [];
        let mut j: int = 0;
        loop {
            if j >= dep_slugs.length { break; }
            paths.push(context_root + "/" + dep_slugs[j] + ".layout-manifest");
            j += 1;
        }
        out.push(paths);
        i += 1;
    }
    return out;
}

// #957: map each `<root>/<slug>.layout-manifest` path to the sibling
// `<root>/<slug>.sfn-asm` the effect-import loader reads. The two are
// staged together by `stage_capsule_imports`, so a suffix swap yields
// the dependency's staged native-IR artifact without re-resolving the
// capsule graph.
fn _cr_manifests_to_asm_paths(manifests: string[]) -> string[] {
    let mut out: string[] = [];
    let suffix = ".layout-manifest";
    let mut i: int = 0;
    loop {
        if i >= manifests.length { break; }
        let m = manifests[i];
        if _cr_ends_with(m, suffix) {
            out.push(substring(m, 0, m.length - suffix.length) + ".sfn-asm");
        }
        i += 1;
    }
    return out;
}

// #957: stage a per-module `.import-deps` sidecar (one direct-import
// `.sfn-asm` path per line) under the import-context root. The
// `<sailfin> emit --import-context <root>` subprocess reads
// `<root>/<slug>.import-deps` to load the cross-module effect table,
// so callee-effect transitivity (`E0402`) is enforced on the build
// path — the in-process compile path passes the same paths directly.
// Direct imports suffice: an imported callee's `.sfn-asm` already
// carries the (transitively-complete) effects its own signature
// declares, and `localize_import_symbols_for_program` scopes the
// loaded table to this program's import declarations.
//
// #984: slug resolution runs against `universe`, not `sources`. On
// `-p` (`walk_project_src`) builds the entry module is staged but
// excluded from `sources` (its `.ll` is produced separately), so an
// import of the entry would resolve to no slug and the sibling's
// sidecar would omit the entry's `.sfn-asm` — leaving `sibling→entry`
// effects unenforced on the build path. `universe` re-adds the staged
// entry for resolution while sidecars are still written only for
// `sources` (the modules `compile_capsule_modules` actually emits).
fn _cr_stage_import_deps(sources: CapsuleSource[], universe: CapsuleSource[], work_dir: string) -> void ![io] {
    let context_root = _cr_import_context_root(work_dir);
    let mut i: int = 0;
    loop {
        if i >= sources.length { break; }
        let dep_slugs = _cr_direct_import_slugs_for(sources[i], universe);
        let mut content: string = "";
        let mut j: int = 0;
        loop {
            if j >= dep_slugs.length { break; }
            content = content + context_root + "/" + dep_slugs[j] + ".sfn-asm"
                + "\n";
            j += 1;
        }
        let deps_path = context_root + "/" + sources[i].slug + ".import-deps";
        _cr_ensure_dir(_cr_dirname(deps_path));
        // #1011: the `--import-context` worker reads this sidecar; publish
        // atomically so a peer never reads a partial dep list.
        let tmp = _mktemp_sibling_cmd(deps_path);
        if tmp.length == 0 { fs.writeFile(deps_path, content); } else {
            fs.writeFile(tmp, content);
            _atomic_rename_into_place(tmp, deps_path);
        }
        i += 1;
    }
}
