// compiler/src/capsule_resolver/dedupe.sfn
//
// Source-set resolution and dedupe. Runs every enumeration path for a set of
// entry paths — relative-import walk, binary `src/` walk, manifest deps, host
// capsule, workspace-implicit and cache-implicit — then folds the results into
// one `CapsuleSource[]` with no duplicate path or slug, and fills in each
// source's `ll_path` once the consumer and dep layout are known.
import { compute_runtime_demand, runtime_demand_all } from "../build/runtime_selection";
import { cache_key_for } from "../build_cache";
import { capsule_artifact_layout_from_specs } from "../capsule_artifact";
import { enumerate_runtime_capsule_artifacts } from "../runtime_capsule_resolver";
import {
    toml_get_build_full_runtime,
    toml_get_capabilities_required,
    toml_get_dependencies,
    toml_get_name
} from "../toml_parser";
import { _cr_enumerate_host_capsule_sources, enumerate_capsule_sources } from "./discovery";
import { source_identity_member_for_project } from "./identity";
import {
    _cr_any_entry_imports_host,
    _cr_dep_specs_from_text,
    enumerate_binary_capsule_sources,
    enumerate_cache_implicit_sources,
    enumerate_workspace_implicit_sources
} from "./implicit";
import {
    _cr_consumer_root_prefix,
    _cr_dirname,
    _cr_path_join,
    _cr_resolve_ll_path,
    _cr_routing_slug,
    _cr_string_array_contains,
    discover_project_root
} from "./paths";
import { _cr_empty_relative_scan_memo, _cr_enumerate_relative_sources_memo } from "./relative";
import {
    CapsuleSource,
    ProjectCapsuleResult,
    ResolverConsumer,
    WorkspaceMember,
    empty_resolver_consumer
} from "./types";
import { discover_workspace_root, load_workspace_members } from "./workspace";

// Result of the shared resolution + dedupe pass shared between the
// build (`prepare_project_capsules`) and check
// (`prepare_project_capsules_for_check`) entry points. `has_collision`
// distinguishes "slug collision detected" from "nothing to compile":
// callers that need to distinguish setup errors from no-deps (e.g.
// `sfn check` returning exit code 2) consult this flag instead of
// inferring intent from an empty source list.
struct ResolverDedupeResult {
    sources: CapsuleSource[];
    has_collision: boolean;
    // Phase F (`docs/proposals/0008-effect-validation.md` §5): the
    // project manifest's `[capabilities] required = [...]` list.
    // Empty when no manifest is present (standalone .sfn files
    // outside any capsule) — the effect-checker treats that as
    // "no capability surface to compare against" and skips the
    // E0403 cross-check.
    capabilities_required: string[];
    // Stage D PR2: every declared `[dependencies]` key from the
    // project's `capsule.toml`. `prepare_project_capsules` passes
    // this through `enumerate_runtime_capsule_artifacts` so the
    // returned `ProjectCapsuleResult.runtime_capsules` only
    // contains workspace runtime capsules the project actually
    // depends on. Empty for standalone files / projects without
    // a manifest, which short-circuits the runtime-capsule lookup.
    manifest_dep_specs: string[];
    // Stage D PR2: workspace root discovered while walking the
    // dep graph (or `""` if the project sits outside any
    // workspace). Required for `enumerate_runtime_capsule_artifacts`,
    // which reads `<workspace_root>/workspace.toml`.
    workspace_root: string;
    // SFN-833: the source paths that seed the import-reachability
    // closure — every resolved source the DEPENDENCY enumerators did
    // not contribute (the relative-import walk, the `-p` binary `src/`
    // walk, the host-capsule walk). Recorded here, at the one site that
    // knows which leg produced which source, because neither `spec` nor
    // `origin` can be read back as a root signal: a relatively-imported
    // file inside a workspace member carries that member's canonical
    // spec (#873), and the host-capsule walk stamps the consumer's own
    // sources with the host capsule's name.
    //
    // Consumed by every filtered resolver path (SFEP-0070 §§3.2, 3.6).
    // Build/link adds runtime roots; `sfn check` uses its explicit requested
    // files as entry roots and keeps the closure complete for those files.
    root_source_paths: string[];
    // SFN-882: the canonical effect roots this build demands, or the `"*"`
    // sentinel meaning "retain everything". Drives demand-driven runtime
    // `sfn-source` selection at all three consumers — runtime-root seeding
    // here in the resolver, and dep staging plus the link in the driver.
    //
    // Computed once, at the single success return below, and threaded
    // verbatim thereafter; never recomputed per consumer, because the
    // consumers straddle two phases and independent recomputation would be
    // free to disagree. Every early/error return sets `"*"`, which is the
    // fail-open direction: a resolution that did not get far enough to
    // compute a real demand set must not narrow anything.
    runtime_demand: string[];
}

// Shared resolution + dedupe used by both `prepare_project_capsules`
// and `prepare_project_capsules_for_check`. Walks three resolution
// paths and concatenates their `CapsuleSource` outputs:
//
//   1. Relative imports (`./foo`, `../bar`) reachable from each entry
//      in `entry_paths` — always walked, even for standalone files
//      outside any capsule.toml. Walking from multiple entry paths
//      lets `sfn check pathA pathB` (multi-path invocation) pick up
//      relative-import graphs that aren't transitively reachable from
//      a single anchor file.
//   2. Manifest-declared capsule deps (`[dependencies]` in the
//      project's capsule.toml) — every .sfn under each dep's src/.
//      Resolved against `entry_paths[0]`'s discovered project root
//      (which by construction is shared by every entry in the same
//      group, so any entry's project root yields the same answer).
//   3. Workspace-implicit imports — any scoped import (`scope/name`)
//      any of the entries uses that maps to a workspace member but
//      isn't declared in `[dependencies]`. Replaces the legacy
//      `_is_stdlib_capsule_cmd` allowlist; workspace.toml is the
//      single source of truth for which capsules are implicitly
//      available.
//
// On slug collision (two distinct source paths producing the same
// slug), prints a structured error to stderr and returns
// `has_collision = true`. Same-slug-same-path entries are silently
// deduped — that's an exact duplicate, not a conflict.
//
// Stage C2b2: after dedupe, this pass also fills in each
// `CapsuleSource.ll_path` per the per-capsule layout (proposal
// §4.4). Construction sites emit `ll_path = ""`; the layout
// decision is centralized here so both manifest deps and
// relative-imports route through the same policy.
// SFN-341: two enumerators can surface the SAME file under different
// spellings. Testing a capsule that the runtime also depends on is the
// case that bites: the host-capsule walk roots at `./capsules/<scope>/
// <name>` while the runtime-dependency union resolves the identical tree
// as `capsules/<scope>/<name>`. Compared verbatim those look like two
// providers of one slug and trip the collision diagnostic, so strip a
// leading `./` before comparing and let the duplicate collapse. This only
// ever makes two spellings of one path compare equal — a genuine collision
// between distinct files still fails closed.
fn _cr_strip_leading_dot_slash(path: string) -> string {
    if path.length >= 2 && substring(path, 0, 2) == "./" {
        return substring(path, 2, path.length);
    }
    return path;
}

// SFN-341: the spec set the manifest-dep / runtime-union enumerators have
// already supplied IN FULL, for the workspace-implicit walk to skip.
// `base` is the project's declared `[dependencies]`; `provided` is what
// `enumerate_capsule_sources` actually returned, which is strictly larger —
// it adds the transitive closure and the runtime capsule's own dependency
// union. Returns a fresh array so the caller's `covered_specs` (surfaced as
// `manifest_dep_specs`) is never mutated.
fn _cr_specs_union(base: string[], provided: CapsuleSource[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= base.length { break; }
        if !_cr_string_array_contains(out, base[i]) {
            out.push(base[i]);
        }
        i += 1;
    }
    let mut j: int = 0;
    loop {
        if j >= provided.length { break; }
        let spec = provided[j].spec;
        if spec.length > 0 {
            if !_cr_string_array_contains(out, spec) { out.push(spec); }
        }
        j += 1;
    }
    return out;
}

fn _cr_resolve_and_dedupe(entry_paths: string[], consumer: ResolverConsumer, bundled_workspace_start: string) -> ResolverDedupeResult ![io] {
    let mut sources: CapsuleSource[] = [];
    let empty_sources: CapsuleSource[] = [];
    let empty_specs: string[] = [];

    let mut empty_caps: string[] = [];
    let empty_roots: string[] = [];
    // SFN-833: paths contributed by the DEPENDENCY enumeration legs
    // (manifest deps + the runtime union, workspace-implicit, and
    // cache-implicit). Everything else is a reachability root. Tracking
    // the dependency side rather than the root side is deliberate: a leg
    // added later that forgets to declare itself defaults to ROOT, which
    // over-approximates the retained set instead of silently dropping
    // sources the build needs.
    let mut dep_leg_paths: string[] = [];
    if entry_paths.length == 0 && consumer.runtime_root.length == 0 {
        return ResolverDedupeResult {
            sources: empty_sources,
            has_collision: false,
            capabilities_required: empty_caps,
            manifest_dep_specs: empty_specs,
            workspace_root: "",
            root_source_paths: empty_roots,
            runtime_demand: runtime_demand_all()
        };
    }

    // SFN-341: the guard above admits exactly one new shape past this
    // point — a runtime-dep-only resolution with no project entry
    // (`prepare_runtime_dep_capsules`, empty `entry_paths`, non-empty
    // `runtime_root`). Both anchored discoveries below are gated on
    // having an entry rather than on `discover_*_root("")` returning
    // empty: `discover_project_root` substitutes `"."` for an empty
    // start dir (`paths.sfn`), so an ungated call would probe the
    // PROCESS CWD and, whenever that directory happens to hold a
    // `capsule.toml`, run the manifest branch against an unrelated
    // project — folding its dep closure into a resolution that is
    // supposed to cover the runtime's deps alone. Gating keeps
    // `project_root` empty, so control reaches the `else if
    // consumer.runtime_root.length > 0` manifest-less runtime-union
    // branch by construction, and leaves `workspace_root` to the
    // SFN-352 `bundled_workspace_start` probe, which is the one anchor
    // deliberately independent of the CWD.
    // (2) Manifest-declared capsule deps and (3) workspace-implicit
    // imports use the first entry's directory as the anchor. By
    // construction (callers group entries by `(project_root,
    // workspace_root)`), every entry in `entry_paths` resolves to the
    // same project root and workspace root, so the choice of anchor
    // doesn't change the result. Computed up-front (#873) because the
    // relative walk now needs the workspace member set to canonicalize
    // a capsule source's slug to its spec slug.
    let mut anchor_dir: string = "";
    if entry_paths.length > 0 { anchor_dir = _cr_dirname(entry_paths[0]); }

    let mut source_workspace_root: string = "";
    if entry_paths.length > 0 {
        source_workspace_root = discover_workspace_root(anchor_dir);
    }
    let mut workspace_root = source_workspace_root;
    if workspace_root.length == 0 {
        // SFN-352: the compiler driver supplies an absolute binary directory,
        // which remains stable when a standalone command runs with the entry
        // directory as cwd. Prefer that anchor for bundled workspace capsules;
        // retain the cwd probe for direct/internal callers without driver
        // context. An installed compiler normally finds no workspace from
        // either anchor and continues into the cache-implicit leg below.
        if bundled_workspace_start.length > 0 {
            workspace_root = discover_workspace_root(bundled_workspace_start);
        }
        if workspace_root.length == 0 {
            workspace_root = discover_workspace_root("");
        }
    }
    let mut members: WorkspaceMember[] = [];
    if workspace_root.length > 0 {
        members = load_workspace_members(workspace_root);
    }
    let mut project_root: string = "";
    if entry_paths.length > 0 {
        project_root = discover_project_root(anchor_dir);
        let selected_member = source_identity_member_for_project(project_root);
        if selected_member.name.length > 0 {
            members.push(selected_member);
        }
    }

    // (1) Relative imports — walked from every entry; the dedupe loop
    // below collapses overlapping sets. A relatively-imported file that
    // resolves into a workspace member's `src/` is staged under that
    // member's canonical spec slug (#873), so it collapses cleanly
    // against the same file discovered by the workspace-implicit walk.
    //
    // #1247: one scan memo is threaded across every entry's walk so
    // each unique source in the union closure is read + scanned at
    // most once per resolution pass. Without this, a whole-tree
    // `sfn check` re-scanned every closure module once per entry —
    // O(entries × closure) scans whose arena garbage (allocated
    // before the per-file loop's Phase 5a mark) grew peak RSS by
    // ~25MB per entry and could never be rewound.
    let mut scan_memo = _cr_empty_relative_scan_memo();
    let mut ei: int = 0;
    loop {
        if ei >= entry_paths.length { break; }
        let entry = entry_paths[ei];
        let outcome = _cr_enumerate_relative_sources_memo(entry, members, scan_memo);
        scan_memo = outcome.memo;
        let relative = outcome.sources;
        let mut ri: int = 0;
        loop {
            if ri >= relative.length { break; }
            sources.push(relative[ri]);
            ri += 1;
        }
        ei += 1;
    }

    // (1b) Stage D PR3: opt-in `<project_root>/src/**/*.sfn` walk
    // for `kind = "binary"` `-p` builds. The relative-import
    // walker only follows modules transitively imported from the
    // entry, but the compiler's `main.sfn` doesn't import every
    // CLI / lowering module the link needs. Walking `src/`
    // directly closes that gap — and emits the same slugs the
    // relative-import walker would, so any module the entry DOES
    // reach gets dedupe-collapsed cleanly below. Off by default;
    // `cli_main.sfn` sets `walk_project_src` only when `-p` is
    // used and the resolved kind is binary.
    if consumer.walk_project_src {
        if project_root.length > 0 {
            let mut bei: int = 0;
            loop {
                if bei >= entry_paths.length { break; }
                let bin_sources = enumerate_binary_capsule_sources(project_root, entry_paths[bei], members);
                let mut bsi: int = 0;
                loop {
                    if bsi >= bin_sources.length { break; }
                    sources.push(bin_sources[bsi]);
                    bsi += 1;
                }
                bei += 1;
            }
        }
    }
    let mut covered_specs: string[] = [];
    let mut capabilities_required: string[] = [];
    // SFN-882: `[build] full-runtime = true` opts this artifact out of
    // demand-driven runtime source selection entirely. Set on
    // `compiler/capsule.toml`, whose binary is the runtime provider surface
    // and must carry every runtime module regardless of what its own sources
    // declare. Absent → false for every ordinary project.
    let mut project_full_runtime: boolean = false;
    // SFN-341: the exclusion set for the workspace-implicit walk (3). It is
    // NOT `covered_specs`: the declared-dep list omits both the transitive
    // closure and the runtime `[dependencies]` union, so a capsule the dep
    // enumerator already returned in full was enumerated a second time here.
    // That second provider is not benign — the two legs anchor their paths
    // differently (the dep leg on the project root or the runtime bundle, the
    // implicit leg on the discovered workspace root, which is ABSOLUTE
    // whenever it came from the driver's `binary_dir` rather than the entry),
    // so one file arrives under two spellings and the slug dedupe below reads
    // that as two providers of one slug. The resulting false collision fails
    // the whole resolution and drops EVERY capsule source from the link.
    // Excluding by spec is what the cache-implicit leg (4) already does, and
    // it costs no coverage: both legs enumerate a capsule's entire `src/`
    // tree, so whichever one runs first is complete on its own. Sources the
    // RELATIVE walk contributed are deliberately not excluded — that walk
    // only reaches what the entry transitively imports, so its spec tag does
    // not imply whole-capsule coverage.
    let mut implicit_excluded: string[] = [];
    if project_root.length > 0 {
        let manifest_path = _cr_path_join(project_root, "capsule.toml");
        if fs.exists(manifest_path) {
            let manifest_text = fs.readFile(manifest_path);
            let deps_text = toml_get_dependencies(manifest_text);
            covered_specs = _cr_dep_specs_from_text(deps_text);
            // Phase F: extract `[capabilities] required = [...]` so
            // the effect-checker can compare every function's
            // declared effects against the manifest-allowed surface.
            // Empty list (no [capabilities] section, or `required =
            // []`) tells the checker to skip the cross-check —
            // that's the right call for projects mid-migration.
            capabilities_required = toml_get_capabilities_required(manifest_text);
            project_full_runtime = toml_get_build_full_runtime(manifest_text);
        }
        let dep_sources = enumerate_capsule_sources(project_root, consumer.runtime_root);
        let mut di: int = 0;
        loop {
            if di >= dep_sources.length { break; }
            sources.push(dep_sources[di]);
            dep_leg_paths.push(_cr_strip_leading_dot_slash(dep_sources[di].source_path));
            di += 1;
        }
        implicit_excluded = _cr_specs_union(covered_specs, dep_sources);
        // P1 (#363): when `consumer.include_host_as_dep` is set
        // (currently `sfn test`) AND at least one test entry
        // imports the host capsule by its `[capsule].name`,
        // enumerate `<project_root>/src/` and tag each source with
        // the manifest's name as the spec. The by-name gate is
        // required for correctness: `_cr_enumerate_host_capsule_sources`
        // pulls in every `.sfn` under `src/`, including the capsule
        // entrypoint. For a capsule whose tests only reach the host
        // via `../src/...` (path-shaped slug) — the compiler's own
        // `compiler/tests/` suite is the canonical case — firing
        // host-enum would link `main.sfn`'s `@main` into each test
        // binary on top of the test-runner `@main`, failing the link
        // with `invalid redefinition of function 'main'`. (#527 also
        // closed the cache-entry race that co-firing the path-shaped
        // and `<name>/<rel>` walkers would cause, by mixing the slug
        // into `cache_key_for`'s digest; the gate independently
        // prevents the duplicate-entrypoint link hazard.) The build
        // path keeps this off (`empty_resolver_consumer()`) because
        // the host capsule's entry source is compiled directly via
        // the single-file `compile_to_llvm_file_with_module` path, so
        // re-enumerating it here would double-emit.
        if consumer.include_host_as_dep {
            let manifest_path = _cr_path_join(project_root, "capsule.toml");
            if fs.exists(manifest_path) {
                let manifest_text = fs.readFile(manifest_path);
                let host_name = toml_get_name(manifest_text);
                if host_name.length > 0 {
                    if _cr_any_entry_imports_host(entry_paths, host_name) {
                        let host_sources = _cr_enumerate_host_capsule_sources(project_root);
                        let mut hi: int = 0;
                        loop {
                            if hi >= host_sources.length { break; }
                            let candidate = host_sources[hi];
                            // Filter by source_path — the relative-
                            // import walker may have already emitted
                            // the same source under a path-shaped
                            // slug; the slug-collision detector
                            // doesn't catch that case because the
                            // slugs differ.
                            let mut already_seen: boolean = false;
                            let mut sj: int = 0;
                            loop {
                                if sj >= sources.length { break; }
                                if strings_equal(sources[sj].source_path, candidate.source_path) {
                                    already_seen = true;
                                    break;
                                }
                                sj += 1;
                            }
                            if !already_seen { sources.push(candidate); }
                            hi += 1;
                        }
                    }
                }
            }
        }
    } else if consumer.runtime_root.length > 0 {
        // SFN-341: a manifest-less build (`sfn build prog.sfn`) never enters
        // the branch above, but the runtime's own `[dependencies]` still have
        // to reach the link set — the runtime's `sfn-sources` are in every
        // binary, so their calls into a capsule provider are emitted even for
        // a program that declares nothing. `enumerate_capsule_sources`
        // resolves only the runtime union when the project root is empty.
        // Kept as a separate branch rather than widening the gate above: the
        // host-capsule and lockfile logic there reads `<project_root>/…`
        // paths that would resolve cwd-relative under an empty root.
        let rt_dep_sources = enumerate_capsule_sources("", consumer.runtime_root);
        let mut rdsi: int = 0;
        loop {
            if rdsi >= rt_dep_sources.length { break; }
            sources.push(rt_dep_sources[rdsi]);
            dep_leg_paths.push(_cr_strip_leading_dot_slash(rt_dep_sources[rdsi].source_path));
            rdsi += 1;
        }
        implicit_excluded = _cr_specs_union(covered_specs, rt_dep_sources);
    }

    if workspace_root.length > 0 {
        // `workspace_root` + `members` were resolved up-front (above the
        // relative walk) so both the relative and implicit enumerators
        // share one member set (#873).
        // Workspace-implicit enumeration is per-entry: each entry may
        // reference a different scoped import, and the union is the
        // set the project actually needs.
        let mut wi_entry: int = 0;
        loop {
            if wi_entry >= entry_paths.length { break; }
            let implicit = enumerate_workspace_implicit_sources(entry_paths[wi_entry], members, implicit_excluded);
            let mut wi: int = 0;
            loop {
                if wi >= implicit.length { break; }
                sources.push(implicit[wi]);
                dep_leg_paths.push(_cr_strip_leading_dot_slash(implicit[wi].source_path));
                wi += 1;
            }
            wi_entry += 1;
        }
    }

    // (4) Cache-implicit imports (SFN-216): a bare `sfn build main.sfn`
    // with no source-anchored capsule.toml/workspace.toml resolves scoped
    // imports the user `sfn add`ed into ~/.sfn/cache. If step (3) found a
    // cwd workspace fallback for bundled capsules (SFN-348), still run the
    // cache leg for specs that workspace did not satisfy; otherwise a
    // `/tmp/main.sfn` run from the Sailfin checkout would lose access to
    // cached third-party capsules like `demo/greeter`. Excluding specs
    // already present in `sources` prevents double-staging the same
    // canonical slug from both the cwd workspace and the user cache.
    if project_root.length == 0 {
        if source_workspace_root.length == 0 {
            let mut cache_excluded: string[] = [];
            let mut csi: int = 0;
            loop {
                if csi >= sources.length { break; }
                let spec = sources[csi].spec;
                if spec.length > 0 {
                    if !_cr_string_array_contains(cache_excluded, spec) {
                        cache_excluded.push(spec);
                    }
                }
                csi += 1;
            }
            let mut ci_entry: int = 0;
            loop {
                if ci_entry >= entry_paths.length { break; }
                let cached = enumerate_cache_implicit_sources(entry_paths[ci_entry], cache_excluded);
                let mut cci: int = 0;
                loop {
                    if cci >= cached.length { break; }
                    sources.push(cached[cci]);
                    dep_leg_paths.push(_cr_strip_leading_dot_slash(cached[cci].source_path));
                    cci += 1;
                }
                ci_entry += 1;
            }
        }
    }

    if sources.length == 0 {
        return ResolverDedupeResult {
            sources: empty_sources,
            has_collision: false,
            capabilities_required: capabilities_required,
            manifest_dep_specs: covered_specs,
            workspace_root: workspace_root,
            root_source_paths: empty_roots,
            runtime_demand: runtime_demand_all()
        };
    }

    // Slug-collision detection: two sources with the same slug but
    // different source paths would clobber each other under
    // build/compiler/import-context/<slug>.* — surface the conflict so
    // the user can rename or restructure rather than silently picking
    // one.
    let mut deduped: CapsuleSource[] = [];
    let mut seen_slugs: string[] = [];
    let mut seen_paths: string[] = [];
    let mut si: int = 0;
    loop {
        if si >= sources.length { break; }
        let candidate = sources[si];
        let mut duplicate: boolean = false;
        let mut sj: int = 0;
        loop {
            if sj >= seen_slugs.length { break; }
            if strings_equal(seen_slugs[sj], candidate.slug) {
                if !strings_equal(_cr_strip_leading_dot_slash(seen_paths[sj]), _cr_strip_leading_dot_slash(candidate.source_path)) {
                    print.err("capsule-resolver: slug collision for \""
                        + candidate.slug
                        + "\":\n  "
                        + seen_paths[sj]
                        + "\n  "
                        + candidate.source_path
                        + "\nrename one of the modules so each maps to a distinct slug.");
                    return ResolverDedupeResult {
                        sources: empty_sources,
                        has_collision: true,
                        capabilities_required: capabilities_required,
                        manifest_dep_specs: covered_specs,
                        workspace_root: workspace_root,
                        root_source_paths: empty_roots,
                        runtime_demand: runtime_demand_all()
                    };
                }
                // Same slug AND same path → exact duplicate, drop silently.
                duplicate = true;
                break;
            }
            sj += 1;
        }
        if !duplicate {
            seen_slugs.push(candidate.slug);
            seen_paths.push(candidate.source_path);
            deduped.push(candidate);
        }
        si += 1;
    }

    // Stage C2b2: fill in `ll_path` for each deduped source via
    // the per-capsule layout. Build the layout once from the
    // post-dedupe spec set so each (scope, name) pair is checked
    // at most once during routing. `ll_path` was emitted as `""`
    // at the construction sites; downstream callers (
    // `compile_capsule_modules`, `_clang_link_multi`) only ever
    // see the resolved value.
    let mut dep_specs: string[] = [];
    let mut ds: int = 0;
    loop {
        if ds >= deduped.length { break; }
        if deduped[ds].spec.length > 0 {
            dep_specs.push(deduped[ds].spec);
        }
        ds += 1;
    }
    let layout = capsule_artifact_layout_from_specs(dep_specs, consumer.scope, consumer.name);

    // For standalone relative-import sources outside a manifest owner, the
    // repository-agnostic fallback is a path-shaped identifier (e.g.
    // `/tmp/widget/src/util` for an absolute entry). That's
    // unsuitable as a tail under `<consumer>/ir/` (it'd start
    // with `/`). Strip the discovered `project_root` prefix so
    // the routed tail mirrors the source layout (e.g. `src/util`
    // → `build/capsules/<consumer>/ir/src/util.ll`). The
    // original slug stays in `cur.slug` for cache keying, symbol
    // mangling, and `.sfn-asm` staging — only the ll_path
    // computation sees the relativized form.
    let consumer_root_prefix = _cr_consumer_root_prefix(project_root, consumer);
    let mut resolved: CapsuleSource[] = [];
    let mut ri: int = 0;
    loop {
        if ri >= deduped.length { break; }
        let cur = deduped[ri];
        let routing_slug = _cr_routing_slug(cur, consumer_root_prefix);
        let ll = _cr_resolve_ll_path(routing_slug, layout);
        resolved.push(CapsuleSource {
            spec: cur.spec, source_path: cur.source_path, slug: cur.slug, ll_path: ll,
            // Provenance survives the ll_path rewrite — this pass only routes
            // output paths and must not launder where a source came from.
            origin: cur.origin
        });
        ri += 1;
    }

    // SFN-833: derive the reachability roots from the post-dedupe set.
    // A source is a root unless a dependency leg contributed its path —
    // see `dep_leg_paths` above for why the discrimination runs this way
    // round.
    let mut root_source_paths: string[] = [];
    let mut rp: int = 0;
    loop {
        if rp >= resolved.length { break; }
        let key = _cr_strip_leading_dot_slash(resolved[rp].source_path);
        if !_cr_string_array_contains(dep_leg_paths, key) {
            root_source_paths.push(key);
        }
        rp += 1;
    }

    // SFN-882: the demand scan reads the UNFILTERED set plus the entry paths.
    // Scanning the filtered closure would be circular — the closure depends on
    // which runtime roots are seeded, which depends on this answer.
    //
    // Skipped entirely when the consumer declares no `runtime_root`. That is
    // exactly the `sfn check` shape (the field's own comment at
    // `types.sfn:85-94` records the split: build/run/test-link set it, `check`
    // leaves it empty), and `check` neither links nor selects runtime sources,
    // so scanning for it would buy nothing. The guard is not a micro-
    // optimisation: `_cr_resolve_and_dedupe` is on the `sfn check` path, which
    // is rung 1 of the validation ladder and the inner development loop, and an
    // unconditional extra full read pass over every resolved source would tax
    // every `check` in the repo to serve a consumer that does not exist there.
    let mut demand_paths: string[] = [];
    if consumer.runtime_root.length > 0 && !consumer.retain_full_runtime {
        let mut dp: int = 0;
        loop {
            if dp >= resolved.length { break; }
            demand_paths.push(resolved[dp].source_path);
            dp += 1;
        }
        let mut ep: int = 0;
        loop {
            if ep >= entry_paths.length { break; }
            if !_cr_string_array_contains(demand_paths, entry_paths[ep]) {
                demand_paths.push(entry_paths[ep]);
            }
            ep += 1;
        }
    }
    let mut resolved_demand = runtime_demand_all();
    if consumer.runtime_root.length > 0 && !consumer.retain_full_runtime {
        resolved_demand = compute_runtime_demand(demand_paths, capabilities_required, project_full_runtime);
    }

    return ResolverDedupeResult {
        sources: resolved,
        has_collision: false,
        capabilities_required: capabilities_required,
        manifest_dep_specs: covered_specs,
        workspace_root: workspace_root,
        root_source_paths: root_source_paths,
        runtime_demand: resolved_demand
    };
}
