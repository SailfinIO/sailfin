// Check-only capsule preparation. Keeping this entry point outside the
// build resolver facade prevents `sfn check` from importing driver emission
// and LLVM lowering modules that it never executes.
import { BuildCacheConfig } from "../build_cache";
import { toml_get_entry } from "../toml_parser";
import { module_name_for_source } from "./identity";
import {
    _cr_dirname,
    _cr_import_context_root,
    _cr_path_join,
    discover_project_root
} from "./paths";
import { _cr_resolve_dedupe_filtered } from "./reachability";
import { _cr_srchash_path, _cr_stage_cache_hit, stage_capsule_imports } from "./staging";
import { CapsuleSource, CheckCapsuleResolution, ResolverConsumer } from "./types";

// A previously staged project entry is useful as a best-effort provider
// inventory for E0420 import suggestions. Never stage it on behalf of an
// unrelated check: entry diagnostics belong to checks that actually request
// the entry, and a broken entry must not turn a healthy-file check into a
// resolver setup failure.
fn _check_project_entry_artifact(entry_paths: string[], work_dir: string) -> string ![io] {
    if entry_paths.length == 0 { return ""; }
    let project_root = discover_project_root(_cr_dirname(entry_paths[0]));
    if project_root.length == 0 { return ""; }
    let manifest_path = _cr_path_join(project_root, "capsule.toml");
    if !fs.exists(manifest_path) { return ""; }
    let entry = toml_get_entry(fs.readFile(manifest_path));
    if entry.length == 0 { return ""; }
    let source_path = _cr_path_join(project_root, entry);
    if !fs.exists(source_path) { return ""; }
    let mut index: int = 0;
    loop {
        if index >= entry_paths.length { break; }
        if entry_paths[index] == source_path { return ""; }
        index += 1;
    }
    let slug = module_name_for_source(source_path);
    let context_root = _cr_import_context_root(work_dir);
    let artifact = context_root + "/" + slug + ".sfn-asm";
    let manifest = context_root + "/" + slug + ".layout-manifest";
    let srchash = _cr_srchash_path(context_root, slug);
    if _cr_stage_cache_hit(artifact, manifest, srchash, source_path) {
        return artifact;
    }
    return "";
}

// SFN-686: the deduped spec set the analyzer checks capsule imports against.
// Specs are recorded verbatim, NOT canonicalised: a manifest `[dependencies]`
// key is stored as written (`discovery.sfn`) and `_cr_capsule_spec_for_slug`
// (`relative.sfn`) returns a `WorkspaceMember.name` as written, and a capsule
// name may carry more than two segments. The analyzer matches an import
// against these by exact-or-submodule prefix rather than truncating either
// side, so a multi-segment capsule name resolves correctly.
fn _check_resolved_capsule_specs(sources: CapsuleSource[]) -> string[] {
    let mut out: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= sources.length { break; }
        let spec = sources[index].spec;
        index += 1;
        if spec.length == 0 { continue; }
        let mut seen: boolean = false;
        let mut j: int = 0;
        loop {
            if j >= out.length { break; }
            if out[j] == spec {
                seen = true;
                break;
            }
            j += 1;
        }
        if !seen { out.push(spec); }
    }
    return out;
}

fn prepare_project_capsules_for_check(entry_paths: string[], consumer: ResolverConsumer, sailfin_exe: string, work_dir: string, binary_dir: string) -> CheckCapsuleResolution ![io] {
    let empty_paths: string[] = [];
    let project_entry_artifact = _check_project_entry_artifact(entry_paths, work_dir);
    // SFN-894: the checked files are semantic roots. Stage only their complete
    // import closure, using the same fail-open verification as build; check's
    // empty runtime root correctly excludes modules needed only for linking.
    let resolved = _cr_resolve_dedupe_filtered(entry_paths, consumer, binary_dir);
    // E0407 (SFN-764) aborts here alongside a slug collision: both are
    // setup errors already reported at the manifest read, and continuing
    // past an unreadable manifest would analyze the capsule with no
    // declared surface — i.e. grant it everything.
    if resolved.has_collision || resolved.manifest_unreadable.length > 0 {
        return CheckCapsuleResolution {
            asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            capsule_count: 0,
            staging_failed: true,
            capabilities_required: resolved.capabilities_required,
            capabilities_declared: resolved.capabilities_declared,
            capabilities_dev_required: resolved.capabilities_dev_required,
            resolved_capsule_specs: empty_paths,
            capsule_specs_known: false
        };
    }
    // SFN-686: `capsule_specs_known` stays true here. Resolving nothing is a
    // real answer, not a missing pass: `sfn check` makes every analyzed file
    // an entry root of its own group (`check/engine.sfn` collects each file
    // into `entry_paths` and analyzes exactly those), so an empty source set
    // means no entry named a resolvable capsule spec, and there is no
    // legitimate capsule import left to flag. That invariant is load-bearing —
    // if a future incremental or LSP path ever analyzes a file outside its
    // group's `entry_paths`, this must become false or it mass-false-positives.
    if resolved.sources.length == 0 {
        let mut no_source_paths: string[] = [];
        if project_entry_artifact.length > 0 {
            no_source_paths.push(project_entry_artifact);
        }
        return CheckCapsuleResolution {
            asm_paths: no_source_paths,
            implicit_provider_asm_paths: empty_paths,
            capsule_count: 0,
            staging_failed: false,
            capabilities_required: resolved.capabilities_required,
            capabilities_declared: resolved.capabilities_declared,
            capabilities_dev_required: resolved.capabilities_dev_required,
            resolved_capsule_specs: empty_paths,
            capsule_specs_known: true
        };
    }

    // SFN-861: `sfn check` is already the fast rung — no LLVM IR, no
    // `clang`, no self-host — so the shared staging cache has no cold-
    // start cost here to amortise; this path does not participate in it.
    let disabled_cache: BuildCacheConfig = BuildCacheConfig {
        enabled: false,
        trace: false,
        clean: false,
        capsule_name: ""
    };
    let staged = stage_capsule_imports(resolved.sources, disabled_cache, sailfin_exe, work_dir);
    if !staged {
        print.err("capsule-resolver: failed to stage import-context for project capsules");
        return CheckCapsuleResolution {
            asm_paths: empty_paths,
            implicit_provider_asm_paths: empty_paths,
            capsule_count: 0,
            staging_failed: true,
            capabilities_required: resolved.capabilities_required,
            capabilities_declared: resolved.capabilities_declared,
            capabilities_dev_required: resolved.capabilities_dev_required,
            resolved_capsule_specs: empty_paths,
            capsule_specs_known: false
        };
    }

    let context_root = _cr_import_context_root(work_dir);
    let mut asm_paths: string[] = [];
    let mut project_entry_already_present: boolean = false;
    let mut index: int = 0;
    loop {
        if index >= resolved.sources.length { break; }
        let artifact = context_root + "/" + resolved.sources[index].slug
            + ".sfn-asm";
        if artifact == project_entry_artifact {
            project_entry_already_present = true;
        }
        asm_paths.push(artifact);
        index += 1;
    }
    if project_entry_artifact.length > 0 && !project_entry_already_present {
        asm_paths.push(project_entry_artifact);
    }
    let mut implicit_provider_asm_paths: string[] = [];
    let mut implicit_index: int = 0;
    loop {
        if implicit_index >= resolved.implicit_provider_slugs.length { break; }
        implicit_provider_asm_paths.push(context_root + "/" + resolved.implicit_provider_slugs[implicit_index]
            + ".sfn-asm");
        implicit_index += 1;
    }
    return CheckCapsuleResolution {
        asm_paths: asm_paths,
        implicit_provider_asm_paths: implicit_provider_asm_paths,
        capsule_count: resolved.sources.length as int,
        staging_failed: false,
        capabilities_required: resolved.capabilities_required,
        capabilities_declared: resolved.capabilities_declared,
        capabilities_dev_required: resolved.capabilities_dev_required,
        resolved_capsule_specs: _check_resolved_capsule_specs(resolved.sources),
        capsule_specs_known: true
    };
}

export { prepare_project_capsules_for_check };
