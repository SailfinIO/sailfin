// compiler/src/prelude_globals.sfn
//
// #812 — implicit-runtime resolution for the E0420 undefined-callee
// check. The runtime (`runtime/prelude.sfn` plus the `runtime/sfn/**`
// modules) is implicitly linked into every Sailfin binary, so its
// top-level `fn` / `let` / `extern fn` declarations (`monotonic_millis`,
// `strings_equal`, `number_to_string`, `substring_unchecked`, the
// `runtime_*_fn` lowering targets, the parser-synthesized
// `runtime_assert_fail_fn`, …) are callable without an explicit
// `import` and resolve at link time. Without those names in scope the
// E0420 walker would mistake a bare runtime call for an undefined
// function and break self-host, the test suite, and every example.
//
// This module owns the IO side (runtime-root resolution + source
// scanning); the pure declaration-name scanner lives in `prelude_scan`
// so unit tests can cover it without linking the externs below. The
// runtime SOURCE directory is located via `resolve_runtime_root` (the
// same exe-relative resolution the linker uses to find `prelude.o`), so
// the lookup is cwd-independent — integration/e2e tests run the compiler
// from scratch directories where a cwd-relative `runtime/` would miss.
import { prelude_global_names_from_source } from "sfn/analyzer/prelude_scan";

import { relocate_string_to_heap } from "./arena_relocate";
import { installed_payload_dir_for_exe } from "./install_root";
import { substring } from "./string_utils";

// Mirrors the runtime-root externs declared in `cli_main.sfn` (declared,
// not imported, because the seed's cross-module signature resolver does
// not hand back runtime-capsule `.sfn` signatures — see the note there).
// Extern signatures must be C-ABI types (`* u8`, per E0801); the result
// is cast to `string` for `fs` use exactly as `cli_main` does.
extern fn exe_path() -> *u8;

extern fn resolve_runtime_root(exe: *u8) -> *u8;

// Per-process memo of the runtime source scan. The corpus is immutable
// for the life of the process and the compiler never changes cwd, so the
// BFS walk in `load_prelude_global_names` is pure repeated work whenever
// a run checks more than one file — it cost ~8.02M `strnlen` calls per
// checked file with zero amortization (SFN-633;
// `docs/proposals/design-notes/sfn-628-strnlen-recovery-tax.md` §5.C
// measures that at 58% of front-end scan volume on a 7-file run).
//
// The memo is a heap-relocated `string` blob, NOT a `string[]` — that is
// the whole difficulty, and a `string[]` here is a use-after-free.
// `compile_to_llvm_file_with_module_imports` takes an arena mark
// (`main.sfn:855`) immediately BEFORE the first
// `load_prelude_global_names` call and rewinds to it at the end of the
// emit pass (`main.sfn:915-917`, phase-scoped reclamation, default-on).
// A `string[]` memo is arena-allocated after that mark, so the rewind
// reclaims its container and every later file in the same process reads a
// dangling pointer — the exact hazard `arena_relocate.sfn:6-13` records
// for SFEP-0043 ("after the rewind its metadata struct is gone, so any
// post-rewind indexing is a use-after-free"). It presents as an
// intermittent SIGSEGV during `sfn emit`, not as a build failure.
//
// So only a heap-backed scalar crosses the mark boundary: the names are
// joined before relocation and re-split per call. The split re-scans
// ~18 KB (1,119 names) in place of the ~940 KB of runtime source the memo
// avoids re-reading, so the win comfortably survives it.
//
// `_pg_scanned` is a boolean on purpose — do NOT collapse the guard into
// `_pg_runtime_blob.length > 0`. A non-scalar module global is emitted
// with a `null` initializer and its initializer deferred into
// `@sailfin_module_init__<module>` (`llvm/lowering/module_globals.sfn:293,324`),
// and #1386 plants the call to that init function only in a module's own
// `fn main` (`llvm/lowering/emission.sfn:447-456`). This module has no
// `fn main`, so the blob reads back `null` until its first assignment,
// while `.length` lowers to an unguarded `load` + `extractvalue`
// (`llvm/expression_lowering/native/core_member_lowering.sfn:848-864`).
// A boolean literal is const-initialized in the preamble instead
// (`module_globals.sfn:315-323`) and needs no init call, so it is safe to
// read before anything assigns it.
//
// The memo also holds ONLY the runtime-derived names, never the combined
// `helper_names ++ scanned` result. Every call site passes the same
// `runtime_helper_call_names()` today, so that is defence in depth rather
// than a live requirement — it keeps the uniformity from silently
// becoming load-bearing.
let mut _pg_scanned: boolean = false;

let mut _pg_runtime_blob: string = "";

// Newline-delimited round trip for the memo blob. Declaration names are
// identifiers, so a newline can never occur inside one.
fn _pg_join_names(names: string[]) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= names.length { break; }
        if i > 0 { out = out + "\n"; }
        out = out + names[i];
        i += 1;
    }
    return out;
}

fn _pg_split_names(blob: string) -> string[] {
    let mut out: string[] = [];
    let mut start: int = 0;
    let mut i: int = 0;
    loop {
        if i >= blob.length { break; }
        if substring(blob, i, i + 1) == "\n" {
            if i > start { out.push(substring(blob, start, i)); }
            start = i + 1;
        }
        i += 1;
    }
    if blob.length > start {
        out.push(substring(blob, start, blob.length));
    }
    return out;
}

fn _pg_join(dir: string, child: string) -> string {
    if dir.length == 0 { return child; }
    if substring(dir, dir.length - 1, dir.length) == "/" { return dir + child; }
    return dir + "/" + child;
}

// Scan every `*.sfn` under `runtime_dir/sfn` (BFS, depth-bounded —
// mirrors `_cr_collect_capsule_sources` in capsule_resolver.sfn, which
// notes the seed compiler is brittle around recursive accumulators) and
// append their top-level names to `names`.
fn _pg_scan_sfn_tree(runtime_dir: string, names: string[]) -> string[] ![io] {
    let mut out = names;
    let sfn_root = _pg_join(runtime_dir, "sfn");
    if !fs.exists(sfn_root) { return out; }
    let mut dir_queue: string[] = [sfn_root];
    let mut head: int = 0;
    let max_depth: int = 64;
    loop {
        if head >= dir_queue.length { break; }
        if head >= max_depth { break; }
        let dir = dir_queue[head];
        head += 1;
        if !fs.exists(dir) { continue; }
        let entries = fs.listDirectory(dir);
        let mut i: int = 0;
        loop {
            if i >= entries.length { break; }
            let entry = entries[i];
            i += 1;
            let full = _pg_join(dir, entry);
            if entry.length >= 4 {
                if substring(entry, entry.length - 4, entry.length) == ".sfn" {
                    let source = fs.readFile(full);
                    let module_names = prelude_global_names_from_source(source);
                    out = out.concat(module_names);
                    continue;
                }
            }
            // Anything without a `.sfn` suffix is a candidate subdir;
            // `listDirectory` on a file returns empty, so this is safe.
            let child_entries = fs.listDirectory(full);
            if child_entries.length > 0 { dir_queue.push(full); }
        }
    }
    return out;
}

// Locate the runtime SOURCE directory (the one containing `prelude.sfn`)
// cwd-independently, in the same precedence the CLI driver
// (`cli/entry.sfn`) uses for the runtime it links: the
// `SAILFIN_RUNTIME_ROOT` operator override, then the install-root pointer,
// then the exe-relative walk, then cwd-relative fallbacks for in-repo
// invocations. The two resolvers must agree or an installed compiler
// scans one runtime's prelude and links another's.
fn _pg_find_runtime_dir() -> string ![io] {
    let mut candidates: string[] = [];
    let override_root = env.get("SAILFIN_RUNTIME_ROOT");
    if override_root.length > 0 {
        candidates.push(override_root);
        candidates.push(_pg_join(override_root, "runtime"));
    }
    // A copied (non-symlinked) installed `sfn` has no `runtime/` anywhere
    // near its own directory; the installer's pointer names the version
    // directory that owns it. Ahead of the exe-relative walk because the
    // installer may also leave an adjacent `runtime/` mirror beside the copy
    // (SFN-1125), and the pointer is the one the driver anchors on; ahead of
    // the cwd-relative probes so an installed compiler run from an empty cwd
    // still sees the full prelude rather than degrading to `helper_names`
    // (SFN-1124).
    let exe_raw: *u8 = exe_path();
    let payload = installed_payload_dir_for_exe(exe_raw as string);
    if payload.length > 0 {
        candidates.push(_pg_join(payload, "runtime"));
    }
    let root_raw: *u8 = resolve_runtime_root(exe_raw);
    let root: string = root_raw as string;
    if root.length > 0 {
        candidates.push(root);
        candidates.push(_pg_join(root, "runtime"));
    }
    candidates.push("runtime");
    candidates.push("../runtime");
    candidates.push("../../runtime");
    let mut i: int = 0;
    loop {
        if i >= candidates.length { break; }
        let dir = candidates[i];
        i += 1;
        if dir.length == 0 { continue; }
        if fs.exists(_pg_join(dir, "prelude.sfn")) { return dir; }
    }
    return "";
}

// Names of every implicitly-available callable: the compiler-known
// runtime-helper builtins passed in by the caller (`helper_names` —
// `number_to_string`, `print`, the `runtime_*_fn` family, …) plus the
// prelude and `runtime/sfn/**` source declarations (available when the
// runtime source can be located; an installed compiler shipping only
// object files still gets the caller-supplied helper builtins).
//
// `helper_names` is supplied by the caller (main.sfn / tools/check.sfn,
// via `llvm/runtime_helpers.runtime_helper_call_names()`) rather than
// imported here on purpose: this module is imported by `main`, so a
// `prelude_globals → llvm/...` edge would invert the layering.
fn load_prelude_global_names(helper_names: string[]) -> string[] ![io] {
    if !_pg_scanned {
        let mut scanned: string[] = [];
        let runtime_dir = _pg_find_runtime_dir();
        if runtime_dir.length > 0 {
            let prelude_source = fs.readFile(_pg_join(runtime_dir, "prelude.sfn"));
            scanned = scanned.concat(prelude_global_names_from_source(prelude_source));
            scanned = _pg_scan_sfn_tree(runtime_dir, scanned);
        }
        // Relocate out of the arena before the phase rewind reclaims it.
        _pg_runtime_blob = relocate_string_to_heap(_pg_join_names(scanned));
        _pg_scanned = true;
    }
    return helper_names.concat(_pg_split_names(_pg_runtime_blob));
}
