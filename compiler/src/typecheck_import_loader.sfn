// compiler/src/typecheck_import_loader.sfn
//
// On-disk loader that turns staged `.sfn-asm` artifacts into the AST
// interface declarations the typechecker consumes via
// `typecheck_diagnostics_with_imports`.
//
// This module sits one layer above `typecheck_imports.sfn` (the pure
// converter — deliberately a leaf depending only on `ast` and
// `native_ir`). Adding the parser-and-I/O wiring here keeps the leaf
// module's diamond-import discipline intact: any future unit test that
// needs only the converters can import `typecheck_imports` without
// pulling the native-IR parser graph (which reaches `string_utils`)
// through a second path.
//
// Diamond rule for callers: `check/engine.sfn` is the only consumer in
// Track A2. Other callers should audit transitive import paths to
// `string_utils` before adopting — `sfn test` does not dedupe shared
// modules across import paths, so two reachable copies trigger
// duplicate-symbol cascades.
//
// Parse-failure handling: this loader uses
// `parse_native_artifact_for_import_context` (not the thinner
// `parse_native_interfaces_for_import` helper) so that diagnostics
// emitted by the native-IR parser propagate to the caller. A
// malformed `.sfn-asm` artifact produces zero interfaces *and*
// non-empty diagnostics — keeping these distinct from the "parsed
// fine, no interfaces declared" case prevents a silently-corrupt
// artifact from looking like a benign module that just happened to
// export only structs/functions.
import {
    ImportSymbolTable,
    append_implicit_function_signature_from_module,
    append_import_function_signature_from_module,
    empty_import_symbols
} from "sfn/analyzer/effect_imports";
import { ClosureSymbolSet } from "sfn/analyzer/import_resolution_check";
import { interfaces_from_native, structs_from_native } from "sfn/analyzer/typecheck_imports";
import { ImportedTypeAlias } from "sfn/analyzer/typecheck_imports";
import { bound_base_name } from "sfn/analyzer/typecheck_types/generic_bounds";
import {
    apply_type_substitution,
    build_type_substitution,
    parse_type_arguments
} from "sfn/analyzer/typecheck_types/interface_and_generics";
import { trim_text } from "sfn/analyzer/typecheck_types/text_utils";
import {
    ImplicitSymbol,
    LoweringDiagnostic,
    NativeBinding,
    NativeEnum,
    NativeFunction,
    NativeInterface,
    NativeStruct
} from "sfn/ir";
import { parse_fn_type_text } from "sfn/ir";
import {
    parse_native_artifact_for_import_context,
    parse_native_artifact_for_import_with_bindings,
    split_lines
} from "sfn/ir";
import {
    char_code_at,
    ends_with,
    starts_with,
    substring
} from "sfn/strings";
import {
    FieldDeclaration,
    FunctionSignature,
    MethodDeclaration,
    Parameter,
    Statement,
    TypeAnnotation,
    TypeParameter,
    parse_program
} from "sfn/syntax";

// Result of parsing a single `.sfn-asm` buffer. `diagnostics` is
// non-empty only when the native-IR parser flagged a real problem;
// callers should treat that case as a stale or corrupt artifact, not
// as an empty-but-valid module.
struct ArtifactInterfaceParse {
    interfaces: Statement[];
    function_effects: ImportSymbolTable;
    diags: LoweringDiagnostic[];
    structs: Statement[];
    aliases: Statement[];
}

// Result of loading a batch of `.sfn-asm` artifacts. The path lists
// partition the input cleanly:
//   - `missing_paths`: not on disk (resolver/staging out of sync).
//   - `parse_failure_paths`: existed but the native-IR parser
//      produced diagnostics — treat as corrupt/stale.
//   - `skipped_paths`: parsed fine and contributed neither interfaces
//      nor structs (benign — common for modules that export only fns).
//
// `function_effects` is the Phase E channel: an `ImportSymbolTable`
// aggregating the `effects` field on every `NativeFunction` declared
// across the loaded artifacts. The effect checker resolves caller
// `Call` expressions against this table so cross-module effect
// propagation lights up without re-parsing artifacts.
//
// `native_texts` is the raw `.sfn-asm` text for every artifact that
// existed on disk (i.e. NOT in `missing_paths`), in input-order. The
// `sfn test` resolver feeds these into
// `lower_to_llvm_lines_with_parsed_context_for_tests` so
// `apply_module_symbol_mangling` can resolve provider module names
// from the imported-text stream. Returning them alongside the parsed
// interfaces in a single result avoids re-reading every artifact a
// second time when both consumers want the same files (cli_test
// today; future consumers would benefit too).
struct ImportedInterfaceLoadResult {
    interfaces: Statement[];
    function_effects: ImportSymbolTable;
    missing_paths: string[];
    parse_failure_paths: string[];
    skipped_paths: string[];
    native_texts: string[];
    implicit_symbols: ImplicitSymbol[];
    implicit_diagnostics: string[];
    structs: Statement[];
    aliases: ImportedTypeAlias[];
}

struct ImplicitProviderSurfaceResult {
    symbols: ImplicitSymbol[];
    diagnostics: string[];
}

// Pure: parse a `.sfn-asm` text buffer and return its interface
// declarations, the cross-module function-effect table contributed
// by its top-level `NativeFunction` decls, and any diagnostics the
// native-IR parser produced.
fn interfaces_from_native_artifact(text: string) -> ArtifactInterfaceParse {
    let parsed = parse_native_artifact_for_import_context(text);
    let interfaces = interfaces_from_native(parsed.interfaces);
    let raw_aliases = _aliases_from_native_text(text);
    let structs = _expand_artifact_structs(structs_from_native(parsed.structs), raw_aliases, text);
    let aliases = _expand_artifact_aliases(raw_aliases);
    let mut function_effects = empty_import_symbols();
    let mut i: int = 0;
    loop {
        if i >= parsed.functions.length { break; }
        let function = parsed.functions[i];
        // Attested extern declarations carry effects across module boundaries
        // through the same artifact table as Sailfin function declarations.
        // Unattested externs retain their existing effect-free behavior.
        //
        // Note: this also means imported extern *symbols* are not
        // currently registered in the importing module's typecheck
        // symbol table. That is acceptable today because the
        // typechecker performs no call-site name resolution against
        // the symbol table — the table is duplicate-detection-only.
        // When call-site resolution lands (see runtime architecture
        // M1+), this loader needs a parallel `imported_externs`
        // channel keyed by `kind == "extern function"` (the value
        // chosen in `register_top_level_symbol`) so extern callers
        // imported from `runtime/sfn/platform/*.sfn` resolve
        // cross-module.
        if !function.is_extern || function.effects.length > 0 {
            // SFEP-0023 §4.2: carry a per-export `is_decorator` bit alongside
            // the effects so the decorator resolver can distinguish an imported
            // decorator from an ordinary imported function. The bit rides the
            // same `.sfn-asm` metadata channel — `NativeFunction.decorators`
            // already round-trips the `@decorator` marker — so no new artifact
            // plumbing is needed.
            let type_parameters = _artifact_callable_type_parameters(function.name, "", text);
            let visible_aliases = _aliases_outside_type_parameters(raw_aliases, type_parameters);
            function_effects = append_import_function_signature_from_module(function_effects, function.name, function.effects, _native_function_is_tier1_decorator(function), "", _expand_artifact_alias(function.return_type, visible_aliases), function.parameters.length, _native_function_required_arity(function), _expanded_native_parameter_types(function, visible_aliases), _type_parameter_names(type_parameters));
        }
        i += 1;
    }
    return ArtifactInterfaceParse {
        interfaces: interfaces,
        function_effects: function_effects,
        diags: parsed.diags,
        structs: structs,
        aliases: aliases
    };
}

fn _expand_artifact_alias_nested(type_text: string, aliases: Statement[], depth: int) -> string {
    if depth >= 16 { return trim_text(type_text); }
    let mut resolved = trim_text(type_text);
    if ends_with(resolved, "[]") {
        let element = trim_text(substring(resolved, 0, resolved.length - 2));
        if starts_with(element, "(") && ends_with(element, ")") {
            return "(" + _expand_artifact_alias_nested(substring(element, 1, element.length - 1), aliases, depth
                + 1)
                + ")[]";
        }
        let expanded_element = _expand_artifact_alias_nested(element, aliases, depth
            + 1);
        if starts_with(expanded_element, "*") {
            return "(" + expanded_element + ")[]";
        }
        return expanded_element + "[]";
    }
    let mut alias_depth: int = 0;
    loop {
        if alias_depth >= 16 { break; }
        let mut next: string = "";
        let mut i: int = 0;
        loop {
            if i >= aliases.length { break; }
            let declaration = aliases[i];
            if declaration.name == bound_base_name(resolved) {
                next = trim_text(apply_type_substitution(declaration.aliased_type.text, build_type_substitution(declaration.type_parameters, parse_type_arguments(resolved))));
                break;
            }
            i += 1;
        }
        if next.length == 0 || next == resolved { break; }
        resolved = next;
        alias_depth += 1;
    }
    let function_type = parse_fn_type_text(resolved);
    if function_type.ok {
        let mut text = "fn (";
        let mut i: int = 0;
        loop {
            if i >= function_type.param_types.length { break; }
            if i > 0 { text = text + ", "; }
            text = text + _expand_artifact_alias_nested(function_type.param_types[i], aliases, depth
                + 1);
            i += 1;
        }
        text = text + ")";
        if function_type.return_type.length > 0 {
            text = text + " -> " + _expand_artifact_alias_nested(function_type.return_type, aliases, depth
                + 1);
        }
        i = 0;
        if function_type.effects.length > 0 { text = text + " !["; }
        loop {
            if i >= function_type.effects.length { break; }
            if i > 0 { text = text + ", "; }
            text = text + function_type.effects[i];
            i += 1;
        }
        if function_type.effects.length > 0 { text = text + "]"; }
        return text;
    }
    if starts_with(resolved, "*") {
        let mut prefix = "*";
        let mut pointee = trim_text(substring(resolved, 1, resolved.length));
        if starts_with(pointee, "const ") {
            prefix = "*const ";
            pointee = trim_text(substring(pointee, 6, pointee.length));
        } else if starts_with(pointee, "mut ") {
            prefix = "*mut ";
            pointee = trim_text(substring(pointee, 4, pointee.length));
        }
        return prefix + _expand_artifact_alias_nested(pointee, aliases, depth
            + 1);
    }
    let arguments = parse_type_arguments(resolved);
    if arguments.length > 0 {
        let mut result = bound_base_name(resolved) + "<";
        let mut i: int = 0;
        loop {
            if i >= arguments.length { break; }
            if i > 0 { result = result + ", "; }
            result = result + _expand_artifact_alias_nested(arguments[i], aliases, depth
                + 1);
            i += 1;
        }
        return result + ">";
    }
    return resolved;
}

fn _expand_artifact_alias(type_text: string, aliases: Statement[]) -> string {
    return _expand_artifact_alias_nested(type_text, aliases, 0);
}

fn _aliases_outside_type_parameters(aliases: Statement[], parameters: TypeParameter[]) -> Statement[] {
    let mut visible: Statement[] = [];
    for declaration in aliases {
        let mut shadowed = false;
        for parameter in parameters {
            if declaration.name == parameter.name { shadowed = true; }
        }
        if !shadowed { visible.push(declaration); }
    }
    return visible;
}

// The native-IR parser keeps the base struct name but discards the generic
// header. Recover its parameter list from the same artifact text so field
// metadata can substitute a consumer's concrete type arguments.
fn _artifact_type_parameters(header: string) -> TypeParameter[] {
    let mut parameters: TypeParameter[] = [];
    for argument in parse_type_arguments(header) {
        let mut colon: int = -1;
        let mut i: int = 0;
        loop {
            if i >= argument.length { break; }
            if argument[i] == ":" {
                colon = i;
                break;
            }
            i += 1;
        }
        let mut name = trim_text(argument);
        if colon >= 0 {
            name = trim_text(substring(argument, 0, colon));
        }
        parameters.push(TypeParameter {
            name: name, bound: null, span: null
        });
    }
    return parameters;
}

fn _type_parameter_names(parameters: TypeParameter[]) -> string[] {
    let mut names: string[] = [];
    for parameter in parameters { names.push(parameter.name); }
    return names;
}

fn _artifact_struct_type_parameters(name: string, text: string) -> TypeParameter[] {
    for line in split_lines(text) {
        let header = trim_text(line);
        if starts_with(header, ".struct ") {
            let declaration = trim_text(substring(header, 8, header.length));
            if bound_base_name(declaration) == name {
                return _artifact_type_parameters(declaration);
            }
        }
    }
    return [];
}

fn _artifact_callable_type_parameters(name: string, owner: string, text: string) -> TypeParameter[] {
    let mut current_struct = "";
    for line in split_lines(text) {
        let header = trim_text(line);
        if starts_with(header, ".struct ") {
            current_struct = bound_base_name(trim_text(substring(header, 8, header.length)));
        } else if header == ".endstruct" { current_struct = ""; } else if (owner.length == 0
            && current_struct.length == 0
            && starts_with(header, ".fn "))
            || (owner.length > 0
            && current_struct == owner
            && starts_with(header, ".method ")) {
            let mut declaration = trim_text(substring(header, 4, header.length));
            if owner.length > 0 {
                declaration = trim_text(substring(header, 8, header.length));
            }
            if bound_base_name(declaration) == name {
                return _artifact_type_parameters(declaration);
            }
        }
    }
    return [];
}

fn _expand_artifact_aliases(aliases: Statement[]) -> Statement[] {
    let mut expanded: Statement[] = [];
    for declaration in aliases {
        let visible_aliases = _aliases_outside_type_parameters(aliases, declaration.type_parameters);
        expanded.push(Statement.TypeAliasDeclaration {
            name: declaration.name, name_span: declaration.name_span, type_parameters: declaration.type_parameters, aliased_type: TypeAnnotation {
                text: _expand_artifact_alias(declaration.aliased_type.text, visible_aliases)
            }, decorators: declaration.decorators
        });
    }
    return expanded;
}

fn _expanded_annotation(annotation: TypeAnnotation?, aliases: Statement[]) -> TypeAnnotation? {
    if annotation == null { return null; }
    return TypeAnnotation {
        text: _expand_artifact_alias(annotation.text, aliases)
    };
}

fn _expand_artifact_methods(methods: MethodDeclaration[], aliases: Statement[], owner: string, text: string) -> MethodDeclaration[] {
    let mut expanded: MethodDeclaration[] = [];
    for method in methods {
        let signature = method.signature;
        let type_parameters = _artifact_callable_type_parameters(signature.name, owner, text);
        let visible_aliases = _aliases_outside_type_parameters(aliases, type_parameters);
        let mut parameters: Parameter[] = [];
        for parameter in signature.parameters {
            parameters.push(Parameter {
                name: parameter.name, type_annotation: _expanded_annotation(parameter.type_annotation, visible_aliases), default_value: parameter.default_value, mutable: parameter.mutable, span: parameter.span
            });
        }
        expanded.push(MethodDeclaration {
            signature: FunctionSignature {
                name: signature.name, is_async: signature.is_async, parameters: parameters, return_type: _expanded_annotation(signature.return_type, visible_aliases), effects: signature.effects, type_parameters: type_parameters, name_span: signature.name_span
            }, body: method.body, decorators: method.decorators
        });
    }
    return expanded;
}

fn _expand_artifact_structs(structs: Statement[], aliases: Statement[], text: string) -> Statement[] {
    let mut expanded: Statement[] = [];
    for declaration in structs {
        let type_parameters = _artifact_struct_type_parameters(declaration.name, text);
        let visible_aliases = _aliases_outside_type_parameters(aliases, type_parameters);
        let mut fields: FieldDeclaration[] = [];
        for field in declaration.fields {
            fields.push(FieldDeclaration {
                name: field.name, type_annotation: TypeAnnotation {
                    text: _expand_artifact_alias(field.type_annotation.text, visible_aliases)
                }, mutable: field.mutable, name_span: field.name_span
            });
        }
        expanded.push(Statement.StructDeclaration {
            name: bound_base_name(declaration.name), name_span: declaration.name_span, type_parameters: type_parameters, implements_types: declaration.implements_types, fields: fields, methods: _expand_artifact_methods(declaration.methods, visible_aliases, declaration.name, text), decorators: declaration.decorators
        });
    }
    return expanded;
}

fn _expanded_native_parameter_types(function: NativeFunction, aliases: Statement[]) -> string[] {
    let mut types: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= function.parameters.length { break; }
        types.push(_expand_artifact_alias(function.parameters[i].type_annotation, aliases));
        i += 1;
    }
    return types;
}

// Native artifacts emit aliases as `.type Name = T` lines, but the import
// context parser does not retain them. Reparse only those declarations so
// the type checker can enforce pointer qualifiers across module boundaries.
fn _aliases_from_native_text(text: string) -> Statement[] {
    let lines = split_lines(text);
    let mut aliases: Statement[] = [];
    let mut i: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, ".type ") {
            let declaration = substring(line, 1, line.length) + ";";
            let parsed = parse_program(declaration);
            if parsed.statements.length == 1 {
                if parsed.statements[0].variant == "TypeAliasDeclaration" {
                    aliases.push(parsed.statements[0]);
                }
            }
        }
        i += 1;
    }
    return aliases;
}

// Smallest argument count a cross-module call may supply: the index of the
// first parameter declaring a default (SFN-812). `NativeParameter.
// default_value` round-trips through the artifact (`emit_native.sfn` writes
// `= <expr>`, `native_ir_utils_parse.sfn` reads it back), so a staged
// signature carries its defaults faithfully and a caller that omits one is
// not rejected.
fn _native_function_required_arity(function: NativeFunction) -> int {
    let mut index: int = 0;
    loop {
        if index >= function.parameters.length { break; }
        if function.parameters[index].default_value != null { return index; }
        index += 1;
    }
    return function.parameters.length;
}

fn _implicit_bool(value: boolean) -> string {
    if value { return "1"; }
    return "0";
}

fn _implicit_join(values: string[], separator: string) -> string {
    let mut out = "";
    let mut index: int = 0;
    loop {
        if index >= values.length { break; }
        if index > 0 { out = out + separator; }
        out = out + values[index];
        index += 1;
    }
    return out;
}

fn _implicit_function_signature(function: NativeFunction) -> string {
    let mut parameters: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= function.parameters.length { break; }
        let parameter = function.parameters[index];
        parameters.push(parameter.name + ":" + parameter.type_annotation + ":"
            + _implicit_bool(parameter.mutable)
            + ":"
            + _implicit_bool(parameter.default_value != null));
        index += 1;
    }
    return "fn|" + _implicit_bool(function.is_async) + "|" + _implicit_bool(function.is_extern)
        + "|"
        + _implicit_join(parameters, ",")
        + "|"
        + function.return_type
        + "|"
        + _implicit_join(function.effects, ",")
        + "|"
        + _implicit_join(function.decorators, ",");
}

fn _implicit_struct_signature(definition: NativeStruct) -> string {
    let mut fields: string[] = [];
    let mut methods: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= definition.fields.length { break; }
        let field = definition.fields[index];
        fields.push(field.name + ":" + field.type_annotation + ":"
            + _implicit_bool(field.mutable));
        index += 1;
    }
    index = 0;
    loop {
        if index >= definition.methods.length { break; }
        methods.push(definition.methods[index].name + ":"
            + _implicit_function_signature(definition.methods[index]));
        index += 1;
    }
    let mut layout_signature = "none";
    if definition.layout != null {
        let layout = definition.layout;
        let mut layout_fields: string[] = [];
        index = 0;
        loop {
            if index >= layout.fields.length { break; }
            let field = layout.fields[index];
            layout_fields.push(field.name + ":" + field.type_annotation + ":"
                + number_to_string(field.offset)
                + ":"
                + number_to_string(field.size)
                + ":"
                + number_to_string(field.align));
            index += 1;
        }
        layout_signature = number_to_string(layout.size) + ":"
            + number_to_string(layout.align)
            + ":"
            + _implicit_join(layout_fields, ",");
    }
    return "struct|" + _implicit_join(fields, ",") + "|" + _implicit_join(methods, ",")
        + "|"
        + _implicit_join(definition.implements, ",")
        + "|"
        + layout_signature;
}

fn _implicit_interface_signature(definition: NativeInterface) -> string {
    let mut signatures: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= definition.signatures.length { break; }
        let member = definition.signatures[index];
        let mut parameters: string[] = [];
        let mut parameter_index: int = 0;
        loop {
            if parameter_index >= member.parameters.length { break; }
            let parameter = member.parameters[parameter_index];
            parameters.push(parameter.name + ":" + parameter.type_annotation
                + ":"
                + _implicit_bool(parameter.mutable));
            parameter_index += 1;
        }
        signatures.push(member.name + ":" + _implicit_bool(member.is_async)
            + ":"
            + _implicit_join(member.type_parameters, ",")
            + ":"
            + _implicit_join(parameters, ",")
            + ":"
            + member.return_type
            + ":"
            + _implicit_join(member.effects, ","));
        index += 1;
    }
    return "interface|" + _implicit_join(definition.type_parameters, ",") + "|"
        + _implicit_join(signatures, ",");
}

fn _implicit_enum_signature(definition: NativeEnum) -> string {
    let mut variants: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= definition.variants.length { break; }
        let variant = definition.variants[index];
        let mut fields: string[] = [];
        let mut field_index: int = 0;
        loop {
            if field_index >= variant.fields.length { break; }
            let field = variant.fields[field_index];
            fields.push(field.name + ":" + field.type_annotation + ":"
                + _implicit_bool(field.mutable));
            field_index += 1;
        }
        variants.push(variant.name + ":" + _implicit_join(fields, ","));
        index += 1;
    }
    let mut layout_signature = "none";
    if definition.layout != null {
        let layout = definition.layout;
        let mut layout_variants: string[] = [];
        index = 0;
        loop {
            if index >= layout.variants.length { break; }
            let variant = layout.variants[index];
            let mut layout_fields: string[] = [];
            let mut field_index: int = 0;
            loop {
                if field_index >= variant.fields.length { break; }
                let field = variant.fields[field_index];
                layout_fields.push(field.name + ":" + field.type_annotation
                    + ":"
                    + number_to_string(field.offset)
                    + ":"
                    + number_to_string(field.size)
                    + ":"
                    + number_to_string(field.align));
                field_index += 1;
            }
            layout_variants.push(variant.name + ":" + number_to_string(variant.tag)
                + ":"
                + number_to_string(variant.offset)
                + ":"
                + number_to_string(variant.size)
                + ":"
                + number_to_string(variant.align)
                + ":"
                + _implicit_join(layout_fields, ","));
            index += 1;
        }
        layout_signature = number_to_string(layout.size) + ":"
            + number_to_string(layout.align)
            + ":"
            + layout.tag_type
            + ":"
            + number_to_string(layout.tag_size)
            + ":"
            + number_to_string(layout.tag_align)
            + ":"
            + _implicit_join(layout_variants, ",");
    }
    return "enum|" + _implicit_join(definition.type_parameters, ",") + "|"
        + _implicit_join(variants, ",")
        + "|"
        + layout_signature;
}

fn _implicit_binding_signature(binding: NativeBinding) -> string {
    return "value|" + binding.type_annotation + "|" + _implicit_bool(binding.mutable)
        + "|"
        + _implicit_bool(binding.is_thread_local)
        + "|"
        + _implicit_bool(binding.is_extern);
}

fn _implicit_function_symbol(function: NativeFunction, provider_module: string) -> ImplicitSymbol {
    let mut parameter_types: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= function.parameters.length { break; }
        parameter_types.push(function.parameters[index].type_annotation);
        index += 1;
    }
    return ImplicitSymbol {
        name: function.name,
        kind: "function",
        provider_module: provider_module,
        signature: _implicit_function_signature(function),
        effects: function.effects,
        parameter_types: parameter_types,
        return_type: function.return_type,
        parameter_count: function.parameters.length,
        required_parameter_count: _native_function_required_arity(function),
        declared_type: "",
        is_async: function.is_async,
        is_generic: false,
        is_c_abi: function.is_extern
    };
}

fn _implicit_non_function_symbol(name: string, kind: string, provider_module: string, signature: string, declared_type: string = "") -> ImplicitSymbol {
    return ImplicitSymbol {
        name: name,
        kind: kind,
        provider_module: provider_module,
        signature: signature,
        effects: [],
        parameter_types: [],
        return_type: "",
        parameter_count: -1,
        required_parameter_count: -1,
        declared_type: declared_type,
        is_async: false,
        is_generic: false,
        is_c_abi: false
    };
}

fn _provider_module_from_native_text(text: string) -> string {
    let marker = ".module ";
    let marker_at = _find_text(text, marker);
    if marker_at < 0 { return ""; }
    let start = marker_at + marker.length;
    let mut end = start;
    loop {
        if end >= text.length { break; }
        let ch = substring(text, end, end + 1);
        if ch == "\n" || ch == "\r" { break; }
        end += 1;
    }
    return substring(text, start, end);
}

fn _implicit_symbol_key(symbol: ImplicitSymbol) -> string {
    return symbol.name + "\n" + symbol.provider_module + "\n" + symbol.kind
        + "\n"
        + symbol.signature;
}

fn _implicit_text_lt(left: string, right: string) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= left.length || index >= right.length { break; }
        let left_code = char_code_at(left, index);
        let right_code = char_code_at(right, index);
        if left_code < right_code { return true; }
        if left_code > right_code { return false; }
        index += 1;
    }
    return left.length < right.length;
}

fn _sort_implicit_symbols(input: ImplicitSymbol[]) -> ImplicitSymbol[] {
    let mut out: ImplicitSymbol[] = [];
    let mut copy_index: int = 0;
    loop {
        if copy_index >= input.length { break; }
        out.push(input[copy_index]);
        copy_index += 1;
    }
    let mut index: int = 1;
    loop {
        if index >= out.length { break; }
        let current = out[index];
        let current_key = _implicit_symbol_key(current);
        let mut prior = index - 1;
        loop {
            if prior < 0 { break; }
            if !_implicit_text_lt(current_key, _implicit_symbol_key(out[prior])) {
                break;
            }
            out[prior + 1] = out[prior];
            prior -= 1;
        }
        out[prior + 1] = current;
        index += 1;
    }
    return out;
}

fn implicit_provider_surface_from_native_texts(texts: string[]) -> ImplicitProviderSurfaceResult {
    let mut collected: ImplicitSymbol[] = [];
    let mut diagnostics: string[] = [];
    let mut text_index: int = 0;
    loop {
        if text_index >= texts.length { break; }
        let text = texts[text_index];
        let provider_module = _provider_module_from_native_text(text);
        if provider_module.length == 0 {
            diagnostics.push("implicit provider interface: staged artifact is missing canonical .module identity");
            text_index += 1;
            continue;
        }
        let parsed = parse_native_artifact_for_import_with_bindings(text);
        let mut index: int = 0;
        loop {
            if index >= parsed.functions.length { break; }
            collected.push(_implicit_function_symbol(parsed.functions[index], provider_module));
            index += 1;
        }
        index = 0;
        loop {
            if index >= parsed.structs.length { break; }
            let definition = parsed.structs[index];
            collected.push(_implicit_non_function_symbol(definition.name, "struct", provider_module, _implicit_struct_signature(definition), definition.name));
            index += 1;
        }
        index = 0;
        loop {
            if index >= parsed.enums.length { break; }
            let definition = parsed.enums[index];
            collected.push(_implicit_non_function_symbol(definition.name, "enum", provider_module, _implicit_enum_signature(definition), definition.name));
            index += 1;
        }
        index = 0;
        loop {
            if index >= parsed.interfaces.length { break; }
            let definition = parsed.interfaces[index];
            collected.push(_implicit_non_function_symbol(definition.name, "interface", provider_module, _implicit_interface_signature(definition), definition.name));
            index += 1;
        }
        index = 0;
        loop {
            if index >= parsed.bindings.length { break; }
            let binding = parsed.bindings[index];
            collected.push(_implicit_non_function_symbol(binding.name, "value", provider_module, _implicit_binding_signature(binding), binding.type_annotation));
            index += 1;
        }
        text_index += 1;
    }

    let sorted = _sort_implicit_symbols(collected);
    let mut symbols: ImplicitSymbol[] = [];
    let mut index: int = 0;
    loop {
        if index >= sorted.length { break; }
        let symbol = sorted[index];
        if symbols.length > 0 {
            let previous = symbols[symbols.length - 1];
            if previous.name == symbol.name {
                if previous.provider_module == symbol.provider_module
                    && previous.kind == symbol.kind
                    && previous.signature == symbol.signature {
                    index += 1;
                    continue;
                }
                diagnostics.push("implicit provider interface: incompatible duplicate declaration `"
                    + symbol.name
                    + "` from `"
                    + previous.provider_module
                    + "` and `"
                    + symbol.provider_module
                    + "`");
                index += 1;
                continue;
            }
        }
        symbols.push(symbol);
        index += 1;
    }
    return ImplicitProviderSurfaceResult {
        symbols: symbols,
        diagnostics: diagnostics
    };
}

// SFEP-0023 §4.1/§4.2: a staged export is a well-formed Tier 1 decorator
// when it carries the `@decorator` marker *and* matches the entry-hook
// contract shape `(string[], string) -> void` (args then function-name
// descriptor). A `@decorator`-marked function with the wrong shape is not
// treated as a decorator here — at the use site it then resolves as
// "imported but not a decorator" (E0701) rather than silently accepting a
// mis-typed hook. The marker round-trips through `NativeFunction.decorators`
// as the bare name `"decorator"` (`.decorator @decorator`), and the native
// parameter/return types are raw source-text strings, so the shape check is
// a whitespace-insensitive string compare.
fn _native_function_is_tier1_decorator(function: NativeFunction) -> boolean {
    if !_decorators_contain_marker(function.decorators) { return false; }
    if function.parameters.length != 2 { return false; }
    if _strip_spaces(function.parameters[0].type_annotation) != "string[]" {
        return false;
    }
    if _strip_spaces(function.parameters[1].type_annotation) != "string" {
        return false;
    }
    if _strip_spaces(function.return_type) != "void" { return false; }
    return true;
}

fn _decorators_contain_marker(decorators: string[]) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= decorators.length { break; }
        if decorators[index] == "decorator" { return true; }
        index += 1;
    }
    return false;
}

fn _strip_spaces(text: string) -> string {
    let mut out: string = "";
    let mut index: int = 0;
    loop {
        if index >= text.length { break; }
        let ch = text[index];
        if ch != " " { out = out + ch; }
        index += 1;
    }
    return out;
}

// #1953: the set of every symbol name defined anywhere in `sfn check`'s
// staged import closure, for the import-resolution pass's non-exported-
// symbol check (E0431). Sailfin resolves imported symbols GLOBALLY by name
// — a module may legally `import { X } from "./a"` even when `X` is
// actually declared in `./b`, because the linker resolves `X` across the
// whole program, not per-declaring-module (the compiler's own tree relies
// on this). So the honest check that matches the language is "is this
// imported name defined SOMEWHERE in the closure", not "does this exact
// module export it". `names` is the union of every top-level name every
// staged artifact declares — functions (incl. externs), structs,
// interfaces, enums, bindings — plus every `.import`/`.export` specifier
// name and alias (names re-exported through a barrel). `complete` is false
// when any artifact is missing or failed to parse: the union is then a
// subset of the real closure surface, so the check pass skips E0431
// entirely rather than risk a false positive on a name defined in the
// unreadable artifact. Over-accepting is a deliberate false-negative bias
// — it can only make E0431 more permissive, never false-positive on valid
// code.
fn build_closure_symbol_set(asm_paths: string[]) -> ClosureSymbolSet ![io] {
    let mut names: string[] = [];
    let mut complete: boolean = true;
    let mut i: int = 0;
    loop {
        if i >= asm_paths.length { break; }
        let asm = asm_paths[i];
        if !fs.exists(asm) {
            complete = false;
            i += 1;
            continue;
        }
        let text = fs.readFile(asm);
        let parsed = parse_native_artifact_for_import_context(text);
        if parsed.diags.length > 0 {
            complete = false;
            i += 1;
            continue;
        }
        let mut fi: int = 0;
        loop {
            if fi >= parsed.functions.length { break; }
            names.push(parsed.functions[fi].name);
            fi += 1;
        }
        let mut si: int = 0;
        loop {
            if si >= parsed.structs.length { break; }
            names.push(parsed.structs[si].name);
            si += 1;
        }
        let mut ii: int = 0;
        loop {
            if ii >= parsed.interfaces.length { break; }
            names.push(parsed.interfaces[ii].name);
            ii += 1;
        }
        let mut ei: int = 0;
        loop {
            if ei >= parsed.enums.length { break; }
            names.push(parsed.enums[ei].name);
            ei += 1;
        }
        let mut bi: int = 0;
        loop {
            if bi >= parsed.bindings.length { break; }
            names.push(parsed.bindings[bi].name);
            bi += 1;
        }
        // Every `.import`/`.export` specifier name a module carries is a
        // name reachable through that module (barrel re-exports pass
        // imported names straight through), so fold them into the global
        // set too. A wildcard-shaped re-export (`.export "src" { }` — empty
        // specifier list) cannot be enumerated; treat the closure as
        // incomplete so E0431 is skipped rather than false-firing.
        let mut ni: int = 0;
        loop {
            if ni >= parsed.imports.length { break; }
            let imp = parsed.imports[ni];
            if imp.kind == "export" {
                if imp.specifiers.length == 0 { complete = false; }
            }
            let mut spi: int = 0;
            loop {
                if spi >= imp.specifiers.length { break; }
                let spec = imp.specifiers[spi];
                names.push(spec.name);
                let alias = spec.alias;
                if alias != null {
                    let alias_str: string? = alias;
                    if alias_str.length > 0 { names.push(alias_str); }
                }
                spi += 1;
            }
            ni += 1;
        }
        i += 1;
    }
    return ClosureSymbolSet { names: names, complete: complete };
}

// Read each path, parse its artifact, and accumulate. Partitioning
// follows the `ImportedInterfaceLoadResult` contract: missing files
// surface in `missing_paths`, parse failures surface in
// `parse_failure_paths`, and successfully-parsed artifacts that
// contributed neither interfaces nor struct declarations surface in
// `skipped_paths` (SFN-1161 added the struct half — an artifact carrying
// only structs is a real contribution and is no longer reported skipped).
// No condition aborts the load — `sfn check` should always run
// analysis; the partitioning lets the CLI decide which slices warrant
// a warning.
fn _interface_path_contains(paths: string[], target: string) -> boolean {
    let mut index: int = 0;
    loop {
        if index >= paths.length { break; }
        if paths[index] == target { return true; }
        index += 1;
    }
    return false;
}

fn load_imported_interfaces_with_implicit_paths(paths: string[], implicit_paths: string[]) -> ImportedInterfaceLoadResult ![io] {
    let mut interfaces: Statement[] = [];
    let mut structs: Statement[] = [];
    let mut aliases: ImportedTypeAlias[] = [];
    let mut function_effects = empty_import_symbols();
    let mut missing: string[] = [];
    let mut parse_failures: string[] = [];
    let mut skipped: string[] = [];
    let mut native_texts: string[] = [];
    let mut implicit_texts: string[] = [];
    let mut ordered_paths: string[] = [];
    let mut order_index: int = 0;
    loop {
        if order_index >= implicit_paths.length { break; }
        if !_interface_path_contains(ordered_paths, implicit_paths[order_index]) {
            ordered_paths.push(implicit_paths[order_index]);
        }
        order_index += 1;
    }
    order_index = 0;
    loop {
        if order_index >= paths.length { break; }
        if !_interface_path_contains(ordered_paths, paths[order_index]) {
            ordered_paths.push(paths[order_index]);
        }
        order_index += 1;
    }

    let mut i: int = 0;
    loop {
        if i >= ordered_paths.length { break; }
        let path = ordered_paths[i];
        if !fs.exists(path) {
            missing.push(path);
            i += 1;
            continue;
        }
        // Single read per artifact. `text` flows into both the
        // interface-parse path AND the returned `native_texts` array
        // so consumers (today: `sfn test`, which feeds
        // `apply_module_symbol_mangling`) avoid a second
        // `fs.readFile` round trip per dependency.
        let text = fs.readFile(path);
        native_texts.push(text);
        let is_implicit = _interface_path_contains(implicit_paths, path);
        if is_implicit { implicit_texts.push(text); }
        let parsed = interfaces_from_native_artifact(text);
        if parsed.diags.length > 0 {
            parse_failures.push(path);
            i += 1;
            continue;
        }
        // Phase E: merge this artifact's exported function-effects
        // into the per-batch table, regardless of whether the
        // artifact also declared interfaces. A module that exports
        // only standalone fns is `skipped` for interface purposes
        // but still contributes effect entries for cross-module
        // propagation.
        let mut k: int = 0;
        loop {
            if k >= parsed.function_effects.functions.length { break; }
            let entry = parsed.function_effects.functions[k];
            // Preserve the SFEP-0023 §4.2 `is_decorator` bit across the
            // per-batch merge — a plain `append_import_function` would reset
            // it to false, defeating the metadata channel before it reaches
            // `localize_import_symbols_for_program`.
            if is_implicit {
                function_effects = append_implicit_function_signature_from_module(function_effects, entry.name, entry.effects, _provider_module_from_native_text(text), entry.return_type, entry.parameter_count, entry.required_parameter_count, entry.parameter_types, entry.type_parameters);
            } else {
                function_effects = append_import_function_signature_from_module(function_effects, entry.name, entry.effects, entry.is_decorator, _provider_module_from_artifact_path(path), entry.return_type, entry.parameter_count, entry.required_parameter_count, entry.parameter_types, entry.type_parameters);
            }
            k += 1;
        }
        if parsed.interfaces.length == 0 && parsed.structs.length == 0 && parsed.aliases.length == 0 {
            skipped.push(path);
        } else {
            let mut j: int = 0;
            loop {
                if j >= parsed.interfaces.length { break; }
                interfaces.push(parsed.interfaces[j]);
                j += 1;
            }
            let mut m: int = 0;
            loop {
                if m >= parsed.structs.length { break; }
                structs.push(parsed.structs[m]);
                aliases.push(ImportedTypeAlias {
                    declaration: parsed.structs[m], provider_module: _provider_module_from_artifact_path(path)
                });
                m += 1;
            }
            m = 0;
            loop {
                if m >= parsed.aliases.length { break; }
                aliases.push(ImportedTypeAlias {
                    declaration: parsed.aliases[m], provider_module: _provider_module_from_artifact_path(path)
                });
                m += 1;
            }
        }
        i += 1;
    }

    let implicit_surface = implicit_provider_surface_from_native_texts(implicit_texts);
    return ImportedInterfaceLoadResult {
        interfaces: interfaces,
        function_effects: function_effects,
        missing_paths: missing,
        parse_failure_paths: parse_failures,
        skipped_paths: skipped,
        native_texts: native_texts,
        implicit_symbols: implicit_surface.symbols,
        implicit_diagnostics: implicit_surface.diagnostics,
        structs: structs,
        aliases: aliases
    };
}

fn load_imported_interfaces_from_paths(paths: string[]) -> ImportedInterfaceLoadResult ![io] {
    let empty_implicit: string[] = [];
    return load_imported_interfaces_with_implicit_paths(paths, empty_implicit);
}

// Import-context paths end in `<logical-module>.sfn-asm`; preserving that
// suffix-free tail gives unresolved-call diagnostics an actionable import
// target without coupling semantic analysis to the resolver's source graph.
fn _provider_module_from_artifact_path(path: string) -> string {
    let marker = "/import-context/";
    let mut start: int = 0;
    let marker_at = _find_text(path, marker);
    if marker_at >= 0 { start = marker_at + marker.length; }
    let mut end = path.length;
    let suffix = ".sfn-asm";
    if end >= suffix.length {
        if substring(path, end - suffix.length, end) == suffix {
            end -= suffix.length;
        }
    }
    return substring(path, start, end);
}

fn _find_text(text: string, needle: string) -> int {
    if needle.length == 0 { return 0; }
    let mut i: int = 0;
    loop {
        if i + needle.length > text.length { break; }
        if substring(text, i, i + needle.length) == needle { return i; }
        i += 1;
    }
    return -1;
}

// Backwards-compat shim. `load_imported_interfaces_from_paths` now
// returns `native_texts` in its result so consumers can pull both
// shapes from a single read per artifact. Kept for any caller still
// reaching for the old name, but new callers should use the unified
// loader. Drop in a follow-up once the in-tree consumers migrate.
fn load_imported_native_texts_from_paths(paths: string[]) -> string[] ![io] {
    let load = load_imported_interfaces_from_paths(paths);
    return load.native_texts;
}

export {
    ArtifactInterfaceParse,
    ImportedInterfaceLoadResult,
    ImplicitProviderSurfaceResult,
    build_closure_symbol_set,
    interfaces_from_native_artifact,
    implicit_provider_surface_from_native_texts,
    load_imported_interfaces_from_paths,
    load_imported_interfaces_with_implicit_paths,
    load_imported_native_texts_from_paths
};
