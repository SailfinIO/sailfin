// compiler/src/tools/fmt/emitter.sfn
//
// Whitespace decisions and formatted source emission.
import { Token } from "sfn/syntax";

import { char_at, strings_equal } from "../../string_utils";
import { wraps_at_threshold } from "../fmt_rules";
import { _emit_indent, _is_top_level_decl } from "./tokens";
import { FmtToken } from "./types";

fn _measure_inline_block(fmt_tokens: FmtToken[], start: int) -> int {
    let mut depth = 0;
    let mut length = 0;
    let mut items = 1;
    let mut has_content = false;
    let mut semicolons = 0;
    let mut has_colon = false;
    let mut j = start;
    loop {
        if j >= fmt_tokens.length { return -1; }
        let ft = fmt_tokens[j];
        let role = ft.role;
        let lex = ft.token.lexeme;

        // Any leading comments on or inside the block → not inlineable
        if ft.leading_comments.length > 0 { return -1; }
        if ft.blank_lines_before > 0 { return -1; }
        // Trailing comments → not inlineable
        if ft.trailing_comment.length > 0 { return -1; }

        if strings_equal(role, "block_open") {
            if depth > 0 { return -1; }
            depth = 1;
            length = length + lex.length + 1;
            j += 1;
            continue;
        }
        if strings_equal(role, "block_close") {
            if depth == 1 {
                if !has_content { items = 0; }
                // Multi-statement code blocks (2+ semicolons) should not inline
                if semicolons > 1 { return -1; }
                // Blocks with both colons and semicolons are field declarations
                // (struct/enum), not code blocks — do not inline
                if has_colon {
                    if semicolons > 0 { return -1; }
                }
                length = length + 1 + lex.length;
                let encoded = length * 1000 + items;
                return encoded;
            }
            return -1;
        }

        has_content = true;
        if strings_equal(role, "separator") {
            // Don't count trailing comma (separator before block_close) as an item or length
            let is_trailing = false;
            if j + 1 < fmt_tokens.length {
                if strings_equal(fmt_tokens[j + 1].role, "block_close") {
                    is_trailing = true;
                }
            }
            if !is_trailing {
                items += 1;
                length = length + lex.length + 1;
            }
        } else if strings_equal(role, "colon") {
            has_colon = true;
            length = length + lex.length + 1;
        } else if strings_equal(role, "semicolon") {
            semicolons += 1;
            length = length + lex.length;
        } else {
            if j > start + 1 { length = length + 1; }
            length = length + lex.length;
        }
        j += 1;
    }
    return -1;
}

fn _is_inline_block_context(fmt_tokens: FmtToken[], block_open_idx: int) -> boolean {
    // A block is inlineable if it fits on one line. The measure function
    // rejects nested blocks, comments, blank lines, and multi-statement
    // blocks. Here we just check that the context is reasonable.
    if block_open_idx == 0 { return false; }
    let prev = fmt_tokens[block_open_idx - 1];
    // import { ... }
    if strings_equal(prev.token.lexeme, "import") { return true; }
    // export { ... }
    if strings_equal(prev.token.lexeme, "export") { return true; }
    // StructName { ... }  — value followed by {
    // BUT exclude struct/enum declarations: struct Foo { ... }
    if strings_equal(prev.role, "value") {
        if block_open_idx >= 2 {
            let prev2 = fmt_tokens[block_open_idx - 2];
            if strings_equal(prev2.token.lexeme, "struct") { return false; }
            if strings_equal(prev2.token.lexeme, "enum") { return false; }
            if strings_equal(prev2.token.lexeme, "interface") { return false; }
        }
        return true;
    }
    // Type parameter close: GenericStruct<T> { ... }
    if strings_equal(prev.role, "bracket_close") { return true; }
    // After closing paren: if cond() { ... }, fn foo() { ... }
    if strings_equal(prev.role, "paren_close") { return true; }
    // After keywords: else { ... }, loop { ... }, try { ... }, catch { ... }
    // BUT exclude struct/enum/interface keyword followed by name followed by {
    if strings_equal(prev.role, "keyword") {
        if strings_equal(prev.token.lexeme, "struct") { return false; }
        if strings_equal(prev.token.lexeme, "enum") { return false; }
        if strings_equal(prev.token.lexeme, "interface") { return false; }
        return true;
    }
    // Match arms: Pattern => { body; }
    if strings_equal(prev.role, "arrow") { return true; }
    return false;
}

fn _needs_newline_before(role: string, prev_role: string, lexeme: string, prev_lexeme: string) -> boolean {
    // Close brace always on its own line (unless empty block)
    if strings_equal(role, "block_close") {
        if strings_equal(prev_role, "block_open") { return false; }
        return true;
    }
    // After semicolon or open brace → new line
    if strings_equal(prev_role, "semicolon") { return true; }
    if strings_equal(prev_role, "block_open") {
        if strings_equal(role, "block_close") { return false; }
        return true;
    }
    if strings_equal(prev_role, "block_close") {
        // Tokens that attach to the closing brace (stay on same line)
        if strings_equal(role, "separator") { return false; }
        if strings_equal(role, "semicolon") { return false; }
        if strings_equal(role, "arrow") { return false; }
        if strings_equal(role, "dot") { return false; }
        if strings_equal(role, "paren_close") { return false; }
        if strings_equal(role, "bracket_close") { return false; }
        if strings_equal(lexeme, "else") { return false; }
        if strings_equal(lexeme, "catch") { return false; }
        if strings_equal(lexeme, "from") { return false; }
        if strings_equal(lexeme, "as") { return false; }
        // Everything else (new statement/declaration) → new line
        return true;
    }
    return false;
}

fn _needs_space_before(role: string, prev_role: string, lexeme: string, prev_lexeme: string) -> boolean {
    // No space at start of output
    if strings_equal(prev_role, "") { return false; }

    // No space after unary operator (!, -)
    if strings_equal(prev_role, "unary_op") { return false; }

    // Generic angle brackets: tight, no intra-bracket spacing.
    // `Box<int>` not `Box < int >`. The close `>` is a distinct role so
    // a following `=` is never fused into `>=`.
    if strings_equal(role, "generic_open") { return false; }
    if strings_equal(prev_role, "generic_open") { return false; }
    if strings_equal(role, "generic_close") { return false; }

    // Optional suffix ?: no space before
    if strings_equal(role, "optional_suffix") { return false; }

    // Compound assignment: operator followed by = (lexer splits += into + and =)
    if strings_equal(role, "assign") {
        if strings_equal(prev_role, "operator") { return false; }
    }

    // Dot: no space either side
    if strings_equal(role, "dot") { return false; }
    if strings_equal(prev_role, "dot") { return false; }

    // No space after open parens/brackets, no space before close
    if strings_equal(prev_role, "paren_open") { return false; }
    if strings_equal(prev_role, "bracket_open") { return false; }
    if strings_equal(role, "paren_close") { return false; }
    if strings_equal(role, "bracket_close") { return false; }

    // No space before separator/semicolon
    if strings_equal(role, "separator") { return false; }
    if strings_equal(role, "semicolon") { return false; }

    // Colon: no space before, space after
    if strings_equal(role, "colon") { return false; }

    // Function call: no space before (
    if strings_equal(role, "paren_open") {
        if strings_equal(prev_role, "value") { return false; }
        if strings_equal(prev_role, "paren_close") { return false; }
        if strings_equal(prev_role, "bracket_close") { return false; }
        if strings_equal(prev_role, "generic_close") { return false; }
    }

    // Index: no space before [
    if strings_equal(role, "bracket_open") {
        if strings_equal(prev_role, "value") { return false; }
        if strings_equal(prev_role, "paren_close") { return false; }
        if strings_equal(prev_role, "bracket_close") { return false; }
        if strings_equal(prev_role, "generic_close") { return false; }
    }

    // bang_bracket: space before, no space after !
    if strings_equal(role, "bang_bracket") { return true; }
    if strings_equal(prev_role, "bang_bracket") { return false; }

    // Decorator @: no space after
    if strings_equal(prev_role, "decorator") { return false; }

    // Range `..`: tight on both sides (`0..4`, not `0 .. 4`). Keyed on the
    // literal lexeme, not the shared "operator" role, so binary `+`/`-`/`*`/…
    // spacing is untouched.
    if strings_equal(lexeme, "..") { return false; }
    if strings_equal(prev_lexeme, "..") { return false; }

    return true;
}

fn _line_pos_from_end(out: string) -> int {
    let len = out.length;
    let mut pos = 0;
    let limit = 200;
    let mut si = len;
    loop {
        if si <= 0 { break; }
        if pos >= limit { break; }
        si -= 1;
        if strings_equal(char_at(out, si), "\n") { break; }
        pos += 1;
    }
    return pos;
}

// Stores `value` at `depth` in the delimiter-flag array, growing it as needed.
fn _set_delim_flag(flags: boolean[], depth: int, value: boolean) -> boolean[] {
    let mut out = flags;
    loop {
        if out.length > depth { break; }
        out.push(false);
    }
    out[depth] = value;
    return out;
}

// True when the innermost open delimiter is an expanded bracket literal.
// `depth` is the current `paren_depth`, so the innermost sits at `depth - 1`.
fn _innermost_expanded(flags: boolean[], depth: int) -> boolean {
    if depth <= 0 { return false; }
    if flags.length < depth { return false; }
    return flags[depth - 1];
}

// A bracket literal expands to one element per line when — and only when —
// it carries a comment. A `//` comment ends its line by definition, so the
// elements after it cannot share that line; emitting them flat leaves each
// continuation at the enclosing block's indent instead of the element's
// (SFN-763). Comment-free literals keep the flat form, so this never reflows
// existing source.
//
// Scans from the opening bracket to its match, tracking nesting so a comment
// inside a nested call or block still expands this literal — it has to, since
// that comment ends a line that lives inside these brackets.
fn _bracket_needs_expansion(fmt_tokens: FmtToken[], start: int) -> boolean {
    let mut depth = 0;
    let mut pos = start;
    loop {
        if pos >= fmt_tokens.length { return false; }
        let ft = fmt_tokens[pos];
        let role = ft.role;
        if pos > start {
            if ft.leading_comments.length > 0 { return true; }
        }
        if strings_equal(role, "bracket_open") { depth += 1; }
        if strings_equal(role, "paren_open") { depth += 1; }
        if strings_equal(role, "block_open") { depth += 1; }
        if strings_equal(role, "bracket_close") {
            depth -= 1;
            if depth == 0 { return false; }
        }
        if strings_equal(role, "paren_close") { depth -= 1; }
        if strings_equal(role, "block_close") { depth -= 1; }
        if ft.trailing_comment.length > 0 {
            if depth > 0 { return true; }
        }
        pos += 1;
    }
    return false;
}

// Render a token's trailing comments, one line each, returning the text to
// append. The caller sets `at_line_start` to true whenever `comments` is
// non-empty.
//
// Extracted so the trailing-comma skip path and the normal emit path cannot
// diverge. They did: the skip path `continue`d past this loop, so the comment
// attached to the comma it drops was deleted from the file outright, and
// because `fmt` is a fixed point `--check` then passed on the mangled result
// (SFN-1248).
//
// Every comment ends its own line. A `//` comment runs to end of line and
// Sailfin has no block-comment form, so ANY text emitted after one on the same
// line is swallowed into it — which makes the newline a correctness
// requirement, not layout.
//
// It used to be absent, and the only line-enders were a `semicolon` or a
// `separator` at `paren_depth == 0`. A trailing comment inside a call, an
// array literal, or a wrapped operator chain was therefore followed by the
// rest of the construct on the same line, collapsing
// `_sum(<nl> 1, // one<nl> 2,<nl>)` into `_sum(1,  // one 2,);` — which no
// longer parses, so `sfn fmt --write` silently destroyed source (SFN-1105).
//
// The loop rather than one newline afterwards matters for the second and later
// entries. A token collects more than one trailing comment only at EOF, where
// `strip_and_classify` folds leftover `pending_comments` onto the last token
// (`tokens.sfn`); concatenating those would fuse a run of trailing comment
// LINES into one, so every comment but the first would end up inside the
// first. No source destroyed, but a one-way collapse of the file's comments,
// and `fmt` is a fixed point so it would never come back.
//
// Neither caller gates this on `!in_inline`. The block inliner already refuses
// any construct carrying comments (`_measure_inline_block` returns -1 on a
// non-empty `trailing_comment`), so inline mode cannot reach either call site;
// and were that guard ever relaxed, breaking the line is still right, because
// losing the inline layout beats losing the code.
fn _emit_trailing_comments(comments: Token[], indent: int, at_line_start: boolean) -> string {
    let mut out = "";
    let mut line_start = at_line_start;
    let mut tci = 0;
    loop {
        if tci >= comments.length { break; }
        let tc = comments[tci];
        // The first comment trails the token it is attached to; any further
        // ones start their own line and need the block's indent, matching how
        // leading comments are emitted.
        if line_start { out = out + _emit_indent(indent); } else {
            out = out + "  ";
        }
        out = out + tc.lexeme + "\n";
        line_start = true;
        tci += 1;
    }
    return out;
}

fn emit_formatted(fmt_tokens: FmtToken[]) -> string {
    let mut out = "";
    let mut indent = 0;
    let mut prev_role = "";
    let mut prev_lexeme = "";
    let mut at_line_start = true;
    let mut paren_depth = 0;
    let mut inline_block_depth = 0;
    let mut inline_block_end = -1;
    let mut wrap_operators = false;
    // Per-delimiter-depth flag: true marks an expanded bracket literal
    // (SFN-763). Indexed by the depth `paren_depth` holds while that delimiter
    // is open, so it answers "is the innermost open delimiter an expanded
    // literal?".
    let mut delim_expanded: boolean[] = [];

    let mut i = 0;
    loop {
        if i >= fmt_tokens.length { break; }
        let ft = fmt_tokens[i];
        let role = ft.role;
        let lexeme = ft.token.lexeme;
        let in_inline = inline_block_depth > 0;
        // Set when this token is the `]` of an expanded literal (SFN-763).
        let mut force_close_nl = false;

        // ── Check if this block_open should be inlined ──
        if strings_equal(role, "block_open") {
            if !in_inline {
                if _is_inline_block_context(fmt_tokens, i) {
                    let measure = _measure_inline_block(fmt_tokens, i);
                    if measure >= 0 {
                        let line_len = measure / 1000;
                        let item_count = measure % 1000;
                        // Current line position (bounded scan, O(1))
                        let cur_line_pos = _line_pos_from_end(out);
                        if !wraps_at_threshold(item_count, cur_line_pos
                            + line_len) { inline_block_depth = 1; }
                    }
                }
            } else { inline_block_depth += 1; }
        }

        // ── Emit blank line ──
        if i > 0 {
            if !in_inline {
                // Suppress blank lines at block start (after {)
                let suppress_blank = false;
                if strings_equal(prev_role, "block_open") {
                    suppress_blank = true;
                }
                // Suppress blank lines at block end (before })
                if strings_equal(role, "block_close") { suppress_blank = true; }

                if ft.blank_lines_before > 0 {
                    if !suppress_blank {
                        if !at_line_start { out = out + "\n"; }
                        out = out + "\n";
                        at_line_start = true;
                    }
                } else {
                    // Inject blank line between top-level declarations at indent 0
                    if indent == 0 {
                        if _is_top_level_decl(lexeme) {
                            // Only if previous wasn't also at top level start or file start
                            if !strings_equal(prev_role, "") {
                                // Check if this is the first decl after imports
                                let need_blank = false;
                                if strings_equal(prev_role, "semicolon") {
                                    need_blank = true;
                                }
                                if strings_equal(prev_role, "block_close") {
                                    need_blank = true;
                                }
                                if need_blank {
                                    if !at_line_start { out = out + "\n"; }
                                    out = out + "\n";
                                    at_line_start = true;
                                }
                            }
                        }
                        // Also inject blank line before top-level decorators
                        if strings_equal(role, "decorator") {
                            if !strings_equal(prev_role, "") {
                                if strings_equal(prev_role, "semicolon") {
                                    if !at_line_start { out = out + "\n"; }
                                    out = out + "\n";
                                    at_line_start = true;
                                }
                                if strings_equal(prev_role, "block_close") {
                                    if !at_line_start { out = out + "\n"; }
                                    out = out + "\n";
                                    at_line_start = true;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Emit leading comments ──
        if !in_inline {
            let mut ci = 0;
            loop {
                if ci >= ft.leading_comments.length { break; }
                let comment = ft.leading_comments[ci];
                if !at_line_start { out = out + "\n"; }
                out = out + _emit_indent(indent) + comment.lexeme + "\n";
                at_line_start = true;
                ci += 1;
            }
        }

        // ── Adjust indent before closing tokens (skip in inline mode) ──
        if !in_inline {
            if strings_equal(role, "block_close") {
                indent -= 1;
                if indent < 0 { indent = 0; }
            }
        }
        if strings_equal(role, "paren_close") {
            paren_depth -= 1;
            if paren_depth < 0 { paren_depth = 0; }
        }
        if strings_equal(role, "bracket_close") {
            // A `]` with no matching `[` — `fmt` lexes but does not parse, so
            // malformed input reaches here — would clamp back to a slot an
            // earlier delimiter wrote and inherit its flag. Nothing clears a
            // slot, so that stale `true` would drop `indent` for the rest of
            // the file: the de-indent SFN-763 exists to stop.
            let had_open = paren_depth > 0;
            paren_depth -= 1;
            if paren_depth < 0 { paren_depth = 0; }
            // `paren_depth` now indexes the bracket being closed.
            if had_open {
                if !in_inline {
                    if delim_expanded.length > paren_depth {
                        if delim_expanded[paren_depth] {
                            indent -= 1;
                            if indent < 0 { indent = 0; }
                            force_close_nl = true;
                        }
                    }
                }
            }
        }
        if strings_equal(role, "generic_close") {
            // `>>` closes two nested generic levels in one token.
            if strings_equal(lexeme, ">>") { paren_depth -= 2; } else {
                paren_depth -= 1;
            }
            if paren_depth < 0 { paren_depth = 0; }
        }

        // ── Determine whitespace before token ──
        if in_inline {
            // In inline block: space-separated, no newlines
            if strings_equal(role, "block_open") {
                // Space before { in inline mode (e.g., "StructName {")
                if !at_line_start {
                    let needs_sp = _needs_space_before(role, prev_role, lexeme, prev_lexeme);
                    if needs_sp { out = out + " "; }
                }
            } else if strings_equal(role, "block_close") { out = out + " "; } else if strings_equal(role, "separator") {
                // No space before comma
            } else if strings_equal(role, "semicolon") {
                // No space before semicolon
            } else if strings_equal(role, "colon") {
                // No space before colon
            } else if strings_equal(role, "dot") {
                // No space around dot
            } else if strings_equal(prev_role, "dot") {
                // No space after dot
            } else if strings_equal(prev_role, "block_open") { out = out + " "; } else if strings_equal(prev_role, "separator") {
                out = out + " ";
            } else if strings_equal(prev_role, "colon") { out = out + " "; } else if strings_equal(prev_role, "unary_op") {
                // No space after unary operator
            } else {
                let needs_sp = _needs_space_before(role, prev_role, lexeme, prev_lexeme);
                if needs_sp { out = out + " "; }
            }
            at_line_start = false;
        } else {
            let mut needs_nl = _needs_newline_before(role, prev_role, lexeme, prev_lexeme);
            if force_close_nl { needs_nl = true; }
            if needs_nl {
                if !at_line_start { out = out + "\n"; }
                out = out + _emit_indent(indent);
                at_line_start = false;
            } else {
                if at_line_start {
                    if i > 0 { out = out + _emit_indent(indent); }
                    at_line_start = false;
                } else {
                    let needs_sp = _needs_space_before(role, prev_role, lexeme, prev_lexeme);
                    if needs_sp {
                        // Expression wrapping: break before binary operator when line gets long
                        let mut should_wrap = false;
                        if strings_equal(role, "operator") {
                            // Only wrap at chain-style operators, not arithmetic
                            let is_wrappable = false;
                            if strings_equal(lexeme, "+") {
                                is_wrappable = true;
                            }
                            if strings_equal(lexeme, "&&") {
                                is_wrappable = true;
                            }
                            if strings_equal(lexeme, "||") {
                                is_wrappable = true;
                            }
                            if is_wrappable {
                                if wrap_operators { should_wrap = true; } else {
                                    let cur_pos = _line_pos_from_end(out);
                                    let mut next_len = 0;
                                    if i + 1 < fmt_tokens.length {
                                        next_len = fmt_tokens[i + 1].token.lexeme.length;
                                    }
                                    if cur_pos + 1 + lexeme.length + 1
                                        + next_len > 80 { should_wrap = true; }
                                }
                            }
                        }
                        if should_wrap {
                            out = out + "\n" + _emit_indent(indent + 1);
                            wrap_operators = true;
                        } else { out = out + " "; }
                    }
                }
            }
        }

        // ── Skip trailing comma before closing delimiter ──
        // Strips trailing commas in single-line imports: { a, b, } → { a, b }
        if strings_equal(role, "separator") {
            if i + 1 < fmt_tokens.length {
                let next_role = fmt_tokens[i + 1].role;
                if strings_equal(next_role, "block_close") {
                    // Skip this comma — don't emit it. Its trailing comment is
                    // not the comma's to take with it: dropping both deleted
                    // the comment from the file, and `fmt` is a fixed point, so
                    // `--check` passed on the result immediately afterwards
                    // (SFN-1248). Re-emit it where the comma stood, turning
                    // `beta,  // c` into `beta  // c`.
                    //
                    // `indent` is still the inner block's — `block_close`
                    // de-indents on its own iteration, which has not run yet —
                    // so a second comment lines up with the block, as in the
                    // normal path. Not gated on `!in_inline`, for the reason
                    // `_emit_trailing_comments` documents.
                    out = out + _emit_trailing_comments(ft.trailing_comment, indent, at_line_start);
                    if ft.trailing_comment.length > 0 { at_line_start = true; }
                    prev_role = role;
                    prev_lexeme = lexeme;
                    i += 1;
                    continue;
                }
            }
        }

        // ── Emit the token ──
        out = out + lexeme;

        // ── Adjust indent after opening tokens (skip in inline mode) ──
        if inline_block_depth == 0 {
            if strings_equal(role, "block_open") { indent += 1; }
        }
        // Record, at this delimiter's own depth, whether it is an expanded
        // bracket literal — only `[` is ever expanded (SFN-763).
        if strings_equal(role, "paren_open") {
            delim_expanded = _set_delim_flag(delim_expanded, paren_depth, false);
            paren_depth += 1;
        }
        if strings_equal(role, "generic_open") {
            delim_expanded = _set_delim_flag(delim_expanded, paren_depth, false);
            paren_depth += 1;
        }
        if strings_equal(role, "bracket_open") {
            let mut want = false;
            if !in_inline {
                if _bracket_needs_expansion(fmt_tokens, i) { want = true; }
            }
            delim_expanded = _set_delim_flag(delim_expanded, paren_depth, want);
            paren_depth += 1;
            if want { indent += 1; }
        }

        // ── Track inline block exit ──
        if strings_equal(role, "block_close") {
            if inline_block_depth > 0 { inline_block_depth -= 1; }
        }

        // ── Emit trailing comments ──
        //
        // Rationale — why every comment must end its own line, and why one
        // newline per comment rather than one after the group — lives on
        // `_emit_trailing_comments`.
        out = out + _emit_trailing_comments(ft.trailing_comment, indent, at_line_start);
        if ft.trailing_comment.length > 0 { at_line_start = true; }

        // ── Emit newline after statement-ending tokens (not in inline mode) ──
        if !in_inline {
            if strings_equal(role, "semicolon") {
                if !at_line_start { out = out + "\n"; }
                at_line_start = true;
                wrap_operators = false;
            }

            // ── Newline after the `[` of an expanded literal ──
            if strings_equal(role, "bracket_open") {
                if _innermost_expanded(delim_expanded, paren_depth) {
                    if !at_line_start { out = out + "\n"; }
                    at_line_start = true;
                }
            }

            // ── Newline after comma at statement level ──
            if strings_equal(role, "separator") {
                if paren_depth == 0 {
                    if !at_line_start { out = out + "\n"; }
                    at_line_start = true;
                } else if _innermost_expanded(delim_expanded, paren_depth) {
                    // One element per line. A comma inside a nested call or
                    // generic keeps the flat form, because that `(` or `<` owns
                    // the innermost depth and is never expanded. A nested block
                    // pushes no frame, so its commas share the bracket's frame
                    // and do break — struct-literal fields inside an expanded
                    // literal go one per line, which is the wanted shape.
                    if !at_line_start { out = out + "\n"; }
                    at_line_start = true;
                }
            }
        }

        // Reset expression wrapping at block boundaries
        if strings_equal(role, "block_open") { wrap_operators = false; }
        if strings_equal(role, "block_close") { wrap_operators = false; }

        prev_role = role;
        prev_lexeme = lexeme;
        i += 1;
    }

    // Ensure file ends with exactly one newline
    if out.length > 0 {
        if !at_line_start { out = out + "\n"; }
    }

    return out;
}  // ═══════════════════════════════════════════════════════════════════  // Import sorting  // ═══════════════════════════════════════════════════════════════════  // An import statement is a contiguous range of FmtTokens from  // "import" to ";".  We collect these, extract the path, sort, and  // rebuild the token list.
