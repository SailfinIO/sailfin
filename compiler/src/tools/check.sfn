// compiler/src/tools/check.sfn
//
// Driver adapter for the pure analyzer facade. This module prepares
// authority-bearing check inputs (runtime globals, environment policy, and
// relative-module resolution), then converts diagnostic data into the legacy
// human-rendered `CheckResult` shape. Semantic analysis lives in
// `compiler/capsules/analyzer/src/analyzer.sfn`; JSON envelope rendering stays in
// `check/engine.sfn`.
import { AnalyzerInput, AnalyzerResult, analyze_program } from "sfn/analyzer";
import { ImportSymbolTable, empty_import_symbols } from "sfn/analyzer/effect_imports";
import { ClosureSymbolSet } from "sfn/analyzer/import_resolution_check";
import { Diagnostic, diagnostic_to_diag } from "sfn/analyzer/typecheck_types";
import { runtime_helper_call_names } from "sfn/codegen-llvm";
import { ImplicitSymbol, intrinsic_effect_table } from "sfn/ir";
import { int_to_string } from "sfn/strings";
import { Program, Statement } from "sfn/syntax";
import { parse_program } from "sfn/syntax";

import { resolve_import_context } from "../check/import_resolution";
import { render_diagnostic, split_source_lines } from "../diagnostics_render";
import { read_effect_enforcement_env, resolve_effect_enforcement } from "../effect_gate";
import { load_prelude_global_names } from "../prelude_globals";

struct CheckResult {
    file_path: string;
    diagnostics: Diagnostic[];
    producers: string[];
    rendered: string[];
    error_count: int;
    warning_count: int;
}

struct CheckSummary {
    files_checked: int;
    total_errors: int;
    total_warnings: int;
}

// `off` is a build-only escape hatch. Explicit `sfn check` continues to
// validate effects at the default severity, matching its historical contract.
fn effect_severity_for_check(file_path: string) -> string ![io] {
    let mut severity = resolve_effect_enforcement(read_effect_enforcement_env(file_path));
    if severity == "off" { severity = resolve_effect_enforcement(""); }
    return severity;
}

// Driver-side constructor for the facade contract. Parsed syntax and staged
// interfaces arrive from the caller; all remaining authority-bearing inputs
// are resolved here before the pure `analyze_program` call.
fn analyzer_input_for_check(program: Program, file_path: string, imported_interfaces: Statement[], imported_symbols: ImportSymbolTable, capabilities_required: string[], capabilities_declared: boolean, capabilities_dev_required: string[], closure_symbols: ClosureSymbolSet, allow_bare_assert: boolean, implicit_symbols: ImplicitSymbol[] = [], resolved_capsule_specs: string[] = [], capsule_specs_known: boolean = false) -> AnalyzerInput ![io] {
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    let import_context = resolve_import_context(program, file_path, closure_symbols, resolved_capsule_specs, capsule_specs_known);
    return AnalyzerInput {
        program: program,
        file_path: file_path,
        imported_interfaces: imported_interfaces,
        imported_symbols: imported_symbols,
        intrinsic_effects: intrinsic_effect_table(),
        prelude_globals: prelude_globals,
        capabilities_required: capabilities_required,
        capabilities_declared: capabilities_declared,
        capabilities_dev_required: capabilities_dev_required,
        import_context: import_context,
        allow_bare_assert: allow_bare_assert,
        effect_severity: effect_severity_for_check(file_path),
        implicit_symbols: implicit_symbols
    };
}

// Presentation adapter: semantic diagnostic data becomes the existing human
// rendering array without changing codes, ordering, messages, or counts.
fn check_result_from_analysis(result: AnalyzerResult, source: string) -> CheckResult {
    let source_lines = split_source_lines(source);
    let mut rendered: string[] = [];
    let mut index: int = 0;
    loop {
        if index >= result.diagnostics.length { break; }
        let producer = result.producers[index];
        rendered.push(render_diagnostic(diagnostic_to_diag(result.diagnostics[index], producer), source_lines, producer));
        index += 1;
    }
    return CheckResult {
        file_path: result.file_path,
        diagnostics: result.diagnostics,
        producers: result.producers,
        rendered: rendered,
        error_count: result.error_count,
        warning_count: result.warning_count
    };
}

fn check_source(source: string, file_path: string) -> CheckResult ![io] {
    let imported_interfaces: Statement[] = [];
    let capabilities_required: string[] = [];
    let closure_symbols = ClosureSymbolSet { names: [], complete: false };
    let capabilities_dev_required: string[] = [];
    return check_source_with_imports(source, file_path, imported_interfaces, empty_import_symbols(), capabilities_required, false, capabilities_dev_required, closure_symbols, false);
}

// Backwards-compatible source adapter retained for existing tool consumers.
// New analyzer-only consumers parse independently and call `analyze_program`
// with an `AnalyzerInput`, avoiding every driver/LLVM dependency in this file.
fn check_source_with_imports(source: string, file_path: string, imported_interfaces: Statement[], imported_symbols: ImportSymbolTable, capabilities_required: string[], capabilities_declared: boolean, capabilities_dev_required: string[], closure_symbols: ClosureSymbolSet, allow_bare_assert: boolean) -> CheckResult ![io] {
    let program = parse_program(source);
    let input = analyzer_input_for_check(program, file_path, imported_interfaces, imported_symbols, capabilities_required, capabilities_declared, capabilities_dev_required, closure_symbols, allow_bare_assert);
    return check_result_from_analysis(analyze_program(input), source);
}

fn check_file(path: string, inlined_source: string) -> CheckResult ![io] {
    return check_source(inlined_source, path);
}

fn render_summary(summary: CheckSummary) -> string {
    let files_str = int_to_string(summary.files_checked);
    if summary.total_errors == 0 {
        return "checked " + files_str + " files: ok";
    }
    let errors_str = int_to_string(summary.total_errors);
    let mut label: string = " errors";
    if summary.total_errors == 1 { label = " error"; }
    return "checked " + files_str + " files: " + errors_str + label;
}

fn summarize(results: CheckResult[]) -> CheckSummary {
    let mut total_errors: int = 0;
    let mut total_warnings: int = 0;
    let mut index: int = 0;
    loop {
        if index >= results.length { break; }
        total_errors += results[index].error_count;
        total_warnings += results[index].warning_count;
        index += 1;
    }
    return CheckSummary {
        files_checked: results.length as int,
        total_errors: total_errors,
        total_warnings: total_warnings
    };
}

export {
    CheckResult,
    CheckSummary,
    analyzer_input_for_check,
    check_file,
    check_result_from_analysis,
    check_source,
    check_source_with_imports,
    effect_severity_for_check,
    render_summary,
    summarize
};
