// Check/build staging subprocess adapter. It emits only native text and has
// no dependency on LLVM validation or the compiler's lowering entry module.
import { emit_child_argv } from "./build/emit_child_argv";
import { _atomic_rename_into_place, _mktemp_sibling_cmd } from "./build/fs";

fn stage_native_text_with_retry(sailfin_exe: string, module_name: string, source_path: string, out_path: string, max_attempts: int) -> boolean ![io] {
    let mut attempt: int = 0;
    loop {
        if attempt >= max_attempts { break; }
        attempt += 1;
        let staged = _mktemp_sibling_cmd(out_path);
        let mut emit_target = out_path;
        if staged.length > 0 { emit_target = staged; }
        let args: string[] = emit_child_argv(sailfin_exe, module_name, emit_target, "native", source_path, "");
        let mut ok = process.run(args) == 0;
        if ok {
            if !fs.exists(emit_target) { ok = false; }
        }
        if ok {
            if fs.readFile(emit_target).length == 0 { ok = false; }
        }
        if ok {
            if staged.length > 0 {
                ok = _atomic_rename_into_place(staged, out_path);
            }
            if ok { return true; }
        }
        if staged.length > 0 {
            if fs.exists(staged) { fs.deleteFile(staged); }
        }
    }
    return false;
}

export { stage_native_text_with_retry };
