// Phase-scoped arena reclamation (SFEP-0043). The arena mark/rewind pair
// snapshots and restores the arena bump pointer so the AST/typecheck/emit
// region can be reclaimed before lowering (LLVM IR) starts, reducing
// per-module peak RSS from front+back to ≈max(front,back). Declared here
// mirroring cli_main.sfn:59's `extern fn sfn_arena_telemetry_dump`. The
// Sailfin-native bodies live in runtime/sfn/memory/arena.sfn.
// f64 matches the double ABI (#1309 descriptor ABI: `() -> double` /
// `(double) -> void`).
extern fn sfn_arena_sfn_mark() -> f64;

extern fn sfn_arena_sfn_rewind(mark: f64) -> void;

fn _ms_since(start_ms: int) -> int {
    let end_ms = monotonic_millis();
    let delta = end_ms - start_ms;
    if delta < 0 { return 0; }
    return delta;
}

fn _timing_line(module_name: string, phase: string, elapsed_ms: int) -> string {
    // Format is stable and grep/awk-friendly.
    // Emitted to stderr via print.err by the caller.
    return "[timing] module=" + module_name + " phase=" + phase + " ms="
        + int_to_string(elapsed_ms);
}

fn _drain_llvm_lowering_traces() ![io] {
    let buffered = take_lowering_trace_buffer();
    if buffered.length > 0 { print.err(buffered); }
}

fn _print_fatal_lowering_diagnostics(diags: LoweringDiagnostic[]) ![io] {
    let lines = fatal_lowering_diagnostic_lines(diags);
    let mut index: int = 0;
    loop {
        if index >= lines.length { break; }
        print.err(lines[index]);
        index += 1;
    }
}

fn _load_llvm_import_context(native_text: string, module_name: string, context_root: string) -> ImportedModuleContext ![io] {
    if native_text.length == 0 {
        return ImportedModuleContext {
            manifests: [],
            native_texts: [],
            module_aliases: [],
            implicit_symbols: []
        };
    }
    let parsed = parse_native_artifact(native_text);
    return load_imported_module_context(parsed.imports, module_name, context_root);
}

fn _load_llvm_import_context_with_implicit(native_text: string, module_name: string, context_root: string, implicit_symbols: ImplicitSymbol[]) -> ImportedModuleContext ![io] {
    if native_text.length == 0 {
        return ImportedModuleContext {
            manifests: [],
            native_texts: [],
            module_aliases: [],
            implicit_symbols: implicit_symbols
        };
    }
    let parsed = parse_native_artifact(native_text);
    let mut context = load_imported_module_context_with_implicit(parsed.imports, module_name, context_root, implicit_symbols);
    context.implicit_symbols = implicit_symbols;
    return context;
}

fn _llvm_import_context_from_loaded_data(native_text: string, module_name: string, context_root: string, imported_manifests: LayoutManifest[], imported_native_texts: string[]) -> ImportedModuleContext ![io] {
    let parsed = parse_native_artifact(native_text);
    return imported_module_context_from_loaded_data(parsed.imports, module_name, context_root, imported_manifests, imported_native_texts);
}

fn _load_llvm_import_context_from_lines(native_lines: string[], module_name: string, context_root: string) -> ImportedModuleContext ![io] {
    let parsed = parse_native_artifact_from_lines(native_lines);
    return load_imported_module_context(parsed.imports, module_name, context_root);
}

// Refuse compilation when any `export { X };` in this module re-exports
// an imported symbol without a local definition.  Reports each violation
// via print.err and returns true if the caller should bail.  See
// docs/rca/2026-04-18-reexport-diagnostic-gep.md.
fn _reject_reexport_violations(program: Program) -> boolean ![io] {
    let violations = collect_reexport_violations(program);
    if violations.length == 0 { return false; }
    report_reexport_violations(violations);
    return true;
}

// Refuse compilation when the parser left any top-level `Statement.Unknown` in
// the program — either a malformed-but-dispatched declaration carrying a
// precise `E05xx` code (`fn broken( {`, `let x = ;`, `struct S { x: }`) or a
// genuinely unrecognized top-level construct. Reports each via print.err and
// returns true so the caller bails before lowering/linking. This turns the old
// "missing-main linker ICE" into a precise parse error and matches the E05xx
// `producer: parse` diagnostics `sfn check` surfaces for the same nodes
// (SFN-18).
fn _reject_parse_errors(program: Program) -> boolean ![io] {
    let mut found: boolean = false;
    let mut i: int = 0;
    loop {
        if i >= program.statements.length { break; }
        let stmt = program.statements[i];
        if stmt.variant == "Unknown" {
            if stmt.code.length > 0 {
                print.err("error[" + stmt.code + "]: " + stmt.message);
            } else {
                let mut near: string = "";
                if stmt.tokens.length > 0 {
                    near = " near `" + stmt.tokens[0].lexeme + "`";
                }
                print.err("error[E0500]: parse error: unrecognized syntax"
                    + near);
            }
            found = true;
        }
        i += 1;
    }
    return found;
}

// Print the `emit_native` diagnostic sidecar. Every entry is `note` severity,
// which SFEP-0061 §4 prints only under `SAILFIN_DEBUG_LOWERING` — so a default
// build's behaviour is unchanged. Matches the `[emit-native]` stderr prefix
// convention of `report_reexport_violations` (`diagnostics_render.sfn`).
// `file_path` is stamped in place before rendering: all five producers mint
// `file_path: ""` (the emitter has no idea which module is being compiled),
// so without this the renderer emits a bare `--> :3:5`. Same pattern and same
// reason as `_emit_typecheck_diagnostics` below.
fn _report_emit_native_diags(diags: Diag[], file_path: string) ![io] {
    if !_env_flag("SAILFIN_DEBUG_LOWERING") { return; }
    let mut stamp: int = 0;
    loop {
        if stamp >= diags.length { break; }
        diags[stamp].file_path = file_path;
        stamp += 1;
    }
    let lines = emit_native_diag_lines(diags);
    let mut index: int = 0;
    loop {
        if index >= lines.length { break; }
        print.err("[emit-native] " + lines[index]);
        index += 1;
    }
}

fn compile_to_sailfin(source: string) -> string ![io] {
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    if typecheck_has_errors_with_prelude(program, prelude_globals) {
        let diagnostics = typecheck_diagnostics_with_prelude(program, prelude_globals);
        _emit_typecheck_diagnostics(diagnostics, source, "main");
        return "";
    }
    if _reject_parse_errors(program) { return ""; }
    if _reject_reexport_violations(program) { return ""; }
    if validate_and_render_effects(program, source, "main", empty_import_symbols()) > 0 {
        return "";
    }
    // E4 ownership pass (#1213): dormant Phase R0 — builds and discards
    // per-binding ownership state after the effect gate. Always 0 today;
    // E5/E6 flip it to a real gate without re-plumbing call sites.
    if run_ownership_checker(program) > 0 { return ""; }
    return emit_program(program);
}

fn compile_to_llvm(source: string) -> string ![io] {
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    if typecheck_has_errors_with_prelude(program, prelude_globals) {
        let diagnostics = typecheck_diagnostics_with_prelude(program, prelude_globals);
        _emit_typecheck_diagnostics(diagnostics, source, "main");
        return "";
    }
    if _reject_parse_errors(program) { return ""; }
    if _reject_reexport_violations(program) { return ""; }
    if validate_and_render_effects(program, source, "main", empty_import_symbols()) > 0 {
        return "";
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    if run_ownership_checker(program) > 0 { return ""; }
    let trace_emit = _env_flag("SAILFIN_TRACE_EMIT") || _legacy_flag_file("build/sailfin/.trace_emit");
    let emitted = emit_native_lines_with_module_name(program, "main");
    _report_emit_native_diags(emitted.diags, "main");
    let native_text = lines_to_native_text(emitted.lines);
    if trace_emit {
        print.err("emit-llvm: native text bytes=" + int_to_string(native_text.length));
        if native_text.length > 0 {
            fs.writeFile("build/sailfin/debug-emit-native.sfn-asm", native_text);
            print.err("emit-llvm: wrote build/sailfin/debug-emit-native.sfn-asm");
        }
    }
    if native_text.length > 0 {
        let import_context = _load_llvm_import_context(native_text, "main", import_context_root(""));
        let ir = lower_to_llvm_ir_from_text_with_provider_context(native_text, "main", import_context, resolve_llvm_provider_context());
        _drain_llvm_lowering_traces();
        if trace_emit {
            print.err("emit-llvm: llvm bytes=" + int_to_string(ir.length));
            if ir.length > 0 {
                fs.writeFile("build/sailfin/debug-emit-llvm.ll", ir);
                print.err("emit-llvm: wrote build/sailfin/debug-emit-llvm.ll");
            }
        }
        return ir;
    }
    // No report here: the primary emit above already reported this program's
    // diagnostics, and re-emitting the same `Program` is deterministic — so a
    // second report would print a verbatim duplicate (SFN-608).
    //
    // The no-duplicate property is per entry point, not per build: a full
    // `sfn build` stages a `native` emit and then an `llvm` emit for the same
    // module (`capsule_resolver/staging.sfn`, `capsule_resolver/compile.sfn`),
    // and `emit_llvm_with_retry` re-runs on each attempt — so the same note
    // legitimately appears once per compile pass under the debug gate.
    let native_result = emit_native_with_module_name(program, "main");
    let fallback_text = native_result.module.artifacts[0].contents;
    let fallback_context = _load_llvm_import_context(fallback_text, "main", import_context_root(""));
    let ir = lower_to_llvm_ir_with_provider_context(native_result.module, fallback_context, resolve_llvm_provider_context());
    _drain_llvm_lowering_traces();
    if trace_emit {
        print.err("emit-llvm: llvm bytes=" + int_to_string(ir.length));
        if ir.length > 0 {
            fs.writeFile("build/sailfin/debug-emit-llvm.ll", ir);
            print.err("emit-llvm: wrote build/sailfin/debug-emit-llvm.ll");
        }
    }
    return ir;
}

// Compile source to LLVM IR and print it line-by-line to stdout.
// Returns true on success. Used by `sfn emit llvm <file>` (no -o flag) to
// avoid the large-string cross-module return in `compile_to_llvm_with_module`,
// which segfaulted on large modules like
// `compiler/capsules/ir/src/native_ir_api.sfn`
// when the big joined IR string was returned and then printed.
fn print_llvm_with_module(source: string, module_name: string) -> boolean ![io] {
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    let skip_typecheck = _env_flag("SAILFIN_SKIP_TYPECHECK")
        || _legacy_flag_file("build/sailfin/.skip_typecheck");
    if !skip_typecheck {
        if typecheck_has_errors_with_prelude(program, prelude_globals) {
            let diagnostics = typecheck_diagnostics_with_prelude(program, prelude_globals);
            _emit_typecheck_diagnostics(diagnostics, source, module_name);
            return false;
        }
    }
    if _reject_parse_errors(program) { return false; }
    if _reject_reexport_violations(program) { return false; }
    if validate_and_render_effects(program, source, module_name, empty_import_symbols()) > 0 {
        return false;
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    if run_ownership_checker(program) > 0 { return false; }
    let emitted = emit_native_lines_with_module_name(program, module_name);
    _report_emit_native_diags(emitted.diags, module_name);
    let native_text = lines_to_native_text(emitted.lines);
    if native_text.length == 0 { return false; }
    let import_context = _load_llvm_import_context(native_text, module_name, import_context_root(""));
    let generated = lower_native_text_to_llvm_artifact_with_context_and_provider(native_text, module_name, import_context, resolve_llvm_provider_context());
    _drain_llvm_lowering_traces();
    if !generated.ok {
        if has_error_diag(generated.diags) {
            _print_fatal_lowering_diagnostics(generated.diags);
        } else if generated.failure_message.length > 0 {
            print.err(generated.failure_message);
        }
        return false;
    }
    let mut line_index: int = 0;
    loop {
        if line_index >= generated.lines.length { break; }
        print(generated.lines[line_index]);
        line_index += 1;
    }
    return true;
}

fn compile_to_llvm_with_module(source: string, module_name: string) -> string ![io] {
    ice_set_source(module_name);
    ice_enter_stage("parse");
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    let skip_typecheck = _env_flag("SAILFIN_SKIP_TYPECHECK")
        || _legacy_flag_file("build/sailfin/.skip_typecheck");
    ice_enter_stage("typecheck");
    if !skip_typecheck {
        if typecheck_has_errors_with_prelude(program, prelude_globals) {
            let diagnostics = typecheck_diagnostics_with_prelude(program, prelude_globals);
            _emit_typecheck_diagnostics(diagnostics, source, module_name);
            return "";
        }
    } else {
        print.err("emit-llvm: skipping typecheck (SAILFIN_SKIP_TYPECHECK set, or legacy build/sailfin/.skip_typecheck file present)");
    }
    if _reject_parse_errors(program) { return ""; }
    if _reject_reexport_violations(program) { return ""; }
    ice_enter_stage("effects");
    if validate_and_render_effects(program, source, module_name, empty_import_symbols()) > 0 {
        return "";
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    ice_enter_stage("ownership");
    if run_ownership_checker(program) > 0 { return ""; }
    let trace_emit = _env_flag("SAILFIN_TRACE_EMIT") || _legacy_flag_file("build/sailfin/.trace_emit");
    ice_enter_stage("emit_native");
    let emitted = emit_native_lines_with_module_name(program, module_name);
    _report_emit_native_diags(emitted.diags, module_name);
    let native_text = lines_to_native_text(emitted.lines);
    if trace_emit {
        print.err("emit-llvm: native text bytes=" + int_to_string(native_text.length));
        if native_text.length > 0 {
            fs.writeFile("build/sailfin/debug-emit-native.sfn-asm", native_text);
            print.err("emit-llvm: wrote build/sailfin/debug-emit-native.sfn-asm");
        }
    }
    ice_enter_stage("lower_llvm");
    let mut ir: string = "";
    // The re-emits below carry the same diagnostics the primary emit above
    // already reported; re-reporting would duplicate them (SFN-608).
    if native_text.length > 0 {
        let import_context = _load_llvm_import_context(native_text, module_name, import_context_root(""));
        ir = lower_to_llvm_ir_from_text_with_provider_context(native_text, module_name, import_context, resolve_llvm_provider_context());
        _drain_llvm_lowering_traces();
        if ir.length == 0 {
            let native_result = emit_native_with_module_name(program, module_name);
            let fallback_context = _load_llvm_import_context(native_result.module.artifacts[0].contents, module_name, import_context_root(""));
            ir = lower_to_llvm_ir_with_provider_context(native_result.module, fallback_context, resolve_llvm_provider_context());
            _drain_llvm_lowering_traces();
        }
    } else {
        let native_result = emit_native_with_module_name(program, module_name);
        let fallback_context = _load_llvm_import_context(native_result.module.artifacts[0].contents, module_name, import_context_root(""));
        ir = lower_to_llvm_ir_with_provider_context(native_result.module, fallback_context, resolve_llvm_provider_context());
        _drain_llvm_lowering_traces();
    }
    if trace_emit {
        print.err("emit-llvm: llvm bytes=" + int_to_string(ir.length));
        if ir.length > 0 {
            fs.writeFile("build/sailfin/debug-emit-llvm.ll", ir);
            print.err("emit-llvm: wrote build/sailfin/debug-emit-llvm.ll");
        }
    }
    return ir;
}

fn compile_to_llvm_with_module_timed(source: string, module_name: string) -> string ![io, clock] {
    ice_set_source(module_name);
    ice_enter_stage("parse");
    let t0 = monotonic_millis();
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    let t_parse = _ms_since(t0);

    let t1 = monotonic_millis();
    ice_enter_stage("typecheck");
    let skip_typecheck = _env_flag("SAILFIN_SKIP_TYPECHECK")
        || _legacy_flag_file("build/sailfin/.skip_typecheck");
    let mut t_typecheck: int = 0;
    if !skip_typecheck {
        t_typecheck = _ms_since(t1);
        if typecheck_has_errors_with_prelude(program, prelude_globals) {
            let diagnostics = typecheck_diagnostics_with_prelude(program, prelude_globals);
            _emit_typecheck_diagnostics(diagnostics, source, module_name);
            print.err(_timing_line(module_name, "parse", t_parse));
            print.err(_timing_line(module_name, "typecheck", t_typecheck));
            return "";
        }
    } else {
        t_typecheck = _ms_since(t1);
        print.err("emit-llvm: skipping typecheck (SAILFIN_SKIP_TYPECHECK set, or legacy build/sailfin/.skip_typecheck file present)");
    }
    if _reject_parse_errors(program) {
        print.err(_timing_line(module_name, "parse", t_parse));
        print.err(_timing_line(module_name, "typecheck", t_typecheck));
        return "";
    }
    if _reject_reexport_violations(program) {
        print.err(_timing_line(module_name, "parse", t_parse));
        print.err(_timing_line(module_name, "typecheck", t_typecheck));
        return "";
    }
    ice_enter_stage("effects");
    if validate_and_render_effects(program, source, module_name, empty_import_symbols()) > 0 {
        print.err(_timing_line(module_name, "parse", t_parse));
        print.err(_timing_line(module_name, "typecheck", t_typecheck));
        return "";
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    ice_enter_stage("ownership");
    if run_ownership_checker(program) > 0 {
        print.err(_timing_line(module_name, "parse", t_parse));
        print.err(_timing_line(module_name, "typecheck", t_typecheck));
        return "";
    }

    let t2 = monotonic_millis();
    ice_enter_stage("emit_native");
    let trace_emit = _env_flag("SAILFIN_TRACE_EMIT") || _legacy_flag_file("build/sailfin/.trace_emit");
    let emitted = emit_native_lines_with_module_name(program, module_name);
    _report_emit_native_diags(emitted.diags, module_name);
    let native_text = lines_to_native_text(emitted.lines);
    if trace_emit {
        print.err("emit-llvm: native text bytes=" + int_to_string(native_text.length));
        if native_text.length > 0 {
            fs.writeFile("build/sailfin/debug-emit-native.sfn-asm", native_text);
            print.err("emit-llvm: wrote build/sailfin/debug-emit-native.sfn-asm");
        }
    }
    let t_emit_native = _ms_since(t2);

    let t3 = monotonic_millis();
    ice_enter_stage("lower_llvm");
    let mut ir = "";
    if native_text.length > 0 {
        let import_context = _load_llvm_import_context(native_text, module_name, import_context_root(""));
        ir = lower_to_llvm_ir_from_text_with_provider_context(native_text, module_name, import_context, resolve_llvm_provider_context());
        _drain_llvm_lowering_traces();
    } else {
        // Already reported above; re-emitting is deterministic (SFN-608).
        let native_result = emit_native_with_module_name(program, module_name);
        let fallback_context = _load_llvm_import_context(native_result.module.artifacts[0].contents, module_name, import_context_root(""));
        ir = lower_to_llvm_ir_with_provider_context(native_result.module, fallback_context, resolve_llvm_provider_context());
        _drain_llvm_lowering_traces();
    }
    if trace_emit {
        print.err("emit-llvm: llvm bytes=" + int_to_string(ir.length));
        if ir.length > 0 {
            fs.writeFile("build/sailfin/debug-emit-llvm.ll", ir);
            print.err("emit-llvm: wrote build/sailfin/debug-emit-llvm.ll");
        }
    }
    let t_lower_llvm = _ms_since(t3);

    print.err(_timing_line(module_name, "parse", t_parse));
    print.err(_timing_line(module_name, "typecheck", t_typecheck));
    print.err(_timing_line(module_name, "emit_native", t_emit_native));
    print.err(_timing_line(module_name, "lower_llvm", t_lower_llvm));
    print.err(_timing_line(module_name, "total", _ms_since(t0)));
    return ir;
}

// Resolver-driven test compile path. Mirrors
// `compile_tests_to_llvm_file_with_module` but threads three pieces of
// import-context the resolver pass produces:
//
//   - `imported_interfaces` from `load_imported_interfaces_from_paths`
//     — paired with `imported_function_effects` and fed into
//     `typecheck_diagnostics_with_import_symbols` so cross-module
//     `implements` clauses are conformance-checked end to end (same
//     wiring `sfn check` adopted in Track A2). Issue #811 added the
//     `ImportSymbolTable` slot so the typecheck walker can resolve
//     imported free-function callees ahead of issue D's enforcement
//     flip.
//   - `imported_manifests` reserved for layout-manifest plumbing —
//     today `[]`; the test path doesn't currently exercise cross-
//     module struct layout in any of the import-using tests, so
//     deferring layout loading keeps commit 3 minimal. Layout-manifest
//     loading lands as a follow-up if a regression appears.
//   - `imported_native_texts` from
//     `load_imported_native_texts_from_paths` — fed into
//     `apply_module_symbol_mangling` via `lower_to_llvm_lines_with_-
//     parsed_context_for_tests` so the test source's `@helper_answer`
//     references rewrite to the mangled `@helper_answer__<dep_slug>`
//     symbols the dependency `.ll` files define.
//
// Typecheck error handling matches the post-A3 contract: severity is
// on the `Diagnostic` struct, so we filter for `severity == "error"`
// before reporting and bailing. Warnings (e.g. future W01xx load
// warnings) flow through without aborting the test compile.
// Retain every non-test statement (imports, helpers) plus only the
// `TestDeclaration`s that satisfy the active `-k`/`--tag` filters. Used
// by the test compile path to cut filtered-out tests before emit.
fn _filter_program_tests(program: Program) -> Program {
    let mut kept: Statement[] = [];
    let mut i: int = 0;
    loop {
        if i >= program.statements.length { break; }
        let statement = program.statements[i];
        if statement.variant == "TestDeclaration" {
            if test_decl_matches_filters(statement) {
                kept.push(statement);
            }
        } else { kept.push(statement); }
        i += 1;
    }
    return Program { statements: kept };
}

fn compile_tests_to_llvm_file_with_module_imports(source: string, module_name: string, out_path: string, imported_interfaces: Statement[], imported_manifests: LayoutManifest[], imported_native_texts: string[], imported_function_effects: ImportSymbolTable, imported_capabilities_required: string[], imported_capabilities_declared: boolean, imported_capabilities_dev_required: string[], implicit_symbols: ImplicitSymbol[], imported_structs: Statement[]) -> boolean ![io] {
    let trace = test_runner_trace();
    if trace { print.err("test compiler (imports): parse_program start"); }
    let mut program: Program = parse_program(source);
    // Per-test discovery filter (`-k` / `--tag`, issue #849). Drop
    // non-matching `TestDeclaration`s before typecheck/emit so the
    // synthesized harness only calls the surviving `test:` symbols.
    // The file-level pre-filter in the `sfn test` runner guarantees at
    // least one test survives every file that reaches this point, so
    // the harness is never synthesized empty.
    if test_filters_active() { program = _filter_program_tests(program); }
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    let diagnostics = typecheck_diagnostics_with_import_symbols_prelude_implicit_structs(program, imported_interfaces, imported_structs, imported_function_effects, prelude_globals, implicit_symbols);
    let mut has_errors: boolean = false;
    let mut di: int = 0;
    loop {
        if di >= diagnostics.length { break; }
        if strings_equal(diagnostics[di].severity, "error") {
            has_errors = true;
            break;
        }
        di += 1;
    }
    if has_errors {
        _emit_typecheck_diagnostics(diagnostics, source, module_name);
        return false;
    }
    if _reject_parse_errors(program) { return false; }
    if _reject_reexport_violations(program) { return false; }
    // Phase E + F: thread the resolver-built function-effect table
    // (E0402) and capsule capability surface (E0403). Empty
    // capability list = standalone test outside any capsule = skip
    // E0403 cross-check; the tests in `compiler/tests/unit/` run
    // without a manifest in scope today and rely on this fallback.
    if validate_and_render_effects_with_capabilities(program, source, module_name, imported_function_effects, imported_capabilities_required, imported_capabilities_declared, imported_capabilities_dev_required) > 0 {
        return false;
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    if run_ownership_checker_with_imports(program, imported_function_effects) > 0 {
        return false;
    }
    if trace {
        print.err("test compiler (imports): emit_native_with_module_name start (module="
            + module_name
            + ")");
    }
    let emitted = emit_native_lines_with_module_name(program, module_name);
    _report_emit_native_diags(emitted.diags, module_name);
    let native_text = lines_to_native_text(emitted.lines);
    if trace {
        print.err("test compiler (imports): native text bytes=" + int_to_string(native_text.length));
        print.err("test compiler (imports): lower_to_llvm_for_tests start (imports="
            + int_to_string(imported_native_texts.length)
            + ")");
    }
    if fs.exists(out_path) { fs.deleteFile(out_path); }
    if trace {
        if native_text.length > 0 {
            fs.writeFile("build/sailfin/debug-test-native.sfn-asm", native_text);
            print.err("test compiler (imports): wrote build/sailfin/debug-test-native.sfn-asm");
        }
    }

    let parsed_native = parse_native_artifact(native_text);
    let import_context = imported_module_context_from_loaded_data_with_implicit(parsed_native.imports, module_name, import_context_root(""), imported_manifests, imported_native_texts, implicit_symbols);
    let generated = lower_llvm_for_tests_from_text_with_provider_context(native_text, module_name, import_context, resolve_llvm_provider_context());
    _drain_llvm_lowering_traces();
    if !_publish_llvm_artifact(generated, out_path, "test llvm: wrote truncated IR to "
        + out_path) { return false; }
    if !fs.exists(out_path) { return false; }
    let content = fs.readFile(out_path);
    if trace {
        print.err("test compiler (imports): lower_llvm_for_tests bytes="
            + int_to_string(content.length));
    }
    if content.length <= 4 {
        if trace {
            print.err("test compiler (imports): suspiciously short llvm output (len="
                + int_to_string(content.length)
                + ")");
        }
        return false;
    }
    return true;
}

fn compile_to_native_text_with_module(source: string, module_name: string) -> string ![io] {
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    if typecheck_has_errors_with_prelude(program, prelude_globals) {
        let diagnostics = typecheck_diagnostics_with_prelude(program, prelude_globals);
        _emit_typecheck_diagnostics(diagnostics, source, module_name);
        return "";
    }
    if _reject_parse_errors(program) { return ""; }
    if _reject_reexport_violations(program) { return ""; }
    if validate_and_render_effects(program, source, module_name, empty_import_symbols()) > 0 {
        return "";
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    if run_ownership_checker(program) > 0 { return ""; }
    let trace_emit = _env_flag("SAILFIN_TRACE_EMIT") || _legacy_flag_file("build/sailfin/.trace_emit");
    let emitted = emit_native_lines_with_module_name(program, module_name);
    _report_emit_native_diags(emitted.diags, module_name);
    let text = lines_to_native_text(emitted.lines);
    if trace_emit {
        print.err("emit-native: native text bytes=" + int_to_string(text.length));
        if text.length > 0 {
            fs.writeFile("build/sailfin/debug-emit-native.sfn-asm", text);
            print.err("emit-native: wrote build/sailfin/debug-emit-native.sfn-asm");
        }
    }
    return text;
}

struct TypedSsaTextResult {
    ok: boolean;
    text: string;
}

fn compile_to_typed_ssa_text_with_module(source: string, module_name: string) -> TypedSsaTextResult ![io] {
    let native_text = compile_to_native_text_with_module(source, module_name);
    if native_text.length == 0 {
        return TypedSsaTextResult { ok: false, text: "" };
    }
    let parsed = parse_native_artifact(native_text);
    let produced: TypedSsaProduceResult = produce_typed_ssa_declarations(parsed, module_name, module_name);
    if !produced.ok || produced.module == null {
        let mut i: int = 0;
        loop {
            if i >= produced.diagnostics.length { break; }
            print.err("error[" + produced.diagnostics[i].code + "]: " + produced.diagnostics[i].message);
            i += 1;
        }
        return TypedSsaTextResult { ok: false, text: "" };
    }
    return TypedSsaTextResult {
        ok: true,
        text: render_module(produced.module)
    };
}

fn print_typed_ssa_with_module(source: string, module_name: string) -> boolean ![io] {
    let result = compile_to_typed_ssa_text_with_module(source, module_name);
    if !result.ok { return false; }
    print(result.text);
    return true;
}

fn write_typed_ssa_file_with_module(source: string, module_name: string, out_path: string) -> boolean ![io] {
    let result = compile_to_typed_ssa_text_with_module(source, module_name);
    if !result.ok { return false; }
    fs.writeFile(out_path, result.text);
    return true;
}

// Write native text directly to a file to avoid returning large strings across ABI boundaries.
fn write_native_text_file_with_module(source: string, module_name: string, out_path: string) -> boolean ![io] {
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    if typecheck_has_errors_with_prelude(program, prelude_globals) {
        let diagnostics = typecheck_diagnostics_with_prelude(program, prelude_globals);
        _emit_typecheck_diagnostics(diagnostics, source, module_name);
        return false;
    }
    if _reject_parse_errors(program) { return false; }
    if _reject_reexport_violations(program) { return false; }
    if validate_and_render_effects(program, source, module_name, empty_import_symbols()) > 0 {
        return false;
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    if run_ownership_checker(program) > 0 { return false; }
    let emitted = emit_native_lines_with_module_name(program, module_name);
    _report_emit_native_diags(emitted.diags, module_name);
    if !native_lines_have_text(emitted.lines) { return false; }
    return _publish_lines_atomic(out_path, emitted.lines);
}

// `sfn emit native` file mode (issue #906): emit the `.sfn-asm`, then —
// when `run_gate` is set — run the lowering dry-run gate over the
// just-written text so the command fails closed on the same
// unresolved-callee inputs `sfn build` / `sfn emit llvm` reject. On a gate
// failure, delete the artifact (mirrors the driver-side stale-`.ll` cleanup)
// so no `.sfn-asm` survives and
// downstream tooling that only stats the path cannot mistake it for a
// clean build.
//
// `run_gate` is false for the build's per-module subprocess emit
// (`emit_subprocess_with_retry` passes `--no-resolve-gate`): that stage
// emits intermediate `.sfn-asm` with NO cross-module import context, so a
// legitimate imported call is unresolvable in isolation and must not be
// gated here — the build's load-bearing fail-closed gate is the later
// LLVM lowering stage (#631), not this native stage.
fn write_native_text_file_with_module_gated(source: string, module_name: string, out_path: string, run_gate: boolean) -> boolean ![io] {
    let ok = write_native_text_file_with_module(source, module_name, out_path);
    if !ok { return false; }
    if !run_gate { return true; }
    let native_text = fs.readFile(out_path);
    let import_context = _load_llvm_import_context(native_text, module_name, import_context_root(""));
    let passes_gate = native_text_passes_lowering_gate(native_text, module_name, import_context, resolve_llvm_provider_context());
    _drain_llvm_lowering_traces();
    if passes_gate { return true; }
    if fs.exists(out_path) { fs.deleteFile(out_path); }
    return false;
}

// `sfn emit native` stdout mode (issue #906): when `run_gate` is set, gate
// the native text before printing it, so a program that would fail
// `build` / `emit llvm` does not emit `.sfn-asm` to stdout with a rc=0
// false-green. Returns false (→ CLI exits non-zero) on emit failure or a
// lowering fatal. An empty text means the native emitter already failed
// upstream (typecheck / effect / re-export) and printed its own
// diagnostics. `run_gate` is false for build-internal emits (see the file
// wrapper above).
fn print_native_text_with_module_gated(source: string, module_name: string, run_gate: boolean) -> boolean ![io] {
    let native_text = compile_to_native_text_with_module(source, module_name);
    // Empty text is this module's sentinel for an upstream failure
    // (typecheck / effect / re-export) that already emitted diagnostics.
    // Fail closed unconditionally — independent of `run_gate` — so stdout
    // mode never prints an empty artifact and exits 0 (e.g. under
    // `--no-resolve-gate`), matching the file wrapper, whose underlying
    // `write_native_text_file_with_module` already returns false on the
    // same sentinel.
    if native_text.length == 0 { return false; }
    if run_gate {
        let import_context = _load_llvm_import_context(native_text, module_name, import_context_root(""));
        let passes_gate = native_text_passes_lowering_gate(native_text, module_name, import_context, resolve_llvm_provider_context());
        _drain_llvm_lowering_traces();
        if !passes_gate { return false; }
    }
    print(native_text);
    return true;
}

// Compile and write LLVM IR directly, avoiding large return values.
// Emits native text in memory and passes it straight into the lowering
// pipeline — no intra-call IPC file between emit and lower, so the function
// is safe to invoke from parallel workers.
fn compile_to_llvm_file_with_module(source: string, module_name: string, out_path: string, work_dir: string) -> boolean ![io] {
    // Empty import set → legacy in-module-only effect gate. Callers
    // with cross-module import context use
    // `compile_to_llvm_file_with_module_imports` (#957).
    let no_imports: string[] = [];
    return compile_to_llvm_file_with_module_imports(source, module_name, out_path, work_dir, no_imports);
}

// Driver-side adapter for provider-owned LLVM generation results. Lowering
// decides whether its lines are publishable; this module alone chooses the
// destination, reports presentation diagnostics, removes stale output after a
// fatal generation failure, and invokes atomic publication.
fn _publish_llvm_artifact(result: LLVMArtifactResult, out_path: string, publication_failure_message: string) -> boolean ![io] {
    if !result.ok {
        let fatal = has_error_diag(result.diags);
        if fatal {
            _print_fatal_lowering_diagnostics(result.diags);
            if fs.exists(out_path) { fs.deleteFile(out_path); }
        } else if result.failure_message.length > 0 {
            print.err(result.failure_message);
        }
        return false;
    }
    let published = _publish_lines_atomic(out_path, result.lines);
    if !published {
        if publication_failure_message.length > 0 {
            print.err(publication_failure_message);
        }
    }
    return published;
}

// Phase E build-path enforcement (#957). Identical to
// `compile_to_llvm_file_with_module` but threads the cross-module
// import-effect table loaded from `import_asm_paths` — the staged
// `.sfn-asm` of this module's direct imports — into the effect gate,
// so callee-effect transitivity (`E0402`) is enforced during
// `make compile` / `make check`, not just under `sailfin check`.
// Empty `import_asm_paths` degrades to the legacy empty-table
// (in-module-only) behavior, so the historical empty-table callers
// (`compile_to_llvm_with_module_timed`, ad-hoc `sailfin emit llvm
// <file>` with no `--import-context`) are unaffected.
fn compile_to_llvm_file_with_module_imports(source: string, module_name: string, out_path: string, work_dir: string, import_asm_paths: string[]) -> boolean ![io] {
    let empty_implicit: string[] = [];
    return compile_to_llvm_file_with_module_imports_and_implicit(source, module_name, out_path, work_dir, import_asm_paths, empty_implicit);
}

fn compile_to_llvm_file_with_module_import_context_root(source: string, module_name: string, out_path: string, work_dir: string, import_asm_paths: string[], context_root: string) -> boolean ![io] {
    let empty_implicit: string[] = [];
    return compile_to_llvm_file_with_module_import_context_root_and_implicit(source, module_name, out_path, work_dir, import_asm_paths, empty_implicit, context_root);
}

fn compile_to_llvm_file_with_module_imports_and_implicit(source: string, module_name: string, out_path: string, work_dir: string, import_asm_paths: string[], implicit_asm_paths: string[]) -> boolean ![io] {
    return compile_to_llvm_file_with_module_import_context_root_and_implicit(source, module_name, out_path, work_dir, import_asm_paths, implicit_asm_paths, import_context_root(work_dir));
}

fn compile_to_llvm_file_with_module_import_context_root_and_implicit(source: string, module_name: string, out_path: string, work_dir: string, import_asm_paths: string[], implicit_asm_paths: string[], context_root: string) -> boolean ![io] {
    // Phase-scoped arena reclamation: enabled unless SAILFIN_ARENA_PHASE_REWIND=0.
    // The mark is taken here, before parse, so the rewind at the end of the
    // emit pass reclaims the entire AST/typecheck/emit region — letting
    // LLVM lowering reuse that arena space instead of piling on top.
    let phase_rewind: boolean = env.get("SAILFIN_ARENA_PHASE_REWIND") != "0";
    let arena_mark: f64 = sfn_arena_sfn_mark();
    let program: Program = parse_program(source);
    let prelude_globals = load_prelude_global_names(runtime_helper_call_names());
    let loaded = load_imported_interfaces_with_implicit_paths(import_asm_paths, implicit_asm_paths);
    if loaded.implicit_diagnostics.length > 0 {
        let mut implicit_diag_index: int = 0;
        loop {
            if implicit_diag_index >= loaded.implicit_diagnostics.length {
                break;
            }
            print.err(loaded.implicit_diagnostics[implicit_diag_index]);
            implicit_diag_index += 1;
        }
        return false;
    }
    let mut skip_typecheck_probe: string = "build/sailfin/.skip_typecheck";
    if work_dir.length > 0 {
        skip_typecheck_probe = work_dir + "/sailfin/.skip_typecheck";
    }
    let skip_typecheck = _env_flag("SAILFIN_SKIP_TYPECHECK")
        || _legacy_flag_file(skip_typecheck_probe);
    if !skip_typecheck {
        let diagnostics = typecheck_diagnostics_with_import_symbols_prelude_implicit_structs(program, loaded.interfaces, loaded.structs, loaded.function_effects, prelude_globals, loaded.implicit_symbols);
        if diagnostics.length > 0 {
            _emit_typecheck_diagnostics(diagnostics, source, module_name);
            return false;
        }
    } else {
        print.err("emit-llvm-file: skipping typecheck (SAILFIN_SKIP_TYPECHECK set, or legacy build/sailfin/.skip_typecheck file present)");
    }
    if _reject_parse_errors(program) { return false; }
    if _reject_reexport_violations(program) { return false; }
    let imports = loaded.function_effects;
    if validate_and_render_effects(program, source, module_name, imports) > 0 {
        return false;
    }
    // E4 ownership pass (#1213): dormant Phase R0 gate.
    if run_ownership_checker_with_imports(program, imports) > 0 { return false; }

    // Stream the emitter's line array into lowering instead of joining to
    // one full-text string that `parse_native_artifact` would immediately
    // re-split (#1817).
    let emitted = emit_native_lines_with_module_name(program, module_name);
    // MUST stay here, before the `sfn_arena_sfn_rewind` below. `Diag`, its
    // `Span?`, and every string the renderer builds are arena-allocated, so
    // reporting after the rewind reads freed memory — a use-after-free that
    // does not fail deterministically (SFEP-0061 §9.1). Do not sink this call
    // toward its use site.
    _report_emit_native_diags(emitted.diags, module_name);
    let native_lines = emitted.lines;
    if !native_lines_have_text(native_lines) {
        print.err("emit-llvm-file: empty native output for module "
            + module_name);
        // Drop any stale `.ll` from a previous build so downstream tooling
        // that only stats `out_path` cannot mistake it for fresh output.
        if fs.exists(out_path) { fs.deleteFile(out_path); }
        return false;
    }
    // Phase-scoped arena reclamation: join the emitter's line array to a
    // single string, copy it to malloc-backed memory, rewind the arena
    // (reclaiming the entire parse/typecheck/emit region), then lower from
    // the heap-backed text and free it. Only one scalar crosses the mark
    // boundary — nothing arena-allocated is read after the rewind, avoiding
    // the array-container UAF that afflicts a `string[]` copy approach
    // (the array struct itself is arena-backed and gone after rewind).
    // Disabled when SAILFIN_ARENA_PHASE_REWIND=0.
    if phase_rewind {
        let heap_text: string = relocate_string_to_heap(lines_to_native_text(native_lines));
        // Preserve the established one-scalar rewind path exactly when no
        // implicit provider is selected. Besides protecting determinism, this
        // avoids carrying an arena-backed array container across the rewind.
        if implicit_asm_paths.length == 0 {
            sfn_arena_sfn_rewind(arena_mark);
            let import_context = _load_llvm_import_context(heap_text, module_name, context_root);
            let generated = lower_native_text_to_llvm_artifact_with_context_and_provider(heap_text, module_name, import_context, resolve_llvm_provider_context());
            _drain_llvm_lowering_traces();
            let ok = _publish_llvm_artifact(generated, out_path, "");
            free_heap_string(heap_text);
            return ok;
        }
        let mut implicit_paths_text = "";
        let mut implicit_path_index: int = 0;
        loop {
            if implicit_path_index >= implicit_asm_paths.length { break; }
            if implicit_path_index > 0 {
                implicit_paths_text = implicit_paths_text + "\n";
            }
            implicit_paths_text = implicit_paths_text + implicit_asm_paths[implicit_path_index];
            implicit_path_index += 1;
        }
        let heap_implicit_paths = relocate_string_to_heap(implicit_paths_text);
        sfn_arena_sfn_rewind(arena_mark);
        let mut ok: boolean = false;
        let relocated_implicit_paths = split(heap_implicit_paths, "\n");
        let reloaded = load_imported_interfaces_with_implicit_paths([], relocated_implicit_paths);
        let import_context = _load_llvm_import_context_with_implicit(heap_text, module_name, context_root, reloaded.implicit_symbols);
        let generated = lower_native_text_to_llvm_artifact_with_context_and_provider(heap_text, module_name, import_context, resolve_llvm_provider_context());
        _drain_llvm_lowering_traces();
        ok = _publish_llvm_artifact(generated, out_path, "");
        free_heap_string(heap_implicit_paths);
        free_heap_string(heap_text);
        return ok;
    }
    // Non-rewind path: existing behavior unchanged.
    // `-p` cross-module path: thread the staged import bodies into
    // lowering so sibling call sites resolve the entry's exported
    // function signatures (#999). The empty-import / in-process path
    // (`import_asm_paths.length == 0`) keeps routing through the direct
    // provider entrypoint.
    let parsed_native = parse_native_artifact_from_lines(native_lines);
    let mut import_context = load_imported_module_context_with_implicit(parsed_native.imports, module_name, context_root, loaded.implicit_symbols);
    import_context.implicit_symbols = loaded.implicit_symbols;
    let generated = lower_native_lines_to_llvm_artifact_with_context_and_provider(native_lines, module_name, import_context, resolve_llvm_provider_context());
    _drain_llvm_lowering_traces();
    return _publish_llvm_artifact(generated, out_path, "");
}

// Build-path typecheck diagnostic emission. Every `compile_to_*`
// entry point that hits a typecheck error routes through this
// helper so the build path and `sfn check` produce the same caret
// rendering — single source of truth in `diagnostics_render.sfn`.
//
// Track B B4 (`docs/proposals/0004-check-architecture.md`) deleted the
// previous in-module renderer chain (`format_typecheck_diagnostic`,
// `format_typecheck_diagnostics`, `report_typecheck_errors`,
// `split_source_lines`, `build_pointer_line`, `join_lines` — ~150
// lines) in favor of this 10-line wrapper. The legacy "[typecheck]
// --> line N, column N" shape is gone; build-path errors now match
// `error[E0001]: ... --> file:line:col` like `sfn check`.
fn _emit_typecheck_diagnostics(entries: Diagnostic[], source: string, file_path: string) ![io] {
    let lines = split_source_lines(source);
    let mut index: int = 0;
    loop {
        if index >= entries.length { break; }
        // Stamp file_path in place so the renderer's `--> file:line:col`
        // line carries the right module name. Factories mint diagnostics
        // with empty file_path; this is the single point on the build
        // path that knows which module is currently being analyzed.
        entries[index].file_path = file_path;
        let rendered = render_terminal_diagnostic(diagnostic_to_diag(entries[index], "typecheck"), lines, "typecheck");
        print.err(rendered);
        index += 1;
    }
}

fn repeat_character(ch: string, count: int) -> string {
    if count <= 0 { return ""; }
    let mut index: int = 0;
    let mut result: string = "";
    loop {
        if index >= count { break; }
        result = result + ch;
        index += 1;
    }
    return result;
}

// Read the project's capsule.toml and return dependencies as a
// newline-separated "name=version" string. Returns "" if no capsule.toml
// is found in the current directory.
fn read_project_dependencies() -> string ![io] {
    if !fs.exists("capsule.toml") { return ""; }
    let text = fs.readFile("capsule.toml");
    return toml_get_dependencies(text);
}
