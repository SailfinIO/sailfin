import { int_to_string } from "sfn/strings";

// compiler/src/cli_selfhost.sfn
//
// CLI handler for `sfn selfhost` — the triple-pass self-host
// fixed-point validator that used to live as ~100 lines of bash in
// `Makefile`'s `check-impl` (issue #1502, epic #513 Phase 1).
//
// `sfn selfhost` is an INTERNAL toolchain command: it is intentionally
// NOT advertised in `_usage()` (the user-facing `sfn --help`). End
// users compiling their own capsules never run it — it validates that
// the compiler is a fixed point and is driven only by `sfn dev verify`
// and CI. This mirrors how Go (`cmd/dist`, reachable only as
// `go tool dist`) and Rust (`x.py` / `src/bootstrap`) keep self-host
// validation out of the public compiler CLI, while still honoring epic
// #513's mandate that `sfn` (not bash) owns the logic. The verb is
// reachable for anyone who types it; it is simply undocumented.
//
// Orchestration (a straight port of the former `Makefile:531-632`):
//   1. stage2 (seedcheck): the first-pass binary builds `-p compiler`
//      into an isolated scratch root, `--no-cache`.
//   2. smoke gate: the seedcheck binary runs hello-world.
//   3. stage3: the seedcheck binary builds `-p compiler` again into a
//      second isolated scratch root.
//   4. fixed-point diff: the per-module `.ll` digests of stage2 and
//      stage3 are compared (reusing the `--check-determinism` diff
//      structs/renderers from `build_report.sfn`).
//   5. promotion: the validated seedcheck binary is copied over the
//      canonical `build/bin/sfn`.
//
// Per-stage isolation is load-bearing for top-level/runtime scratch. The
// scoped compiler module tree is canonical, so stage2 is snapshotted before
// stage3 clears and repopulates it. `SAILFIN_TEST_SCRATCH` is set on each
// spawned child through `run_capture`'s explicit env array
// (`_selfhost_stage_env`), the same shell-free vehicle
// `build/runtime_objs.sfn::_runtime_emit_child_env` uses, keeping this a
// pure-orchestration driver that post-processes no artifact.
//
// Nothing this command *spawns* may reach a POSIX shell: `sfn selfhost`
// is what proves the native Windows self-host fixed point, and there is
// no `sh` there to reach (SFEP-0021 §4.2). Stage builds, scratch
// cleanup, binary promotion and the smoke gate are all shell-free.
//
// `_selfhost_snapshot` hashes every `.ll` module and linked binary through the
// same binary-safe in-process path. No spawned stage reaches a hashing shell,
// and Windows records a real binary digest instead of a platform-only miss.
import {
    _atomic_rename_into_place,
    _copy_file,
    _dirname_cmd,
    _ensure_dir_recursive_cmd,
    _mktemp_sibling_cmd,
    _sha256_of_file
} from "./build/fs";
import { host_exe_name } from "./build/target";
import {
    DeterminismModule,
    DeterminismSnapshot,
    compare_for_determinism,
    determinism_diff_to_json,
    determinism_diff_to_text,
    make_determinism_module
} from "./build_report";
import { starts_with, substring } from "./string_utils";

// Resolved configuration for one `sfn selfhost` invocation. Defaults
// reproduce the former Makefile paths byte-for-byte.
struct SelfhostConfig {
    work_dir: string;
    first_pass: string;
    seedcheck_out: string;
    stage3_out: string;
    promote_to: string;
    // Accepted and recorded, but not enforced (SFN-619 restores it). Its
    // only ever vehicle was interpolation into a shell `timeout N …`
    // prefix, and the runtime offers no shell-free equivalent — a deadline
    // today means the spawn/poll/kill handle API
    // (`cli/commands/test/pool.sfn::_reap_test_child`). Kept in the flag
    // surface so no existing caller breaks.
    smoke_timeout: string;
    json: boolean;
    no_promote: boolean;
    strict: boolean;
}

fn _selfhost_default_config() -> SelfhostConfig ![io] {
    return SelfhostConfig {
        work_dir: "build/selfhost",
        first_pass: host_exe_name("build/bin/sfn"),
        seedcheck_out: host_exe_name("build/bin/sfn-seedcheck"),
        stage3_out: host_exe_name("build/bin/sfn-stage3"),
        promote_to: host_exe_name("build/bin/sfn"),
        smoke_timeout: "10",
        json: false,
        no_promote: false,
        strict: false
    };
}

// -------------------------------------------------------------------
// `--json` sub-envelope (SFEP-0014 §3.5, SFN-725)
// -------------------------------------------------------------------
//
// Before SFN-725 `--json` printed only `determinism_diff_to_json`, and
// every phase banner was `!cfg.json` guarded — so JSON mode reported
// LESS structure than human mode, and an early exit (a stage2 build
// failure, a dead smoke gate) emitted nothing at all.
//
// `sfn dev verify` supervises this command and must attribute a failure
// to the sub-phase that produced it, so every post-arg-parse exit path
// funnels through `_selfhost_finish`, which emits exactly one
// `sailfin-selfhost/1` line on stdout in JSON mode.
//
// The supervisor splices that line into its own report verbatim and
// scrapes three scalars from it (`failed_phase`, `fixed_point_checked`,
// `fixed_point`). `compiler/src` has no JSON parser and cannot import
// the `sfn/json` capsule (build cycle), so the fields a consumer must
// read are deliberately flat scalars rather than nested structure.
//
// Arg-parse errors deliberately emit NO envelope, matching the
// `sfn bench` precedent recorded in SFEP-0003 §3.3: a `--json` consumer
// treats empty-stdout-with-nonzero-exit as a setup error.
struct SelfhostPhase {
    name: string;
    status: string;
    exit_code: int;
}

struct SelfhostLedger {
    phases: SelfhostPhase[];
    // First phase to fail, or "" when none did. `verify` reads this
    // rather than scanning `phases[]`, which would need a real parser.
    failed_phase: string;
    fixed_point_checked: boolean;
    fixed_point: boolean;
    binary_match: boolean;
    // The `determinism_diff_to_json` document, spliced in raw, or "" when
    // the run never reached the diff.
    determinism_json: string;
}

fn _selfhost_new_ledger() -> SelfhostLedger {
    let empty: SelfhostPhase[] = [];
    return SelfhostLedger {
        phases: empty,
        failed_phase: "",
        fixed_point_checked: false,
        fixed_point: false,
        binary_match: false,
        determinism_json: ""
    };
}

fn _sh_json_escape(s: string) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= s.length { break; }
        let ch = substring(s, i, i + 1);
        if ch == "\"" { out = out + "\\\""; } else if ch == "\\" {
            out = out + "\\\\";
        } else if ch == "\n" { out = out + "\\n"; } else if ch == "\r" {
            out = out + "\\r";
        } else if ch == "\t" { out = out + "\\t"; } else { out = out + ch; }
        i += 1;
    }
    return out;
}

fn _sh_json_quote(s: string) -> string {
    return "\"" + _sh_json_escape(s) + "\"";
}

fn _sh_json_bool(value: boolean) -> string {
    if value { return "true"; }
    return "false";
}

fn _selfhost_envelope_json(led: SelfhostLedger, exit_code: int, strict: boolean) -> string {
    let mut phases: string = "[";
    let mut i: int = 0;
    loop {
        if i >= led.phases.length { break; }
        if i > 0 { phases = phases + ","; }
        let p = led.phases[i];
        phases = phases + "{\"name\":" + _sh_json_quote(p.name) + ",\"status\":"
            + _sh_json_quote(p.status)
            + ",\"exit_code\":"
            + int_to_string(p.exit_code)
            + "}";
        i += 1;
    }
    phases = phases + "]";

    let mut failed: string = "null";
    if led.failed_phase.length > 0 {
        failed = _sh_json_quote(led.failed_phase);
    }
    let mut det: string = "null";
    if led.determinism_json.length > 0 { det = led.determinism_json; }

    return "{\"schema_version\":\"sailfin-selfhost/1\",\"command\":\"selfhost\",\"exit_code\":"
        + int_to_string(exit_code)
        + ",\"strict\":"
        + _sh_json_bool(strict)
        + ",\"failed_phase\":"
        + failed
        + ",\"fixed_point_checked\":"
        + _sh_json_bool(led.fixed_point_checked)
        + ",\"fixed_point\":"
        + _sh_json_bool(led.fixed_point)
        + ",\"binary_match\":"
        + _sh_json_bool(led.binary_match)
        + ",\"phases\":"
        + phases
        + ",\"determinism\":"
        + det
        + "}";
}

// Single exit funnel: emits the envelope in JSON mode and passes the
// exit code through unchanged. Human mode is byte-identical to before.
fn _selfhost_finish(cfg: SelfhostConfig, led: SelfhostLedger, exit_code: int) -> int ![io] {
    if cfg.json {
        print(_selfhost_envelope_json(led, exit_code, cfg.strict));
    }
    return exit_code;
}

fn _selfhost_usage() -> string {
    return "usage: sfn selfhost [--work-dir DIR] [--first-pass BIN]\n"
        + "                    [--seedcheck-out BIN] [--stage3-out BIN]\n"
        + "                    [--promote-to BIN]\n"
        + "                    [--smoke-timeout SECS] (accepted, not enforced)\n"
        + "                    [--no-promote] [--strict] [--json]\n"
        + "\n"
        + "Internal: validate the compiler self-hosts to a fixed point\n"
        + "(stage2 == stage3 LLVM IR) and promote the validated binary.\n";
}

// Whether `needle` occurs in `haystack`. `_string_contains_cmd` in
// string_cmd_utils only tests single-character membership, so the
// smoke gate needs a real substring scan.
fn _selfhost_contains(haystack: string, needle: string) -> boolean {
    if needle.length == 0 { return true; }
    if needle.length > haystack.length { return false; }
    let limit = haystack.length - needle.length;
    let mut i: int = 0;
    loop {
        if i > limit { break; }
        if substring(haystack, i, i + needle.length) == needle { return true; }
        i += 1;
    }
    return false;
}

// Basename of a `/`-separated path (no trailing-slash handling needed —
// callers pass file paths produced by `fs.listDirectory`).
fn _selfhost_basename(path: string) -> string {
    let mut last_slash: int = -1;
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if substring(path, i, i + 1) == "/" { last_slash = i; }
        i += 1;
    }
    if last_slash < 0 { return path; }
    return substring(path, last_slash + 1, path.length);
}

// Whether a flat `"KEY=VALUE"` environment entry binds `key`. A bare
// `"KEY"` with no `=` counts, since that is how a valueless binding is
// reported.
fn _selfhost_env_entry_has_key(entry: string, key: string) -> boolean {
    if entry == key { return true; }
    if entry.length <= key.length { return false; }
    if substring(entry, 0, key.length) != key { return false; }
    return substring(entry, key.length, key.length + 1) == "=";
}

// The environment for one stage child: the parent's, with the two
// selfhost overrides forced on. `run_capture` never inherits — an empty
// array is the empty environment, not "the parent's" — so the parent env
// is copied through explicitly.
//
// Existing bindings for the two keys are *dropped*, not shadowed by a
// later duplicate: POSIX leaves it unspecified which entry `getenv`
// resolves when `envp` binds a key twice, so appending alone would let
// an inherited `SAILFIN_BOOTSTRAP=on` win.
//
// `SAILFIN_BOOTSTRAP=off`: the selfhost stages MUST build with the given
// `driver_bin` (the fixed point is that the first-pass binary rebuilds
// itself), never dispatch to the pinned seed. `driver_bin` carries the
// *source* version, which is ahead of `bootstrap.toml [seed].version` for
// the whole span between a release and its seed cut — so the exact-match
// bootstrap gate (SFEP-0047) would otherwise fetch + re-exec the seed here
// and subvert the self-host check while still reporting green. Mirrors the
// `SAILFIN_TOOLCHAIN=off` seed-transition note in `compiler/capsule.toml`.
fn _selfhost_stage_env(parent_env: string[], scratch_dir: string) -> string[] {
    let mut child_env: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= parent_env.length { break; }
        let entry = parent_env[i];
        if !_selfhost_env_entry_has_key(entry, "SAILFIN_BOOTSTRAP") && !_selfhost_env_entry_has_key(entry, "SAILFIN_TEST_SCRATCH") {
            child_env.push(entry);
        }
        i += 1;
    }
    child_env.push("SAILFIN_BOOTSTRAP=off");
    child_env.push("SAILFIN_TEST_SCRATCH=" + scratch_dir);
    return child_env;
}

// The argv for one stage build. `run_capture` hands this straight to
// `execve`, so the arguments are literal — none of the shell quoting the
// former `sh -c` command string needed.
// `--skip-toolchain-check`: this stage has already resolved the exact
// driver binary to run and must not let this child re-select a different
// toolchain (a recorded user default, SFEP-0073 §3.3 rank 4, or an exact
// project pin). See workspace.toml's `dev` exclusion note.
fn _selfhost_stage_argv(driver_bin: string, work_subdir: string, out_bin: string) -> string[] {
    return [driver_bin, "build", "--no-cache", "-p", "compiler", "--work-dir", work_subdir, "-o", out_bin, "--skip-toolchain-check"];
}

// Re-emit a captured child stream so stage output still reaches the
// console. `print`/`print.err` append a newline, so one trailing newline
// is stripped for a byte-faithful round-trip; an empty capture prints
// nothing. Mirrors `build/runtime_objs.sfn::_runtime_emit_captured_stream`.
fn _selfhost_emit_captured_stream(text: string, to_stderr: boolean) -> void ![io] {
    if text.length == 0 { return; }
    let mut out = text;
    if substring(out, out.length - 1, out.length) == "\n" {
        out = substring(out, 0, out.length - 1);
    }
    if to_stderr { print.err(out); } else { print(out); }
}

// Delete `root` and everything beneath it — the shell-free replacement
// for `rm -rf`, over a file or a directory. A missing `root` is not an
// error, matching `rm -rf`. Returns whether `root` is gone afterward.
//
// There is no `fs.isDirectory` builtin, so entry kind is inferred from
// the unlink: `fs.deleteFile` is `unlink(2)`, which fails on a directory.
// Whatever refuses to unlink is queued as a directory and removed after
// its contents, since `fs.removeDirectory` is `rmdir(2)` and only takes
// an empty directory. `dirs` is an append-only queue walked by a monotone
// cursor, so a directory is only ever pushed while its parent is being
// processed — every ancestor therefore sits at a strictly smaller index,
// and removing the queue in reverse always empties children first.
//
// Symlinks are unlinked rather than followed (`unlink(2)` again), so the
// walk cannot escape `root`; `fs.listDirectory` filters `.`/`..`. Mirrors
// the shipped `sfn/fs::remove_all`, which is not importable from
// `compiler/src`.
//
// The return value matters more than it looks: a stale `.ll` surviving in
// one stage is a false *mismatch*, while one surviving symmetrically in
// both stages is a false *fixed point* — the displaced `rm -rf` swallowed
// its errors, so this is the one silent false-green path worth reporting.
fn _selfhost_remove_tree(root: string) -> boolean ![io] {
    // The unlink runs BEFORE the existence probe, and the order is the whole
    // fix for SFN-681. `fs.exists` is `stat(2)` and follows symlinks, so a
    // root that is a *dangling* link fails that probe and would take the
    // absent-root `return true` without ever being unlinked — reporting a
    // removal that did not happen. `fs.deleteFile` is `unlink(2)`, which
    // does not follow: it removes the link itself and leaves any live target
    // alone. A genuinely absent root just makes it fail harmlessly, which
    // the probe below then answers.
    //
    // A file root also has no entries to walk, and `rmdir` would refuse it.
    if fs.deleteFile(root) { return true; }
    if !fs.exists(root) { return true; }
    let mut dirs: string[] = [root];
    let mut di: int = 0;
    let mut guard: int = 0;
    loop {
        if di >= dirs.length { break; }
        if guard > 65536 { break; }
        guard += 1;
        let dir = dirs[di];
        let entries = fs.listDirectory(dir);
        let mut ei: int = 0;
        loop {
            if ei >= entries.length { break; }
            let full_path = dir + "/" + entries[ei];
            if !fs.deleteFile(full_path) { dirs.push(full_path); }
            ei += 1;
        }
        di += 1;
    }
    let mut ri: int = dirs.length - 1;
    loop {
        if ri < 0 { break; }
        fs.removeDirectory(dirs[ri]);
        ri -= 1;
    }
    // `fs.exists` is safe as the survival check here even though it follows
    // symlinks: every non-directory root — plain file, live link, dangling
    // link — was already unlinked above and returned early, so the only root
    // that reaches this line is a real directory. Moving the unlink back
    // below the probe would reopen SFN-681 here as well as there.
    return !fs.exists(root);
}

// Copy a stage binary into place: stage it beside the destination, carry
// the source's mode bits over, then rename it into position.
//
// Writing `dst` directly does not work for `--promote-to`, whose default
// destination is the *running* `build/bin/sfn`. `_copy_file` opens its
// destination with `fopen(…, "wb")`, and the kernel denies write access to
// a file currently being executed (`ETXTBSY`), so the open fails outright.
// The displaced `cp -f` survived that only because `-f` means "if the
// destination cannot be opened, remove it and try again" — the flag was
// load-bearing, not cosmetic. `rename(2)` reaches the same fresh inode
// without ever opening the live one, and atomically: `dst` is never
// observed truncated or missing, which matters because the next `make
// check` step immediately executes the binary just promoted.
//
// That last sentence is POSIX reasoning and does not carry to Windows.
// POSIX rebinds a PATH to a fresh inode and leaves the running image's
// inode alone, so the swap is atomic. Windows locks the running image's
// path itself, not merely its bytes, so the direct replace fails
// `ERROR_ACCESS_DENIED` (measured, not inferred), and Win32 offers no
// atomic replace of a running image at all — the only alternative is
// `MOVEFILE_DELAY_UNTIL_REBOOT`, which needs a reboot and a privilege.
// `sfn_rename_replace`'s Windows sibling therefore displaces the live
// image to `dst.old` and moves the staged copy in: a window two
// metadata operations wide in which `dst` is absent. Three things keep
// that safe here. It is entered ONLY where the atomic form already
// failed, so no promote that succeeds today loses atomicity. It closes
// before this function returns, so the caller that executes the
// promoted binary next never observes it. And the displaced image
// survives at `dst.old`, so a failed publish rolls back rather than
// leaving `dst` missing. See `platform/rename_ops_windows.sfn`.
//
// The mode step is equally load-bearing: `_copy_file` creates a missing
// destination with `fopen`'s 0666-and-umask default, which is *not*
// executable, whereas `cp -f` carried the source's permissions across.
// It is applied to the staged copy rather than after the rename so `dst`
// is never briefly present-but-unrunnable.
//
// `fs.get_perms` reports -1 on any error and `fs.set_perms` masks to 12
// bits, so chmod-ing an unchecked -1 would quietly set 0o7777 — setuid,
// setgid, sticky and world-writable — on the compiler binary. The `> 0`
// guard is not defensive padding: the Windows `get_perms` lowering is a
// fixed -1 stub, so that is the path taken on the very platform this
// command exists to validate. A non-positive mode means the host does not
// report one, and the copy's default stands.
fn _selfhost_promote_binary(src: string, dst: string) -> boolean ![io] {
    let mut staged = _mktemp_sibling_cmd(dst);
    // `_mktemp_sibling_cmd` yields "" if it cannot allocate a temp name;
    // a fixed sibling still shares the destination's filesystem, which is
    // what keeps the rename atomic.
    if staged.length == 0 { staged = dst + ".sfn-promote-tmp"; }
    if !_copy_file(src, staged) {
        fs.deleteFile(staged);
        return false;
    }
    let mode = fs.get_perms(src);
    if mode > 0 && !fs.set_perms(staged, mode) {
        print.err("[selfhost] could not carry the source mode onto " + staged);
        fs.deleteFile(staged);
        return false;
    }
    return _atomic_rename_into_place(staged, dst);
}

// Recursively collect `*.ll` files under `root`. The BFS covers the scoped
// compiler tree at `build/capsules/sfn/compiler/ir/` and the nested runtime
// cache layout.
fn _selfhost_collect_ll_files(root: string) -> string[] ![io] {
    let mut results: string[] = [];
    if !fs.exists(root) { return results; }
    let mut queue: string[] = [root];
    let mut guard: int = 0;
    loop {
        if queue.length == 0 { break; }
        if guard > 4096 { break; }
        guard += 1;
        let mut next_queue: string[] = [];
        let mut qi: int = 0;
        loop {
            if qi >= queue.length { break; }
            let dir = queue[qi];
            if fs.exists(dir) {
                let entries = fs.listDirectory(dir);
                let mut ei: int = 0;
                loop {
                    if ei >= entries.length { break; }
                    let entry = entries[ei];
                    let full_path = dir + "/" + entry;
                    if entry.length >= 3 && substring(entry, entry.length - 3, entry.length) == ".ll" {
                        results.push(full_path);
                    } else {
                        let child_entries = fs.listDirectory(full_path);
                        if child_entries.length > 0 {
                            next_queue.push(full_path);
                        }
                    }
                    ei += 1;
                }
            }
            qi += 1;
        }
        queue = next_queue;
    }
    return results;
}

// `sfn/compiler` is scoped, so its own module IR lives in the canonical
// per-capsule tree instead of the legacy `SAILFIN_TEST_SCRATCH/capsules`
// tree. Self-host stages run sequentially; each stage clears this tree, and
// the caller snapshots it before starting the next stage.
fn _selfhost_compiler_ir_dir() -> string {
    return "build/capsules/sfn/compiler/ir";
}

// A fixed-point check without the compiler's own module IR is vacuous. Keep
// this probe separate from the runtime-cache warning: an empty compiler tree
// is a hard orchestration failure, not reduced coverage.
fn _selfhost_has_compiler_ir(root: string) -> boolean ![io] {
    return _selfhost_collect_ll_files(root).length > 0;
}

// Scoped IR is nested (`build/fs.ll`, `cli/commands/build.ll`, ...), so a
// basename is not a unique module identity. Preserve the path relative to the
// enumerated root; retain the basename fallback for a path outside that root.
fn _selfhost_relative_ll_slug(root: string, path: string) -> string {
    let mut prefix = root;
    if prefix.length > 1 && prefix[prefix.length - 1] == "/" {
        prefix = substring(prefix, 0, prefix.length - 1);
    }
    if prefix.length > 0 && path.length > prefix.length && starts_with(path, prefix)
        && path[prefix.length] == "/" {
        return substring(path, prefix.length + 1, path.length);
    }
    return _selfhost_basename(path);
}

// Build a determinism snapshot from a stage's `.ll` scratch dir, its
// sailfin cache dir, and its linked binary. The `.ll` digests carry the
// fixed-point check (the Makefile compared only these); the binary sha
// is folded in as a strictly-stronger signal (a benign binary-only
// divergence is a non-fatal warning in the default mode, so
// `sfn dev verify` stays green). On macOS the binary sha is NOT a reliable divergence
// signal — ld64's ad-hoc code signature embeds the linked output's
// basename, so even byte-identical inputs linked to different basenames
// hash differently (SFN-87 / #1726); the `.ll` module digests are the
// authoritative fixed-point check.
//
// `runtime_dir` is the stage's sailfin cache dir,
// `<work_dir>/sailfin/` (`build/cache.sfn::_resolve_sailfin_cache_dir_for_work`,
// ~L173-183): the top-level module's `program.ll`/`program.o` plus driver
// scratch, which happens to include the runtime modules pulled in by that
// top-level module. It sits outside `capsules_dir` and would otherwise be
// invisible to the module diff. Its entries are prefixed `cache/` (not
// `runtime/` — `program.ll` is not a runtime module) so a divergence
// there renders as a named module line, not an opaque binary sha.
fn _selfhost_snapshot(capsules_dir: string, runtime_dir: string, binary_path: string) -> DeterminismSnapshot ![io] {
    let files = _selfhost_collect_ll_files(capsules_dir);
    let mut modules: DeterminismModule[] = [];
    let mut i: int = 0;
    loop {
        if i >= files.length { break; }
        let slug = _selfhost_relative_ll_slug(capsules_dir, files[i]);
        let sha = _sha256_of_file(files[i]);
        modules.push(make_determinism_module(slug, sha));
        i += 1;
    }
    let runtime_files = _selfhost_collect_ll_files(runtime_dir);
    let mut ri: int = 0;
    loop {
        if ri >= runtime_files.length { break; }
        let slug = "cache/" + _selfhost_relative_ll_slug(runtime_dir, runtime_files[ri]);
        let sha = _sha256_of_file(runtime_files[ri]);
        modules.push(make_determinism_module(slug, sha));
        ri += 1;
    }
    let binary_sha = _sha256_of_file(binary_path);
    return DeterminismSnapshot {
        binary_path: binary_path,
        binary_sha256: binary_sha,
        modules: modules
    };
}

// Spawn one stage build: `<driver> build --no-cache -p compiler
// --work-dir <work_subdir> -o <out_bin>`. `SAILFIN_TEST_SCRATCH` isolates
// legacy scratch, while the scoped compiler IR tree is cleared explicitly and
// snapshotted by the caller before the next stage starts. Returns the child
// exit code.
fn _selfhost_build_stage(driver_bin: string, scratch_dir: string, work_subdir: string, out_bin: string) -> int ![io] {
    _ensure_dir_recursive_cmd(work_subdir);
    // Fresh scratch: drop any prior `.ll` so a stale module can't poison
    // the fixed-point comparison. Surfaced rather than ignored because a
    // survivor skews the diff in either direction (see `_selfhost_remove_tree`).
    let scratch_capsules = scratch_dir + "/capsules";
    if !_selfhost_remove_tree(scratch_capsules) {
        print.err("[selfhost] WARNING: could not fully clear "
            + scratch_capsules
            + " — a stale module may skew the fixed-point diff");
    }
    let compiler_ir = _selfhost_compiler_ir_dir();
    if !_selfhost_remove_tree(compiler_ir) {
        print.err("[selfhost] WARNING: could not fully clear " + compiler_ir
            + " — a stale module may skew the fixed-point diff");
    }
    let rc = process.run_capture(_selfhost_stage_argv(driver_bin, work_subdir, out_bin), _selfhost_stage_env(process.environ(), scratch_dir));
    // `run_capture` buffers rather than passing the child's stdio through,
    // so both streams are handed back to the console here.
    _selfhost_emit_captured_stream(process.capture_take_stdout(), false);
    _selfhost_emit_captured_stream(process.capture_take_stderr(), true);
    // `run_capture` reports a spawn or reap failure as -1, which would
    // surface as the nonsensical "exit=-1" and a 255 process status. It
    // also leaves both captures empty, so unlike the displaced `sh -c`
    // there is no `not found` message to go on — hence the explicit one.
    if rc < 0 {
        print.err("[selfhost] could not spawn " + driver_bin);
        return 1;
    }
    return rc;
}

// Smoke gate: run hello-world with the seedcheck binary and confirm the
// expected greeting appears (port of `Makefile:566-580`). The exit code
// is intentionally ignored, exactly as the Makefile's `|| true` did — the
// greeting substring is the contract.
//
// stdout and stderr are captured separately and joined in-process; the
// former combined capture came from a `2>&1` redirection, which needed a
// shell. The greeting may arrive on either stream, so both are searched.
//
// There is no deadline here: `--smoke-timeout` came from the shell
// `timeout` prefix, and `run_capture` drains to EOF with an infinite poll,
// so a wedged seedcheck binary hangs this gate. SFN-619 restores a bound
// via the spawn/poll/kill handle API.
fn _selfhost_smoke(seedcheck_bin: string) -> boolean ![io] {
    // --skip-toolchain-check: the seedcheck binary is the exact artifact
    // under test and must not re-select a different toolchain to run this.
    let argv: string[] = [seedcheck_bin, "run", "examples/basics/hello-world.sfn", "--skip-toolchain-check"];
    let _ = process.run_capture(argv, process.environ());
    let combined = process.capture_take_stdout() + process.capture_take_stderr();
    return _selfhost_contains(combined, "Hello, Sailfin!");
}

fn handle_selfhost_command(args: string[], binary_dir: string) -> int ![io] {
    let mut cfg = _selfhost_default_config();
    let mut led = _selfhost_new_ledger();

    let mut argi: int = 1;
    loop {
        if argi >= args.length { break; }
        let arg = args[argi];
        if strings_equal(arg, "-h") || strings_equal(arg, "--help") {
            print(_selfhost_usage());
            return 0;
        } else if strings_equal(arg, "--json") { cfg.json = true; } else if strings_equal(arg, "--no-promote") {
            cfg.no_promote = true;
        } else if strings_equal(arg, "--strict") { cfg.strict = true; } else if strings_equal(arg, "--skip-toolchain-check") {
            // Accepted and ignored: `cli/main.sfn::_v2_argv_has_skip_flag`
            // already stood rank 4 (per-user default dispatch) down on this
            // flag before this parser ran (SFN-1068 / SFEP-0073 §3.3). This
            // parser's only job is to not reject it.
        } else if strings_equal(arg, "--work-dir") {
            argi += 1;
            if argi >= args.length {
                print.err("[selfhost] --work-dir requires a value");
                return 2;
            }
            cfg.work_dir = args[argi];
        } else if strings_equal(arg, "--first-pass") {
            argi += 1;
            if argi >= args.length {
                print.err("[selfhost] --first-pass requires a value");
                return 2;
            }
            cfg.first_pass = args[argi];
        } else if strings_equal(arg, "--seedcheck-out") {
            argi += 1;
            if argi >= args.length {
                print.err("[selfhost] --seedcheck-out requires a value");
                return 2;
            }
            cfg.seedcheck_out = args[argi];
        } else if strings_equal(arg, "--stage3-out") {
            argi += 1;
            if argi >= args.length {
                print.err("[selfhost] --stage3-out requires a value");
                return 2;
            }
            cfg.stage3_out = args[argi];
        } else if strings_equal(arg, "--promote-to") {
            argi += 1;
            if argi >= args.length {
                print.err("[selfhost] --promote-to requires a value");
                return 2;
            }
            cfg.promote_to = args[argi];
        } else if strings_equal(arg, "--smoke-timeout") {
            argi += 1;
            if argi >= args.length {
                print.err("[selfhost] --smoke-timeout requires a value");
                return 2;
            }
            cfg.smoke_timeout = args[argi];
        } else {
            print.err("[selfhost] unknown argument: " + arg);
            print(_selfhost_usage());
            return 2;
        }
        argi += 1;
    }

    // Derived per-stage roots under `--work-dir`. The scoped compiler modules
    // use one canonical per-capsule tree and are snapshotted between stages;
    // each stage retains an isolated top-level/runtime scratch tree.
    let s2_work = cfg.work_dir + "/native-seedcheck";
    let s2_scratch = s2_work + "/scratch";
    let s2_capsules = _selfhost_compiler_ir_dir();
    let s2_runtime = s2_work + "/sailfin";
    let s3_work = cfg.work_dir + "/native-stage3";
    let s3_scratch = s3_work + "/scratch";
    let s3_capsules = _selfhost_compiler_ir_dir();
    let s3_runtime = s3_work + "/sailfin";

    // Both stages link to the SAME basename (`sfn`), only in different
    // stage directories: on macOS, ld64's ad-hoc code signature embeds
    // the linked output's basename as its identifier, so linking stage2
    // and stage3 to different basenames (`sfn-seedcheck` vs
    // `sfn-stage3`) makes their binaries diverge even when every emitted
    // `.ll` module is byte-identical, making `binary_match` structurally
    // unsatisfiable (SFN-87 / #1726). Linking both to `sfn` and copying
    // the result out afterward keeps the two stages' signatures aligned
    // while preserving `cfg.seedcheck_out` / `cfg.stage3_out` for every
    // existing external consumer (a `sfn test` run pointed at the
    // promoted binary, `--promote-to`).
    //
    // The link lands under a `bin/` subdirectory, not directly in
    // `<stage_work>`: `<stage_work>/sailfin` is the runtime/driver cache
    // DIRECTORY (`_resolve_sailfin_cache_dir_for_work`), so a sibling
    // `<stage_work>/sfn` binary collides with nothing today but running
    // it fails downstream lookups that expect `sailfin` to be a
    // directory next to the binary — proven by a local repro where
    // hashing the linked path errored "Is a directory" and the
    // seedcheck binary could not stage its own runtime sfn-source
    // import context. `<stage_work>/bin/sfn` keeps the same basename
    // property while removing that sibling collision.
    let s2_bin_dir = s2_work + "/bin";
    let s3_bin_dir = s3_work + "/bin";
    let s2_linked_bin = host_exe_name(s2_bin_dir + "/sfn");
    let s3_linked_bin = host_exe_name(s3_bin_dir + "/sfn");

    if !fs.exists(cfg.first_pass) {
        print.err("[selfhost] first-pass binary missing: " + cfg.first_pass
            + " (run: sfn dev bootstrap build)");
        led.phases.push(SelfhostPhase {
            name: "preflight", status: "fail", exit_code: 1
        });
        led.failed_phase = "preflight";
        return _selfhost_finish(cfg, led, 1);
    }

    // ---- stage2 (seedcheck): built by the first-pass binary ----
    if !cfg.json { print("[selfhost] building stage2 (seedcheck)..."); }
    _ensure_dir_recursive_cmd(s2_bin_dir);
    let s2_rc = _selfhost_build_stage(cfg.first_pass, s2_scratch, s2_work, s2_linked_bin);
    if s2_rc != 0 {
        print.err("[selfhost] stage2 build failed (exit=" + int_to_string(s2_rc)
            + ")");
        led.phases.push(SelfhostPhase {
            name: "stage2", status: "fail", exit_code: s2_rc
        });
        led.failed_phase = "stage2";
        return _selfhost_finish(cfg, led, s2_rc);
    }
    // `_selfhost_build_stage` only ensures `work_subdir` exists; the copy
    // destination's parent is a caller-supplied path (`--seedcheck-out`)
    // that the spawned build never creates, unlike its own `-o` parent
    // (`build.sfn:303`'s `_ensure_dir`).
    _ensure_dir_recursive_cmd(_dirname_cmd(cfg.seedcheck_out));
    if !_selfhost_promote_binary(s2_linked_bin, cfg.seedcheck_out) {
        print.err("[selfhost] failed to copy stage2 binary → " + cfg.seedcheck_out);
        led.phases.push(SelfhostPhase {
            name: "stage2", status: "fail", exit_code: 1
        });
        led.failed_phase = "stage2";
        return _selfhost_finish(cfg, led, 1);
    }
    // A stage that contributes zero `.ll` files from its sailfin cache dir
    // silently drops that coverage from the fixed-point diff below without
    // affecting `matched` — a false "all clear". We just built this stage,
    // so a wrong `s2_runtime` path or a cache path that skipped `.ll`
    // emission is worth surfacing immediately.
    if _selfhost_collect_ll_files(s2_runtime).length == 0 {
        print.err("[selfhost] WARNING: stage2 contributed zero .ll modules from its "
            + "sailfin cache dir "
            + s2_runtime
            + " — that coverage in the "
            + "fixed-point diff is not effective");
    }
    if !_selfhost_has_compiler_ir(s2_capsules) {
        print.err("[selfhost] stage2 produced zero compiler IR modules under "
            + s2_capsules
            + " — refusing a vacuous fixed-point check");
        led.phases.push(SelfhostPhase {
            name: "stage2", status: "fail", exit_code: 1
        });
        led.failed_phase = "stage2";
        return _selfhost_finish(cfg, led, 1);
    }

    led.phases.push(SelfhostPhase {
        name: "stage2", status: "pass", exit_code: 0
    });

    // ---- smoke gate: seedcheck binary runs a real program ----
    if !cfg.json {
        print("[selfhost] validating seedcheck binary runs hello-world...");
    }
    if !_selfhost_smoke(cfg.seedcheck_out) {
        print.err("[selfhost] seedcheck binary cannot run hello-world.sfn"
            + " (expected 'Hello, Sailfin!')");
        print.err("[selfhost] the seedcheck compiler is NOT viable — fix the compiler");
        led.phases.push(SelfhostPhase {
            name: "seedcheck-smoke", status: "fail", exit_code: 1
        });
        led.failed_phase = "seedcheck-smoke";
        return _selfhost_finish(cfg, led, 1);
    }

    led.phases.push(SelfhostPhase {
        name: "seedcheck-smoke", status: "pass", exit_code: 0
    });

    // The scoped compiler IR tree is canonical rather than work-dir-local.
    // Capture stage2 before the stage3 build clears and repopulates it.
    let snap2 = _selfhost_snapshot(s2_capsules, s2_runtime, s2_linked_bin);

    // ---- stage3: built by the stage2 (seedcheck) binary ----
    if !cfg.json {
        print("[selfhost] building stage3 (driven by seedcheck) for fixed-point check...");
    }
    _ensure_dir_recursive_cmd(s3_bin_dir);
    let s3_rc = _selfhost_build_stage(cfg.seedcheck_out, s3_scratch, s3_work, s3_linked_bin);
    if s3_rc != 0 {
        print.err("[selfhost] stage3 build failed (exit=" + int_to_string(s3_rc)
            + ")");
        led.phases.push(SelfhostPhase {
            name: "stage3", status: "fail", exit_code: s3_rc
        });
        led.failed_phase = "stage3";
        return _selfhost_finish(cfg, led, s3_rc);
    }
    _ensure_dir_recursive_cmd(_dirname_cmd(cfg.stage3_out));
    if !_selfhost_promote_binary(s3_linked_bin, cfg.stage3_out) {
        print.err("[selfhost] failed to copy stage3 binary → " + cfg.stage3_out);
        led.phases.push(SelfhostPhase {
            name: "stage3", status: "fail", exit_code: 1
        });
        led.failed_phase = "stage3";
        return _selfhost_finish(cfg, led, 1);
    }
    if _selfhost_collect_ll_files(s3_runtime).length == 0 {
        print.err("[selfhost] WARNING: stage3 contributed zero .ll modules from its "
            + "sailfin cache dir "
            + s3_runtime
            + " — that coverage in the "
            + "fixed-point diff is not effective");
    }
    if !_selfhost_has_compiler_ir(s3_capsules) {
        print.err("[selfhost] stage3 produced zero compiler IR modules under "
            + s3_capsules
            + " — refusing a vacuous fixed-point check");
        led.phases.push(SelfhostPhase {
            name: "stage3", status: "fail", exit_code: 1
        });
        led.failed_phase = "stage3";
        return _selfhost_finish(cfg, led, 1);
    }

    // ---- fixed-point diff: stage2 vs stage3 ----
    // Hashed from the same-basename linked paths, not `cfg.seedcheck_out`
    // / `cfg.stage3_out` — those differ only by copy destination, but the
    // whole point of the same-basename link is that the *linked* outputs
    // carry an aligned ad-hoc signature.
    let snap3 = _selfhost_snapshot(s3_capsules, s3_runtime, s3_linked_bin);
    let diff = compare_for_determinism(snap2, snap3);

    // `diff.matched` also folds in `binary_match`, which is NOT a
    // reliable divergence signal on macOS (see `_selfhost_snapshot`'s
    // header comment, SFN-87 / #1726): ld64's ad-hoc code signature can
    // make byte-identical `.ll` inputs link to different binary shas for
    // reasons unrelated to the compiler's fixed-point property. Gate the
    // human-readable status and `--strict` on `module_diffs`, the
    // authoritative IR-level check, so a binary-only divergence never
    // reads as "not yet a fixed point".
    let ir_matched = diff.module_diffs.length == 0;

    led.phases.push(SelfhostPhase {
        name: "stage3", status: "pass", exit_code: 0
    });
    led.fixed_point_checked = true;
    led.fixed_point = ir_matched;
    led.binary_match = diff.binary_match;
    led.determinism_json = determinism_diff_to_json(diff);
    if ir_matched {
        led.phases.push(SelfhostPhase {
            name: "fixed-point", status: "pass", exit_code: 0
        });
    } else {
        // Recorded as a phase failure so the supervisor can name it; the
        // process exit code stays 0 unless `--strict`, matching the
        // warn-by-default policy below.
        led.phases.push(SelfhostPhase {
            name: "fixed-point", status: "fail", exit_code: 0
        });
        led.failed_phase = "fixed-point";
    }

    if !cfg.json {
        if diff.matched {
            print("[selfhost] stage2 == stage3: compiler is a fixed point");
        } else if ir_matched {
            print("[selfhost] stage2 == stage3: every module IR digest matched");
        } else {
            print("[selfhost] stage2 != stage3: compiler output is not yet a fixed point");
        }
        print(determinism_diff_to_text(diff));
    }

    if ir_matched && !diff.binary_match {
        print.err("[selfhost] WARNING: all module IR matched but the linked "
            + "binary sha256 differs — on macOS this is expected ld64/"
            + "ad-hoc-codesign packaging variance, not an IR fixed-point "
            + "failure (SFN-87 / #1726). Non-fatal, including under --strict.");
    }

    // ---- exit / promotion policy ----
    // Default (warn): a real IR mismatch is non-fatal — promote the
    // validated seedcheck binary and exit 0, exactly as the Makefile did.
    // Strict: a real IR mismatch fails (exit 1) and we do NOT promote a
    // non-fixed-point binary. A binary-sha-only divergence (IR matched)
    // is never fatal, even under --strict — see the WARNING above.
    if !ir_matched && cfg.strict {
        print.err("[selfhost] --strict: fixed-point mismatch is fatal");
        return _selfhost_finish(cfg, led, 1);
    }

    if !cfg.no_promote {
        _ensure_dir_recursive_cmd(_dirname_cmd(cfg.promote_to));
        if !_selfhost_promote_binary(cfg.seedcheck_out, cfg.promote_to) {
            print.err("[selfhost] failed to promote seedcheck → " + cfg.promote_to);
            led.phases.push(SelfhostPhase {
                name: "promote", status: "fail", exit_code: 1
            });
            // First failure wins. A non-fatal `fixed-point` mismatch
            // records itself and deliberately CONTINUES into promotion, so
            // this is the one site that can overwrite an already-recorded
            // failure — and the mismatch is the more diagnostic of the two.
            if led.failed_phase.length == 0 { led.failed_phase = "promote"; }
            return _selfhost_finish(cfg, led, 1);
        }
        if !cfg.json {
            print("[selfhost] promoted seedcheck → " + cfg.promote_to);
        }
    }

    return _selfhost_finish(cfg, led, 0);
}

export {
    handle_selfhost_command,
    // Exported for regression coverage (compiler/tests/{unit,integration}).
    _selfhost_basename,
    _selfhost_collect_ll_files,
    _selfhost_compiler_ir_dir,
    _selfhost_has_compiler_ir,
    _selfhost_relative_ll_slug,
    _selfhost_contains,
    _selfhost_env_entry_has_key,
    _selfhost_promote_binary,
    _selfhost_remove_tree,
    _selfhost_snapshot,
    _selfhost_stage_argv,
    _selfhost_stage_env
};
