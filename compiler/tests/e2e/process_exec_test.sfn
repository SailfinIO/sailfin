// compiler/tests/e2e/process_exec_test.sfn
//
// The `process.exec` (`execve(2)`) runtime primitive — the seed-blocker
// predecessor for SFN-172 toolchain re-exec dispatch (SFEP-0046 §3.5).
// `process.exec(argv, env_flat)` replaces the current process image on
// POSIX; on Windows (`runtime/sfn/platform/process_windows.sfn::sfn_process_exec`)
// there is no such primitive, so it spawns the child onto the parent's
// stdio, waits, and exits with the child's code instead — the same
// OBSERVABLE contract by a different mechanism. These tests pin that
// contract end-to-end (parse → typecheck → effect → emit → lower → link →
// run) with two fixtures the test builds itself, so neither leg depends on
// a POSIX-only path:
//
//   `target`: prints a marker and returns 0 — the exec target.
//   `main`: execs `argv[1]` (the built `target` path) and, only if
//     `process.exec` RETURNS, prints a fallback marker and exits 42.
//
//   1. exec succeeds: the marker reaches stdout, the fallback line never
//      runs, and the observed exit code is `target`'s (0), not `main`'s.
//   2. exec of a nonexistent path: `process.exec` returns, so `main`'s
//      fallback path runs and its own exit code (42) is observed.
import { find } from "sfn/strings";
import {
    clean_runner_env,
    report_child_failure,
    report_child_failure_pending,
    scratch_root,
    sfn_bin_path
} from "sfn/test";

// Child env for the nested `sfn build` and the built binaries: derived by
// subtraction from the real environment rather than a hand-rolled allowlist
// (SFN-1114).
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

// Build `src` to `binpath` with the compiler-under-test; returns the build
// exit code. Threads the child env so the nested clang/link finds its tools.
fn _build_fixture(src: string, binpath: string) -> int ![io] {
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", binpath, src], _child_env());
    report_child_failure_pending("process-exec build " + src, exit);
    return exit;
}

// `-o` is honoured verbatim, so on Windows the built file may carry a
// `.exe` suffix the base path did not ask for. Both spellings are probed
// rather than branching on the host.
fn _built_path(base: string) -> string ![io] {
    if fs.exists(base + ".exe") { return base + ".exe"; }
    return base;
}

test "process.exec: replaces the image with a built exec target" ![io] {
    let root = scratch_root() + "/sfn-process-exec-ok";
    fs.createDirectory(root, true);

    let target_src = root + "/target.sfn";
    fs.writeFile(target_src, "fn main() -> int ![io] {\n"
        + "    print(\"SFN172_EXEC_OK\");\n"
        + "    return 0;\n"
        + "}\n");
    let target_build = _build_fixture(target_src, root + "/target");
    assert target_build == 0;
    let target_bin = _built_path(root + "/target");

    let main_src = root + "/main.sfn";
    // The exec target arrives through argv[1], never spliced into the
    // source text: a spliced Windows backslash path would go through
    // string-literal escape decoding and silently rewrite itself
    // (`fs_copy_binary_test.sfn`, SFN-1001).
    fs.writeFile(main_src, "fn main(argv: string[]) -> int ![io] {\n"
        + "    let e: string[] = process.environ();\n"
        + "    let _rc = process.exec([argv[1]], e);\n"
        + "    print.err(\"SFN172_EXEC_FALLBACK\");\n"
        + "    return 42;\n"
        + "}\n");
    let main_build = _build_fixture(main_src, root + "/main");
    assert main_build == 0;
    let main_bin = _built_path(root + "/main");

    let run_exit = process.run_capture([main_bin, target_bin], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("process-exec run target-ok", run_exit, out, err);
    // Image was replaced by `target`: its exit code (0) is observed, its
    // stdout carries the marker, and `main`'s post-exec fallback never ran.
    assert run_exit == 0;
    assert find(out, "SFN172_EXEC_OK", 0) >= 0;
    assert find(out + err, "SFN172_EXEC_FALLBACK", 0) < 0;
}

test "process.exec: returns on a failed exec (image not replaced)" ![io] {
    let root = scratch_root() + "/sfn-process-exec-fail";
    fs.createDirectory(root, true);

    let main_src = root + "/main.sfn";
    fs.writeFile(main_src, "fn main(argv: string[]) -> int ![io] {\n"
        + "    let e: string[] = process.environ();\n"
        + "    let _rc = process.exec([argv[1]], e);\n"
        + "    print.err(\"SFN172_EXEC_FALLBACK\");\n"
        + "    return 42;\n"
        + "}\n");
    let main_build = _build_fixture(main_src, root + "/main");
    assert main_build == 0;
    let main_bin = _built_path(root + "/main");

    // A path under this test's own scratch root that nothing creates,
    // rather than a hard-coded POSIX path like `/nonexistent/...`.
    let absent = scratch_root() + "/sfn172-absent/does-not-exist";
    assert ! fs.exists(absent);

    let run_exit = process.run_capture([main_bin, absent], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    // The image was not replaced: `main` continued past the failed exec,
    // printed its fallback marker, and returned its own exit code.
    assert run_exit == 42;
    assert find(out + err, "SFN172_EXEC_FALLBACK", 0) >= 0;
}
