// End-to-end coverage for SFN-680: `sfn dev clean build|dist|all` as the
// native replacement for `make clean-build` / `make clean` / `make
// clean-all`. Native (no-bash) `*_test.sfn` per `.claude/rules/no-bash-e2e.md`:
// it builds a fully synthetic repo in a scratch dir and drives the
// compiler-under-test against it as cwd — no real build tree is ever
// touched.
import { remove_all } from "sfn/fs";
import { find } from "sfn/strings";
import {
    clean_runner_env,
    clean_runner_env_without,
    default_scratch_dir,
    nested_runner_scratch,
    sfn_bin_abs_path
} from "sfn/test";

import { _clean_abs_with, _clean_guard_cache_root_from, _clean_target_ok } from "../../src/cli/commands/dev_clean";

// A per-invocation scratch root for a synthetic repo. `SAILFIN_TEST_SCRATCH`
// keeps it unique under the parallel pool; `/tmp` is the standalone fallback.
fn _scratch_repo(name: string) -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    return dir + "/" + name;
}

fn _write_bootstrap_toml(repo: string) -> void ![io] {
    fs.writeFile(repo + "/bootstrap.toml", "[seed]\n" + "version = \"0.0.0\"\n"
        + "source = \"github-release\"\n"
        + "repo = \"SailfinIO/sailfin\"\n"
        + "asset_prefix = \"sailfin\"\n"
        + "policy = \"exact\"\n\n"
        + "[store]\n"
        + "install_base = \"build/toolchains/seed/versions\"\n"
        + "bin_dir = \"build/toolchains/seed/bin\"\n");
}

fn _write_local_path_bootstrap_toml(repo: string) -> void ![io] {
    fs.writeFile(repo + "/bootstrap.toml", "[seed]\n" + "version = \"0.0.0\"\n"
        + "source = \"local-path\"\n"
        + "repo = \"SailfinIO/sailfin\"\n"
        + "asset_prefix = \"sailfin\"\n"
        + "policy = \"exact\"\n\n"
        + "[store]\n"
        + "install_base = \"build/toolchains/seed/versions\"\n"
        + "bin_dir = \"build/toolchains/seed/bin\"\n");
}

// Populate a fresh synthetic repo at `repo` with the bootstrap manifest plus
// the marker files each test asserts on: `build/native`, `build/sailfin`,
// the seed store stand-in `build/toolchains/seed/bin`, and `dist`.
fn _seed_repo(repo: string) -> void ![io] {
    assert remove_all(repo);
    fs.createDirectory(repo, true);
    _write_bootstrap_toml(repo);
    fs.createDirectory(repo + "/build/native", true);
    fs.writeFile(repo + "/build/native/marker.txt", "native\n");
    fs.createDirectory(repo + "/build/sailfin", true);
    fs.writeFile(repo + "/build/sailfin/marker.txt", "sailfin\n");
    fs.createDirectory(repo + "/build/toolchains/seed/bin", true);
    fs.writeFile(repo + "/build/toolchains/seed/bin/marker.txt", "seed\n");
    fs.createDirectory(repo + "/dist", true);
    fs.writeFile(repo + "/dist/marker.txt", "dist\n");
}

// --------------------------------------------------------------
// Pure absoluteness-check coverage (SFN-704). `_clean_target_ok`,
// `_clean_abs_with`, and `_clean_guard_cache_root_from` were POSIX-only
// (`starts_with(x, "/")`), so a Windows drive-absolute path was
// misclassified as relative. Exercised directly rather than through the
// subprocess-driven tests below, since these are pure string logic with
// no host dependency.
// --------------------------------------------------------------
test "dev clean: _clean_target_ok rejects a drive-absolute target" {
    assert ! _clean_target_ok("C:/repo/build/native");
    assert ! _clean_target_ok("C:\\repo\\build\\native");
    assert _clean_target_ok("build/native");
}

test "dev clean: _clean_abs_with treats a drive-absolute path as already absolute" {
    // A POSIX-only check would have prefixed the cwd onto this, producing
    // a nonsense joined path instead of leaving the drive-absolute path
    // untouched.
    assert _clean_abs_with("/home/dev/repo", "C:/Users/foo/build") == "C:/Users/foo/build";
    assert _clean_abs_with("/home/dev/repo", "build/native") == "/home/dev/repo/build/native";
}

test "dev clean: cache-root guard recognizes a drive-absolute root" {
    // The highest-stakes site: on a native Windows host, `cache_root("")`
    // can legitimately be drive-absolute via HOME (build_cache.sfn:692). A
    // POSIX-only check misread it as the relative repo-local case and
    // disabled the guard entirely.
    let guarded = _clean_guard_cache_root_from("/home/dev/repo", "C:/Users/foo/.cache/sailfin/v2");
    assert guarded == "C:/Users/foo/.cache/sailfin/v2";
}

test "dev clean: cache-root guard recognizes a POSIX-absolute root" {
    let guarded = _clean_guard_cache_root_from("/home/dev/repo", "/home/dev/.cache/sailfin/v2");
    assert guarded == "/home/dev/.cache/sailfin/v2";
}

// Verified negative: a genuinely relative root (containers, `env -i`,
// systemd units — build_cache.sfn:637-666, no XDG_CACHE_HOME/HOME) must
// keep returning "" so the guard stays off and `build/cache` is still
// wiped on those hosts. A regression here silently leaves stale cache
// content behind while reporting success.
test "dev clean: cache-root guard leaves a genuinely relative root unguarded" {
    assert _clean_guard_cache_root_from("/home/dev/repo", "build/cache/v2") == "";
}

test "dev clean: dry-run removes nothing" ![io] {
    let repo = _scratch_repo("dev-clean-dry-run");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_dry_run"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build", "--dry-run"], child_env, repo);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert find(out, "would remove: build/native", 0) >= 0;
    assert find(out, "would remove: build/sailfin", 0) >= 0;
    // The seed store must not be on the removal list. It IS named on the
    // "preserved" line, so this pins the verb, not the mere mention.
    assert find(out, "would remove: build/toolchains", 0) < 0;
    assert find(out, "preserved: build/toolchains", 0) >= 0;
    assert fs.exists(repo + "/build/native/marker.txt");
    assert fs.exists(repo + "/build/sailfin/marker.txt");
    assert fs.exists(repo + "/build/toolchains/seed/bin/marker.txt");
    assert fs.exists(repo + "/dist/marker.txt");

    assert remove_all(repo);
}

test "dev clean: preserves the seed store" ![io] {
    let repo = _scratch_repo("dev-clean-preserve-seed");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_preserve_seed"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert ! fs.exists(repo + "/build/native/marker.txt");
    assert ! fs.exists(repo + "/build/sailfin/marker.txt");
    assert fs.exists(repo + "/build/toolchains/seed/bin/marker.txt");
    assert fs.exists(repo + "/dist/marker.txt");

    assert remove_all(repo);
}

test "dev clean: --include-seed removes the seed store" ![io] {
    let repo = _scratch_repo("dev-clean-include-seed");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_include_seed"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build", "--include-seed"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert ! fs.exists(repo + "/build/toolchains");

    assert remove_all(repo);
}

test "dev clean: env opt-out removes the seed store" ![io] {
    let repo = _scratch_repo("dev-clean-keep-seed-env");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    // `_without` rather than a bare `clean_runner_env` push: the plain helper
    // strips only pool-managed keys, so it inherits an ambient
    // SAILFIN_CLEAN_KEEP_SEED — and under first-match `getenv` an exported
    // `=1` would win over the push below and fail this test (SFN-1252).
    let mut child_env = clean_runner_env_without(nested_runner_scratch("dev_clean_keep_seed_env"), ["SAILFIN_CLEAN_KEEP_SEED"]);
    child_env.push("SAILFIN_CLEAN_KEEP_SEED=0");

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert ! fs.exists(repo + "/build/toolchains");

    assert remove_all(repo);
}

test "dev clean: dist clean removes dist" ![io] {
    let repo = _scratch_repo("dev-clean-dist");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_dist"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "dist"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert ! fs.exists(repo + "/dist");
    assert fs.exists(repo + "/build/native/marker.txt");

    assert remove_all(repo);
}

test "dev clean: absent build tree is a no-op" ![io] {
    let repo = _scratch_repo("dev-clean-absent-tree");
    _seed_repo(repo);
    assert remove_all(repo + "/build");
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_absent_tree"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build"], child_env, repo);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert find(out + err, "error", 0) < 0;
    assert find(out, "nothing to remove (build tree absent)", 0) >= 0;
    assert ! fs.exists(repo + "/build");

    assert remove_all(repo);
}

test "dev clean: preserved store name comes from the bootstrap manifest" ![io] {
    let repo = _scratch_repo("dev-clean-custom-store");
    assert remove_all(repo);
    fs.createDirectory(repo, true);
    fs.writeFile(repo + "/bootstrap.toml", "[seed]\n" + "version = \"0.0.0\"\n"
        + "source = \"github-release\"\n"
        + "repo = \"SailfinIO/sailfin\"\n"
        + "asset_prefix = \"sailfin\"\n"
        + "policy = \"exact\"\n\n"
        + "[store]\n"
        + "install_base = \"build/seedstore/versions\"\n"
        + "bin_dir = \"build/seedstore/bin\"\n");
    fs.createDirectory(repo + "/build/seedstore/bin", true);
    fs.writeFile(repo + "/build/seedstore/bin/marker.txt", "seed\n");
    fs.createDirectory(repo + "/build/toolchains", true);
    fs.writeFile(repo + "/build/toolchains/marker.txt", "toolchains\n");
    fs.createDirectory(repo + "/build/native", true);
    fs.writeFile(repo + "/build/native/marker.txt", "native\n");
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_custom_store"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    // The derived store (build/seedstore) survives...
    assert fs.exists(repo + "/build/seedstore/bin/marker.txt");
    // ...but build/toolchains does not, proving the preserved child is read
    // from the manifest rather than hardcoded to "toolchains".
    assert ! fs.exists(repo + "/build/toolchains");
    assert ! fs.exists(repo + "/build/native/marker.txt");

    assert remove_all(repo);
}

test "dev clean: a symlinked build child is unlinked, not followed" ![io] {
    let repo = _scratch_repo("dev-clean-symlink-repo");
    _seed_repo(repo);
    let outside = _scratch_repo("dev-clean-symlink-outside");
    assert remove_all(outside);
    fs.createDirectory(outside, true);
    fs.writeFile(outside + "/treasure.txt", "treasure\n");
    process.run(["ln", "-s", outside, repo + "/build/link"]);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_symlink"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert fs.exists(outside + "/treasure.txt");
    // `fs.exists` follows symlinks, so it cannot tell us whether the link
    // node itself is gone (it would report the same "absent" result whether
    // the walk unlinked the symlink or dereferenced and deleted through it).
    // Probe the link node directly instead.
    let link_exit = process.run_capture(["test", "-L", repo + "/build/link"], []);
    let _link_out = process.capture_take_stdout();
    let _link_err = process.capture_take_stderr();
    assert link_exit != 0;

    assert remove_all(repo);
    assert remove_all(outside);
}

test "dev clean: all removes both trees" ![io] {
    let repo = _scratch_repo("dev-clean-all");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_all"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "all"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert ! fs.exists(repo + "/build/native/marker.txt");
    assert ! fs.exists(repo + "/dist");
    assert fs.exists(repo + "/build/toolchains/seed/bin/marker.txt");

    assert remove_all(repo);
}

test "dev clean: refuses to run outside a compiler checkout" ![io] {
    let repo = _scratch_repo("dev-clean-outside-checkout");
    assert remove_all(repo);
    fs.createDirectory(repo, true);
    fs.createDirectory(repo + "/build", true);
    fs.writeFile(repo + "/build/marker.txt", "marker\n");
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_clean_outside_checkout"));

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build"], child_env, repo);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "bootstrap.toml", 0) >= 0;
    assert fs.exists(repo + "/build/marker.txt");

    assert remove_all(repo);
}

// --------------------------------------------------------------
// `sfn dev bootstrap build --clean-tree` (SFN-1252). A synthetic repo has
// `bootstrap.toml` but no `workspace.toml`, so
// `compute_workspace_source_fingerprint` returns "" and
// `_dev_bootstrap_build` exits 1 with "could not compute the compiler
// source fingerprint" — after the clean, before any seed fetch or build.
// No network, no build.
// --------------------------------------------------------------
test "dev clean: bootstrap build --clean-tree wipes build/ and preserves the seed store" ![io] {
    let repo = _scratch_repo("dev-bootstrap-clean-tree");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_bootstrap_clean_tree"));

    let exit = process.run_capture_cwd([sfn, "dev", "bootstrap", "build", "--clean-tree"], child_env, repo);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 1;
    assert find(err, "could not compute the compiler source fingerprint", 0) >= 0;
    assert ! fs.exists(repo + "/build/native/marker.txt");
    assert ! fs.exists(repo + "/build/sailfin/marker.txt");
    assert fs.exists(repo + "/build/toolchains/seed/bin/marker.txt");
    assert fs.exists(repo + "/dist/marker.txt");

    assert remove_all(repo);
}

test "dev clean: bootstrap build --clean-tree ignores SAILFIN_CLEAN_KEEP_SEED" ![io] {
    let repo = _scratch_repo("dev-bootstrap-clean-tree-keep-seed-env");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let mut child_env = clean_runner_env_without(nested_runner_scratch("bootstrap_clean_keep_seed"), ["SAILFIN_CLEAN_KEEP_SEED"]);
    child_env.push("SAILFIN_CLEAN_KEEP_SEED=0");

    let exit = process.run_capture_cwd([sfn, "dev", "bootstrap", "build", "--clean-tree"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 1;
    // The seed store surviving is the point, but assert the wipe happened at
    // all — otherwise a regression making `--clean-tree` a no-op would pass
    // this test for the wrong reason.
    assert ! fs.exists(repo + "/build/native/marker.txt");
    assert fs.exists(repo + "/build/toolchains/seed/bin/marker.txt");

    assert remove_all(repo);
}

// The paired positive proving the pinning is scoped, not a global disable:
// the same env var reaches the direct `sfn dev clean build` surface and
// removes the seed store there.
test "dev clean: SAILFIN_CLEAN_KEEP_SEED=0 still reaches dev clean build" ![io] {
    let repo = _scratch_repo("dev-clean-build-keep-seed-env-scoped");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let mut child_env = clean_runner_env_without(nested_runner_scratch("clean_build_keep_seed_scoped"), ["SAILFIN_CLEAN_KEEP_SEED"]);
    child_env.push("SAILFIN_CLEAN_KEEP_SEED=0");

    let exit = process.run_capture_cwd([sfn, "dev", "clean", "build"], child_env, repo);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert ! fs.exists(repo + "/build/toolchains");

    assert remove_all(repo);
}

// Pins the parser's exact-match behaviour so a future prefix-matching change
// cannot silently alias `--clean` onto `--clean-tree` — `--clean` is the
// unrelated `sfn build`/`sfn run` content-addressed cache flag.
test "dev clean: bootstrap build rejects the cache-flag spelling" ![io] {
    let repo = _scratch_repo("dev-bootstrap-clean-flag-spelling");
    _seed_repo(repo);
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_bootstrap_clean_flag_spelling"));

    let exit = process.run_capture_cwd([sfn, "dev", "bootstrap", "build", "--clean"], child_env, repo);
    let _out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(err, "unknown flag --clean", 0) >= 0;
    assert fs.exists(repo + "/build/native/marker.txt");
    assert fs.exists(repo + "/build/sailfin/marker.txt");
    assert fs.exists(repo + "/build/toolchains/seed/bin/marker.txt");
    assert fs.exists(repo + "/dist/marker.txt");

    assert remove_all(repo);
}

// Pins the insertion point against a future reorder: a local-path seed is
// rejected before the clean phase runs, not after.
test "dev clean: bootstrap build --clean-tree removes nothing when the seed is local-path" ![io] {
    let repo = _scratch_repo("dev-bootstrap-clean-tree-local-path");
    assert remove_all(repo);
    fs.createDirectory(repo, true);
    _write_local_path_bootstrap_toml(repo);
    fs.createDirectory(repo + "/build/native", true);
    fs.writeFile(repo + "/build/native/marker.txt", "native\n");
    fs.createDirectory(repo + "/build/sailfin", true);
    fs.writeFile(repo + "/build/sailfin/marker.txt", "sailfin\n");
    fs.createDirectory(repo + "/build/toolchains/seed/bin", true);
    fs.writeFile(repo + "/build/toolchains/seed/bin/marker.txt", "seed\n");
    fs.createDirectory(repo + "/dist", true);
    fs.writeFile(repo + "/dist/marker.txt", "dist\n");
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_bootstrap_clean_tree_local_path"));

    let exit = process.run_capture_cwd([sfn, "dev", "bootstrap", "build", "--clean-tree"], child_env, repo);
    let _out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(err, "local-path", 0) >= 0;
    assert fs.exists(repo + "/build/native/marker.txt");
    assert fs.exists(repo + "/build/sailfin/marker.txt");
    assert fs.exists(repo + "/build/toolchains/seed/bin/marker.txt");
    assert fs.exists(repo + "/dist/marker.txt");

    assert remove_all(repo);
}

test "dev clean: bootstrap build --clean-tree removes nothing outside a compiler checkout" ![io] {
    let repo = _scratch_repo("dev-bootstrap-clean-tree-outside-checkout");
    assert remove_all(repo);
    fs.createDirectory(repo, true);
    fs.createDirectory(repo + "/build/native", true);
    fs.writeFile(repo + "/build/native/marker.txt", "native\n");
    let sfn = sfn_bin_abs_path();
    let child_env = clean_runner_env(nested_runner_scratch("dev_bootstrap_clean_tree_outside_checkout"));

    let exit = process.run_capture_cwd([sfn, "dev", "bootstrap", "build", "--clean-tree"], child_env, repo);
    let _out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    // Pin WHICH refusal fired. `exit != 0` plus a surviving marker is equally
    // satisfied by a dropped flag (argv rejected) and by the clean being
    // reordered ahead of the manifest checks — in the latter case
    // `clean_build_tree`'s own gate refuses, removing nothing. Both would pass
    // a bare exit assertion. The bootstrap manifest error must be the one
    // reported, and the `[clean]` prefix must be absent: its presence would
    // mean the wipe was attempted before the build refused.
    assert find(err, "bootstrap.toml: not found at", 0) >= 0;
    assert find(err, "[clean]", 0) < 0;
    assert fs.exists(repo + "/build/native/marker.txt");

    assert remove_all(repo);
}
