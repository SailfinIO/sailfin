// End-to-end regression for the LLVM instruction-drop fail-closed gate
// (SFN-528).
//
// `lower_instruction_range` used to diagnose `break` and `continue` outside a
// loop without tagging either diagnostic `[fatal]`. LLVM lowering then omitted
// the instruction, so an invalid control-flow side effect became a no-op and
// `sfn emit llvm` exited 0. These subprocess tests pin the non-zero exit and
// stderr diagnostic at both reachable consumption sites.
import { find } from "sfn/strings";
import {
    clean_runner_env,
    nested_runner_scratch,
    report_child_failure,
    sfn_bin_path
} from "sfn/test";

// The location half is SFN-536: the `NativeInstruction` for `break`/`continue`
// now carries the statement's span, so `render_lowering_error_diag` can append
// a `-->` line. Before that the diagnostic named only the enclosing function.
//
// Each case gets its own scratch and a clean child env (SFN-401). Threading
// `process.environ()` binds the nested `emit` to the parent pool's state, and a
// shared scratch lets concurrent compiles collide on `<cache-dir>/program.ll`.
// That is pool-only: it passes a serial run and fails under `--jobs N`. It bites
// the location assertion first, because a cross-contaminated `.sfn-asm` is
// span-less — fail-soft by design — so `-->` disappears while the older
// assertions still hold.
fn _assert_emit_fails_closed(label: string, name: string, source: string, diagnostic: string, location: string) ![io] {
    let scratch = nested_runner_scratch(label);
    fs.createDirectory(scratch, true);
    let path = scratch + "/" + name;
    fs.writeFile(path, source);

    let exit = process.run_capture([sfn_bin_path(), "emit", "llvm", path], clean_runner_env(scratch));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();

    if fs.exists(path) { fs.deleteFile(path); }

    if exit == 0 {
        report_child_failure(label, exit, out, err);
    }
    assert exit != 0;
    assert find(err, "llvm lowering [fatal] [E1003]:", 0) >= 0;
    assert find(err, diagnostic, 0) >= 0;
    if find(err, "-->", 0) < 0 {
        report_child_failure(label + " (no source location)", exit, out, err);
    }
    assert find(err, "-->", 0) >= 0;
    if find(err, location, 0) < 0 {
        report_child_failure(label + " (expected location " + location + ")", exit, out, err);
    }
    assert find(err, location, 0) >= 0;
}

// The keyword sits on its own line so the asserted location can only be the
// `break`/`continue`'s own span (4:9), never the enclosing `if`'s (3:5). Those
// two coincide on a single-line `if c { break; }`, which would let a diagnostic
// attributed to the wrong construct still satisfy the assertion.
test "lowering instruction gate: break outside loop fails closed" ![io] {
    _assert_emit_fails_closed("sfn528-break", "sfn528_break_outside_loop.sfn", "fn main() -> i32 {\n    let mut n: int = 1;\n    if n > 0 {\n        break;\n    }\n    return n;\n}\n", "`break` outside loop in `main`", ":4:9");
}

test "lowering instruction gate: continue outside loop fails closed" ![io] {
    _assert_emit_fails_closed("sfn528-continue", "sfn528_continue_outside_loop.sfn", "fn main() -> i32 {\n    let mut n: int = 1;\n    if n > 0 {\n        continue;\n    }\n    return n;\n}\n", "`continue` outside loop in `main`", ":4:9");
}
