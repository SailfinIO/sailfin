// End-to-end regression test for SFN-1202 — effect propagation across an
// inline `export { X } from "./Y"` re-export edge.
//
// The Reach pillar's claim is that the compiler derives a capability
// manifest and proves it *complete* (`CLAUDE.md`). A facade re-export that
// dropped its origin's effects would falsify that by construction: any
// function reachable only through a barrel could under-report its reach.
// The shape is live in the compiler's own sources — `cli/commands/dev.sfn`
// reaches `toolchain_install_to_base` through the inline re-export at
// `cli/commands/toolchain.sfn` — so this is load-bearing, not theoretical.
// The propagation holds today; what this file buys is a guard against it
// silently ceasing to.
//
// Silently is the operative word, and it is why the coverage is worth its
// runtime. An effect requirement that fails to reach a caller raises
// nothing: `_propagate_imported_callee_effects`
// (`compiler/capsules/analyzer/src/effect_checker/collector.sfn`) returns
// its accumulated requirements unchanged both when a callee does not
// resolve and when it resolves with no effects, so a lost requirement and
// a genuinely pure callee are the same observable outcome — a clean
// `sfn check`. A regression here does not announce itself; it just stops
// rejecting things.
//
// That failure mode was confirmed against these fixtures rather than
// assumed. With that propagation suppressed, all three under-declared
// callers below check `ok` and the three negative cases fail, while the
// positive control still passes — so the suite discriminates the
// behaviour it names instead of merely reacting to a broken compiler.
//
// SFN-1202 was filed believing the propagation was already broken, on the
// strength of a field case (SFN-1069) where three callers of a re-exported
// `![clock, io, net]` function kept declaring `![io, net]` and shipped
// green. That reproduces correctly on this compiler — restoring the
// narrow signatures yields `E0402 ... missing required effects: ![clock]`
// — so the original diagnosis did not survive, and `partial_caller.sfn`
// preserves that exact shape as the case most likely to matter.
//
// Note the code is E0402, not the E0400 the issue predicted. The promoting
// input is the requirement's *description prefix*, not the callee's module
// as such: `code_for_missing_effect_data`
// (`compiler/capsules/analyzer/src/effect_diagnostics.sfn`) promotes E0400
// to E0402 for a description carrying the `imported `…`` prefix, while a
// same-module local keeps a `local `…`` prefix and stays E0400. Each
// rejected case below asserts that prefix, which is what ties the
// diagnostic to cross-module propagation rather than to some other
// mechanism that happened to demand the same effect.
//
// Distinct from `export_from_test.sfn`, which builds and runs the same
// re-export shape to cover the *linker* shim (#508), and from
// `reexport_check_test.sfn`, which covers the bare `export { X };` form.
//
// `docs/conventions/e2e-tests.md` points "does this snippet produce
// diagnostic X" at `assert_does_not_compile`; that helper takes a single
// source string and cannot express a three-module relative-import chain,
// so these cases drive `sfn check` over on-disk fixtures instead.
//
// Effects are a check-time property, so nothing here is lowered to LLVM IR
// or linked: no `program.ll`, no `clang`, and none of the build-cache
// collision `export_from_test.sfn` guards against. (`sfn check` does stage
// the import closure to `.sfn-asm` under `build/compiler/import-context`,
// but those slugs are full source paths and so are unique to this
// fixture.) `SAILFIN_TEST_SCRATCH` is not consulted on the check path, so
// the child gets `clean_runner_env("")` — the pool-orchestration keys
// stripped, per SFN-401, without minting a scratch dir it would never use.
import { find } from "sfn/strings";
import {
    clean_runner_env,
    expect_contains_str,
    expect_eq_int,
    sfn_bin_path
} from "sfn/test";

// Fixture entry modules under `compiler/tests/e2e/fixtures/export_from_effects/`.
// Each is checked on its own so the resolved closure contains exactly the
// chain that case is about; the fixture carries its own `capsule.toml` to
// keep that closure independent of the compiler build cache (see the
// manifest's own description).
fn _fixture(name: string) -> string {
    return "compiler/tests/e2e/fixtures/export_from_effects/" + name;
}

// The outcome of one spawned `sfn check`: the child's exit status and its
// combined stdout+stderr, since the diagnostic body is what these cases
// assert on and the renderer is free to choose a stream.
struct _CheckRun {
    exit: int;
    output: string;
}

fn _run_check(entry: string) -> _CheckRun ![io] {
    let child_env = clean_runner_env("");
    let exit = process.run_capture([sfn_bin_path(), "check", _fixture(entry)], child_env);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    return _CheckRun { exit: exit, output: out + err };
}

// A rejected case must fail for the *stated* reason, so four things are
// required rather than a bare non-zero exit.
//
// The last is the one that makes the case about re-exports at all: the
// `imported `…`` prefix is written by `_propagate_imported_callee_effects`
// for a cross-module callee, so asserting it pins the requirement to
// import propagation. Without it, a future change that demanded the same
// effect through some unrelated mechanism would still satisfy the rest.
//
// The missing-effect match includes the closing bracket, which is what
// makes it a containment check rather than a non-emptiness one: the
// renderer comma-joins a multi-effect set, so `![clock]` cannot be
// satisfied by a rendered `![clock, io]`.
fn _assert_rejected(entry: string, callee: string, missing: string) -> void ![io] {
    let run = _run_check(entry);
    // Status alone would also be produced by a fixture that failed to
    // parse, so it is only the first of the four.
    assert run.exit != 0;
    assert expect_contains_str(run.output, "E0402").ok;
    assert expect_contains_str(run.output, "missing required effects: !["
        + missing
        + "]").ok;
    assert expect_contains_str(run.output, "imported `" + callee
        + "` declares !["
        + missing
        + "]").ok;
}

test "export-from-effects: a caller under-declaring a facade-reached effect is rejected" ![io] {
    // The one-hop shape: `undeclared_caller` -> `facade` -> `origin`, with
    // the caller declaring no effects against an `![io]` origin.
    _assert_rejected("undeclared_caller.sfn", "effect_probe_io", "io");
}

test "export-from-effects: a narrower effect row through a facade is rejected" ![io] {
    // The SFN-1069 shape verbatim: the caller declares a non-empty but
    // narrower row (`![io, net]`) than the facade-reached callee
    // (`![clock, io, net]`). A containment check that degraded into a
    // non-empty check would pass this while admitting the real defect.
    _assert_rejected("partial_caller.sfn", "effect_probe_multi", "clock");
}

test "export-from-effects: effects survive a chain of re-exports" ![io] {
    // Two hops: `chain_caller` -> `chain` -> `facade` -> `origin`. The
    // by-name lookup into the localized import table is hop-count
    // independent, but the closure staging it depends on is transitive, so
    // the extra edge is worth pinning separately.
    _assert_rejected("chain_caller.sfn", "effect_probe_io", "io");
}

test "export-from-effects: a correctly-declared caller through a facade checks clean" ![io] {
    // Positive control. Without it the three negative cases above would
    // still pass if `sfn check` rejected every fixture for some unrelated
    // reason — the failure mode a negative-only suite cannot see.
    let run = _run_check("declared_caller.sfn");
    assert expect_eq_int(run.exit, 0).ok;
    assert find(run.output, "E0402", 0) < 0;
}
