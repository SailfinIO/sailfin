// End-to-end coverage for the structured lowering diagnostic sidecar
// (SFEP-0061 S2, SFN-535).
import { find } from "sfn/strings";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

test "direct lowering failure renders code and source coordinates" ![io] {
    let mut scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length == 0 { scratch = "/tmp"; }
    fs.createDirectory(scratch, true);
    let source_path = scratch + "/sfn535_spanned_lowering_diag.sfn";
    if fs.exists(source_path) { fs.deleteFile(source_path); }
    fs.writeFile(source_path, "struct T { a: i32; }\n"
        + "fn broken(t: T) -> i32 {\n"
        + "    return t.nope;\n"
        + "}\n"
        + "fn main() -> i32 { return 0; }\n");

    let exit = process.run_capture([_sfn_bin(), "emit", "llvm", source_path], process.environ());
    let stdout = process.capture_take_stdout();
    let stderr = process.capture_take_stderr();
    let combined = stdout + stderr;

    assert exit != 0;
    assert find(combined, "llvm lowering [fatal] [E1002]:", 0) >= 0;
    assert find(combined, "sfn535_spanned_lowering_diag.sfn:3:", 0) >= 0;
}
