// compiler/tests/e2e/windows_runtime_siblings_test.sfn
//
// SFN-549: `runtime/sfn/platform/rlimit_windows.sfn`,
// `runtime/sfn/platform/rand_windows.sfn`, and the eight anchor-less appends
// (`realpath_windows.sfn`, `clock_windows.sfn`, `pthread_windows.sfn`,
// `popen_windows.sfn`, `mkstemp_windows.sfn`, `strcasestr_windows.sfn`,
// `opendir_windows.sfn` — added by SFN-903 — and `mkdtemp_windows.sfn` —
// added by SFN-993) are
// the native Windows runtime providers. SFN-1039 folds `sysconf` back into
// `pthread_windows.sfn` (its former standalone sibling only worked through a
// `[targets.x86_64-w64-mingw32]` manifest table the pinned seed cannot read).
// SFN-808 adds
// `runtime/sfn/platform/cert_roots_windows.sfn` to the same swap set, for
// the system `ROOT` certificate store reached through Crypt32. Pins that
// each module still emits clean LLVM IR for a Windows target and defines
// the symbol it provides — via a basename swap for rlimit/rand/cert_roots,
// and via a pure append for the eight anchor-less siblings
// (no POSIX `.sfn` counterpart to swap from) — in
// `target_condition_runtime_sfn_sources`
// (`compiler/src/build/target.sfn`). The native TLS stack (SFN-341) needs no
// OpenSSL, so there is no absent-OpenSSL Windows sibling to pin here.
//
// No-bash e2e (`.claude/rules/no-bash-e2e.md`): drives `sfn emit llvm`
// under `SAILFIN_TARGET_OS=Windows` as a subprocess and asserts on the
// captured `.ll` text with `sfn/strings::contains`.
import { contains } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch, sfn_bin_path } from "sfn/test";

// Emit `src` for a Windows target into a fresh scratch dir, returning the
// emitted IR text, or "" on any failure (non-zero exit, missing output).
// `label` distinguishes the nested scratch dir per test.
fn _emit_windows(src: string, label: string) -> string ![io] {
    let scratch = nested_runner_scratch(label);
    fs.createDirectory(scratch, true);
    let mut child_env = clean_runner_env(scratch);
    child_env.push("SAILFIN_TARGET_OS=Windows");
    let ll = scratch + "/out.ll";
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", ll, "llvm", src], child_env);
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return ""; }
    if !fs.exists(ll) { return ""; }
    return fs.readFile(ll);
}

test "windows siblings: rlimit_windows.sfn emits and defines apply_default_mem_limit" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/rlimit_windows.sfn", "rlimit-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i32 @apply_default_mem_limit()");
}

test "windows siblings: terminal_windows.sfn emits and defines sfn_stream_is_terminal" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/terminal_windows.sfn", "terminal-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i1 @sfn_stream_is_terminal(");
    assert contains(ir, "declare i32 @_isatty(");
}

// SFN-698: this module was a no-op returning 0 for as long as it existed,
// which left native Windows as the only platform running the compiler with no
// memory ceiling at all. Pin the job-object surface so a regression back to a
// pure pass-through fails here rather than on a host that runs out of RAM.
// The IR is emitted for a Windows target from any host, so this stays a
// Linux-runnable guard on code that only executes on Windows.
test "windows siblings: rlimit_windows.sfn arms a job-object memory budget" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/rlimit_windows.sfn", "rlimit-windows-jobobj");
    assert ir.length > 0;
    assert contains(ir, "declare i64 @CreateJobObjectA(");
    assert contains(ir, "declare i32 @SetInformationJobObject(");
    assert contains(ir, "declare i32 @AssignProcessToJobObject(");
    // The cap has to cover this process, not merely be configured — the
    // assignment is what makes the limit bind.
    assert contains(ir, "@GetCurrentProcess(");
}

test "windows siblings: rand_windows.sfn emits and defines sfn_rand_fill" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/rand_windows.sfn", "rand-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i32 @sfn_rand_fill(");
    assert contains(ir, "declare i32 @BCryptGenRandom(");
}

test "windows siblings: cert_roots_windows.sfn emits and defines sfn_cert_roots_blob" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/cert_roots_windows.sfn", "cert-roots-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i8* @sfn_cert_roots_blob(");
    assert contains(ir, "declare i64 @CertOpenSystemStoreA(");
    assert contains(ir, "declare i8* @CertEnumCertificatesInStore(");
    assert contains(ir, "declare i32 @CertCloseStore(");
}

test "windows siblings: realpath_windows.sfn emits and defines realpath" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/realpath_windows.sfn", "realpath-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i8* @realpath(");
    assert contains(ir, "declare i8* @_fullpath(");
    assert contains(ir, "declare i64 @CreateFileA(");
    assert contains(ir, "declare i32 @GetFinalPathNameByHandleA(");
    assert contains(ir, "call i32 @GetFinalPathNameByHandleA(");
    assert contains(ir, "declare i8* @memmove(");
    assert contains(ir, "call i8* @memmove(");
}

test "windows siblings: clock_windows.sfn emits and defines clock_gettime" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/clock_windows.sfn", "clock-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i32 @clock_gettime(");
    assert contains(ir, "declare void @GetSystemTimePreciseAsFileTime(");
}

// SFN-1039: sysconf folded back in from the deleted sysconf_windows.sfn
// (see the file header), so this pin now also covers @sysconf/@GetSystemInfo.
test "windows siblings: pthread_windows.sfn emits and defines pthread_mutex_init" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/pthread_windows.sfn", "pthread-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i32 @pthread_mutex_init(");
    assert contains(ir, "declare void @InitializeSRWLock(");
    assert contains(ir, "define i64 @sysconf(");
    assert contains(ir, "declare void @GetSystemInfo(");
}

test "windows siblings: popen_windows.sfn emits and defines popen" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/popen_windows.sfn", "popen-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i8* @popen(");
    assert contains(ir, "declare i8* @_popen(");
}

test "windows siblings: mkstemp_windows.sfn emits and defines mkstemp" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/mkstemp_windows.sfn", "mkstemp-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i32 @mkstemp(");
    // The suffix is now generated in-process from the pid and tick count and
    // the file is created with an exclusive `_open`, rather than asking
    // `_mktemp_s` for a name (SFN-1115). `_mktemp_s` returns the LOWEST free
    // `<letter><pid>` name in the directory, so removing a temp made the very
    // next mint hand back the identical path.
    //
    // Pinning the pid/tick seeds guards the uniqueness source, which is the
    // property that actually regressed. The previous pin — `declare i32
    // @_mktemp_s(` — asserted the presence of the defective call, so it could
    // only ever fail once the defect was fixed.
    assert contains(ir, "declare i32 @_open(");
    assert contains(ir, "declare i32 @GetCurrentProcessId(");
    assert contains(ir, "declare i32 @GetTickCount(");
    assert ! contains(ir, "@_mktemp_s(");
}

test "windows siblings: strcasestr_windows.sfn emits and defines strcasestr" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/strcasestr_windows.sfn", "strcasestr-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i8* @strcasestr(");
}

// SFN-903. These two symbols were the last undefined ones blocking the
// native MSVC self-host link — `_dir_is_enumerable` (`build/fs.sfn`) calls
// `opendir`, which is in no Microsoft library at all (unlike `close`, which
// links only because `oldnames.lib` aliases it to `_close`).
//
// `readdir` is deliberately absent from the sibling: the handle is a Win32
// `HANDLE`, not a POSIX `DIR*`, so a future caller gets a loud undefined
// symbol rather than silent misbehaviour. Asserting it is NOT defined keeps
// that decision from being quietly undone.
test "windows siblings: opendir_windows.sfn emits and defines opendir/closedir" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/opendir_windows.sfn", "opendir-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i8* @opendir(");
    assert contains(ir, "define i32 @closedir(");
    assert contains(ir, "declare i64 @FindFirstFileA(");
    assert contains(ir, "declare i32 @FindClose(");
    assert ! contains(ir, "define i8* @readdir(");
}

// SFN-993. `fs.mkdtemp` was a `false` stub on the Windows codegen leg;
// `mkdtemp` is now an ordinary `extern fn` satisfied by this sibling's
// `CreateDirectoryA` retry loop instead.
test "windows siblings: mkdtemp_windows.sfn emits and defines mkdtemp" ![io] {
    let ir = _emit_windows("runtime/sfn/platform/mkdtemp_windows.sfn", "mkdtemp-windows-emit");
    assert ir.length > 0;
    assert contains(ir, "define i8* @mkdtemp(");
    assert contains(ir, "declare i32 @CreateDirectoryA(");
    assert contains(ir, "declare i32 @GetLastError(");
}
