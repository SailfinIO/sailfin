// Native e2e regression for SFN-33: a pure-Sailfin `sfn/http` server keeps
// module-global state across requests in one process.
import { Env, env_from_current } from "sfn/os";
import { contains } from "sfn/strings";
import {
    Background,
    sfn_bin_path,
    wait_until,
    with_background
} from "sfn/test";

extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn realloc(ptr: *u8, new_size: usize) -> *u8;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

extern fn strlen(s: *u8) -> usize;

// `sfn_socket_open`, not the raw libc `socket` — on Windows every raw
// `socket()` call fails until `WSAStartup` runs in the process (SFN-1114):
// a probe of `socket(2, 1, 0)` here returns fd=-1 with
// `WSAGetLastError()` = 10093 (WSANOTINITIALISED). `sfn_socket_open`
// (`runtime/sfn/platform/socket_ops_windows.sfn`) is the runtime's socket
// creator and carries the `WSAStartup` call; its POSIX sibling
// (`socket_ops.sfn`) is a direct pass-through, so this is the correct
// symbol on every target, not a Windows-only substitution. Effect note:
// `socket_ops.sfn` is `net`-gated (`runtime/capsule.toml`
// `[sfn-source-gates]`), so `_su_connect` and every caller up to
// `_su_request`/the test declare `![net]` transitively (SFN-927 is the
// undefined-symbol failure mode otherwise).
extern fn sfn_socket_open(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

// `sfn_socket_send`/`sfn_socket_recv`, not the raw libc `send`/`recv` — on
// Windows `recv`/`send` return a 32-bit `int`, so an `-> i64` extern (needed
// to match the buffer-length parameter) sign-extends a `-1` failure return
// into `4294967295`, silently defeating every `if n < 0` guard (SFN-927).
// The runtime helpers carry an identical Sailfin signature on both
// platforms and do the width conversion internally.
extern fn sfn_socket_send(sockfd: i32, buf: *u8, len: i64, flags: i32) -> i64;

extern fn sfn_socket_recv(sockfd: i32, buf: *u8, len: i64, flags: i32) -> i64;

// `sfn_socket_close`, not the raw libc `close` — on Windows `close()` on a
// Winsock SOCKET is not an error return but a process-killing
// `__fastfail(0xC0000409)` (`socket_ops_windows.sfn:11-12`). The runtime
// helper routes to `closesocket` there and to `close` on POSIX
// (`socket_ops.sfn:101`), so it is correct on every target (SFN-1114).
extern fn sfn_socket_close(fd: i32) -> i32;

fn _su_port() -> i64 { return 18882; }

fn _child_env() -> string[] ![io] { return process.environ(); }

// The same environment in `sfn/os`'s typed form, for `with_background`.
fn _child_env_typed() -> Env ![io] { return env_from_current(); }

fn _fixture_root() -> string {
    return "compiler/tests/e2e/fixtures/stateful_http_users_server";
}

fn _work_root() -> string { return "build/stateful-http-users-e2e"; }

fn _su_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

fn _su_connect(port: i64) -> i32 ![net] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_su_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_su_ptr_off(addr, 0), 16, 1 as usize);
            memset(_su_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_su_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_su_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        memset(_su_ptr_off(addr, 4), 127, 1 as usize);
        memset(_su_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

fn _su_send_all(fd: i32, buf: *u8, total: i64) -> bool {
    let mut sent: i64 = 0;
    loop {
        if sent >= total { break; }
        let n: i64 = sfn_socket_send(fd, _su_ptr_off(buf, sent), total - sent, 0);
        if n <= 0 { return false; }
        sent = sent + n;
    }
    return true;
}

fn _su_recv_all(fd: i32) -> string {
    let mut capacity: i64 = 8192;
    let mut len: i64 = 0;
    let mut buf: *u8 = malloc((capacity + 1) as usize);
    if buf as i64 == 0 { return ""; }
    loop {
        if len + 4096 > capacity {
            let new_cap: i64 = capacity * 2;
            let new_buf: *u8 = realloc(buf, (new_cap + 1) as usize);
            if new_buf as i64 == 0 {
                free(buf);
                return "";
            }
            buf = new_buf;
            capacity = new_cap;
        }
        let n: i64 = sfn_socket_recv(fd, _su_ptr_off(buf, len), 4096, 0);
        if n < 0 {
            free(buf);
            return "";
        }
        if n == 0 { break; }
        len = len + n;
    }
    memset(_su_ptr_off(buf, len), 0, 1 as usize);
    return buf as string;
}

fn _su_request(port: i64, request: string) -> string ![net] {
    let fd: i32 = _su_connect(port);
    if fd < 0 { return ""; }
    if !_su_send_all(fd, request as *u8, strlen(request as *u8) as i64) {
        sfn_socket_close(fd);
        return "";
    }
    let resp = _su_recv_all(fd);
    sfn_socket_close(fd);
    return resp;
}

fn _build_bin(bin: string) -> string ![io] {
    fs.createDirectory(_work_root(), true);
    let exit = process.run_capture([sfn_bin_path(), "build", "-p", _fixture_root(), "-o", bin], _child_env());
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if exit != 0 { return ""; }
    return bin;
}

// Poll `GET /users` until the prebuilt server answers with an empty list
// (startup is just the binary launching + bind, ~1s). 45s wall-clock budget.
// Captures nothing — reaches the port through the file-local `_su_port()`
// rather than closing over a parameter (SFN-843).
fn _await_ready() -> string ![clock, io, net] {
    let request = "GET /users HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n";
    let ready = wait_until(fn () -> boolean {
        let resp = _su_request(_su_port(), request);
        return contains(resp, "HTTP/1.1 200") && contains(resp, "[]");
    }, 45000, 500);
    if !ready { return ""; }
    return _su_request(_su_port(), request);
}

test "stateful users server: POST persists across GET requests (SFN-33)" ![clock, io, net] {
    // SFN-843: typed explicitly — the `with_background` body below captures
    // it, and an untyped call-initialized `let` mistypes the capture's env
    // slot as `i8*`.
    let server_bin: string = _build_bin(_work_root() + "/server-bin");
    assert server_bin.length > 0;

    // `with_background` owns the blocking server's lifetime: it is killed
    // and reaped on scope exit, including when an assertion below throws —
    // replacing the previous `timeout <secs>` argv vehicle, which the
    // original `_spawn_server` fell back to running the server unreaped
    // without, and which forced a SKIP on any host without coreutils.
    let _served = with_background([server_bin], _child_env_typed(), "", "stateful-users-server", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;

        let ready = _await_ready();
        print.info("[stateful-users] ready: " + ready);
        assert ready.length > 0;
        assert contains(ready, "HTTP/1.1 200");
        assert contains(ready, "[]");

        let post = _su_request(_su_port(), "POST /users HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nConnection: close\r\n\r\nAlice");
        print.info("[stateful-users] post: " + post);
        assert contains(post, "HTTP/1.1 201");
        assert contains(post, "Content-Type: application/json");
        assert contains(post, "{\"id\":\"1\",\"name\":\"Alice\"}");

        let list = _su_request(_su_port(), "GET /users HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        print.info("[stateful-users] list: " + list);
        assert contains(list, "HTTP/1.1 200");
        assert contains(list, "[{\"id\":\"1\",\"name\":\"Alice\"}]");

        let by_id = _su_request(_su_port(), "GET /users/1 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        print.info("[stateful-users] by-id: " + by_id);
        assert contains(by_id, "HTTP/1.1 200");
        assert contains(by_id, "{\"id\":\"1\",\"name\":\"Alice\"}");
        return 0;
    });

    let _rm = process.run(["rm", "-rf", _work_root()]);
}
