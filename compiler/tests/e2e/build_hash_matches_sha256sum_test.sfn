// compiler/tests/e2e/build_hash_matches_sha256sum_test.sfn
//
// Cross-check the build driver's in-process SHA-256 against an independent
// system implementation. SFN-660 extends the original text-only precedent to
// every representative artifact class the build hashes in production: the
// compiler binary, a compressed tar archive, and generated LLVM IR larger than
// the retired 64 KiB threshold.
import { remove_all } from "sfn/fs";
import { default_scratch_dir, sfn_bin_path, tool_present } from "sfn/test";

import { _sha256_of_file } from "../../src/build/fs";
import { sha256_hex_of_string } from "../../src/build/hash";

fn _capture_digest(argv: string[]) -> string ![io] {
    let rc = process.run_capture(argv, process.environ());
    let out = process.capture_take_stdout();
    let _ = process.capture_take_stderr();
    if rc != 0 { return ""; }
    let mut end: int = 0;
    loop {
        if end >= out.length { break; }
        if out[end] == " " || out[end] == "\t" || out[end] == "\n" { break; }
        end += 1;
    }
    if end != 64 { return ""; }
    let mut digest: string = "";
    let mut i: int = 0;
    loop {
        if i >= end { break; }
        digest = digest + out[i];
        i += 1;
    }
    return digest;
}

// Return the system implementation's 64-character digest, trying the GNU
// spelling first and the macOS spelling second. These subprocesses are test
// oracles only; production hashing never reaches them.
fn _system_sha256(path: string) -> string ![io] {
    let digest = _capture_digest(["sha256sum", path]);
    if digest.length == 64 { return digest; }
    return _capture_digest(["shasum", "-a", "256", path]);
}

fn _tmp_path(name: string) -> string ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { return scratch + "/" + name; }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { return tmpdir + "/.sfn_bh_test_" + name; }
    return default_scratch_dir() + "/.sfn_bh_test_" + name;
}

test "build_hash: string entry point matches the system digest" ![io] {
    let content = "hello, Sailfin\n";
    let path = _tmp_path("text.txt");
    fs.writeFile(path, content);
    let expected = _system_sha256(path);
    assert remove_all(path);
    if expected.length == 0 {
        assert true;
        return;
    }
    assert sha256_hex_of_string(content) == expected;
}

test "build_hash: compiled binary matches the system digest" ![io] {
    let path = sfn_bin_path();
    let expected = _system_sha256(path);
    if expected.length == 0 {
        assert true;
        return;
    }
    assert _sha256_of_file(path) == expected;
}

test "build_hash: tar.gz archive matches the system digest" ![io] {
    if !tool_present("tar") {
        assert true;
        return;
    }
    let path = _tmp_path("compiler.tar.gz");
    let tar_rc = process.run(["tar", "-czf", path, "build/bin/sfn"]);
    if tar_rc != 0 {
        assert true;
        return;
    }
    let expected = _system_sha256(path);
    let got = _sha256_of_file(path);
    assert remove_all(path);
    if expected.length == 0 {
        assert true;
        return;
    }
    assert got == expected;
}

test "build_hash: generated LLVM IR above 64 KiB matches the system digest" ![io] {
    let path = _tmp_path("large.ll");
    let emit_rc = process.run_capture([sfn_bin_path(), "emit", "-o", path, "llvm", "compiler/src/build/fs.sfn"], process.environ());
    let _ = process.capture_take_stdout();
    let _ = process.capture_take_stderr();
    if emit_rc != 0 || !fs.exists(path) {
        assert true;
        return;
    }
    let contents = fs.readFile(path);
    assert contents.length > 65536;
    let expected = _system_sha256(path);
    let got = _sha256_of_file(path);
    assert remove_all(path);
    if expected.length == 0 {
        assert true;
        return;
    }
    assert got == expected;
}

test "build_hash: missing file fails closed while an empty file hashes" ![io] {
    let missing = _tmp_path("missing.bin");
    assert remove_all(missing);
    assert _sha256_of_file(missing) == "";

    let empty = _tmp_path("empty.bin");
    fs.writeFile(empty, "");
    let got = _sha256_of_file(empty);
    assert remove_all(empty);
    assert got == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
}
