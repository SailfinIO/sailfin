// End-to-end regression for the LLVM-lowering fail-closed value gate
// (SFN-527).
//
// Several lowering consumers substitute `default_return_literal` — a
// fabricated placeholder value — whenever a sub-lowering fails, so a
// `return`/assignment/`let`/struct-literal that could not be lowered still
// produced *some* LLVM value and the emit exited 0 with wrong-but-plausible
// IR. SFN-527 did not remove those substitutions: the placeholder is still
// emitted at every site, deliberately, so the rest of the pass sees
// structurally valid IR (dropping it would leave a block unterminated or an
// alloca uninitialized). What changed is the severity — each site now *tags*
// the fabrication `E1002` with `severity == "error"`, which is the only thing
// `has_error_diag` acts on, so the emit fails closed instead
// of exiting 0 in silence. This test pins that at each consumer site plus
// the combined `sfn build` repro from the issue.
//
// SFN-675 moved the two proven primitive return/initializer mismatches to the
// shared frontend as E0309. The remaining fixtures still exercise lowering's
// E1002 backstop because their invalidity is not yet structurally proven there.
//
// SFN-543 moved the proven unknown-field access to the shared frontend as
// E0015, which fires before lowering runs. The fixtures below therefore reach
// the field through an *inferred* receiver (`let t = mk_t()`), which the
// frontend cannot prove and so still reaches this backstop — the shape a
// lowering gate exists to catch.
//
// SFN-565 splits the structural function-body fallback by reachability over
// the emitted LLVM block graph. The infinite-loop exit block remains
// disconnected and untagged, while a genuine fall-off-the-end reaches its
// merge block and fails closed with `E1002`.
//
// Drives the compiler-under-test as a subprocess per `.claude/rules/no-bash-e2e.md`.
import { find } from "sfn/strings";
import {
    clean_runner_env,
    default_scratch_dir,
    nested_runner_scratch,
    sfn_bin_path
} from "sfn/test";

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    return dir;
}

// Write `source` to `<scratch>/<name>` and return the path.
fn _write_source(name: string, source: string) -> string ![io] {
    let path = _scratch_dir() + "/" + name;
    if fs.exists(path) { fs.deleteFile(path); }
    fs.writeFile(path, source);
    return path;
}

// Run `sfn emit llvm <src>` and assert it fails closed with `[E1002]` and
// the given site-specific substring.
fn _assert_emit_fails_closed(name: string, source: string, substring: string) ![io] {
    let src = _write_source(name, source);
    let exit = process.run_capture([sfn_bin_path(), "emit", "llvm", src], process.environ());
    let sout = process.capture_take_stdout();
    let serr = process.capture_take_stderr();
    let combined = sout + serr;
    assert exit != 0;
    // Assert the full canonical prefix, not just the code, so the tag
    // spelling required by the `[fatal]` contract is pinned too.
    assert find(combined, "llvm lowering [fatal] [E1002]:", 0) >= 0;
    assert find(combined, substring, 0) >= 0;
}

// Proven primitive mismatches now stop in the shared frontend, before LLVM
// lowering can fabricate a placeholder value at the same consumer site.
fn _assert_frontend_primitive_fails_closed(name: string, source: string, substring: string) ![io] {
    let src = _write_source(name, source);
    let exit = process.run_capture([sfn_bin_path(), "emit", "llvm", src], process.environ());
    let sout = process.capture_take_stdout();
    let serr = process.capture_take_stderr();
    let combined = sout + serr;
    assert exit != 0;
    assert find(combined, "error[E0309]:", 0) >= 0;
    assert find(combined, substring, 0) >= 0;
    assert find(combined, "llvm lowering [fatal]", 0) < 0;
}

test "lowering fail-closed gate: bare return in value-returning fn" ![io] {
    _assert_emit_fails_closed("sfn527_empty_return.sfn", "fn f() -> i32 { return; }\nfn main() -> i32 { return 0; }\n", "missing return value in `f`");
}

test "lowering fail-closed gate: unknown field in return position" ![io] {
    _assert_emit_fails_closed("sfn527_return_null_operand.sfn", "struct T { a: i32; }\nfn mk_t() -> T { return T { a: 1 }; }\nfn in_return() -> i32 { let t = mk_t(); return t.nope; }\nfn main() -> i32 { return 0; }\n", "unhandled return expression in `in_return`");
}

test "lowering fail-closed gate: return operand uncoercible to declared type" ![io] {
    _assert_frontend_primitive_fails_closed("sfn527_return_coerce.sfn", "fn r_str(s: string) -> i32 { return s; }\nfn main() -> i32 { return 0; }\n", "type mismatch in return value: expected `int`, found `string`");
}

test "lowering fail-closed gate: assignment RHS fails to lower" ![io] {
    _assert_emit_fails_closed("sfn527_assign_null_operand.sfn", "struct T { a: i32; }\nfn mk_t() -> T { return T { a: 1 }; }\nfn in_assign() -> i32 { let t = mk_t(); let mut x: i32 = 41; x = t.nope; return x; }\nfn main() -> i32 { return 0; }\n", "failed to lower assignment expression for `x` in `in_assign`");
}

test "lowering fail-closed gate: assignment RHS uncoercible" ![io] {
    _assert_emit_fails_closed("sfn527_assign_coerce.sfn", "fn a_str(s: string) -> i32 { let mut x: i32 = 1; x = s; return x; }\nfn main() -> i32 { return 0; }\n", "unable to coerce assignment value for `x` in `a_str`");
}

test "lowering fail-closed gate: let initializer uncoercible" ![io] {
    _assert_frontend_primitive_fails_closed("sfn527_let_coerce.sfn", "fn l_str(s: string) -> i32 { let y: i32 = s; return y; }\nfn main() -> i32 { return 0; }\n", "type mismatch in initializer for `y`: expected `int`, found `string`");
}

test "lowering fail-closed gate: let initializer fails to lower" ![io] {
    _assert_emit_fails_closed("sfn527_let_null_operand.sfn", "struct T { a: i32; }\nfn mk_t() -> T { return T { a: 1 }; }\nfn in_let() -> i32 { let t = mk_t(); let x: i32 = t.nope; return x; }\nfn main() -> i32 { return 0; }\n", "initializer for `x` in `in_let` did not lower");
}

test "lowering fail-closed gate: struct literal missing field" ![io] {
    _assert_emit_fails_closed("sfn527_struct_literal_missing_field.sfn", "struct S { a: string; flag: boolean; b: string; }\nfn make(computed: boolean) -> S { return S { a: \"x\", b: \"y\" }; }\nfn main() -> i32 { let r = make(true); return 0; }\n", "struct literal for `S` missing field `flag`");
}

test "lowering fail-closed gate: struct literal field value fails to lower" ![io] {
    _assert_emit_fails_closed("sfn527_struct_literal_unlowered_field.sfn", "struct T { a: i32; }\nfn mk_t() -> T { return T { a: 1 }; }\nstruct S { a: i32; flag: boolean; }\nfn mk() -> S { let t = mk_t(); return S { a: t.nope, flag: true }; }\nfn main() -> i32 { return 0; }\n", "unable to lower value for struct literal field `S.a`");
}

test "lowering fail-closed gate: combined repro fails `sfn build` and produces no binary" ![io] {
    let src = _write_source("sfn527_build_gate.sfn", "struct T { a: i32; }\nfn mk_t() -> T { return T { a: 1 }; }\nfn f() -> i32 { return; }\nfn g() -> i32 { let t = mk_t(); let x: i32 = t.nope; return x; }\nfn in_return() -> i32 { let t = mk_t(); return t.nope; }\nfn main() -> i32 { return 0; }\n");
    let binpath = _scratch_dir() + "/sfn527_build_gate_bin";
    if fs.exists(binpath) { fs.deleteFile(binpath); }
    let env_vars = clean_runner_env(nested_runner_scratch("sfn527-build"));
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", binpath, src], env_vars);
    let sout = process.capture_take_stdout();
    let serr = process.capture_take_stderr();
    assert exit != 0;
    assert find(sout + serr, "[E1002]", 0) >= 0;
    assert ! fs.exists(binpath);
}

test "lowering fail-closed gate: unreachable loop fallthrough still builds untagged" ![io] {
    let src = _write_source("sfn527_loop_fallthrough.sfn", "fn spin(n: i32) -> i32 { loop { if n > 0 { return n; } } }\nfn main() -> i32 { return 0; }\n");
    let exit = process.run_capture([sfn_bin_path(), "emit", "llvm", src], process.environ());
    let sout = process.capture_take_stdout();
    let serr = process.capture_take_stderr();
    assert exit == 0;
    assert find(sout + serr, "[E1002]", 0) < 0;
}

test "lowering fail-closed gate: reachable function fallthrough fails closed" ![io] {
    _assert_emit_fails_closed("sfn565_reachable_fallthrough.sfn", "fn oops(n: i32) -> i32 { if n > 0 { return n; } }\nfn main() -> i32 { return 0; }\n", "function `oops` can reach the end without returning");
}

test "lowering fail-closed gate: exhaustive boxed enum match is unreachable" ![io] {
    let src = _write_source("sfn565_exhaustive_result.sfn", "fn classify(n: i32) -> Result<i32, string> { if n > 0 { return Result.Ok { value: n }; } return Result.Err { error: \"no\" }; }\nfn unwrap(n: i32) -> i32 { let result = classify(n); match result { Result.Ok { value } => { return value; }, Result.Err { error } => { return 0; } } }\nfn main() -> i32 { return 0; }\n");
    let exit = process.run_capture([sfn_bin_path(), "emit", "llvm", src], process.environ());
    let sout = process.capture_take_stdout();
    let serr = process.capture_take_stderr();
    assert exit == 0;
    assert find(sout + serr, "[E1002]", 0) < 0;
}

test "lowering fail-closed gate: valid source still emits" ![io] {
    let src = _write_source("sfn527_valid_source.sfn", "fn add(a: i32, b: i32) -> i32 { return a + b; }\nfn main() -> i32 { return add(1, 2); }\n");
    let out = _scratch_dir() + "/sfn527_valid_source.ll";
    if fs.exists(out) { fs.deleteFile(out); }
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", out, "llvm", src], process.environ());
    let _sout = process.capture_take_stdout();
    let _serr = process.capture_take_stderr();
    assert exit == 0;
    assert fs.exists(out);
    let ir = fs.readFile(out);
    assert ir.length > 0;
}
