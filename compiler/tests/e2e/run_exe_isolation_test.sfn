// Regression for SFN-719: `sfn run` must not write its built binary to a
// FIXED path. On Windows a running `.exe` is locked by the OS, so a nested
// or concurrent `sfn run` sharing the same fixed name fails to link over
// it; every platform also risks one run's binary being clobbered by
// another's before it finishes executing.
//
// `run_scratch_isolation_test.sfn` (#1411) already locks the
// `SAILFIN_TEST_SCRATCH`-guarded pool path, where per-invocation isolation
// comes from the scratch dir itself and the fixed `run` name is
// deliberately left untouched. This test locks the OTHER branch: the
// unguarded default (`build/sailfin`, relative to CWD) that a plain-CLI or
// nested invocation hits when no scratch is set. It drives children in a
// private, per-test CWD (so relative `build/sailfin` never touches the
// repo's own or another test's) with `SAILFIN_TEST_SCRATCH` explicitly
// absent from the child env.
//
// Both tests spawn asynchronously (`process.spawn_with_env_cwd` +
// `process.handle_wait`, not `process.run_capture`) so the fixture can be
// probed WHILE still running — a blocking `run_capture` only ever sees
// the directory after `sfn run`'s own post-exit cleanup has already run,
// which would make the naming assertion vacuous.
import { find, int_to_string, split } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch } from "sfn/test";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

fn _first_line(text: string) -> string {
    let lines = split(text, "\n");
    if lines.length == 0 { return text; }
    return lines[0];
}

// `spawn_with_env_cwd` resolves the child's argv[0] against the CHILD cwd,
// not the parent's — an unqualified "build/bin/sfn" would not resolve
// once the child's cwd is the private fixture dir (mirrors
// `run_cache_flags_test.sfn`'s `_sfn_bin_abs`).
fn _sfn_bin_abs() -> string ![io] {
    let bin = _sfn_bin();
    if bin.length > 0 && bin[0] == "/" { return bin; }
    let exit = process.run_capture(["pwd"], []);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if exit != 0 { return bin; }
    return _first_line(out) + "/" + bin;
}

// A self-contained fixture (no external capsule deps) written under a
// private per-test directory, which also serves as the CHILD's cwd — so
// its own `build/sailfin` is isolated from the repo's and from every
// other test. `sleep_ms` gives an external observer a window to probe
// `build/sailfin` (or spawn an overlapping second invocation) while the
// built binary is still executing.
fn _ensure_fixture(root: string, sleep_ms: int) -> void ![io] {
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn719/probe\"\n"
        + "version = \"0.1.0\"\n\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"binary\"\n");
    fs.writeFile(root + "/src/main.sfn", "fn main() -> int ![clock, io] {\n"
        + "    sleep("
        + int_to_string(sleep_ms)
        + ");\n"
        + "    print(\"7\");\n"
        + "    return 0;\n"
        + "}\n");
}

// Count entries directly under `dir` whose name starts with "run-" — the
// per-invocation exe naming scheme (`_unique_run_exe_path` in
// `compiler/src/cli/commands/run.sfn`). `run.ll` starts with "run." and is
// never counted.
fn _count_run_exe_entries(dir: string) -> int ![io] {
    if !fs.exists(dir) { return 0; }
    let entries = fs.listDirectory(dir);
    let mut count: int = 0;
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        if find(entries[i], "run-", 0) == 0 { count += 1; }
        i += 1;
    }
    return count;
}

// Poll `dir` for a "run-" entry up to `~deadline_ms`, sleeping between
// probes. `sfn run` needs to compile+link before the fixture's own
// `sleep()` even starts, so the exe doesn't appear the instant the
// process is spawned.
fn _wait_for_run_exe_entry(dir: string, deadline_ms: int) -> boolean ![clock, io] {
    let mut waited: int = 0;
    loop {
        if _count_run_exe_entries(dir) > 0 { return true; }
        if waited >= deadline_ms { return false; }
        sleep(100);
        waited += 100;
    }
}

test "run: unguarded default path mints a per-invocation exe name and cleans up after itself" ![clock, io] {
    let root = nested_runner_scratch("run-exe-isolation-single");
    _ensure_fixture(root, 1500);
    // Deliberately no `SAILFIN_TEST_SCRATCH` in the child env: this
    // exercises the unguarded default (`build/sailfin`, relative to the
    // child's own cwd), not the already-isolated scratch-guarded branch.
    let child_env = clean_runner_env("");
    let sailfin_dir = root + "/build/sailfin";

    let handle = process.spawn_with_env_cwd([_sfn_bin_abs(), "run", "src/main.sfn"], child_env, root);
    assert handle != 0;
    // While the fixture is still sleeping inside its own execution, its
    // exe must be present under a per-invocation "run-" name — never the
    // fixed legacy `run`/`run.exe`.
    assert _wait_for_run_exe_entry(sailfin_dir, 60000);
    assert ! fs.exists(sailfin_dir + "/run");
    assert ! fs.exists(sailfin_dir + "/run.exe");
    assert _count_run_exe_entries(sailfin_dir) == 1;

    let out = process.handle_read_stdout(handle);
    let _err = process.handle_read_stderr(handle);
    let exit = process.handle_wait(handle);
    assert exit == 0;
    assert find(out, "7", 0) >= 0;
    // `sfn run` deletes its own exe once its child has exited — the
    // per-invocation scheme stays bounded rather than accumulating a new
    // binary on every `sfn run`.
    assert _count_run_exe_entries(sailfin_dir) == 0;
}

test "run: two overlapping invocations in one directory both succeed" ![clock, io] {
    let root = nested_runner_scratch("run-exe-isolation-overlap");
    _ensure_fixture(root, 1500);
    let child_env = clean_runner_env("");
    let bin = _sfn_bin_abs();

    // Start both before waiting on either, so their builds and their
    // fixtures' own `sleep()` genuinely overlap in the same directory —
    // the acceptance criterion in SFN-719 ("two concurrent `sfn run`
    // invocations in one directory both succeed").
    let handle_a = process.spawn_with_env_cwd([bin, "run", "src/main.sfn"], child_env, root);
    let handle_b = process.spawn_with_env_cwd([bin, "run", "src/main.sfn"], child_env, root);
    assert handle_a != 0;
    assert handle_b != 0;

    let out_a = process.handle_read_stdout(handle_a);
    let _err_a = process.handle_read_stderr(handle_a);
    let exit_a = process.handle_wait(handle_a);

    let out_b = process.handle_read_stdout(handle_b);
    let _err_b = process.handle_read_stderr(handle_b);
    let exit_b = process.handle_wait(handle_b);

    assert exit_a == 0;
    assert exit_b == 0;
    assert find(out_a, "7", 0) >= 0;
    assert find(out_b, "7", 0) >= 0;
}
