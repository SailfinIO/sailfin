// Regression for SFN-719: `sfn run` must not write its built binary to a
// FIXED path. On Windows a running `.exe` is locked by the OS, so a nested
// or concurrent `sfn run` sharing the same fixed name fails to link over
// it; every platform also risks one run's binary being clobbered by
// another's before it finishes executing.
//
// `run_scratch_isolation_test.sfn` (#1411) already locks the
// `SAILFIN_TEST_SCRATCH`-guarded pool path, where per-invocation isolation
// comes from the scratch dir itself and the fixed `run` name is
// deliberately left untouched. This test locks the OTHER branch: the
// unguarded default (`build/sailfin`, relative to CWD) that a plain-CLI or
// nested invocation hits when no scratch is set. It drives the child in a
// private, per-test CWD (so relative `build/sailfin` never touches the
// repo's own or another test's) with `SAILFIN_TEST_SCRATCH` explicitly
// absent from the child env.
import { find, split } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch } from "sfn/test";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

fn _first_line(text: string) -> string {
    let lines = split(text, "\n");
    if lines.length == 0 { return text; }
    return lines[0];
}

// `run_capture_cwd` resolves the child's argv[0] against the CHILD cwd, not
// the parent's — an unqualified "build/bin/sfn" would not resolve once the
// nested run's cwd is the private fixture dir (mirrors
// `run_cache_flags_test.sfn`'s `_sfn_bin_abs`).
fn _sfn_bin_abs() -> string ![io] {
    let bin = _sfn_bin();
    if bin.length > 0 && bin[0] == "/" { return bin; }
    let exit = process.run_capture(["pwd"], []);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if exit != 0 { return bin; }
    return _first_line(out) + "/" + bin;
}

// A self-contained fixture (no external capsule deps) written under a
// private per-test directory, which also serves as the CHILD's cwd — so
// its own `build/sailfin` is isolated from the repo's and from every other
// test.
fn _ensure_fixture(root: string) -> void ![io] {
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn719/probe\"\n"
        + "version = \"0.1.0\"\n\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"binary\"\n");
    fs.writeFile(root + "/src/main.sfn", "fn main() -> int ![io] {\n"
        + "    print(\"7\");\n"
        + "    return 0;\n"
        + "}\n");
}

// Count entries directly under `dir` whose name starts with "run-" — the
// per-invocation exe naming scheme (`_unique_run_exe_path` in
// `compiler/src/cli/commands/run.sfn`). `run.ll` starts with "run." and is
// never counted.
fn _count_run_exe_entries(dir: string) -> int ![io] {
    if !fs.exists(dir) { return 0; }
    let entries = fs.listDirectory(dir);
    let mut count: int = 0;
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        if find(entries[i], "run-", 0) == 0 { count += 1; }
        i += 1;
    }
    return count;
}

test "run: unguarded default path mints a per-invocation exe name and does not accumulate" ![io] {
    let root = nested_runner_scratch("run-exe-isolation");
    _ensure_fixture(root);
    // Deliberately no `SAILFIN_TEST_SCRATCH` in the child env: this
    // exercises the unguarded default (`build/sailfin`, relative to the
    // child's own cwd), not the already-isolated scratch-guarded branch.
    let child_env = clean_runner_env("");
    let sailfin_dir = root + "/build/sailfin";

    let exit1 = process.run_capture_cwd([_sfn_bin_abs(), "run", "src/main.sfn"], child_env, root);
    let out1 = process.capture_take_stdout();
    let _err1 = process.capture_take_stderr();
    assert exit1 == 0;
    assert find(out1, "7", 0) >= 0;
    // The fixed legacy name must be gone — a per-invocation name replaces
    // it, never the shared `run`/`run.exe`.
    assert ! fs.exists(sailfin_dir + "/run");
    assert ! fs.exists(sailfin_dir + "/run.exe");
    assert _count_run_exe_entries(sailfin_dir) == 1;

    let exit2 = process.run_capture_cwd([_sfn_bin_abs(), "run", "src/main.sfn"], child_env, root);
    let out2 = process.capture_take_stdout();
    let _err2 = process.capture_take_stderr();
    assert exit2 == 0;
    assert find(out2, "7", 0) >= 0;
    // A second invocation swept the first invocation's leftover before
    // minting its own — the per-invocation scheme stays bounded rather
    // than accumulating a new binary on every `sfn run`.
    assert _count_run_exe_entries(sailfin_dir) == 1;
}
