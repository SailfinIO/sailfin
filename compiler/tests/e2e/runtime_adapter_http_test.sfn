// End-to-end test for runtime/sfn/adapters/http.sfn — the
// Sailfin-native HTTP/1.1 socket client adapter (M3 #818, epic #390).
//
// Native (no-bash) replacement for the former
// `test_runtime_adapter_http.sh` (test-infra Phase 3, epic #842;
// `.claude/rules/no-bash-e2e.md`). Pins, end-to-end:
//   1. typecheck   — `sfn check runtime/sfn/adapters/http.sfn` is ok.
//   2. fmt         — the module is fmt-canonical.
//   3. emit shape  — the module emits a `define` for every sfn_http_*
//                    export and `declare`s the BSD-sockets libc surface
//                    (socket/connect/send/recv/close).
//   4. routing     — `http.get_body` lowers to `@sfn_http_get` and NOT
//                    the legacy curl `@sailfin_runtime_http_get` call.
//   5. member-call — `http.get(url)` lowers to a `@sfn_http_get` call
//                    and `http.post(url, body)` to `@sfn_http_post2_lv`,
//                    with no residual `@sailfin_intrinsic_http_*` call
//                    (the #912 member-call flip; SFN-1022 repointed the
//                    POST leg at the length-carrying twin).
//   6. behavioral   — `http.download` against an unreachable transport
//                    (TCP discard, nothing bound) surfaces the real
//                    `connect-failed` reason via a nested build + run
//                    (SFN-1028). Skips, rather than fails, when the
//                    nested build cannot link (clang unavailable).
//
// OMITTED: the original script's behavioral GET+POST round-trip leg
// (test_get_round_trip) drove a real socket request against a localhost
// Python listener. A live network server / Python client cannot run as
// an `![io]` `sfn/test` leg per `.claude/rules/no-bash-e2e.md`, so it is
// dropped here; the emit-shape + routing + reference-absence checks, plus
// the connect-failed behavioral leg above, cover the registry-flip
// behavior without a live network server.
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]`, so
// they cannot be called from an `![io]` test. For subprocess/IR-output
// assertions use `sfn/strings` (`find` / `split` / `starts_with` /
// `contains` / `char_at_index`), as the runtime_string_basic exemplar does.
import {
    char_at_index,
    contains,
    find,
    split,
    starts_with
} from "sfn/strings";
import {
    clean_runner_env,
    default_scratch_dir,
    nested_runner_scratch,
    sfn_bin_path
} from "sfn/test";

// `run_capture`'s empty array is the *empty* environment; thread the
// variables the toolchain needs. `emit` / `check` neither link nor spawn
// clang (no PATH required), but keep the standard set for portability.
fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

// A unique scratch dir for this test (under the runner's per-file scratch
// when present, else /tmp).
fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/sfn-runtime-http";
    fs.createDirectory(dir, true);
    return dir;
}

// Emit LLVM IR for the module at `module_path` and return it (or
// "EMIT_FAILED" on a non-zero exit).
fn _emit_module(tag: string, module_path: string) -> string ![io] {
    let dir = _scratch_dir();
    let outpath = dir + "/" + tag + ".ll";
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", outpath, "llvm", module_path], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return "EMIT_FAILED"; }
    return fs.readFile(outpath);
}

// Emit LLVM IR for source written to a scratch `.sfn` file, then read it
// back (or "EMIT_FAILED" on a non-zero exit).
fn _emit_source(tag: string, source: string) -> string ![io] {
    let dir = _scratch_dir();
    let srcpath = dir + "/" + tag + ".sfn";
    fs.writeFile(srcpath, source);
    return _emit_module(tag, srcpath);
}

// `^define .* @sym(` — a line that starts the symbol's definition.
fn _has_define(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "define ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// `^declare .* @sym(` — the module declares the libc trampoline.
fn _has_declare(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "declare ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn _is_word_char(ch: string) -> boolean {
    if ch.length == 0 { return false; }
    let word = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    return find(word, ch, 0) >= 0;
}

// `@sym\b` — does the IR reference the bare symbol at a word boundary?
fn _references(ir: string, sym: string) -> boolean {
    let needle = "@" + sym;
    let mut pos = find(ir, needle, 0);
    loop {
        if pos < 0 { break; }
        let after = pos + needle.length;
        if after >= ir.length { return true; }
        let ch = char_at_index(ir, after);
        if !_is_word_char(ch) { return true; }
        pos = find(ir, needle, after);
    }
    return false;
}

// Does any `call`/`invoke` line target `@sym(`? (A `declare` of `@sym`
// is tolerated for seed compat; only call sites are load-bearing here.)
fn _calls(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        let is_call = contains(line, "call ") || contains(line, "invoke ");
        if is_call && contains(line, "@" + sym + "(") { return true; }
        i = i + 1;
    }
    return false;
}

test "runtime/sfn/adapters/http.sfn typechecks cleanly" ![io] {
    let exit = process.run_capture([sfn_bin_path(), "check", "runtime/sfn/adapters/http.sfn"], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert find(out + err, "ok", 0) >= 0;
}

test "runtime/sfn/adapters/http.sfn is fmt-canonical" ![io] {
    let exit = process.run_capture([sfn_bin_path(), "fmt", "--check", "runtime/sfn/adapters/http.sfn"], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    assert exit == 0;
}

test "http emit: define for every sfn_http_* export" ![io] {
    let ir = _emit_module("http", "runtime/sfn/adapters/http.sfn");
    assert ir != "EMIT_FAILED";
    assert _has_define(ir, "sfn_http_get");
    assert _has_define(ir, "sfn_http_post");
    assert _has_define(ir, "sfn_http_post2");
    assert _has_define(ir, "sfn_http_download");
    // SFN-1022: the length-carrying twins must be defined alongside the
    // originals — the originals stay for seed-built IR, but the twins are
    // what fresh call sites now route through.
    assert _has_define(ir, "sfn_http_post_lv");
    assert _has_define(ir, "sfn_http_post2_lv");
}

// SFN-1028: the download fail-code vocabulary must actually compile into the
// module — the Windows CI leg runs no behavioral tests (SFN-981), so this is
// the only Windows-side proof the shared taxonomy is present.
test "http emit: the download failure-reason taxonomy compiles in" ![io] {
    let ir = _emit_module("http", "runtime/sfn/adapters/http.sfn");
    assert ir != "EMIT_FAILED";
    assert contains(ir, "connect-failed");
    assert contains(ir, "dns-failed");
    assert contains(ir, "http-status-");
}

// SFN-671: creation and disposal are no longer libc `socket`/`close`.
// SFN-927 widened this to timeouts and recv/send: Winsock's `recv`/
// `send` are 32-bit (not POSIX's 64-bit `ssize_t`) and its
// `SO_RCVTIMEO`/`SO_SNDTIMEO` optval is a millisecond DWORD (not a
// `struct timeval`), so all four now route through
// `platform/socket_ops.sfn`, which is swapped for its Windows sibling by
// manifest target conditioning. The rest of the surface is
// exported under the same names by `ws2_32.dll` and stays a bare libc
// declaration. Asserting the ABSENCE of the POSIX-only declares is the
// half that matters: it is what would catch a regression that
// reintroduced a direct `close(fd)`/`recv(fd)`/`send(fd)`/`setsockopt`-
// timeout call on a socket.
test "http emit: declares the socket surface, POSIX close/recv/send retired" ![io] {
    let ir = _emit_module("http", "runtime/sfn/adapters/http.sfn");
    assert ir != "EMIT_FAILED";
    assert _has_declare(ir, "sfn_socket_open");
    // SFN-1026: the resolver must initialize Winsock before
    // `getaddrinfo`, since it runs ahead of socket creation and
    // `sfn_socket_open` is therefore too late. Asserted as a CALL, not
    // a declare: the `extern fn` keeps the declare alive even with the
    // call deleted, so a declare assertion passes while the bug is
    // fully reintroduced (verified). The Windows CI leg runs no tests
    // (SFN-981), so this IR check is the only host-side guard there is.
    assert _calls(ir, "sfn_socket_net_init");
    assert _has_declare(ir, "connect");
    assert _has_declare(ir, "sfn_socket_send");
    assert _has_declare(ir, "sfn_socket_recv");
    assert _has_declare(ir, "sfn_socket_close");
    assert _has_declare(ir, "sfn_socket_set_timeouts");
    assert ! _has_declare(ir, "socket");
    assert ! _has_declare(ir, "close");
    assert ! _has_declare(ir, "send");
    assert ! _has_declare(ir, "recv");
}

test "http emit: declares getaddrinfo for real-DNS host resolution (#1707)" ![io] {
    let ir = _emit_module("http", "runtime/sfn/adapters/http.sfn");
    assert ir != "EMIT_FAILED";
    // The DNS fall-through (`_host_ip4` -> `_resolve_dns`) declares the libc
    // resolver surface so a real hostname can resolve past localhost /
    // dotted-quad.
    assert _has_declare(ir, "getaddrinfo");
    assert _has_declare(ir, "freeaddrinfo");
}

test "http.get_body lowers to @sfn_http_get, not the curl path" ![io] {
    let source = "fn fetch(url: string) -> string ![net] {\n"
        + "    return http.get_body(url);\n"
        + "}\n\n"
        + "fn main() -> int ![net, io] {\n"
        + "    let body = fetch(\"http://127.0.0.1:9/\");\n"
        + "    print(body);\n"
        + "    return 0;\n"
        + "}\n";
    let ir = _emit_source("http_probe", source);
    assert ir != "EMIT_FAILED";
    // The flipped registry row routes through @sfn_http_get.
    assert _references(ir, "sfn_http_get");
    // The legacy curl entrypoint must not be CALLED (declares tolerated).
    assert ! _calls(ir, "sailfin_runtime_http_get");
}

test "http.get/http.post member calls flip to @sfn_http_get/@sfn_http_post2_lv (#912)" ![io] {
    let source = "fn main() -> int ![net, io] {\n"
        + "    let got = http.get(\"http://127.0.0.1:9/\");\n"
        + "    print(got);\n"
        + "    let posted = http.post(\"http://127.0.0.1:9/\", \"{}\");\n"
        + "    print(posted);\n"
        + "    return 0;\n"
        + "}\n";
    let ir = _emit_source("http_member_probe", source);
    assert ir != "EMIT_FAILED";
    assert _calls(ir, "sfn_http_get");
    // SFN-1022: the body param carries `{i8*, i64}` and routes through the
    // length-carrying twin; the bare-pointer symbol stays DEFINED for
    // seed-built IR but must no longer be a freshly emitted call target.
    assert _calls(ir, "sfn_http_post2_lv");
    assert ! _calls(ir, "sfn_http_post2");
    // The old member-call intrinsics must not be CALLED anymore.
    assert ! _calls(ir, "sailfin_intrinsic_http_get");
    assert ! _calls(ir, "sailfin_intrinsic_http_post");
}

// SFN-1028: `http.download` against an unreachable transport (TCP discard,
// nothing ever bound) must report the real connect failure reason instead
// of the pre-fix bare-boolean contract. `.invalid` is avoided because a
// captive resolver could hijack the NXDOMAIN and flip the reason to
// `dns-failed`; `http://127.0.0.1:9` is the established in-repo idiom
// (`http_post_carry_length_test.sfn`, `publish_test.sfn`,
// the emit-shape tests above). Per SFN-1001, the scratch destination path
// is threaded through `SAILFIN_TEST_SCRATCH`, never spliced into the
// generated source text. Per `.claude/rules/no-bash-e2e.md`, the nested
// build uses `clean_runner_env(nested_runner_scratch(...))`, never raw
// `process.environ()`.
fn _child_env_download_reason() -> string[] ![io] {
    return clean_runner_env(nested_runner_scratch("http-download-reason"));
}

test "http.download surfaces the connect-failed reason (SFN-1028)" ![io] {
    let scratch = _scratch_dir() + "/http-download-reason";
    fs.createDirectory(scratch, true);
    let src = scratch + "/probe.sfn";
    let bin = scratch + "/probe";
    fs.writeFile(src, "fn main() -> int ![io, net] {\n"
        + "    let dest = env.get(\"SAILFIN_TEST_SCRATCH\") + \"/out.bin\";\n"
        + "    let r: string = http.download(\"http://127.0.0.1:9/nope\", dest);\n"
        + "    print(\"R=\" + r);\n"
        + "    return 0;\n"
        + "}\n");

    let build_env = _child_env_download_reason();
    let build_rc = process.run_capture([sfn_bin_path(), "build", src, "-o", bin], build_env);
    let _build_out = process.capture_take_stdout();
    let _build_err = process.capture_take_stderr();
    if build_rc != 0 {
        // clang unavailable or link failed — the emit-shape + routing legs
        // above still pin the wiring; skip the behavioral leg.
        assert true;
        return;
    }

    let run_env = _child_env_download_reason();
    let run_rc = process.run_capture([bin], run_env);
    let run_out = process.capture_take_stdout();
    let _run_err = process.capture_take_stderr();
    assert contains(run_out, "R=connect-failed");
}
