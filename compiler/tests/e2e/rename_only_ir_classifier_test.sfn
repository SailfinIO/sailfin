// End-to-end coverage for the reusable compiler-capsule rename-only IR
// classifier established by SFN-741.
import {
    bash_path,
    clean_runner_env,
    nested_runner_scratch,
    report_child_failure
} from "sfn/test";

extern fn realpath(path: *u8, resolved: *u8) -> *u8;

fn _script() -> string ![io] {
    let configured = env.get("SAILFIN_REPO_ROOT");
    if configured.length > 0 {
        return configured + "/scripts/classify_rename_only_ir.sh";
    }
    let resolved: *u8 = realpath("." as *u8, null);
    let mut root = ".";
    if resolved as i64 != 0 { root = resolved as string; }
    return root + "/scripts/classify_rename_only_ir.sh";
}

fn _fixture_root(name: string) -> string ![io] {
    let root = nested_runner_scratch("rename-only-ir-" + name);
    fs.createDirectory(root, true);
    return root;
}

fn _classify(root: string, expected_exit: int) -> int ![io] {
    let result = process.run_capture(["bash", bash_path(_script()), bash_path(root
        + "/before.ll"), bash_path(root
        + "/after.ll"), bash_path(root
        + "/map.tsv")], clean_runner_env(bash_path(root)));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    if result != expected_exit {
        report_child_failure("rename-only classifier", result, out, err);
    }
    return result;
}

test "rename-only determinism classifier accepts explicit capsule mangling changes" ![io] {
    let root = _fixture_root("pass");
    fs.writeFile(root + "/before.ll", "define i64 @parse__parser__mod() {\n"
        + "  %value = call i64 @lex__lexer()\n"
        + "  ret i64 %value\n"
        + "}\n");
    fs.writeFile(root + "/after.ll", "define i64 @parse__sfn__syntax__parser__mod() {\n"
        + "  %value = call i64 @lex__sfn__syntax__lexer()\n"
        + "  ret i64 %value\n"
        + "}\n");
    fs.writeFile(root + "/map.tsv", "parser__mod\tsfn__syntax__parser__mod\n"
        + "lexer\tsfn__syntax__lexer\n");
    let result = _classify(root, 0);
    if result != 0 {
        throw "rename-only classifier rejected explicit module renames";
    }
}

test "rename-only determinism classifier rejects semantic IR drift" ![io] {
    let root = _fixture_root("fail");
    fs.writeFile(root + "/before.ll", "define i64 @parse__parser__mod() {\n"
        + "  ret i64 1\n"
        + "}\n");
    fs.writeFile(root + "/after.ll", "define i64 @parse__sfn__syntax__parser__mod() {\n"
        + "  ret i64 2\n"
        + "}\n");
    fs.writeFile(root + "/map.tsv", "parser__mod\tsfn__syntax__parser__mod\n");
    let result = _classify(root, 1);
    if result != 1 { throw "rename-only classifier accepted semantic IR drift"; }
}

test "rename-only determinism classifier preserves final newline state" ![io] {
    let root = _fixture_root("newline");
    fs.writeFile(root + "/before.ll", "define i64 @parse__parser__mod() {");
    fs.writeFile(root + "/after.ll", "define i64 @parse__sfn__syntax__parser__mod() {\n");
    fs.writeFile(root + "/map.tsv", "parser__mod\tsfn__syntax__parser__mod\n");
    let result = _classify(root, 1);
    if result != 1 {
        throw "rename-only classifier ignored final-newline drift";
    }
}

test "rename-only determinism classifier accepts a mapped rename at EOF without newline" ![io] {
    let root = _fixture_root("rename-at-eof");
    fs.writeFile(root + "/before.ll", "declare @parser__mod");
    fs.writeFile(root + "/after.ll", "declare @sfn__syntax__parser__mod");
    fs.writeFile(root + "/map.tsv", "parser__mod\tsfn__syntax__parser__mod\n");
    let result = _classify(root, 0);
    if result != 0 {
        throw "rename-only classifier rejected a mapped EOF rename";
    }
}
