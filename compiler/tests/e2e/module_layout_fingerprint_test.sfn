// Regression coverage for SFN-661. `scripts/module_layout_fingerprint.sh`
// hashes the sorted set of `.sfn` PATHS (not their bytes) so the build-cache
// key space can be segmented by module layout: a split/rename/add/remove
// lands in a fresh key space with nothing to restore from, closing the
// window where a stale cache entry keyed before the dep slug entered
// `cache_key_for` could serve IR mangled against a symbol that no longer
// exists.
//
// This guard is seed-independent, which is why it exists at all: CI's
// `make compile` is driven by the PINNED SEED, so the `cache_key_for`
// fix is inert there until a seed carrying it is pinned.
//
// The wiring tests below guard the companion hazard: the save key (in
// `.github/actions/sailfin-build/action.yml` and the `build-quality`
// job) and the restore prefix (the same action, plus the warmer job) must
// never drift apart, or PR CI is stranded on a permanently cold cache.
import { contains } from "sfn/strings";
import { sfn_bin_abs_path } from "sfn/test";

fn _repo_root() -> string ![io] {
    let mut repo = env.get("SAILFIN_REPO_ROOT");
    if repo.length == 0 { repo = env.get("PWD"); }
    if repo.length == 0 { repo = "."; }
    return repo;
}

// `run_capture`'s env is empty, not inherited — the script needs
// `sha256sum`/`shasum`, `find`, and `sort` on `PATH`.
fn _script_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    return e;
}

fn _fingerprint(root: string) -> string ![io] {
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let _exit = process.run_capture(["bash", script, root], _script_env());
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

fn _default_fingerprint(root: string) -> string ![io] {
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let _exit = process.run_capture_cwd(["bash", script], _script_env(), root);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

fn _freshness_fingerprint(root: string) -> string ![io] {
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let _exit = process.run_capture_cwd(["bash", script, "--freshness"], _script_env(), root);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

fn _ci_freshness_fingerprint(root: string) -> string ![io] {
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let _exit = process.run_capture_cwd(["bash", script, "--ci-freshness"], _script_env(), root);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

fn _inventory_view(root: string, view: string) -> string ![io] {
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let _exit = process.run_capture_cwd(["bash", script, view], _script_env(), root);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

fn _member_manifest(root: string, name: string) -> string ![io] {
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let _exit = process.run_capture_cwd(["bash", script, "--member-manifest", name], _script_env(), root);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

fn _native_freshness_fingerprint(root: string) -> string ![io] {
    let _exit = process.run_capture_cwd([sfn_bin_abs_path(), "dev", "bootstrap", "fingerprint"], [], root);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

// --------------------------------------------------------------
// Script behaviour
// --------------------------------------------------------------
test "module layout fingerprint: deterministic across repeated runs" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-determinism";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    fs.writeFile(scratch + "/main.sfn", "fn value() -> int { return 1; }\n");

    let first = _fingerprint(scratch);
    let second = _fingerprint(scratch);

    assert first.length > 0;
    assert first == second;
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: content edits do not change it" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-content";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    let source = scratch + "/main.sfn";
    fs.writeFile(source, "fn value() -> int { return 1; }\n");
    let before = _fingerprint(scratch);

    // The set of `.sfn` paths is unchanged, so appending a comment must
    // not move the fingerprint — it hashes paths only, deliberately
    // WITHOUT contents (SFN-661).
    fs.writeFile(source, "fn value() -> int { return 1; }\n// a comment\n");
    let after = _fingerprint(scratch);

    assert before.length > 0;
    assert before == after;
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: adding a module changes it" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-add";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    fs.writeFile(scratch + "/main.sfn", "fn value() -> int { return 1; }\n");
    let before = _fingerprint(scratch);

    fs.writeFile(scratch + "/extra.sfn", "fn other() -> int { return 2; }\n");
    let after = _fingerprint(scratch);

    assert before != after;
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: explicit overlapping roots preserve v1 multiplicity" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-overlap";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    fs.writeFile(scratch + "/main.sfn", "fn value() -> int { return 1; }\n");
    let once = _fingerprint(scratch);
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let _exit = process.run_capture(["bash", script, scratch, scratch], _script_env());
    let twice = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    assert once != twice;
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: transitional workspace expands deterministically" ![io] {
    let root = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/transitional";
    let first = _default_fingerprint(root);
    let second = _default_fingerprint(root);
    assert first.length == 68;
    assert substring(first, 0, 3) == "v2-";
    assert first == second;
}

test "module layout fingerprint: target workspace expands deterministically" ![io] {
    let root = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/target";
    let first = _default_fingerprint(root);
    let second = _default_fingerprint(root);
    assert first.length == 68;
    assert substring(first, 0, 3) == "v2-";
    assert first == second;
}

test "module layout fingerprint: shell and native v2 freshness inventories agree" ![io] {
    let transitional = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/transitional";
    let target = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/target";
    assert _freshness_fingerprint(transitional) == _native_freshness_fingerprint(transitional);
    assert _freshness_fingerprint(target) == _native_freshness_fingerprint(target);
}

test "module layout fingerprint: canonical views accept transitional and target roots" ![io] {
    let transitional = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/transitional";
    let target = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/target";
    let transitional_public = _inventory_view(transitional, "--public-members");
    let target_public = _inventory_view(target, "--public-members");

    assert contains(transitional_public, "sfn/strings\tcapsules/sfn/strings");
    assert contains(transitional_public, "sfn/json\tstdlib/json");
    assert contains(target_public, "sfn/strings\tstdlib/strings");
    assert contains(target_public, "sfn/prelude\tstdlib/prelude");
    assert ! contains(transitional_public, "sfn/runtime-native");
    assert ! contains(target_public, "sfn/compiler");
    assert _member_manifest(transitional, "sfn/compiler") == "compiler/capsule.toml\n";
    assert _member_manifest(target, "sfn/compiler") == "compiler/driver/capsule.toml\n";
}

test "module layout fingerprint: freshness is checkout-root independent and ignores docs" ![io] {
    let fixture = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/target";
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-root-independence";
    let first = scratch + "/first";
    let second = scratch + "/second";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    process.run(["cp", "-R", fixture, first]);
    process.run(["cp", "-R", fixture, second]);

    let dependency = "\n[dependencies]\n\"sfn/strings\" = \"*\"\n";
    let first_manifest = first + "/compiler/driver/capsule.toml";
    let second_manifest = second + "/compiler/driver/capsule.toml";
    fs.writeFile(first_manifest, fs.readFile(first_manifest) + dependency);
    fs.writeFile(second_manifest, fs.readFile(second_manifest) + dependency);

    let baseline = _ci_freshness_fingerprint(first);
    assert baseline == _ci_freshness_fingerprint(second);
    fs.writeFile(second + "/README.md", "documentation churn\n");
    assert baseline == _ci_freshness_fingerprint(second);
    fs.writeFile(second + "/stdlib/strings/src/mod.sfn", "fn moved() -> int { return 2; }\n");
    assert baseline != _ci_freshness_fingerprint(second);
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: duplicate canonical members fail every inventory view" ![io] {
    let root = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/duplicate_name";
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let exit = process.run_capture_cwd(["bash", script, "--member-records"], _script_env(), root);
    let _output = process.capture_take_stdout();
    let error = process.capture_take_stderr();
    assert exit != 0;
    assert contains(error, "duplicate workspace capsule name");
}

test "module layout fingerprint: freshness inputs name explicit files exactly once" ![io] {
    let inputs = _inventory_view(_repo_root(), "--ci-freshness-inputs");
    assert _count(inputs, "workspace.toml\n") == 1;
    assert _count(inputs, "bootstrap.toml\n") == 1;
    assert _count(inputs, "compiler/capsule.toml\n") == 1;
    assert _count(inputs, "runtime/capsule.toml\n") == 1;
    assert _count(inputs, "capsules/sfn/cli/src/mod.sfn\n") == 1;
    assert _count(inputs, "stdlib/strings/src/mod.sfn\n") == 1;
    assert _count(inputs, "capsules/sfn/crypto/src/mod.sfn\n") == 1;
    assert _count(inputs, "capsules/sfn/archive/src/mod.sfn\n") == 1;
}

test "module layout fingerprint: literal members ignore workspace excludes" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-literal-exclude";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch + "/stdlib/kept/src", true);
    fs.writeFile(scratch + "/workspace.toml", "[workspace]\nmembers = [\"stdlib/kept\"]\nexclude = [\"stdlib/kept\"]\n");
    fs.writeFile(scratch + "/stdlib/kept/capsule.toml", "[capsule]\nname = \"sfn/kept\"\n\n[build]\nkind = \"library\"\n");
    fs.writeFile(scratch + "/stdlib/kept/src/mod.sfn", "fn kept() -> int { return 1; }\n");
    let shell = _freshness_fingerprint(scratch);
    let native = _native_freshness_fingerprint(scratch);
    assert shell == native;
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: missing declared entry fails closed" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-missing-entry";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch + "/compiler/src", true);
    fs.writeFile(scratch + "/workspace.toml", "[workspace]\nmembers = [\"compiler\"]\n");
    fs.writeFile(scratch + "/compiler/capsule.toml", "[capsule]\nname = \"sfn/compiler\"\n\n[build]\nkind = \"binary\"\nentry = \"src/missing.sfn\"\n");
    fs.writeFile(scratch + "/compiler/src/other.sfn", "fn other() -> int { return 1; }\n");
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let exit = process.run_capture_cwd(["bash", script], _script_env(), scratch);
    let _output = process.capture_take_stdout();
    let error = process.capture_take_stderr();
    assert exit != 0;
    assert contains(error, "missing declared entry");
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: non-runtime IR is outside the layout" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/module-layout-fingerprint-nonruntime-ir";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch + "/stdlib/lib/src", true);
    fs.writeFile(scratch + "/workspace.toml", "[workspace]\nmembers = [\"stdlib/lib\"]\n");
    fs.writeFile(scratch + "/stdlib/lib/capsule.toml", "[capsule]\nname = \"sfn/lib\"\n\n[build]\nkind = \"library\"\n");
    fs.writeFile(scratch + "/stdlib/lib/src/mod.sfn", "fn value() -> int { return 1; }\n");
    let before = _default_fingerprint(scratch);
    fs.createDirectory(scratch + "/stdlib/lib/ir", true);
    fs.writeFile(scratch + "/stdlib/lib/ir/ignored.ll", "; ignored\n");
    assert _default_fingerprint(scratch) == before;
    process.run(["rm", "-rf", scratch]);
}

test "module layout fingerprint: missing member source fails closed" ![io] {
    let root = _repo_root()
        + "/compiler/tests/unit/fixtures/repository_topology/missing_source";
    let script = _repo_root() + "/scripts/module_layout_fingerprint.sh";
    let exit = process.run_capture_cwd(["bash", script], _script_env(), root);
    let _output = process.capture_take_stdout();
    let error = process.capture_take_stderr();
    assert exit != 0;
    assert contains(error, "member has no Sailfin source input");
}

// --------------------------------------------------------------
// CI wiring agreement
// --------------------------------------------------------------
// The save key and the restore-keys prefix must carry the same
// `steps.layout.outputs.fp` value at every `sailfin-buildcache-` site, or
// a PR restore can silently fall back to the target-only cache and never
// warm (SFN-661). Three sites: the composite action's key + restore-keys,
// the `build-quality` job's save key, and the warmer job's key +
// restore-keys.
fn _read_repo_file(path: string) -> string ![io] {
    return fs.readFile(_repo_root() + "/" + path);
}

// Count occurrences of `needle` in `text`. Asserting on COUNTS rather
// than on whole key lines is deliberate: an exact-line assertion breaks
// on any incidental whitespace or component reordering, while the
// invariant that matters is simply "every `sailfin-buildcache-` site
// carries the fingerprint". A count mismatch is exactly the drift that
// would strand PR CI on a cold cache (SFN-661).
fn _count(text: string, needle: string) -> int {
    if needle.length == 0 { return 0; }
    let mut n: int = 0;
    let mut i: int = 0;
    loop {
        if i + needle.length > text.length { break; }
        if substring(text, i, i + needle.length) == needle {
            n += 1;
            i += needle.length;
        } else { i += 1; }
    }
    return n;
}

test "module layout fingerprint: every build-cache key site carries the fp" ![io] {
    let action = _read_repo_file(".github/actions/sailfin-build/action.yml");
    let workflow = _read_repo_file(".github/workflows/build-quality.yml");

    // Count `steps.layout.outputs.fp`, NOT `sailfin-buildcache-`: the
    // latter also appears in explanatory prose, so it is not a usable
    // invariant. Every real key site interpolates the fp exactly once,
    // which makes the fp count the honest measure of coverage.
    // The action: one key + one restore-keys prefix, one fp step.
    assert contains(action, "id: layout");
    assert _count(action, "steps.layout.outputs.fp") == 2;
    assert _count(action, "id: layout") == 1;

    // build-quality.yml: the build-quality job's save key, plus the
    // warmer job's key and restore-keys prefix — three sites across two
    // jobs, each job defining its own fp step.
    assert _count(workflow, "steps.layout.outputs.fp") == 3;
    assert _count(workflow, "id: layout") == 2;
}

test "module layout fingerprint: every cache key uses canonical freshness" ![io] {
    let action = _read_repo_file(".github/actions/sailfin-build/action.yml");
    let workflow = _read_repo_file(".github/workflows/build-quality.yml");

    assert _count(action, "steps.layout.outputs.freshness") == 2;
    assert _count(workflow, "steps.layout.outputs.freshness") == 5;
    assert _count(action, "echo \"freshness=$freshness\"") == 1;
    assert _count(workflow, "echo \"freshness=$freshness\"") == 2;
    assert contains(action, "--ci-freshness");
    assert contains(workflow, "--ci-freshness");
    assert ! contains(action, "hashFiles('compiler/src");
    assert ! contains(workflow, "hashFiles('compiler/src");
}

test "module layout fingerprint: no site uses the failure-swallowing echo form" ![io] {
    // `echo "fp=$(bash ...)"` returns echo's exit status, not the
    // script's — a failing script would still exit the step green with
    // an empty fp, silently diverging the save key from the restore
    // prefix (SFN-661).
    let action = _read_repo_file(".github/actions/sailfin-build/action.yml");
    let workflow = _read_repo_file(".github/workflows/build-quality.yml");
    assert ! contains(action, "echo \"fp=$(bash");
    assert ! contains(workflow, "echo \"fp=$(bash");
}
