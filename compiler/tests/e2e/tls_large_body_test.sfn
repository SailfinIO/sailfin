// TLS record fragmentation over a full native loopback round-trip (SFN-984).
//
// Locks in that a payload larger than one TLS record survives both
// directions of a native-server ↔ native-client exchange. Before SFN-984,
// `runtime/sfn/platform/tls.sfn::tls_write` sealed exactly ONE record per
// call, so `_tls_seal_record`'s fail-closed `content_len > 16384` guard
// (RFC 8446 §5.1) turned any larger write into -1. Both send loops that sit
// above it — `runtime/sfn/adapters/http.sfn::_send_all` and
// `runtime/sfn/concurrency/serve.sfn::_serve_send_all` — already retried on a
// short write, but a -1 is not a short write: their `if n <= 0 { return
// false; }` arm read it as terminal and failed the transfer outright.
//
// The user-visible symptom was `sfn publish` reporting `publish failed —
// could not reach registry` for any capsule above ~12 KB of source. That
// threshold is not approximate: `compiler/src/cli/commands/publish.sfn`
// base64-encodes the tarball into a JSON body, and base64 inflates 4/3, so
// 12 KiB of source is exactly 16384 body bytes — the first byte over the
// record limit. `sfn/json`, `sfn/toml`, `sfn/crypto`, and `sfn/archive` were
// all unpublishable; every capsule that had ever published sat under it.
//
// Why an e2e and not a unit test. `tls_write`'s interesting behaviour is
// gated behind `state == connected` and ends in a real `send(2)` on
// `s.fd`, so a fabricated `TlsSession` reaches only the trivial -1
// early-returns. The record layer's own guard is deliberately correct and is
// already pinned by `tls_record_pointer_differential_test.sfn` (which asserts
// `sfn_tls_record_seal` REJECTS 16385 content bytes) — that assertion stays
// true here. What was missing is a caller that splits a large buffer across
// several wire-legal records, and only a live session exercises it.
//
// Coverage shape — one round-trip proves both directions:
//   - client → server: the handler only returns its OK marker when the
//     request it received is at least `_big_min()` bytes, so the marker's
//     presence proves the whole oversize POST body arrived (i.e. the client's
//     `_send_all` → `tls_write` fragmented rather than failing).
//   - server → client: the response body is itself larger than `_big_min()`,
//     so a full-length body proves the server's `_serve_send_all` →
//     `tls_write` fragmented too.
// The payload is 262144 bytes (16× the record limit), which also satisfies
// the issue's "≥200 KB" acceptance bar directly.
//
// A plaintext leg runs the identical exchange over `sfn_serve`. It never
// touched the record layer and passed before the fix, so it is the control
// that keeps a future regression attributable to TLS rather than to the
// oversize body itself.
//
// no-bash-e2e (`.claude/rules/no-bash-e2e.md`): an `![io]` `*_test.sfn`
// drives everything via `process.*`; `openssl` is the cert generator only,
// and both peers are native Sailfin binaries. Builds thread the full parent
// environment (the nested build links via clang + ld) so
// `SAILFIN_TEST_SCRATCH` rides along and the build cache stays
// per-invocation under the parallel pool.
//
// Matchers note (#842): `sfn/test`'s `expect_*` matchers are `![pure]` and
// cannot be called from an `![io]` test; assert on captured text with
// `sfn/strings::contains` instead.
import { Env, env_from_current } from "sfn/os";
import { contains, find } from "sfn/strings";
import {
    default_scratch_dir,
    report_child_failure,
    report_child_failure_pending,
    sfn_bin_path,
    start_background,
    stop_background,
    tool_present,
    wait_until
} from "sfn/test";

// ── file-local raw loopback readiness probe ──────────────────────
// Prefixed `_tlb_` so these never collide with the external-linkage runtime
// helpers of the same shape in `http.sfn`.
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

// `sfn_socket_open`, not the raw libc `socket` — on Windows every raw
// `socket()` call fails until `WSAStartup` runs in the process (SFN-1114):
// a probe of `socket(2, 1, 0)` here returns fd=-1 with
// `WSAGetLastError()` = 10093 (WSANOTINITIALISED). `sfn_socket_open`
// (`runtime/sfn/platform/socket_ops_windows.sfn`) is the runtime's socket
// creator and carries the `WSAStartup` call; its POSIX sibling
// (`socket_ops.sfn`) is a direct pass-through, so this is the correct
// symbol on every target, not a Windows-only substitution. Effect note:
// `socket_ops.sfn` is `net`-gated (`runtime/capsule.toml`
// `[sfn-source-gates]`), so `_tlb_connect` and every caller up to
// `_await_listening`/both tests declare `![net]` transitively (SFN-927 is
// the undefined-symbol failure mode otherwise).
extern fn sfn_socket_open(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

// `sfn_socket_close`, not the raw libc `close` — on Windows `close()` on a
// Winsock SOCKET is not an error return but a process-killing
// `__fastfail(0xC0000409)` (`socket_ops_windows.sfn:11-12`). The runtime
// helper routes to `closesocket` there and to `close` on POSIX
// (`socket_ops.sfn:101`), so it is correct on every target (SFN-1114).
extern fn sfn_socket_close(fd: i32) -> i32;

fn _tlb_ptr_off(base: *u8, off: i64) -> *u8 {
    return ((base as i64) + off) as *u8;
}

// Connect to 127.0.0.1:`port`, trying both `sockaddr_in` layouts (Linux's
// u16 `sin_family` at offset 0, macOS/BSD's u8 `sin_len` + u8 `sin_family`).
// The platform-agnostic emitted IR cannot branch on the layout, so the
// wrong-layout attempt fails fast with EAFNOSUPPORT without connecting
// anywhere — the same two-attempt shape as `http.sfn::_connect_tcp`.
fn _tlb_connect(port: i64) -> i32 ![net] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_tlb_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_tlb_ptr_off(addr, 0), 16, 1 as usize);
            memset(_tlb_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_tlb_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_tlb_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        memset(_tlb_ptr_off(addr, 4), 127, 1 as usize);
        memset(_tlb_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

// Fixed loopback ports for this test. A collision here is invisible to a
// serial local run and fails only under the pool's `--jobs N`, which is the
// pool-only class `.claude/rules/no-bash-e2e.md` warns about — so the survey
// matters more than the specific numbers.
//
// Claimed across `compiler/tests/` at the time of writing: 18790-18799,
// 18882-18886, 18893-18895, 18898-18900, 18902, 18910-18912. 18913-18919 is
// the nearest free block; 18916/18917 are taken here rather than extending a
// range. 18898/18899 were the original choice and were WRONG —
// `runtime_tls_aes_gcm_client_test.sfn:304,350` owns them, and
// `socket_ops_timeout_readback_test.sfn:69` already records that ownership.
fn _tls_port() -> i64 { return 18916; }

fn _tls_port_str() -> string { return "18916"; }

fn _plain_port() -> i64 { return 18917; }

fn _plain_port_str() -> string { return "18917"; }

// The payload floor, in bytes, for both the request and the response: 16x
// the 2^14 TLS record limit, so a correct implementation must emit 16
// records and the pre-SFN-984 implementation fails on the first one. Also
// clears the issue's "≥200 KB" acceptance bar. Well under
// `sfn/http`'s 1 MiB request cap, so the server accepts it.
fn _big_min() -> i64 { return 200000; }

fn _big_min_str() -> string { return "200000"; }

// The marker the handler returns only when it saw a full-size request.
fn _ok_marker() -> string { return "TLS-BIG-OK-5b2a"; }

// Emitted into both fixtures: grow a repeating pattern by DOUBLING until it
// clears `_big_min()`, yielding 262144 bytes. Doubling rather than appending
// a fixed chunk per iteration is deliberate — repeated `s = s + <chunk>` is
// quadratic in the final length, which is the exact shape SFN-976 fixed in
// `base64_encode`, and a fixture is no better a place for it.
fn _big_helper() -> string {
    return "fn _big() -> string {\n" + "    let mut s = \"0123456789abcdef\";\n"
        + "    loop {\n"
        + "        if s.length >= "
        + _big_min_str()
        + " { break; }\n"
        + "        s = s + s;\n"
        + "    }\n"
        + "    return s;\n"
        + "}\n"
        + "\n";
}

// Full parent environment for the build + server + client subprocesses
// (`run_capture`/`spawn_with_env`'s empty env is EMPTY, not "inherit"): the
// nested build links a binary (clang + ld), and `SAILFIN_TEST_SCRATCH`
// (already present) keeps the build cache per-invocation under the pool.
fn _child_env() -> string[] ![io] { return process.environ(); }

// The same environment in `sfn/os`'s typed form, for `start_background`.
fn _child_env_typed() -> Env ![io] { return env_from_current(); }

// Parent environment with any inherited `SAILFIN_TLS_CAFILE` stripped. A
// child's `getenv` resolves the FIRST matching entry, so a CAFILE set in the
// parent shell would otherwise shadow this test's intended cert.
// `find(...) != 0` keeps every entry whose `SAILFIN_TLS_CAFILE=` prefix is
// NOT at index 0 (i.e. not this variable).
fn _env_no_cafile() -> string[] ![io] {
    let src = process.environ();
    let mut out: string[] = [];
    let mut i: i64 = 0;
    loop {
        if i >= src.length { break; }
        let entry = src[i];
        if find(entry, "SAILFIN_TLS_CAFILE=", 0) != 0 { out.push(entry); }
        i = i + 1;
    }
    return out;
}

// Client run-env with `SAILFIN_TLS_CAFILE` pointed at `cert_path` so the
// self-signed chain verifies (the cert as its own trust anchor).
fn _trusted_env(cert_path: string) -> string[] ![io] {
    let mut e = _env_no_cafile();
    e.push("SAILFIN_TLS_CAFILE=" + cert_path);
    return e;
}

// A per-test scratch dir (under the runner's per-file scratch when present,
// else /tmp). Absolute so the server's baked cert/key paths resolve
// regardless of the server process's cwd.
fn _scratch_dir(name: string) -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/" + name;
    fs.createDirectory(dir, true);
    return dir;
}

// Generate a self-signed cert+key (no passphrase) with SAN = `san_host`. The
// client enforces RFC-6125 hostname verification, and modern OpenSSL checks
// the SAN (not the CN) when one is present, so the SAN must match the host
// the client connects to. Ed25519 because the native TLS server signs
// CertificateVerify with Ed25519 only (SFN-341).
fn _gen_cert(dir: string, san_host: string) -> boolean ![io] {
    let exit = process.run_capture(["openssl", "req", "-x509", "-newkey", "ed25519", "-keyout", dir
        + "/key.pem", "-out", dir
        + "/cert.pem", "-days", "1", "-nodes", "-subj", "/CN="
        + san_host, "-addext", "subjectAltName=DNS:"
        + san_host], _child_env());
    report_child_failure_pending("tls-large-body cert-gen", exit);
    return exit == 0;
}

// Shared server-fixture body: the libc memory externs, a layout-matching
// `OwnedBuf` (the moved-`OwnedBuf` handler ABI, #1476), an `_owned_from`
// returning a fresh libc-backed buffer, and a `handle` that gates its
// oversize reply on having RECEIVED an oversize request.
//
// The length gate is what makes one round-trip prove both directions: the
// runtime hands `handle` the whole request (head + body), so `req.len >=
// _big_min()` cannot hold unless every byte of the client's oversize POST
// body arrived. A client whose `tls_write` failed mid-body never reaches
// here at all, and one that silently truncated gets `SHORT-REQ` instead of
// the marker — so neither failure can pass as success.
fn _owned_and_handle() -> string {
    return "extern fn malloc(size: usize) -> * u8;\n"
        + "extern fn memcpy(dst: * u8, src: * u8, n: usize) -> * u8;\n"
        + "extern fn memset(dst: * u8, byte: i32, n: usize) -> * u8;\n"
        + "extern fn strlen(s: * u8) -> usize;\n"
        + "\n"
        + "struct OwnedBuf {\n"
        + "    ptr_addr: i64;\n"
        + "    len: i64;\n"
        + "    cap: i64;\n"
        + "    arena_addr: i64;\n"
        + "}\n"
        + "\n"
        + "fn _owned_from(s: string) -> OwnedBuf {\n"
        + "    let src: * u8 = s as * u8;\n"
        + "    let n: i64 = strlen(src) as i64;\n"
        + "    let copy: * u8 = malloc((n + 1) as usize);\n"
        + "    if copy as i64 == 0 { return OwnedBuf { ptr_addr: 0, len: 0, cap: 0, arena_addr: 0 }; }\n"
        + "    memcpy(copy, src, n as usize);\n"
        + "    memset(((copy as i64) + n) as * u8, 0, 1 as usize);\n"
        + "    return OwnedBuf { ptr_addr: copy as i64, len: n, cap: n + 1, arena_addr: 0 };\n"
        + "}\n"
        + "\n"
        + _big_helper()
        + "fn handle(req: OwnedBuf) -> OwnedBuf {\n"
        + "    if req.len >= "
        + _big_min_str()
        + " { return _owned_from(\""
        + _ok_marker()
        + "\" + _big()); }\n"
        + "    return _owned_from(\"SHORT-REQ\");\n"
        + "}\n"
        + "\n";
}

// Write the TLS server fixture: the shared handler plus a `main` that starts
// `sfn_serve_tls` (declared `extern`; the linker resolves it to
// `runtime/sfn/concurrency/serve.sfn`) with the cert/key paths read back
// from `argv[1]` (the scratch dir) rather than spliced into this source
// text. `SAILFIN_TEST_SCRATCH`/`TEMP` is a native Windows backslash path,
// and a literal `+ dir +` here would silently corrupt it the same way SFN-1001
// already diagnosed and fixed in `runtime_tls_anchor_cache_test.sfn`:
// `decode_string_literal_escapes` (`compiler/capsules/syntax/src/parser/utils.sfn:84-113`)
// drops the backslash for any `\<char>` it does not recognize as an escape
// when the nested build re-lexes this generated file, turning
// `C:\Users\...` into `C:Users...` — a different, non-existent path that
// `sfn_fs_read_file` then silently fails to open, so `tls_server_ctx`
// returns null and `sfn_serve_tls` returns before ever binding. Also prints
// a startup marker and checks both paths exist before serving, so a future
// regression here announces itself instead of a bare "never became
// connectable".
fn _write_tls_server(dir: string) -> string ![io] {
    let src = dir + "/tlssrv.sfn";
    fs.writeFile(src, "extern fn sfn_serve_tls(handler: * u8, port: i32, cert: * u8, key: * u8) -> void;\n"
        + _owned_and_handle()
        + "fn main(argv: string[]) -> int ![net, io] {\n"
        + "    let dir = argv[1];\n"
        + "    let cert = dir + \"/cert.pem\";\n"
        + "    let key = dir + \"/key.pem\";\n"
        + "    if !fs.exists(cert) {\n"
        + "        print.err(\"[tls-large-body-srv] missing cert at \" + cert);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    if !fs.exists(key) {\n"
        + "        print.err(\"[tls-large-body-srv] missing key at \" + key);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    print.info(\"[tls-large-body-srv] starting TLS on port "
        + _tls_port_str()
        + "\");\n"
        + "    sfn_serve_tls(handle as * u8, "
        + _tls_port_str()
        + ", cert as * u8, key as * u8);\n"
        + "    return 0;\n"
        + "}\n");
    return src;
}

// Write the plaintext server fixture — the control leg's peer. No
// filesystem path is baked into the source here, so it is not exposed to
// the corruption `_write_tls_server` guards against — the startup marker is
// added anyway so a silent-return regression on this leg would also
// announce itself.
fn _write_plain_server(dir: string) -> string ![io] {
    let src = dir + "/plainsrv.sfn";
    fs.writeFile(src, "extern fn sfn_serve(handler: * u8, port: i32) -> void;\n"
        + _owned_and_handle()
        + "fn main() -> int ![net, io] {\n"
        + "    print.info(\"[tls-large-body-srv] starting plaintext on port "
        + _plain_port_str()
        + "\");\n"
        + "    sfn_serve(handle as * u8, "
        + _plain_port_str()
        + ");\n"
        + "    return 0;\n"
        + "}\n");
    return src;
}

// Write a client fixture capsule whose `main` POSTs an oversize body to
// `url` and writes the response to `<argv[1]>/body.out`. `http.post_json`
// returns the response body, or an empty result when the round-trip failed
// before a status was obtained — the same `resp.status == 0` path `sfn
// publish` reports as "could not reach registry". So the file's presence +
// content is the round-trip proof and its absence is the failure proof.
//
// The body is shaped like `publish.sfn`'s: a JSON object whose one large
// field stands in for the base64 tarball. Only its SIZE matters to the
// record layer, but keeping the shape means this exercises the same
// `http.post_json` entry point publishing uses.
//
// The scratch dir travels through `argv[1]`, never spliced into this source
// text — see `_write_tls_server`'s header for why (SFN-1001). Also prints a
// startup marker and whether the response landed, so a corrupted path (or
// any other silent failure) shows up in the client's own captured stdout
// instead of only as an empty body one layer up. Every leg of this file
// expects a body, so an absent write here is always unexpected — unlike
// `tls_loopback_test.sfn`'s verify-rejection leg — but it is still reported
// rather than failed here: `report_child_failure`/the empty-body print at
// the call site already surface it, and keeping this fixture's exit code
// tied only to whether it COULD run (not to whether the peer answered)
// keeps the two failure classes distinguishable.
fn _write_client(dir: string, url: string) -> string ![io] {
    let root = dir + "/client";
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/tls-large-body-e2e-client\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"tls large-body e2e client\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", _big_helper()
        + "fn main(argv: string[]) -> int ![net, io] {\n"
        + "    let dir = argv[1];\n"
        + "    let out_path = dir + \"/body.out\";\n"
        + "    if !fs.exists(dir) {\n"
        + "        print.err(\"[tls-large-body-cli] scratch dir missing: \" + dir);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    print.info(\"[tls-large-body-cli] starting, target \" + out_path);\n"
        + "    let body = \"{\\\"content\\\":\\\"\" + _big() + \"\\\"}\";\n"
        + "    let resp = http.post_json(\""
        + url
        + "\", body, \"\");\n"
        + "    if resp.length > 0 {\n"
        + "        fs.writeFile(out_path, resp);\n"
        + "        print.info(\"[tls-large-body-cli] wrote \" + out_path);\n"
        + "    } else {\n"
        + "        print.info(\"[tls-large-body-cli] empty response, no file written\");\n"
        + "    }\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

// Compile a fixture to a standalone binary up front (synchronous), so the
// cold compile is NOT inside the readiness poll window.
fn _build_bin(main_path: string, bin: string) -> string ![io] {
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", bin, main_path], _child_env());
    report_child_failure_pending("tls-large-body build", exit);
    if exit != 0 { return ""; }
    return bin;
}

// Poll a raw TCP connect until the prebuilt server is accepting. 30s
// wall-clock budget. `port` is a typed parameter (not an untyped call-
// initialized `let`), so capturing it in the probe closure below is
// unaffected by SFN-843.
fn _await_listening(port: i64) -> boolean ![clock, io, net] {
    let start_ms: int = monotonic_millis();
    let ok = wait_until(fn () -> boolean {
        let fd: i32 = _tlb_connect(port);
        if fd >= 0 {
            sfn_socket_close(fd);
            return true;
        }
        return false;
    }, 30000, 500);
    if !ok {
        let elapsed: int = monotonic_millis() - start_ms;
        print.info("[tls-large-body] probe: no listener on 127.0.0.1:"
            + number_to_string(port)
            + " after "
            + number_to_string(elapsed)
            + "ms");
    }
    return ok;
}

// Run the client once and return the response body it wrote (or "" if it
// wrote nothing — a failed round-trip). `dir` is passed as the client's
// `argv[1]` (see `_write_client`'s header for why — SFN-1001), and
// `out_path` is recomputed here identically to how the fixture computes it
// internally. Removes any stale output first so the result reflects THIS
// run only.
fn _client_body(client_bin: string, run_env: string[], dir: string) -> string ![io] {
    let out_path = dir + "/body.out";
    let _rm = fs.deleteFile(out_path);
    let cexit = process.run_capture([client_bin, dir], run_env);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("tls-large-body client run", cexit, out, err);
    if cexit != 0 { return ""; }
    if !fs.exists(out_path) {
        // Distinguishes "the client failed to run" (report_child_failure
        // above, exit != 0) from "the client ran and wrote nothing" — both
        // previously collapsed into the identical empty `body` a caller
        // sees, with no way to tell them apart from the retry loop alone.
        print.info("[tls-large-body] client exited 0 but wrote no file at "
            + out_path
            + "; stdout=\""
            + substring(out, 0, 2048)
            + "\" stderr=\""
            + substring(err, 0, 2048)
            + "\"");
        return "";
    }
    return fs.readFile(out_path);
}

// Retry a few times to absorb residual server startup latency — used only
// for a POSITIVE round-trip, where a body IS expected.
fn _client_body_retry(client_bin: string, run_env: string[], dir: string) -> string ![clock, io] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 20 { break; }
        let body = _client_body(client_bin, run_env, dir);
        if body.length > 0 { return body; }
        sleep(500);
        attempt = attempt + 1;
    }
    return "";
}

// Renders a downloaded body for a diagnostic print: length plus a bounded
// prefix. This test's bodies are ~262144 bytes by design (`_big_min()`), so
// printing one whole would flood the log — a truncated prefix is enough to
// tell "empty"/"short"/"the expected shape" apart.
fn _describe_body(body: string) -> string {
    return "length=" + number_to_string(body.length) + " prefix=\"" + substring(body, 0, 200)
        + "\"";
}

test "tls: a payload larger than one TLS record round-trips in both directions" ![clock, io, net] {
    // `openssl` generates the self-signed cert; skip cleanly without it.
    if !tool_present("openssl") {
        print.info("[tls-large-body] SKIP: openssl CLI not available");
        assert true;
        return;
    }

    let dir = _scratch_dir("sfn-tls-large-body");
    let cert = dir + "/cert.pem";
    let key = dir + "/key.pem";
    // SAN matches the connect host (localhost), so trust is the only thing
    // that could reject the peer — and the trusted env supplies it.
    assert _gen_cert(dir, "localhost");

    // Build the native TLS server binary up front (synchronous), so the cold
    // compile is not inside the readiness poll window.
    let srv_main = _write_tls_server(dir);
    let srv_bin: string = _build_bin(srv_main, dir + "/tlssrv-bin");
    assert srv_bin.length > 0;

    // Build the native https client fixture.
    let out_path = dir + "/body.out";
    let cli_main = _write_client(dir, "https://localhost:" + _tls_port_str()
        + "/");
    let cli_bin = _build_bin(cli_main, dir + "/client-bin");
    assert cli_bin.length > 0;

    // Managed explicitly (`start_background`/`stop_background`) rather than
    // through the scoped `with_background` fixture: `with_background`'s own
    // catch drains and DISCARDS the child's streams before rethrowing, so a
    // server that never becomes connectable always reported bare "assertion
    // failed" with no signal from the server side. Draining here on the
    // specific readiness-failure path keeps that signal. `dir` rides as
    // `argv[1]` (see `_write_tls_server`'s header — SFN-1001).
    let server = start_background([srv_bin, dir], _child_env_typed(), "", "tls-large-body-server");
    assert server.handle.handle_id != 0;

    let up = _await_listening(_tls_port());
    if !up {
        let drain = stop_background(server);
        print.info("[tls-large-body] TLS server never became connectable; exit="
            + number_to_string(drain.exit)
            + " stdout=\""
            + substring(drain.stdout, 0, 4096)
            + "\" stderr=\""
            + substring(drain.stderr, 0, 4096)
            + "\"");
    }
    assert up;

    try {
        let body = _client_body_retry(cli_bin, _trusted_env(cert), dir);
        print.info("[tls-large-body] round-trip body: " + _describe_body(body));

        // A body at all means the oversize request was sent, framed, and
        // answered — the pre-SFN-984 client failed `_send_all` here and
        // wrote nothing, surfacing as "could not reach registry".
        assert body.length > 0;

        // client → server: the handler emits its marker ONLY when the
        // request it received cleared `_big_min()`, so this is the proof
        // that every byte of the oversize POST body arrived rather than
        // being truncated.
        assert contains(body, _ok_marker());

        // server → client: the response itself is oversize, so a
        // full-length body proves the server fragmented its reply too.
        assert body.length >= _big_min();
        let _ = stop_background(server);
    } catch (err) {
        // Reap first, then re-throw, so the failing test still fails with
        // its own message rather than a teardown error — mirrors
        // `with_background`'s own catch (SFN-402/SFEP-0050 §5.1).
        let _ = stop_background(server);
        throw err;
    }

    // Best-effort cleanup. The server itself was already killed and reaped
    // above.
    let _rm = process.run(["rm", "-rf", dir]);
}

test "tls: the same oversize payload round-trips over plaintext (control)" ![clock, io, net] {
    // This leg never touched the record layer and passed before SFN-984, so
    // it keeps a future failure attributable to TLS rather than to the
    // oversize body itself.
    let dir = _scratch_dir("sfn-tls-large-body-plain");

    let srv_main = _write_plain_server(dir);
    let srv_bin: string = _build_bin(srv_main, dir + "/plainsrv-bin");
    assert srv_bin.length > 0;

    let out_path = dir + "/body.out";
    let cli_main = _write_client(dir, "http://localhost:" + _plain_port_str()
        + "/");
    let cli_bin = _build_bin(cli_main, dir + "/client-bin");
    assert cli_bin.length > 0;

    // See the TLS test above for why this manages the server explicitly
    // instead of through `with_background`.
    let server = start_background([srv_bin], _child_env_typed(), "", "tls-large-body-plain-server");
    assert server.handle.handle_id != 0;

    let up = _await_listening(_plain_port());
    if !up {
        let drain = stop_background(server);
        print.info("[tls-large-body] plaintext server never became connectable; exit="
            + number_to_string(drain.exit)
            + " stdout=\""
            + substring(drain.stdout, 0, 4096)
            + "\" stderr=\""
            + substring(drain.stderr, 0, 4096)
            + "\"");
    }
    assert up;

    try {
        let body = _client_body_retry(cli_bin, _child_env(), dir);
        print.info("[tls-large-body] plaintext round-trip body: "
            + _describe_body(body));
        assert body.length > 0;
        assert contains(body, _ok_marker());
        assert body.length >= _big_min();
        let _ = stop_background(server);
    } catch (err) {
        let _ = stop_background(server);
        throw err;
    }

    let _rm = process.run(["rm", "-rf", dir]);
}
