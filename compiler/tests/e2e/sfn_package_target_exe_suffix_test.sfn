// compiler/tests/e2e/sfn_package_target_exe_suffix_test.sfn
//
// SFN-972: a staged tarball member is a distribution artifact for the
// `--target` the package is built FOR, not for the host running `sfn
// package` — so the staged/archived binary names must be TARGET-gated
// (`_package_target_os` + `target_exe_name`, `compiler/src/cli/commands/
// package.sfn`), never HOST-gated (`host_exe_name`). Every runtime spawn
// site on Windows (`runtime/sfn/platform/process_windows.sfn`) calls
// `CreateProcessA` with `lpApplicationName = null`, so an extensionless PE
// this compiler stages into a Windows tarball is unlaunchable (SFN-693).
//
// Covers both staging sites (`_package_compiler` and `_package_installer`)
// and both target flavours:
//   - `--target windows-x86_64` -> `bin/sfn.exe`, `bin/sailfin.exe`
//   - `--target linux-x86_64`   -> `bin/sfn`, `bin/sailfin` (today's shape,
//     byte-identical)
//
// Also asserts the exec bit survives the rename on the Windows members —
// `CreateOptions.exec_paths` (`sfn/archive`) is matched against archive
// member paths, so if the staged file is renamed but `exec_paths` is not
// updated in lockstep, the match silently fails and the binary archives
// 0644 instead of 0755 with NO error (the SFN-972 spec's "silent-failure
// trap"). Uses `tar -tvzf` (permission-bit listing) rather than the plain
// `-tzf` listing `sfn_package_test.sfn` uses elsewhere, since only the
// verbose form carries the mode string.
//
// The `--compiler-bin` source MUST be non-executable (0644), not the live
// host `sfn` binary: `_tw_is_executable`
// (`stdlib/archive/src/tar_write.sfn`) ORs `exec_paths` membership
// with a live `fs.is_executable` probe on the STAGED file, and
// `_copy_file_preserving_mode` (`compiler/src/build/fs.sfn`) copies the
// source's mode onto the staged copy. An executable source (0755) makes
// the `fs.is_executable` fallback fire regardless of `exec_paths`, so the
// exec-bit assertions below would pass even through the exact lockstep
// regression SFN-972 exists to catch. `_nonexec_compiler_bin` stages a
// 0644 copy so the archived exec bit can only come from `exec_paths`.
//
// This drives a real `sfn package --target ...` against the actual host
// binary (a Linux ELF) staged under a Windows-flavoured name — the naming
// and archiving decision is independent of what platform the binary was
// actually built for, matching `sfn_package_test.sfn`'s existing shape
// (`--compiler-bin` pointed at the host binary regardless of `--target`).
import { contains, split } from "sfn/strings";
import {
    clean_runner_env,
    default_scratch_dir,
    host_is_windows,
    report_child_failure,
    report_child_failure_pending,
    sfn_bin_abs_path,
    sfn_bin_path,
    tool_present
} from "sfn/test";

import { _dirname, _path_basename } from "../../src/build/paths";

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    return dir;
}

fn _test_root(tag: string) -> string ![io] {
    let root = _scratch_dir() + "/sfnpkg-exe-" + tag;
    fs.createDirectory(root, true);
    return root;
}

// The child env is derived by subtraction from the real environment, not
// assembled key by key (SFN-1114).
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

// `tar -tvzf <tarball>` -> full verbose listing text (permission bits +
// member path per line), the only `tar` listing form that carries mode.
// Run with `tar`'s cwd set to the tarball's own directory and a bare
// basename argument, never the full path: GNU tar reads an `X:`
// drive-letter prefix as `[user@]host:path` remote-archive syntax and
// refuses to open it locally — fatal for every one of this file's paths
// (native Windows scratch roots). `--force-local` is a GNU extension
// bsdtar (macOS) does not reliably carry, so dropping the path argument
// entirely is the only fix safe on every host (`sfn_package_test.sfn::_tar_list`,
// same rationale).
fn _tar_list_verbose(tarball: string) -> string ![io] {
    let dir = _dirname(tarball);
    let base = _path_basename(tarball);
    let exit = process.run_capture_cwd(["tar", "-tvzf", base], _child_env(), dir);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("sfn-package-exe-suffix tar-list", exit, out, err);
    if exit != 0 { return ""; }
    return out;
}

// Split on `\n` and strip a trailing `\r` from each line. MSYS `tar`
// writes CRLF into a native Win32 pipe (a foreign consumer as far as its
// own newline handling is concerned — confirmed by measurement in
// `sfn_package_test.sfn::_split_lines`, the source of this shape): the CR
// is invisible in any printed log and fatal to a suffix or equality
// comparison against a `\n`-split line, while leaving the line COUNT
// untouched. Stripped once at the split point rather than at each
// comparison, so every consumer built on top inherits the fix.
fn _split_lines(text: string) -> string[] {
    let raw = split(text, "\n");
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= raw.length { break; }
        let mut line = raw[i];
        if line.length > 0 && substring(line, line.length - 1, line.length) == "\r" {
            line = substring(line, 0, line.length - 1);
        }
        out.push(line);
        i += 1;
    }
    return out;
}

// The verbose listing line whose path ends in `suffix`, or "" if none.
fn _verbose_line_for_suffix(listing: string, suffix: string) -> string {
    let lines = _split_lines(listing);
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if line.length >= suffix.length {
            let tail = substring(line, line.length - suffix.length, line.length);
            if tail == suffix { return line; }
        }
        i += 1;
    }
    return "";
}

// A ustar verbose listing line's leading permission field starts with
// `-rwx` for an executable regular file (the mode `_copy_file_preserving_mode`
// + `CreateOptions.exec_paths` are meant to produce for a staged binary).
fn _line_is_exec(line: string) -> bool {
    if line.length < 4 { return false; }
    return substring(line, 0, 4) == "-rwx";
}

// True when `tar`, `cp`, and `chmod` are all present — the full toolset the
// exec-bit tests below need (`tool_present("tar")` alone is not enough
// once `--compiler-bin` is staged through `cp`/`chmod`).
fn _exec_bit_tools_present() -> bool ![io] {
    if !tool_present("tar") { return false; }
    if !tool_present("cp") { return false; }
    if !tool_present("chmod") { return false; }
    return true;
}

// A 0644 copy of `src` at `<root>/cbin/sfn`, for use as `--compiler-bin`.
// See the module doc comment: the staged file's mode must NOT be
// executable, or `_tw_is_executable`'s live-probe fallback masks an
// `exec_paths` lockstep regression.
fn _nonexec_compiler_bin(root: string, src: string) -> string ![io] {
    fs.createDirectory(root + "/cbin", true);
    let bin = root + "/cbin/sfn";
    let cp_exit = process.run_capture(["cp", src, bin], _child_env());
    report_child_failure_pending("sfn-package-exe-suffix cp", cp_exit);
    if cp_exit != 0 { return ""; }
    let chmod_exit = process.run_capture(["chmod", "644", bin], _child_env());
    report_child_failure_pending("sfn-package-exe-suffix chmod", chmod_exit);
    if chmod_exit != 0 { return ""; }
    return bin;
}

fn _find_tarball(dir: string, prefix: string) -> string ![io] {
    if !fs.exists(dir) { return ""; }
    let entries = fs.listDirectory(dir);
    let mut i = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        let starts = name.length >= prefix.length && substring(name, 0, prefix.length) == prefix;
        let ends = name.length >= 7 && substring(name, name.length - 7, name.length) == ".tar.gz";
        if starts && ends { return dir + "/" + name; }
        i += 1;
    }
    return "";
}

// =====================================================================
// Compiler mode
// =====================================================================
test "sfn package (compiler mode): windows target stages .exe members with exec bit" ![io] {
    if !_exec_bit_tools_present() {
        assert true;
        return;
    }

    let root = _test_root("compiler-win");
    let dist = root + "/dist";
    let bin = _nonexec_compiler_bin(root, sfn_bin_abs_path());
    assert bin.length > 0;

    let exit = process.run_capture([sfn_bin_path(), "package", "--target", "windows-x86_64", "--out", dist, "--compiler-bin", bin], _child_env());
    report_child_failure_pending("sfn-package-exe-suffix compiler-win build", exit);
    assert exit == 0;

    let tarball = _find_tarball(dist, "sailfin-native-windows-x86_64-");
    assert tarball.length > 0;

    let listing = _tar_list_verbose(tarball);
    let sfn_line = _verbose_line_for_suffix(listing, "/bin/sfn.exe");
    let sailfin_line = _verbose_line_for_suffix(listing, "/bin/sailfin.exe");
    assert sfn_line.length > 0;
    assert sailfin_line.length > 0;
    // The plain (non-`.exe`) names must be ABSENT — the member was renamed,
    // not duplicated under both names.
    assert _verbose_line_for_suffix(listing, "/bin/sfn") == "";
    assert _verbose_line_for_suffix(listing, "/bin/sailfin") == "";

    // The exec-bit trap (SFN-972): the rename must be reflected in
    // `exec_paths` too, or these members silently archive 0644. POSIX
    // only: `fs.is_executable` collapses to `fs.exists` on Windows by
    // design (`runtime/sfn/platform/fs_exec_mode_windows.sfn:27`, SFN-649
    // — UCRT's `_access` fast-fails on `X_OK`, and Windows has no execute
    // bit to ask about), so `_tw_is_executable`'s `exec_paths` fallback
    // answers `true` for every staged member regardless of `exec_paths`
    // there — a platform fact, not a stub awaiting implementation. The
    // suffix presence/absence asserted above is the whole SFN-972 claim
    // this host can check.
    if !host_is_windows() {
        assert _line_is_exec(sfn_line);
        assert _line_is_exec(sailfin_line);
    }
}

test "sfn package (compiler mode): linux target keeps today's suffixless members" ![io] {
    if !_exec_bit_tools_present() {
        assert true;
        return;
    }

    let root = _test_root("compiler-linux");
    let dist = root + "/dist";
    let bin = _nonexec_compiler_bin(root, sfn_bin_abs_path());
    assert bin.length > 0;

    let exit = process.run_capture([sfn_bin_path(), "package", "--target", "linux-x86_64", "--out", dist, "--compiler-bin", bin], _child_env());
    report_child_failure_pending("sfn-package-exe-suffix compiler-linux build", exit);
    assert exit == 0;

    let tarball = _find_tarball(dist, "sailfin-native-linux-x86_64-");
    assert tarball.length > 0;

    let listing = _tar_list_verbose(tarball);
    let sfn_line = _verbose_line_for_suffix(listing, "/bin/sfn");
    let sailfin_line = _verbose_line_for_suffix(listing, "/bin/sailfin");
    assert sfn_line.length > 0;
    assert sailfin_line.length > 0;
    assert ! contains(listing, "/bin/sfn.exe");
    assert ! contains(listing, "/bin/sailfin.exe");
    // POSIX only — see the windows-target test above for why:
    // `fs.is_executable` collapses to `fs.exists` on Windows (SFN-649,
    // `fs_exec_mode_windows.sfn:27`), so `_line_is_exec` has no
    // discriminating power there.
    if !host_is_windows() {
        assert _line_is_exec(sfn_line);
        assert _line_is_exec(sailfin_line);
    }
}

// =====================================================================
// Installer mode
// =====================================================================
test "sfn package --installer: windows target stages .exe members with exec bit" ![io] {
    if !_exec_bit_tools_present() {
        assert true;
        return;
    }

    let root = _test_root("installer-win");
    let dist = root + "/dist";
    let bin = _nonexec_compiler_bin(root, sfn_bin_abs_path());
    assert bin.length > 0;

    let exit = process.run_capture([sfn_bin_path(), "package", "--installer", "--target", "windows-x86_64", "--out", dist, "--compiler-bin", bin], _child_env());
    report_child_failure_pending("sfn-package-exe-suffix installer-win build", exit);
    assert exit == 0;

    let tarball = _find_tarball(dist, "installer-windows-x86_64");
    assert tarball.length > 0;

    let listing = _tar_list_verbose(tarball);
    let sfn_line = _verbose_line_for_suffix(listing, "bin/sfn.exe");
    let sailfin_line = _verbose_line_for_suffix(listing, "bin/sailfin.exe");
    assert sfn_line.length > 0;
    assert sailfin_line.length > 0;
    // The plain (non-`.exe`) names must be ABSENT — the member was renamed,
    // not duplicated under both names.
    assert _verbose_line_for_suffix(listing, "bin/sfn") == "";
    assert _verbose_line_for_suffix(listing, "bin/sailfin") == "";
    // The exec-bit trap (SFN-972), POSIX only — see the compiler-mode
    // windows-target test for why: `fs.is_executable` collapses to
    // `fs.exists` on Windows (SFN-649, `fs_exec_mode_windows.sfn:27`), so
    // `_line_is_exec` has no discriminating power there.
    if !host_is_windows() {
        assert _line_is_exec(sfn_line);
        assert _line_is_exec(sailfin_line);
    }
}

test "sfn package --installer: linux target keeps today's suffixless members" ![io] {
    if !_exec_bit_tools_present() {
        assert true;
        return;
    }

    let root = _test_root("installer-linux");
    let dist = root + "/dist";
    let bin = _nonexec_compiler_bin(root, sfn_bin_abs_path());
    assert bin.length > 0;

    let exit = process.run_capture([sfn_bin_path(), "package", "--installer", "--target", "linux-x86_64", "--out", dist, "--compiler-bin", bin], _child_env());
    report_child_failure_pending("sfn-package-exe-suffix installer-linux build", exit);
    assert exit == 0;

    let tarball = _find_tarball(dist, "installer-linux-x86_64");
    assert tarball.length > 0;

    let listing = _tar_list_verbose(tarball);
    let sfn_line = _verbose_line_for_suffix(listing, "bin/sfn");
    let sailfin_line = _verbose_line_for_suffix(listing, "bin/sailfin");
    assert sfn_line.length > 0;
    assert sailfin_line.length > 0;
    assert ! contains(listing, "bin/sfn.exe");
    assert ! contains(listing, "bin/sailfin.exe");
    // POSIX only — see the compiler-mode windows-target test for why:
    // `fs.is_executable` collapses to `fs.exists` on Windows (SFN-649,
    // `fs_exec_mode_windows.sfn:27`), so `_line_is_exec` has no
    // discriminating power there.
    if !host_is_windows() {
        assert _line_is_exec(sfn_line);
        assert _line_is_exec(sailfin_line);
    }
}
