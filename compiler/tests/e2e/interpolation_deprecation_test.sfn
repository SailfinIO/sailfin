// End-to-end coverage for the SFEP-0057 Phase 2 deprecation lint (W0212,
// SFN-482). Compiling a source file that still uses `{{ }}` interpolation must
// surface a non-fatal W0212 warning via `sfn check` (so `assert_compiles` /
// `sfn check --json` consumers can see it) WITHOUT failing the check; a file on
// the recognized `${ }` form must emit no such warning. The detector is a
// check-time AST walk (interpolation_deprecation_check.sfn), not a lowering
// pass, so `sfn check` is the surface under test.
import { find } from "sfn/strings";
import { clean_runner_env, expect_eq_bool, nested_runner_scratch } from "sfn/test";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

test "interpolation deprecation: {{ }} emits W0212 without failing the build" ![io] {
    let exit = process.run_capture([_sfn_bin(), "check", "--json", "compiler/tests/e2e/fixtures/interp_deprecated_braces.sfn"], clean_runner_env(nested_runner_scratch("interp-dep-braces")));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let diag = out + err;
    // Non-fatal: the check succeeds even though the deprecated form is used.
    assert expect_eq_bool(exit == 0, true).ok;
    // The W0212 deprecation code appears in the JSON envelope.
    assert expect_eq_bool(find(diag, "W0212", 0) >= 0, true).ok;
}

test "interpolation deprecation: ${ } emits no W0212" ![io] {
    let exit = process.run_capture([_sfn_bin(), "check", "--json", "compiler/tests/e2e/fixtures/interp_dollar_clean.sfn"], clean_runner_env(nested_runner_scratch("interp-dep-dollar")));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let diag = out + err;
    assert expect_eq_bool(exit == 0, true).ok;
    assert expect_eq_bool(find(diag, "W0212", 0) < 0, true).ok;
}
