// SFN-674: fn-typed struct fields store the uniform `{code, env}` pair and
// dispatch through the existing closure seam. The fixture covers a top-level
// named function (non-capturing), a capturing lambda, and an ordinary method
// on the same struct so closure-field resolution remains ahead of method
// fan-out without stealing real method calls. A function-call receiver carries
// a string literal so successful speculative lowering must preserve all emitted
// artifacts, not only its LLVM lines.
import { contains, trim_right } from "sfn/strings";
import {
    clean_runner_env,
    expect_eq_bool,
    expect_eq_int,
    expect_eq_str,
    sfn_bin_path,
    with_tmp_dir
} from "sfn/test";

fn _fixture() -> string {
    return "compiler/tests/e2e/fixtures/fn_field_dispatch/main.sfn";
}

test "fn field: named and capturing values dispatch beside a struct method" ![io] {
    let mut output: string = "";
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let exit = process.run_capture([sfn_bin_path(), "run", _fixture()], clean_runner_env(dir));
        output = trim_right(process.capture_take_stdout());
        let _err = process.capture_take_stderr();
        return exit;
    });
    assert expect_eq_int(outcome, 0).ok;
    assert expect_eq_str(output, "6\n15\n42\n6").ok;
}

test "fn field: IR stores and loads closure pairs without pair boxing" ![io] {
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let llvm_path = dir + "/fn-field-dispatch.ll";
        let exit = process.run_capture([sfn_bin_path(), "emit", "-o", llvm_path, "llvm", _fixture()], clean_runner_env(dir));
        let _out = process.capture_take_stdout();
        let _err = process.capture_take_stderr();
        assert expect_eq_int(exit, 0).ok;
        assert expect_eq_bool(fs.exists(llvm_path), true).ok;

        let ir = fs.readFile(llvm_path);
        assert expect_eq_bool(contains(ir, "%Router = type { {i8*, i8*}, i64 }"), true).ok;
        assert expect_eq_bool(contains(ir, "insertvalue %Router undef, {i8*, i8*}"), true).ok;
        assert expect_eq_bool(contains(ir, "load {i8*, i8*}, {i8*, i8*}*"), true).ok;
        assert expect_eq_bool(contains(ir, "extractvalue {i8*, i8*}"), true).ok;
        // The general aggregate-to-pointer boxing fallback starts by sizing
        // the aggregate with this GEP. A closure pair belongs inline in the
        // field and must never enter that path; the Router itself remains a
        // normally boxed user struct.
        assert expect_eq_bool(contains(ir, "getelementptr {i8*, i8*}, {i8*, i8*}* null, i32 1"), false).ok;
        return 0;
    });
    assert expect_eq_int(outcome, 0).ok;
}
