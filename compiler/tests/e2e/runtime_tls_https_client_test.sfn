// Outbound HTTPS round-trip e2e for the native runtime's TLS surface
// (SFEP-0036 gap B1, #1782). Drives the real `https://` client path
// (`runtime/sfn/adapters/http.sfn` -> `runtime/sfn/platform/tls.sfn`,
// OpenSSL) against a local `openssl s_server` on loopback and asserts the
// response body arrives — proving the handshake, peer-chain verification,
// TLS read/write, and body extraction all work end-to-end.
//
// Shape (the no-bash-e2e pattern, `.claude/rules/no-bash-e2e.md`): the
// `openssl` CLI generates a self-signed cert (CN=localhost) and runs the
// TLS server (`s_server -www`, an HTTP status page). A generated Sailfin
// fixture `http.download`s the `https://` URL to a file; the test then
// reads that file. `http.download` writes the file ONLY on a successful
// round-trip (a failed connect/handshake/verify returns null before the
// file is opened), so a non-empty file is proof the TLS GET succeeded —
// and it sidesteps printing a possibly-null body string from the fixture.
//
// Trust: the fixture runs with `SAILFIN_TLS_CAFILE` pointed at the
// generated self-signed cert (which carries a `DNS:localhost` SAN), so
// `tls_client_ctx`'s verify-on default (SSL_VERIFY_PEER + polled
// SSL_get_verify_result) plus the RFC-6125 hostname check (SSL_set1_host,
// host = "localhost") both accept it. System trust-store discovery
// hardening + the verify-failure regression are #3.
//
// Skips cleanly (`assert true`, mirroring the tool-absent SKIP precedent)
// when `openssl` is missing (no TLS peer) or no `timeout`/`gtimeout` is
// available to reap the blocking `s_server` (no process-kill primitive).
// CI runners (Linux + coreutils + libssl) have both.
//
// Matchers note (#842): `sfn/test`'s `expect_*` matchers are `![pure]` and
// cannot be called from an `![io]` test; assert on captured text with
// `sfn/strings::contains` instead.
import { remove_all } from "sfn/fs";
import { Env, env_from_current } from "sfn/os";
import { contains } from "sfn/strings";
import {
    default_scratch_dir,
    report_child_failure,
    report_child_failure_pending,
    sfn_bin_path,
    start_background,
    stop_background,
    tool_present,
    wait_until
} from "sfn/test";

// ── file-local raw loopback readiness probe ──────────────────────
// Prefixed `_tlp_` so these never collide with the external-linkage
// runtime helpers of the same shape in `http.sfn` (not linked into this
// test binary, but the prefix keeps that independent of link order).
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

// `sfn_socket_open`, not the raw libc `socket` — on Windows every raw
// `socket()` call fails until `WSAStartup` runs in the process (SFN-1114):
// a probe of `socket(2, 1, 0)` here returns fd=-1 with
// `WSAGetLastError()` = 10093 (WSANOTINITIALISED). `sfn_socket_open`
// (`runtime/sfn/platform/socket_ops_windows.sfn`) is the runtime's socket
// creator and carries the `WSAStartup` call; its POSIX sibling
// (`socket_ops.sfn`) is a direct pass-through, so this is the correct
// symbol on every target, not a Windows-only substitution. Effect note:
// `socket_ops.sfn` is `net`-gated (`runtime/capsule.toml`
// `[sfn-source-gates]`), so `_tlp_connect` and every caller up to
// `_await_listening`/the test declare `![net]` transitively (SFN-927 is
// the undefined-symbol failure mode otherwise).
extern fn sfn_socket_open(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

// `sfn_socket_close`, not the raw libc `close` — on Windows `close()` on a
// Winsock SOCKET is not an error return but a process-killing
// `__fastfail(0xC0000409)` (`socket_ops_windows.sfn:11-12`). The runtime
// helper routes to `closesocket` there and to `close` on POSIX
// (`socket_ops.sfn:101`), so it is correct on every target (SFN-1114).
extern fn sfn_socket_close(fd: i32) -> i32;

fn _tlp_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

// The listening port — fixed, high, and distinct from the other native
// loopback tests (serve_loopback uses 18790) so the pool's `--jobs N` does
// not collide.
fn _tls_port() -> i64 { return 18795; }

fn _tls_port_str() -> string { return "18795"; }

// Connect a stream socket to `127.0.0.1:port`; returns the fd or -1. Tries
// both `sockaddr_in` byte layouts (Linux u16 sin_family at 0; macOS/BSD u8
// sin_len at 0 + u8 sin_family at 1), first success wins — the inlined
// `http.sfn::_connect_tcp` idiom. Used only to detect that `s_server` is
// accepting before the fixture runs.
fn _tlp_connect(port: i64) -> i32 ![net] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_tlp_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_tlp_ptr_off(addr, 0), 16, 1 as usize);
            memset(_tlp_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_tlp_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_tlp_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        memset(_tlp_ptr_off(addr, 4), 127, 1 as usize);
        memset(_tlp_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

// Full parent environment for the build + server + client subprocesses
// (`run_capture`/`spawn_with_env`'s empty env is EMPTY, not "inherit"):
// the nested build links a binary (clang + ld),
// and SAILFIN_TEST_SCRATCH (already present) keeps the build cache
// per-invocation under the parallel pool.
fn _child_env() -> string[] ![io] { return process.environ(); }

// The same environment in `sfn/os`'s typed form, for `start_background`.
fn _child_env_typed() -> Env ![io] { return env_from_current(); }

// The client run-env plus `SAILFIN_TLS_CAFILE` pointed at the generated
// self-signed cert so the client trusts it (verify stays on).
fn _client_env(cert_path: string) -> string[] ![io] {
    let mut e = process.environ();
    e.push("SAILFIN_TLS_CAFILE=" + cert_path);
    return e;
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/sfn-tls-https-e2e";
    fs.createDirectory(dir, true);
    return dir;
}

// Generate a self-signed cert+key (CN=localhost) for the TLS server. The
// `subjectAltName=DNS:localhost` SAN is required: the client now enforces
// RFC-6125 hostname verification (SSL_set1_host), and modern OpenSSL checks
// the SAN (not the CN) when a SAN is present. Returns true on success.
fn _gen_cert(dir: string) -> boolean ![io] {
    // Native TLS server signs CertificateVerify with Ed25519 only (RSA/ECDSA
    // signing is out of SFEP-0048 §6.3 scope), so `sfn_serve_tls` accepts an
    // Ed25519 certificate only (SFN-341).
    let exit = process.run_capture(["openssl", "req", "-x509", "-newkey", "ed25519", "-keyout", dir
        + "/key.pem", "-out", dir
        + "/cert.pem", "-days", "1", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost"], _child_env());
    report_child_failure_pending("runtime-tls-https-client cert-gen", exit);
    return exit == 0;
}

// The `openssl s_server -www` argv (an HTTP status-page server), for
// `start_background` to spawn directly — no external `timeout` wrapper
// needed, since the test owns the child's lifetime itself
// (`start_background`/`stop_background`).
fn _server_argv(dir: string) -> string[] {
    let mut argv: string[] = [];
    argv.push("openssl");
    argv.push("s_server");
    argv.push("-accept");
    argv.push(_tls_port_str());
    argv.push("-cert");
    argv.push(dir + "/cert.pem");
    argv.push("-key");
    argv.push(dir + "/key.pem");
    argv.push("-www");
    argv.push("-quiet");
    return argv;
}

// Poll a raw TCP connect until `s_server` is accepting. 30s wall-clock
// budget. Captures nothing — reaches the port through the file-local
// `_tls_port()` rather than closing over a parameter (SFN-843).
fn _await_listening() -> boolean ![clock, io, net] {
    let start_ms: int = monotonic_millis();
    let ok = wait_until(fn () -> boolean {
        let fd: i32 = _tlp_connect(_tls_port());
        if fd >= 0 {
            sfn_socket_close(fd);
            return true;
        }
        return false;
    }, 30000, 500);
    if !ok {
        let elapsed: int = monotonic_millis() - start_ms;
        print.info("[tls-https] probe: no listener on 127.0.0.1:"
            + _tls_port_str()
            + " after "
            + number_to_string(elapsed)
            + "ms");
    }
    return ok;
}

// Renders a downloaded body for a diagnostic print: length plus a bounded
// prefix.
fn _describe_body(body: string) -> string {
    return "length=" + number_to_string(body.length) + " prefix=\"" + substring(body, 0, 200)
        + "\"";
}

// Write a fixture capsule whose `main` downloads `https://localhost:PORT/`
// to `<argv[1]>/body.out`. `http.download` writes the file only on a
// successful round-trip, so its presence + content is the round-trip proof.
//
// The scratch dir travels through `argv[1]`, never spliced into this source
// text. `SAILFIN_TEST_SCRATCH`/`TEMP` is a native Windows backslash path,
// and a literal `+ dir +` here would silently corrupt it the same way SFN-1001
// already diagnosed and fixed in `runtime_tls_anchor_cache_test.sfn`:
// `decode_string_literal_escapes` (`compiler/capsules/syntax/src/parser/utils.sfn:84-113`)
// drops the backslash for any `\<char>` it does not recognize as an escape
// when the nested build re-lexes this generated file, turning
// `C:\Users\...` into `C:Users...` — a different, non-existent path that
// `http.download` would then write to, invisibly to the test's own
// (uncorrupted) `out_path` check. Also prints a startup marker and whether
// the download landed, so a corrupted path shows up in the client's own
// captured stdout instead of only as an empty body one layer up.
fn _write_client(dir: string) -> string ![io] {
    let root = dir + "/client";
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/tls-https-e2e-client\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"outbound https e2e client\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", "fn main(argv: string[]) -> int ![net, io] {\n"
        + "    let dir = argv[1];\n"
        + "    let out_path = dir + \"/body.out\";\n"
        + "    if !fs.exists(dir) {\n"
        + "        print.err(\"[tls-https-cli] scratch dir missing: \" + dir);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    print.info(\"[tls-https-cli] starting, target \" + out_path);\n"
        + "    let _ = http.download(\"https://localhost:"
        + _tls_port_str()
        + "/\", out_path);\n"
        + "    if fs.exists(out_path) {\n"
        + "        print.info(\"[tls-https-cli] wrote \" + out_path);\n"
        + "    } else {\n"
        + "        print.info(\"[tls-https-cli] no file at \" + out_path);\n"
        + "    }\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

fn _build_bin(main_path: string, bin: string) -> string ![io] {
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", bin, main_path], _child_env());
    report_child_failure_pending("runtime-tls-https-client build", exit);
    if exit != 0 { return ""; }
    return bin;
}

test "runtime tls: https GET round-trips against a local openssl s_server" ![clock, io, net] {
    // Need the openssl CLI (TLS peer + cert gen). Skip cleanly otherwise —
    // the plain suite still covers the surface via the unit skeleton test +
    // `make compile`.
    if !tool_present("openssl") {
        print.info("[tls-https] SKIP: openssl CLI not available");
        assert true;
        return;
    }

    let dir = _scratch_dir();
    let cert_ok = _gen_cert(dir);
    assert cert_ok;

    // Build the client fixture up front (cold build once).
    let out_path = dir + "/body.out";
    let _rm = fs.deleteFile(out_path);
    let main_path = _write_client(dir);
    let client_bin = _build_bin(main_path, dir + "/client-bin");
    assert client_bin.length > 0;

    // Managed explicitly (`start_background`/`stop_background`) rather than
    // through the scoped `with_background` fixture: `with_background`'s own
    // catch drains and DISCARDS the child's streams before rethrowing, so a
    // server that never becomes connectable always reported bare "assertion
    // failed" with no signal from `s_server` itself. Draining here on the
    // specific readiness-failure path keeps that signal.
    let server = start_background(_server_argv(dir), _child_env_typed(), "", "tls-https-server");
    assert server.handle.handle_id != 0;

    let up = _await_listening();
    if !up {
        let drain = stop_background(server);
        print.info("[tls-https] s_server never became connectable; exit="
            + number_to_string(drain.exit)
            + " stdout=\""
            + substring(drain.stdout, 0, 4096)
            + "\" stderr=\""
            + substring(drain.stderr, 0, 4096)
            + "\"");
    }
    assert up;

    try {
        // Run the client (with SAILFIN_TLS_CAFILE trusting the self-signed
        // cert), retrying briefly to absorb any residual startup latency. A
        // non-empty output file proves the https round-trip succeeded.
        let cenv = _client_env(dir + "/cert.pem");
        let mut body = "";
        let mut last_cexit: i64 = -1;
        let mut last_cout: string = "";
        let mut last_cerr: string = "";
        let mut attempt: i64 = 0;
        loop {
            if attempt >= 20 { break; }
            let _rm2 = fs.deleteFile(out_path);
            let cexit = process.run_capture([client_bin, dir], cenv);
            last_cexit = cexit;
            last_cout = process.capture_take_stdout();
            last_cerr = process.capture_take_stderr();
            report_child_failure("runtime-tls-https-client run attempt "
                + number_to_string(attempt), cexit, last_cout, last_cerr);
            if cexit == 0 {
                if fs.exists(out_path) {
                    let content = fs.readFile(out_path);
                    if content.length > 0 {
                        body = content;
                        break;
                    }
                }
            }
            sleep(500);
            attempt = attempt + 1;
        }

        if body.length == 0 {
            // Distinguishes "the client failed to run" (report_child_failure
            // above, per attempt, exit != 0) from "the client ran and wrote
            // nothing on every attempt" — both previously collapsed into the
            // identical bare "assertion failed" below.
            print.info("[tls-https] client never produced a body after "
                + number_to_string(attempt)
                + " attempts; last exit="
                + number_to_string(last_cexit)
                + " stdout=\""
                + substring(last_cout, 0, 2048)
                + "\" stderr=\""
                + substring(last_cerr, 0, 2048)
                + "\"");
        } else {
            print.info("[tls-https] round-trip body: " + _describe_body(body));
        }
        // Round-trip proof: a non-empty body came back over TLS. `s_server
        // -www` returns an HTML status page listing the negotiated ciphers.
        assert body.length > 0;
        assert contains(body, "Ciphers");
        let _ = stop_background(server);
    } catch (err) {
        // Reap first, then re-throw, so the failing test still fails with
        // its own message rather than a teardown error — mirrors
        // `with_background`'s own catch (SFN-402/SFEP-0050 §5.1).
        let _ = stop_background(server);
        throw err;
    }

    // Cleanup after the server was already killed and reaped
    // above.
    assert remove_all(dir + "/client");
    let _rmo = fs.deleteFile(out_path);
}
