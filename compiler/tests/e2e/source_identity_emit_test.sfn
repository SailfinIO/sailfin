// SFN-930: direct emit must resolve the same manifest-owned identity as build
// and relative traversal, without a `--module-name` override.
import { contains } from "sfn/strings";
import {
    clean_runner_env,
    nested_runner_scratch,
    report_child_failure_pending,
    sfn_bin_path
} from "sfn/test";

// Declared directly rather than resolved through the compiler under
// test, matching the SFN-635 no-cross-module-extern convention
// `compiler/src/build/fs.sfn:59` and `cli/entry.sfn` follow for the
// same symbol.
extern fn realpath(path: *u8, resolved: *u8) -> *u8;

// The child env is derived by subtraction from the real environment, not
// assembled key by key (SFN-1114).
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

// The current working directory, replacing a `pwd` shellout: on this
// host `pwd` resolves to the MSYS `pwd`, which prints an MSYS-style
// `/c/...` path a native Windows binary cannot open. Mirrors `_cwd_cmd`
// (`compiler/src/build/fs.sfn:217`, SFN-888) — no `host_is_windows()`
// gate is needed because `@realpath` is provided on a native Windows
// host by `runtime/sfn/platform/realpath_windows.sfn` over `_fullpath`.
fn _cwd() -> string ![io] {
    let resolved: *u8 = realpath("." as *u8, null);
    if resolved as i64 != 0 { return resolved as string; }
    // `PWD` is maintained by a shell, so it is absent when `sfn` is
    // spawned by a non-shell parent and absent on native Windows —
    // fallback only, matching `_cwd_cmd`.
    let pwd = env.get("PWD");
    if pwd.length > 0 { return pwd; }
    return ".";
}

fn _emit_native(source: string, output: string) -> string ![io] {
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", output, "native", source], _child_env());
    report_child_failure_pending("source-identity emit " + source, exit);
    if exit != 0 || !fs.exists(output) { return ""; }
    return fs.readFile(output);
}

test "direct emit: arbitrary library root uses manifest-prefixed identity" ![io] {
    let ws = fs.mkdtemp("sfn-identity-emit-lib-");
    fs.createDirectory(ws + "/private/parser/src", true);
    fs.writeFile(ws + "/workspace.toml", "[workspace]\nmembers = [\"private/parser\"]\n");
    fs.writeFile(ws + "/private/parser/capsule.toml", "[capsule]\nname = \"sfn/syntax\"\nversion = \"0.0.1\"\n\n[capabilities]\nrequired = []\n\n[build]\nkind = \"library\"\n");
    let source = ws + "/private/parser/src/ast.sfn";
    fs.writeFile(source, "struct Ast {}\n");
    let native = _emit_native(source, ws + "/ast.sfn-asm");
    assert contains(native, ".module sfn/syntax/ast");
}

test "direct emit: selected binary is relative to its source root" ![io] {
    let ws = fs.mkdtemp("sfn-identity-emit-bin-");
    fs.createDirectory(ws + "/driver/src/cli", true);
    fs.writeFile(ws + "/workspace.toml", "[workspace]\nmembers = [\"driver\"]\n");
    fs.writeFile(ws + "/driver/capsule.toml", "[capsule]\nname = \"sfn/compiler\"\nversion = \"0.0.1\"\n\n[capabilities]\nrequired = []\n\n[build]\nkind = \"binary\"\nentry = \"src/cli/main.sfn\"\n");
    let source = ws + "/driver/src/cli/main.sfn";
    fs.writeFile(source, "fn main() {}\n");
    let native = _emit_native(source, ws + "/main.sfn-asm");
    assert contains(native, ".module cli/main");
}

test "direct emit: unlisted nested binary outranks containing workspace library" ![io] {
    let ws = fs.mkdtemp("sfn-identity-emit-nested-bin-");
    fs.createDirectory(ws + "/outer/src/tool/src/cli", true);
    fs.writeFile(ws + "/workspace.toml", "[workspace]\nmembers = [\"outer\"]\n");
    fs.writeFile(ws + "/outer/capsule.toml", "[capsule]\nname = \"sfn/outer\"\nversion = \"0.0.1\"\n\n[build]\nkind = \"library\"\n");
    fs.writeFile(ws + "/outer/src/tool/capsule.toml", "[capsule]\nname = \"sfn/nested-tool\"\nversion = \"0.0.1\"\n\n[build]\nkind = \"binary\"\nentry = \"src/cli/main.sfn\"\n");
    let source = ws + "/outer/src/tool/src/cli/main.sfn";
    fs.writeFile(source, "fn main() {}\n");
    let native = _emit_native(source, ws + "/nested-main.sfn-asm");
    assert contains(native, ".module cli/main");
}

test "absolute standalone entry converges with relative imports" ![io] {
    let root = fs.mkdtemp("sfn-identity-standalone-absolute-");
    fs.writeFile(root + "/dep.sfn", "fn answer() -> int { return 42; }\n\nexport { answer };\n");
    let main_source = root + "/main.sfn";
    fs.writeFile(main_source, "import { answer } from \"./dep\";\n\nfn main() -> int { return answer() - 42; }\n");
    let exit = process.run_capture([sfn_bin_path(), "run", main_source], _child_env());
    report_child_failure_pending("source-identity run", exit);
    assert exit == 0;
}

test "direct emit: runtime prelude identity agrees for relative and absolute paths" ![io] {
    let root = fs.mkdtemp("sfn-identity-runtime-prelude-");
    let relative_native = _emit_native("runtime/prelude.sfn", root
        + "/relative.sfn-asm");
    let absolute_native = _emit_native(_cwd() + "/runtime/prelude.sfn", root
        + "/absolute.sfn-asm");
    assert contains(relative_native, ".module runtime/prelude");
    assert contains(absolute_native, ".module runtime/prelude");
}

test "direct emit: unlisted nested runtime prelude outranks containing library" ![io] {
    let ws = fs.mkdtemp("sfn-identity-nested-runtime-prelude-");
    fs.createDirectory(ws + "/outer/src/provider/sfn", true);
    fs.writeFile(ws + "/workspace.toml", "[workspace]\nmembers = [\"outer\"]\n");
    fs.writeFile(ws + "/outer/capsule.toml", "[capsule]\nname = \"sfn/outer\"\nversion = \"0.0.1\"\n\n[build]\nkind = \"library\"\n");
    fs.writeFile(ws + "/outer/src/provider/capsule.toml", "[capsule]\nname = \"sfn/nested-runtime\"\nversion = \"0.0.1\"\n\n[build]\nkind = \"runtime\"\nsfn-source-root = \"sfn\"\nsfn-module-prefix = \"runtime/sfn\"\nprelude-entry = \"prelude.sfn\"\nsfn-sources = []\n");
    let prelude = ws + "/outer/src/provider/prelude.sfn";
    fs.writeFile(prelude, "fn prelude_probe() {}\n");
    let native = _emit_native(prelude, ws + "/nested-prelude.sfn-asm");
    assert contains(native, ".module runtime/prelude");
}

test "relative traversal: absolute-path library test converges on provider identity" ![io] {
    let ws = fs.mkdtemp("sfn-identity-relative-");
    fs.createDirectory(ws + "/lib/src", true);
    fs.createDirectory(ws + "/lib/tests", true);
    fs.writeFile(ws + "/workspace.toml", "[workspace]\nmembers = [\"lib\"]\n");
    fs.writeFile(ws + "/lib/capsule.toml", "[capsule]\nname = \"sfn/example\"\nversion = \"0.0.1\"\n\n[capabilities]\nrequired = []\n\n[build]\nkind = \"library\"\n");
    fs.writeFile(ws + "/lib/src/mod.sfn", "fn answer() -> int { return 42; }\n");
    let test_source = ws + "/lib/tests/mod_test.sfn";
    fs.writeFile(test_source, "import { answer } from \"../src/mod\";\n\ntest \"provider identity\" { assert answer() == 42; }\n");
    // `nested_runner_scratch`, not `_child_env()`: `test_source` names a
    // single `.sfn` file, so this nested `sfn test` takes the
    // single-process compile path (`cli/commands/test/single_process_run.
    // sfn:73,77`), which writes a FIXED `<scratch>/test.ll` /
    // `<scratch>/test.exe` with no isolation of its own — unlike the
    // multi-file path, which mints its own `fs.mkdtemp` root regardless of
    // what it is handed. `_child_env()` passes the parent's own
    // `SAILFIN_TEST_SCRATCH` straight through, so without a dedicated
    // label this would share that fixed name with any other nested
    // single-file `sfn test` sharing the same pool worker, and Windows
    // (unlike POSIX) refuses to overwrite a `test.exe` still open
    // elsewhere (SFN-401 idiom; see `runner_slowest_summary_test.sfn`).
    let exit = process.run_capture([sfn_bin_path(), "test", test_source], clean_runner_env(nested_runner_scratch("mod-test")));
    report_child_failure_pending("source-identity test", exit);
    assert exit == 0;
}
