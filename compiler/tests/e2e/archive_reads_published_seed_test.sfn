// compiler/tests/e2e/archive_reads_published_seed_test.sfn
//
// Extract a REAL published seed tarball (a `sailfin_<version>_<os>_<arch>.tar.gz`
// release asset, ustar + GNU long-name/PAX shapes and all) with
// `targz_extract` and confirm the seed's two program entries both
// materialize — the acceptance evidence for SFEP-0071 §3.8's
// ustar-conformance claim on the exact asset shape `sfn toolchain install`
// consumes.
//
// This test deliberately does NOT assert a `sfn -> sailfin` symlink.
// Published seed tarballs carry no symlink member: `bin/sailfin` and
// `bin/sfn` are two regular files of identical size (verified against the
// 0.10.0 asset, both 4638280 bytes, and against the archived
// `sailfin-native-linux-x86_64-0.5.0-alpha.17` asset). The `sfn -> sailfin`
// symlink in an INSTALLED tree is created after extraction by the installer
// (`install.sh:440`, and `toolchain_install_to_base`), so asserting it here
// tests the wrong layer — it would make this test a proxy for the installer
// rather than for the extractor. §3.5's symlink policy is covered where a
// symlink member actually exists: `archive_extracts_symlink_member_test.sfn`
// builds that fixture explicitly.
//
// Gated on the asset already being present locally — this test NEVER
// downloads. Point `SAILFIN_SEED_TARBALL` at a cached
// `sailfin_*_<os>_<arch>.tar.gz` (e.g. the asset a prior `sfn toolchain
// install` or release-CI leg already fetched) to exercise it; unset or
// missing, the test skips rather than reaching for the network, matching
// the `tool_present` degrade pattern used across this suite.
import { ExtractOptions, targz_extract } from "sfn/archive";
import { default_scratch_dir } from "sfn/test";

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    return dir;
}

// Search `dir` (non-recursive) for an entry literally named `target`.
fn _dir_has_entry(dir: string, target: string) -> boolean ![io] {
    let entries = fs.listDirectory(dir);
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        if entries[i] == target { return true; }
        i += 1;
    }
    return false;
}

// A shallow (depth-2) search for a directory holding BOTH seed program
// entries — the seed layout puts them either at the extraction root or one
// `bin/`-shaped directory below it, and this test does not assume which.
fn _seed_layout_ok(root: string) -> boolean ![io] {
    if _dir_has_entry(root, "sailfin") && _dir_has_entry(root, "sfn") {
        return true;
    }
    let entries = fs.listDirectory(root);
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let child = root + "/" + entries[i];
        if fs.is_directory(child) {
            if _dir_has_entry(child, "sailfin") && _dir_has_entry(child, "sfn") {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

test "archive reads published seed: extracts the real tarball with both program entries intact" ![io] {
    let tarball = env.get("SAILFIN_SEED_TARBALL");
    if tarball.length == 0 {
        assert true;
        return;
    }
    if !fs.exists(tarball) {
        assert true;
        return;
    }

    let dest_dir = _scratch_dir() + "/archive-published-seed/dest";
    fs.createDirectory(dest_dir, true);
    let opts = ExtractOptions {
        copy_instead_of_link: false,
        apply_modes: true,
        max_total_bytes: 1073741824,
        max_members: 65536,
        host_is_windows: false
    };
    let result = targz_extract(tarball, dest_dir, opts);
    match result {
        Result.Ok { value }
        : {
            assert value.member_count > 0;
        },
        Result.Err { error }
        : {
            print("targz_extract failed: " + error.message);
            assert false;
        }
    }

    assert _seed_layout_ok(dest_dir);
}
