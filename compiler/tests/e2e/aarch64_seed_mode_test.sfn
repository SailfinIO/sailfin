// E2E coverage for the aarch64 release and seed gates (SFN-580, SFN-799):
// native-seed selection, required release payloads, and fail-closed cadence
// pinning of the published native+installer ARM64 pair.
//
// The script's `SAILFIN_SEED_ASSET_LIST` seam lets these cases run
// hermetically against a fixture file instead of probing the network.
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]` and so
// cannot be called from an `![io]` test like this. Assert on captured stdout
// with `sfn/strings::contains`/`trim` instead.
import { contains, find, trim } from "sfn/strings";
import { default_scratch_dir, with_tmp_dir } from "sfn/test";

// Marker files live under `SAILFIN_TEST_SCRATCH` (or `/tmp`), not inside the
// `with_tmp_dir` fixture's own directory, so they survive the fixture's
// scope-exit teardown and can be read back after the closure returns.
fn _scratch_marker(name: string) -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    let path = dir + "/arm-seed-" + name + ".out";
    if fs.exists(path) { fs.deleteFile(path); }
    return path;
}

fn _script() -> string ![io] {
    let configured = env.get("SAILFIN_SEED_MODE_SCRIPT");
    if configured.length > 0 { return configured; }
    return "scripts/select-aarch64-seed-mode.sh";
}

// Base child env: PATH is mandatory for `bash`/`grep`/`curl` to resolve
// (`run_capture`'s env array is the complete child environment, not an
// overlay). `seed_version` empty means "unset" (the script's own default).
fn _child_env(asset_list: string, seed_version: string) -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    if asset_list.length > 0 {
        e.push("SAILFIN_SEED_ASSET_LIST=" + asset_list);
    }
    if seed_version.length > 0 { e.push("SEED_VERSION=" + seed_version); }
    return e;
}

fn _write_asset_list(dir: string, assets: string[]) -> string ![io] {
    let path = dir + "/assets.txt";
    let mut body = "";
    for asset in assets { body = body + asset + "\n"; }
    fs.writeFile(path, body);
    return path;
}

fn _touch_assets(dir: string, assets: string[]) ![io] {
    for asset in assets { fs.writeFile(dir + "/" + asset, ""); }
}

fn _release_payload_gate() -> string ![io] {
    let configured = env.get("SAILFIN_RELEASE_PAYLOAD_GATE_SCRIPT");
    if configured.length > 0 { return configured; }
    return "scripts/verify-release-payloads.sh";
}

fn _seed_pin_asset_gate() -> string ![io] {
    let configured = env.get("SAILFIN_SEED_PIN_ASSET_GATE_SCRIPT");
    if configured.length > 0 { return configured; }
    return "scripts/verify-arm64-release-assets.sh";
}

fn _run_release_payload_gate(dir: string, version: string) -> int ![io] {
    let exit = process.run_capture(["bash", _release_payload_gate(), dir, version], _child_env("", ""));
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    return exit;
}

fn _run_seed_pin_asset_gate(asset_list: string, version: string) -> int ![io] {
    let exit = process.run_capture(["bash", _seed_pin_asset_gate(), version, asset_list], _child_env("", ""));
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    return exit;
}

// One script invocation, capturing stdout to `marker` (outside the fixture
// dir so it survives teardown) and returning the exit code.
fn _run_once(marker: string, asset_list: string, seed_version: string) -> int ![io] {
    let exit = process.run_capture(["bash", _script()], _child_env(asset_list, seed_version));
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    fs.writeFile(marker, out);
    return exit;
}

// Child env for the curl-branch probe: `SAILFIN_SEED_ASSET_LIST` is left
// unset so the script falls through to `_asset_present`, and
// `SAILFIN_SEED_PROBE_HTTP_CODE` short-circuits that function before curl
// ever runs, so this stays hermetic.
fn _child_env_probe(probe_code: string, seed_version: string) -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    e.push("SAILFIN_SEED_PROBE_HTTP_CODE=" + probe_code);
    if seed_version.length > 0 { e.push("SEED_VERSION=" + seed_version); }
    return e;
}

// One script invocation through the curl-branch probe seam, capturing
// stdout and stderr to markers outside the fixture dir so they survive
// teardown, and returning the exit code.
fn _run_once_probe(marker: string, err_marker: string, probe_code: string, seed_version: string) -> int ![io] {
    let exit = process.run_capture(["bash", _script()], _child_env_probe(probe_code, seed_version));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    fs.writeFile(marker, out);
    fs.writeFile(err_marker, err);
    return exit;
}

test "aarch64 seed mode: a pinned release with both arm64 assets selects native" ![io] {
    let marker = _scratch_marker("t1");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin-native-linux-x86_64-9.9.9.tar.gz", "sailfin-native-linux-arm64-9.9.9.tar.gz", "sailfin_9.9.9_linux_arm64.tar.gz", "sailfin_9.9.9_macos_arm64.tar.gz",]);
        return _run_once(marker, list, "9.9.9");
    });
    assert exit == 0;

    let out = fs.readFile(marker);
    fs.deleteFile(marker);
    assert trim(out) == "native";
}

test "aarch64 seed mode: a legacy pin without arm64 assets falls back to qemu" ![io] {
    let marker = _scratch_marker("t2");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin-native-linux-x86_64-9.9.9.tar.gz", "sailfin_9.9.9_linux_x86_64.tar.gz", "sailfin_9.9.9_macos_arm64.tar.gz",]);
        return _run_once(marker, list, "9.9.9");
    });
    assert exit == 0;

    let out = fs.readFile(marker);
    fs.deleteFile(marker);
    assert trim(out) == "qemu";
}

test "aarch64 seed mode: a partial arm64 asset set fails closed" ![io] {
    let exit = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin-native-linux-arm64-9.9.9.tar.gz",]);
        let rc = process.run_capture(["bash", _script()], _child_env(list, "9.9.9"));
        let _o = process.capture_take_stdout();
        let _e = process.capture_take_stderr();
        return rc;
    });
    assert exit != 0;
}

test "aarch64 seed mode: an unresolved seed version fails closed" ![io] {
    let exit_latest = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin-native-linux-arm64-9.9.9.tar.gz", "sailfin_9.9.9_linux_arm64.tar.gz",]);
        let rc = process.run_capture(["bash", _script()], _child_env(list, "latest"));
        let _o = process.capture_take_stdout();
        let _e = process.capture_take_stderr();
        return rc;
    });
    assert exit_latest != 0;

    let exit_empty = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin-native-linux-arm64-9.9.9.tar.gz", "sailfin_9.9.9_linux_arm64.tar.gz",]);
        let rc = process.run_capture(["bash", _script()], _child_env(list, ""));
        let _o = process.capture_take_stdout();
        let _e = process.capture_take_stderr();
        return rc;
    });
    assert exit_empty != 0;
}

test "aarch64 seed mode: release legs gate the emulated toolchain on the seed probe" ![io] {
    // `${{` is not written as a literal in a source string: the lexer reads
    // `${` as the start of a `${ expr }` interpolation. Build the needle by
    // concatenation instead.
    let mode_output_needle = "arm_seed_mode: " + "$"
        + "{{ steps.arm_seed.outputs.mode || 'qemu' }}";

    let tag_workflow = fs.readFile(".github/workflows/release-tag.yml");
    assert contains(tag_workflow, "steps.arm_seed.outputs.mode == 'qemu'");
    assert contains(tag_workflow, mode_output_needle);

    let branches_workflow = fs.readFile(".github/workflows/release-branches.yml");
    assert contains(branches_workflow, "steps.arm_seed.outputs.mode == 'qemu'");
    assert contains(branches_workflow, mode_output_needle);
}

test "aarch64 seed mode: the composite action gates both seed paths on the mode" ![io] {
    let action = fs.readFile(".github/actions/sailfin-build/action.yml");
    assert contains(action, "inputs.target != 'linux-arm64' || inputs.arm_seed_mode == 'native'");
    assert contains(action, "inputs.target == 'linux-arm64' && inputs.arm_seed_mode == 'qemu'");
    assert contains(action, "arm_seed_mode != 'native' && inputs.arm_seed_mode != 'qemu'");
}

test "aarch64 seed mode: release legs fall back when the probe is absent" ![io] {
    let tag_workflow = fs.readFile(".github/workflows/release-tag.yml");
    assert contains(tag_workflow, "absent from this checkout");
    assert contains(tag_workflow, "mode=qemu");

    let branches_workflow = fs.readFile(".github/workflows/release-branches.yml");
    assert contains(branches_workflow, "absent from this checkout");
    assert contains(branches_workflow, "mode=qemu");
}

test "aarch64 seed mode: a ranged-GET partial-content probe counts an asset as present" ![io] {
    let marker = _scratch_marker("t7");
    let err_marker = _scratch_marker("t7-err");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        return _run_once_probe(marker, err_marker, "206", "9.9.9");
    });
    assert exit == 0;

    let out = fs.readFile(marker);
    fs.deleteFile(marker);
    fs.deleteFile(err_marker);
    assert trim(out) == "native";
}

test "aarch64 seed mode: a full-content probe counts an asset as present" ![io] {
    let marker = _scratch_marker("t8");
    let err_marker = _scratch_marker("t8-err");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        return _run_once_probe(marker, err_marker, "200", "9.9.9");
    });
    assert exit == 0;

    let out = fs.readFile(marker);
    fs.deleteFile(marker);
    fs.deleteFile(err_marker);
    assert trim(out) == "native";
}

test "aarch64 seed mode: a not-found probe counts an asset as absent" ![io] {
    let marker = _scratch_marker("t9");
    let err_marker = _scratch_marker("t9-err");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        return _run_once_probe(marker, err_marker, "404", "9.9.9");
    });
    assert exit == 0;

    let out = fs.readFile(marker);
    fs.deleteFile(marker);
    fs.deleteFile(err_marker);
    assert trim(out) == "qemu";
}

test "aarch64 seed mode: an unresolvable probe status fails closed" ![io] {
    let marker = _scratch_marker("t10");
    let err_marker = _scratch_marker("t10-err");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        return _run_once_probe(marker, err_marker, "401", "9.9.9");
    });
    assert exit != 0;

    let err = fs.readFile(err_marker);
    fs.deleteFile(marker);
    fs.deleteFile(err_marker);
    assert contains(err, "refusing to guess");
}

test "aarch64 seed mode: the probe never asks for an asset with HEAD" ![io] {
    let script = fs.readFile(_script());
    assert ! contains(script, "--request HEAD");
    assert ! contains(script, "-X HEAD");
    assert ! contains(script, "--head ");
    assert contains(script, "--range 0-0");
}

test "aarch64 seed mode: the installer smoke probes never use HEAD" ![io] {
    let workflow = fs.readFile(".github/workflows/installer-smoke.yml");
    assert contains(workflow, "--range 0-0");
    assert contains(workflow, "Range = 'bytes=0-0'");
    assert ! contains(workflow, "-Method Head");
    assert ! contains(workflow, "--head ");
}

test "release payloads: v0.9.2 shape without ARM64 payloads fails closed" ![io] {
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _touch_assets(dir, ["sailfin-native-linux-x86_64-0.9.2.tar.gz", "sailfin_0.9.2_linux_x86_64.tar.gz", "sailfin-native-macos-arm64-0.9.2.tar.gz", "sailfin_0.9.2_macos_arm64.tar.gz", "sailfin_0.9.2_windows_x86_64.tar.gz",]);
        return _run_release_payload_gate(dir, "0.9.2");
    });
    assert exit != 0;
}

test "release payloads: a partial ARM64 payload pair fails closed" ![io] {
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _touch_assets(dir, ["sailfin-native-linux-x86_64-9.9.9.tar.gz", "sailfin_9.9.9_linux_x86_64.tar.gz", "sailfin-native-linux-arm64-9.9.9.tar.gz", "sailfin-native-macos-arm64-9.9.9.tar.gz", "sailfin_9.9.9_macos_arm64.tar.gz", "sailfin_9.9.9_windows_x86_64.tar.gz",]);
        return _run_release_payload_gate(dir, "9.9.9");
    });
    assert exit != 0;
}

test "release payloads: v0.9.3 complete ARM64 pair is publishable" ![io] {
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _touch_assets(dir, ["sailfin-native-linux-x86_64-0.9.3.tar.gz", "sailfin_0.9.3_linux_x86_64.tar.gz", "sailfin-native-linux-arm64-0.9.3.tar.gz", "sailfin_0.9.3_linux_arm64.tar.gz", "sailfin-native-macos-arm64-0.9.3.tar.gz", "sailfin_0.9.3_macos_arm64.tar.gz", "sailfin_0.9.3_windows_x86_64.tar.gz",]);
        return _run_release_payload_gate(dir, "0.9.3");
    });
    assert exit == 0;
}

test "seed pin assets: unrelated v0.9.2 assets cannot satisfy the ARM64 gate" ![io] {
    let exit = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin-native-linux-x86_64-0.9.2.tar.gz", "sailfin_0.9.2_linux_x86_64.tar.gz", "SHA256SUMS",]);
        return _run_seed_pin_asset_gate(list, "0.9.2");
    });
    assert exit != 0;
}

test "seed pin assets: a partial published ARM64 pair fails closed" ![io] {
    let exit = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin_9.9.9_linux_arm64.tar.gz",]);
        return _run_seed_pin_asset_gate(list, "9.9.9");
    });
    assert exit != 0;
}

test "seed pin assets: v0.9.3 complete ARM64 pair may advance" ![io] {
    let exit = with_tmp_dir(fn (dir: string) -> int {
        let list = _write_asset_list(dir, ["sailfin-native-linux-arm64-0.9.3.tar.gz", "sailfin_0.9.3_linux_arm64.tar.gz",]);
        return _run_seed_pin_asset_gate(list, "0.9.3");
    });
    assert exit == 0;
}

test "release workflows: ARM64 is required before publish and cadence pin" ![io] {
    let release_workflow = fs.readFile(".github/workflows/release.yml");
    assert ! contains(release_workflow, "gh release create");

    let tag_workflow = fs.readFile(".github/workflows/release-tag.yml");
    assert ! contains(tag_workflow, "continue-on-error:");
    assert contains(tag_workflow, ".release-gates/scripts/verify-release-payloads.sh");
    let gate_pos = find(tag_workflow, "bash .release-gates/scripts/verify-release-payloads.sh", 0);
    let atomic_publish_needle = "gh release create \"" + "$"
        + "{RELEASE_TAG}\" \""
        + "$"
        + "{files[@]}\"";
    let publish_pos = find(tag_workflow, atomic_publish_needle, 0);
    assert gate_pos >= 0;
    assert publish_pos > gate_pos;
    let repair_draft_pos = find(tag_workflow, "--draft=true", 0);
    let repair_upload_pos = find(tag_workflow, "gh release upload", 0);
    assert repair_draft_pos > gate_pos;
    assert repair_upload_pos > repair_draft_pos;

    let cadence_workflow = fs.readFile(".github/workflows/cadence-seed-pin.yml");
    assert contains(cadence_workflow, "--json assets,isDraft");
    assert contains(cadence_workflow, "is still a draft; refusing to pin an unpublished toolchain");
    assert contains(cadence_workflow, "scripts/verify-arm64-release-assets.sh");
    assert contains(cadence_workflow, "resuming smoke gate for existing PR");
    assert contains(cadence_workflow, "reusing validated remote branch");
    assert contains(cadence_workflow, "does not carry the expected");
    assert ! contains(cadence_workflow, "an open PR already exists for $branch; skipping");
    let arm_smoke_pos = find(cadence_workflow, "arm_smoke_name=\"install (ubuntu-24.04-arm)\"", 0);
    let auto_merge_pos = find(cadence_workflow, "gh pr merge \"$pr_url\" --auto --squash", 0);
    assert arm_smoke_pos >= 0;
    assert auto_merge_pos > arm_smoke_pos;
}

test "seed pin workflow: bootstrap changes run the native ARM installer self-host smoke" ![io] {
    let workflow = fs.readFile(".github/workflows/installer-smoke.yml");
    assert contains(workflow, "- \"bootstrap.toml\"");
    assert contains(workflow, "slug: linux_arm64");
    assert contains(workflow, "Verify pinned native ARM seed self-host");
    assert contains(workflow, "make fetch-seed");
    assert contains(workflow, "ELF 64-bit.*ARM aarch64");
    assert contains(workflow, "make compile");
}
