// End-to-end lockstep guard for SFN-546: `process.run` must leave the child
// attached to the parent's stdout/stderr on BOTH POSIX and Windows (the
// contract stated in the header of `runtime/sfn/platform/process_windows.sfn`).
// On POSIX this holds via `posix_spawnp` with `file_actions = null`
// (`runtime/sfn/process.sfn`); on Windows it holds via the inheritable
// std-handle duplication in `sfn_process_run`
// (`runtime/sfn/platform/process_windows.sfn`).
//
// `process.run` has no capture surface by design, so the only way to observe
// "the child's output reached the parent's stdout" is from OUTSIDE a parent
// process. This test therefore spawns a generated Sailfin program via a
// nested `sfn run` (whose stdout/stderr this test captures through pipes with
// `process.run_capture`); the generated program itself calls `process.run` on
// a command that prints a sentinel. The sentinel can only reach the captured
// buffers if the inner `process.run` passed the grandchild's output through
// to the nested `sfn run` process's own streams.
//
// The POSIX leg is genuine coverage on every Linux run; the Windows leg only
// executes on a Windows host, so this file does not go red-to-green on Linux.
// The third and fourth tests below are the Linux-runnable halves of the
// SFN-546 and SFN-572 guards respectively — the latter covering the same
// defect class on `sfn_process_run_capture`'s stdin handle.
//
// The property is proved TRANSITIVELY: `sfn run` itself passes its child's
// output through with `process.run` (`compiler/src/cli/commands/run.sfn`), so
// on Windows this exercises `sfn_process_run` at two levels and a failure
// does not localize to one of them on its own.
import { contains, find } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch, sfn_bin_path } from "sfn/test";

// Sentinels distinct enough not to collide with ordinary build chatter
// (diagnostics, clang/linker noise) that might also land on the nested
// process's stdout/stderr.
fn _stdout_sentinel() -> string { return "SFN546_STDOUT_PASSTHROUGH_9f2c"; }

fn _stderr_sentinel() -> string { return "SFN546_STDERR_PASSTHROUGH_9f2c"; }

// Source for the generated program: it picks a working echo-to-stdout and
// echo-to-stderr command per host (Windows has no `echo.exe` — `echo` is a
// `cmd` builtin, and stderr redirection syntax differs from POSIX `sh`) and
// calls `process.run` on each, uninterposed (no capture args). If `run`
// leaves the grandchild attached to this generated program's own inherited
// stdout/stderr, the sentinels flow straight through to whatever the
// generated program itself is attached to — the nested `sfn run` process,
// whose stdout/stderr THIS test captures.
fn _generated_program_src() -> string {
    return "import { find } from \"sfn/strings\";\n\n"
        + "fn _is_windows() -> bool ![io] {\n"
        + "    let os = env.get(\"OS\");\n"
        + "    if find(os, \"Windows\", 0) >= 0 { return true; }\n"
        + "    if env.get(\"SYSTEMROOT\").length > 0 { return true; }\n"
        + "    if env.get(\"windir\").length > 0 { return true; }\n"
        + "    return false;\n"
        + "}\n\n"
        + "fn main() ![io] {\n"
        + "    if _is_windows() {\n"
        + "        process.run([\"cmd\", \"/c\", \"echo "
        + _stdout_sentinel()
        + "\"]);\n"
        + "        process.run([\"cmd\", \"/c\", \"echo "
        + _stderr_sentinel()
        + " 1>&2\"]);\n"
        + "    } else {\n"
        + "        process.run([\"echo\", \""
        + _stdout_sentinel()
        + "\"]);\n"
        + "        process.run([\"sh\", \"-c\", \"echo "
        + _stderr_sentinel()
        + " 1>&2\"]);\n"
        + "    }\n"
        + "}\n";
}

test "process.run: passes a nested child's stdout/stderr through to the caller (POSIX/Windows lockstep, SFN-546)" ![io] {
    let scratch = nested_runner_scratch("sfn546_run_stdio");
    fs.createDirectory(scratch, true);
    let src = scratch + "/passthrough_fixture.sfn";
    fs.writeFile(src, _generated_program_src());

    let exit = process.run_capture([sfn_bin_path(), "run", src], clean_runner_env(scratch));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();

    assert exit == 0;
    // The nested `sfn run` process's own captured stdout/stderr must contain
    // the sentinels the generated program's grandchild wrote — proof that
    // `process.run` did not swallow or capture the grandchild's output, but
    // left it attached to the nested process's inherited streams.
    assert find(out, _stdout_sentinel(), 0) >= 0;
    assert find(err, _stderr_sentinel(), 0) >= 0;
}

// ── Acceptance 3: run_capture still CAPTURES rather than passing through ──
// The two spawn paths must not be conflated: unlike `process.run` above,
// `process.run_capture` redirects the child's stdout through a pipe this
// test drains explicitly, so the sentinel shows up in
// `process.capture_take_stdout()` rather than leaking onto this test's own
// stdout.
test "process.run_capture: still captures rather than passing through (SFN-546)" ![io] {
    // `[]` is a deliberate EMPTY child environment, not "inherit" — `echo`
    // needs none, and `posix_spawnp` resolves a bare name from the caller's
    // `PATH` rather than from `envp`.
    let exit = process.run_capture(["echo", "SFN546_CAPTURE_SENTINEL_7ab1"], []);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();

    assert exit == 0;
    assert find(out, "SFN546_CAPTURE_SENTINEL_7ab1", 0) >= 0;
}

// ── The Linux-runnable half of the SFN-546 guard ──────────────────────
// `runtime/sfn/platform/process_windows.sfn` is selected only by the runtime
// manifest's Windows target table, so nothing on a Linux run compiles it and the
// two tests above exercise only their POSIX leg here. Without a static check,
// the Windows fix could be reverted and every Linux check would stay green.
//
// Same source-consistency form as `cross_windows_runtime_modules_test.sfn`:
// whole-file `contains` against tokens unique to `sfn_process_run`, with no
// string slicing or in-loop array growth (both miscompile from an `![io]`
// test in this repo — see that file's IMPLEMENTATION NOTE, #842).
test "process.run: the Windows spawn keeps its inheritable-stdio wiring (SFN-546)" ![io] {
    let src = fs.readFile("runtime/sfn/platform/process_windows.sfn");

    // `bInheritHandles` is a computed flag, not the literal `0` that
    // discarded the child's output. This exact argument list occurs only in
    // `sfn_process_run` — `run_capture` and `_pw_spawn_impl` pass a literal
    // `1` and an `env_block`.
    assert contains(src, "CreateProcessA(null, cmdline, null, null, inherit,");

    // The parent's stdout/stderr are the handles being passed down.
    // `GetStdHandle(-11)` / `(-12)` (STD_OUTPUT_HANDLE / STD_ERROR_HANDLE)
    // appear nowhere else in the module.
    assert contains(src, "GetStdHandle(-11)");
    assert contains(src, "GetStdHandle(-12)");

    // They are handed down as inheritable duplicates, and released after the
    // spawn rather than leaked.
    assert contains(src, "fn _pw_dup_inheritable(");
    assert contains(src, "fn _pw_close_dup(");
    assert contains(src, "_pw_close_dup(h_out)");

    // STARTF_USESTDHANDLES (0x100) must be set, or the named handles are
    // ignored and the wiring above is dead code.
    assert contains(src, "flags_view.v = 256");
}

// The same Linux-runnable static form, for the sibling defect on the CAPTURE
// path (SFN-572). `sfn_process_run_capture` also sets STARTF_USESTDHANDLES and
// spawns with `bInheritHandles = 1`, so its `hStdInput` is under the same
// inheritability precondition as the passthrough path above — but it once
// stored a raw `GetStdHandle(-10)` there, which may be non-inheritable and may
// be a `0`/`-1` sentinel. Nothing on a Linux run compiles the module, so this
// is the only thing standing between that line and a silent return.
test "process.run_capture: the Windows spawn duplicates stdin inheritable (SFN-572)" ![io] {
    let src = fs.readFile("runtime/sfn/platform/process_windows.sfn");

    // The capture path's stdin is an inheritable duplicate, not a raw handle.
    // `sfn_process_run` passes its own `self_proc` local rather than calling
    // `GetCurrentProcess()` inline, so this exact expression occurs only in
    // `sfn_process_run_capture` — asserting it pins the fix to that function
    // without slicing the source.
    assert contains(src, "let h_stdin: i64 = _pw_dup_inheritable(GetCurrentProcess(), GetStdHandle(-10));");

    // ...and the duplicate is released after the spawn rather than leaked.
    // `h_stdin` is the capture path's name for it; the passthrough path's
    // three duplicates are `h_in`/`h_out`/`h_err`.
    assert contains(src, "_pw_close_dup(h_stdin)");

    // The release must also sit BEFORE the `ok == 0` bail, or it runs only
    // on the spawn-failure path and leaks the duplicate on every successful
    // spawn — which is the regression the presence check above would still
    // pass. Pinning the two adjacent lines is what makes this a guard for
    // *placement* rather than existence; the passthrough path's analogue is
    // `_pw_close_dup(h_err);` before its own `if ok == 0 {`.
    assert contains(src, "_pw_close_dup(h_stdin);\n    // Close the inheritable write ends before releasing the process-wide\n    // spawn lock.");
}

test "Windows inheritable-handle setup is serialized and fails closed" ![io] {
    let src = fs.readFile("runtime/sfn/platform/process_windows.sfn");

    assert contains(src, "fn _pw_lock_inheritable_spawn()");
    assert contains(src, "fn _pw_unlock_inheritable_spawn()");
    assert contains(src, "_pw_lock_inheritable_spawn();\n    let self_proc:");
    assert contains(src, "memset(hbuf, 0, 32 as usize);\n    let hbase: i64 = hbuf as i64;\n    _pw_lock_inheritable_spawn();");
    assert contains(src, "memset(hbuf, 0, 48 as usize);\n    let hbase: i64 = hbuf as i64;\n\n    _pw_lock_inheritable_spawn();");
    assert contains(src, "_pw_close_dup(h_err);\n    _pw_unlock_inheritable_spawn();");
    assert contains(src, "let _cw2: i32 = CloseHandle(err_wr);\n    _pw_unlock_inheritable_spawn();");
    assert contains(src, "let _cc3: i32 = CloseHandle(err_wr);\n    _pw_unlock_inheritable_spawn();");

    // Parent-only ends must not remain inheritable. A failed clear is a hard
    // spawn-setup error, since proceeding would keep pipe EOF from arriving.
    assert contains(src, "if s1 == 0 || s2 == 0 {");
    assert contains(src, "if s1 == 0 || s2 == 0 || s3 == 0 {");
}
