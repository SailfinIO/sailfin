// compiler/tests/e2e/import_shadows_local_fn_test.sfn
//
// Regression for SFN-530: an imported local name that collides with a
// function defined in the importing module must fail lowering. Before the
// fatal gate, mangling dropped the import rewrite and call sites silently
// bound to the local function, producing a successful binary with wrong
// behavior.
//
// Build isolation mirrors backend_failure_gate_test.sfn: the child `sfn build`
// inherits the full environment (PATH for clang/linker,
// SAILFIN_TEST_SCRATCH for per-invocation build-cache isolation). Captured
// output is stashed outside the temporary capsule so it survives teardown.
import { expect_contains_str, expect_eq_bool, with_tmp_dir } from "sfn/test";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

fn _child_env() -> string[] ![io] { return process.environ(); }

fn _marker() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = "/tmp"; }
    fs.createDirectory(dir, true);
    let path = dir + "/sfn530-import-shadow.out";
    if fs.exists(path) { fs.deleteFile(path); }
    return path;
}

fn _build_shadowing_capsule(out_marker: string) -> int ![io] {
    return with_tmp_dir(fn (dir: string) -> int {
        fs.createDirectory(dir + "/src", true);
        fs.writeFile(dir + "/capsule.toml", "[capsule]\n"
            + "name = \"sfn530-import-shadow\"\n"
            + "version = \"0.1.0\"\n"
            + "description = \"SFN-530 import shadowing regression\"\n\n"
            + "[build]\n"
            + "kind = \"binary\"\n"
            + "entry = \"src/main.sfn\"\n");
        fs.writeFile(dir + "/src/lib.sfn", "export fn helper() -> i32 { return 111; }\n");
        fs.writeFile(dir + "/src/main.sfn", "import { helper } from \"./lib\";\n"
            + "fn helper() -> i32 { return 222; }\n"
            + "fn main() -> i32 { return helper(); }\n");

        let build_exit = process.run_capture([_sfn_bin(), "build", "-p", dir], _child_env(),);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        fs.writeFile(out_marker, out + err);
        return build_exit;
    });
}

test "import shadowing a local function fails lowering (SFN-530)" ![io] {
    let marker = _marker();
    let exit = _build_shadowing_capsule(marker);
    let output = fs.readFile(marker);
    if fs.exists(marker) { fs.deleteFile(marker); }

    assert expect_eq_bool(exit != 0, true).ok;
    assert expect_contains_str(output, "llvm lowering [fatal] [E1001]").ok;
    assert expect_contains_str(output, "import `helper` shadows local function").ok;
    assert expect_contains_str(output, "in module `").ok;
}
