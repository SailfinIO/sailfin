// End-to-end tests for the SFEP-0051 Phase 4c workspace capability-envelope
// enforcement gate and the `sfn capabilities audit` reporting command.
//
// Each test builds a throwaway fixture workspace under a fresh `with_tmp_dir`
// (the repo tree is untouched) with two members: `clean` (declares only `io`,
// within the `allow = ["clock", "io"]` envelope) and `drifter` (declares
// `["io", "net"]`, so `net` drifts). The gate is exercised through three
// surfaces:
//
//   * `sfn check <path>` and `sfn build <file>` take a path, so the workspace
//     root is discovered from it — no `cd` needed, and the enforce-mode gate
//     fails before any emit/link so an empty child env (no PATH/clang) suffices.
//   * `sfn capabilities audit` discovers the workspace from the current
//     directory, so it runs via `run_capture_cwd` with the workspace root as
//     the child cwd and an absolute compiler path.
//
// `mode = "warn"` turns the same drift into a report that does not fail.
import { find } from "sfn/strings";
import {
    clean_runner_env,
    clean_runner_env_without,
    default_scratch_dir,
    report_child_failure,
    report_child_failure_pending,
    sfn_bin_abs_path,
    sfn_bin_path,
    with_tmp_dir
} from "sfn/test";

import { _copy_file_preserving_mode, _cwd_cmd } from "../../src/build/fs";

// The child env is derived by subtraction from the real environment, not
// assembled key by key (SFN-1114). No nested scratch: the audit does not
// compile, so no build-cache routing is needed.
fn _child_env() -> string[] ![io] { return clean_runner_env(""); }

// Build a two-member fixture workspace under `root`. `clean` stays within the
// `allow = ["clock", "io"]` envelope; `drifter` declares `net`, which drifts.
// When `warn` is true the envelope carries `mode = "warn"`.
fn _make_ws(root: string, warn: boolean) -> void ![io] {
    fs.createDirectory(root + "/clean", true);
    fs.createDirectory(root + "/drifter", true);
    let mut ws = "[workspace]\nmembers = [\"clean\", \"drifter\"]\n\n[workspace.capabilities]\nallow = [\"clock\", \"io\"]\n";
    if warn { ws = ws + "mode = \"warn\"\n"; }
    fs.writeFile(root + "/workspace.toml", ws);
    fs.writeFile(root + "/clean/capsule.toml", "[capsule]\nname = \"fixture/clean\"\nversion = \"0.1.0\"\n\n[capabilities]\nrequired = [\"io\"]\n");
    fs.writeFile(root + "/clean/main.sfn", "fn main() -> int {\n    return 0;\n}\n");
    fs.writeFile(root + "/drifter/capsule.toml", "[capsule]\nname = \"fixture/drifter\"\nversion = \"0.1.0\"\n\n[capabilities]\nrequired = [\"io\", \"net\"]\n");
    fs.writeFile(root + "/drifter/main.sfn", "fn main() -> int {\n    return 0;\n}\n");
}

// ---- Test 1: drift fails `sfn check` in enforce mode ----
test "capability gate: declared-surface drift fails sfn check (enforce)" ![io] {
    let out_marker = _scratch_marker("t1");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _make_ws(dir, false);
        let rc = process.run_capture([sfn_bin_path(), "check", dir], []);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        fs.writeFile(out_marker, out + err);
        return rc;
    });
    assert exit != 0;
    let msg = fs.readFile(out_marker);
    fs.deleteFile(out_marker);
    assert find(msg, "E0405", 0) >= 0;
    assert find(msg, "net", 0) >= 0;
}

// ---- Test 2: drift fails `sfn build` in enforce mode (before any link) ----
test "capability gate: declared-surface drift fails sfn build (enforce)" ![io] {
    let out_marker = _scratch_marker("t2");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _make_ws(dir, false);
        let rc = process.run_capture([sfn_bin_path(), "build", dir
            + "/drifter/main.sfn"], []);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        fs.writeFile(out_marker, out + err);
        return rc;
    });
    assert exit != 0;
    let msg = fs.readFile(out_marker);
    fs.deleteFile(out_marker);
    assert find(msg, "E0405", 0) >= 0;
}

// ---- Test 3: `sfn capabilities audit` prints the table + exits non-zero ----
test "capabilities audit: prints table and exits non-zero on drift (enforce)" ![io] {
    let out_marker = _scratch_marker("t3-out");
    let err_marker = _scratch_marker("t3-err");
    let sfn_abs = sfn_bin_abs_path();
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _make_ws(dir, false);
        let rc = process.run_capture_cwd([sfn_abs, "capabilities", "audit"], _child_env(), dir);
        fs.writeFile(out_marker, process.capture_take_stdout());
        fs.writeFile(err_marker, process.capture_take_stderr());
        return rc;
    });
    assert exit != 0;
    let out = fs.readFile(out_marker);
    let err = fs.readFile(err_marker);
    fs.deleteFile(out_marker);
    fs.deleteFile(err_marker);
    // Table header + the drifting member/effect on stdout.
    assert find(out, "MEMBER", 0) >= 0;
    assert find(out, "EFFECTIVE", 0) >= 0;
    assert find(out, "DRIFT", 0) >= 0;
    assert find(out, "fixture/drifter", 0) >= 0;
    assert find(out, "mode: enforce", 0) >= 0;
    // Coded diagnostic on stderr.
    assert find(err, "E0405", 0) >= 0;
}

// ---- Test 4: `mode = "warn"` reports drift but sfn check still passes ----
test "capability gate: mode = warn reports drift without failing sfn check" ![io] {
    let err_marker = _scratch_marker("t4");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _make_ws(dir, true);
        let rc = process.run_capture([sfn_bin_path(), "check", dir], []);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        report_child_failure("workspace-capability-gate warn check", rc, out, err);
        fs.writeFile(err_marker, err);
        return rc;
    });
    assert exit == 0;
    let err = fs.readFile(err_marker);
    fs.deleteFile(err_marker);
    // The drift is still reported (E0405) with the not-enforced note.
    assert find(err, "E0405", 0) >= 0;
    assert find(err, "not enforced", 0) >= 0;
}

// ---- Test 5: `sfn capabilities audit` under warn exits 0 ----
test "capabilities audit: mode = warn reports drift and exits zero" ![io] {
    let out_marker = _scratch_marker("t5");
    let sfn_abs = sfn_bin_abs_path();
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _make_ws(dir, true);
        let rc = process.run_capture_cwd([sfn_abs, "capabilities", "audit"], _child_env(), dir);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        report_child_failure("workspace-capability-gate warn audit", rc, out, err);
        fs.writeFile(out_marker, out);
        return rc;
    });
    assert exit == 0;
    let out = fs.readFile(out_marker);
    fs.deleteFile(out_marker);
    assert find(out, "mode: warn", 0) >= 0;
    assert find(out, "not enforced", 0) >= 0;
}

// ---- Test 6: no declared envelope ⇒ the gate is a no-op (opt-in) ----
// Regression guard: the envelope is opt-in. A workspace with no
// `[workspace.capabilities]` block must NOT flag its members' declared effects
// as drift against an empty envelope — otherwise every effect-declaring
// workspace (including this repo) would fail `sfn check`/`build` outright.
test "capability gate: no [workspace.capabilities] is a no-op" ![io] {
    let check_marker = _scratch_marker("t6-check");
    let audit_code_marker = _scratch_marker("t6-audit-code");
    let audit_out_marker = _scratch_marker("t6-audit-out");
    let sfn_abs = sfn_bin_abs_path();
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _make_ws_bare(dir);
        let check_rc = process.run_capture([sfn_bin_path(), "check", dir], []);
        report_child_failure_pending("workspace-capability-gate bare check", check_rc);
        fs.writeFile(check_marker, _rc_marker(check_rc));
        let audit_rc = process.run_capture_cwd([sfn_abs, "capabilities", "audit"], _child_env(), dir);
        let audit_out = process.capture_take_stdout();
        let audit_err = process.capture_take_stderr();
        report_child_failure("workspace-capability-gate bare audit", audit_rc, audit_out, audit_err);
        fs.writeFile(audit_out_marker, audit_out);
        fs.writeFile(audit_code_marker, _rc_marker(audit_rc));
        return 0;
    });
    assert exit == 0;
    let check_rc = fs.readFile(check_marker);
    let audit_rc = fs.readFile(audit_code_marker);
    let audit_out = fs.readFile(audit_out_marker);
    fs.deleteFile(check_marker);
    fs.deleteFile(audit_code_marker);
    fs.deleteFile(audit_out_marker);
    // check succeeds (drifter's declared `net` is not flagged as drift) and the
    // audit exits 0, reporting there is nothing to audit.
    assert check_rc == "pass";
    assert audit_rc == "pass";
    assert find(audit_out, "nothing to audit", 0) >= 0;
}

// ---- Test 7: Phase 4b — inferred-surface drift caught where declared passes ----
// SFN-418: `underdeclared` declares only `["io"]` in its capsule.toml — within
// the `allow = ["clock", "io"]` envelope, so Phase 4a's declared-surface audit
// is clean — but a public function in its `src/` uses `![net]`. Phase 4b unions
// the inferred surface into the member's required set, so `net` now drifts and
// `sfn check` fails with E0405: the exact case declared-only (4a) misses.
test "capability gate: inferred-surface drift fails sfn check where declared passes (4b)" ![io] {
    let out_marker = _scratch_marker("t7");
    let exit = with_tmp_dir(fn (dir: string) -> int {
        _make_ws_inferred(dir);
        let rc = process.run_capture([sfn_bin_path(), "check", dir], []);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        fs.writeFile(out_marker, out + err);
        return rc;
    });
    assert exit != 0;
    let msg = fs.readFile(out_marker);
    fs.deleteFile(out_marker);
    assert find(msg, "E0405", 0) >= 0;
    assert find(msg, "net", 0) >= 0;
}

// Build a one-member fixture whose declared surface is clean but whose source
// under-declares: `underdeclared` lists only `["io"]` in `[capabilities]`
// (within `allow = ["clock", "io"]`), yet a public function in its `src/` uses
// `![net]`. Phase 4a passes on the declared surface; Phase 4b (SFN-418) catches
// the `net` drift from the inferred surface.
fn _make_ws_inferred(root: string) -> void ![io] {
    fs.createDirectory(root + "/underdeclared/src", true);
    fs.writeFile(root + "/workspace.toml", "[workspace]\nmembers = [\"underdeclared\"]\n\n[workspace.capabilities]\nallow = [\"clock\", \"io\"]\n");
    fs.writeFile(root + "/underdeclared/capsule.toml", "[capsule]\nname = \"fixture/underdeclared\"\nversion = \"0.1.0\"\n\n[capabilities]\nrequired = [\"io\"]\n");
    fs.writeFile(root + "/underdeclared/src/net_use.sfn", "fn reach_out() -> int ![net] {\n    let _status = http.get(\"http://example.com\");\n    return 0;\n}\n\nexport { reach_out };\n");
}

// Build a two-member fixture with members that declare effects but NO
// `[workspace.capabilities]` envelope — the opt-out (unconfigured) shape.
fn _make_ws_bare(root: string) -> void ![io] {
    fs.createDirectory(root + "/clean", true);
    fs.createDirectory(root + "/drifter", true);
    fs.writeFile(root + "/workspace.toml", "[workspace]\nmembers = [\"clean\", \"drifter\"]\n");
    fs.writeFile(root + "/clean/capsule.toml", "[capsule]\nname = \"fixture/clean\"\nversion = \"0.1.0\"\n\n[capabilities]\nrequired = [\"io\"]\n");
    fs.writeFile(root + "/clean/main.sfn", "fn main() -> int {\n    return 0;\n}\n");
    fs.writeFile(root + "/drifter/capsule.toml", "[capsule]\nname = \"fixture/drifter\"\nversion = \"0.1.0\"\n\n[capabilities]\nrequired = [\"io\", \"net\"]\n");
    fs.writeFile(root + "/drifter/main.sfn", "fn main() -> int {\n    return 0;\n}\n");
}

// "pass" for exit 0, else "fail" — lets a test assert on a captured exit code
// through a marker file without an int-to-string dependency.
fn _rc_marker(rc: int) -> string {
    if rc == 0 { return "pass"; }
    return "fail";
}

// A fresh marker-file path under the runner scratch dir (or `/tmp`), with any
// stale value removed. Lives outside the `with_tmp_dir` tree so it survives
// teardown (the `sfn/test` idiom for asserting on closure-captured output).
fn _scratch_marker(name: string) -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    let path = dir + "/sfn-capgate-" + name + ".out";
    if fs.exists(path) { fs.deleteFile(path); }
    return path;
}

fn _make_implicit_override_ws(root: string, grant_net: boolean, deny_net: boolean) -> string ![io] {
    fs.createDirectory(root + "/app/src", true);
    fs.createDirectory(root + "/provider/src", true);
    let mut envelope = "[workspace.capabilities]\nallow = [\"io\"]\n";
    if deny_net { envelope = envelope + "deny = [\"net\"]\n"; }
    if grant_net {
        envelope = envelope + "\n[workspace.capabilities.grants]\n"
            + "\"demo/implicit\" = [\"net\"]\n";
    }
    fs.writeFile(root + "/workspace.toml", "[workspace]\n"
        + "members = [\"app\", \"provider\"]\n\n"
        + envelope);
    fs.writeFile(root + "/app/capsule.toml", "[capsule]\n"
        + "name = \"demo/app\"\n"
        + "version = \"0.1.0\"\n\n"
        + "[capabilities]\nrequired = []\n\n"
        + "[build]\nkind = \"binary\"\nentry = \"src/main.sfn\"\n");
    fs.writeFile(root + "/app/src/main.sfn", "fn main() -> int { return 0; }\n");
    fs.writeFile(root + "/provider/capsule.toml", "[capsule]\n"
        + "name = \"demo/implicit\"\n"
        + "version = \"0.1.0\"\n\n"
        + "[capabilities]\nrequired = [\"net\"]\n\n"
        + "[build]\nkind = \"library\"\nentry = \"src/mod.sfn\"\nimplicit = false\n");
    fs.writeFile(root + "/provider/src/mod.sfn", "fn latent_net() -> int ![net] { return 7; }\n");
    return root + "/app/src/main.sfn";
}

fn _make_implicit_override_toolchain(root: string) -> string ![io] {
    let toolchain = root + "/toolchain";
    fs.createDirectory(toolchain + "/bin", true);
    fs.createDirectory(toolchain + "/provider/src", true);
    fs.writeFile(toolchain + "/workspace.toml", "[workspace]\nmembers = [\"provider\"]\n");
    // The bundled slot is intentionally under-declared. A passing grant test
    // therefore proves that the same-name source member replaced this provider
    // before provider-local validation, rather than merely auditing an
    // unrelated ordinary workspace member.
    fs.writeFile(toolchain + "/provider/capsule.toml", "[capsule]\n"
        + "name = \"demo/implicit\"\nversion = \"0.1.0\"\n\n"
        + "[capabilities]\nrequired = [\"io\"]\n\n"
        + "[build]\nkind = \"library\"\nentry = \"src/mod.sfn\"\nimplicit = true\n");
    fs.writeFile(toolchain + "/provider/src/mod.sfn", "fn latent_net() -> int ![net] { return 9; }\n");
    let compiler = toolchain + "/bin/sfn";
    if !_copy_file_preserving_mode(sfn_bin_abs_path(), compiler) { return ""; }
    if !fs.set_perms(compiler, 493) { return ""; }
    return compiler;
}

// `_make_implicit_override_toolchain` copies the compiler binary alone
// (`_copy_file_preserving_mode`, no adjacent `runtime/`), so
// `resolve_runtime_root`'s exe-relative walk
// (`runtime/sfn/platform/exec.sfn`) cannot find it there; this override
// points the copy back at the repo's own runtime bundle. SAILFIN_RUNTIME_ROOT
// is named in the strip list so an inherited outer value cannot shadow the
// push below.
//
// `_cwd_cmd()` (`realpath(".", null)`) rather than a `pwd` shellout: a
// Git-Bash `pwd` prints the POSIX-mount spelling (`/c/Users/...`) on a
// native Windows host, which `resolve_runtime_root` returns verbatim and the
// runtime-manifest lookup then cannot resolve as a real Win32 path — the
// override was silently pointing nowhere, surfacing as "runtime
// bundle/manifest missing".
fn _implicit_override_env() -> string[] ![io] {
    let mut child = clean_runner_env_without("", ["SAILFIN_RUNTIME_ROOT"]);
    child.push("SAILFIN_RUNTIME_ROOT=" + _cwd_cmd() + "/runtime");
    return child;
}

test "capability gate: explicit implicit-provider override obeys workspace grant" ![io] {
    let result = with_tmp_dir(fn (root: string) -> int {
        let compiler = _make_implicit_override_toolchain(root);
        if compiler.length == 0 { return 97; }
        let entry = _make_implicit_override_ws(root + "/consumer", true, false);
        let exit = process.run_capture([compiler, "run", entry], _implicit_override_env());
        report_child_failure_pending("workspace-capability-gate override-grant run", exit);
        return exit;
    });
    assert result == 0;
}

test "capability gate: explicit implicit-provider override deny wins over grant" ![io] {
    let marker = _scratch_marker("implicit-override-deny");
    let result = with_tmp_dir(fn (root: string) -> int {
        let compiler = _make_implicit_override_toolchain(root);
        if compiler.length == 0 { return 97; }
        let entry = _make_implicit_override_ws(root + "/consumer", true, true);
        let exit = process.run_capture([compiler, "run", entry], _implicit_override_env());
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        fs.writeFile(marker, out + err);
        return exit;
    });
    assert result != 0;
    let message = fs.readFile(marker);
    fs.deleteFile(marker);
    assert find(message, "E0405", 0) >= 0;
    assert find(message, "demo/implicit", 0) >= 0;
    assert find(message, "net", 0) >= 0;
}
