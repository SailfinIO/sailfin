// End-to-end test for runtime/sfn/memory/secretbuf.sfn — the dormant,
// internal `SecretBuf` libc-backed secret-buffer runtime (SFN-783,
// design SFEP-0069 §§3.2 and 3.5). Modeled on
// `compiler/tests/e2e/owned_buf_roundtrip_test.sfn`.
//
// Phases:
//   1. typecheck — sfn check reports ok.
//   2. fmt       — sfn fmt --check is canonical.
//   3. emit shape — IR contains the pinned aggregates, the seven
//                   public defines, and the extern declares.
//   4. wipe-before-free ordering — the growth path in
//                   `secret_buf_append` and the drain path in
//                   `secret_buf_zeroize` call `_secret_buf_wipe`
//                   strictly before `free` in the emitted IR
//                   (SFEP-0069 §3.5 step order).
//   5. C harness — exercises the runtime end-to-end, including the
//                  §8-item-6 requirement to inspect memory BEFORE it
//                  is freed rather than after: the harness calls the
//                  module-private `_secret_buf_wipe` primitive
//                  directly on a still-allocated block, reads the
//                  bytes back through the address it already holds,
//                  and only then frees the block itself.
//
// `SecretBuf` is dormant and module-private — nothing here is a
// public-surface claim; the harness reaches the linked symbols
// directly, the same way a C consumer of any Sailfin-emitted object
// file can, without going through Sailfin's own import visibility
// rules (which are a *source-level* restriction on safe Sailfin code,
// not a linker-level one).
import { contains, find } from "sfn/strings";
import { sfn_bin_path } from "sfn/test";

fn _scratch(tag: string) -> string ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let dir = base + "/sfn-secret-buf-" + tag;
    fs.createDirectory(dir, true);
    return dir;
}

fn _env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

fn _repo_root() -> string ![io] {
    let configured = env.get("SAILFIN_REPO_ROOT");
    if configured.length > 0 { return configured; }
    return ".";
}

// ---- Test 1: typecheck ----
test "secret_buf_runtime: runtime/sfn/memory/secretbuf.sfn typechecks cleanly" ![io] {
    let skeleton = _repo_root() + "/runtime/sfn/memory/secretbuf.sfn";
    let exit = process.run_capture([sfn_bin_path(), "check", skeleton], _env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert find(out + err, "ok", 0) >= 0;
}

// ---- Test 2: fmt ----
test "secret_buf_runtime: runtime/sfn/memory/secretbuf.sfn is fmt-canonical" ![io] {
    let skeleton = _repo_root() + "/runtime/sfn/memory/secretbuf.sfn";
    let exit = process.run_capture([sfn_bin_path(), "fmt", "--check", skeleton], _env());
    let _ = process.capture_take_stdout();
    let _ = process.capture_take_stderr();
    assert exit == 0;
}

fn _emit_secretbuf(dir: string) -> string ![io] {
    let skeleton = _repo_root() + "/runtime/sfn/memory/secretbuf.sfn";
    let out_ll = dir + "/secretbuf.ll";
    if !fs.exists(out_ll) {
        let exit = process.run_capture([sfn_bin_path(), "emit", "-o", out_ll, "llvm", skeleton], _env());
        let _ = process.capture_take_stdout();
        let _ = process.capture_take_stderr();
        assert exit == 0;
    }
    return out_ll;
}

// ---- Test 3: emit shape — aggregate layouts, seven defines, extern declares ----
test "secret_buf_runtime: sfn emit llvm pins SecretBuf/SfnSecretCleanupNode layouts and the seven function defines" ![io] {
    let dir = _scratch("emit");
    let out_ll = _emit_secretbuf(dir);
    let ir = fs.readFile(out_ll);

    // Aggregate layouts (SFEP-0069 §3.2/§3.5)
    assert contains(ir, "%SecretBuf = type { i64, i64, i64, i64 }");
    assert contains(ir, "%SfnSecretCleanupNode = type { i64, i64, i64, i64, i64 }");

    // The seven public functions
    assert contains(ir, "@secret_buf_new(");
    assert contains(ir, "@secret_buf_len(");
    assert contains(ir, "@secret_buf_declassify_byte(");
    assert contains(ir, "@secret_buf_set(");
    assert contains(ir, "@secret_buf_append(");
    assert contains(ir, "@secret_buf_zeroize(");
    assert contains(ir, "@secret_buf_declassify_copy(");

    // Extern declares
    assert contains(ir, "@malloc(");
    assert contains(ir, "@free(");
    assert contains(ir, "@memcpy(");

    // The non-elidable wipe primitive's own body carries the volatile
    // byte-store loop (SFEP-0069 §3.6), not an ordinary store.
    assert contains(ir, "store volatile i8 0");
}

// ---- Test 4: wipe precedes free, both in growth and in zeroize ----
// Asserts the index of the `_secret_buf_wipe` call is strictly before
// the index of the first `free` call within each function's own IR
// body (bounded by the next top-level `define`) — the SFEP-0069 §3.5
// cleanup order pinned at the IR level, mirroring the "every free is
// control-dependent on completion of the wipe loop" shipping
// assertion in §3.6.
test "secret_buf_runtime: secret_buf_append growth wipes the old block before freeing it (IR order)" ![io] {
    let dir = _scratch("emit");
    let out_ll = _emit_secretbuf(dir);
    let ir = fs.readFile(out_ll);

    let fn_start = find(ir, "define %SecretBuf* @secret_buf_append(", 0);
    assert fn_start >= 0;
    let fn_end = find(ir, "\ndefine ", fn_start + 1);
    assert fn_end > fn_start;

    let wipe_idx = find(ir, "call void @_secret_buf_wipe(", fn_start);
    let free_idx = find(ir, "call void @free(", fn_start);
    assert wipe_idx >= fn_start;
    assert wipe_idx < fn_end;
    assert free_idx >= fn_start;
    assert free_idx < fn_end;
    assert wipe_idx < free_idx;
}

test "secret_buf_runtime: secret_buf_zeroize wipes before freeing the backing allocation (IR order)" ![io] {
    let dir = _scratch("emit");
    let out_ll = _emit_secretbuf(dir);
    let ir = fs.readFile(out_ll);

    let fn_start = find(ir, "define void @secret_buf_zeroize(", 0);
    assert fn_start >= 0;
    let fn_end = find(ir, "\ndefine ", fn_start + 1);
    assert fn_end > fn_start;

    let wipe_idx = find(ir, "call void @_secret_buf_wipe(", fn_start);
    let free_idx = find(ir, "call void @free(", fn_start);
    assert wipe_idx >= fn_start;
    assert wipe_idx < fn_end;
    assert free_idx >= fn_start;
    assert free_idx < fn_end;
    assert wipe_idx < free_idx;
}

// ---- Test 5: functional roundtrip via clang-compiled C harness ----
test "secret_buf_runtime: new -> wipe-before-free -> set -> declassify_copy -> zeroize idempotency (C harness via clang)" ![io] {
    let dir = _scratch("roundtrip");
    let secretbuf_ll = _emit_secretbuf(dir);

    let harness = dir + "/harness.c";
    fs.writeFile(harness, "#include <stddef.h>\n" + "#include <stdint.h>\n"
        + "#include <stdio.h>\n"
        + "#include <stdlib.h>\n"
        + "#include <string.h>\n"
        + "\n"
        + "extern void *secret_buf_new(int64_t capacity);\n"
        + "extern int64_t secret_buf_len(void *self);\n"
        + "extern int64_t secret_buf_declassify_byte(void *self, int64_t index);\n"
        + "extern void *secret_buf_set(void *self, int64_t index, int64_t value);\n"
        + "extern void *secret_buf_append(void *self, int64_t value);\n"
        + "extern void secret_buf_zeroize(void *self);\n"
        + "extern void *secret_buf_declassify_copy(void *self);\n"
        + "extern void _secret_buf_wipe(int64_t ptr_addr, int64_t cap);\n"
        + "\n"
        + "void sailfin_runtime_mark_persistent(void *ptr) { (void)ptr; }\n"
        + "void sfn_type_register(void *desc) { (void)desc; }\n"
        + "void *sfn_alloc_struct(int64_t size) { return calloc(1, (size_t)size); }\n"
        + "\n"
        + "int main(void) {\n"
        + "    /* ---- wipe-before-free: fill, wipe, read (before free), then free ---- */\n"
        + "    void *buf = secret_buf_new(64);\n"
        + "    if (!buf) { fprintf(stderr, \"new failed\\n\"); return 1; }\n"
        + "    int64_t *fields = (int64_t *)buf;\n"
        + "    int64_t ptr_addr = fields[0];\n"
        + "    int64_t cap = fields[2];\n"
        + "    if (ptr_addr == 0) { fprintf(stderr, \"ptr_addr == 0\\n\"); return 2; }\n"
        + "    if (cap != 64) { fprintf(stderr, \"cap != 64 (got %lld)\\n\", (long long)cap); return 3; }\n"
        + "    unsigned char *raw = (unsigned char *)(intptr_t)ptr_addr;\n"
        + "    memset(raw, 0xAB, (size_t)cap);\n"
        + "    _secret_buf_wipe(ptr_addr, cap);\n"
        + "    for (int64_t i = 0; i < cap; i++) {\n"
        + "        if (raw[i] != 0) { fprintf(stderr, \"byte %lld not wiped\\n\", (long long)i); return 4; }\n"
        + "    }\n"
        + "    free(raw);\n"
        + "\n"
        + "    /* ---- set + declassify_copy: fresh secret, write a pattern, copy out ---- */\n"
        + "    void *secret = secret_buf_new(8);\n"
        + "    if (!secret) { fprintf(stderr, \"secret new failed\\n\"); return 5; }\n"
        + "    const char *pattern = \"SECRET42\";\n"
        + "    for (int64_t i = 0; i < 8; i++) {\n"
        + "        secret = secret_buf_set(secret, i, (int64_t)(unsigned char)pattern[i]);\n"
        + "    }\n"
        + "    if (secret_buf_len(secret) != 8) { fprintf(stderr, \"secret len != 8\\n\"); return 6; }\n"
        + "    for (int64_t i = 0; i < 8; i++) {\n"
        + "        if (secret_buf_declassify_byte(secret, i) != (int64_t)(unsigned char)pattern[i]) {\n"
        + "            fprintf(stderr, \"declassify_byte(%lld) mismatch\\n\", (long long)i);\n"
        + "            return 7;\n"
        + "        }\n"
        + "    }\n"
        + "    void *copy = secret_buf_declassify_copy(secret);\n"
        + "    if (!copy) { fprintf(stderr, \"declassify_copy returned null\\n\"); return 8; }\n"
        + "    int64_t *ofields = (int64_t *)copy;\n"
        + "    int64_t copy_ptr = ofields[0];\n"
        + "    int64_t copy_len = ofields[1];\n"
        + "    if (copy_len != 8) { fprintf(stderr, \"copy len != 8 (got %lld)\\n\", (long long)copy_len); return 9; }\n"
        + "    unsigned char *copy_raw = (unsigned char *)(intptr_t)copy_ptr;\n"
        + "    if (memcmp(copy_raw, pattern, 8) != 0) { fprintf(stderr, \"copy bytes mismatch\\n\"); return 10; }\n"
        + "    free(copy_raw);\n"
        + "\n"
        + "    /* ---- append growth: relocation happens without crashing ---- */\n"
        + "    void *grown = secret_buf_new(8);\n"
        + "    for (int64_t i = 0; i < 40; i++) {\n"
        + "        grown = secret_buf_append(grown, (int64_t)('a' + (i % 26)));\n"
        + "    }\n"
        + "    if (secret_buf_len(grown) != 40) { fprintf(stderr, \"grown len != 40\\n\"); return 11; }\n"
        + "    for (int64_t i = 0; i < 40; i++) {\n"
        + "        int64_t want = (int64_t)('a' + (i % 26));\n"
        + "        if (secret_buf_declassify_byte(grown, i) != want) {\n"
        + "            fprintf(stderr, \"grown byte %lld mismatch\\n\", (long long)i);\n"
        + "            return 12;\n"
        + "        }\n"
        + "    }\n"
        + "    secret_buf_zeroize(grown);\n"
        + "\n"
        + "    /* ---- zeroize idempotency ----\n"
        + "       Step 5 of the SFEP-0069 3.5 order zeroes the descriptor, so the\n"
        + "       second call takes the cleanup_token == 0 early return instead of\n"
        + "       reading `state` out of the record the first call freed. Asserting\n"
        + "       the zeroed descriptor is what makes this a real guard: without it\n"
        + "       a second zeroize reads freed memory and passes only by luck. */\n"
        + "    void *idem = secret_buf_new(16);\n"
        + "    secret_buf_zeroize(idem);\n"
        + "    /* Recycle the freed cleanup record before the second call. Without\n"
        + "       an intervening allocation the freed node is untouched in tcache\n"
        + "       and a stale-token read happens to return `draining`, so the test\n"
        + "       would pass whether or not the guard works. This allocation hands\n"
        + "       that 40-byte block to a NEW record, so a surviving stale token\n"
        + "       reads `live` and drains someone else's buffer. */\n"
        + "    void *recycler = secret_buf_new(32);\n"
        + "    int64_t *rfields = (int64_t *)recycler;\n"
        + "    int64_t recycler_ptr = rfields[0];\n"
        + "    int64_t *ifields = (int64_t *)idem;\n"
        + "    if (ifields[0] != 0 || ifields[1] != 0 || ifields[2] != 0 || ifields[3] != 0) {\n"
        + "        fprintf(stderr, \"descriptor not zeroed after zeroize\\n\");\n"
        + "        return 14;\n"
        + "    }\n"
        + "    secret_buf_zeroize(idem);\n"
        + "    /* The recycled record must be untouched: same backing pointer, and\n"
        + "       still drainable exactly once. */\n"
        + "    if (rfields[0] != recycler_ptr) {\n"
        + "        fprintf(stderr, \"stale zeroize corrupted a live record\\n\");\n"
        + "        return 15;\n"
        + "    }\n"
        + "    secret_buf_zeroize(recycler);\n"
        + "\n"
        + "    /* ---- canonical empty drop: zeroize on an allocation-failure-shaped buffer is a no-op ---- */\n"
        + "    void *empty = secret_buf_new(0);\n"
        + "    int64_t *efields = (int64_t *)empty;\n"
        + "    if (efields[0] != 0 || efields[1] != 0 || efields[2] != 0 || efields[3] != 0) {\n"
        + "        fprintf(stderr, \"canonical empty is not all-zero\\n\");\n"
        + "        return 13;\n"
        + "    }\n"
        + "    secret_buf_zeroize(empty);\n"
        + "\n"
        + "    return 0;\n"
        + "}\n");

    let bin = dir + "/roundtrip";
    let clang_exit = process.run_capture(["clang", "-Wno-override-module", harness, secretbuf_ll, "-o", bin, "-lm"], _env());
    let clang_out = process.capture_take_stdout();
    let clang_err = process.capture_take_stderr();
    if clang_exit != 0 {
        // clang not available or link failed — skip roundtrip; the
        // IR-shape and ordering assertions above still pin the
        // contract.
        assert true;
    } else {
        let run_exit = process.run_capture([bin], _env());
        let run_out = process.capture_take_stdout();
        let run_err = process.capture_take_stderr();
        assert run_exit == 0;
    }
}
