// End-to-end regression for SFN-1199: the active `-k` / `--tag` selection must
// be part of the test-binary cache key.
//
// The filter cut (`set_test_filters` -> `_filter_program_tests`) runs upstream
// of emit, so a filtered link produces a binary holding only the surviving
// tests. Before the fix `test_bin_cache_key` folded no filter term, so a
// filtered and an unfiltered run of identical source computed the SAME key and
// whichever ran first served its binary to the other. When the unfiltered run
// lost that race it reported PASS having executed a subset — a silent false
// green.
//
// Pinned end to end rather than only at the key level: the unit suite
// (`compiler/tests/unit/build_cache_test.sfn`) proves the digests differ, but
// only a real multi-run sequence proves what the runner actually EXECUTES.
//
// Native e2e per `.claude/rules/no-bash-e2e.md`. Deliberately does NOT pass
// `--no-test-cache`: a live cache is the whole point, since that flag is the
// workaround this fix retires.
//
// Assertions read the `--json` summary's `"passed":N`. That count comes from
// the executed RECORDS (`_emit_results_events`), not from static discovery, so
// it reflects what the binary actually ran — which is exactly the field that
// lied before the fix. Assertions on a test NAME would not discriminate: in
// JSON mode the per-test event is rendered from the statically discovered
// entry name, not from the record, so a wrong binary still prints the expected
// names.
import { find, int_to_string } from "sfn/strings";
import { clean_runner_env_without, nested_runner_scratch, sfn_bin_path } from "sfn/test";

// Per-leg scratch + a caller-owned cache root, per the nested-runner rule
// (SFN-401). `SAILFIN_BUILD_CACHE_DIR` is stripped before the push so an
// inherited outer value cannot shadow it. All legs of one test share
// `cache_dir` — that sharing is precisely what the regression needs — while
// each leg gets its own scratch so the runs cannot collide on `test.exe`.
// One cache root shared by every leg in this FILE. The four fixtures below
// differ in content and `test_bin_cache_key` folds the source hash, never the
// path, so their test-bin keys are distinct and each test still exercises its
// own cold/warm sequence. Sharing reuses only the expensive runtime-object
// link, which is invariant across them — three private roots paid that link
// three times for nothing. Still isolated per invocation, since the shared
// path hangs off this invocation's own scratch.
fn _shared_cache() -> string ![io] {
    return nested_runner_scratch("filter-cache-key-shared") + "/cache";
}

fn _leg_env(cache_dir: string, label: string) -> string[] ![io] {
    let mut e = clean_runner_env_without(nested_runner_scratch("filter-cache-key-"
        + label), ["SAILFIN_BUILD_CACHE_DIR"]);
    e.push("SAILFIN_BUILD_CACHE_DIR=" + cache_dir);
    return e;
}

fn _run(args: string[], cache_dir: string, label: string) -> string ![io] {
    let mut argv: string[] = [sfn_bin_path(), "test"];
    let mut i = 0;
    loop {
        if i >= args.length { break; }
        argv.push(args[i]);
        i += 1;
    }
    argv.push("--json");
    let exit = process.run_capture(argv, _leg_env(cache_dir, label));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let log = out + err;
    print.err("[filter-cache-key] leg=" + label + " cache=" + cache_dir
        + " child exit="
        + int_to_string(exit)
        + " combined output:\n"
        + log);
    return log;
}

// Three tests whose names share the substring `marker` but differ in prefix, so
// `-k alpha_marker` selects exactly one and `-k marker` selects all three. The
// executed count therefore separates the two selections.
//
// `salt` varies the file's CONTENT: `test_bin_cache_key` folds the source hash
// and never the path, so two fixtures with identical bodies would derive one
// key and the pool leg below would race two children onto a single entry
// instead of exercising two.
fn _fixture_body(salt: string) -> string {
    return "test \"alpha_marker one\" {\n    assert 1 == 1;\n}\n\ntest \"beta_marker two\" {\n    assert 2 == 2;\n}\n\ntest \"gamma_marker three\" {\n    let salt = \""
        + salt
        + "\";\n    assert salt.length > 0;\n}\n";
}

fn _write_fixture(root: string, name: string) -> string ![io] {
    let dir = root + "/" + name;
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/" + name + "_test.sfn", _fixture_body(name));
    return dir;
}

// The core property, in the order the issue reports it: a filtered run between
// two unfiltered runs must not change what the second unfiltered run executes.
// Single-process path (one test file).
//
// Pre-fix this goes red at leg 2: leg 1 populates the shared key with the FULL
// binary, so the filtered leg hits it and runs all three tests, reporting
// `"passed":3` where 1 is expected. Leg 3 is the issue's own
// filtered-then-unfiltered direction and is the leg that goes red when the
// legs run in the opposite order.
test "test filter cache: a filtered run does not shrink a later unfiltered run" ![io] {
    let root = fs.mkdtemp("sfn-filter-cache-single-");
    let cache = _shared_cache();
    let dir = _write_fixture(root, "single");

    let first = _run([dir], cache, "single-unfiltered-cold");
    assert find(first, "\"passed\":3", 0) >= 0;
    assert find(first, "\"failed\":0", 0) >= 0;

    let filtered = _run([dir, "-k", "alpha_marker"], cache, "single-filtered");
    assert find(filtered, "\"passed\":1", 0) >= 0;
    assert find(filtered, "\"failed\":0", 0) >= 0;

    let second = _run([dir], cache, "single-unfiltered-warm");
    assert find(second, "\"passed\":3", 0) >= 0;
    assert find(second, "\"failed\":0", 0) >= 0;
}

// Two different `-k` values must not serve each other's binaries. The
// selections differ in COUNT (1 vs 3), not merely in which test is named:
// sharing a binary would make the second leg report the first leg's count.
test "test filter cache: two different -k selectors do not share a binary" ![io] {
    let root = fs.mkdtemp("sfn-filter-cache-distinct-");
    let cache = _shared_cache();
    let dir = _write_fixture(root, "distinct");

    let narrow = _run([dir, "-k", "alpha_marker"], cache, "distinct-narrow");
    assert find(narrow, "\"passed\":1", 0) >= 0;
    assert find(narrow, "\"failed\":0", 0) >= 0;

    // Pre-fix this hits the narrow leg's entry and reports `"passed":1`.
    let wide = _run([dir, "-k", "marker"], cache, "distinct-wide");
    assert find(wide, "\"passed\":3", 0) >= 0;
    assert find(wide, "\"failed\":0", 0) >= 0;
}

// The same property under the pool path: `_pool_child_argv` forwards
// `-k`/`--tag` to each child, so a child re-establishes the filter state and
// must derive the same filter-bearing key its single-process counterpart does.
// Two files keep the runner off the in-process leaf path and on the fan-out.
test "test filter cache: the pool path also keys on the active filter" ![io] {
    let root = fs.mkdtemp("sfn-filter-cache-pool-");
    let cache = _shared_cache();
    let dir_a = _write_fixture(root, "poola");
    let dir_b = _write_fixture(root, "poolb");

    let first = _run([dir_a, dir_b, "--jobs", "2"], cache, "pool-unfiltered-cold");
    assert find(first, "\"passed\":6", 0) >= 0;
    assert find(first, "\"failed\":0", 0) >= 0;

    let filtered = _run([dir_a, dir_b, "--jobs", "2", "-k", "alpha_marker"], cache, "pool-filtered");
    assert find(filtered, "\"passed\":2", 0) >= 0;
    assert find(filtered, "\"failed\":0", 0) >= 0;

    let second = _run([dir_a, dir_b, "--jobs", "2"], cache, "pool-unfiltered-warm");
    assert find(second, "\"passed\":6", 0) >= 0;
    assert find(second, "\"failed\":0", 0) >= 0;
}
