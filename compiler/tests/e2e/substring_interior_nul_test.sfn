// SFN-632 — soundness regression for `sfn_str_slice_lv`
// (`runtime/sfn/string.sfn`), the length-carrying sibling of the retained
// bare `sfn_str_slice`. The bare symbol's `(i8*, double, double) -> i8*`
// shape never receives the source length, so a slice spanning an interior
// NUL byte is silently truncated when the aggregate is rebuilt at the call
// site with a `sfn_str_len` `strnlen` scan (the SFN-1008 truncation class).
// `sfn_str_slice_lv` fixes this by carrying `s_len` in and returning a
// pointer to a `{data@0, len@8}` header the caller loads through directly —
// no rescan, so no truncation.
//
// A Sailfin `string` has no interior-NUL representation, so the hazard is
// synthesized directly via a C harness, mirroring
// `string_length_aware_lv_test.sfn`'s pattern for the same module and
// `fs_write_carry_length_test.sfn`'s pattern for the hard-fail-on-link-error
// discipline (a compile/link failure after resolution is a hard regression,
// not a silent skip, once a host compiler is confirmed reachable).
import {
    contains,
    find,
    split,
    starts_with
} from "sfn/strings";
import {
    c_math_link_flags,
    clean_runner_env,
    nested_runner_scratch,
    run_external_c_oracle,
    sfn_bin_path
} from "sfn/test";

fn _repo_root() -> string ![io] {
    let configured = env.get("SAILFIN_REPO_ROOT");
    if configured.length > 0 { return configured; }
    return ".";
}

fn _string_path() -> string ![io] {
    return _repo_root() + "/runtime/sfn/string.sfn";
}

fn _has_define_named(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "define ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// The C harness. `main` exercises the interior-NUL soundness contract
// directly: `sfn_str_slice_lv` must honor the carried length across a
// payload's interior NUL, while the retained bare `sfn_str_slice` — kept
// only for the pinned seed's old-ABI call shape — truncates at it, since it
// has no length input and its result is read back as an ordinary C string.
//
// The stub set mirrors `string_length_aware_lv_test.sfn`'s for the helpers
// `main` never reaches (type registration, struct allocation, the realloc
// path), so the linker only needs a definition, never a real one.
// `string.sfn` has no filesystem or Windows-only surface, so — unlike
// `fs_write_carry_length_test.sfn`'s harness — no `win32_provided` split is
// needed here.
//
// The arena is the one stub that must be REAL, and this is where this
// harness diverges from `string_length_aware_lv_test.sfn`. That test drives
// only non-allocating length-aware reads, so it can stub `sfn_arena_alloc`
// to return null. `sfn_str_slice_lv` allocates its `{data@0, len@8}` header
// and payload through the arena, so a null-returning stub would drive it
// down the exhaustion arm and hand `main` a null header to dereference —
// the test would segfault rather than measure anything. `malloc` backs it
// instead: glibc returns at least 16-byte alignment, which covers the
// 8-alignment the payload's word read-modify-write requires.
//
// Stub widths are the fixed-width C spellings, not `long`: Sailfin `usize` /
// `i64` are 64-bit on every target while `unsigned long` is 32 bits under
// LLP64, and `sfn_arena_alloc` is the one stub whose argument is actually
// read. `string_cstr_boundary_test.sfn` uses `uint64_t` for the same reason.
//
// `sfn_alloc_struct` and `sfn_raise_value_error` stay degenerate because
// `main` cannot reach them while the allocator succeeds — but note they sit on
// `_sfn_empty_str_header`'s exhaustion arm, so a `malloc` failure here would
// fault inside the harness rather than report a failure.
fn _harness_c() -> string {
    return "#include <stdio.h>\n" + "#include <string.h>\n"
        + "#include <stdlib.h>\n"
        + "#include <stdint.h>\n"
        + "static char _arena_token;\n"
        + "void* sfn_arena_global(void){return &_arena_token;}\n"
        + "void* owned_buf_new(int64_t a,int64_t b){(void)a;(void)b;return 0;}\n"
        + "void  sailfin_runtime_mark_persistent(void* p){(void)p;}\n"
        + "_Bool sfn_arena_enabled(void){return 0;}\n"
        + "void  sfn_type_register(void* d){(void)d;}\n"
        + "void* sfn_alloc_struct(int64_t n){(void)n;return 0;}\n"
        + "void* sfn_arena_alloc(void* a,uint64_t s,uint64_t g){(void)a;(void)g;return malloc(s ? (size_t)s : 1);}\n"
        + "void* sfn_arena_realloc(void* a,void* p,uint64_t s,uint64_t g){(void)a;(void)p;(void)s;(void)g;return 0;}\n"
        + "void  sfn_raise_value_error(void* a){(void)a;}\n"
        + "extern char* sfn_str_slice_lv(const char* d, long long n, double a, double b);\n"
        + "extern char* sfn_str_slice(const char* d, double a, double b);\n"
        + "struct Hdr { const char* d; long long n; };\n"
        + "int main(void){\n"
        + "  char payload[] = { 'A', 'B', '\\0', 'C', 'D' }; /* interior NUL at index 2 */\n"
        + "  int ok = 1;\n"
        + "  /* The length-carrying twin must return all 5 bytes, NUL included. */\n"
        + "  void* result = sfn_str_slice_lv(payload, 5, 0.0, 5.0);\n"
        + "  struct Hdr* h = (struct Hdr*)result;\n"
        + "  if(h->n != 5){ printf(\"lv len FAIL got=%lld want=5\\n\", h->n); ok = 0; }\n"
        + "  if(memcmp(h->d, payload, 5) != 0){ printf(\"lv bytes FAIL\\n\"); ok = 0; }\n"
        + "  /* Contrast: the retained bare symbol has no length input, so its\n"
        + "   * caller reads the result as an ordinary C string and truncates at\n"
        + "   * the interior NUL. This is the defect `_lv` exists to fix. */\n"
        + "  char* old = sfn_str_slice(payload, 0.0, 5.0);\n"
        + "  if(strlen(old) != 2){ printf(\"bare truncation FAIL got=%zu want=2\\n\", strlen(old)); ok = 0; }\n"
        + "  printf(ok ? \"ALL OK\\n\" : \"SOME FAIL\\n\");\n"
        + "  return ok ? 0 : 1;\n"
        + "}\n";
}

test "sfn_str_slice_lv carries the caller's length across an interior NUL" ![io] {
    let scratch = nested_runner_scratch("substring-interior-nul");
    fs.createDirectory(scratch, true);
    let child_env = clean_runner_env(scratch);

    let ll = scratch + "/string.ll";
    let emit_exit = process.run_capture([sfn_bin_path(), "emit", "-o", ll, "llvm", _string_path()], child_env);
    let _eo = process.capture_take_stdout();
    let _ee = process.capture_take_stderr();
    assert emit_exit == 0;

    let ir = fs.readFile(ll);
    assert _has_define_named(ir, "sfn_str_slice_lv");
    assert _has_define_named(ir, "sfn_str_slice");

    let harness = scratch + "/interior_nul_harness.c";
    fs.writeFile(harness, _harness_c());
    let bin = scratch + "/interior_nul_harness";
    // libm comes from `c_math_link_flags()` rather than a literal `-lm`
    // (SFN-1114): that spelling has no MSVC counterpart, and the helper
    // answers with the empty array there, which is why it returns a list
    // rather than a string.
    let mut oracle_argv: string[] = ["-Wno-override-module", harness, ll, "-o", bin];
    for flag in c_math_link_flags() { oracle_argv.push(flag); }
    let clang_exit = run_external_c_oracle(oracle_argv);
    let _co = process.capture_take_stdout();
    let clang_err = process.capture_take_stderr();
    if clang_exit != 0 {
        print("interior-nul harness failed to link (exit=" + _int_to_string(clang_exit)
            + ")");
        print(clang_err);
    }
    assert clang_exit == 0;

    let run_exit = process.run_capture([bin], child_env);
    let out = process.capture_take_stdout();
    let run_err = process.capture_take_stderr();
    if run_exit != 0 {
        print("interior-nul harness exited " + _int_to_string(run_exit));
        print(out);
        print(run_err);
    }
    assert run_exit == 0;
    assert find(out, "ALL OK", 0) >= 0;
}

fn _int_to_string(n: int) -> string {
    if n == 0 { return "0"; }
    let mut v = n;
    let mut neg = false;
    if v < 0 {
        neg = true;
        v = -v;
    }
    let mut digits = "";
    let table = "0123456789";
    loop {
        if v <= 0 { break; }
        digits = table[v % 10] + digits;
        v = v / 10;
    }
    if neg { return "-" + digits; }
    return digits;
}
