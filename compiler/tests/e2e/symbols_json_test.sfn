// End-to-end coverage for `sfn symbols --json` (SFN-444).
//
// Drives the real binary as a subprocess (`.claude/rules/no-bash-e2e.md`)
// and asserts on the raw stdout envelope with `sfn/strings` predicates —
// `symbols` is pure-frontend (no clang/link), so `_child_env()` needs
// only `PATH`/`HOME`, mirroring `check_json_schema_test.sfn`. The
// subprocess inherits the runner's cwd (repo root), so the binary resolves
// `runtime/` and derives library locations from `workspace.toml`.
import { contains } from "sfn/strings";
import { sfn_bin_abs_path, sfn_bin_path } from "sfn/test";

fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    return e;
}

struct SymbolsRun {
    exit: int,
    out: string,
    err: string
}

fn _symbols(args: string[]) -> SymbolsRun ![io] {
    let mut argv: string[] = [sfn_bin_path(), "symbols"];
    let mut i: int = 0;
    loop {
        if i >= args.length { break; }
        argv.push(args[i]);
        i += 1;
    }
    let exit = process.run_capture(argv, _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    return SymbolsRun { exit: exit, out: out, err: err };
}

test "symbols: emits the sailfin-symbols/1 envelope" ![io] {
    let r = _symbols(["--json"]);
    assert r.exit == 0;
    assert contains(r.out, "\"schema_version\":\"sailfin-symbols/1\"");
    assert contains(r.out, "\"compiler_version\"");
    assert contains(r.out, "\"symbols\"");
    assert contains(r.out, "\"parse_failures\"");
}

test "symbols: indexes sfn/strings helpers with signatures" ![io] {
    let r = _symbols(["--json"]);
    assert contains(r.out, "sfn/strings");
    assert contains(r.out, "ascii_uppercase");
    assert contains(r.out, "ascii_lowercase");
    assert contains(r.out, "int_to_string");
    assert contains(r.out, "parse_int");
    assert contains(r.out, "Result<int, string>");
}

test "symbols: output is byte-stable across two runs" ![io] {
    let a = _symbols(["--json"]);
    let b = _symbols(["--json"]);
    assert a.out == b.out;
}

test "symbols: unknown --capsule is a structured error with nonzero exit" ![io] {
    let r = _symbols(["--json", "--capsule", "sfn/definitely-not-real"]);
    assert r.exit != 0;
    assert contains(r.out, "E_SYMBOLS_UNRESOLVED_CAPSULE");
}

test "symbols: --capsule sfn/strings restricts to that capsule" ![io] {
    let r = _symbols(["--json", "--capsule", "sfn/strings"]);
    assert r.exit == 0;
    assert contains(r.out, "ascii_uppercase");
    assert contains(r.out, "sfn/strings");
}

test "symbols: workspace inventory discovers an arbitrary member root" ![io] {
    let root = fs.mkdtemp("sfn-symbols-member-root-");
    fs.createDirectory(root + "/runtime", true);
    fs.createDirectory(root + "/domains/foundation/alpha/src", true);
    fs.writeFile(root + "/workspace.toml", "[workspace]\nmembers = [\"runtime\", \"domains/foundation/alpha\"]\n");
    fs.writeFile(root + "/runtime/capsule.toml", "[capsule]\nname = \"sfn/runtime-native\"\nversion = \"0.0.0\"\npublish = false\n\n[capabilities]\nrequired = []\n\n[build]\nkind = \"runtime\"\nentry = \"prelude.sfn\"\nprelude-entry = \"prelude.sfn\"\n");
    fs.writeFile(root + "/runtime/prelude.sfn", "fn fixture_prelude() -> int { return 1; }\n");
    fs.writeFile(root + "/domains/foundation/alpha/capsule.toml", "[capsule]\nname = \"sfn/alpha\"\nversion = \"0.0.0\"\n\n[capabilities]\nrequired = []\n\n[build]\nkind = \"library\"\nentry = \"src/mod.sfn\"\n");
    fs.writeFile(root + "/domains/foundation/alpha/src/mod.sfn", "fn arbitrary_root_marker() -> int { return 7; }\n");

    let mut child_env = _child_env();
    child_env.push("SAILFIN_RUNTIME_ROOT=" + root + "/runtime");
    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "symbols", "--json", "--capsule", "sfn/alpha"], child_env, root);
    let out = process.capture_take_stdout();
    let _ = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "sfn/alpha");
    assert contains(out, "arbitrary_root_marker");
}
