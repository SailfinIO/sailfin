// Full both-native TLS loopback e2e (SFEP-0036 §8, gap B1 of epic #1540,
// issue #1785). Locks in the inbound TLS termination (#1783) and the
// outbound client verification (#1784) working *together* end-to-end: a
// native `sfn_serve_tls` server and the native `https://` client
// (`runtime/sfn/adapters/http.sfn` -> `runtime/sfn/platform/tls.sfn`,
// OpenSSL) complete a real handshake + request→response cycle over
// loopback, and an untrusted self-signed cert against the verifying client
// is rejected.
//
// Why this is distinct from the sibling TLS e2es. Each of those pairs ONE
// native half with the `openssl` CLI as the other peer:
//   - `serve_tls_loopback_test.sfn`      — native server vs `openssl s_client`
//   - `runtime_tls_https_client_test.sfn` — native client vs `openssl s_server`
//   - `runtime_tls_verify_failure_test.sfn` — native client vs `openssl s_server`
// This test drives BOTH halves native in one round-trip, so it is the
// regression that proves the two shipped halves interoperate — the
// acceptance bar of SFEP-0036 §8 issue #4.
//
// Trust model (`tls.sfn` §3.6). The client verifies on by default
// (SSL_VERIFY_PEER + SSL_get_verify_result == 0) plus the RFC-6125
// hostname check (SSL_set1_host). The self-signed server cert carries a
// `DNS:localhost` SAN and the client connects to `https://localhost:PORT/`,
// so:
//   - SUCCESS leg: `SAILFIN_TLS_CAFILE` points at the cert -> the chain is
//     trust-anchored -> the round-trip body arrives.
//   - VERIFY-FAILURE leg: no `SAILFIN_TLS_CAFILE` -> the self-signed cert
//     is not in any trust store -> chain verification fails -> the client
//     writes no body (the "no file written" failure signal, as in
//     `runtime_tls_verify_failure_test.sfn`).
//
// A third test asserts the plaintext `sfn_serve` path still round-trips
// (regression guard: adding TLS must not perturb the plaintext transport).
//
// no-bash-e2e (`.claude/rules/no-bash-e2e.md`): an `![io]` `*_test.sfn`
// drives everything via `process.*`; `openssl` is the cert generator only,
// and the servers are native Sailfin binaries. Builds thread the full
// parent environment (the nested build links via clang + ld) and
// `SAILFIN_TEST_SCRATCH` rides along, keeping the build cache
// per-invocation under the parallel pool.
//
// Matchers note (#842): `sfn/test`'s `expect_*` matchers are `![pure]` and
// cannot be called from an `![io]` test; assert on captured text with
// `sfn/strings::contains` / `sfn/strings::find` instead.
import { Env, env_from_current } from "sfn/os";
import { contains, find } from "sfn/strings";
import {
    default_scratch_dir,
    report_child_failure,
    report_child_failure_pending,
    sfn_bin_path,
    start_background,
    stop_background,
    tool_present,
    wait_until
} from "sfn/test";

// ── file-local raw loopback readiness probe ──────────────────────
// Prefixed `_tll_` so these never collide with the external-linkage
// runtime helpers of the same shape in `http.sfn` (not linked into this
// test binary, but the prefix keeps that independent of link order).
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

// `sfn_socket_open`, not the raw libc `socket` — on Windows every raw
// `socket()` call fails until `WSAStartup` runs in the process (SFN-1114):
// a probe of `socket(2, 1, 0)` here returns fd=-1 with
// `WSAGetLastError()` = 10093 (WSANOTINITIALISED). `sfn_socket_open`
// (`runtime/sfn/platform/socket_ops_windows.sfn`) is the runtime's socket
// creator and carries the `WSAStartup` call; its POSIX sibling
// (`socket_ops.sfn`) is a direct pass-through, so this is the correct
// symbol on every target, not a Windows-only substitution. Effect note:
// `socket_ops.sfn` is `net`-gated (`runtime/capsule.toml`
// `[sfn-source-gates]`), so `_tll_connect` and every caller up to
// `_await_tls_listening`/`_await_plain_listening`/both tests declare
// `![net]` transitively (SFN-927 is the undefined-symbol failure mode
// otherwise).
extern fn sfn_socket_open(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

// `sfn_socket_close`, not the raw libc `close` — on Windows `close()` on a
// Winsock SOCKET is not an error return but a process-killing
// `__fastfail(0xC0000409)` (`socket_ops_windows.sfn:11-12`). The runtime
// helper routes to `closesocket` there and to `close` on POSIX
// (`socket_ops.sfn:101`), so it is correct on every target (SFN-1114).
extern fn sfn_socket_close(fd: i32) -> i32;

fn _tll_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

// Connect a stream socket to `127.0.0.1:port`; returns the fd or -1. Tries
// both `sockaddr_in` byte layouts (Linux u16 sin_family at 0; macOS/BSD u8
// sin_len at 0 + u8 sin_family at 1), first success wins — the inlined
// `http.sfn::_connect_tcp` idiom. Used only to detect that the server is
// accepting before the client fixture runs.
fn _tll_connect(port: i64) -> i32 ![net] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_tll_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_tll_ptr_off(addr, 0), 16, 1 as usize);
            memset(_tll_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_tll_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_tll_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        memset(_tll_ptr_off(addr, 4), 127, 1 as usize);
        memset(_tll_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

// Fixed loopback ports for this test — distinct from the other native
// loopback e2es (18790 serve, 18795/18796/18797 tls-client/verify, 18893
// serve-tls) so the pool's `--jobs N` does not collide; high + uncommon to
// dodge local services.
fn _tls_port() -> i64 { return 18894; }

fn _tls_port_str() -> string { return "18894"; }

fn _plain_port() -> i64 { return 18895; }

fn _plain_port_str() -> string { return "18895"; }

// Full parent environment for the build + server + client subprocesses
// (`run_capture`/`spawn_with_env`'s empty env is EMPTY, not "inherit"):
// the nested build links a binary (clang + ld), and
// `SAILFIN_TEST_SCRATCH` (already present) keeps the build cache
// per-invocation under the parallel pool.
fn _child_env() -> string[] ![io] { return process.environ(); }

// The same environment in `sfn/os`'s typed form, for `start_background`
// (the `sfn/test` background-server spawn takes an `Env`, not the flat array).
fn _child_env_typed() -> Env ![io] { return env_from_current(); }

// Parent environment with any inherited `SAILFIN_TLS_CAFILE` entry
// stripped. A child's `getenv` resolves the FIRST matching entry, so a
// CAFILE set in the parent shell would otherwise leak into the child and
// either shadow the trusted run's intended cert or trust-anchor the
// "untrusted" negative case — skewing the result. Both client env builders
// start from this filtered base. `find(...) != 0` keeps every entry whose
// `SAILFIN_TLS_CAFILE=` prefix is NOT at index 0 (i.e. not this variable).
fn _env_no_cafile() -> string[] ![io] {
    let src = process.environ();
    let mut out: string[] = [];
    let mut i: i64 = 0;
    loop {
        if i >= src.length { break; }
        let entry = src[i];
        if find(entry, "SAILFIN_TLS_CAFILE=", 0) != 0 { out.push(entry); }
        i = i + 1;
    }
    return out;
}

// Client run-env WITH `SAILFIN_TLS_CAFILE` pointed at `cert_path` so the
// self-signed chain verifies (the cert as its own trust anchor).
fn _trusted_env(cert_path: string) -> string[] ![io] {
    let mut e = _env_no_cafile();
    e.push("SAILFIN_TLS_CAFILE=" + cert_path);
    return e;
}

// Client run-env WITHOUT any custom CA — the self-signed peer is not in the
// system trust store, so verification must fail.
fn _untrusted_env() -> string[] ![io] { return _env_no_cafile(); }

// A per-test scratch dir (under the runner's per-file scratch when present,
// else /tmp). Absolute so the server's baked cert/key paths resolve
// regardless of the server process's cwd.
fn _scratch_dir(name: string) -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/" + name;
    fs.createDirectory(dir, true);
    return dir;
}

// Generate a self-signed cert+key (no passphrase) with SAN = `san_host`.
// The client enforces RFC-6125 hostname verification (SSL_set1_host), and
// modern OpenSSL checks the SAN (not the CN) when a SAN is present, so the
// SAN must match the host the client connects to. Writes `cert.pem` /
// `key.pem` into `dir`. Returns true on success.
fn _gen_cert(dir: string, san_host: string) -> boolean ![io] {
    // Native TLS server signs CertificateVerify with Ed25519 only (RSA/ECDSA
    // signing is out of SFEP-0048 §6.3 scope), so `sfn_serve_tls` accepts an
    // Ed25519 certificate only (SFN-341).
    let exit = process.run_capture(["openssl", "req", "-x509", "-newkey", "ed25519", "-keyout", dir
        + "/key.pem", "-out", dir
        + "/cert.pem", "-days", "1", "-nodes", "-subj", "/CN="
        + san_host, "-addext", "subjectAltName=DNS:"
        + san_host], _child_env());
    report_child_failure_pending("tls-loopback cert-gen", exit);
    return exit == 0;
}

// Shared server-fixture body: the libc memory externs, a layout-matching
// `OwnedBuf` (the moved-`OwnedBuf` handler ABI, #1476), an `_owned_from`
// that returns a fresh libc-backed buffer (mirroring `sfn/http`'s
// `_http_owned_from_str`), and a `handle` that returns `marker`. This
// exercises the real runtime dispatch without depending on the `sfn/http`
// capsule; the runtime wraps the returned bytes in a bare `200 OK` with a
// `Content-Length`, so the native client terminates its read cleanly.
fn _owned_and_handle(marker: string) -> string {
    return "extern fn malloc(size: usize) -> * u8;\n"
        + "extern fn memcpy(dst: * u8, src: * u8, n: usize) -> * u8;\n"
        + "extern fn memset(dst: * u8, byte: i32, n: usize) -> * u8;\n"
        + "extern fn strlen(s: * u8) -> usize;\n"
        + "\n"
        + "struct OwnedBuf {\n"
        + "    ptr_addr: i64;\n"
        + "    len: i64;\n"
        + "    cap: i64;\n"
        + "    arena_addr: i64;\n"
        + "}\n"
        + "\n"
        + "fn _owned_from(s: string) -> OwnedBuf {\n"
        + "    let src: * u8 = s as * u8;\n"
        + "    let n: i64 = strlen(src) as i64;\n"
        + "    let copy: * u8 = malloc((n + 1) as usize);\n"
        + "    if copy as i64 == 0 { return OwnedBuf { ptr_addr: 0, len: 0, cap: 0, arena_addr: 0 }; }\n"
        + "    memcpy(copy, src, n as usize);\n"
        + "    memset(((copy as i64) + n) as * u8, 0, 1 as usize);\n"
        + "    return OwnedBuf { ptr_addr: copy as i64, len: n, cap: n + 1, arena_addr: 0 };\n"
        + "}\n"
        + "\n"
        + "fn handle(req: OwnedBuf) -> OwnedBuf { return _owned_from(\""
        + marker
        + "\"); }\n"
        + "\n";
}

// Write the TLS server fixture: the shared handler body plus a `main` that
// starts `sfn_serve_tls` (declared `extern`; the linker resolves it to
// `runtime/sfn/concurrency/serve.sfn`) with the cert/key paths read back
// from `argv[1]` (the scratch dir) rather than spliced into this source
// text. `SAILFIN_TEST_SCRATCH`/`TEMP` is a native Windows backslash path,
// and a literal `+ dir +` here would silently corrupt it the same way SFN-1001
// already diagnosed and fixed in `runtime_tls_anchor_cache_test.sfn`:
// `decode_string_literal_escapes` (`compiler/capsules/syntax/src/parser/utils.sfn:84-113`)
// drops the backslash for any `\<char>` it does not recognize as an escape
// when the nested build re-lexes this generated file, turning
// `C:\Users\...` into `C:Users...` — a different, non-existent path that
// `sfn_fs_read_file` then silently fails to open, so `tls_server_ctx`
// returns null and `sfn_serve_tls` returns before ever binding. Also prints
// a startup marker and checks both paths exist before serving, so a future
// regression here announces itself instead of a bare "never became
// connectable".
fn _write_tls_server(dir: string) -> string ![io] {
    let src = dir + "/tlssrv.sfn";
    fs.writeFile(src, "extern fn sfn_serve_tls(handler: * u8, port: i32, cert: * u8, key: * u8) -> void;\n"
        + _owned_and_handle("TLS-RT-OK-7c1e")
        + "fn main(argv: string[]) -> int ![net, io] {\n"
        + "    let dir = argv[1];\n"
        + "    let cert = dir + \"/cert.pem\";\n"
        + "    let key = dir + \"/key.pem\";\n"
        + "    if !fs.exists(cert) {\n"
        + "        print.err(\"[tls-loopback-srv] missing cert at \" + cert);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    if !fs.exists(key) {\n"
        + "        print.err(\"[tls-loopback-srv] missing key at \" + key);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    print.info(\"[tls-loopback-srv] starting TLS on port "
        + _tls_port_str()
        + "\");\n"
        + "    sfn_serve_tls(handle as * u8, "
        + _tls_port_str()
        + ", cert as * u8, key as * u8);\n"
        + "    return 0;\n"
        + "}\n");
    return src;
}

// Write the plaintext server fixture: the shared handler body plus a `main`
// that starts `sfn_serve` (the plaintext transport, unchanged by TLS). No
// filesystem path is baked into the source here, so it is not exposed to
// the corruption `_write_tls_server` guards against — the startup marker is
// added anyway so a silent-return regression on this leg would also
// announce itself.
fn _write_plain_server(dir: string) -> string ![io] {
    let src = dir + "/plainsrv.sfn";
    fs.writeFile(src, "extern fn sfn_serve(handler: * u8, port: i32) -> void;\n"
        + _owned_and_handle("PLAIN-RT-OK-7c1e")
        + "fn main() -> int ![net, io] {\n"
        + "    print.info(\"[tls-loopback-srv] starting plaintext on port "
        + _plain_port_str()
        + "\");\n"
        + "    sfn_serve(handle as * u8, "
        + _plain_port_str()
        + ");\n"
        + "    return 0;\n"
        + "}\n");
    return src;
}

// Write a client fixture capsule whose `main` downloads `url` to
// `<argv[1]>/body.out`. `http.download` writes the file ONLY on a
// successful round-trip (a failed connect/handshake/verify returns null
// before the file is opened), so its presence + content is the round-trip
// proof and its absence is the verify-rejected proof.
//
// The scratch dir travels through `argv[1]`, never spliced into this
// source text — see `_write_tls_server`'s header for why (SFN-1001). Also
// prints a startup marker and whether the download landed. The client
// cannot itself tell a corrupted scratch dir from an intended
// verify-rejection (an absent `out_path` is the correct outcome for that
// leg), so a missing `out_path` is reported but does not fail the run — the
// pre-flight `dir` check above is what actually catches a corrupted path,
// since `dir` itself is never legitimately missing.
fn _write_client(dir: string, url: string) -> string ![io] {
    let root = dir + "/client";
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/tls-loopback-e2e-client\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"tls loopback e2e client\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", "fn main(argv: string[]) -> int ![net, io] {\n"
        + "    let dir = argv[1];\n"
        + "    let out_path = dir + \"/body.out\";\n"
        + "    if !fs.exists(dir) {\n"
        + "        print.err(\"[tls-loopback-cli] scratch dir missing: \" + dir);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    print.info(\"[tls-loopback-cli] starting, target \" + out_path);\n"
        + "    let _ = http.download(\""
        + url
        + "\", out_path);\n"
        + "    if fs.exists(out_path) {\n"
        + "        print.info(\"[tls-loopback-cli] wrote \" + out_path);\n"
        + "    } else {\n"
        + "        print.info(\"[tls-loopback-cli] no file at \" + out_path\n"
        + "            + \" (expected for a verify-rejection leg)\");\n"
        + "    }\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

// Compile a fixture to a standalone binary up front (synchronous), so the
// cold compile is NOT inside the readiness poll window. Threads the full
// parent environment (the nested build links via clang + ld).
fn _build_bin(main_path: string, bin: string) -> string ![io] {
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", bin, main_path], _child_env());
    report_child_failure_pending("tls-loopback build", exit);
    if exit != 0 { return ""; }
    return bin;
}

// Poll a raw TCP connect until the prebuilt TLS server is accepting (startup
// is just the binary launching + bind + ctx build, ~1s). 30s wall-clock
// budget. Captures nothing — reaches the port through the file-local
// `_tls_port()` rather than closing over a parameter (SFN-843).
fn _await_tls_listening() -> boolean ![clock, io, net] {
    let start_ms: int = monotonic_millis();
    let ok = wait_until(fn () -> boolean {
        let fd: i32 = _tll_connect(_tls_port());
        if fd >= 0 {
            sfn_socket_close(fd);
            return true;
        }
        return false;
    }, 30000, 500);
    if !ok {
        let elapsed: int = monotonic_millis() - start_ms;
        print.info("[tls-loopback] probe: no listener on 127.0.0.1:"
            + _tls_port_str()
            + " after "
            + number_to_string(elapsed)
            + "ms");
    }
    return ok;
}

// Same probe for the plaintext server's port. See `_await_tls_listening` for
// the no-capture rationale.
fn _await_plain_listening() -> boolean ![clock, io, net] {
    let start_ms: int = monotonic_millis();
    let ok = wait_until(fn () -> boolean {
        let fd: i32 = _tll_connect(_plain_port());
        if fd >= 0 {
            sfn_socket_close(fd);
            return true;
        }
        return false;
    }, 30000, 500);
    if !ok {
        let elapsed: int = monotonic_millis() - start_ms;
        print.info("[tls-loopback] probe: no listener on 127.0.0.1:"
            + _plain_port_str()
            + " after "
            + number_to_string(elapsed)
            + "ms");
    }
    return ok;
}

// Run the client once with `run_env` and return the downloaded body (or ""
// if `http.download` wrote nothing — a failed round-trip/verify). `dir` is
// passed as the client's `argv[1]` (see `_write_client`'s header for why —
// SFN-1001), and `out_path` is recomputed here identically to how the
// fixture computes it internally. Removes any stale output first so the
// result reflects THIS run only.
fn _client_body(client_bin: string, run_env: string[], dir: string) -> string ![io] {
    let out_path = dir + "/body.out";
    let _rm = fs.deleteFile(out_path);
    let cexit = process.run_capture([client_bin, dir], run_env);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("tls-loopback client body run", cexit, out, err);
    if cexit != 0 { return ""; }
    if !fs.exists(out_path) {
        // Distinguishes "the client failed to run" (report_child_failure
        // above, exit != 0) from "the client ran and wrote nothing" — both
        // previously collapsed into the identical empty `body` a caller
        // sees, with no way to tell them apart from the retry loop alone.
        print.info("[tls-loopback] client exited 0 but wrote no file at "
            + out_path
            + "; stdout=\""
            + substring(out, 0, 2048)
            + "\" stderr=\""
            + substring(err, 0, 2048)
            + "\"");
        return "";
    }
    return fs.readFile(out_path);
}

// Run the client once and return its process exit code, discarding any
// downloaded body. Used by the verify-failure leg to distinguish a CLEAN
// verify-rejection (the fixture returns 0 and `http.download` writes no
// file) from an unrelated CRASH (non-zero exit, which also leaves no file):
// the crash must FAIL the test, not masquerade as a rejection the way a
// body-only check would. `dir` travels as `argv[1]`, same as `_client_body`.
// Removes stale output first.
fn _client_exit(client_bin: string, run_env: string[], dir: string) -> i64 ![io] {
    let out_path = dir + "/body.out";
    let _rm = fs.deleteFile(out_path);
    let cexit = process.run_capture([client_bin, dir], run_env);
    report_child_failure_pending("tls-loopback client exit run", cexit);
    return cexit;
}

// Retry `_client_body` a few times to absorb residual server startup
// latency — used only for the POSITIVE round-trip (where a body IS
// expected), never to conclude a negative (an untrusted peer never
// succeeds no matter how many retries).
fn _client_body_retry(client_bin: string, run_env: string[], dir: string) -> string ![clock, io] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 20 { break; }
        let body = _client_body(client_bin, run_env, dir);
        if body.length > 0 { return body; }
        sleep(500);
        attempt = attempt + 1;
    }
    return "";
}

// Renders a downloaded body for a diagnostic print: length plus a bounded
// prefix, so the print stays useful without risking a multi-KB dump.
fn _describe_body(body: string) -> string {
    return "length=" + number_to_string(body.length) + " prefix=\"" + substring(body, 0, 200)
        + "\"";
}

test "tls loopback: native serve ↔ native https client round-trips + verify-failure" ![clock, io, net] {
    // `openssl` generates the self-signed cert; skip cleanly without it (the
    // plain suite still covers the plaintext paths + `make compile` the TLS
    // surface). Mirrors the tool-absent SKIP precedent.
    if !tool_present("openssl") {
        print.info("[tls-loopback] SKIP: openssl CLI not available");
        assert true;
        return;
    }

    let dir = _scratch_dir("sfn-tls-loopback-rt");
    let cert = dir + "/cert.pem";
    let key = dir + "/key.pem";
    // SAN matches the connect host (localhost), so the only reason the
    // untrusted run fails is trust — isolating chain verification.
    assert _gen_cert(dir, "localhost");

    // Build the native TLS server binary up front (synchronous), so the cold
    // compile is not inside the readiness poll window.
    let srv_main = _write_tls_server(dir);
    let srv_bin = _build_bin(srv_main, dir + "/tlssrv-bin");
    assert srv_bin.length > 0;

    // Build the native https client fixture.
    let out_path = dir + "/body.out";
    let cli_main = _write_client(dir, "https://localhost:" + _tls_port_str()
        + "/");
    let cli_bin = _build_bin(cli_main, dir + "/client-bin");
    assert cli_bin.length > 0;

    // Managed explicitly (`start_background`/`stop_background`) rather than
    // through the scoped `with_background` fixture: `with_background`'s own
    // catch drains and DISCARDS the child's streams before rethrowing, so a
    // server that never becomes connectable always reported bare "assertion
    // failed" with no signal from the server side. Draining here on the
    // specific readiness-failure path keeps that signal. `dir` rides as
    // `argv[1]` (see `_write_tls_server`'s header — SFN-1001).
    let server = start_background([srv_bin, dir], _child_env_typed(), "", "tls-loopback-server");
    assert server.handle.handle_id != 0;

    let up = _await_tls_listening();
    if !up {
        let drain = stop_background(server);
        print.info("[tls-loopback] TLS server never became connectable; exit="
            + number_to_string(drain.exit)
            + " stdout=\""
            + substring(drain.stdout, 0, 4096)
            + "\" stderr=\""
            + substring(drain.stderr, 0, 4096)
            + "\"");
    }
    assert up;

    try {
        // SUCCESS leg (acceptance #1): trusted via CAFILE -> the full
        // handshake + request→response cycle round-trips the handler body.
        let body = _client_body_retry(cli_bin, _trusted_env(cert), dir);
        print.info("[tls-loopback] round-trip body: " + _describe_body(body));
        assert body.length > 0;
        assert contains(body, "TLS-RT-OK-7c1e");

        // VERIFY-FAILURE leg (acceptance #2): no CAFILE -> the self-signed cert
        // is not trust-anchored -> chain verification fails -> no body. Require
        // the client to still exit 0 (a clean verify-rejection, since the fixture
        // returns 0 regardless) so an unrelated crash — which would ALSO leave no
        // file — cannot masquerade as a rejection and pass. A single attempt is
        // conclusive (trust cannot appear on retry).
        //
        // This must fail because the cert has no anchor, not because the trust
        // store failed to load anything at all — SFN-807 showed those are not
        // the same failure, and this exact leg kept passing throughout it: a
        // bundle-loading bug that fail-closed to zero anchors produces the
        // identical no-body signal as a correctly rejected untrusted peer.
        // `runtime_tls_ca_bundle_realistic_size_test.sfn` (SFN-813) covers the
        // loader itself so a regression there cannot hide behind this leg again.
        let uexit = _client_exit(cli_bin, _untrusted_env(), dir);
        assert uexit == 0;
        assert ! fs.exists(out_path);
        let _ = stop_background(server);
    } catch (err) {
        // Reap first, then re-throw, so the failing test still fails with
        // its own message rather than a teardown error — mirrors
        // `with_background`'s own catch (SFN-402/SFEP-0050 §5.1).
        let _ = stop_background(server);
        throw err;
    }

    // Best-effort cleanup. The server itself was already killed and reaped
    // above.
    let _rm = process.run(["rm", "-rf", dir]);
}

test "tls loopback: plaintext serve still round-trips (regression guard)" ![clock, io, net] {
    let dir = _scratch_dir("sfn-tls-loopback-plain");

    // Build the native plaintext server binary up front (synchronous).
    let srv_main = _write_plain_server(dir);
    let srv_bin = _build_bin(srv_main, dir + "/plainsrv-bin");
    assert srv_bin.length > 0;

    // Build the native http client fixture (plaintext scheme).
    let out_path = dir + "/body.out";
    let cli_main = _write_client(dir, "http://localhost:" + _plain_port_str()
        + "/");
    let cli_bin = _build_bin(cli_main, dir + "/client-bin");
    assert cli_bin.length > 0;

    // See the TLS test above for why this manages the server explicitly
    // instead of through `with_background`.
    let server = start_background([srv_bin], _child_env_typed(), "", "plain-loopback-server");
    assert server.handle.handle_id != 0;

    let up = _await_plain_listening();
    if !up {
        let drain = stop_background(server);
        print.info("[tls-loopback] plaintext server never became connectable; exit="
            + number_to_string(drain.exit)
            + " stdout=\""
            + substring(drain.stdout, 0, 4096)
            + "\" stderr=\""
            + substring(drain.stderr, 0, 4096)
            + "\"");
    }
    assert up;

    try {
        // Plaintext round-trip still works alongside the TLS surface.
        let body = _client_body_retry(cli_bin, _child_env(), dir);
        print.info("[tls-loopback] plaintext round-trip body: " + _describe_body(body));
        assert body.length > 0;
        assert contains(body, "PLAIN-RT-OK-7c1e");
        let _ = stop_background(server);
    } catch (err) {
        let _ = stop_background(server);
        throw err;
    }

    let _rm = process.run(["rm", "-rf", dir]);
}
