// End-to-end test for issue #394 (M2.1+M2.2): the
// `runtime/sfn/memory/arena.sfn` Sailfin module's `sfn_arena_sfn_*`
// exports actually link into the compiler binary built by
// `make compile`.
//
// Native (no-bash) replacement for the former
// `test_runtime_sfn_sources_active.sh` (test-infra Phase 3, epic #842;
// `.claude/rules/no-bash-e2e.md`). Pins the production link path: when
// `runtime/capsule.toml` declares `sfn-sources = ["sfn/memory/arena.sfn"]`,
// the resulting `build/bin/sfn` binary exports five
// `sfn_arena_sfn_*` symbols sourced from Sailfin emission, plus the bare
// arena-core exports #1309 moved into Sailfin
// (`sfn_arena_create`/`alloc`/`global`/`enabled`), and the surviving bare
// arena forwarders (`realloc`/`print_stats`). The remaining-C assertion
// guards the "C arena still links for the not-yet-ported entry points"
// invariant — a patch that drops them before #822 trips it.
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]`, so
// they cannot be called from an `![io]` test. For subprocess/manifest
// assertions use `sfn/strings` (`find` / `split` / `starts_with` /
// `contains` / `ends_with`), as the runtime_string_basic exemplar does.
import {
    contains,
    ends_with,
    find,
    split,
    starts_with
} from "sfn/strings";
import { clean_runner_env, skip } from "sfn/test";

// The child env is derived by subtraction from the real environment, not
// assembled key by key (SFN-1114).
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

// `[[:space:]][Tt][[:space:]]_?sym$` — a defined text symbol on a line of
// `nm` output (optional `_` prefix accommodates macOS Mach-O). Anchored on
// symbol-end so a substring collision (`sfn_arena_sfn_create_helper`) does
// not satisfy the check, and gated on a defined-text marker (` T `/` t `)
// so an undefined-reference line (`U sfn_arena_sfn_create`) does not falsely
// report the binary as exporting the symbol.
// Locates the compiled runtime-native object for `module` — the bare
// filename a runtime/sfn source module mangles to
// (`sfn__runtime-native__<module>.sfn-<target>-<opt>.o` under
// `build/sailfin/`) — tolerant of the `<target>-<opt>` segment differing
// per host via a prefix match rather than the exact literal name. Returns
// "" when the tree has not been built yet, for the caller to `skip(...)`.
//
// Used in place of `sfn_bin_path()` for a symbol-presence assertion: on a
// native Windows host `lld-link` strips the COFF symbol table from the
// linked PE (`llvm-nm build/bin/sfn.exe` reports "no symbols"), while the
// object files retain it in exactly the `T`/`t` shape `_nm_has_defined`
// already parses. This is not a weakening — this test asserts a symbol is
// Sailfin-DEFINED at the bare name, and an object file answers that MORE
// precisely by naming which object defines it. Whether the symbol survived
// into the link is already guaranteed by the link itself: an unresolved
// symbol fails `lld-link`, so a binary that exists at all has it resolved
// (SFN-1114).
fn _runtime_object(module: string) -> string ![io] {
    let dir = "build/sailfin";
    if !fs.exists(dir) { return ""; }
    let prefix = "sfn__runtime-native__" + module + ".sfn-";
    let entries = fs.listDirectory(dir);
    let mut i = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        if starts_with(name, prefix) && ends_with(name, ".o") {
            return dir + "/" + name;
        }
        i = i + 1;
    }
    return "";
}

// `llvm-nm` rather than `nm` because LLVM is already a hard toolchain
// dependency and reads ELF, Mach-O and COFF uniformly, whereas `nm` is
// absent on a native Windows host (SFN-1114).
fn _nm_has_defined(binary: string, sym: string) -> boolean ![io] {
    let exit = process.run_capture(["llvm-nm", binary], _child_env());
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return false; }
    let lines = split(out, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        let is_text = contains(line, " T ") || contains(line, " t ");
        if is_text && (ends_with(line, " " + sym) || ends_with(line, "_" + sym)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// The literal acceptance check from issue #394: `nm | grep sfn_arena_alloc`
// matches at least one symbol in the compiler binary (substring, any kind).
// `llvm-nm` rather than `nm` (SFN-1114) — see `_nm_has_defined` above.
fn _nm_references(binary: string, sym: string) -> boolean ![io] {
    let exit = process.run_capture(["llvm-nm", binary], _child_env());
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return false; }
    return find(out, sym, 0) >= 0;
}

test "runtime/capsule.toml sfn-sources lists the arena module" ![io] {
    let manifest = fs.readFile("runtime/capsule.toml");
    let lines = split(manifest, "\n");
    let mut in_sources = false;
    let mut found = false;
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "sfn-sources = [") { in_sources = true; }
        if in_sources && contains(line, "\"sfn/memory/arena.sfn\"") {
            found = true;
        }
        if in_sources && contains(line, "]") { in_sources = false; }
        i = i + 1;
    }
    assert found;
}

test "compiler binary exports five sfn_arena_sfn_* Sailfin symbols" ![io] {
    let obj = _runtime_object("arena");
    if obj.length == 0 {
        skip("build/sailfin/sfn__runtime-native__arena.sfn-*.o not found — tree not built yet (SFN-1114)");
    }
    assert _nm_has_defined(obj, "sfn_arena_sfn_create");
    assert _nm_has_defined(obj, "sfn_arena_sfn_alloc");
    assert _nm_has_defined(obj, "sfn_arena_sfn_reset");
    assert _nm_has_defined(obj, "sfn_arena_sfn_destroy");
    assert _nm_has_defined(obj, "sfn_arena_sfn_realloc");
}

test "compiler binary exports bare arena-core (create/alloc/global/enabled) from Sailfin (#1309)" ![io] {
    let obj = _runtime_object("arena");
    if obj.length == 0 {
        skip("build/sailfin/sfn__runtime-native__arena.sfn-*.o not found — tree not built yet (SFN-1114)");
    }
    assert _nm_has_defined(obj, "sfn_arena_create");
    assert _nm_has_defined(obj, "sfn_arena_alloc");
    assert _nm_has_defined(obj, "sfn_arena_global");
    assert _nm_has_defined(obj, "sfn_arena_enabled");
}

test "compiler binary exports surviving bare arena forwarders (realloc/print_stats)" ![io] {
    let obj = _runtime_object("arena");
    if obj.length == 0 {
        skip("build/sailfin/sfn__runtime-native__arena.sfn-*.o not found — tree not built yet (SFN-1114)");
    }
    assert _nm_has_defined(obj, "sfn_arena_realloc");
    assert _nm_has_defined(obj, "sfn_arena_print_stats");
}

test "nm | grep sfn_arena_alloc matches at least one symbol (#394 spec)" ![io] {
    let obj = _runtime_object("arena");
    if obj.length == 0 {
        skip("build/sailfin/sfn__runtime-native__arena.sfn-*.o not found — tree not built yet (SFN-1114)");
    }
    assert _nm_references(obj, "sfn_arena_alloc");
}
