// E2E test for the aarch64 bootstrap's x86_64 binfmt_misc probe
// (`scripts/bootstrap-aarch64-linux.sh`, `x86_64_binfmt_registered`). The
// probe used to hand the whole binfmt_misc directory to one `grep`, so the
// write-only `register` node (mode 0200, no read handler) made grep exit 2
// and `pipefail` turned a successful match into "not registered" — rejecting
// every host where qemu-x86_64 was already enabled in the kernel. These
// fixtures always include a `register` file with mode `000` to regress that.
//
// The script exposes a regression seam: `SAILFIN_BINFMT_PROBE_ONLY=1` runs
// only the probe against `SAILFIN_BINFMT_DIR` and reports the verdict as the
// exit status, before the script's Linux/aarch64 host checks — so it runs on
// any host bash runs on.
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]` and so
// cannot be called from an `![io]` test like this. Assert on captured stdout
// with `sfn/strings::contains` instead.
import { contains } from "sfn/strings";
import { clean_runner_env, clean_runner_env_without, default_scratch_dir } from "sfn/test";

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    return dir;
}

fn _script() -> string ![io] {
    let configured = env.get("SAILFIN_BOOTSTRAP_SCRIPT");
    if configured.length > 0 { return configured; }
    return "scripts/bootstrap-aarch64-linux.sh";
}

// Base child env for the probe, derived by subtraction from the real
// environment (SFN-1114) plus the probe-only seam vars.
fn _child_env(binfmt_dir: string) -> string[] ![io] {
    let mut e = clean_runner_env_without("", ["SAILFIN_BINFMT_DIR", "SAILFIN_BINFMT_PROBE_ONLY"]);
    e.push("SAILFIN_BINFMT_PROBE_ONLY=1");
    e.push("SAILFIN_BINFMT_DIR=" + binfmt_dir);
    return e;
}

// Child env for the `chmod` shell-outs, derived by subtraction (SFN-1114).
fn _plain_env() -> string[] ![io] { return clean_runner_env(""); }

fn _test_root(tag: string) -> string ![io] {
    let dir = fs.mkdtemp(_scratch_dir() + "/binfmt-" + tag + "-");
    // `mkdtemp` returns "" on failure. An empty root would be threaded through
    // as `SAILFIN_BINFMT_DIR=`, silently pointing every case at the host's real
    // binfmt_misc mount and making these assertions host-dependent.
    assert dir.length > 0;
    return dir;
}

// Every fixture carries a write-only `register` node (mode 000, empty
// content) — the exact condition that broke the old whole-directory `grep`
// probe under `pipefail` on a non-root CI runner.
fn _write_register(dir: string) -> void ![io] {
    fs.writeFile(dir + "/register", "");
    let _exit = process.run_capture(["chmod", "000", dir + "/register"], _plain_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
}

fn _probe_exit(binfmt_dir: string) -> int ![io] {
    let exit = process.run_capture(["bash", _script()], _child_env(binfmt_dir));
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    return exit;
}

fn _probe_stdout(binfmt_dir: string) -> string ![io] {
    let _exit = process.run_capture(["bash", _script()], _child_env(binfmt_dir));
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    return out;
}

// Realistic enabled x86_64 entry (as `update-binfmts` would install it).
fn _x86_64_entry() -> string {
    return "enabled\ninterpreter /usr/libexec/qemu-binfmt/x86_64-binfmt-P\nflags: OCF\noffset 0\nmagic 7f454c4602010100000000000000000002003e00\nmask fffffffffffffffcfffffffffffffffffeffffff\n";
}

// Decoy non-x86 entry (a real registration for another interpreter).
fn _decoy_entry() -> string {
    return "enabled\ninterpreter /usr/bin/python3.12\nflags:\noffset 0\nmagic 550a\n";
}

test "aarch64 bootstrap: x86_64 cross wrapper selects LLD" ![io] {
    let source = fs.readFile(_script());
    assert contains(source, "exec \"$NATIVE_CC_PATH\" --target=x86_64-linux-gnu -fuse-ld=lld");
}

test "aarch64 bootstrap: self-host passes do not fetch a native seed" ![io] {
    let source = fs.readFile(_script());
    assert contains(source, "SAILFIN_BOOTSTRAP=off SAILFIN_TARGET_ARCH=aarch64 \\\n\t\trun_x86");
    assert contains(source, "SAILFIN_BOOTSTRAP=off SAILFIN_TARGET_ARCH=aarch64 \\\n\t\t\"$WORK_DIR/pass-1/sfn\" build");

    let workflow = fs.readFile(".github/workflows/ci.yml");
    assert contains(workflow, "build/bin/sfn build --target=aarch64-unknown-linux-gnu");
    assert ! contains(workflow, "cat >build/aarch64-cross/bin/clang");
    assert ! contains(workflow, "cat >build/aarch64-bootstrap/bin/clang");
    assert ! contains(workflow, "readelf -h build/aarch64-cross/pass-1/sfn");
}

test "aarch64 binfmt: enabled x86_64 entry is detected alongside an unreadable register node" ![io] {
    let dir = _test_root("t1");
    fs.writeFile(dir + "/status", "enabled\n");
    fs.writeFile(dir + "/qemu-x86_64", _x86_64_entry());
    fs.writeFile(dir + "/python3.12", _decoy_entry());
    _write_register(dir);

    let out = _probe_stdout(dir);
    assert contains(out, "x86_64 binfmt registration detected");

    let exit = _probe_exit(dir);
    assert exit == 0;
}

test "aarch64 binfmt: a disabled x86_64 entry is not usable" ![io] {
    let dir = _test_root("t2");
    fs.writeFile(dir + "/status", "enabled\n");
    fs.writeFile(dir + "/qemu-x86_64", "disabled\ninterpreter /usr/libexec/qemu-binfmt/x86_64-binfmt-P\nflags: OCF\n");
    _write_register(dir);

    let exit = _probe_exit(dir);
    assert exit == 1;
}

test "aarch64 binfmt: a directory with no x86_64 entry is not usable" ![io] {
    let dir = _test_root("t3");
    fs.writeFile(dir + "/status", "enabled\n");
    fs.writeFile(dir + "/python3.12", _decoy_entry());
    _write_register(dir);

    let exit = _probe_exit(dir);
    assert exit == 1;
}

test "aarch64 binfmt: globally disabled binfmt_misc is not usable" ![io] {
    let dir = _test_root("t4");
    fs.writeFile(dir + "/status", "disabled\n");
    fs.writeFile(dir + "/qemu-x86_64", _x86_64_entry());
    _write_register(dir);

    let exit = _probe_exit(dir);
    assert exit == 1;
}

test "aarch64 binfmt: an entry is matched by its interpreter path" ![io] {
    let dir = _test_root("t5");
    fs.writeFile(dir + "/status", "enabled\n");
    fs.writeFile(dir + "/qemu-foreign", "enabled\ninterpreter /usr/bin/qemu-x86_64-static\nflags: OCF\n");
    _write_register(dir);

    let exit = _probe_exit(dir);
    assert exit == 0;
}
