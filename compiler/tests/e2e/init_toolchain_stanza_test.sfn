// compiler/tests/e2e/init_toolchain_stanza_test.sfn
//
// SFN-167 / SFEP-0046 Phase 1: `sfn init` scaffolds a `[toolchain]` pin
// stamped with the version of the `sfn` doing the scaffolding (the `go mod
// init` `go`-line equivalent). Drives `sfn init` in a fresh dir and asserts
// the generated `capsule.toml` carries a `[toolchain] sfn` pin. Native per
// `.claude/rules/no-bash-e2e.md`: the child cwd is supplied directly to
// `run_capture_cwd`; the assertions are pure `sfn/strings::find` over the
// emitted manifest.
import { find } from "sfn/strings";
import { default_scratch_dir, sfn_bin_abs_path } from "sfn/test";

fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    return e;
}

test "sfn init: scaffolds a [toolchain] pin in the generated capsule.toml" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = default_scratch_dir(); }
    let dir = base + "/sfn-init-toolchain";
    fs.createDirectory(dir, true);

    // Clean slate: `init` refuses to overwrite an existing `capsule.toml`, so
    // a re-run must start fresh. Apply the scratch directory to this child
    // only; no shell or process-global `chdir` is involved.
    let manifest_path = dir + "/capsule.toml";
    let main_path = dir + "/src/main.sfn";
    if fs.exists(manifest_path) { fs.deleteFile(manifest_path); }
    if fs.exists(main_path) { fs.deleteFile(main_path); }
    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "init"], _child_env(), dir);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;

    let manifest = fs.readFile(manifest_path);
    assert find(manifest, "[toolchain]", 0) >= 0;
    assert find(manifest, "sfn =", 0) >= 0;
}
