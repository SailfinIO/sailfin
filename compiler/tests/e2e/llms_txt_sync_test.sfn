// llms.txt drift guard — native replacement for `test_llms_txt_sync.sh`
// (test-infra Phase 3, epic #842; no-bash-e2e ratchet).
//
// llms.txt is the in-context language reference LLM agents read before
// generating Sailfin code — a stale or self-contradictory copy directly
// causes systematic agent errors. This pins the two cheap, mechanical
// freshness invariants the old bash guard pinned:
//
//   1. Single source of truth — site/public/llms.txt is a symlink that
//      resolves to the repo-root llms.txt (exactly one copy).
//   2. Version stamp — the "> Version:" line in llms.txt matches the
//      [capsule] version in compiler/capsule.toml, so every release bump
//      forces an llms.txt review.
//
// Test 1 inspects the symlink with the native `fs.read_link` (SFN-46),
// reading its raw single-hop target directly instead of shelling out to
// `readlink`/`test -L`; content accuracy beyond the version stamp stays
// a review concern (docs/status.md).
//
// NOTE on matchers: `sfn/test`'s `expect_*` matchers are `![pure]` and so
// cannot be called from an `![io]` test like this. Assert on file text
// via `sfn/strings` predicates and `==` instead. (#842.)
import {
    find,
    split,
    starts_with,
    trim
} from "sfn/strings";

fn _repo_root() -> string ![io] {
    let root = env.get("SAILFIN_REPO_ROOT");
    if root.length > 0 { return root; }
    return ".";
}

// The recorded symlink target for `path`, or `""` if there is no link record.
//
// git stores `site/public/llms.txt` with mode `120000` — a symlink — but only
// materializes it as one when `core.symlinks` is true, which needs Developer
// Mode or elevation on Windows and is therefore `false` on an ordinary
// checkout. Where it is false git writes a REGULAR FILE whose entire contents
// are the link target text. The repository invariant is identical in both
// cases and lives in the index either way; only the working-tree shape
// differs, so reading just `fs.read_link` would report a drift that does not
// exist.
//
// This does not soften the guard. A regression that replaced the link with a
// genuine second copy would make these contents the whole of llms.txt, which
// is not the expected target string, so the caller's equality check still
// fails — which is the whole point of comparing against an exact target
// rather than merely checking that something is there.
fn _link_target(path: string) -> string ![io] {
    let native = fs.read_link(path);
    if native.length > 0 { return native; }
    if !fs.exists(path) { return ""; }
    return trim(fs.readFile(path));
}

test "llms.txt: site copy is a symlink to the repo-root llms.txt" ![io] {
    let root = _repo_root();
    let site_copy = root + "/site/public/llms.txt";

    // 1a. A link record must exist — a real symlink, or git's non-symlink
    //     materialization of one. A plain file that is not a link is "".
    let target = _link_target(site_copy);
    assert target.length > 0;

    // 1b. Single-hop raw target must point at the repo-root llms.txt.
    //     `site/public/` -> repo root is exactly two levels up, so the
    //     link stores `../../llms.txt` verbatim (no canonicalization).
    assert target == "../../llms.txt";

    // 1c. Single source of truth: the file the link names really is the
    //     repo-root copy. Where the symlink is materialized, read it THROUGH
    //     the link and require byte-identity — that also proves the link is
    //     not dangling. Where it is not, the working tree holds only the
    //     target text, so there is nothing to dereference and the reachable
    //     claim is that the named file exists; 1b already pinned which file.
    let resolved = root + "/llms.txt";
    assert fs.exists(resolved);
    let root_text = fs.readFile(resolved);
    assert root_text.length > 0;
    if fs.read_link(site_copy).length > 0 {
        let site_text = fs.readFile(site_copy);
        assert site_text == root_text;
    }
}

// Extract the value of the first `version = "..."` line in a TOML file:
// the text between the first pair of double quotes on a `version`-prefixed
// (after trim) line.
fn _capsule_version(toml: string) -> string {
    let lines = split(toml, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = trim(lines[i]);
        if starts_with(line, "version") {
            let q1 = find(line, "\"", 0);
            if q1 >= 0 {
                let q2 = find(line, "\"", q1 + 1);
                if q2 > q1 { return substring(line, q1 + 1, q2); }
            }
        }
        i += 1;
    }
    return "";
}

// Extract the version token from the `> Version: <token>` line in llms.txt.
// The token runs from after `Version:` up to the first space or `|`.
fn _llms_version(text: string) -> string {
    let lines = split(text, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "> Version:") {
            // Slice off the "> Version:" prefix, then trim, then cut at the
            // first space or '|'.
            let rest = trim(substring(line, 10, line.length));
            let mut j = 0;
            loop {
                if j >= rest.length { break; }
                let ch = rest[j];
                if ch == " " || ch == "|" { break; }
                j += 1;
            }
            return substring(rest, 0, j);
        }
        i += 1;
    }
    return "";
}

test "llms.txt: > Version: line matches compiler/capsule.toml" ![io] {
    let root = _repo_root();

    let toml = fs.readFile(root + "/compiler/capsule.toml");
    let llms = fs.readFile(root + "/llms.txt");

    let capsule_version = _capsule_version(toml);
    let llms_version = _llms_version(llms);

    assert capsule_version.length > 0;
    assert llms_version.length > 0;
    assert capsule_version == llms_version;
}
