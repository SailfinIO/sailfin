// compiler/tests/e2e/cross_target_emit_test.sfn
//
// SFN-923: `sfn build --target=<triple>` lowered per-module capsule IR for
// the HOST, not the requested target, because `--target` lives in a
// process-local cell (`compiler/src/build/target_state.sfn`) that a
// per-module emit CHILD process never inherits. Sibling of
// `target_flag_cache_key_test.sfn`, same discipline
// (`clean_runner_env(nested_runner_scratch("<label>"))`, distinct label
// per spawn, no bash).
//
// The original tests pin transport at its narrowest point: `sfn emit
// --target=<triple>` directly. SFN-1117 adds the architecture-axis link
// acceptance on an x86_64 Linux host with an installed aarch64 sysroot. A
// fixture with a `struct` forces `__sfn_type_desc` emission, whose
// `comdat any` group is
// the observable signal `lowering_debug_state.sfn:101-103`'s target-OS gate
// controls (SFN-923's presenting failure was a Windows COFF link dying on
// duplicate `__sfn_type_desc.*` symbols precisely because a child emitted
// them WITHOUT this comdat group).
//
// Test A's contrast forces BOTH sides' target explicitly via
// `SAILFIN_TARGET_OS` rather than leaving either to the host default:
// `clean_runner_env` strips the ambient value first (SFN-925), matching
// `windows_exe_suffix_test.sfn`'s header, precisely so the pushed value is
// the only occurrence. Left to the host default, the "non-Windows" side
// would resolve to Windows too on a native Windows runner — collapsing the
// contrast into comparing Windows against Windows — so this asserts a
// property between two NAMED targets, never between "host" and "Windows".
import { byte_at, free_bytes, read_bytes } from "sfn/fs";
import { contains } from "sfn/strings";
import {
    clean_runner_env,
    nested_runner_scratch,
    report_child_failure,
    sfn_bin_abs_path,
    skip,
    with_tmp_dir
} from "sfn/test";

// A struct forces `__sfn_type_desc` emission (`comdat any` under a Windows
// target), which is the observable signal this file asserts on.
fn _write_fixture(dir: string) -> void ![io] {
    fs.writeFile(dir + "/probe.sfn", "struct Point {\n    x: int;\n    y: int;\n}\nfn main() -> int {\n    let p = Point { x: 1, y: 2 };\n    return p.x;\n}\n");
}

fn _write_aarch64_fixture(dir: string) -> void ![io] {
    fs.writeFile(dir + "/aarch64_probe.sfn", "fn read_perms(path: * u8) -> i64 ![io] {\n"
        + "    return sailfin_intrinsic_fs_get_perms(path);\n"
        + "}\n\n"
        + "fn main() -> int { return 0; }\n");
}

// The Tier-2 cross job provisions these exact glibc/CRT locations before it
// runs this file. Other hosts and ordinary developer machines skip only this
// link acceptance; the target-transport tests above remain universal.
fn _aarch64_cross_toolchain_ready() -> boolean ![io] {
    if !fs.exists("/proc/self/status") { return false; }
    if !fs.exists("/lib64/ld-linux-x86-64.so.2") { return false; }
    if !fs.exists("/lib/ld-linux-aarch64.so.1") { return false; }
    if !fs.exists("/usr/lib/aarch64-linux-gnu/Scrt1.o") { return false; }
    if !fs.exists("/usr/lib/gcc/aarch64-linux-gnu") { return false; }
    let clang_exit = process.run_capture(["clang", "--version"], process.environ());
    let _clang_out = process.capture_take_stdout();
    let _clang_err = process.capture_take_stderr();
    if clang_exit != 0 { return false; }
    let lld_exit = process.run_capture(["ld.lld", "--version"], process.environ());
    let _lld_out = process.capture_take_stdout();
    let _lld_err = process.capture_take_stderr();
    return lld_exit == 0;
}

// Test A (design note §7.2): the flag reaches `sfn emit` directly, with no
// build/link involved. A contrast pair over the same fixture — the
// Linux-target emit must carry NO comdat group, and the Windows-target
// emit must carry at least one. Asserting only the Windows half would pass
// vacuously if `emit` unconditionally emitted a comdat group regardless of
// target; the contrast is what pins the SFN-923 bug (the child previously
// resolved the host target even when told to cross-build). Both targets
// are forced explicitly (see the file header) rather than one of them
// being "whatever this host happens to be."
test "cross-target emit: --target reaches sfn emit and flips the comdat gate" ![io] {
    let sfn = sfn_bin_abs_path();
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        _write_fixture(dir);
        let linux_out = dir + "/linux.ll";
        let win_out = dir + "/win.ll";

        let mut linux_env = clean_runner_env(nested_runner_scratch("cross-target-emit-linux"));
        linux_env.push("SAILFIN_TARGET_OS=Linux");
        let linux_exit = process.run_capture_cwd([sfn, "emit", "--module-name", "probe", "-o", linux_out, "llvm", "probe.sfn"], linux_env, dir);
        let _linux_stdout = process.capture_take_stdout();
        let linux_stderr = process.capture_take_stderr();
        report_child_failure("cross-target-emit linux emit", linux_exit, _linux_stdout, linux_stderr);
        assert linux_exit == 0;
        assert fs.exists(linux_out);
        let linux_ll = fs.readFile(linux_out);
        assert ! contains(linux_ll, "comdat any");

        let win_env = clean_runner_env(nested_runner_scratch("cross-target-emit-win"));
        let win_exit = process.run_capture_cwd([sfn, "emit", "--module-name", "probe", "--target=x86_64-pc-windows-msvc", "-o", win_out, "llvm", "probe.sfn"], win_env, dir);
        let _win_stdout = process.capture_take_stdout();
        let win_stderr = process.capture_take_stderr();
        report_child_failure("cross-target-emit win emit", win_exit, _win_stdout, win_stderr);
        assert win_exit == 0;
        assert fs.exists(win_out);
        let win_ll = fs.readFile(win_out);
        assert contains(win_ll, "comdat any");

        // Silence unused-variable rejects on the retained-for-debugging
        // captures above.
        assert linux_stderr.length >= 0;
        assert win_stderr.length >= 0;
        return 0;
    });
    assert outcome == 0;
}

// Test C (design note §7.2): `sfn emit --target=<bogus>` is rejected with
// `E0614` (the same closed-set check `sfn build --target` enforces),
// exit 2, and no output file. `E0617` (the fail-closed
// target-disagreement guard, `cli/commands/emit.sfn`) is unreachable by
// construction today — `build_target_triple()` always honors the cell
// `set_build_target` just seeded, so it cannot disagree with what was
// just set. This asserts E0617's ABSENCE on a well-formed cross emit
// rather than fabricating a way to trigger it; it is a future-precedence
// guard, not a reachable-today path.
test "cross-target emit: an unsupported --target triple is rejected with E0614, and E0617 never fires" ![io] {
    let sfn = sfn_bin_abs_path();
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        _write_fixture(dir);
        let out = dir + "/bogus.ll";

        let bogus_env = clean_runner_env(nested_runner_scratch("cross-target-emit-bogus"));
        let bogus_exit = process.run_capture_cwd([sfn, "emit", "--module-name", "probe", "--target=bogus-triple", "-o", out, "llvm", "probe.sfn"], bogus_env, dir);
        let _bogus_stdout = process.capture_take_stdout();
        let bogus_stderr = process.capture_take_stderr();
        assert bogus_exit == 2;
        assert contains(bogus_stderr, "error[E0614]");
        assert contains(bogus_stderr, "unsupported --target triple: \"bogus-triple\"");
        assert ! fs.exists(out);

        let win_out = dir + "/win-ok.ll";
        let win_env = clean_runner_env(nested_runner_scratch("cross-target-emit-well-formed"));
        let win_exit = process.run_capture_cwd([sfn, "emit", "--module-name", "probe", "--target=x86_64-pc-windows-msvc", "-o", win_out, "llvm", "probe.sfn"], win_env, dir);
        let _win_stdout = process.capture_take_stdout();
        let win_stderr = process.capture_take_stderr();
        report_child_failure("cross-target-emit well-formed win emit", win_exit, _win_stdout, win_stderr);
        assert win_exit == 0;
        assert ! contains(win_stderr, "E0617");

        return 0;
    });
    assert outcome == 0;
}

test "cross-target emit: aarch64 Linux build emits target IR and an AArch64 ELF" ![io] {
    if !_aarch64_cross_toolchain_ready() {
        skip("aarch64 glibc cross sysroot, clang, or ld.lld unavailable");
        return;
    }

    let sfn = sfn_bin_abs_path();
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        _write_aarch64_fixture(dir);
        let ir = dir + "/aarch64_probe.ll";
        let emit_env = clean_runner_env(nested_runner_scratch("cross-target-emit-aarch64-ir"));
        let emit_exit = process.run_capture_cwd([sfn, "emit", "--module-name", "aarch64_probe", "--target=aarch64-unknown-linux-gnu", "-o", ir, "llvm", "aarch64_probe.sfn"], emit_env, dir);
        let emit_out = process.capture_take_stdout();
        let emit_err = process.capture_take_stderr();
        report_child_failure("cross-target aarch64 emit", emit_exit, emit_out, emit_err);
        assert emit_exit == 0;
        assert fs.exists(ir);
        let llvm_ir = fs.readFile(ir);
        assert contains(llvm_ir, "getelementptr i8, i8* ");
        assert contains(llvm_ir, ", i64 16");
        assert ! contains(llvm_ir, ", i64 24");

        let binary = dir + "/aarch64-probe";
        let work = dir + "/work";
        let build_env = clean_runner_env(nested_runner_scratch("cross-target-emit-aarch64-build"));
        let build_exit = process.run_capture_cwd([sfn, "build", "--target=aarch64-unknown-linux-gnu", "--no-cache", "--work-dir", work, "-o", binary, "aarch64_probe.sfn"], build_env, dir);
        let build_out = process.capture_take_stdout();
        let build_err = process.capture_take_stderr();
        report_child_failure("cross-target aarch64 build", build_exit, build_out, build_err);
        assert build_exit == 0;
        assert fs.exists(binary);

        // ELF64 little-endian header: e_machine is the 16-bit field at
        // offsets 18-19; EM_AARCH64 is 183. Reading bytes in Sailfin keeps
        // the architecture assertion inside the e2e contract rather than a
        // workflow-local `readelf | grep`.
        let bytes = read_bytes(binary);
        assert bytes.status == 0;
        assert bytes.length > 20;
        assert byte_at(bytes, 0) == 127;
        assert byte_at(bytes, 1) == 69;
        assert byte_at(bytes, 2) == 76;
        assert byte_at(bytes, 3) == 70;
        assert byte_at(bytes, 18) == 183;
        assert byte_at(bytes, 19) == 0;
        free_bytes(bytes);
        return 0;
    });
    assert outcome == 0;
}
