// E2E tests for `sfn publish` (argument handling, capsule discovery,
// SFNPKG packaging, digest format, registry resolution).
//
// Native replacement for the former `test_publish.sh` (test-infra Phase 3,
// epic #842). `sfn publish` used to shell out to a system HTTP client;
// SFN-496 replaced that with an in-process HTTP call, so the
// network-dependent cases below no longer intercept anything via a
// PATH-injected fake HTTP client. They instead run
// a small generated `sfn/http` server (`_write_fixture_server`, built once
// via `_ensure_fixture_bin`) as a background subprocess on loopback, point
// `SFN_REGISTRY` at it, and inspect what the fixture records under
// `SFN_FIXTURE_DIR` (`last_path` / `last_body`) after the CLI run
// completes. Reference pattern: `compiler/tests/e2e/serve_loopback_test.sfn`.
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]` and so
// cannot be called from an `![io]` test like this. Assert on the captured
// stdout/stderr text with `sfn/strings` predicates (`find`/`contains`)
// instead. (#842.)
//
// Hermeticity is a file-wide invariant, not a per-test courtesy (SFN-1245):
// no test may inherit a credential, and no test may resolve a registry off
// loopback. `_env_for` strips `SFN_TOKEN` so the first half cannot be
// violated by accident. The second half has no single choke point — the CLI
// falls through to the compiled-in `https://pkg.sfn.dev`
// (`cli/commands/cmd_shared.sfn`) whenever neither `SFN_REGISTRY` nor
// `~/.sfn/config.toml` supplies one — so every test that gets as far as
// packaging pins the registry at the fixture and then asserts the fixture
// recorded the request. A test that reaches packaging without such an
// assertion is publishing to production.
//
// Run semantics: `run_capture` cannot chdir, so the .sh's "cd then run"
// shape is reproduced by passing the capsule dir as an explicit path arg.
// The "uses cwd" case (test 5) is therefore covered by passing the workdir
// as the path arg; the cwd-discovery nuance is exercised equivalently.
import { Env, env_from_current, env_set } from "sfn/os";
import { contains, find, split } from "sfn/strings";
import {
    Background,
    clean_runner_env,
    clean_runner_env_without,
    default_scratch_dir,
    sfn_bin_abs_path,
    sfn_bin_path,
    wait_until,
    with_background
} from "sfn/test";

// True iff `ch` (a 1-char string) is a lowercase-hex digit. String indexing
// + `>=`/`<=` does not compare 1-char strings lexicographically, so route
// through the `char_code` prelude global (the in-tree idiom).
fn _is_hex_char(ch: string) -> boolean {
    let code = char_code(ch);
    if code >= 48 && code <= 57 { return true; }
    if code >= 97 && code <= 102 { return true; }
    return false;
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    return dir;
}

// Base child env, derived by subtraction from the real environment rather
// than a hand-rolled allowlist (SFN-1114). Callers that need HOME / a
// registry override forced use `_env_for` instead.
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

// Per-test scratch subdir under SAILFIN_TEST_SCRATCH (or /tmp).
fn _test_root(tag: string) -> string ![io] {
    let root = _scratch_dir() + "/publish-" + tag;
    fs.createDirectory(root, true);
    return root;
}

// Mirror the .sh `make_capsule`: minimal capsule.toml + src/mod.sfn.
fn _make_capsule(dir: string, name: string, version: string) -> void ![io] {
    fs.createDirectory(dir + "/src", true);
    let toml = "[capsule]\nname = \"" + name + "\"\nversion = \"" + version
        + "\"\n\n[dependencies]\n\n[capabilities]\nrequired = [\"io\"]\n\n[build]\nentry = \"src/mod.sfn\"\n";
    fs.writeFile(dir + "/capsule.toml", toml);
    fs.writeFile(dir + "/src/mod.sfn", "fn hello() -> string {\n    return \"hello\";\n}\n");
}

// Same as `_make_capsule`, but inserts `publish_line` (raw manifest text,
// e.g. `publish = false`) as its own line right after `version = "..."`.
fn _make_capsule_with_publish(dir: string, name: string, version: string, publish_line: string) -> void ![io] {
    fs.createDirectory(dir + "/src", true);
    let toml = "[capsule]\nname = \"" + name + "\"\nversion = \"" + version
        + "\"\n"
        + publish_line
        + "\n\n[dependencies]\n\n[capabilities]\nrequired = [\"io\"]\n\n[build]\nentry = \"src/mod.sfn\"\n";
    fs.writeFile(dir + "/capsule.toml", toml);
    fs.writeFile(dir + "/src/mod.sfn", "fn hello() -> string {\n    return \"hello\";\n}\n");
}

// Write `<home>/.sfn/credentials` with the fake token, as the .sh does.
fn _write_credentials(home: string) -> void ![io] {
    fs.createDirectory(home + "/.sfn", true);
    fs.writeFile(home + "/.sfn/credentials", "fake-token\n");
}

// Build a child env with HOME forced to `home` and any extra `KEY=value`
// entries appended (this file only ever passes SFN_REGISTRY). `HOME` and
// `SFN_REGISTRY` are named to `clean_runner_env_without` because this helper
// goes on to push its own, so an inherited entry earlier in the array cannot
// shadow the caller's push (SFN-1114). `SFN_TOKEN` is stripped and never
// re-pushed: an inherited developer credential would defeat the no-token
// tests' premise and would otherwise be transmitted to whatever registry the
// child resolves (SFN-1245).
fn _env_for(home: string, extra: string[]) -> string[] ![io] {
    let mut e = clean_runner_env_without(env.get("SAILFIN_TEST_SCRATCH"), ["HOME", "SFN_REGISTRY", "SFN_TOKEN"]);
    e.push("HOME=" + home);
    let mut i = 0;
    loop {
        if i >= extra.length { break; }
        e.push(extra[i]);
        i += 1;
    }
    return e;
}

fn _contains_usage(text: string) -> bool {
    return contains(text, "usage") || contains(text, "Usage");
}

// First line of a captured file's content (drops the trailing newline the
// shim's `echo` appends, plus anything after it).
fn _first_line(text: string) -> string {
    let lines = split(text, "\n");
    if lines.length == 0 { return text; }
    return lines[0];
}

// ── Fixture registry server (SFN-496) ──────────────────────────────
//
// A generated `sfn/http` capsule, built once and run as a background
// subprocess on loopback. `handle` records every request's path and body
// under `SFN_FIXTURE_DIR` (set per-test), and can be told to answer with a
// 400 (marker file `status400`). Port is fixed: this is the sole publish
// e2e file binding it, so it does not collide under `--jobs N`.
fn _fixture_port() -> string { return "18920"; }

fn _fixture_app_root() -> string { return "build/publish-e2e-fixture-server"; }

fn _fixture_bin_path() -> string {
    return _fixture_app_root() + "/server-bin";
}

fn _write_fixture_server() -> string ![io] {
    let root = _fixture_app_root();
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/publish-e2e-fixture-server\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"sfn publish e2e fixture registry\"\n"
        + "\n"
        + "[dependencies]\n"
        + "\"sfn/http\" = \"*\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", "import { serve, Request, Response } from \"sfn/http\";\n"
        + "\n"
        + "fn handle(req: Request) -> Response ![io] {\n"
        + "    if strings_equal(req.path, \"/probe\") {\n"
        + "        return Response { status: 200, headers: [], body: \"ready\" };\n"
        + "    }\n"
        + "    let dir = env.get(\"SFN_FIXTURE_DIR\");\n"
        + "    if dir.length > 0 {\n"
        + "        fs.writeFile(dir + \"/last_path\", req.path);\n"
        + "        fs.writeFile(dir + \"/last_body\", req.body);\n"
        + "        if fs.exists(dir + \"/status400\") {\n"
        + "            return Response { status: 400, headers: [], body: \"{\\\"error\\\":\\\"Digest mismatch: expected sha256:abc, got sha256:def\\\"}\" };\n"
        + "        }\n"
        + "        if fs.exists(dir + \"/index.json\") {\n"
        + "            return Response { status: 200, headers: [], body: fs.readFile(dir + \"/index.json\") };\n"
        + "        }\n"
        + "    }\n"
        + "    return Response { status: 200, headers: [], body: \"{\\\"ok\\\":true}\" };\n"
        + "}\n"
        + "\n"
        + "fn main() -> int ![io, net] {\n"
        + "    serve(handle as * fn (Request) -> Response, "
        + _fixture_port()
        + ");\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

// Full parent environment: the nested build LINKS a binary (clang + ld),
// which needs the toolchain surface beyond PATH/HOME/TMPDIR
// (`.claude/rules/no-bash-e2e.md`).
fn _fixture_build_env() -> string[] ![io] { return process.environ(); }

fn _build_fixture_bin(main_path: string, bin: string) -> string ![io] {
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", bin, main_path], _fixture_build_env());
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if exit != 0 { return ""; }
    return bin;
}

// Build the fixture server binary once and reuse it across every test in
// this file. Returns the binary path, or "" on a build failure.
fn _ensure_fixture_bin() -> string ![io] {
    let bin = _fixture_bin_path();
    if fs.exists(bin) { return bin; }
    let main_path = _write_fixture_server();
    return _build_fixture_bin(main_path, bin);
}

// Typed env for the backgrounded fixture server: the full parent
// environment plus `SFN_FIXTURE_DIR` pointed at this test's own recording
// directory (so no state leaks between tests).
fn _fixture_env(fixture_dir: string) -> Env ![io] {
    return env_set(env_from_current(), "SFN_FIXTURE_DIR", fixture_dir);
}

// Poll `GET /probe` until the prebuilt fixture server answers.
fn _await_fixture_ready() -> boolean ![clock, io, net] {
    return wait_until(fn () -> boolean {
        return http.get_body("http://127.0.0.1:" + _fixture_port() + "/probe").length > 0;
    }, 45000, 500);
}

// ---- Test 1: publish with too many args shows usage ----
test "publish: too many args shows usage" ![io] {
    let root = _test_root("t1");
    let home = root + "/home";
    fs.createDirectory(home, true);
    let e = _env_for(home, []);
    let _exit = process.run_capture([sfn_bin_path(), "publish", "a", "b"], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert _contains_usage(out + err);
}

// ---- Test 2: publish with no capsule.toml fails ----
test "publish: no capsule.toml fails" ![io] {
    let root = _test_root("t2");
    let home = root + "/home";
    let workdir = root + "/work";
    fs.createDirectory(workdir, true);
    _write_credentials(home);
    let e = _env_for(home, []);
    // run_capture cannot chdir; pass the empty workdir as the path arg so
    // discovery looks there and finds no capsule.toml.
    let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    // SFN-732: failure diagnostics belong on stderr, so `2>/dev/null`
    // suppresses them and a caller parsing stdout never sees one.
    assert contains(err, "no capsule.toml found");
    assert ! contains(out, "no capsule.toml found");
}

// ---- Test 3: publish with path arg finds capsule.toml ----
test "publish: path arg finds capsule" ![clock, io, net] {
    let root = _test_root("t3");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule(workdir + "/my/capsule", "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir
            + "/my/capsule"], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        assert contains(out + err, "packaging test/pkg@1.0.0");
        return 0;
    });
    // Proves the POST landed on the loopback fixture, not the default registry.
    let last_path = fixture_dir + "/last_path";
    assert fs.exists(last_path);
    assert _first_line(fs.readFile(last_path)) == "/api/publish";
}

// ---- Test 4: publish with trailing-slash path still works ----
test "publish: trailing-slash path works" ![clock, io, net] {
    let root = _test_root("t4");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule(workdir + "/cap", "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir
            + "/cap/"], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        assert contains(out + err, "packaging test/pkg@1.0.0");
        return 0;
    });
    // Proves the POST landed on the loopback fixture, not the default registry.
    let last_path = fixture_dir + "/last_path";
    assert fs.exists(last_path);
    assert _first_line(fs.readFile(last_path)) == "/api/publish";
}

// ---- Test 5: publish without path uses cwd ----
// run_capture cannot chdir, so the cwd-discovery semantics are exercised by
// passing the capsule dir as an explicit path arg.
test "publish: discovers capsule (cwd semantics)" ![clock, io, net] {
    let root = _test_root("t5");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule(workdir, "my/cap", "2.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        assert contains(out + err, "packaging my/cap@2.0.0");
        return 0;
    });
    // Proves the POST landed on the loopback fixture, not the default registry.
    let last_path = fixture_dir + "/last_path";
    assert fs.exists(last_path);
    assert _first_line(fs.readFile(last_path)) == "/api/publish";
}

// ---- Test 6: publish with no token fails ----
test "publish: no token fails" ![io] {
    let root = _test_root("t6");
    let home = root + "/home";
    let workdir = root + "/work";
    fs.createDirectory(home, true);
    _make_capsule(workdir, "test/pkg", "1.0.0");
    // No credentials written, and `_env_for` strips any inherited SFN_TOKEN
    // (SFN-1245) so a developer's own token cannot defeat the guard.
    let e = _env_for(home, []);
    let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert contains(out + err, "no auth token found");
    // No packaging means no POST was attempted.
    assert ! contains(out + err, "packaging");
}

// ---- Test 7: digest in payload has sha256: prefix ----
test "publish: digest has sha256: prefix" ![clock, io, net] {
    let root = _test_root("t7");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule(workdir, "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let _o = process.capture_take_stdout();
        let _err = process.capture_take_stderr();
        return 0;
    });
    let captured = fixture_dir + "/last_body";
    assert fs.exists(captured);
    let body = fs.readFile(captured);
    // The code prepends "sha256:" to the hex digest. Assert the literal
    // prefix is present and that a 64-ish hex run follows it.
    let prefix = "\"digest\":\"sha256:";
    assert contains(body, prefix);
    let at = find(body, prefix, 0);
    assert at >= 0;
    let start = at + prefix.length;
    // Count contiguous lowercase-hex chars after the prefix.
    let mut n = 0;
    loop {
        let idx = start + n;
        if idx >= body.length { break; }
        let ch = substring(body, idx, idx + 1);
        if !_is_hex_char(ch) { break; }
        n += 1;
    }
    assert n >= 64;
}

// ---- Test 8: SFNPKG paths are relative even with a path arg ----
// The body carries base64 `content_b64`; rather than base64-decode in sfn we
// assert the captured body contains `content_b64` (the payload field), and
// that the surrounding publish output earlier showed the relative packaging
// path. (Acceptable simplification — a full base64 decode would require
// shelling out; the relative-path invariant is covered by the packaging
// message and the field's presence.)
test "publish: payload carries content_b64 with relative packaging" ![clock, io, net] {
    let root = _test_root("t8");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule(workdir + "/nested/cap", "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir
            + "/nested/cap"], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        // The packaging message proves the capsule was discovered via the path.
        assert contains(out + err, "packaging test/pkg@1.0.0");
        return 0;
    });
    let captured = fixture_dir + "/last_body";
    assert fs.exists(captured);
    let body = fs.readFile(captured);
    assert contains(body, "content_b64");
}

// ---- Test 9: publish surfaces HTTP error details ----
test "publish: surfaces HTTP error details" ![clock, io, net] {
    let root = _test_root("t9");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    fs.writeFile(fixture_dir + "/status400", "1");
    _write_credentials(home);
    _make_capsule(workdir, "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        let all = out + err;
        assert contains(all, "HTTP 400");
        assert contains(all, "Digest mismatch");
        return 0;
    });
    // The 400 is only producible by the fixture's `status400` branch, but
    // assert the recording too: the header's invariant is that every test
    // reaching packaging proves where its request landed.
    let last_path = fixture_dir + "/last_path";
    assert fs.exists(last_path);
    assert _first_line(fs.readFile(last_path)) == "/api/publish";
}

// ---- Test 10: publish uses default registry when none configured ----
//
// Deleted (SFN-496): the old fake HTTP-client shim intercepted every
// request, so exercising the *default* registry cost nothing. The in-process HTTP
// client has no shim to intercept — driving this case for real would send a
// live publish POST to the production registry `https://pkg.sfn.dev`. The
// default-resolution claim is already covered without any network access by
// `compiler/tests/e2e/config_test.sfn`'s "config: get returns default when
// unset" test, which asserts the default resolves to
// `https://pkg.sfn.dev`.
// ---- Test 11: publish uses registry from config file ----
test "publish: config-file registry URL" ![clock, io, net] {
    let root = _test_root("t11");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    fs.writeFile(home + "/.sfn/config.toml", "[registry]\nurl = \"http://127.0.0.1:"
        + _fixture_port()
        + "\"\n");
    _make_capsule(workdir, "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, []);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let _o = process.capture_take_stdout();
        let _err = process.capture_take_stderr();
        return 0;
    });
    let last_path = fixture_dir + "/last_path";
    assert fs.exists(last_path);
    assert _first_line(fs.readFile(last_path)) == "/api/publish";
}

// ---- Test 12: SFN_REGISTRY env var overrides config file ----
test "publish: SFN_REGISTRY env overrides config" ![clock, io, net] {
    let root = _test_root("t12");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    fs.writeFile(home + "/.sfn/config.toml", "[registry]\nurl = \"http://127.0.0.1:9\"\n");
    _make_capsule(workdir, "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let _o = process.capture_take_stdout();
        let _err = process.capture_take_stderr();
        return 0;
    });
    let last_path = fixture_dir + "/last_path";
    // The server recording a request at all (rather than the config file's
    // unreachable http://127.0.0.1:9) proves the env var won.
    assert fs.exists(last_path);
    assert _first_line(fs.readFile(last_path)) == "/api/publish";
}

// ---- Test 13: SFN_REGISTRY strips trailing slash ----
test "publish: SFN_REGISTRY strips trailing slash" ![clock, io, net] {
    let root = _test_root("t13");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule(workdir, "test/pkg", "1.0.0");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()
            + "/"]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let _o = process.capture_take_stdout();
        let _err = process.capture_take_stderr();
        return 0;
    });
    let last_path = fixture_dir + "/last_path";
    assert fs.exists(last_path);
    // Exactly "/api/publish" — NOT "//api/publish" — is precisely the
    // trailing-slash claim.
    assert _first_line(fs.readFile(last_path)) == "/api/publish";
}

// ---- SFEP-0020 §3.6 / SFN-714: [capsule] publish = false private-capsule
// gate. The gate sits between manifest-name resolution and credential
// discovery / packaging / registry upload, so it must reject before any of
// those side effects regardless of how the capsule was discovered. ----
// ---- Test 14: private capsule is rejected before credential discovery ----
test "publish: private capsule is rejected before credential discovery" ![io] {
    let root = _test_root("t14");
    let home = root + "/home";
    let workdir = root + "/work";
    fs.createDirectory(home, true);
    // No credentials written, and SFN_TOKEN omitted: without the gate this
    // run would fail on the missing token instead of the private-capsule
    // rejection. Asserting the token message's absence is the ordering proof.
    _make_capsule_with_publish(workdir, "private/cap", "1.0.0", "publish = false");
    let e = _env_for(home, []);
    let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let all = out + err;
    assert _exit != 0;
    assert contains(all, "private/cap");
    assert contains(all, "is private and cannot be published");
    assert ! contains(all, "no auth token found");
    assert ! contains(all, "packaging");
    assert contains(all, "E0612");
    // SFN-732: the refusal is a diagnostic, so it lands on stderr only.
    assert contains(err, "E0612");
    assert ! contains(out, "E0612");
}

// ---- Test 15: private capsule makes no network call ----
test "publish: private capsule makes no network call" ![clock, io, net] {
    let root = _test_root("t15");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule_with_publish(workdir, "private/cap", "1.0.0", "publish = false");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        let all = out + err;
        assert _exit != 0;
        assert contains(all, "is private and cannot be published");
        assert ! contains(all, "packaging");
        return 0;
    });
    // The fixture server never recorded a request: with no system client
    // in the loop, the gate still blocked before any HTTP call reached the
    // wire.
    assert ! fs.exists(fixture_dir + "/last_path");
}

// ---- Test 16: registry override cannot bypass the private gate ----
test "publish: registry override cannot bypass the private gate" ![clock, io, net] {
    let root = _test_root("t16");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    _make_capsule_with_publish(workdir, "private/cap", "1.0.0", "publish = false");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        let all = out + err;
        assert _exit != 0;
        assert contains(all, "is private and cannot be published");
        assert ! contains(all, "packaging");
        return 0;
    });
    // Pointing the override at a real, reachable server (rather than the
    // old unreachable 127.0.0.1:9) makes the "no call happened" proof
    // strictly stronger: if the gate failed, the server would have
    // recorded the request.
    assert ! fs.exists(fixture_dir + "/last_path");
}

// ---- Test 17: cwd discovery cannot bypass the private gate ----
// run_capture (two-arg form) cannot chdir, so this exercises the no-path
// codepath via `sh -c "cd ... && exec ..."` instead, which requires an
// absolute binary path since the shell has already changed directory.
test "publish: cwd discovery cannot bypass the private gate" ![io] {
    let root = _test_root("t17");
    let home = root + "/home";
    let workdir = root + "/work";
    _write_credentials(home);
    _make_capsule_with_publish(workdir, "private/cap", "1.0.0", "publish = false");
    let bin = sfn_bin_abs_path();
    let e = _env_for(home, []);
    let _exit = process.run_capture(["sh", "-c", "cd '" + workdir
        + "' && exec '"
        + bin
        + "' publish"], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let all = out + err;
    assert _exit != 0;
    assert contains(all, "private/cap");
    assert contains(all, "is private and cannot be published");
}

