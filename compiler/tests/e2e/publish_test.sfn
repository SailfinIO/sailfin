// ---- Test 20: invalid publish value is a manifest error ----
test "publish: invalid publish value is a manifest error" ![clock, io, net] {
    let root = _test_root("t20");
    let home = root + "/home";
    let workdir = root + "/work";
    let fixture_dir = root + "/fixture";
    fs.createDirectory(fixture_dir, true);
    _write_credentials(home);
    // A quoted string must not be coerced to either boolean.
    _make_capsule_with_publish(workdir, "test/pkg", "1.0.0", "publish = \"false\"");
    let bin = _ensure_fixture_bin();
    assert bin.length > 0;
    let _served = with_background([bin], _fixture_env(fixture_dir), "", "publish-fixture", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_fixture_ready();
        let e = _env_for(home, ["SFN_REGISTRY=http://127.0.0.1:" + _fixture_port()]);
        let _exit = process.run_capture([sfn_bin_path(), "publish", workdir], e);
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        let all = out + err;
        assert _exit != 0;
        assert contains(all, "manifest error");
        assert ! contains(all, "packaging");
        return 0;
    });
    assert ! fs.exists(fixture_dir + "/last_path");
}

// ---- Test 21: the compiler's own manifest reaches the private gate ----
test "publish: compiler capsule is rejected before credential discovery" ![io] {
    let root = _test_root("t21");
    let home = root + "/home";
    fs.createDirectory(home, true);
    // The real compiler manifest must reach E0612 before an empty HOME can
    // trigger credential discovery or packaging.
    let e = _env_for(home, []);
    let _exit = process.run_capture([sfn_bin_path(), "publish", "compiler"], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let all = out + err;
    assert _exit != 0;
    assert contains(all, "sfn/compiler");
    assert contains(all, "is private and cannot be published");
    assert contains(all, "E0612");
    assert ! contains(all, "no auth token found");
    assert ! contains(all, "packaging");
}
