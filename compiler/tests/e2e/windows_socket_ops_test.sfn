// compiler/tests/e2e/windows_socket_ops_test.sfn
//
// SFN-671: pins the emitted surface of BOTH halves of the
// `platform/socket_ops.sfn` / `socket_ops_windows.sfn` sibling pair.
//
// Why this can run on a Linux host: `sfn emit` takes an explicit module
// path, so the Windows sibling can be emitted and inspected anywhere —
// only the LINK needs a Windows target. That makes the Windows half of
// this fix assertable on ordinary CI instead of waiting for the native
// Windows leg (SFN-668 / SFN-55).
//
// What is NOT covered here, stated plainly: that `closesocket` actually
// disposes of a handle, and that `WSAStartup` actually enables socket
// creation, are runtime behaviours no Linux runner can observe. Those
// were verified directly against Win32 while developing this change —
// a C program calling `WSAStartup` + `socket` + `close((int)s)` exits
// `0xC0000409` at the `close`, and the same program using `closesocket`
// exits 0. This test pins the two things a Linux host CAN prove: that
// the Windows module reaches for the right symbols, and that the POSIX
// module does not reach for the fatal one.
import { contains, split, starts_with } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch, with_tmp_dir } from "sfn/test";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

// True iff `ir` has a module-scope `declare` for exactly `@sym(`. The
// trailing paren makes this an exact-symbol test: `@close(` does not
// match `@closesocket(` or `@fclose(`, which is the whole point of the
// negative assertions below.
fn _has_declare(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "declare ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i += 1;
    }
    return false;
}

// True iff some line of `ir` contains both `needle_a` and `needle_b`.
// Matching on line content rather than a full-line string (with its
// compiler-assigned SSA register numbers) keeps the SFN-927 IR-literal
// assertions below from breaking on an unrelated change to this module
// that shifts `%tN` numbering.
fn _line_has_both(ir: string, needle_a: string, needle_b: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if contains(line, needle_a) && contains(line, needle_b) { return true; }
        i += 1;
    }
    return false;
}

// How many lines of `ir` contain both needles.
//
// The count matters, not just presence: these modules sign-extend in more
// than one function, and a presence check is satisfied by any single
// surviving site. `fd_io_windows.sfn` sign-extends in both `sfn_fd_read`
// and `sfn_fd_write`, so dropping the `sext` from the read half alone —
// the memory-unsafe path, feeding `io.sfn`'s `got <= 0` guard and the
// `memset` that overran by ~4 GiB before SFN-927 — would leave the write
// half's `sext` holding a presence assertion green. `socket_ops_windows`
// is weaker still at three sites (`recv`, `send`, and the timeout
// readback), where `readback` alone would mask both socket halves.
//
// Asserting an exact count also fails loudly when a fourth site appears,
// which is the right direction: a new sign-extending function should
// force a deliberate look at this pin rather than inherit its coverage.
fn _count_lines_with_both(ir: string, needle_a: string, needle_b: string) -> int {
    let lines = split(ir, "\n");
    let mut i: int = 0;
    let mut found: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if contains(line, needle_a) && contains(line, needle_b) { found += 1; }
        i += 1;
    }
    return found;
}

// Same shape as `_has_declare` but for a module-scope `define`. The two
// are NOT interchangeable: a bare `contains(ir, "@sym(")` is satisfied
// by a forward `declare`, so a module that only declared the pair would
// pass a containment check while defining nothing.
fn _has_define(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i: int = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "define ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i += 1;
    }
    return false;
}

fn _emit(tag: string, module_path: string, dir: string) -> string ![io] {
    let outpath = dir + "/" + tag + ".ll";
    let exit = process.run_capture([_sfn_bin(), "emit", "-o", outpath, "llvm", module_path], clean_runner_env(nested_runner_scratch(tag)));
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return "EMIT_FAILED"; }
    return fs.readFile(outpath);
}

test "socket-ops: the Windows sibling reaches for Winsock, never POSIX close" ![io] {
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let ir = _emit("sockwin", "runtime/sfn/platform/socket_ops_windows.sfn", dir);
        assert ir != "EMIT_FAILED";
        // The two symbols the whole fix exists to reach.
        assert _has_declare(ir, "closesocket");
        assert _has_declare(ir, "WSAStartup");
        // The fatal one must be absent. `@close(` cannot match
        // `@closesocket(`, so this is a real assertion and not a
        // tautology satisfied by the line above.
        assert ! _has_declare(ir, "close");
        return 0;
    });
    assert outcome == 0;
}

test "socket-ops: the POSIX module keeps close and never links Winsock" ![io] {
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let ir = _emit("sockposix", "runtime/sfn/platform/socket_ops.sfn", dir);
        assert ir != "EMIT_FAILED";
        assert _has_declare(ir, "close");
        assert _has_declare(ir, "socket");
        // Linux and macOS have no ws2_32 to resolve these against, so
        // leaking either into the POSIX module would break every
        // non-Windows link — the identity half of the contract (#1112).
        assert ! _has_declare(ir, "closesocket");
        assert ! _has_declare(ir, "WSAStartup");
        return 0;
    });
    assert outcome == 0;
}

// Both halves must define the same six symbols, or the swap produces a
// link with an unresolved reference on whichever target loses. This is
// the contract `target_condition_runtime_sfn_sources` depends on and
// that no type checker enforces across a module swap.
test "socket-ops: both siblings define the same exported surface" ![io] {
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let posix = _emit("sockposix2", "runtime/sfn/platform/socket_ops.sfn", dir);
        let win = _emit("sockwin2", "runtime/sfn/platform/socket_ops_windows.sfn", dir);
        assert posix != "EMIT_FAILED";
        assert win != "EMIT_FAILED";
        assert _has_define(posix, "sfn_socket_open");
        assert _has_define(posix, "sfn_socket_close");
        assert _has_define(posix, "sfn_socket_set_timeouts");
        assert _has_define(posix, "sfn_socket_recv");
        assert _has_define(posix, "sfn_socket_send");
        assert _has_define(posix, "sfn_socket_timeout_readback_ms");
        assert _has_define(win, "sfn_socket_open");
        assert _has_define(win, "sfn_socket_close");
        assert _has_define(win, "sfn_socket_set_timeouts");
        assert _has_define(win, "sfn_socket_recv");
        assert _has_define(win, "sfn_socket_send");
        assert _has_define(win, "sfn_socket_timeout_readback_ms");
        return 0;
    });
    assert outcome == 0;
}

// SFN-927 defect 2, pinned statically: Winsock's `recv`/`send` are `int`
// (32-bit), not POSIX's `ssize_t` (64-bit). A caller-side `-> i64` extern
// against the Windows symbol reads a `-1` error back as `4294967295`
// instead of a negative value, which silently defeats every `if n < 0`
// guard in the adapters. This is checkable without running anything —
// `sfn emit` prints the raw extern declaration widths — so it is
// host-independent and catches a regression on any CI runner, including
// a Windows one, unlike the earlier "issue a live request" style
// coverage this bug slipped through (nothing in CI makes an outbound
// request from a Windows binary).
test "socket-ops: the Windows sibling declares 32-bit recv/send, the POSIX sibling 64-bit" ![io] {
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let win = _emit("sockwin3", "runtime/sfn/platform/socket_ops_windows.sfn", dir);
        let posix = _emit("sockposix3", "runtime/sfn/platform/socket_ops.sfn", dir);
        assert win != "EMIT_FAILED";
        assert posix != "EMIT_FAILED";
        assert contains(win, "declare i32 @recv(");
        assert contains(win, "declare i32 @send(");
        assert ! contains(win, "declare i64 @recv(");
        assert ! contains(win, "declare i64 @send(");
        assert contains(posix, "declare i64 @recv(");
        assert contains(posix, "declare i64 @send(");
        // The narrowed declaration is useless without a genuine `sext` back
        // to i64 (a `zext` would still turn Winsock's `-1` into a large
        // positive number). `core_cast_lowering.sfn` selects `sext` for a
        // signed `i32 -> i64` widening today; this pins that the emitted
        // body actually does, so a regression in that selector (not just
        // the declared width) fails here instead of passing silently
        // because these assertions never looked inside the function body.
        //
        // Counted, not merely present: this module sign-extends in three
        // places — `sfn_socket_recv`, `sfn_socket_send`, and
        // `sfn_socket_timeout_readback_ms`. A presence check is satisfied
        // by any one of them, so both socket halves could lose their
        // `sext` while the readback alone kept the assertion green.
        assert _count_lines_with_both(win, "sext i32", "to i64") == 3;
        return 0;
    });
    assert outcome == 0;
}

// SFN-927 defect 1, pinned statically: Winsock's `SO_RCVTIMEO`/
// `SO_SNDTIMEO` optval is a 4-byte millisecond DWORD, not a 16-byte
// POSIX `struct timeval`. The Windows sibling must convert seconds to
// milliseconds (`secs * 1000`) and pass a 4-byte optlen; the POSIX
// sibling must keep passing the unconverted seconds count with a
// 16-byte optlen. Checking the emitted IR literals is a host-independent
// substitute for a live `getsockopt` readback, which would require
// actually running the compiled Windows binary — not possible on the
// Linux-only CI fleet this suite runs on.
test "socket-ops: the Windows sibling converts seconds to a millisecond DWORD" ![io] {
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let win = _emit("sockwin4", "runtime/sfn/platform/socket_ops_windows.sfn", dir);
        let posix = _emit("sockposix4", "runtime/sfn/platform/socket_ops.sfn", dir);
        assert win != "EMIT_FAILED";
        assert posix != "EMIT_FAILED";
        // secs -> ms, and a 4-byte DWORD optlen on both SO_RCVTIMEO/SO_SNDTIMEO calls.
        assert contains(win, "mul i32 %secs, 1000");
        assert _line_has_both(win, "i32 65535, i32 4102", "i32 4)");
        assert _line_has_both(win, "i32 65535, i32 4101", "i32 4)");
        // The POSIX sibling keeps the unconverted `struct timeval` shape:
        // no ms conversion, 16-byte optlen throughout.
        assert ! contains(posix, "mul i32 %secs, 1000");
        assert _line_has_both(posix, "i32 1, i32 20", "i32 16)");
        assert _line_has_both(posix, "i32 1, i32 21", "i32 16)");
        return 0;
    });
    assert outcome == 0;
}

// SFN-927's generic-fd counterpart to the two tests above, for the
// `platform/fd_io.sfn` / `fd_io_windows.sfn` pair `io.sfn`/`assert.sfn`
// route through. Content pins, not just plumbing: `fd_io_windows.sfn`
// declaring the UCRT's `_read`/`_write` at the wrong (64-bit) width is a
// memory-unsafety regression nothing else in this suite catches — no
// Windows CI leg runs `sfn test`, and `cross_windows_runtime_modules_test.sfn`
// only proves the manifest/Makefile agree the sibling is swapped in, not
// what the sibling's body contains.
test "fd-io: the Windows sibling declares 32-bit _read/_write and sign-extends; the POSIX sibling 64-bit read/write" ![io] {
    let outcome = with_tmp_dir(fn (dir: string) -> int {
        let win = _emit("fdiowin", "runtime/sfn/platform/fd_io_windows.sfn", dir);
        let posix = _emit("fdioposix", "runtime/sfn/platform/fd_io.sfn", dir);
        assert win != "EMIT_FAILED";
        assert posix != "EMIT_FAILED";
        assert contains(win, "declare i32 @_read(");
        assert contains(win, "declare i32 @_write(");
        assert ! contains(win, "declare i64 @_read(");
        assert ! contains(win, "declare i64 @_write(");
        // The Windows sibling must never fall back to the un-underscored
        // POSIX names: `read`/`write` are not what the UCRT exports them
        // as, and `_has_declare`'s exact-symbol match means "read" would
        // NOT be satisfied by a stray "_read" substring, so this is a
        // real assertion.
        assert ! _has_declare(win, "read");
        assert ! _has_declare(win, "write");
        assert contains(posix, "declare i64 @read(");
        assert contains(posix, "declare i64 @write(");
        // Same sign-extension pin as the socket pair above (W2): the
        // narrowed declaration alone does not restore the negative-error
        // signal without a genuine `sext`. Counted, not merely present —
        // both `sfn_fd_read` and `sfn_fd_write` must sign-extend, and a
        // presence check would stay green if only the read half (the
        // memory-unsafe path) lost its `sext`.
        assert _count_lines_with_both(win, "sext i32", "to i64") == 2;
        return 0;
    });
    assert outcome == 0;
}
