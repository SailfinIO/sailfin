// SFN-775 / SFEP-0068 native cross-target source-of-truth guard.
//
// The former test compared `runtime/capsule.toml` with the root Makefile's
// duplicated `RUNTIME_MODS` shell list. Neither that list nor the Makefile
// still exists (SFN-60): the runtime provider declares its MinGW differences
// once and the native driver consumes them.
// These static contracts keep production manifest ownership explicit without
// recreating a second target table in test code.
import { contains } from "sfn/strings";
import { expect_contains_str, expect_eq_bool } from "sfn/test";

test "cross-windows runtime policy is manifest-owned" ![io] {
    let manifest = fs.readFile("runtime/capsule.toml");
    let conditioner = fs.readFile("compiler/src/build/runtime_objs.sfn");
    let target = fs.readFile("compiler/src/build/target.sfn");

    assert expect_contains_str(manifest, "[targets.x86_64-w64-mingw32]").ok;
    assert expect_contains_str(manifest, "sfn-sources-replace").ok;
    assert expect_contains_str(manifest, "sfn-sources-add").ok;
    assert expect_contains_str(manifest, "link-libs-add = [\"-lbcrypt\", \"-lcrypt32\", \"-lws2_32\"]").ok;
    assert expect_contains_str(conditioner, "runtime capsule manifest has no [targets.").ok;
    assert expect_eq_bool(contains(conditioner, "target_condition_runtime_sfn_sources"), false).ok;
    assert expect_eq_bool(contains(target, "process_windows"), false).ok;
    assert expect_eq_bool(contains(target, "rlimit_windows"), false).ok;
}

test "cross-windows manifest selects every Win32 runtime sibling" ![io] {
    let manifest = fs.readFile("runtime/capsule.toml");
    assert expect_contains_str(manifest, "sfn/process.sfn=sfn/platform/process_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/rlimit.sfn=sfn/platform/rlimit_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/terminal.sfn=sfn/platform/terminal_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/rand.sfn=sfn/platform/rand_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/fs_exec_mode.sfn=sfn/platform/fs_exec_mode_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/fd_io.sfn=sfn/platform/fd_io_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/socket_ops.sfn=sfn/platform/socket_ops_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/rename_ops.sfn=sfn/platform/rename_ops_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/exclusive_create.sfn=sfn/platform/exclusive_create_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/cert_roots.sfn=sfn/platform/cert_roots_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/realpath_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/clock_windows.sfn").ok;
    // SFN-1039: `pthread_windows.sfn` carries `sysconf` as well as the
    // `pthread_*` bodies, and a statically linked mingw-w64 does not
    // resolve `sysconf` from winpthreads. Dropping it from the MinGW list
    // leaves `sfn_scheduler_resolve_thread_count` with an undefined
    // reference, so its presence here is load-bearing, not incidental.
    //
    // Anchored contiguously from the `sfn-sources-add = [` header rather
    // than searched for anywhere in the file: a bare whole-file substring
    // would still pass if the entry were moved to `sfn-sources-drop`, which
    // is precisely the regression this guards. Reordering these three lines
    // fails the assertion by design — this list's membership is a link-time
    // contract, so a reorder should come back through review here.
    assert expect_contains_str(manifest, "sfn-sources-add = [\n    \"sfn/platform/realpath_windows.sfn\",\n    \"sfn/platform/clock_windows.sfn\",\n    \"sfn/platform/pthread_windows.sfn\",").ok;
    assert expect_contains_str(manifest, "link-libs-drop = []").ok;
    assert expect_contains_str(manifest, "sfn/platform/popen_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/mkstemp_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/strcasestr_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/opendir_windows.sfn").ok;
    assert expect_contains_str(manifest, "sfn/platform/mkdtemp_windows.sfn").ok;
}

test "cross-Darwin manifest selects directory-safe no-clobber rename" ![io] {
    let manifest = fs.readFile("runtime/capsule.toml");
    assert expect_contains_str(manifest, "[targets.x86_64-apple-darwin]").ok;
    assert expect_contains_str(manifest, "[targets.arm64-apple-darwin]").ok;
    assert expect_contains_str(manifest, "sfn/platform/rename_ops.sfn=sfn/platform/rename_ops_macos.sfn").ok;
    let provider = fs.readFile("runtime/sfn/platform/rename_ops_macos.sfn");
    assert expect_contains_str(provider, "renamex_np").ok;
    assert expect_contains_str(provider, "return renamex_np(src, dst, 4)").ok;
}

test "Linux no-clobber rename supports captured directories" ![io] {
    let provider = fs.readFile("runtime/sfn/platform/rename_ops.sfn");
    assert expect_contains_str(provider, "renameat2").ok;
    assert expect_contains_str(provider, "return renameat2(-100, src, -100, dst, 1)").ok;
    assert expect_eq_bool(contains(provider, "link(src, dst)"), false).ok;
}

test "cross-windows native linker is driver-owned" ![io] {
    let target = fs.readFile("compiler/src/build/target.sfn");
    let backend = fs.readFile("compiler/src/backend.sfn");
    assert expect_contains_str(target, "x86_64-w64-mingw32-gcc").ok;
    assert expect_contains_str(target, "-femulated-tls").ok;
    assert expect_contains_str(target, "-static").ok;
    assert expect_contains_str(backend, "target_linker_driver").ok;
}
