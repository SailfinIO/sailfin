// Regression coverage for SFN-564. The retired `make compile` recipe used the
// output binary's mtime as its freshness predicate, which can miss an edit when
// timestamps are preserved or have coarse resolution. `sfn dev bootstrap build`
// delegates freshness to this content fingerprint instead.
//
// SFN-679 retired the shell implementation
// (`scripts/compiler_source_fingerprint.sh`) in favour of the native
// `sfn dev bootstrap fingerprint` subcommand; this file now drives that
// subcommand directly instead of shelling out to the script.
import { sfn_bin_abs_path, sfn_bin_path } from "sfn/test";

// `sfn dev bootstrap fingerprint <root>` prints ONLY the hex digest on
// stdout.
fn _fingerprint(root: string) -> string ![io] {
    let _exit = process.run_capture([sfn_bin_path(), "dev", "bootstrap", "fingerprint", root], []);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

fn _workspace_fingerprint(root: string) -> string ![io] {
    let _exit = process.run_capture_cwd([sfn_bin_abs_path(), "dev", "bootstrap", "fingerprint"], [], root);
    let output = process.capture_take_stdout();
    let _error = process.capture_take_stderr();
    return output;
}

test "compiler source fingerprint changes with bytes despite restored mtime" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/source-fingerprint-content";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    let source = scratch + "/main.sfn";
    fs.writeFile(source, "fn value() -> int { return 1; }\n");
    let first = _fingerprint(scratch);

    // Change the bytes, then force the old timestamp. This is the state the
    // former `find -newer build/bin/sfn` predicate silently classified as
    // up-to-date.
    fs.writeFile(source, "fn value() -> int { return 2; }\n");
    process.run(["touch", "-t", "200001010000", source]);
    let second = _fingerprint(scratch);

    assert first.length > 0;
    assert second.length > 0;
    assert first != second;
    process.run(["rm", "-rf", scratch]);
}

test "compiler source fingerprint is stable across repeated runs" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH") + "/source-fingerprint-stable";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    fs.writeFile(scratch + "/main.sfn", "fn value() -> int { return 1; }\n");
    let first = _fingerprint(scratch);
    let second = _fingerprint(scratch);

    assert first.length > 0;
    assert first == second;
    process.run(["rm", "-rf", scratch]);
}

test "compiler source fingerprint includes source paths" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH") + "/source-fingerprint-path";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    fs.writeFile(scratch + "/first.sfn", "fn value() -> int { return 1; }\n");
    let first = _fingerprint(scratch);

    process.run(["mv", scratch + "/first.sfn", scratch + "/renamed.sfn"]);
    let renamed = _fingerprint(scratch);

    assert first != renamed;
    process.run(["rm", "-rf", scratch]);
}

test "compiler source fingerprint changes when a source file is added or removed" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/source-fingerprint-add-remove";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    fs.writeFile(scratch + "/first.sfn", "fn value() -> int { return 1; }\n");
    let before_add = _fingerprint(scratch);

    fs.writeFile(scratch + "/second.sfn", "fn other() -> int { return 2; }\n");
    let after_add = _fingerprint(scratch);
    assert after_add != before_add;

    process.run(["rm", scratch + "/second.sfn"]);
    let after_remove = _fingerprint(scratch);
    assert after_remove == before_add;

    process.run(["rm", "-rf", scratch]);
}

test "compiler source fingerprint ignores non-sfn files under the root" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/source-fingerprint-non-sfn";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch, true);
    fs.writeFile(scratch + "/first.sfn", "fn value() -> int { return 1; }\n");
    let before = _fingerprint(scratch);

    fs.writeFile(scratch + "/README.md", "unrelated notes\n");
    let after = _fingerprint(scratch);

    assert before.length > 0;
    assert after == before;
    process.run(["rm", "-rf", scratch]);
}

test "compiler source fingerprint v2 covers workspace explicit inputs" ![io] {
    let scratch = env.get("SAILFIN_TEST_SCRATCH")
        + "/source-fingerprint-workspace-v2";
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch + "/compiler/src", true);
    fs.createDirectory(scratch + "/runtime/sfn", true);
    fs.createDirectory(scratch + "/runtime/ir", true);
    let workspace = "[workspace]\nmembers = [\"compiler\", \"runtime\"]\n";
    let bootstrap = "[seed]\nversion = \"0.0.0\"\n";
    let compiler_manifest = "[capsule]\nname = \"sfn/compiler\"\nversion = \"0.0.0\"\n\n[build]\nkind = \"binary\"\nentry = \"src/main.sfn\"\n";
    let runtime_manifest = "[capsule]\nname = \"sfn/runtime-native\"\nversion = \"0.0.0\"\n\n[build]\nkind = \"runtime\"\nsfn-source-root = \"sfn\"\n";
    fs.writeFile(scratch + "/workspace.toml", workspace);
    fs.writeFile(scratch + "/bootstrap.toml", bootstrap);
    fs.writeFile(scratch + "/compiler/capsule.toml", compiler_manifest);
    fs.writeFile(scratch + "/compiler/src/main.sfn", "fn main() -> int { return 0; }\n");
    fs.writeFile(scratch + "/runtime/capsule.toml", runtime_manifest);
    fs.writeFile(scratch + "/runtime/sfn/mod.sfn", "fn runtime_value() -> int { return 1; }\n");
    fs.writeFile(scratch + "/runtime/ir/stub.ll", "; runtime stub\n");

    let baseline = _workspace_fingerprint(scratch);
    assert baseline.length == 68;
    assert substring(baseline, 0, 3) == "v2-";

    fs.writeFile(scratch + "/README.md", "unrelated\n");
    assert _workspace_fingerprint(scratch) == baseline;

    fs.writeFile(scratch + "/workspace.toml", workspace + "# changed\n");
    assert _workspace_fingerprint(scratch) != baseline;
    fs.writeFile(scratch + "/workspace.toml", workspace);

    fs.writeFile(scratch + "/bootstrap.toml", bootstrap + "# changed\n");
    assert _workspace_fingerprint(scratch) != baseline;
    fs.writeFile(scratch + "/bootstrap.toml", bootstrap);

    fs.writeFile(scratch + "/compiler/capsule.toml", compiler_manifest
        + "# changed\n");
    assert _workspace_fingerprint(scratch) != baseline;
    fs.writeFile(scratch + "/compiler/capsule.toml", compiler_manifest);

    fs.writeFile(scratch + "/runtime/ir/stub.ll", "; changed runtime stub\n");
    assert _workspace_fingerprint(scratch) != baseline;
    fs.writeFile(scratch + "/runtime/ir/stub.ll", "; runtime stub\n");

    fs.writeFile(scratch + "/compiler/src/main.sfn", "fn main() -> int { return 1; }\n");
    assert _workspace_fingerprint(scratch) != baseline;
    process.run(["rm", "-rf", scratch]);
}
