// Regression e2e for SFN-807: the runtime TLS client's trust-store path
// (`runtime/sfn/platform/tls.sfn::_tls_anchors()` ->
// `capsules/sfn/crypto/src/trust_store.sfn::trust_store_load()`) must accept
// a CA bundle bigger than a *chain* PEM. `pem.sfn`'s wire-chain decoder
// defaults to a 16-block cap; SFN-807 was that default silently leaking into
// `trust_store_from_pem`, so a realistically-sized system bundle
// (~150 certificates) fail-closed to zero trust anchors and every TLS
// handshake with a `SAILFIN_TLS_CAFILE` override quietly stopped verifying
// anything.
//
// Every existing TLS e2e points `SAILFIN_TLS_CAFILE` at a single generated
// certificate (2-4 blocks), so none of them would notice a regression of the
// 16-block cap — a bundle that small clears it either way. This test builds
// its OWN bundle (never the machine's real system store, which varies by
// host/CI image and would not be hermetic): 19 distinct throwaway filler
// anchors followed by the real loopback cert, 20 blocks total — enough to
// clear the old 16-block cap and small enough to stay well under the
// ~94 ms / ~23 MB post-fix load cost (SFN-807 also fixed a quadratic base64
// accumulation that made anything near a real 150-cert bundle prohibitively
// expensive to even construct in a test).
//
// This is deliberately the shape that FAILS pre-fix and PASSES post-fix: the
// SUCCESS assertion is the one SFN-807 broke. A test that only asserted
// rejection of an untrusted peer (as the sibling verify-failure e2es do)
// cannot distinguish "trust store loaded and correctly rejected" from
// "trust store loaded zero anchors and rejected everything" — see the
// header note SFN-813 added to those files.
//
// no-bash-e2e (`.claude/rules/no-bash-e2e.md`): an `![io]` `*_test.sfn`
// drives everything via `process.*`; `openssl` is the cert generator and TLS
// peer (`s_server`), matching `runtime_tls_verify_failure_test.sfn`'s
// pattern. The client fixture is compiled via a nested `sfn build`, isolated
// with `clean_runner_env(nested_runner_scratch(...))` (SFN-401) so the pool's
// per-file scratch/orchestration keys never leak into the nested build.
import { remove_all } from "sfn/fs";
import { Env, env_from_current } from "sfn/os";
import { int_to_string } from "sfn/strings";
import {
    Background,
    clean_runner_env,
    default_scratch_dir,
    nested_runner_scratch,
    report_child_failure_pending,
    sfn_bin_path,
    tool_present,
    wait_until,
    with_background
} from "sfn/test";

// ── file-local raw loopback readiness probe ──────────────────────
// Prefixed `_tcb_` so these never collide with the external-linkage runtime
// helpers of the same shape in `http.sfn` (not linked into this test binary,
// but the prefix keeps that independent of link order).
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

// `sfn_socket_open`, not the raw libc `socket` — on Windows every raw
// `socket()` call fails until `WSAStartup` runs in the process (SFN-1114):
// a probe of `socket(2, 1, 0)` here returns fd=-1 with
// `WSAGetLastError()` = 10093 (WSANOTINITIALISED). `sfn_socket_open`
// (`runtime/sfn/platform/socket_ops_windows.sfn`) is the runtime's socket
// creator and carries the `WSAStartup` call; its POSIX sibling
// (`socket_ops.sfn`) is a direct pass-through, so this is the correct
// symbol on every target, not a Windows-only substitution. Effect note:
// `socket_ops.sfn` is `net`-gated (`runtime/capsule.toml`
// `[sfn-source-gates]`), so `_tcb_connect` and every caller up to
// `_await_listening`/the test declare `![net]` transitively (SFN-927 is
// the undefined-symbol failure mode otherwise).
extern fn sfn_socket_open(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

// `sfn_socket_close`, not the raw libc `close` — on Windows `close()` on a
// Winsock SOCKET is not an error return but a process-killing
// `__fastfail(0xC0000409)` (`socket_ops_windows.sfn:11-12`). The runtime
// helper routes to `closesocket` there and to `close` on POSIX
// (`socket_ops.sfn:101`), so it is correct on every target (SFN-1114).
extern fn sfn_socket_close(fd: i32) -> i32;

fn _tcb_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

// Connect a stream socket to `127.0.0.1:port`; returns the fd or -1. Tries
// both `sockaddr_in` byte layouts (Linux u16 sin_family at 0; macOS/BSD u8
// sin_len at 0 + u8 sin_family at 1), first success wins — the inlined
// `http.sfn::_connect_tcp` idiom. Used only to detect that `s_server` is
// accepting before the fixture runs.
fn _tcb_connect(port: i64) -> i32 ![net] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_tcb_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_tcb_ptr_off(addr, 0), 16, 1 as usize);
            memset(_tcb_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_tcb_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_tcb_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        memset(_tcb_ptr_off(addr, 4), 127, 1 as usize);
        memset(_tcb_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

// The env for `with_background`'s server spawn — plain `Env` (SFN-401's
// clean/nested-scratch isolation in `build_env` below is for the NESTED
// `sfn build`, which `openssl s_server` is not).
fn _server_env_typed() -> Env ![io] { return env_from_current(); }

fn _scratch_root() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    return dir;
}

// Generate a self-signed cert+key with SAN = `san_host`. Returns true on
// success.
fn _gen_cert(dir: string, san_host: string, env_vars: string[]) -> boolean ![io] {
    // Native TLS server signs CertificateVerify with Ed25519 only (RSA/ECDSA
    // signing is out of SFEP-0048 §6.3 scope); the loopback client below
    // talks to `openssl s_server`, not a native server, but generating the
    // same key type keeps this fixture aligned with the sibling e2es.
    let exit = process.run_capture(["openssl", "req", "-x509", "-newkey", "ed25519", "-keyout", dir
        + "/key.pem", "-out", dir
        + "/cert.pem", "-days", "1", "-nodes", "-subj", "/CN="
        + san_host, "-addext", "subjectAltName=DNS:"
        + san_host], env_vars);
    report_child_failure_pending("runtime-tls-ca-bundle-realistic-size cert-gen", exit);
    return exit == 0;
}

// Build `dir/bundle.pem`: `filler_count` distinct throwaway self-signed
// certs (each its own CN, so each is a distinct DER block — never a byte-
// for-byte duplicate of another anchor) followed by the real loopback cert
// from `dir/cert.pem`. A hermetic stand-in for a realistically-sized system
// CA bundle padded with unrelated corporate/vendor anchors: what matters for
// this regression is the BLOCK COUNT the loader must get through, and every
// filler is a distinct, independently self-signed (and therefore
// independently unverifiable-against-the-server) certificate, so only the
// real loopback cert can ever complete the chain.
//
// Distinctness is realism only — it is NOT a workaround. The `bad-signature`
// seen during this test's development was attributed to byte-identical
// anchors and filed as SFN-851; that attribution was wrong. Duplicate
// anchors verify correctly (`_find_issuer` iterates every subject match, so
// a bad copy is skipped), and the real cause was a stale listener from a
// prior run serving a certificate with this CN but a different key. The
// guard in the test below is what fixes it, so there is nothing here to
// revert.
fn _write_bundle(dir: string, filler_count: int, env_vars: string[]) -> string ![io] {
    let mut bundle: string = "";
    let mut i: int = 0;
    loop {
        if i >= filler_count { break; }
        let host = "filler" + int_to_string(i) + ".sfn-ca-bundle-size.invalid";
        assert _gen_cert(dir, host, env_vars);
        bundle = bundle + fs.readFile(dir + "/cert.pem");
        i += 1;
    }
    // Regenerate the real loopback cert last so `dir/cert.pem` /
    // `dir/key.pem` are the pair the server below actually uses. Last is
    // also load-bearing for the regression itself: block 20 being the only
    // USABLE anchor is what a truncating (fail-open) loader would get wrong
    // in addition to a fail-closed one — reordering so the real cert sits
    // among the first 16 blocks would let a truncate-at-16 bug pass this
    // test by accident.
    assert _gen_cert(dir, "localhost", env_vars);
    bundle = bundle + fs.readFile(dir + "/cert.pem");
    let path = dir + "/bundle.pem";
    fs.writeFile(path, bundle);
    return path;
}

// The `openssl s_server -www` argv, for `with_background` to spawn
// directly — no external `timeout` wrapper needed, since `with_background`
// owns the child's lifetime itself.
fn _server_argv(dir: string, port_str: string) -> string[] {
    let mut argv: string[] = [];
    argv.push("openssl");
    argv.push("s_server");
    argv.push("-accept");
    argv.push(port_str);
    argv.push("-cert");
    argv.push(dir + "/cert.pem");
    argv.push("-key");
    argv.push(dir + "/key.pem");
    argv.push("-www");
    argv.push("-quiet");
    return argv;
}

// Poll a raw TCP connect until `s_server` is accepting. 30s wall-clock
// budget. `port` is a typed parameter (not an untyped call-initialized
// `let`), so capturing it in the probe closure below is unaffected by
// SFN-843.
fn _await_listening(port: i64) -> boolean ![clock, io, net] {
    return wait_until(fn () -> boolean {
        let fd: i32 = _tcb_connect(port);
        if fd >= 0 {
            sfn_socket_close(fd);
            return true;
        }
        return false;
    }, 30000, 500);
}

// Write a fixture capsule whose `main` downloads `https://localhost:PORT/`
// to `<argv[1]>/body.out`. A failed connect/handshake/verify never opens
// `out_path` (`sfn_http_download` only writes once `_http_send` returns a
// body), so a NON-EMPTY file is the round-trip proof; the assertion below
// checks content length, not merely existence, so an opened-but-empty file
// (a zero-length body, which `fopen(..., "wb")` alone would still create)
// cannot masquerade as success.
//
// The scratch dir travels through `argv[1]`, never spliced into this source
// text. `SAILFIN_TEST_SCRATCH`/`TEMP` is a native Windows backslash path,
// and a literal `+ dir +` here would silently corrupt it the same way SFN-1001
// already diagnosed and fixed in `runtime_tls_anchor_cache_test.sfn`:
// `decode_string_literal_escapes` (`compiler/capsules/syntax/src/parser/utils.sfn:84-113`)
// drops the backslash for any `\<char>` it does not recognize as an escape
// when the nested build re-lexes this generated file, turning
// `C:\Users\...` into `C:Users...` — a different, non-existent path that
// `http.download` would then write to, invisibly to the caller's own
// (uncorrupted) `out_path` check. Also prints a startup marker and reports
// a missing scratch dir, so a corrupted path shows up in the client's own
// captured output instead of only as an unexplained "no body".
fn _write_client(dir: string, port_str: string) -> string ![io] {
    let root = dir + "/client";
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/tls-ca-bundle-size-e2e-client\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"tls ca bundle size e2e client\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", "fn main(argv: string[]) -> int ![io, net] {\n"
        + "    let dir = argv[1];\n"
        + "    let out_path = dir + \"/body.out\";\n"
        + "    if !fs.exists(dir) {\n"
        + "        print.err(\"[tls-ca-bundle-cli] scratch dir missing: \" + dir);\n"
        + "        return 1;\n"
        + "    }\n"
        + "    print.info(\"[tls-ca-bundle-cli] starting, target \" + out_path);\n"
        + "    let _ = http.download(\"https://localhost:"
        + port_str
        + "/\", out_path);\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

fn _build_bin(main_path: string, bin: string, build_env: string[]) -> string ![io] {
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", bin, main_path], build_env);
    report_child_failure_pending("runtime-tls-ca-bundle-realistic-size build", exit);
    if exit != 0 { return ""; }
    return bin;
}

// Run the client once with `run_env` and report whether `http.download`
// wrote a non-empty body to `<dir>/body.out`. `dir` is passed as the
// client's `argv[1]` (see `_write_client`'s header for why — SFN-1001), and
// `out_path` is recomputed here identically to how the fixture computes it
// internally. Removes any stale output first so the result reflects THIS
// run only.
fn _client_downloads(client_bin: string, run_env: string[], dir: string) -> boolean ![io] {
    let out_path = dir + "/body.out";
    let _rm = fs.deleteFile(out_path);
    let cexit = process.run_capture([client_bin, dir], run_env);
    report_child_failure_pending("runtime-tls-ca-bundle-realistic-size client run", cexit);
    if cexit != 0 { return false; }
    if !fs.exists(out_path) { return false; }
    let content = fs.readFile(out_path);
    return content.length > 0;
}

// Retry `_client_downloads` a few times to absorb residual server startup
// latency.
fn _client_downloads_retry(client_bin: string, run_env: string[], dir: string) -> boolean ![clock, io] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 20 { break; }
        if _client_downloads(client_bin, run_env, dir) { return true; }
        sleep(500);
        attempt += 1;
    }
    return false;
}

fn _skip_ready() -> boolean ![io] {
    if !tool_present("openssl") {
        print.info("[tls-ca-bundle-size] SKIP: openssl CLI not available");
        return false;
    }
    return true;
}

test "runtime tls: a CAFILE bundle over the old 16-block chain cap still verifies (SFN-807)" ![clock, io, net] {
    if !_skip_ready() {
        assert true;
        return;
    }
    // 18900 is taken by `runtime_tls_aes_gcm_client_test.sfn`; 18902 is the
    // next free fixed port among this repo's TLS e2es. `with_background`
    // kills and reaps `s_server` on scope exit (including a thrown
    // assertion), but the pre-flight probe below stays as defense-in-depth
    // against a listener left by anything external to this test (e.g. a
    // manually run debug session) — a foreign peer on this CN under a
    // different key would make `_find_issuer` match on subject and
    // `_verify_link` then fail the signature, a deterministic
    // `bad-signature` that has nothing to do with the anchors under test
    // (SFN-851's root cause).
    let port: i64 = 18902;
    let port_str = "18902";

    let scratch = nested_runner_scratch("tls-ca-bundle-size");
    // SFN-843: typed explicitly — the `with_background` body below captures
    // it, and an untyped call-initialized `let` mistypes the capture's env
    // slot as `i8*`.
    let build_env: string[] = clean_runner_env(scratch);
    // Per-invocation, so a rerun can never inherit the previous run's
    // cert.pem/key.pem and silently verify against the wrong key.
    let dir = scratch + "/sfn-tls-ca-bundle-size";
    fs.createDirectory(dir, true);

    // 19 distinct filler anchors plus the real loopback cert (SAN =
    // localhost, so the only reason a bundle missing it would fail is
    // trust, not hostname) = 20 blocks: enough to clear `pem.sfn`'s old
    // 16-block chain default (the SFN-807 shape), modest enough to stay
    // well inside the post-fix cost budget (~94 ms / ~23 MB for a real
    // bundle; this hermetic one is smaller still).
    // SFN-843: typed explicitly — see `build_env` above.
    let bundle: string = _write_bundle(dir, 19, build_env);

    let main_path = _write_client(dir, port_str);
    // SFN-843: typed explicitly — see `build_env` above.
    let client_bin: string = _build_bin(main_path, dir + "/client-bin", build_env);
    assert client_bin.length > 0;

    // A listener already on this port is a prior run's server, not ours:
    // this run's `s_server` cannot bind, and `_await_listening` would
    // succeed against the foreign peer. Skip rather than report its
    // `bad-signature` as this test's verdict (SFN-851).
    let stale: i32 = _tcb_connect(port);
    if stale >= 0 {
        sfn_socket_close(stale);
        print.info("[tls-ca-bundle-size] SKIP: port 18902 still held by a prior run's s_server");
        assert true;
        return;
    }

    // `with_background` owns `s_server`'s lifetime: it is killed and reaped
    // on scope exit, including when an assertion below throws — replacing
    // the previous `timeout <secs>` argv vehicle, which was the ONLY
    // teardown mechanism and forced a SKIP on any host without coreutils.
    let _served = with_background(_server_argv(dir, port_str), _server_env_typed(), "", "tls-ca-bundle-size-server", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        assert _await_listening(port);

        // The acceptance shape: SUCCESS against a bundle over the old cap.
        // Pre-SFN-807, `trust_store_from_pem` inherited `pem.sfn`'s
        // 16-block chain default, so this 20-block bundle fail-closed to
        // zero anchors and every handshake below would have been rejected
        // for `no-anchor` — the same failure signal as an actually-
        // untrusted peer, which is exactly why the bug went undetected.
        // Post-fix, `trust_store.sfn` applies its own 512-block cap and
        // this succeeds.
        let mut run_env = build_env;
        run_env.push("SAILFIN_TLS_CAFILE=" + bundle);
        let ok = _client_downloads_retry(client_bin, run_env, dir);
        print.info("[tls-ca-bundle-size] round-trip against a 20-block CAFILE bundle: ok="
            + (ok as string));
        assert ok;
        return 0;
    });

    assert remove_all(dir);
}
