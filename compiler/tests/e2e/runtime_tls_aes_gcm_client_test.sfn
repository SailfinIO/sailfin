// AES-GCM cipher-suite coverage for the native runtime's outbound TLS
// client (SFN-814). `runtime_tls_https_client_test.sfn` proves a round-trip
// happens; it never pins WHICH suite carried it, and this stack's
// `encode_client_hello` offers ChaCha20-Poly1305 first
// (`sfn/crypto/tls13_handshake_codec.sfn`, SFN-814),
// so a change that broke AES-GCM specifically could still pass that test by
// negotiating ChaCha20. This test forces the negotiated suite by pointing
// `openssl s_server` at exactly one TLS 1.3 ciphersuite via `-ciphersuites`,
// so a body arriving is proof THAT suite carried the record, not merely that
// some suite did.
//
// Three legs, same server recipe (`openssl s_server -www`, Ed25519
// self-signed `CN=localhost` cert with a `DNS:localhost` SAN, trusted via
// `SAILFIN_TLS_CAFILE` — the `runtime_tls_https_client_test.sfn` recipe):
//   - AES-128-GCM only: the point of this test. `_tls_suite_aead` /
//     `_tls_suite_key_len` (`tls.sfn`) both map this suite, and
//     `encode_client_hello` offers it, so the handshake must complete and
//     the body must round-trip.
//   - ChaCha20-Poly1305 only: the control leg. Proves the harness
//     discriminates by cipher suite (a broken AES-GCM path would still
//     pass this leg) rather than the AES-128 leg passing for an unrelated
//     reason (e.g. the server ignoring `-ciphersuites`).
//   - AES-256-GCM (`TLS_AES_256_GCM_SHA384`) only: the client deliberately
//     does not offer this suite — `_tls_suite_aead` returns 0 for it
//     ("TLS_AES_256_GCM_SHA384 needs a 48-byte hash threaded through the
//     handshake and is out of scope (SFN-814)"), so the handshake MUST
//     fail. This pins that the client's offer list is exactly what
//     `tls.sfn` claims: a regression that started (mis-)offering this
//     suite would flip this leg from a clean rejection to a body arriving
//     under a cipher the runtime cannot actually decrypt records for.
//
// Skips cleanly (`assert true`, the tool-absent SKIP precedent, mirroring
// `runtime_tls_https_client_test.sfn`) when `openssl` is missing (no TLS
// peer) or no `timeout`/`gtimeout` is available to reap the blocking
// `s_server`. Within the guard, every crypto assertion below is
// unconditional — a failed handshake on the AES-GCM or ChaCha20 leg FAILS
// the test, it is never downgraded to a skip or a pass
// (http_redirect_download_test.sfn's silent-empty-probe class of bug is
// exactly what this file must not join).
//
// Matchers note (#842): `sfn/test`'s `expect_*` matchers are `![pure]` and
// cannot be called from an `![io]` test; assert on captured text with
// `sfn/strings::contains` instead.
import { contains } from "sfn/strings";

// ── file-local raw loopback readiness probe ──────────────────────
// Prefixed `_tag_` so these never collide with the external-linkage
// runtime helpers of the same shape in `http.sfn` (not linked into this
// test binary, but the prefix keeps that independent of link order). The
// libc socket externs carry no effect annotation, so the effect checker
// infers no `net` requirement for these direct callers — the same
// rationale as the sibling TLS e2e tests.
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

extern fn socket(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

extern fn close(fd: i32) -> i32;

fn _tag_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

// Connect a stream socket to `127.0.0.1:port`; returns the fd or -1. Tries
// both `sockaddr_in` byte layouts (Linux u16 sin_family at 0; macOS/BSD u8
// sin_len at 0 + u8 sin_family at 1), first success wins — the inlined
// `http.sfn::_connect_tcp` idiom. Used only to detect that `s_server` is
// accepting before the fixture runs.
fn _tag_connect(port: i64) -> i32 {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_tag_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_tag_ptr_off(addr, 0), 16, 1 as usize);
            memset(_tag_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_tag_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_tag_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        memset(_tag_ptr_off(addr, 4), 127, 1 as usize);
        memset(_tag_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = socket(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

// Full parent environment for the build + server + client subprocesses
// (`run_capture`/`spawn_with_env`'s empty env is EMPTY, not "inherit"):
// the nested build links a binary (clang + ld), and
// SAILFIN_TEST_SCRATCH (already present) keeps the build cache
// per-invocation under the parallel pool.
fn _child_env() -> string[] ![io] { return process.environ(); }

// The client run-env plus `SAILFIN_TLS_CAFILE` pointed at the generated
// self-signed cert so the client trusts it (verify stays on).
fn _client_env(cert_path: string) -> string[] ![io] {
    let mut e = process.environ();
    e.push("SAILFIN_TLS_CAFILE=" + cert_path);
    return e;
}

fn _has_cmd(name: string) -> boolean ![io] {
    let probe = process.run(["sh", "-c", "command -v " + name
        + " >/dev/null 2>&1"]);
    return probe == 0;
}

// Resolve a wall-clock timeout command to reap the blocking `s_server`;
// empty if none found.
fn _timeout_cmd() -> string ![io] {
    if _has_cmd("timeout") { return "timeout"; }
    if _has_cmd("gtimeout") { return "gtimeout"; }
    return "";
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = "/tmp"; }
    dir = dir + "/sfn-tls-aes-gcm-e2e";
    fs.createDirectory(dir, true);
    return dir;
}

// Generate a self-signed cert+key (CN=localhost) for the TLS server. The
// `subjectAltName=DNS:localhost` SAN is required: the client enforces
// RFC-6125 hostname verification (SSL_set1_host), and modern OpenSSL checks
// the SAN (not the CN) when a SAN is present. Returns true on success.
fn _gen_cert(dir: string) -> boolean ![io] {
    // Native TLS server signs CertificateVerify with Ed25519 only (RSA/ECDSA
    // signing is out of SFEP-0048 §6.3 scope), so `sfn_serve_tls` accepts an
    // Ed25519 certificate only (SFN-341). This test never starts a native
    // server (openssl s_server plays the peer), but the cert format still
    // needs to be one the client's own chain-parsing accepts.
    let exit = process.run_capture(["openssl", "req", "-x509", "-newkey", "ed25519", "-keyout", dir
        + "/key.pem", "-out", dir
        + "/cert.pem", "-days", "1", "-nodes", "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost"], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    return exit == 0;
}

// Spawn `openssl s_server -www` restricted to exactly one TLS 1.3
// ciphersuite via `-ciphersuites`, wrapped in a wall-clock timeout so it
// self-reaps (there is no process-kill primitive; s_server blocks forever).
// Returns the spawn handle (unused for teardown — the timeout owns the
// lifetime).
fn _spawn_server(dir: string, tcmd: string, port_str: string, ciphersuite: string) -> i64 ![io] {
    let mut argv: string[] = [];
    argv.push(tcmd);
    argv.push("60");
    argv.push("openssl");
    argv.push("s_server");
    argv.push("-accept");
    argv.push(port_str);
    argv.push("-cert");
    argv.push(dir + "/cert.pem");
    argv.push("-key");
    argv.push(dir + "/key.pem");
    argv.push("-ciphersuites");
    argv.push(ciphersuite);
    argv.push("-www");
    argv.push("-quiet");
    return process.spawn_with_env(argv, _child_env());
}

// Poll a raw TCP connect until `s_server` is accepting (or the budget
// elapses). ~30s budget (60 attempts x ~0.5s) stays under the 60s server
// timeout. Returns true once the port accepts a connection.
fn _await_listening(port: i64) -> boolean ![io] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 60 { break; }
        let fd: i32 = _tag_connect(port);
        if fd >= 0 {
            close(fd);
            return true;
        }
        let _ = process.run(["sleep", "0.5"]);
        attempt = attempt + 1;
    }
    return false;
}

// Write a fixture capsule whose `main` downloads `https://localhost:PORT/`
// to `out_path`. `http.download` writes the file only on a successful
// round-trip, so its presence + content is the round-trip proof.
fn _write_client(dir: string, port_str: string, out_path: string) -> string ![io] {
    let root = dir + "/client";
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/tls-aes-gcm-e2e-client\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"aes-gcm cipher suite e2e client\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", "fn main() -> int ![net, io] {\n"
        + "    let _ = http.download(\"https://localhost:"
        + port_str
        + "/\", \""
        + out_path
        + "\");\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

fn _build_bin(main_path: string, bin: string) -> string ![io] {
    let exit = process.run_capture([_sfn_bin(), "build", "-o", bin, main_path], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return ""; }
    return bin;
}

// Run the client once and return the downloaded body (or "" if
// `http.download` wrote nothing — connect failure, handshake failure, or
// verify failure). Removes any stale output first so the result reflects
// THIS run only. Wrapped in `tcmd` as a wall-clock backstop: the client's
// own socket read/write deadlines (`_http_io_timeout_secs`, 10s) already
// turn a stalled peer into a clean `null` return, but the extra `timeout`
// wrapper keeps a genuinely wedged client from hanging the test runner.
fn _client_body(tcmd: string, client_bin: string, run_env: string[], out_path: string) -> string ![io] {
    let _rm = process.run(["rm", "-f", out_path]);
    let cexit = process.run_capture([tcmd, "30", client_bin], run_env);
    let _co = process.capture_take_stdout();
    let _ce = process.capture_take_stderr();
    if cexit != 0 { return ""; }
    if !fs.exists(out_path) { return ""; }
    return fs.readFile(out_path);
}

// Retry `_client_body` a few times to absorb residual server startup
// latency — used only for the POSITIVE round-trip legs (AES-128-GCM,
// ChaCha20-Poly1305), never for the AES-256-GCM negative leg (an
// unoffered suite cannot start succeeding on retry).
fn _client_body_retry(tcmd: string, client_bin: string, run_env: string[], out_path: string) -> string ![io] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 20 { break; }
        let body = _client_body(tcmd, client_bin, run_env, out_path);
        if body.length > 0 { return body; }
        let _ = process.run(["sleep", "0.5"]);
        attempt = attempt + 1;
    }
    return "";
}

fn _skip_ready() -> boolean ![io] {
    if !_has_cmd("openssl") {
        print.info("[tls-aes-gcm] SKIP: openssl CLI not available");
        return false;
    }
    if _timeout_cmd().length == 0 {
        print.info("[tls-aes-gcm] SKIP: no timeout/gtimeout to reap the blocking s_server");
        return false;
    }
    return true;
}

test "runtime tls: handshake completes against an AES-128-GCM-only server" ![io] {
    if !_skip_ready() {
        assert true;
        return;
    }
    let tcmd = _timeout_cmd();
    // Distinct from every other e2e's fixed loopback port so the pool's
    // `--jobs N` does not collide.
    let port: i64 = 18898;
    let port_str = "18898";

    let dir = _scratch_dir() + "/aes128";
    fs.createDirectory(dir, true);
    assert _gen_cert(dir);

    let out_path = dir + "/body.out";
    let main_path = _write_client(dir, port_str, out_path);
    let client_bin = _build_bin(main_path, dir + "/client-bin");
    assert client_bin.length > 0;

    let _handle = _spawn_server(dir, tcmd, port_str, "TLS_AES_128_GCM_SHA256");
    assert _await_listening(port);

    // `tls.sfn::_tls_suite_aead` maps this suite and `encode_client_hello`
    // offers it, so a server that speaks ONLY this suite must still
    // complete the handshake and round-trip the body.
    let body = _client_body_retry(tcmd, client_bin, _client_env(dir
        + "/cert.pem"), out_path);
    print.info("[tls-aes-gcm] AES-128-GCM round-trip body received");
    assert body.length > 0;
    assert contains(body, "Ciphers");

    let _rmd = process.run(["rm", "-rf", dir]);
}

test "runtime tls: handshake completes against a ChaCha20-Poly1305-only server (control)" ![io] {
    if !_skip_ready() {
        assert true;
        return;
    }
    let tcmd = _timeout_cmd();
    let port: i64 = 18899;
    let port_str = "18899";

    let dir = _scratch_dir() + "/chacha20";
    fs.createDirectory(dir, true);
    assert _gen_cert(dir);

    let out_path = dir + "/body.out";
    let main_path = _write_client(dir, port_str, out_path);
    let client_bin = _build_bin(main_path, dir + "/client-bin");
    assert client_bin.length > 0;

    let _handle = _spawn_server(dir, tcmd, port_str, "TLS_CHACHA20_POLY1305_SHA256");
    assert _await_listening(port);

    // Control leg: proves the AES-128-GCM leg above discriminates by
    // cipher suite rather than passing for an unrelated reason (e.g. the
    // server ignoring `-ciphersuites` entirely).
    let body = _client_body_retry(tcmd, client_bin, _client_env(dir
        + "/cert.pem"), out_path);
    print.info("[tls-aes-gcm] ChaCha20-Poly1305 round-trip body received");
    assert body.length > 0;
    assert contains(body, "Ciphers");

    let _rmd = process.run(["rm", "-rf", dir]);
}

test "runtime tls: handshake fails against an AES-256-GCM-only server (unoffered suite)" ![io] {
    if !_skip_ready() {
        assert true;
        return;
    }
    let tcmd = _timeout_cmd();
    let port: i64 = 18900;
    let port_str = "18900";

    let dir = _scratch_dir() + "/aes256";
    fs.createDirectory(dir, true);
    assert _gen_cert(dir);

    let out_path = dir + "/body.out";
    let main_path = _write_client(dir, port_str, out_path);
    let client_bin = _build_bin(main_path, dir + "/client-bin");
    assert client_bin.length > 0;

    let _handle = _spawn_server(dir, tcmd, port_str, "TLS_AES_256_GCM_SHA384");
    assert _await_listening(port);

    // `tls.sfn::_tls_suite_aead` returns 0 for TLS_AES_256_GCM_SHA384 (the
    // 48-byte-hash suite is explicitly out of scope, SFN-814) and
    // `encode_client_hello` does not offer it, so a server restricted to
    // ONLY this suite has no suite in common with the client: TLS 1.3
    // requires the server to abort with `handshake_failure` when no offered
    // suite matches. A single attempt is conclusive — an unoffered suite
    // cannot start succeeding on retry — and the client's own socket
    // read/write deadlines plus the `timeout` wrapper keep this from
    // hanging if the peer ever misbehaves instead of alerting cleanly.
    let body = _client_body(tcmd, client_bin, _client_env(dir + "/cert.pem"), out_path);
    print.info("[tls-aes-gcm] AES-256-GCM leg: expecting no body (unoffered suite)");
    assert body.length == 0;

    let _rmd = process.run(["rm", "-rf", dir]);
}
