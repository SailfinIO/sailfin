// SFN-1114: the hook now invokes `sfn check` directly instead of shelling
// out to `make check-fast`, so the stub compiler below -- not a stub
// Makefile -- is what records that the gate ran.
//
// SFN-935: staged deletions of explicit repository inputs must still trigger
// the opt-in fast-check hook even though the deleted path is absent from the
// live workspace inventory emitted by the compiler.
import { clean_runner_env, nested_runner_scratch, skip } from "sfn/test";

fn _require_posix_shell() -> bool ![io] {
    if env.get("COMSPEC").length == 0 { return true; }
    skip("SFN-1156: pre-commit inventory validates a POSIX hook installer; remove this skip when native Windows has a bounded POSIX-shell provider instead of the WSL bash launcher");
    return false;
}

fn _repo_root() -> string ![io] {
    let mut root = env.get("SAILFIN_REPO_ROOT");
    if root.length == 0 { root = env.get("PWD"); }
    if root.length == 0 { root = "."; }
    return root;
}

fn _run_cwd(argv: string[], child_env: string[], cwd: string) -> int ![io] {
    let exit = process.run_capture_cwd(argv, child_env, cwd);
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    return exit;
}

fn _deletion_triggers(label: string, deleted_path: string) -> void ![io] {
    let scratch = nested_runner_scratch("precommit-inventory-" + label);
    process.run(["rm", "-rf", scratch]);
    fs.createDirectory(scratch + "/scripts", true);
    fs.createDirectory(scratch + "/build/bin", true);
    fs.createDirectory(scratch + "/runtime/ir", true);
    fs.writeFile(scratch + "/scripts/install_precommit.sh", fs.readFile(_repo_root()
        + "/scripts/install_precommit.sh"));
    fs.writeFile(scratch + "/workspace.toml", "[workspace]\nmembers = []\n");
    fs.writeFile(scratch + "/bootstrap.toml", "[seed]\nversion = \"0.0.0\"\n");
    fs.writeFile(scratch + "/runtime/ir/stub.ll", "; stub\n");
    fs.writeFile(scratch + "/build/bin/sfn", "#!/usr/bin/env sh\n"
        + "if [ \"$3\" = \"maintainer-sources\" ]; then echo compiler/src; exit 0; fi\n"
        + "if [ \"$3\" = \"explicit-inputs\" ]; then echo workspace.toml; exit 0; fi\n"
        + "if [ \"$1\" = \"check\" ]; then printf ran > hook-ran; exit 0; fi\n"
        + "exit 1\n");
    process.run(["chmod", "+x", scratch + "/build/bin/sfn"]);

    let child_env = clean_runner_env(scratch + "/test-scratch");
    assert _run_cwd(["git", "init", "-q"], child_env, scratch) == 0;
    assert _run_cwd(["git", "config", "user.email", "test@sailfin.dev"], child_env, scratch) == 0;
    assert _run_cwd(["git", "config", "user.name", "Sailfin Test"], child_env, scratch) == 0;
    assert _run_cwd(["git", "add", "."], child_env, scratch) == 0;
    assert _run_cwd(["git", "commit", "-qm", "baseline"], child_env, scratch) == 0;
    assert _run_cwd(["bash", "scripts/install_precommit.sh"], child_env, scratch) == 0;

    fs.deleteFile(scratch + "/" + deleted_path);
    assert _run_cwd(["git", "add", "-u"], child_env, scratch) == 0;
    assert _run_cwd(["bash", ".git/hooks/pre-commit"], child_env, scratch) == 0;
    assert fs.exists(scratch + "/hook-ran");
    process.run(["rm", "-rf", scratch]);
}

test "precommit inventory: staged bootstrap deletion triggers the check" ![io] {
    if !_require_posix_shell() { return; }
    _deletion_triggers("bootstrap", "bootstrap.toml");
}

test "precommit inventory: staged runtime IR deletion triggers the check" ![io] {
    if !_require_posix_shell() { return; }
    _deletion_triggers("runtime-ir", "runtime/ir/stub.ll");
}
