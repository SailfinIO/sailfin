// compiler/tests/e2e/tls_record_throughput_test.sfn
//
// Pins the throughput of the `*u8` pointer-idiom TLS 1.3 record layer
// (`runtime/sfn/platform/tls_record.sfn`, SFN-768; design
// `docs/proposals/design-notes/sfn-341-native-tls-runtime-swap.md` §3.3),
// whose entire reason for existing is per-byte speed over the `int[]` oracle
// in `sfn/crypto`.
//
// `sfn test` links at -O0 (`compiler/src/cli/commands/test/link.sfn`), so the
// figures this test prints are the -O0 figures. The -O2 figures come from
// `sfn build` (hardcoded -O2 in `compiler/src/cli/commands/build.sfn`) and are
// recorded in the PR and `docs/status.md`, not asserted here.
//
// The floors below are loose on purpose: this is a catastrophic-regression
// guard, not a benchmark. `sfn test` links at -O0, where LLVM's
// constant-length-1 `memset` -> `store i8` fold never fires, so this test
// does NOT guard that fold — losing it would move the -O0 number this test
// measures by exactly zero. What the floors actually catch is a
// catastrophic -O0 throughput regression and a collapse of the pointer
// idiom's advantage over the `int[]` oracle. The -O2 figures, where the fold
// does apply, are recorded in `docs/status.md`, not asserted here. A shared
// CI runner's absolute numbers are not reproducible, so the assertion needs
// a wide margin. Measured on the dev host at -O0: seal ~42 MB/s, open ~43
// MB/s, `int[]` oracle ~3.7 MB/s (pointer/oracle ratio ~11x).
import { tls13_seal_record } from "sfn/crypto";
import { int_to_string } from "sfn/strings";

extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(ptr: *u8, value: i32, n: usize) -> *u8;

extern fn sfn_tls_record_seal(key: *u8, key_len: i64, iv: *u8, iv_len: i64, seq: i64, content_type: i64, content: *u8, content_len: i64, padding: i64, out: *u8) -> i64;

extern fn sfn_tls_record_open(key: *u8, key_len: i64, iv: *u8, iv_len: i64, seq: i64, record: *u8, record_len: i64) -> i64;

// `_tlsrec_` is reserved by the module under test and `_td_` by the
// differential test (tls_record_pointer_differential_test.sfn), so every
// helper here carries the `_tp_` prefix to stay collision-free.
fn _tp_off(p: *u8, o: int) -> *u8 {
    let a: int = (p as i64) + o;
    return a as *u8;
}

fn _tp_put(p: *u8, o: int, b: int) -> void {
    memset(_tp_off(p, o), (b & 255) as i32, 1 as usize);
}

// Integer MB/s (bytes-per-millisecond scaled). Callers must guard `ms == 0`
// themselves before calling this to decide whether a floor applies.
fn _tp_mbps(bytes: int, ms: int) -> int { return bytes / (ms * 1000); }

test "tls record: pointer idiom sustains its throughput advantage over the int[] oracle" ![clock, io] {
    let rec: int = 16384;
    let n_rec: int = 64;
    let passes: int = 4;
    let total: int = rec * n_rec * passes;
    let key: *u8 = malloc(32 as usize);
    let iv: *u8 = malloc(12 as usize);
    let mut i: int = 0;
    loop {
        if i >= 32 { break; }
        _tp_put(key, i, (i * 7 + 3) & 255);
        i += 1;
    }
    i = 0;
    loop {
        if i >= 12 { break; }
        _tp_put(iv, i, (i * 13 + 5) & 255);
        i += 1;
    }
    let plain: *u8 = malloc(rec as usize);
    i = 0;
    loop {
        if i >= rec { break; }
        _tp_put(plain, i, (i * 31 + 7) & 255);
        i += 1;
    }
    let wire: *u8 = malloc((rec + 32) as usize);
    let warm: int = sfn_tls_record_seal(key, 32, iv, 12, 0, 23, plain, rec, 0, wire);
    assert warm > 0;

    let t0: int = monotonic_millis();
    let mut p1: int = 0;
    loop {
        if p1 >= passes { break; }
        let mut s: int = 0;
        loop {
            if s >= n_rec { break; }
            sfn_tls_record_seal(key, 32, iv, 12, s, 23, plain, rec, 0, wire);
            s += 1;
        }
        p1 += 1;
    }
    let t1: int = monotonic_millis();
    let t2: int = monotonic_millis();
    let mut p2: int = 0;
    // Accumulate the open failures outside the timed critical path (a
    // per-iteration assert would distort the measurement) and check once
    // after t3: a broken open that returns its auth-failure code before the
    // decrypt pass would otherwise run faster and still flatter this floor.
    let mut open_bad: int = 0;
    loop {
        if p2 >= passes { break; }
        let mut s: int = 0;
        loop {
            if s >= n_rec { break; }
            let w: int = sfn_tls_record_seal(key, 32, iv, 12, s, 23, plain, rec, 0, wire);
            let o: int = sfn_tls_record_open(key, 32, iv, 12, s, wire, w);
            if o < 0 { open_bad += 1; }
            s += 1;
        }
        p2 += 1;
    }
    let t3: int = monotonic_millis();
    assert open_bad == 0;
    let seal_ms: int = t1 - t0;
    let open_ms: int = (t3 - t2) - seal_ms;
    print.info("bytes=" + int_to_string(total));
    print.info("seal_ms=" + int_to_string(seal_ms));
    print.info("open_ms=" + int_to_string(open_ms));
    free(key);
    free(iv);
    free(plain);
    free(wire);

    // The `int[]` oracle over the same record shape. Only 8 records here: at
    // -O0 that idiom is slow enough that a full 1 MiB pass would dominate.
    let o_rec: int = 8;
    let mut okey: int[] = [];
    let mut oiv: int[] = [];
    let mut q: int = 0;
    loop {
        if q >= 32 { break; }
        okey.push((q * 7 + 3) & 255);
        q += 1;
    }
    q = 0;
    loop {
        if q >= 12 { break; }
        oiv.push((q * 13 + 5) & 255);
        q += 1;
    }
    let mut ocontent: int[] = [];
    q = 0;
    loop {
        if q >= rec { break; }
        ocontent.push((q * 31 + 7) & 255);
        q += 1;
    }
    let o0: int = monotonic_millis();
    q = 0;
    loop {
        if q >= o_rec { break; }
        tls13_seal_record(okey, oiv, q, 23, ocontent, 0);
        q += 1;
    }
    let o1: int = monotonic_millis();
    let oracle_ms: int = o1 - o0;
    let oracle_bytes: int = rec * o_rec;
    print.info("oracle_bytes=" + int_to_string(oracle_bytes));
    print.info("oracle_ms=" + int_to_string(oracle_ms));

    // Catastrophic-regression floors only (see header). A zero elapsed
    // measurement means the run was too fast to resolve at millisecond
    // granularity, not that throughput was bad, so that floor is skipped
    // rather than divided by zero.
    if seal_ms > 0 { assert _tp_mbps(total, seal_ms) >= 5; }
    if open_ms > 0 { assert _tp_mbps(total, open_ms) >= 5; }
    if seal_ms > 0 && oracle_ms > 0 {
        let seal_mbps: int = _tp_mbps(total, seal_ms);
        let oracle_mbps: int = _tp_mbps(oracle_bytes, oracle_ms);
        assert seal_mbps >= oracle_mbps * 3;
    }
}
