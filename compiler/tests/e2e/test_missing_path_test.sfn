// compiler/tests/e2e/test_missing_path_test.sfn
//
// End-to-end guard for `sfn test`'s missing-path check (SFN-648,
// `compiler/src/cli/commands/test/mod.sfn` `run()` /
// `compiler/src/cli/commands/test/discovery.sfn`
// `_collect_test_files_cmd`). Before the fix, `_collect_test_files_cmd`'s
// single-file fast path returned any `.sfn`-suffixed argument as a
// collected file without checking that it existed, so `sfn test
// <absent>.sfn` proceeded straight into compilation and link with no
// `main` symbol for the phantom file — an internal compiler error
// instead of a diagnostic naming the missing path. Following
// `fmt.sfn` `run()`, `run()` now validates every positional suite path up
// front and fails the whole invocation — before any suite/collection
// work — printing `error: path not found: <path>` for each and exiting 2.
// This test drives the real CLI as a subprocess and pins: the diagnostic
// text, the exact exit code, and that neither an ICE nor a "failing IR"
// note is emitted. See `.claude/rules/no-bash-e2e.md`.
import { contains } from "sfn/strings";
import {
    clean_runner_env,
    default_scratch_dir,
    nested_runner_scratch,
    sfn_bin_path
} from "sfn/test";

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/sfn-test-missing-e2e";
    fs.createDirectory(dir, true);
    return dir;
}

fn _child_env() -> string[] ![io] {
    return clean_runner_env(nested_runner_scratch("test-missing-path"));
}

test "test-missing-path: sfn test on an absent .sfn path fails without an ICE" ![io] {
    let dir = _scratch_dir();
    let absent = dir + "/absent_test.sfn";
    if fs.exists(absent) { fs.deleteFile(absent); }

    let rc = process.run_capture([sfn_bin_path(), "test", absent], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();

    // Exit 2 is the contract, not merely "non-zero": the pre-fix ICE also
    // exited non-zero, and `sfn test` reserves 1 for a red suite. Pinning the
    // code is what keeps a typo'd path distinguishable from a test failure.
    assert rc == 2;
    assert contains(out, "path not found");
    assert contains(out, absent);
    assert ! contains(out, "internal compiler error");
    assert ! contains(err, "internal compiler error");
    assert ! contains(out, "failing IR");
    assert ! contains(err, "failing IR");
    assert ! fs.exists(absent);
}

// An absent *directory* never reached the ICE — the directory walk returns
// nothing for a missing path, so it landed on the benign "no *_test.sfn files
// found under <path>" and exit 0. That is the larger user-visible change in
// SFN-648, and this pins the two messages apart so a later refactor cannot
// silently collapse a typo'd suite back into "this suite is empty".
test "test-missing-path: an absent directory is named, not reported as empty" ![io] {
    let dir = _scratch_dir();
    let absent = dir + "/absent-suite-dir";
    let rc = process.run_capture([sfn_bin_path(), "test", absent], _child_env());
    let out = process.capture_take_stdout();

    assert rc == 2;
    assert contains(out, "path not found");
    assert contains(out, absent);
    assert ! contains(out, "no *_test.sfn files found");
    assert ! contains(out, "internal compiler error");
}

// The check counts misses instead of returning on the first one, so that a
// multi-suite invocation is diagnosable in one run. Ordering the absent paths
// around a real suite means a first-miss early return cannot pass by accident.
test "test-missing-path: every absent suite path is reported, not just the first" ![io] {
    let dir = _scratch_dir();
    let absent_a = dir + "/absent-a";
    let absent_b = dir + "/absent-b";
    let rc = process.run_capture([sfn_bin_path(), "test", absent_a, "compiler/tests/unit", absent_b], _child_env());
    let out = process.capture_take_stdout();

    assert rc == 2;
    assert contains(out, absent_a);
    assert contains(out, absent_b);
    // Nothing compiled: the real suite in the middle must not have run.
    assert ! contains(out, "passed");
}
