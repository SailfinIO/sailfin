// Native server-loopback e2e for the typed `sfn/http` `serve` (#1387,
// part of #1385) — the macOS-arm64 request-delivery regression and the
// native replacement for the `test_http_capsule_serve.sh` bash hold-out
// (test-infra Phase 3, epic #842 / #1381).
//
// Background. #1387: a built `serve` server on macOS arm64 accepted
// connections and framed well-formed responses, but the handler saw an
// empty `Request` (`method=""`, `path=""`, `headers.length==0`,
// `body=""`) — every route 404'd. The empty-`Request` symptom was an
// empty/zero-length-string symptom in the `* u8`-request → typed-`Request`
// path, fixed by the SfnString-ABI string-helper ports (#1401 et al.); the
// accept loop / recv path in `runtime/sfn/concurrency/serve.sfn` was never
// the bug. Nothing guarded request delivery on macOS because the only
// behavioral coverage was a Linux-oriented bash script driven by a Python
// socket client — exactly the gap this test closes.
//
// Why this could not be a `sfn/test` before. The behavioral checks in
// `test_http_capsule_serve.sh` start a backgrounded BLOCKING `serve`
// server and drive it with a socket client. The "native server-loopback
// e2e pattern" was the missing capability. It is
// now expressible: the server runs as a background subprocess (a handle,
// not a synchronous drain), and a raw libc socket client — the proven
// `http.sfn::_connect_tcp` dual-sockaddr idiom, inlined here — drives it
// over loopback. `sfn/test`'s `with_background` owns the server's
// lifetime: `serve()` never returns, so it is SIGKILLed and reaped on
// scope exit, including when an assertion throws. That replaced an
// external `timeout`/`gtimeout` vehicle which was the only teardown
// mechanism and which made the whole test skip itself when neither binary
// was installed.
//
// Coverage (the four behavioral checks migrated from the bash script,
// plus the #1387 request-delivery assertions): request method + path
// reach the handler; `GET /` matches `req.path == "/"`; a POST
// Content-Length body is drained and echoed verbatim; a custom
// status + header reach the wire via the framed path; an over-cap
// Content-Length is rejected with a 500 (not a hang).
//
// Matchers note (#842): `sfn/test`'s `expect_*` matchers are `![pure]` and
// cannot be called from an `![io]` test; assert on the captured response
// text with `sfn/strings::contains` instead.
import { Env, env_from_current } from "sfn/os";
import { contains } from "sfn/strings";
import {
    Background,
    sfn_bin_path,
    wait_until,
    with_background
} from "sfn/test";

// ── libc memory + string + socket surface (test-local raw client) ──
// Prefixed `_lb_` so the file-local helpers never collide with the
// external-linkage runtime helpers of the same shape in `http.sfn` /
// `serve.sfn` (neither is linked into this test binary, but the prefix
// keeps that guarantee independent of link order).
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn realloc(ptr: *u8, new_size: usize) -> *u8;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

extern fn strlen(s: *u8) -> usize;

// `sfn_socket_open`, not the raw libc `socket` — on Windows every raw
// `socket()` call fails until `WSAStartup` runs in the process (SFN-1114):
// a probe of `socket(2, 1, 0)` here returns fd=-1 with
// `WSAGetLastError()` = 10093 (WSANOTINITIALISED). `sfn_socket_open`
// (`runtime/sfn/platform/socket_ops_windows.sfn`) is the runtime's socket
// creator and carries the `WSAStartup` call; its POSIX sibling
// (`socket_ops.sfn`) is a direct pass-through, so this is the correct
// symbol on every target, not a Windows-only substitution.
extern fn sfn_socket_open(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

extern fn send(sockfd: i32, buf: *u8, len: i64, flags: i32) -> i64;

extern fn recv(sockfd: i32, buf: *u8, len: i64, flags: i32) -> i64;

// `sfn_socket_close`, not the raw libc `close` — on Windows `close()` on a
// Winsock SOCKET is not an error return but a process-killing
// `__fastfail(0xC0000409)` (`socket_ops_windows.sfn:11-12`). The runtime
// helper routes to `closesocket` there and to `close` on POSIX
// (`socket_ops.sfn:101`), so it is correct on every target (SFN-1114).
extern fn sfn_socket_close(fd: i32) -> i32;

// `shutdown(fd, SHUT_WR=1)` — half-close the write side so the server's
// recv sees EOF (a truncated request, #1709) while the read side stays
// open to drain the server's 500 reply. Identical C ABI on both targets.
extern fn shutdown(sockfd: i32, how: i32) -> i32;

// The listening port for the loopback server. Fixed (this is the sole
// server-loopback test in the native e2e pool, so it does not collide
// under `--jobs N`); high + uncommon to avoid clashing with a developer's
// local services.
fn _lb_port() -> i64 { return 18790; }

// The same port as a string literal for the generated server source
// (int-to-string in the generated-source path is avoided). Must match
// `_lb_port()`.
fn _lb_port_str() -> string { return "18790"; }

// Child environment for the build + server subprocesses. The build LINKS
// a binary (clang + ld), which on macOS needs the full toolchain
// environment (the SDK / library search path) — threading just
// PATH/HOME/TMPDIR (enough for the emit-only gate test) leaves the linker
// unable to resolve `-lm`. `run_capture`/`spawn_with_env`'s empty env is
// the EMPTY environment, not "inherit", so snapshot the parent's full
// environment via `process.environ()` (the propagation idiom from
// `process_environ_test.sfn`). SAILFIN_TEST_SCRATCH is already in there
// (the runner sets it), keeping the nested build cache per-invocation
// under the parallel pool (`.claude/rules/no-bash-e2e.md`).
fn _child_env() -> string[] ![io] { return process.environ(); }

// The same environment in `sfn/os`'s typed form, for the `sfn/test`
// fixtures that take an `Env` rather than a flat array. `env_from_current`
// is the typed equivalent of the `process.environ()` snapshot above; the
// two are kept side by side because the raw `process.run_capture` calls
// below still take the flat form.
fn _child_env_typed() -> Env ![io] { return env_from_current(); }

// ── raw loopback client (inlined `http.sfn::_connect_tcp` idiom) ──
// Effect note: `sfn_socket_open` lives in `socket_ops.sfn`, which is
// `net`-gated (`runtime/capsule.toml` `[sfn-source-gates]`) — a binary
// referencing it without declaring `![net]` fails to link
// (`ld.lld: undefined symbol: sfn_socket_open`, SFN-927). So `_lb_connect`
// and every caller up to `_lb_request`/`_lb_fire_and_close`/
// `_lb_request_halfclose`/`_await_ready`/the test itself declare `![net]`
// transitively.
fn _lb_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

// Connect a stream socket to `127.0.0.1:port`. Tries both `sockaddr_in`
// byte layouts (Linux u16 sin_family at 0; macOS/BSD u8 sin_len at 0 +
// u8 sin_family at 1), first success wins — the wrong-layout attempt
// fails fast (EAFNOSUPPORT) without connecting. Returns the connected fd
// or -1. Identical rationale to `http.sfn::_connect_tcp`.
fn _lb_connect(port: i64) -> i32 ![net] {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_lb_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_lb_ptr_off(addr, 0), 16, 1 as usize);
            memset(_lb_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_lb_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_lb_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        // sin_addr = 127.0.0.1
        memset(_lb_ptr_off(addr, 4), 127, 1 as usize);
        memset(_lb_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

fn _lb_send_all(fd: i32, buf: *u8, total: i64) -> bool {
    let mut sent: i64 = 0;
    loop {
        if sent >= total { break; }
        let n: i64 = send(fd, _lb_ptr_off(buf, sent), total - sent, 0);
        if n <= 0 { return false; }
        sent = sent + n;
    }
    return true;
}

// Drain to EOF (the server frames `Connection: close`, so it closes after
// the response) and return the bytes as a string. The buffer is
// intentionally not freed: `* u8 as string` aliases the pointer (no copy),
// and the test process is short-lived — freeing would dangle the string.
fn _lb_recv_all(fd: i32) -> string {
    let mut capacity: i64 = 8192;
    let mut len: i64 = 0;
    let mut buf: *u8 = malloc((capacity + 1) as usize);
    if buf as i64 == 0 { return ""; }
    let chunk: i64 = 8192;
    loop {
        if len + chunk > capacity {
            let new_cap: i64 = capacity * 2;
            let new_buf: *u8 = realloc(buf, (new_cap + 1) as usize);
            if new_buf as i64 == 0 {
                free(buf);
                return "";
            }
            buf = new_buf;
            capacity = new_cap;
        }
        let n: i64 = recv(fd, _lb_ptr_off(buf, len), chunk, 0);
        if n < 0 {
            free(buf);
            return "";
        }
        if n == 0 { break; }
        len = len + n;
    }
    memset(_lb_ptr_off(buf, len), 0, 1 as usize);
    return buf as string;
}

// Open a fresh connection, send `request` verbatim, drain the response,
// and close. Returns "" on a connect/send failure (server not up yet).
fn _lb_request(port: i64, request: string) -> string ![net] {
    let fd: i32 = _lb_connect(port);
    if fd < 0 { return ""; }
    if !_lb_send_all(fd, request as *u8, strlen(request as *u8) as i64) {
        sfn_socket_close(fd);
        return "";
    }
    let resp = _lb_recv_all(fd);
    sfn_socket_close(fd);
    return resp;
}

// `_lb_fire_and_close(port, request)` — connect, send `request` (which may
// be empty), then close WITHOUT reading the response. The fire-and-forget
// shape for driving the server's error paths (empty / truncated
// connections, #1709) without blocking on a 500 the peer may never read:
// an empty send closes immediately (the server's first recv returns 0 —
// EOF — with no bytes), and a partial head is delivered then followed by
// FIN (the server reads the partial, then EOF before the `\r\n\r\n`
// terminator). Both take the worker's free-and-500 early-return path
// rather than a 10s recv-timeout wait. Returns true if the connection
// was established.
fn _lb_fire_and_close(port: i64, request: string) -> bool ![net] {
    let fd: i32 = _lb_connect(port);
    if fd < 0 { return false; }
    let n: i64 = strlen(request as *u8) as i64;
    if n > 0 { let _ = _lb_send_all(fd, request as *u8, n); }
    sfn_socket_close(fd);
    return true;
}

// `_lb_request_halfclose(port, request)` — send a deliberately truncated
// head, half-close the write side (SHUT_WR) so the server sees EOF before
// the `\r\n\r\n` terminator, then drain the reply. Unlike
// `_lb_fire_and_close`, this keeps the read side open to OBSERVE the
// server's response (a 500 for the truncated request, #1709). Returns the
// response text, or "" on a connect/send failure.
fn _lb_request_halfclose(port: i64, request: string) -> string ![net] {
    let fd: i32 = _lb_connect(port);
    if fd < 0 { return ""; }
    if !_lb_send_all(fd, request as *u8, strlen(request as *u8) as i64) {
        sfn_socket_close(fd);
        return "";
    }
    // SHUT_WR = 1: signal EOF to the server's recv while keeping the read
    // side open to drain its 500 response.
    shutdown(fd, 1);
    let resp = _lb_recv_all(fd);
    sfn_socket_close(fd);
    return resp;
}

// Lay out a consumer capsule that depends on `sfn/http` and routes a few
// paths so the loopback client can observe request delivery. Mirrors the
// bash hold-out's `write_app`; lives INSIDE the repo tree so workspace
// discovery resolves the `sfn/http` dependency.
fn _app_root() -> string { return "build/serve-loopback-e2e"; }

fn _write_server(port_str: string) -> string ![io] {
    let root = _app_root();
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/http-loopback-e2e-app\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"sfn/http serve loopback e2e consumer\"\n"
        + "\n"
        + "[dependencies]\n"
        + "\"sfn/http\" = \"*\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", "import { serve, Request, Response, not_found } from \"sfn/http\";\n"
        + "\n"
        + "fn handle(req: Request) -> Response {\n"
        + "    if strings_equal(req.path, \"/\") {\n"
        + "        return Response { status: 200, headers: [\"X-Root: 1\"], body: \"ROOT-OK\" };\n"
        + "    }\n"
        + "    if strings_equal(req.path, \"/secret\") {\n"
        + "        return Response { status: 403, headers: [\"X-Reason: nope\"], body: \"denied\" };\n"
        + "    }\n"
        + "    if strings_equal(req.path, \"/echo\") {\n"
        + "        return Response { status: 200, headers: [\"X-Echo: 1\"], body: req.body };\n"
        + "    }\n"
        + "    if strings_equal(req.path, \"/probe\") {\n"
        + "        return Response { status: 200, headers: [\"X-Probe: 1\"], body: \"M=\" + req.method + \";P=\" + req.path };\n"
        + "    }\n"
        + "    return not_found();\n"
        + "}\n"
        + "\n"
        + "fn main() -> int ![net, io] {\n"
        + "    serve(handle as * fn (Request) -> Response, "
        + port_str
        + ");\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

// A second consumer that drives the live server with the typed `sfn/http`
// `fetch` CLIENT and prints the parsed status / headers / body — the
// end-to-end half of the bash hold-out's check 4 (the client-side
// `parse_response` logic itself is unit-covered by
// `capsules/sfn/http/tests/wire_test.sfn`). Separate tree from the server
// so the two builds do not clobber each other.
fn _client_root() -> string { return "build/serve-loopback-e2e-client"; }

fn _write_fetch_client(port_str: string) -> string ![io] {
    let root = _client_root();
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn/http-loopback-e2e-client\"\n"
        + "version = \"0.0.1\"\n"
        + "description = \"sfn/http fetch client loopback e2e consumer\"\n"
        + "\n"
        + "[dependencies]\n"
        + "\"sfn/http\" = \"*\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = [\"io\", \"net\"]\n"
        + "\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"library\"\n");
    fs.writeFile(root + "/src/main.sfn", "import { fetch, Response } from \"sfn/http\";\n"
        + "\n"
        + "fn main() -> int ![net, io] {\n"
        + "    let no_headers: string[] = [];\n"
        + "    let resp = fetch(\"GET\", \"http://127.0.0.1:"
        + port_str
        + "/secret\", no_headers, \"\");\n"
        + "    if resp.status == 403 {\n"
        + "        print.info(\"FETCH_STATUS=403\");\n"
        + "    } else {\n"
        + "        print.info(\"FETCH_STATUS=other\");\n"
        + "    }\n"
        + "    let mut i = 0;\n"
        + "    loop {\n"
        + "        if i >= resp.headers.length { break; }\n"
        + "        print.info(\"FETCH_HEADER=\" + resp.headers[i]);\n"
        + "        i = i + 1;\n"
        + "    }\n"
        + "    print.info(\"FETCH_BODY=\" + resp.body);\n"
        + "    return 0;\n"
        + "}\n");
    return root + "/src/main.sfn";
}

// Compile a consumer to a standalone binary up front (a blocking,
// synchronous build), so the cold `sfn/http` compile happens ONCE here
// and is NOT inside the readiness window — a backgrounded `sfn run` would
// otherwise race a cold capsule build against the poll budget. Threads the
// full parent environment (the nested build links, needing the toolchain
// surface).
//
// #1789: deliberately NO `--work-dir` here. This is the sole
// `sfn/http`-consumer build in its CI e2e shard (`e2e-d`), so there is no
// sibling to isolate the shared `build/compiler/import-context/sfn/http`
// from — a private `--work-dir` would buy no isolation and only force a
// slower COLD build, adding CPU/memory pressure under the parallel pool
// that can starve this test's spawned server and blow the readiness poll.
// The unsharded-suite contention #1789 addressed came from a sibling
// test's destructive `rm -rf` of that shared path, which is now removed;
// warm build-vs-build on the shared path is tolerated (the `.sfn-asm`
// stage is atomic-rename published, #1333). Returns the binary path, or
// "" on a build failure.
fn _build_bin(main_path: string, bin: string) -> string ![io] {
    let exit = process.run_capture([sfn_bin_path(), "build", "-o", bin, main_path], _child_env());
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if exit != 0 { return ""; }
    return bin;
}

// The probe request, as a function rather than a local, so the readiness
// closure below captures only `port`.
fn _probe_req() -> string {
    return "GET /probe?x=1 HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n";
}

// Poll `GET /probe` until the prebuilt server answers (startup is just the
// binary launching + bind, ~1s — the cold compile already happened in
// `_build_bin`). Returns the response, or "" if it never came up within the
// budget.
//
// The budget is wall-clock (45s) rather than an attempt count: an attempt
// count silently changes meaning when the probe itself slows down, which is
// exactly what happens on a loaded CI runner. `wait_until` naps in-process
// between attempts — the previous form shelled `process.run(["sleep",
// "0.5"])`, paying a fork+exec per tick.
// The probe closure captures NOTHING — it reaches the port through the
// file-local `_lb_port()` rather than closing over a local. That is
// deliberate (SFN-843): a lambda capturing an enclosing `let` that has no
// type annotation and whose initializer is a call mistypes the capture's
// env slot as `i8*`, failing to lower while still passing `sfn check`.
// Calling a helper is not a capture, so this shape is unaffected. Take
// `port` as a parameter again once SFN-843 lands.
fn _await_ready() -> string ![clock, io, net] {
    let ready = wait_until(fn () -> boolean {
        let resp = _lb_request(_lb_port(), _probe_req());
        if resp.length == 0 { return false; }
        return contains(resp, "M=GET");
    }, 45000, 500);
    if !ready { return ""; }
    return _lb_request(_lb_port(), _probe_req());
}

test "serve loopback: macOS request delivery + framed behavioral round-trips" ![clock, io, net] {
    let main_path = _write_server(_lb_port_str());

    // Compile once (synchronously), then run the prebuilt server.
    let server_bin = _build_bin(main_path, _app_root() + "/server-bin");
    assert server_bin.length > 0;

    // `with_background` owns the blocking server's lifetime: it is killed
    // and reaped on scope exit, including when an assertion below throws.
    // This replaces the previous `timeout <secs>` argv vehicle, which was
    // the ONLY teardown mechanism and required an external
    // `timeout`/`gtimeout` binary — so the test used to skip itself
    // entirely on a host without coreutils, silently dropping every
    // assertion below on that platform. `handle_kill` (SFN-402) is what
    // makes real teardown possible; the skip is gone with it.
    //
    // The body captures NOTHING: `port` is re-derived from the file-local
    // `_lb_port()` inside rather than closed over. See `_await_ready` for
    // why capture is avoided in a body that also makes effectful calls.
    let _served = with_background([server_bin], _child_env_typed(), "", "serve-loopback", fn (server: Background) -> int {
        assert server.handle.handle_id != 0;
        let port = _lb_port();

        // Readiness + #1387 request delivery: method and path reach the
        // handler (the empty-Request symptom would yield "M=;P=").
        let probe_resp = _await_ready();
        print.info("[serve-loopback] probe: " + probe_resp);
        assert probe_resp.length > 0;
        assert contains(probe_resp, "HTTP/1.1 200");
        assert contains(probe_resp, "M=GET");
        // Query string is stripped from the path by the capsule parser.
        assert contains(probe_resp, "P=/probe");

        // GET / matches req.path == "/" (issue's pathlen=0 case).
        let root_resp = _lb_request(port, "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        print.info("[serve-loopback] root: " + root_resp);
        assert contains(root_resp, "HTTP/1.1 200");
        assert contains(root_resp, "ROOT-OK");

        // POST Content-Length body is drained and echoed verbatim.
        let body = "payload-ABC-123-END";
        let post_req = "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 19\r\nConnection: close\r\n\r\n"
            + body;
        let echo_resp = _lb_request(port, post_req);
        print.info("[serve-loopback] echo: " + echo_resp);
        assert contains(echo_resp, "HTTP/1.1 200");
        assert contains(echo_resp, "X-Echo: 1");
        assert contains(echo_resp, body);

        // Custom status + header reach the wire via the framed path.
        let secret_resp = _lb_request(port, "GET /secret HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        print.info("[serve-loopback] secret: " + secret_resp);
        assert contains(secret_resp, "HTTP/1.1 403");
        assert contains(secret_resp, "X-Reason: nope");
        assert contains(secret_resp, "denied");

        // Over-cap Content-Length is rejected with a 500 (not a hang): declare
        // 2 MiB (over the 1 MiB cap) but send only a partial body — the server
        // must reject on the declared length without waiting for the rest.
        // (The whole ~120-byte request lands in the socket buffer in a single
        // `send` before the server drains the head and closes, so `_lb_send_all`
        // does not race a SIGPIPE on the closed peer in practice.)
        let oversize_req = "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 2000000\r\nConnection: close\r\n\r\npartial";
        let oversize_resp = _lb_request(port, oversize_req);
        print.info("[serve-loopback] oversize: " + oversize_resp);
        assert contains(oversize_resp, "HTTP/1.1 500");

        // #1709: a truncated request (EOF before the `\r\n\r\n` terminator) is
        // rejected with a 500 — NOT moved into the handler as a malformed
        // request. Before the fix the partial buffer was handed to the handler
        // (which saw an unparseable head and 404'd); after it, the worker's
        // EOF early-return path frees the request buffer and sends a direct
        // 500. Asserting the 500 distinguishes the fixed behavior from the old
        // dispatch-the-garbage path.
        let trunc_resp = _lb_request_halfclose(port, "GET /probe HTTP/1.1\r\nHost: x");
        print.info("[serve-loopback] truncated: " + trunc_resp);
        assert contains(trunc_resp, "HTTP/1.1 500");

        // #1709: hammer the error paths — interleave empty (immediate-close)
        // and truncated (partial head + EOF) connections so each repeatedly
        // takes the worker's free-and-500 early-return path. A per-connection
        // request-buffer leak, a double-free, or a crash/hang on these paths
        // would destabilize the long-lived server; the post-storm valid
        // round-trip below proves it survived every error-path connection
        // intact. This is the achievable proxy for the RSS-stability criterion
        // — there is no in-process RSS probe, and the blocking server never
        // exits cleanly for an atexit LeakSanitizer pass (the focused, clean-
        // exit ASAN leak gate over `_serve_recv_request` lives in
        // `serve_request_leak_test.sfn`).
        let mut storm: i64 = 0;
        loop {
            if storm >= 40 { break; }
            let _e = _lb_fire_and_close(port, "");
            let _t = _lb_fire_and_close(port, "GET /probe HTTP/1.1\r\nHost: x");
            storm = storm + 1;
        }
        let post_storm = _lb_request(port, "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
        print.info("[serve-loopback] post-storm: " + post_storm);
        assert contains(post_storm, "HTTP/1.1 200");
        assert contains(post_storm, "ROOT-OK");

        // Typed `fetch` client round-trips status + headers from the live
        // server (the #1323 framed path, proven end-to-end through the
        // `sfn/http` client). The `sfn/http` capsule is already warm from the
        // server build, so this second build reuses it.
        let client_main = _write_fetch_client(_lb_port_str());
        let client_bin = _build_bin(client_main, _client_root() + "/client-bin");
        assert client_bin.length > 0;
        let fexit = process.run_capture([client_bin], _child_env());
        let fout = process.capture_take_stdout();
        let _ferr = process.capture_take_stderr();
        print.info("[serve-loopback] fetch-client: " + fout);
        assert fexit == 0;
        assert contains(fout, "FETCH_STATUS=403");
        assert contains(fout, "FETCH_HEADER=X-Reason: nope");
        assert contains(fout, "FETCH_BODY=denied");
        return 0;
    });

    // Best-effort cleanup of the consumer trees. The server itself was
    // already killed and reaped by `with_background` on scope exit.
    let _rm = process.run(["rm", "-rf", _app_root()]);
    let _rmc = process.run(["rm", "-rf", _client_root()]);
}
