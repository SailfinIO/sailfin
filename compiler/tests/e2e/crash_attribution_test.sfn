// compiler/tests/e2e/crash_attribution_test.sfn
//
// Regression for #1206: a test child that CRASHES (SIGSEGV on POSIX, an NT
// fault status on Windows — `_verdict_is_nt_crash_status`,
// `compiler/src/cli/verdict.sfn`) must
//   (a) be named in a `[test] FAIL:` line in human output,
//   (b) leave an in-flight `RUN  <test>` breadcrumb on stderr, and
//   (c) classify as `crash` via the shared classifier
//       (`compiler/src/cli/verdict.sfn::verdict_classify`) — never
//       `setup-error` (the original #1206 symptom, and also the
//       misattribution a Windows NT crash status hit before `verdict.sfn`
//       gained `_verdict_is_nt_crash_status`) and never `test-failure`.
//
// Parts (a)/(b) were delivered by #1303's `_emit_crash_diagnostic` /
// `_is_signal_exit`; this test pins the attribution and the classifier's
// `crash` arm so neither regresses.
//
// (c) is now asserted both ways: directly against the shared classifier,
// and end-to-end through a real `--verdict` trailer (SFN-1120), which is
// what lets a real SIGSEGV be observed traveling all the way through a
// verdict block rather than only proving the classifier maps 139 correctly
// in isolation. The raw exit code is deliberately not asserted alongside
// either form: POSIX encodes a crash as `128 + signal` while Windows
// encodes it as a sign-extended NT status, so asserting the classifier's
// OUTPUT — and now the trailer's `failure` field, which is derived from the
// same classifier — is the one assertion that states the same property on
// both platforms.
//
// Native e2e per `.claude/rules/no-bash-e2e.md`: drives subprocesses via
// `process.run_capture` and asserts on captured output with `sfn/strings`.
import { find } from "sfn/strings";
import {
    clean_runner_env,
    nested_runner_scratch,
    sfn_bin_path,
    with_tmp_dir
} from "sfn/test";

import { verdict_classify } from "../../src/cli/verdict";

// A fixture whose second test overflows the stack — non-tail recursion
// (work after the call) defeats TCO, so it faults with a stack-overflow
// crash (SIGSEGV on POSIX, STATUS_STACK_OVERFLOW on Windows) rather than
// looping into a timeout, and leaves no assertion record. The first test
// passes, so a correct runner names the *file* (the in-flight test within
// it is unrecoverable in JSON mode but visible via the `RUN` breadcrumb in
// human mode).
fn _crash_fixture_src() -> string {
    return "fn _deep(n: int) -> int {\n" + "    let x = _deep(n + 1);\n"
        + "    return x + 1;\n"
        + "}\n\n"
        + "test \"crash probe: passes first\" {\n"
        + "    assert 1 + 1 == 2;\n"
        + "}\n\n"
        + "test \"crash probe: stack overflow segv\" {\n"
        + "    let r = _deep(1);\n"
        + "    assert r == 0;\n"
        + "}\n";
}

// Per-child environment for the nested `sailfin test` spawn. Builds a clean
// top-level child environment via `clean_runner_env` (ambient
// PATH/HOME/TMPDIR for clang/linker, minus the parallel pool's per-child
// orchestration keys, with an isolated nested `SAILFIN_TEST_SCRATCH` —
// SFN-401), then:
//   - strips `SAILFIN_AGENT_REPORT`: when THIS suite runs under a parent
//     test invocation the pool exports it, and an inherited value would
//     change the nested child's own output shape.
//   - disables the signal-kill retry (`SAILFIN_TEST_RETRY=0`) so the
//     crash is observed once, deterministically (no doubled wall-clock).
fn _child_env() -> string[] ![io] {
    let raw = clean_runner_env(nested_runner_scratch("crash-attribution"));
    let mut e: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= raw.length { break; }
        let entry = raw[i];
        let is_report = find(entry, "SAILFIN_AGENT_REPORT=", 0) == 0;
        let is_retry = find(entry, "SAILFIN_TEST_RETRY=", 0) == 0;
        if !is_report && !is_retry { e.push(entry); }
        i += 1;
    }
    e.push("SAILFIN_TEST_RETRY=0");
    return e;
}

test "crash #1206: a fatal fault names the crashed file and classifies as crash" ![io] {
    let code = with_tmp_dir(fn (dir: string) -> int {
        let src = dir + "/crash_signal_probe.sfn";
        fs.writeFile(src, _crash_fixture_src());
        let exit = process.run_capture([sfn_bin_path(), "test", src, "--verdict"], _child_env());
        let out = process.capture_take_stdout();
        let err = process.capture_take_stderr();
        let combined = out + err;
        // (a) the crash is reported as a FAIL naming the crashed file.
        assert find(combined, "[test] FAIL:", 0) >= 0;
        assert find(combined, "crash_signal_probe.sfn", 0) >= 0;
        // (c) the shared classifier maps the crashed child's exit status
        // to `crash`, never `setup-error` (the #1206 symptom) or
        // `test-failure` — see the file header for why the raw exit code
        // itself is not asserted.
        assert verdict_classify(exit, "test") == "crash";
        // (c), end-to-end: a real SIGSEGV travels all the way through a
        // `--verdict` block to the trailer's `failure` field, not just
        // through the classifier in isolation (SFN-1120).
        assert find(combined, "===SAILFIN-RESULT===", 0) >= 0;
        assert find(combined, "\"host\":\"sfn test\"", 0) >= 0;
        assert find(combined, "\"failure\":\"crash\"", 0) >= 0;
        return 0;
    });
    assert code == 0;
}
