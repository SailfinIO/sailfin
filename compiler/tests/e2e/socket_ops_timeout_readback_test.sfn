// compiler/tests/e2e/socket_ops_timeout_readback_test.sfn
//
// SFN-927 regression: after `sfn_socket_set_timeouts(fd, 10)`, the
// effective `SO_RCVTIMEO` the kernel actually armed must read back as
// 10000ms, not 10ms. A duration-based assertion is flaky (no bound
// distinguishes a fast machine from a wrong unit) and a bare `recv < 0`
// assertion is blind to a unit mismatch — `socket_recv_timeout_test.sfn`
// already carries exactly that assertion and would still pass with the
// Winsock millisecond-DWORD bug present. Only a `getsockopt` readback of
// the value the kernel actually holds catches a 1000x unit error.
//
// Unlike `socket_recv_timeout_test.sfn` (which inlines its own POSIX
// `socket`/`close`/`recv`/`send`/`setsockopt`-timeout externs and so
// cannot run on a Windows host at all — POSIX `close` on a Winsock
// `SOCKET` fastfails the process with `0xC0000409`), this test routes
// creation, disposal, timeout arming, recv, and the readback itself
// through `platform/socket_ops.sfn`'s `sfn_socket_open`/
// `sfn_socket_close`/`sfn_socket_set_timeouts`/`sfn_socket_recv`/
// `sfn_socket_timeout_readback_ms` — the same symbols the shipped
// adapters use and that the Windows sibling gets right (SFN-927). Only
// `bind`/`listen`/`accept`/`connect`/`setsockopt` (for SO_REUSEADDR, a
// different option this bug never touched) stay raw externs, because
// `platform/socket_ops.sfn`'s own header establishes those are
// byte-compatible with POSIX on Windows.
//
// There is currently no Windows e2e CI leg (tracked separately — porting
// the raw-socket e2e tests and wiring one up is out of scope here), so
// this test exercises only the POSIX sibling today. It is written to run
// unmodified the moment that leg exists.
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

extern fn bind(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

extern fn listen(sockfd: i32, backlog: i32) -> i32;

extern fn accept(sockfd: i32, addr: *u8, addrlen: *i32) -> i32;

extern fn connect(sockfd: i32, addr: *u8, addrlen: i32) -> i32;

extern fn setsockopt(sockfd: i32, level: i32, optname: i32, optval: *u8, optlen: i32) -> i32;

extern fn sfn_socket_open(domain: i32, ty: i32, protocol: i32) -> i32;

extern fn sfn_socket_close(fd: i32) -> i32;

extern fn sfn_socket_set_timeouts(fd: i32, secs: i32) -> void;

extern fn sfn_socket_recv(fd: i32, buf: *u8, len: i64, flags: i32) -> i64;

extern fn sfn_socket_timeout_readback_ms(fd: i32) -> i64;

// Fixed loopback port for this test. Distinct from every other
// server-binding e2e test's port so the parallel `--jobs N` pool cannot
// collide (see `socket_recv_timeout_test.sfn`'s port-collision note,
// #1862): 18790-18795 and 18882-18886 are taken; 18796 is unshared.
fn _tr_port() -> i64 { return 18796; }

fn _tr_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

// Arm SO_REUSEADDR on the listening socket before `bind`, mirroring
// `serve.sfn::_serve_set_reuseaddr`. Not part of the SFN-927 fix (a
// different `setsockopt` option), so this stays a raw call.
fn _tr_set_reuseaddr(fd: i32) -> void {
    let optval: *u8 = malloc(4 as usize);
    if optval as i64 == 0 { return; }
    memset(optval, 0, 4 as usize);
    memset(_tr_ptr_off(optval, 0), 1, 1 as usize);
    setsockopt(fd, 1, 2, optval, 4);
    setsockopt(fd, 65535, 4, optval, 4);
    free(optval);
}

// Open a stream socket bound to `0.0.0.0:port` and listen, via
// `sfn_socket_open`/`sfn_socket_close` rather than raw `socket`/`close`.
// Tries both `sockaddr_in` byte layouts (Linux u16 sin_family at 0;
// macOS/BSD u8 sin_len at 0 + u8 sin_family at 1), first success wins.
// Returns the listening fd or -1.
fn _tr_bind_listen(port: i64) -> i32 {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 { return 0 - 1; }
        _tr_set_reuseaddr(fd);
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 {
            sfn_socket_close(fd);
            return 0 - 1;
        }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_tr_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_tr_ptr_off(addr, 0), 16, 1 as usize);
            memset(_tr_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_tr_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_tr_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        let rc: i32 = bind(fd, addr, 16);
        free(addr);
        if rc == 0 {
            if listen(fd, 16) == 0 { return fd; }
            sfn_socket_close(fd);
            return 0 - 1;
        }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

// Connect a stream socket to `127.0.0.1:port`, via `sfn_socket_open`.
// Dual sockaddr layout, first success wins. Returns the connected fd or
// -1.
fn _tr_connect(port: i64) -> i32 {
    let mut attempt: i64 = 0;
    loop {
        if attempt >= 2 { break; }
        let addr: *u8 = malloc(16 as usize);
        if addr as i64 == 0 { return 0 - 1; }
        memset(addr, 0, 16 as usize);
        if attempt == 0 {
            memset(_tr_ptr_off(addr, 0), 2, 1 as usize);
        } else {
            memset(_tr_ptr_off(addr, 0), 16, 1 as usize);
            memset(_tr_ptr_off(addr, 1), 2, 1 as usize);
        }
        memset(_tr_ptr_off(addr, 2), ((port >> 8) & 255) as i32, 1 as usize);
        memset(_tr_ptr_off(addr, 3), (port & 255) as i32, 1 as usize);
        // sin_addr = 127.0.0.1
        memset(_tr_ptr_off(addr, 4), 127, 1 as usize);
        memset(_tr_ptr_off(addr, 7), 1, 1 as usize);
        let fd: i32 = sfn_socket_open(2, 1, 0);
        if fd < 0 {
            free(addr);
            return 0 - 1;
        }
        let rc: i32 = connect(fd, addr, 16);
        free(addr);
        if rc == 0 { return fd; }
        sfn_socket_close(fd);
        attempt = attempt + 1;
    }
    return 0 - 1;
}

test "socket-ops: SO_RCVTIMEO readback matches the armed seconds budget, not a 1000x-off unit" ![io] {
    let port = _tr_port();
    let lfd = _tr_bind_listen(port);
    assert lfd >= 0;

    let cfd = _tr_connect(port);
    assert cfd >= 0;
    let sfd = accept(lfd, null, null);
    assert sfd >= 0;

    // Arm a 10s budget — the same value `http.sfn`/`net.sfn`/
    // `websocket.sfn`/`serve.sfn` use in production.
    sfn_socket_set_timeouts(cfd, 10);

    // The load-bearing assertion: readback must be 10000ms, not 10ms
    // (the Winsock DWORD-vs-timeval bug) and not -1 (setsockopt failed
    // silently).
    let readback_ms: i64 = sfn_socket_timeout_readback_ms(cfd);
    print.info("[socket-ops-readback] SO_RCVTIMEO readback_ms=" + (readback_ms as string));
    assert readback_ms == 10000;

    // Pair the readback with a negative-return assertion routed through
    // `sfn_socket_recv` so the recv-width defect (a `-1` truncating to
    // `4294967295` on Windows) is covered by the same test: the server
    // stays silent, so the client's recv must observe the armed timeout
    // as a genuine negative return.
    let buf: *u8 = malloc(64 as usize);
    assert buf as i64 != 0;
    let n: i64 = sfn_socket_recv(cfd, buf, 64, 0);
    print.info("[socket-ops-readback] silent recv n=" + (n as string));
    assert n < 0;

    free(buf);
    sfn_socket_close(cfd);
    sfn_socket_close(sfd);
    sfn_socket_close(lfd);
}
