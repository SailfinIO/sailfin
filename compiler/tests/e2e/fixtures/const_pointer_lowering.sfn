// Fixture for compiler/tests/e2e/const_pointer_lowering_test.sfn.
//
// SFN-1290 / SFEP-0079 §3.2: `*const T` lowered to `i8*` instead of `T*`, so
// a deref of `*const i32` loaded only one byte. Separately, `x as *const T`
// and `x as *mut T` failed to parse and died closed at E0818. This fixture
// writes a 4-byte `i32` (300 = 0x12C) through a plain `*i32` and reads it
// back through `*const i32`/`*mut i32` parameters and casts, plus a
// `*const W` struct-field store. 300 is load-bearing: it does not fit in one
// byte, so a stray one-byte load reads back 44 (0x2C) instead — any value
// under 256 would not catch the bug.
extern fn malloc(size: usize) -> *u8;

extern fn memset(p: *u8, v: i32, n: usize) -> *u8;

// `next`/`ro` are load-bearing: struct field annotations go through
// `normalize_layout_field_type`, which collapses whitespace out of pointer
// types, so a qualifier must be stripped before that collapse or the field
// lowers as `i8*` (SFN-1290). A plain `*W` field would not exercise it.
struct W {
    v: i32;
    next: *mut W;
    ro: *const i32;
}

fn rd_const(c: *const i32) -> i32 { return *c; }

fn rd_plain(c: *i32) -> i32 { return *c; }

fn rd_mut(c: *mut i32) -> i32 { return *c; }

fn wr_const_field(w: *const W) -> void { w.v = 7; }

fn main() ![io] {
    let raw: *u8 = malloc(64 as usize);
    let _z: *u8 = memset(raw, 0, 64 as usize);
    let q: *i32 = raw as *i32;
    *q = 300;
    print("plain=${rd_plain(q)} const=${rd_const(q)} mut=${rd_mut(q)}");
    let c: *const i32 = raw as *const i32;
    let m: *mut i32 = raw as *mut i32;
    print("cast_const=${*c} cast_mut=${*m}");
    let w: *W = raw as *W;
    wr_const_field(w);
    print("field=${w.v}");
}
