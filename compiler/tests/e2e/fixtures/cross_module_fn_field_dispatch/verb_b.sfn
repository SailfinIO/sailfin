// Same shape, but the field's signature takes a named struct parameter, so
// this also covers the E0840 pointer-width relaxation (SFN-1161).
import { Ctx, StructVerb } from "./registry";

fn b_run(c: Ctx) -> int ![io] {
    print("b-ok");
    return c.id;
}

fn b_verb() -> StructVerb ![io] {
    return StructVerb { name: "b", run: b_run };
}

export { b_verb }
