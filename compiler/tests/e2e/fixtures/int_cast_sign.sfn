// Fixture for `int_cast_sign_test.sfn` (SFN-503): every `as` conversion
// whose opcode depends on the operand's or target's source-level sign.
//
// `u8`-typed values are printed after widening to `int` because string
// concat renders a byte-width value as a character, not a number — the
// widening is itself one of the conversions under test.
//
// Every case here casts a local. The parameter-binding half of
// `_cast_operand_source_type` is covered at the IR level by
// `numeric_cast_test.sfn`, and the sized-integer call boundary it depends on
// is covered at runtime by `narrow_int_params_test.sfn` (SFN-571).
fn main() -> int ![io] {
    // Widening from an unsigned source must zero-extend: `sext i8 -1` would
    // make this -1 instead of 255.
    let b: u8 = 255;
    let w: u64 = b as u64;
    print("u8_max_to_u64=" + w);

    // Widening from a signed source still sign-extends.
    let s: i8 = -1;
    let sw: i64 = s as i64;
    print("i8_neg1_to_i64=" + sw);

    // A u32 with bit 31 set must not go negative when widened.
    let hi: u32 = 4000000000;
    let hw: u64 = hi as u64;
    print("u32_hibit_to_u64=" + hw);

    // Truncation is sign-independent: 300 & 0xFF == 44.
    let n: u16 = 300;
    let t: u8 = n as u8;
    let tv: int = t as int;
    print("u16_300_to_u8=" + tv);

    // float → unsigned int selects the saturating unsigned intrinsic.
    let f: f64 = 3.5;
    let fu: u32 = f as u32;
    let fv: int = fu as int;
    print("f64_to_u32=" + fv);

    // unsigned int → float selects `uitofp`; `sitofp` would yield a
    // negative. Compared rather than printed so the assertion does not
    // depend on f64 formatting.
    let uf: u32 = 4000000000;
    let ufd: f64 = uf as f64;
    let mut uf_sign: string = "negative";
    if ufd > 0.0 { uf_sign = "positive"; }
    print("u32_hibit_to_f64=" + uf_sign);

    return 0;
}
