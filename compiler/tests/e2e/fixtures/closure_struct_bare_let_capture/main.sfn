// compiler/tests/e2e/fixtures/closure_struct_bare_let_capture/main.sfn
//
// SFN-1126 regression pin — the BARE-`let` (no type annotation) struct
// capture shape, which already worked before the fix and must keep
// working: a lambda closes over a struct held in an un-annotated `let`
// local (contrast `closure_struct_param_capture`, the by-value-parameter
// shape that was broken).
//
// Expected stdout: 42 (3 array elements + tag 39).
struct Box {
    inner: int[],
    tag: int
}

fn run_it(f: fn () -> int) -> int { return f(); }

fn main() ![io] {
    let v: int[] = [1, 2, 3];
    let b = Box { inner: v, tag: 39 };
    print(run_it(fn () -> int { return b.inner.length + b.tag; }));
}
