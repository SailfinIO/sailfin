// End-to-end regression test for SFN-1009 — `fs.writeFile` / `fs.appendFile`
// now route through `sfn_fs_write_file_lv` / `sfn_fs_append_file_lv`, whose
// `{i8*, i64}` parameter shape carries the caller's byte length instead of
// dropping it at an `extractvalue` and re-deriving it with `strlen` at the
// bare-`i8*` originals. Pins, end-to-end:
//   1. emit shape — the adapter still defines both length-carrying twins.
//   2. soundness  — the twins write exactly `len` bytes, including a payload
//                   with an interior NUL, which no pure-`.sfn` path can
//                   produce today (a Sailfin `string` cannot hold an interior
//                   NUL). The hazard is synthesized directly via a C harness,
//                   mirroring `string_cstr_boundary_test.sfn`'s pattern.
//   3. truncation — a zero-length write still truncates the destination to
//                   0 bytes rather than leaving stale content.
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]`, so
// they cannot be called from an `![io]` test — use `sfn/strings`, as the
// sibling `runtime_adapter_filesystem_test.sfn` does.
import {
    contains,
    find,
    split,
    starts_with
} from "sfn/strings";
import { default_scratch_dir, run_external_c_oracle, sfn_bin_path } from "sfn/test";

// `run_capture`'s empty array is the *empty* environment; thread what the
// toolchain needs. Mirrors `_child_env` in `runtime_adapter_filesystem_test.sfn`.
fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/sfn-fs-write-carry-length";
    fs.createDirectory(dir, true);
    return dir;
}

fn _filesystem_path() -> string ![io] {
    let configured = env.get("SAILFIN_REPO_ROOT");
    if configured.length > 0 {
        return configured + "/runtime/sfn/adapters/filesystem.sfn";
    }
    return "runtime/sfn/adapters/filesystem.sfn";
}

fn _emit_filesystem_ll() -> string ![io] {
    let dir = _scratch_dir();
    let ll = dir + "/filesystem.ll";
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", ll, "llvm", _filesystem_path()], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    assert exit == 0;
    return ll;
}

fn _has_define_named(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "define ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// The C harness. `main` receives the scratch path via argv[1] — never
// spliced into the generated source text, per SFN-1001
// (`fs_copy_binary_test.sfn`): a Windows scratch dir is a backslash path,
// and a literal `+ dir +` here would silently corrupt it.
//
// The payload `"AB\0CD"` (5 content bytes, interior NUL at index 2) is the
// hazard neither `sfn_fs_write_file` nor a pure-`.sfn` string literal can
// carry — a Sailfin `string` has no interior-NUL representation, and the
// bare-`i8*` original truncates at the first zero byte via `strlen`. The
// `_lv` twins must write and append all 5 bytes regardless.
// The emitted `.ll` carries EVERY sfn_fs_* export, not just the two
// functions under test, so the linker demands a resolution for every extern
// any of them reference — including the non-libc runtime helpers
// (`sfn_fd_write`, `sailfin_runtime_concat_v2`, `sailfin_runtime_append_string_v2`,
// `sfn_str_from_codepoint`, `_sfn_fs_access_exec_mode`) and the Windows-only
// APIs (`GetFileAttributesA`, `FindFirstFileA`, `FindNextFileA`, `FindClose`)
// that have no Linux provider. `main` never calls these; they exist only to
// satisfy the linker, mirroring `string_cstr_boundary_test.sfn`'s stub set.
fn _harness_c() -> string {
    return "#include <stdio.h>\n" + "#include <string.h>\n"
        + "#include <stdlib.h>\n"
        + "extern void  sfn_fs_write_file_lv(const char*,const char*,long long);\n"
        + "extern _Bool sfn_fs_append_file_lv(const char*,const char*,long long);\n"
        + "long long sfn_fd_write(int fd,const char* buf,unsigned long count){(void)fd;(void)buf;(void)count;return 0;}\n"
        + "void* sailfin_runtime_concat_v2(void* a,void* b){(void)a;(void)b;return 0;}\n"
        + "void* sailfin_runtime_append_string_v2(void* a,void* t){(void)a;(void)t;return 0;}\n"
        + "char* sfn_str_from_codepoint(long long cp){(void)cp;return 0;}\n"
        + "int _sfn_fs_access_exec_mode(void){return 1;}\n"
        + "int GetFileAttributesA(const char* p){(void)p;return -1;}\n"
        + "void* FindFirstFileA(const char* p,void* d){(void)p;(void)d;return 0;}\n"
        + "int FindNextFileA(void* h,void* d){(void)h;(void)d;return 0;}\n"
        + "int FindClose(void* h){(void)h;return 1;}\n"
        + "void  sailfin_runtime_mark_persistent(void* p){(void)p;}\n"
        + "void  sfn_type_register(void* d){(void)d;}\n"
        + "void* sfn_alloc_struct(long n){return malloc((size_t)n);}\n"
        + "static int check_size(const char* path, long expected){\n"
        + "  FILE* f = fopen(path, \"rb\");\n"
        + "  if(!f){ printf(\"open FAIL\\n\"); return 0; }\n"
        + "  fseek(f, 0, SEEK_END);\n"
        + "  long sz = ftell(f);\n"
        + "  fclose(f);\n"
        + "  if(sz != expected){ printf(\"size FAIL got=%ld want=%ld\\n\", sz, expected); return 0; }\n"
        + "  return 1;\n"
        + "}\n"
        + "static int check_bytes(const char* path, const char* want, long len){\n"
        + "  FILE* f = fopen(path, \"rb\");\n"
        + "  if(!f){ printf(\"open FAIL\\n\"); return 0; }\n"
        + "  char buf[64];\n"
        + "  long n = (long)fread(buf, 1, (size_t)len, f);\n"
        + "  fclose(f);\n"
        + "  if(n != len){ printf(\"read FAIL got=%ld want=%ld\\n\", n, len); return 0; }\n"
        + "  if(memcmp(buf, want, (size_t)len) != 0){ printf(\"bytes FAIL\\n\"); return 0; }\n"
        + "  return 1;\n"
        + "}\n"
        + "int main(int argc, char** argv){\n"
        + "  if(argc < 2){ printf(\"missing-arg\\n\"); return 2; }\n"
        + "  char path[4096];\n"
        + "  snprintf(path, sizeof(path), \"%s/carry_length.bin\", argv[1]);\n"
        + "  int ok = 1;\n"
        + "  char payload[] = { 'A', 'B', '\\0', 'C', 'D' };\n"
        + "  sfn_fs_write_file_lv(path, payload, 5);\n"
        + "  if(!check_size(path, 5)){ ok = 0; }\n"
        + "  if(!check_bytes(path, payload, 5)){ ok = 0; }\n"
        + "  if(!sfn_fs_append_file_lv(path, payload, 5)){ printf(\"append rc FAIL\\n\"); ok = 0; }\n"
        + "  if(!check_size(path, 10)){ ok = 0; }\n"
        + "  sfn_fs_write_file_lv(path, payload, 0);\n"
        + "  if(!check_size(path, 0)){ ok = 0; }\n"
        + "  printf(ok ? \"ALL OK\\n\" : \"SOME FAIL\\n\");\n"
        + "  return ok ? 0 : 1;\n"
        + "}\n";
}

test "filesystem.sfn emit: defines the length-carrying write/append twins" ![io] {
    let ll = _emit_filesystem_ll();
    let ir = fs.readFile(ll);
    assert _has_define_named(ir, "sfn_fs_write_file_lv");
    assert _has_define_named(ir, "sfn_fs_append_file_lv");
}

// ---- soundness: writes exactly `len` bytes, incl. an interior NUL (C harness via clang) ----
test "sfn_fs_write_file_lv / sfn_fs_append_file_lv carry the caller's byte length" ![io] {
    let dir = _scratch_dir();
    let ll = _emit_filesystem_ll();
    let harness = dir + "/carry_length_harness.c";
    fs.writeFile(harness, _harness_c());
    let bin = dir + "/carry_length_harness";
    // The shared optional-oracle boundary skips only when no configured host
    // compiler can run. A compile/link failure after resolution remains a
    // hard regression rather than silently disabling this soundness gate.
    let clang_exit = run_external_c_oracle(["-Wno-override-module", harness, ll, "-o", bin, "-lm"]);
    let _co = process.capture_take_stdout();
    let clang_err = process.capture_take_stderr();
    if clang_exit != 0 {
        print("carry-length harness failed to link (exit=" + _int_to_string(clang_exit)
            + ")");
        print(clang_err);
    }
    assert clang_exit == 0;

    let run_exit = process.run_capture([bin, dir], _child_env());
    let out = process.capture_take_stdout();
    let run_err = process.capture_take_stderr();
    if run_exit != 0 {
        print("carry-length harness exited " + _int_to_string(run_exit));
        print(out);
        print(run_err);
    }
    assert run_exit == 0;
    assert find(out, "ALL OK", 0) >= 0;
}

fn _int_to_string(n: int) -> string {
    if n == 0 { return "0"; }
    let mut v = n;
    let mut neg = false;
    if v < 0 {
        neg = true;
        v = -v;
    }
    let mut digits = "";
    let table = "0123456789";
    loop {
        if v <= 0 { break; }
        digits = table[v % 10] + digits;
        v = v / 10;
    }
    if neg { return "-" + digits; }
    return digits;
}
