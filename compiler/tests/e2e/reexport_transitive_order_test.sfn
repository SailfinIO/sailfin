// End-to-end regression test for SFN-779.
//
// `llvm/imports.sfn`'s import-graph BFS enqueued plain-import edges at
// `depth + 1` but inline re-export (`.export`) edges at the parent's SAME
// depth, and only depth-0 modules keep their full native text (including
// `.fn` signatures). The `seen` dedup keyed on module slug alone and
// recorded whichever depth was dequeued FIRST rather than the MINIMUM
// depth reached — so a module first reached transitively (depth >= 1, text
// dropped) and only later re-reached via a re-export at depth 0 kept its
// empty text. Its signatures never entered `imported_functions`, producing
// `E1007: cannot resolve return type for call to X` and a cascading
// `E1002` on the enclosing `let`.
//
// The bug is import-order dependent (see `fixtures/reexport_transitive_order/
// main.sfn`), so this test asserts the fixture BUILDS AND RUNS — `sfn check`
// alone passes even when this is broken, which is the entire point (the
// check-is-not-a-build-guarantee class, #1389).
import { trim_right } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch } from "sfn/test";

// The compiler-under-test: `$SAILFIN_BIN` if set, else the self-hosted
// binary relative to the repo root the runner starts from. Mirrors
// `sfn/test`'s `_resolve_sfn_bin` so CI can point the test at any compiler.
fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

struct RunOut {
    exit: int;
    out: string;
}

// `sfn run` compiles+links+executes the fixture, so this spawns a nested
// runner: its env must have the parent pool's orchestration keys stripped
// and its own scratch dir, or the nested build binds to the parent's
// private state (`.claude/rules/no-bash-e2e.md`, SFN-401).
fn _run_fixture(path: string) -> RunOut ![io] {
    let child_env = clean_runner_env(nested_runner_scratch("reexport_transitive_order"));
    let exit = process.run_capture([_sfn_bin(), "run", path], child_env);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    return RunOut { exit: exit, out: trim_right(out) };
}

test "reexport transitive order: import-before-reexport chain builds and runs" ![io] {
    let r = _run_fixture("compiler/tests/e2e/fixtures/reexport_transitive_order/main.sfn");
    // Pre-fix this fails to build at all (E1007/E1002), so assert the exit
    // code separately from the output shape.
    assert r.exit == 0;
    let expected = "b:leaf\n" + "bool-yes-ok\n" + "bool-no-ok";
    assert r.out == expected;
}
