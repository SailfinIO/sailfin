// compiler/tests/e2e/perf_history_compare_test.sfn
//
// Regression coverage for `scripts/perf_history.sh` — the seed-scoped baseline
// (SFN-330), the whole-build budget boundary (SFN-421), and the consumer-build
// series (SFN-832 / SFEP-0070).
//
// On the seed-scoped baseline (SFN-330): the nightly perf-history job
// once filed one issue per module on a seed bump because the rolling-median
// baseline mixed samples from different pinned seeds; a new seed rebuilds
// every module with a different compiler binary, shifting all timings at once
// and tripping the +10% gate tree-wide. The compare now windows each module
// against same-seed samples only, so a seed change resets the baseline (a
// module falls through the per-module cold-start skip until N same-seed runs
// accrue) while a genuine same-seed regression is still caught.
//
// Drives the script as a subprocess (no bash e2e scripts — see
// .claude/rules/no-bash-e2e.md) and asserts on captured stdout/stderr.
import { contains } from "sfn/strings";
import { bash_path, git_bash_path, scratch_root } from "sfn/test";

fn _fixture_dir(name: string) -> string ![io] {
    return scratch_root() + "/perf-history-compare-test/" + name;
}

// The append/compare paths are pure shell/awk with no gh dependency, so bash
// plus the two coreutils they call (`awk` and `wc`) is all the child needs —
// thread PATH (and HOME/TMPDIR for good measure); run_capture's empty env is
// the EMPTY environment, not "inherit".
fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + bash_path(home)); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + bash_path(tmpdir)); }
    return e;
}

fn _header() -> string {
    return "run_sha,run_date,module,time_s,peak_kb,ir_lines,status,seed_version\n";
}

// Eight prior nightly runs (distinct shas = chronological order) at a stable
// 1.0s / 10000kb for both foo and bar, all produced by `seed`.
fn _prior_rows(seed: string) -> string {
    let mut s = "";
    let mut i = 1;
    loop {
        if i > 8 { break; }
        let day = number_to_string(i);
        s = s + "sha" + day + ",2026-07-01,foo,1.0,10000,500,OK," + seed + "\n";
        s = s + "sha" + day + ",2026-07-01,bar,1.0,10000,500,OK," + seed + "\n";
        i += 1;
    }
    return s;
}

fn _run_compare(dir: string) -> int ![io] {
    return process.run_capture([git_bash_path(), bash_path("scripts/perf_history.sh"), "compare", "--data-dir", bash_path(dir), "--sha", "cur", "--min-runs", "7", "--threshold-pct", "10", "--out", bash_path(dir
        + "/out.tsv")], _child_env());
}

fn _run_compare_budget(dir: string, budget: string) -> int ![io] {
    return process.run_capture([git_bash_path(), bash_path("scripts/perf_history.sh"), "compare", "--data-dir", bash_path(dir), "--sha", "cur", "--min-runs", "7", "--threshold-pct", "10", "--budget", budget, "--out", bash_path(dir
        + "/out.tsv")], _child_env());
}

// A `build.csv` whose only row is the current run, so the whole-build budget
// row is the sole thing the compare step can emit.
fn _write_budget_fixture(dir: string, wall: string, budget: string) -> void ![io] {
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/compile.csv", _header() + _prior_rows("0.8.0")
        + "cur,2026-07-12,foo,1.0,10000,500,OK,0.8.0\n"
        + "cur,2026-07-12,bar,1.0,10000,500,OK,0.8.0\n");
    fs.writeFile(dir + "/build.csv", "run_sha,run_date,build_wall_s,budget_s\n"
        + "cur,2026-07-12,"
        + wall
        + ","
        + budget
        + "\n");
}

test "perf-history: a seed bump resets baselines and files no regressions" ![io] {
    let dir = _fixture_dir("seedbump");
    fs.createDirectory(dir, true);
    // Prior runs under 0.7.0; current run under the bumped 0.8.0 with every
    // module 2x slower and 2x peak — a cross-seed comparison WOULD flag the
    // whole tree, but same-seed windowing leaves the current run with zero
    // baseline samples, so nothing is filed.
    let csv = _header() + _prior_rows("0.7.0")
        + "cur,2026-07-12,foo,2.0,20000,500,OK,0.8.0\n"
        + "cur,2026-07-12,bar,2.0,20000,500,OK,0.8.0\n";
    fs.writeFile(dir + "/compile.csv", csv);
    let exit = _run_compare(dir);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    // compare exits 0 on the no-regression path; a non-zero exit means the
    // script itself broke (bad flag, missing tool) and must fail the test
    // rather than be masked by a summary-text match.
    assert exit == 0;
    assert contains(out, "no regressions detected");
    assert contains(err, "seed changed");
}

test "perf-history: a same-seed regression is still caught" ![io] {
    let dir = _fixture_dir("sameseed");
    fs.createDirectory(dir, true);
    // Same seed throughout; foo jumps 1.0 -> 1.5 (+50%) while bar and every
    // peak_kb stay flat, so exactly one regression line (foo/time_s) is
    // written.
    let csv = _header() + _prior_rows("0.8.0")
        + "cur,2026-07-12,foo,1.5,10000,500,OK,0.8.0\n"
        + "cur,2026-07-12,bar,1.0,10000,500,OK,0.8.0\n";
    fs.writeFile(dir + "/compile.csv", csv);
    let exit = _run_compare(dir);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "1 regression line(s) written");
}

// The budget comparison is strict `>`, and `perf-history.yml`'s enforcement gate
// applies the same boundary to the same recorded number (SFN-421). Pinning it
// here keeps the two from drifting apart: a gate that failed where compare filed
// nothing (or the reverse) would contradict itself inside one job summary.
test "perf-history: wall time one second over the budget files a budget row" ![io] {
    let dir = _fixture_dir("budget-over");
    _write_budget_fixture(dir, "301", "300");
    let exit = _run_compare_budget(dir, "300");
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "1 regression line(s) written");
    // Row kind must be `budget`, not `rolling-median`: the budget row has no
    // median smoothing and no seed scoping, and reporting keys off column 1.
    let rows = fs.readFile(dir + "/out.tsv");
    assert contains(rows, "budget\t<whole-build>\tbuild_wall_s\t301.0\t300.0");
}

test "perf-history: wall time exactly at the budget files nothing" ![io] {
    let dir = _fixture_dir("budget-at");
    _write_budget_fixture(dir, "300", "300");
    let exit = _run_compare_budget(dir, "300");
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "no regressions detected");
}

// --- consumer-build series (SFN-832 / SFEP-0070) -----------------------------
// The raw shape `sfn bench --consumer --csv` writes: no run columns, which
// `append`'s `_append_tagged` prepends.
fn _consumer_raw_header() -> string {
    return "fixture,cold_s,warm_s,binary_bytes,ctors,modules_staged,cold_cache_misses,cache_hits,cache_misses,status,seed_version,platform\n";
}

fn _consumer_header() -> string {
    return "run_sha,run_date," + _consumer_raw_header();
}

// `count` prior nightly runs (distinct shas = chronological order) with the
// `hello` fixture pinned at the committed pre-filter baseline numbers
// (docs/perf/consumer-baseline.csv), all produced by seed 0.9.5.
fn _consumer_prior_rows(count: int) -> string {
    let mut s = "";
    let mut i = 1;
    loop {
        if i > count { break; }
        s = s + "sha" + number_to_string(i)
            + ",2026-08-01,hello,48.70,1.76,386848,32,34,68,68,0,ok,0.9.5,Linux x86_64\n";
        i += 1;
    }
    return s;
}

fn _write_consumer_fixture(dir: string, priors: int, current: string) -> void ![io] {
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/consumer.csv", _consumer_header()
        + _consumer_prior_rows(priors)
        + "cur,2026-08-12,hello,"
        + current
        + "\n");
}

fn _run_compare_consumer(dir: string) -> int ![io] {
    return process.run_capture([git_bash_path(), bash_path("scripts/perf_history.sh"), "compare", "--data-dir", bash_path(dir), "--sha", "cur", "--min-runs", "7", "--threshold-pct", "10", "--count-threshold-pct", "0", "--out", bash_path(dir
        + "/out.tsv")], _child_env());
}

// The reason the derived counts get their own threshold. 32 -> 35 constructors
// is +9.4% — inside the 10% band the wall-time metrics need to survive runner
// jitter, and therefore invisible if the counts shared it. `cold_s` is held
// flat so the row cannot have come from the timing metric.
test "perf-history: a consumer constructor rise inside the wall-time band is still caught" ![io] {
    let dir = _fixture_dir("consumer-ctors");
    _write_consumer_fixture(dir, 8, "48.70,1.76,386848,35,34,68,68,0,ok,0.9.5,Linux x86_64");
    let exit = _run_compare_consumer(dir);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "1 regression line(s) written");
    // Its own kind, never `rolling-median`: SFN-567 was a gate that reported one
    // comparison under another's label and hid the stricter one. The name is
    // namespaced for the same reason — a fixture and a module may share a name.
    let rows = fs.readFile(dir + "/out.tsv");
    assert contains(rows, "consumer-median\tconsumer/hello\tctors\t35\t32\t9.4");
}

// A standing gate is only useful if it stays quiet while its history is thin —
// a series that alerts on its first nights gets muted before it is ever right.
test "perf-history: a consumer series on thin history no-ops rather than alerting" ![io] {
    let dir = _fixture_dir("consumer-coldstart");
    // Three prior runs against --min-runs 7, and a current run doubled on every
    // metric: still nothing, because three points are not a baseline.
    _write_consumer_fixture(dir, 3, "99.00,1.76,773696,64,68,68,68,0,ok,0.9.5,Linux x86_64");
    let exit = _run_compare_consumer(dir);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "no regressions detected");
    assert contains(err, "consumer cold start");
}

// Binary size is recorded as evidence that dead-stripping keeps it flat, not as
// a signal (docs/perf/consumer-baseline.md). Comparing it would fire on changes
// the epic does not care about and dilute the metrics that do move.
test "perf-history: consumer binary growth alone files nothing" ![io] {
    let dir = _fixture_dir("consumer-size");
    _write_consumer_fixture(dir, 8, "48.70,1.76,773696,32,34,68,68,0,ok,0.9.5,Linux x86_64");
    let exit = _run_compare_consumer(dir);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "no regressions detected");
}

// A metric the harness could not derive is written as -1. Unavailable is not a
// measurement, so it must not alert.
test "perf-history: a consumer metric the harness could not derive does not alert" ![io] {
    let dir = _fixture_dir("consumer-noctor");
    _write_consumer_fixture(dir, 8, "48.70,1.76,-1,-1,34,68,68,0,ok+nostrip+noctor,0.9.5,Linux x86_64");
    let exit = _run_compare_consumer(dir);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "no regressions detected");
}

// The other half of the same rule, which the test above cannot reach: a -1 in a
// PRIOR run must not count as a baseline sample. Seven priors, one of which
// could not derive `ctors`, leaves six valid samples — one short of the seven
// required — so the fixture falls through the per-fixture cold start and files
// nothing despite `ctors` jumping 32 -> 35. Were the -1 counted, the window
// would be full and the jump would be compared against a baseline holding a
// non-measurement.
test "perf-history: an underived consumer sample does not count toward the window" ![io] {
    let dir = _fixture_dir("consumer-noctor-window");
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/consumer.csv", _consumer_header()
        + _consumer_prior_rows(6)
        + "sha7,2026-08-01,hello,48.70,1.76,386848,-1,34,68,68,0,ok+noctor,0.9.5,Linux x86_64\n"
        + "cur,2026-08-12,hello,48.70,1.76,386848,35,34,68,68,0,ok,0.9.5,Linux x86_64\n");
    let exit = _run_compare_consumer(dir);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "no regressions detected");
}

// The reason a missing compile.csv skips only the per-module comparison instead
// of returning: a run whose compile bench aborted before writing its CSV must
// still have its whole-build wall time judged. A per-module cold start
// swallowing a real budget breach is the SFN-421 failure with an extra step.
test "perf-history: a budget breach files even when the compile bench wrote no CSV" ![io] {
    let dir = _fixture_dir("budget-no-compile");
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/build.csv", "run_sha,run_date,build_wall_s,budget_s\n"
        + "cur,2026-07-12,301,300\n");
    let exit = _run_compare_budget(dir, "300");
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "1 regression line(s) written");
    let rows = fs.readFile(dir + "/out.tsv");
    assert contains(rows, "budget\t<whole-build>\tbuild_wall_s\t301.0\t300.0");
}

// The property the reporting path depends on: three comparisons over three
// series land in one TSV, each under its own kind, and none stands in for
// another. `perf-history.yml` counts findings as distinct (kind, name) pairs
// off exactly this output.
test "perf-history: three comparison kinds coexist without masking one another" ![io] {
    let dir = _fixture_dir("all-kinds");
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/compile.csv", _header() + _prior_rows("0.8.0")
        + "cur,2026-07-12,foo,1.5,10000,500,OK,0.8.0\n"
        + "cur,2026-07-12,bar,1.0,10000,500,OK,0.8.0\n");
    fs.writeFile(dir + "/build.csv", "run_sha,run_date,build_wall_s,budget_s\n"
        + "cur,2026-07-12,301,300\n");
    // `modules_staged` is held flat so the consumer series contributes exactly
    // one row and the total is unambiguous.
    fs.writeFile(dir + "/consumer.csv", _consumer_header()
        + _consumer_prior_rows(8)
        + "cur,2026-08-12,hello,48.70,1.76,386848,35,34,68,68,0,ok,0.9.5,Linux x86_64\n");
    let exit = _run_compare_budget(dir, "300");
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "3 regression line(s) written");
    let rows = fs.readFile(dir + "/out.tsv");
    assert contains(rows, "rolling-median\tfoo\ttime_s");
    assert contains(rows, "budget\t<whole-build>\tbuild_wall_s");
    assert contains(rows, "consumer-median\tconsumer/hello\tctors");
}

fn _run_append_consumer(dir: string, raw: string) -> int ![io] {
    return process.run_capture([git_bash_path(), bash_path("scripts/perf_history.sh"), "append", "--data-dir", bash_path(dir), "--sha", "cur", "--date", "2026-08-12", "--consumer", bash_path(raw)], _child_env());
}

// Re-running the nightly against an already-recorded commit must leave the
// series byte-identical, or the rolling median silently weights that commit
// twice and the same run alerts a second time.
test "perf-history: re-appending a commit's consumer rows is a no-op" ![io] {
    let dir = _fixture_dir("consumer-append");
    fs.createDirectory(dir, true);
    let raw = dir + "/raw.csv";
    let row = "hello,48.70,1.76,386848,32,34,68,68,0,ok,0.9.5,Linux x86_64\n";
    fs.writeFile(raw, _consumer_raw_header() + row);

    let first = _run_append_consumer(dir, raw);
    let _out1 = process.capture_take_stdout();
    let _err1 = process.capture_take_stderr();
    assert first == 0;

    let second = _run_append_consumer(dir, raw);
    let out2 = process.capture_take_stdout();
    let _err2 = process.capture_take_stderr();
    assert second == 0;
    assert contains(out2, "consumer rows for cur already present");

    // Exact content, not a substring: one header and one data row is the whole
    // claim, and a duplicate row would still satisfy a `contains`.
    let acc = fs.readFile(dir + "/consumer.csv");
    assert acc == _consumer_header() + "cur,2026-08-12," + row;
}
