// End-to-end test for runtime/sfn/adapters/filesystem.sfn — the
// Sailfin-native filesystem adapter (M3.1a #814 + M3.1b #815, epic #390).
//
// Native (no-bash) replacement for the former
// `test_runtime_adapter_filesystem.sh` (test-infra Phase 3, epic #842;
// `.claude/rules/no-bash-e2e.md`). Pins, end-to-end:
//   1. typecheck   — `sfn check` reports `ok` for filesystem.sfn and
//                    libc.sfn.
//   2. fmt         — both touched modules are fmt-canonical.
//   3. libc externs — libc.sfn declares the dir/stat externs the adapter
//                    routes through (stat/opendir/readdir/closedir/
//                    unlink/mkdir/rmdir).
//   4. emit shape  — the adapter emits a `define` for every sfn_fs_*
//                    export (read/write/append + delete/mkdir/list/
//                    read_bytes).
//   5. flip probes — compiled probes route fs.{readFile,writeFile,
//                    appendFile} (M3.1a) and fs.{listDirectory,deleteFile,
//                    createDirectory} (M3.1b) through @sfn_fs_*, and emit
//                    NO `call ... @sailfin_adapter_fs_*` legacy call site.
//   6. exports     — the compiler binary carries the defined sfn_fs_*
//                    text symbols.
//   7. manifest    — runtime/capsule.toml sfn-sources lists the adapter.
//   8. round-trips — write/read/append (incl. a multi-MB grow path) and
//                    createDirectory/listDirectory/deleteFile, exercised
//                    through a real `sfn build` + direct-exec link path
//                    (`sfn run` takes no fixture argv — `run.sfn:117-121`).
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]`, so
// they cannot be called from an `![io]` test. For subprocess/IR-output
// assertions use `sfn/strings`, as the runtime_string_basic exemplar does.
import {
    char_at_index,
    contains,
    ends_with,
    find,
    split,
    starts_with
} from "sfn/strings";
import {
    clean_runner_env,
    default_scratch_dir,
    sfn_bin_path,
    skip
} from "sfn/test";

// Derived by subtraction from the real environment rather than a
// hand-rolled allowlist (SFN-1114).
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/sfn-runtime-fs";
    fs.createDirectory(dir, true);
    return dir;
}

fn _emit_module(tag: string, module_path: string) -> string ![io] {
    let dir = _scratch_dir();
    let outpath = dir + "/" + tag + ".ll";
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", outpath, "llvm", module_path], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return "EMIT_FAILED"; }
    return fs.readFile(outpath);
}

fn _check_ok(module_path: string) -> boolean ![io] {
    let exit = process.run_capture([sfn_bin_path(), "check", module_path], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    if exit != 0 { return false; }
    return find(out + err, "ok", 0) >= 0;
}

fn _fmt_ok(module_path: string) -> boolean ![io] {
    let exit = process.run_capture([sfn_bin_path(), "fmt", "--check", module_path], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    return exit == 0;
}

fn _has_define_named(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "define ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn _is_word_char(ch: string) -> boolean {
    if ch.length == 0 { return false; }
    let word = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    return find(word, ch, 0) >= 0;
}

// `@sym\b` — does the IR reference the bare symbol at a word boundary?
// (matches the original's portable `@sym([^A-Za-z0-9_]|$)` delimiter.)
fn _references(ir: string, sym: string) -> boolean {
    let needle = "@" + sym;
    let mut pos = find(ir, needle, 0);
    loop {
        if pos < 0 { break; }
        let after = pos + needle.length;
        if after >= ir.length { return true; }
        let ch = char_at_index(ir, after);
        if !_is_word_char(ch) { return true; }
        pos = find(ir, needle, after);
    }
    return false;
}

// The first `call ... @sym(` line, or "" — lets a caller assert over the
// emitted operand types rather than only the symbol name.
fn _call_line(ir: string, sym: string) -> string {
    let lines = split(ir, "\n");
    let needle = "@" + sym + "(";
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if contains(line, "call ") && contains(line, needle) { return line; }
        i = i + 1;
    }
    return "";
}

// `call ... @sym(` on any line — a legacy C call site (declares are
// tolerated; only call sites are forbidden by the original).
fn _has_call_site(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    let needle = "@" + sym + "(";
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if find(line, "call ", 0) >= 0 && contains(line, needle) { return true; }
        i = i + 1;
    }
    return false;
}

// `^extern fn sym(` in the source text.
fn _source_declares_extern(source: string, sym: string) -> boolean {
    let lines = split(source, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        if starts_with(lines[i], "extern fn " + sym + "(") { return true; }
        i = i + 1;
    }
    return false;
}

// Locates the compiled runtime-native object for `module` — the bare
// filename a runtime/sfn source module mangles to
// (`sfn__runtime-native__<module>.sfn-<target>-<opt>.o` under
// `build/sailfin/`) — tolerant of the `<target>-<opt>` segment differing
// per host via a prefix match rather than the exact literal name. Returns
// "" when the tree has not been built yet, for the caller to `skip(...)`.
//
// Used in place of `sfn_bin_path()` for a symbol-presence assertion: on a
// native Windows host `lld-link` strips the COFF symbol table from the
// linked PE (`llvm-nm build/bin/sfn.exe` reports "no symbols"), while the
// object files retain it in exactly the `T`/`t` shape `_nm_has_defined`
// already parses. This is not a weakening — this test asserts a symbol is
// Sailfin-DEFINED at the bare name, and an object file answers that MORE
// precisely by naming which object defines it. Whether the symbol survived
// into the link is already guaranteed by the link itself: an unresolved
// symbol fails `lld-link`, so a binary that exists at all has it resolved
// (SFN-1114).
fn _runtime_object(module: string) -> string ![io] {
    let dir = "build/sailfin";
    if !fs.exists(dir) { return ""; }
    let prefix = "sfn__runtime-native__" + module + ".sfn-";
    let entries = fs.listDirectory(dir);
    let mut i = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        if starts_with(name, prefix) && ends_with(name, ".o") {
            return dir + "/" + name;
        }
        i = i + 1;
    }
    return "";
}

// `<space>T<space>_?sym` at end of an `nm` line (optional `_` for macOS).
//
// `llvm-nm` rather than `nm` because LLVM is already a hard toolchain
// dependency and reads ELF, Mach-O and COFF uniformly, whereas `nm` is
// absent on a native Windows host (SFN-1114).
fn _nm_has_defined(binary: string, sym: string) -> boolean ![io] {
    let exit = process.run_capture(["llvm-nm", binary], _child_env());
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return false; }
    let lines = split(out, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        let is_text = contains(line, " T ") || contains(line, " t ");
        if is_text && (ends_with(line, " " + sym) || ends_with(line, "_" + sym)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// A line in `\n`-joined `lines` equals `want` exactly (mirrors `grep -qx`).
fn _has_exact_line(text: string, want: string) -> boolean {
    let lines = split(text, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        if lines[i] == want { return true; }
        i = i + 1;
    }
    return false;
}

test "runtime/sfn/adapters/filesystem.sfn typechecks cleanly" ![io] {
    assert _check_ok("runtime/sfn/adapters/filesystem.sfn");
}

test "runtime/sfn/platform/libc.sfn typechecks cleanly with dir/stat externs" ![io] {
    assert _check_ok("runtime/sfn/platform/libc.sfn");
}

test "filesystem.sfn and libc.sfn are fmt-canonical" ![io] {
    assert _fmt_ok("runtime/sfn/adapters/filesystem.sfn");
    assert _fmt_ok("runtime/sfn/platform/libc.sfn");
}

test "libc.sfn declares stat/opendir/readdir/closedir/unlink/mkdir/rmdir" ![io] {
    let source = fs.readFile("runtime/sfn/platform/libc.sfn");
    assert _source_declares_extern(source, "stat");
    assert _source_declares_extern(source, "opendir");
    assert _source_declares_extern(source, "readdir");
    assert _source_declares_extern(source, "closedir");
    assert _source_declares_extern(source, "unlink");
    assert _source_declares_extern(source, "mkdir");
    assert _source_declares_extern(source, "rmdir");
}

test "filesystem emit: define for every sfn_fs_* export" ![io] {
    let ir = _emit_module("filesystem", "runtime/sfn/adapters/filesystem.sfn");
    assert ir != "EMIT_FAILED";
    assert _has_define_named(ir, "sfn_fs_read_file");
    assert _has_define_named(ir, "sfn_fs_write_file");
    assert _has_define_named(ir, "sfn_fs_append_file");
    // SFN-1009: the length-carrying twins that fs.writeFile/appendFile
    // now route through must be defined alongside the originals.
    assert _has_define_named(ir, "sfn_fs_write_file_lv");
    assert _has_define_named(ir, "sfn_fs_append_file_lv");
    assert _has_define_named(ir, "sfn_fs_delete");
    assert _has_define_named(ir, "sfn_fs_mkdir");
    assert _has_define_named(ir, "sfn_fs_list_dir");
    assert _has_define_named(ir, "sfn_fs_read_bytes");
    assert _has_define_named(ir, "sfn_fs_write_bytes");
}

test "probe routes fs.{readFile,writeFile,appendFile} through @sfn_fs_*" ![io] {
    let dir = _scratch_dir();
    let probe = dir + "/fs_probe.sfn";
    // SFN-1001: `dir` travels through argv[1], never spliced into source
    // text — on Windows it's a backslash path, and a literal `+ dir +`
    // here would silently corrupt it. Nothing rejects the fixture:
    // `decode_string_literal_escapes`
    // (`compiler/capsules/syntax/src/parser/utils.sfn:84-113`) handles
    // `\n \t \r \" \\ \$` and, for any OTHER escape, drops the backslash
    // and keeps the character — so `\U` decodes to `U`, `\A` to `A`, and
    // `\t` to a real TAB. The fixture compiles and runs against a
    // DIFFERENT path, which is why this had to be fixed structurally
    // rather than by escaping.
    fs.writeFile(probe, "fn main(argv: string[]) -> int ![io] {\n"
        + "    let dir = argv[1];\n"
        + "    fs.writeFile(dir + \"/sfn_fs_probe.txt\", \"hello world\");\n"
        + "    let content = fs.readFile(dir + \"/sfn_fs_probe.txt\");\n"
        + "    fs.appendFile(dir + \"/sfn_fs_probe.txt\", \" again\");\n"
        + "    return 0;\n"
        + "}\n");
    let ir = _emit_module("fs_probe", probe);
    assert ir != "EMIT_FAILED";
    assert _references(ir, "sfn_fs_read_file");
    assert _references(ir, "sfn_fs_write_file_lv");
    assert _references(ir, "sfn_fs_append_file_lv");
    // SFN-1009: the bare-`i8*` twins stay DEFINED (seed-built IR still
    // calls them) but must no longer be the target of a freshly emitted
    // call — that is what proves the length is carried rather than
    // dropped and re-derived with `strlen`.
    assert ! _has_call_site(ir, "sfn_fs_write_file");
    assert ! _has_call_site(ir, "sfn_fs_append_file");
    // SFN-1009: pin the operand SHAPE, not just the symbol. The twins
    // agree with the emitted `declare` only because a `{i8*, i64}`
    // by-value aggregate flattens to the same registers as the split
    // `(*u8, i64)` params the Sailfin body declares. `byval` would break
    // that — it passes the aggregate INDIRECTLY, so the body would read a
    // pointer-to-struct as its data pointer. Nothing else in the suite
    // would catch it, and on a target whose C ABI passes 16-byte
    // aggregates indirectly the failure is silent corruption, not a
    // link error.
    let write_call = _call_line(ir, "sfn_fs_write_file_lv");
    assert write_call != "";
    assert contains(write_call, "{i8*, i64}");
    assert ! contains(write_call, "byval");
    // Legacy C call sites must be gone (declares tolerated).
    assert ! _has_call_site(ir, "sailfin_adapter_fs_read_file");
    assert ! _has_call_site(ir, "sailfin_adapter_fs_write_file");
    assert ! _has_call_site(ir, "sailfin_adapter_fs_append_file");
}

test "probe routes fs.{listDirectory,deleteFile,createDirectory} through @sfn_fs_*" ![io] {
    let dir = _scratch_dir();
    let probe = dir + "/fs_probe_m31b.sfn";
    // SFN-1001: same rationale as the sibling probe above — argv[1]
    // carries `dir`, never the source text.
    fs.writeFile(probe, "fn main(argv: string[]) -> int ![io] {\n"
        + "    let dir = argv[1];\n"
        + "    fs.createDirectory(dir + \"/sfn_fs_probe_m31b/a/b\", true);\n"
        + "    fs.writeFile(dir + \"/sfn_fs_probe_m31b/note.txt\", \"x\");\n"
        + "    let entries = fs.listDirectory(dir + \"/sfn_fs_probe_m31b\");\n"
        + "    fs.deleteFile(dir + \"/sfn_fs_probe_m31b/note.txt\");\n"
        + "    return entries.length;\n"
        + "}\n");
    let ir = _emit_module("fs_probe_m31b", probe);
    assert ir != "EMIT_FAILED";
    assert _references(ir, "sfn_fs_list_dir");
    assert _references(ir, "sfn_fs_delete");
    assert _references(ir, "sfn_fs_mkdir");
    assert ! _has_call_site(ir, "sailfin_adapter_fs_list_directory_v2");
    assert ! _has_call_site(ir, "sailfin_adapter_fs_delete_file");
    assert ! _has_call_site(ir, "sailfin_adapter_fs_create_directory");
}

test "compiler binary exports the defined sfn_fs_* family" ![io] {
    let obj = _runtime_object("filesystem");
    if obj.length == 0 {
        skip("build/sailfin/sfn__runtime-native__filesystem.sfn-*.o not found — tree not built yet (SFN-1114)");
    }
    assert _nm_has_defined(obj, "sfn_fs_read_file");
    assert _nm_has_defined(obj, "sfn_fs_write_file");
    assert _nm_has_defined(obj, "sfn_fs_append_file");
    // SFN-1009: the length-carrying twins must be defined text symbols too.
    assert _nm_has_defined(obj, "sfn_fs_write_file_lv");
    assert _nm_has_defined(obj, "sfn_fs_append_file_lv");
    assert _nm_has_defined(obj, "sfn_fs_delete");
    assert _nm_has_defined(obj, "sfn_fs_mkdir");
    assert _nm_has_defined(obj, "sfn_fs_list_dir");
    assert _nm_has_defined(obj, "sfn_fs_read_bytes");
    assert _nm_has_defined(obj, "sfn_fs_write_bytes");
}

test "runtime/capsule.toml sfn-sources lists the filesystem adapter" ![io] {
    let manifest = fs.readFile("runtime/capsule.toml");
    let lines = split(manifest, "\n");
    let mut in_sources = false;
    let mut found = false;
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "sfn-sources = [") { in_sources = true; }
        if in_sources && contains(line, "\"sfn/adapters/filesystem.sfn\"") {
            found = true;
        }
        if in_sources && contains(line, "]") { in_sources = false; }
        i = i + 1;
    }
    assert found;
}

test "fs.writeFile / readFile / appendFile round-trip end-to-end" ![io] {
    let dir = _scratch_dir();
    let scratch_file = dir + "/round_trip.txt";
    let probe = dir + "/round_trip_probe.sfn";
    // SFN-1001: argv[1] carries the scratch dir; the fixture derives
    // `path` itself so no path is spliced into source text (a Windows
    // scratch dir is a backslash path — see the probe tests above).
    fs.writeFile(probe, "fn main(argv: string[]) -> int ![io] {\n"
        + "    if argv.length < 2 { print.error(\"missing-arg\"); return 2; }\n"
        + "    let path = argv[1] + \"/round_trip.txt\";\n"
        + "    fs.writeFile(path, \"first chunk\");\n"
        + "    let after_write = fs.readFile(path);\n"
        + "    print(after_write);\n"
        + "    fs.appendFile(path, \" plus appended\");\n"
        + "    let after_append = fs.readFile(path);\n"
        + "    print(after_append);\n"
        + "    return 0;\n"
        + "}\n");
    // Build then exec directly (rather than `sfn run`, which has no
    // argv-passthrough surface) so the scratch dir reaches the fixture
    // as argv[1]. Thread PATH + SAILFIN_TEST_SCRATCH (via _child_env) so
    // the linker resolves and program.ll stays per-invocation under the
    // parallel pool.
    // SFN-693: `-o` is honored verbatim on every target
    // (`compiler/src/build/target.sfn:248-253`), so the compiler never
    // adds the suffix here. Windows spawn sites call `CreateProcessA`
    // with `lpApplicationName = null`, which appends `.exe` when the
    // parsed name has none — an extensionless PE is unlaunchable. Named
    // `.exe` on every host: a POSIX ELF does not care about the suffix.
    let binpath = dir + "/round_trip_probe.exe";
    let build_exit = process.run_capture([sfn_bin_path(), "build", "-o", binpath, probe], _child_env());
    let _bo = process.capture_take_stdout();
    let _be = process.capture_take_stderr();
    assert build_exit == 0;
    let run_exit = process.run_capture([binpath, dir], _child_env());
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert run_exit == 0;
    // stdout: each print adds a trailing newline.
    assert _has_exact_line(out, "first chunk");
    assert _has_exact_line(out, "first chunk plus appended");
    // Final on-disk contents match the second read.
    let on_disk = fs.readFile(scratch_file);
    assert on_disk == "first chunk plus appended";
}

test "fs.createDirectory / listDirectory / deleteFile round-trip end-to-end" ![io] {
    let dir = _scratch_dir();
    let base = dir + "/m31b";
    let listing = dir + "/listing.txt";
    let listing2 = dir + "/listing2.txt";
    let probe = dir + "/m31b_probe.sfn";
    // SFN-1001: argv[1] carries the scratch dir; the fixture derives
    // base/listing/listing2 itself so no path is spliced into source text.
    fs.writeFile(probe, "fn main(argv: string[]) -> int ![io] {\n"
        + "    if argv.length < 2 { print.error(\"missing-arg\"); return 2; }\n"
        + "    let dir = argv[1];\n"
        + "    let base = dir + \"/m31b\";\n"
        + "    let listing = dir + \"/listing.txt\";\n"
        + "    let listing2 = dir + \"/listing2.txt\";\n"
        + "    fs.createDirectory(base + \"/x/y/z\", true);\n"
        + "    fs.writeFile(base + \"/alpha.txt\", \"a\");\n"
        + "    fs.writeFile(base + \"/beta.txt\", \"b\");\n"
        + "    let entries = fs.listDirectory(base);\n"
        + "    let mut i = 0;\n"
        + "    loop {\n"
        + "        if i >= entries.length { break; }\n"
        + "        fs.appendFile(listing, entries[i]);\n"
        + "        fs.appendFile(listing, \"\\n\");\n"
        + "        i = i + 1;\n"
        + "    }\n"
        + "    fs.deleteFile(base + \"/alpha.txt\");\n"
        + "    let after = fs.listDirectory(base);\n"
        + "    let mut j = 0;\n"
        + "    loop {\n"
        + "        if j >= after.length { break; }\n"
        + "        fs.appendFile(listing2, after[j]);\n"
        + "        fs.appendFile(listing2, \"\\n\");\n"
        + "        j = j + 1;\n"
        + "    }\n"
        + "    return 0;\n"
        + "}\n");
    // Build then exec directly so the scratch dir reaches the fixture as
    // argv[1] (`sfn run` has no argv-passthrough surface).
    // SFN-693: `-o` is honored verbatim on every target
    // (`compiler/src/build/target.sfn:248-253`), so the compiler never
    // adds the suffix here. Windows spawn sites call `CreateProcessA`
    // with `lpApplicationName = null`, which appends `.exe` when the
    // parsed name has none — an extensionless PE is unlaunchable. Named
    // `.exe` on every host: a POSIX ELF does not care about the suffix.
    let binpath = dir + "/m31b_probe.exe";
    let build_exit = process.run_capture([sfn_bin_path(), "build", "-o", binpath, probe], _child_env());
    let _bo = process.capture_take_stdout();
    let _be = process.capture_take_stderr();
    assert build_exit == 0;
    let run_exit = process.run_capture([binpath, dir], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    assert run_exit == 0;
    // Recursive mkdir materialized every parent component.
    assert fs.exists(base + "/x/y/z");
    // First enumeration sees both files plus the nested dir 'x'.
    let first = fs.readFile(listing);
    assert _has_exact_line(first, "alpha.txt");
    assert _has_exact_line(first, "beta.txt");
    assert _has_exact_line(first, "x");
    // delete removed alpha.txt from disk.
    assert ! fs.exists(base + "/alpha.txt");
    // Second enumeration drops alpha.txt but keeps beta.txt and x.
    let second = fs.readFile(listing2);
    assert ! _has_exact_line(second, "alpha.txt");
    assert _has_exact_line(second, "beta.txt");
    assert _has_exact_line(second, "x");
}

test "large-file round-trip exercises the chunked-read grow path" ![io] {
    let dir = _scratch_dir();
    let scratch_file = dir + "/large.bin";
    let expected_path = scratch_file + ".expected";
    // 512 lines x 64 bytes (incl. newline) = 32768 bytes — 8 realloc
    // passes from the 4 KiB initial capacity of sfn_fs_read_file.
    let line = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde";
    let mut payload = "";
    let mut k = 0;
    loop {
        if k >= 512 { break; }
        payload = payload + line + "\n";
        k = k + 1;
    }
    fs.writeFile(expected_path, payload);

    let probe = dir + "/large_probe.sfn";
    // SFN-1001: argv[1] carries the scratch dir; src/dst are derived
    // inside the fixture so no path is spliced into source text.
    fs.writeFile(probe, "fn main(argv: string[]) -> int ![io] {\n"
        + "    if argv.length < 2 { print.error(\"missing-arg\"); return 2; }\n"
        + "    let dir = argv[1];\n"
        + "    let src = dir + \"/large.bin.expected\";\n"
        + "    let dst = dir + \"/large.bin\";\n"
        + "    let payload = fs.readFile(src);\n"
        + "    fs.writeFile(dst, payload);\n"
        + "    let round_tripped = fs.readFile(dst);\n"
        + "    print(round_tripped);\n"
        + "    return 0;\n"
        + "}\n");
    // Build then exec directly so the scratch dir reaches the fixture as
    // argv[1] (`sfn run` has no argv-passthrough surface).
    // SFN-693: `-o` is honored verbatim on every target
    // (`compiler/src/build/target.sfn:248-253`), so the compiler never
    // adds the suffix here. Windows spawn sites call `CreateProcessA`
    // with `lpApplicationName = null`, which appends `.exe` when the
    // parsed name has none — an extensionless PE is unlaunchable. Named
    // `.exe` on every host: a POSIX ELF does not care about the suffix.
    let binpath = dir + "/large_probe.exe";
    let build_exit = process.run_capture([sfn_bin_path(), "build", "-o", binpath, probe], _child_env());
    let _bo = process.capture_take_stdout();
    let _be = process.capture_take_stderr();
    assert build_exit == 0;
    let run_exit = process.run_capture([binpath, dir], _child_env());
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    assert run_exit == 0;
    // `print` appends one trailing newline; payload already ends with one.
    assert out == payload + "\n";
    // On-disk write mirrors the payload byte-for-byte.
    let on_disk = fs.readFile(scratch_file);
    assert on_disk == payload;
}
