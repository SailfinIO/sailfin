// compiler/tests/e2e/process_relative_argv0_test.sfn
//
// SFN-1104: `process.run` and `process.run_capture` could not spawn a
// working-directory-relative `argv[0]` on a native Windows host.
//
// The Windows bodies called `CreateProcessA` with a NULL `lpApplicationName`
// (`runtime/sfn/platform/process_windows.sfn`), which makes it parse the
// module out of `lpCommandLine` and resolve it through a search that does NOT
// include the process working directory. Measured on a native Windows host
// before the fix, spawning one binary four ways: `build/bin/sfn.exe` and
// `build\bin\sfn.exe` both failed with `ERROR_FILE_NOT_FOUND` (2), while
// `./build/bin/sfn.exe` and the absolute path both succeeded — the leading
// `./` anchored it, not the slash direction.
//
// That is not a corner case here. `sfn_bin_path()`'s own unoverridden default
// IS this relative path, and `built_program_path()`
// (`compiler/src/build/source_fingerprint.sfn`) returns one too, so the
// post-build smoke check discarded a perfectly good compiler with exit 127
// and the rung-2 self-host gate could not be run on Windows at all.
//
// POSIX has always resolved this: `posix_spawnp` searches `PATH` only for a
// name with no separator and resolves anything else against the working
// directory. So this test passes on POSIX before and after, and is a Windows
// regression catcher — which is exactly the shape that would have caught it,
// since no test spawned a relative path on a Windows host.
//
// The other half of the fix — a BARE name still searching `PATH` — is not
// asserted here because no single bare executable name is guaranteed on all
// three CI hosts. It is covered continuously instead: every build in the
// repo spawns `clang` and `llvm-link` by bare name, so a regression there
// fails the build before it could reach a test.
//
// No-bash e2e (`.claude/rules/no-bash-e2e.md`): drives the compiler binary as
// a subprocess through the os capsule, with no shell.
import { contains } from "sfn/strings";
import {
    clean_runner_env,
    expect_eq_bool,
    expect_eq_int,
    nested_runner_scratch
} from "sfn/test";

// The compiler binary named RELATIVE to the working directory.
//
// Deliberately not `sfn_bin_path()`: that honours `SAILFIN_BIN`, which the
// pooled runner and every CI leg set to an absolute path, so reusing it would
// make this test silently vacuous in exactly the environments that gate
// merges. Probing for the suffix keeps it host-conditioned without importing
// the driver's `host_exe_name` across the capsule boundary that
// `compiler/tests/unit/compiler_capsule_boundary_test.sfn` ratchets.
fn _rel_sfn() -> string ![io] {
    if fs.exists("build/bin/sfn.exe") { return "build/bin/sfn.exe"; }
    return "build/bin/sfn";
}

// Not a skip-guard. Every `sfn/test` consumer already depends on a repo-root
// working directory, because `sfn_bin_path()`'s unoverridden default is this
// same relative path — so if this assertion ever fails, the cwd contract has
// moved under the whole e2e tier, not just under this file, and a silent skip
// here would hide that.
test "process: the relative compiler path this test spawns exists" ![io] {
    assert expect_eq_bool(fs.exists(_rel_sfn()), true).ok;
}

// The passthrough spawn — the path `built_program_path()`'s smoke check and
// `sfn run` both take.
test "process: run spawns a working-directory-relative argv[0]" ![io] {
    let rc = process.run([_rel_sfn(), "--version"]);
    assert expect_eq_int(rc as i64, 0).ok;
}

// The captured spawn takes an independent `CreateProcessA` call site, and
// failed the same way before the fix (it returns its own `-1` sentinel rather
// than 127), so it needs its own assertion rather than riding on the above.
test "process: run_capture spawns a working-directory-relative argv[0]" ![io] {
    let scratch = nested_runner_scratch("sfn1104-capture");
    fs.createDirectory(scratch, true);
    let rc = process.run_capture([_rel_sfn(), "--version"], clean_runner_env(scratch));
    let _out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert expect_eq_int(rc, 0).ok;
}

// ── The Linux-runnable half of the SFN-1104 guard ─────────────────────
// `runtime/sfn/platform/process_windows.sfn` is selected only by the runtime
// manifest's Windows target table, so nothing on a Linux or macOS run
// compiles it — and the three tests above therefore exercise only their POSIX
// leg on every host CI currently runs the suite on. Windows CI does not run
// the test tier yet (SFN-981), so without a static check the fix could be
// reverted and every gating leg would stay green.
//
// Same source-consistency form, and for the same reason, as the SFN-546 and
// SFN-572 guards in `process_run_stdio_passthrough_test.sfn`: whole-file
// `contains` against tokens unique to the fix, with no string slicing and no
// in-loop array growth (both miscompile from an `![io]` test in this repo —
// see `cross_windows_runtime_modules_test.sfn`'s IMPLEMENTATION NOTE, #842).
test "process: the Windows spawn resolves a relative argv[0] itself (SFN-1104)" ![io] {
    let src = fs.readFile("runtime/sfn/platform/process_windows.sfn");

    assert expect_eq_bool(contains(src, "fn _pw_app_name("), true).ok;

    // Both directions of the split are load-bearing, so both are pinned. A
    // separator-bearing name is returned for `lpApplicationName`, which
    // `CreateProcessA` resolves against the working directory...
    assert expect_eq_bool(contains(src, "if b == 47 || b == 92 { return a; }"), true).ok;

    // ...and a bare name yields NULL, keeping the `PATH` search that `clang`
    // and `llvm-link` are spawned by. Naming a bare one in
    // `lpApplicationName` would break it twice over, since that also
    // suppresses the implicit `.exe` suffix.
    assert expect_eq_bool(contains(src, "return 0 as *u8;"), true).ok;

    // All three call sites, not just the one a given test happens to reach.
    // The passthrough path keeps its computed `inherit` flag; the capture
    // path and `_pw_spawn_impl` pass a literal `1` with an `env_block`.
    assert expect_eq_bool(contains(src, "let app: *u8 = _pw_app_name(argv[0]);"), true).ok;
    assert expect_eq_bool(contains(src, "CreateProcessA(app, cmdline, null, null, inherit,"), true).ok;
    assert expect_eq_bool(contains(src, "CreateProcessA(app, cmdline, null, null, 1, 0, env_block,"), true).ok;
}
