// End-to-end regression for SFN-670: a binary expression whose operand is
// a parenthesized group containing an unbalanced count of `<` / `>`
// (`(1 << n) - 1`, `(a < b) as int + c`, `(c >> 1) + a`) must lower.
//
// `find_top_level_operator` (codegen-llvm `core_operators.sfn`) tracks
// `<` / `>` as generic-type angle-bracket depth so `f<T>(x) + 1` splits at
// the `+`, not inside the type arguments. Before the fix that tracking ran
// inside parentheses too, so the `<<` in `(1 << n)` left `angle_depth`
// unbalanced and the top-level `-` was never matched — the initializer did
// not lower at all (E1002), and the unannotated binding reported the
// `double` placeholder that SFN-835 mistook for an inference bug.
//
// This fails at lowering, not at `sfn check`, so the test drives a real
// `sfn run` of the fixture and asserts on its stdout. Environment
// threading follows `.claude/rules/no-bash-e2e.md` (full parent env for
// the nested clang/ld, SAILFIN_TEST_SCRATCH for build-cache isolation).
import { trim_right } from "sfn/strings";
import { sfn_bin_path } from "sfn/test";

fn _child_env() -> string[] ![io] { return process.environ(); }

struct RunOut {
    exit: int;
    out: string;
    err: string;
}

fn _run_fixture(path: string) -> RunOut ![io] {
    let exit = process.run_capture([sfn_bin_path(), "run", path], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    return RunOut { exit: exit, out: trim_right(out), err: err };
}

test "lowering: parenthesized operand with unbalanced angle chars lowers and runs (SFN-670)" ![io] {
    let r = _run_fixture("compiler/tests/e2e/fixtures/paren_operand_angle/main.sfn");
    if r.exit != 0 { print(r.err); }
    assert r.exit == 0;
    // shifted, annotated, cmp, halved, plain, generic, float carrier.
    assert r.out == "31\n31\n11\n7\n50\n8\nfloat-ok";
}
