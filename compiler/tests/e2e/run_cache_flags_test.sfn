// End-to-end tests for `sfn run` cache flag plumbing (Stage C PR1d).
//
// Native replacement for `test_run_cache_flags.sh` (test-infra Phase 3,
// epic #842). Verifies that `sfn run` honours the same cache contract as
// `sfn build`:
//
//   1. Backwards-compat `sfn run <file>` (no flags) still works.
//   2. Cold default run stays quiet unless telemetry is requested.
//   3. Warm `--cache-trace` run prints a summary with hits>=1, misses=0.
//   4. `--no-cache` suppresses the `[cache]` summary line entirely.
//   5. `--cache-trace` emits per-module `[cache hit]` lines.
//   6. `--clean` wipes `<cache_root>/v2/...` before building.
//   7. `--clean` also wipes the staged import-context tree, not just the
//      shared cache root (SFN-872).
//
// Tests 1-5 share a fixture capsule importing `sfn/math`, so the module
// cache has work to do. It lives under `build/` — CWD-relative, i.e. the
// repo root — so the repo's own `workspace.toml` resolves `sfn/math` with
// no symlink and no hardcoded absolute path (see `_ensure_fixture`). The
// compiler resolves capsule deps by walking up from the source file to
// find `capsule.toml`.
//
// `sfn run` does not support `--work-dir`, so the absolute path to the
// main sfn file is passed directly; the compiler discovers capsule.toml
// by walking up the directory tree.
//
// Per-test isolation: each test gets its OWN SAILFIN_TEST_SCRATCH
// (for build artifacts / program.ll) and its OWN SAILFIN_BUILD_CACHE_DIR
// (for .ll module cache). This prevents cross-test cache contamination and
// ensures each test's "cold" vs "warm" assertions see only its own runs.
//
// `--clean` additionally wipes the staged import-context tree
// (`build/compiler/import-context/`, SFN-872). That tree is rooted at a
// fixed, CWD-relative path with NO `SAILFIN_TEST_SCRATCH` override, and
// `sfn run` has no `--work-dir` to redirect it — cwd is the only lever.
// Tests 6 and 7 therefore run `sfn run --clean` against a private per-test
// fixture directory as the CHILD's cwd (via `process.run_capture_cwd`),
// never this repo's own cwd: a `--clean` started from the repo root would
// wipe the repo's own staged tree, which other e2e tests read or write and
// which several more silently skip on when absent — silent lost coverage
// under the parallel pool. Do not "simplify" this back to the repo cwd.
//
// NOTE: the `sfn/test` `expect_*` matchers are `![pure]` and cannot be
// used from an `![io]` test; output is asserted with `sfn/strings` predicates.
import { find, split } from "sfn/strings";
import { report_child_failure, sfn_bin_path } from "sfn/test";

fn _first_line(text: string) -> string {
    let lines = split(text, "\n");
    if lines.length == 0 { return text; }
    return lines[0];
}

// `run_capture_cwd` resolves the child's argv[0] against the CHILD cwd, not
// the parent's — an unqualified "build/bin/sfn" would not resolve once the
// nested run's cwd is the private fixture dir. Mirrors
// `target_flag_cache_key_test.sfn`'s `_sfn_bin_abs`.
fn _sfn_bin_abs() -> string ![io] {
    let bin = sfn_bin_path();
    if bin.length > 0 && bin[0] == "/" { return bin; }
    let exit = process.run_capture(["pwd"], []);
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if exit != 0 { return bin; }
    return _first_line(out) + "/" + bin;
}

// Build env for sfn run: PATH (clang/linker), HOME, TMPDIR,
// and per-test SAILFIN_TEST_SCRATCH + SAILFIN_BUILD_CACHE_DIR.
// Using per-test scratch ensures the runtime .o cache is also cold on
// the first run (the bash original used a fresh mktemp scratch each time).
fn _make_env(test_scratch: string, cache_dir: string) -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    e.push("SAILFIN_TEST_SCRATCH=" + test_scratch);
    e.push("SAILFIN_BUILD_CACHE_DIR=" + cache_dir);
    return e;
}

// Materialize the fixture capsule in-tree (idempotent) and return the
// path to `src/main.sfn` (passed to `sfn run`). The fixture lives under
// build/ — CWD-relative = repo root — so discover_workspace_root finds the
// repo's workspace.toml and `sfn/math` resolves through the workspace
// without a symlink or any hardcoded absolute repo path (the prior
// `/home/user/...` symlink only existed on one machine and failed in CI).
// The fixture is read-only and deterministic; per-test cold/warm isolation
// comes from the per-test SAILFIN_BUILD_CACHE_DIR + SAILFIN_TEST_SCRATCH,
// not from a fresh fixture dir.
fn _ensure_fixture() -> string ![io] {
    let root = "build/sfn-run-cache-flags-test/cap";
    fs.createDirectory(root + "/src", true);

    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"run-cache-flags-test\"\n"
        + "version = \"0.1.0\"\n\n"
        + "[dependencies]\n"
        + "\"sfn/math\" = \"0.1.0\"\n\n"
        + "[capabilities]\n"
        + "required = [\"io\"]\n\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n");

    fs.writeFile(root + "/src/main.sfn", "import { abs } from \"sfn/math\";\n"
        + "fn main() ![io] {\n"
        + "    if abs(-7) != 7 { print.info(\"FAIL\"); } else { print.info(\"OK\"); }\n"
        + "}\n");

    return root + "/src/main.sfn";
}

// Run `sfn run [extra_flags...] <main_sfn>` with explicit per-test
// scratch and cache dirs. Returns the combined stdout+stderr and exit code.
fn _run_with(main_sfn: string, test_scratch: string, cache_dir: string, extra_flags: string[]) -> string ![io] {
    let e = _make_env(test_scratch, cache_dir);
    let mut argv: string[] = [sfn_bin_path(), "run"];
    let mut i = 0;
    loop {
        if i >= extra_flags.length { break; }
        argv.push(extra_flags[i]);
        i += 1;
    }
    argv.push(main_sfn);
    let _exit = process.run_capture(argv, e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    return out + err;
}

// A self-contained fixture (relative import, no workspace dependency) for
// the `--clean` tests, which must run with the fixture root itself as the
// CHILD's cwd (see the file header) rather than this repo's cwd. Returns
// the fixture root; `src/main.sfn` is passed relative to that root.
fn _ensure_private_fixture(name: string) -> string ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/" + name;
    fs.createDirectory(root + "/src", true);

    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn872/probe\"\n"
        + "version = \"0.1.0\"\n\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"binary\"\n");

    fs.writeFile(root + "/src/util.sfn", "fn helper() -> int { return 7; }\n"
        + "export { helper };\n");

    fs.writeFile(root + "/src/main.sfn", "import { helper } from \"./util\";\n"
        + "fn main() -> int ![io] {\n"
        + "    if helper() == 7 { print(\"OK\"); }\n"
        + "    return 0;\n"
        + "}\n");

    return root;
}

struct Run {
    exit: int,
    log: string
}

// Run `sfn run [extra_flags...] src/main.sfn` with the given directory as
// the CHILD's cwd (not this test's own cwd — see the file header). Returns
// the exit code and combined stdout+stderr.
fn _run_with_cwd(dir: string, test_scratch: string, cache_dir: string, extra_flags: string[]) -> Run ![io] {
    let e = _make_env(test_scratch, cache_dir);
    let mut argv: string[] = [_sfn_bin_abs(), "run"];
    let mut i = 0;
    loop {
        if i >= extra_flags.length { break; }
        argv.push(extra_flags[i]);
        i += 1;
    }
    argv.push("src/main.sfn");
    let exit = process.run_capture_cwd(argv, e, dir);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    return Run { exit: exit, log: out + err };
}

// ---- Test 1: backwards compat — `sfn run <file>` with no flags ----
test "sfn run <file> still works (no flags)" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/sfn-rcf-t1";
    let test_scratch = root + "/scratch";
    let cache_dir = root + "/cache";
    fs.createDirectory(test_scratch, true);
    let main_sfn = _ensure_fixture();

    let e = _make_env(test_scratch, cache_dir);
    let exit = process.run_capture([sfn_bin_path(), "run", main_sfn], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let log = out + err;

    report_child_failure("run-cache-flags no-flags run", exit, out, err);
    assert exit == 0;
    assert find(log, "OK", 0) >= 0;
    assert find(log, "[cache]", 0) < 0;
    assert find(log, "[link]", 0) < 0;
}

// ---- Test 2: cold default run stays quiet unless telemetry is requested ----
// With a per-test fresh SAILFIN_TEST_SCRATCH, the runtime .o cache is also
// cold — matching the bash original's mktemp-fresh scratch semantics.
// The cache still does the work; it just does not leak telemetry into a
// normal `sfn run` unless `--cache-trace` is requested.
test "first run suppresses cache summary by default" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/sfn-rcf-t2";
    let test_scratch = root + "/scratch";
    let cache_dir = root + "/cache";
    fs.createDirectory(test_scratch, true);
    let main_sfn = _ensure_fixture();

    let log = _run_with(main_sfn, test_scratch, cache_dir, []);

    assert find(log, "OK", 0) >= 0;
    assert find(log, "[cache]", 0) < 0;
    assert find(log, "[link]", 0) < 0;
}

// ---- Test 3: warm --cache-trace run prints summary with misses=0 ----
test "warm run with --cache-trace prints warm cache summary (hits>=1, misses=0)" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/sfn-rcf-t3";
    let test_scratch = root + "/scratch";
    let cache_dir = root + "/cache";
    fs.createDirectory(test_scratch, true);
    let main_sfn = _ensure_fixture();

    // First run to warm both caches.
    let _ = _run_with(main_sfn, test_scratch, cache_dir, []);
    // Second run: sfn/math .ll is now cached; runtime .o objects are cached.
    let log = _run_with(main_sfn, test_scratch, cache_dir, ["--cache-trace"]);

    assert find(log, "OK", 0) >= 0;
    // Warm run: all modules are now cached → misses=0.
    assert find(log, "misses=0", 0) >= 0;
}

// ---- Test 4: --no-cache suppresses the [cache] summary line ----
test "sfn run --no-cache prints no '[cache]' summary" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/sfn-rcf-t4";
    let test_scratch = root + "/scratch";
    let cache_dir = root + "/cache";
    fs.createDirectory(test_scratch, true);
    let main_sfn = _ensure_fixture();

    // Warm the cache first.
    let _ = _run_with(main_sfn, test_scratch, cache_dir, []);
    // Run with --no-cache.
    let log = _run_with(main_sfn, test_scratch, cache_dir, ["--no-cache"]);

    assert find(log, "OK", 0) >= 0;
    // No [cache] summary line must appear.
    assert find(log, "[cache]", 0) < 0;
}

// ---- Test 5: --cache-trace emits per-module [cache hit] lines ----
test "sfn run --cache-trace prints '[cache hit] sfn/math'" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/sfn-rcf-t5";
    let test_scratch = root + "/scratch";
    let cache_dir = root + "/cache";
    fs.createDirectory(test_scratch, true);
    let main_sfn = _ensure_fixture();

    // Warm the cache first.
    let _ = _run_with(main_sfn, test_scratch, cache_dir, []);
    // Run with --cache-trace: sfn/math must report a cache hit.
    let log = _run_with(main_sfn, test_scratch, cache_dir, ["--cache-trace"]);

    assert find(log, "OK", 0) >= 0;
    assert find(log, "[cache hit] sfn/math", 0) >= 0;
}

// ---- Test 6: --clean wipes the cache and forces a fresh miss ----
// Uses the private-cwd fixture (see file header): `--clean` also wipes the
// CWD-fixed staged import-context tree, so this must not run with the
// repo itself as cwd.
test "sfn run --clean wipes the cache and rebuilds" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/sfn-rcf-t6";
    let test_scratch = root + "/scratch";
    let cache_dir = root + "/cache";
    fs.createDirectory(test_scratch, true);
    let fixture_dir = _ensure_private_fixture("sfn-rcf-t6-fixture");

    // Two warm runs to populate the cache.
    let _ = _run_with_cwd(fixture_dir, test_scratch, cache_dir, []);
    let _ = _run_with_cwd(fixture_dir, test_scratch, cache_dir, []);

    // Sanity: v2 cache dir must exist.
    assert fs.exists(cache_dir + "/v2");

    // Run with --clean and telemetry: wipes the .ll module cache and forces
    // a re-miss.
    let run = _run_with_cwd(fixture_dir, test_scratch, cache_dir, ["--clean", "--cache-trace"]);
    let log = run.log;

    // Surface the child's own output on failure: a bare `exit != 0` from a
    // nested build is undiagnosable from CI logs alone.
    report_child_failure("run-cache-flags --clean run", run.exit, log, "");
    assert run.exit == 0;
    assert find(log, "OK", 0) >= 0;
    // After --clean the .ll module cache is wiped → at least one miss and store.
    // Scoped to the `[cache]` summary line rather than searched across the whole
    // log: the trace carries a second, independent `[stage cache]` summary whose
    // counters describe the staged-artifact layer (SFN-861), and a bare
    // whole-log search for "misses=0" matches that line's legitimately-zero
    // shared-cache counters too. The assertion below still proves exactly what
    // this test is named for — that `--clean` forced the `.ll` layer to re-miss
    // — it just stops binding on text that belongs to a different cache.
    let cache_line_start = find(log, "[cache] hits=", 0);
    assert cache_line_start >= 0;
    let cache_line_end = find(log, "\n", cache_line_start);
    assert cache_line_end > cache_line_start;
    let cache_line = substring(log, cache_line_start, cache_line_end);
    assert find(cache_line, "misses=0", 0) < 0;
}

// ---- Test 7: --clean wipes the staged import-context tree (SFN-872) ----
// Distinct from test 6: this proves `--clean` reaches the CWD-fixed staged
// import-context tree (`build/compiler/import-context/`), not just the
// shared `SAILFIN_BUILD_CACHE_DIR` root that tests 3-6 exercise. Uses a
// small (sub-threshold) fixture, so the shared stage cache is disabled
// in-process (`_cr_resolve_stage_cache_ctx` requires `sailfin_exe`, unset
// below the subprocess-isolation module count) and no `[stage cache]` trace
// line is emitted — the filesystem state before/after `--clean` is the
// oracle instead.
test "sfn run --clean wipes the staged import-context tree (SFN-872)" ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let root = base + "/sfn-rcf-t7";
    let test_scratch = root + "/scratch";
    let cache_dir = root + "/cache";
    fs.createDirectory(test_scratch, true);
    let fixture_dir = _ensure_private_fixture("sfn-rcf-t7-fixture");
    let import_context = fixture_dir + "/build/compiler/import-context";

    // Cold run (no --clean): precondition — the staged tree is populated.
    let cold = _run_with_cwd(fixture_dir, test_scratch, cache_dir, []);
    report_child_failure("run-cache-flags SFN-872 cold run", cold.exit, cold.log, "");
    assert cold.exit == 0;
    assert fs.exists(import_context + "/util.sfn-asm");
    assert fs.exists(import_context + "/util.srchash");

    // Plant a sentinel in the staged tree to prove `--clean` wipes the
    // whole tree, not just the specific artifacts a normal build touches.
    let sentinel = import_context + "/.sfn872-sentinel";
    fs.writeFile(sentinel, "x\n");
    assert fs.exists(sentinel);

    // Second run with --clean: must wipe the staged tree before rebuilding.
    let cleaned = _run_with_cwd(fixture_dir, test_scratch, cache_dir, ["--clean"]);
    report_child_failure("run-cache-flags SFN-872 --clean run", cleaned.exit, cleaned.log, "");
    assert cleaned.exit == 0;

    // The sentinel is gone — the tree was actually wiped, not just skipped.
    assert ! fs.exists(sentinel);
    // The staged artifact is back — the post-clean build re-emitted it
    // rather than serving a stale staged artifact.
    assert fs.exists(import_context + "/util.sfn-asm");
}
