// End-to-end regression test for SFN-1021 — `process.handle_write` now
// routes through `sfn_process_handle_write_bytes`, whose `{i8*, i64}`
// parameter shape carries the caller's byte length instead of dropping it
// at an `extractvalue` and letting the callee re-derive it with `strlen`
// (`compiler/capsules/codegen-llvm/src/runtime_helpers/registry_process.sfn:129-135`).
// Mirrors `fs_write_carry_length_test.sfn` (SFN-1009), the precedent for
// this exact defect class. Pins, end-to-end:
//   1. emit shape — process.sfn still defines both the bare and
//                   length-carrying write twins.
//   2. flip probe — a fresh `process.handle_write` call site routes
//                   through `@sfn_process_handle_write_bytes`, carries the
//                   `{i8*, i64}` aggregate (not `byval`), and is NOT a
//                   call site of the bare `sfn_process_handle_write`.
//   3. exports    — the compiled runtime object defines both text symbols.
//   4. round-trip — a real child sees the exact byte length written,
//                   including a multi-byte UTF-8 payload where byte count
//                   and character count diverge.
//
// Windows: `runtime/sfn/platform/process_windows.sfn:1760` / `:1797` carry
// the matching twins, so the repoint is sound there too, but this file's
// functional round-trip (test 4) runs on the host only. The Windows
// adapter's twins are verified by signature inspection and by
// `compiler/tests/e2e/process_handle_windows_test.sfn`.
//
// NOTE on matchers: the `sfn/test` `expect_*` matchers are `![pure]`, so
// they cannot be called from an `![io]` test — use `sfn/strings`, as the
// sibling `runtime_adapter_filesystem_test.sfn` does.
import {
    char_at_index,
    contains,
    ends_with,
    find,
    split,
    starts_with
} from "sfn/strings";
import {
    clean_runner_env,
    default_scratch_dir,
    scratch_root,
    sfn_bin_path,
    skip,
    symbol_reader
} from "sfn/test";

// Derived by subtraction from the real environment via `clean_runner_env`,
// not built up key-by-key (SFN-1114).
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    dir = dir + "/sfn-process-handle-write-carry-length";
    fs.createDirectory(dir, true);
    return dir;
}

fn _process_path() -> string ![io] {
    let configured = env.get("SAILFIN_REPO_ROOT");
    if configured.length > 0 { return configured + "/runtime/sfn/process.sfn"; }
    return "runtime/sfn/process.sfn";
}

fn _emit_process_ll() -> string ![io] {
    let dir = _scratch_dir();
    let ll = dir + "/process.ll";
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", ll, "llvm", _process_path()], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    assert exit == 0;
    return ll;
}

fn _emit_module(tag: string, module_path: string) -> string ![io] {
    let dir = _scratch_dir();
    let outpath = dir + "/" + tag + ".ll";
    let exit = process.run_capture([sfn_bin_path(), "emit", "-o", outpath, "llvm", module_path], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return "EMIT_FAILED"; }
    return fs.readFile(outpath);
}

fn _has_define_named(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if starts_with(line, "define ") && contains(line, "@" + sym + "(") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn _is_word_char(ch: string) -> boolean {
    if ch.length == 0 { return false; }
    let word = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    return find(word, ch, 0) >= 0;
}

// `@sym\b` — does the IR reference the bare symbol at a word boundary?
fn _references(ir: string, sym: string) -> boolean {
    let needle = "@" + sym;
    let mut pos = find(ir, needle, 0);
    loop {
        if pos < 0 { break; }
        let after = pos + needle.length;
        if after >= ir.length { return true; }
        let ch = char_at_index(ir, after);
        if !_is_word_char(ch) { return true; }
        pos = find(ir, needle, after);
    }
    return false;
}

// The first `call ... @sym(` line, or "" — lets a caller assert over the
// emitted operand types rather than only the symbol name.
fn _call_line(ir: string, sym: string) -> string {
    let lines = split(ir, "\n");
    let needle = "@" + sym + "(";
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if contains(line, "call ") && contains(line, needle) { return line; }
        i = i + 1;
    }
    return "";
}

// `call ... @sym` on any line, where `sym` is the WHOLE callee name (not
// merely a prefix). This file asks whether the BARE
// `sfn_process_handle_write` is still called while
// `sfn_process_handle_write_bytes` — of which the bare name is a literal
// prefix — is called on the very next line, so the prefix relationship is
// load-bearing and worth being explicit about.
//
// The sibling `runtime_adapter_filesystem_test.sfn::_has_call_site`
// matches `@sym + "("`; that trailing paren is itself a sufficient
// boundary here (`@sfn_process_handle_write_bytes(` does not contain
// `@sfn_process_handle_write(`), so it is NOT wrong and does not need
// fixing. This form checks the character after the name instead, which
// holds for any delimiter rather than only `(`.
fn _has_call_site(ir: string, sym: string) -> boolean {
    let lines = split(ir, "\n");
    let needle = "@" + sym;
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        if find(line, "call ", 0) >= 0 {
            let mut pos = find(line, needle, 0);
            loop {
                if pos < 0 { break; }
                let after = pos + needle.length;
                if after >= line.length || !_is_word_char(char_at_index(line, after)) {
                    return true;
                }
                pos = find(line, needle, after + 1);
            }
        }
        i = i + 1;
    }
    return false;
}

// Locates the compiled runtime-native object for `module`, tolerant of the
// `<target>-<opt>` segment differing per host, mirroring
// `runtime_adapter_filesystem_test.sfn::_runtime_object`. Returns "" when
// the tree has not been built yet, for the caller to `skip(...)`.
fn _runtime_object(module: string) -> string ![io] {
    let dir = "build/sailfin";
    if !fs.exists(dir) { return ""; }
    let prefix = "sfn__runtime-native__" + module + ".sfn-";
    let entries = fs.listDirectory(dir);
    let mut i = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        if starts_with(name, prefix) && ends_with(name, ".o") {
            return dir + "/" + name;
        }
        i = i + 1;
    }
    return "";
}

// `<space>T<space>_?sym` at end of an `nm` line (optional `_` for macOS).
fn _nm_has_defined(binary: string, sym: string) -> boolean ![io] {
    let reader = symbol_reader();
    if reader.length == 0 {
        skip("no symbol reader on PATH (llvm-nm / nm / llvm-nm-18) — cannot assert symbol presence (SFN-1114)");
        return false;
    }
    let exit = process.run_capture([reader, binary], _child_env());
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return false; }
    let lines = split(out, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        let is_text = contains(line, " T ") || contains(line, " t ");
        if is_text && (ends_with(line, " " + sym) || ends_with(line, "_" + sym)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// `-o` is honoured verbatim, so on Windows the built file may carry a
// `.exe` suffix the base path did not ask for (`process_framed_stdio_test.sfn`).
fn _built_path(base: string) -> string ![io] {
    if fs.exists(base + ".exe") { return base + ".exe"; }
    return base;
}

// Byte-for-byte stdin-to-stdout passthrough child, mirroring
// `process_framed_stdio_test.sfn::_echo_bin` — writing each chunk back via
// a raw `sfn_write_fd` as soon as it is read avoids the coreutils
// stdio-buffering deadlock a spawned `cat` reproduces (see that file's
// header for the full rationale).
fn _echo_bin() -> string ![io] {
    let dir = _scratch_dir();
    let existing = _built_path(dir + "/echo");
    if fs.exists(existing) { return existing; }
    let src = dir + "/echo.sfn";
    fs.writeFile(src, "struct OwnedBuf {\n" + "    ptr_addr: i64;\n"
        + "    len: i64;\n"
        + "    cap: i64;\n"
        + "    arena_addr: i64;\n"
        + "}\n\n"
        + "extern fn sfn_write_fd(fd: i32, buf: *u8, count: usize) -> i64;\n\n"
        + "extern fn free(ptr: *u8) -> void;\n\n"
        + "fn main() -> int ![io] {\n"
        + "    let mut guard: int = 0;\n"
        + "    loop {\n"
        + "        guard += 1;\n"
        + "        if guard >= 5000 {\n"
        + "            let exhausted = \"echo-fixture: read loop exhausted its guard without observing EOF\\n\";\n"
        + "            let _we = sfn_write_fd(2, exhausted as *u8, exhausted.length as usize);\n"
        + "            return 97;\n"
        + "        }\n"
        + "        let chunk: OwnedBuf = io.read_fd(0, 4096);\n"
        + "        if chunk.len == 0 { break; }\n"
        + "        let _w = sfn_write_fd(1, chunk.ptr_addr as *u8, chunk.len as usize);\n"
        + "        if chunk.arena_addr == 0 { free(chunk.ptr_addr as *u8); }\n"
        + "    }\n"
        + "    return 0;\n"
        + "}\n");
    let build_exit = process.run_capture([sfn_bin_path(), "build", "-o", dir
        + "/echo", src], _child_env());
    let _bo = process.capture_take_stdout();
    let _be = process.capture_take_stderr();
    assert build_exit == 0;
    return _built_path(dir + "/echo");
}

test "process.sfn emit: defines both the bare and length-carrying write twins" ![io] {
    let ll = _emit_process_ll();
    let ir = fs.readFile(ll);
    assert _has_define_named(ir, "sfn_process_handle_write");
    assert _has_define_named(ir, "sfn_process_handle_write_bytes");
}

test "probe routes process.handle_write through @sfn_process_handle_write_bytes" ![io] {
    let dir = _scratch_dir();
    let probe = dir + "/process_handle_write_probe.sfn";
    // SFN-1001: `dir` travels through argv[1], never spliced into source
    // text — on Windows it's a backslash path, and a literal `+ dir +`
    // here would silently corrupt it. Not exercised for its own value
    // here (the probe never spawns a child), but kept as argv[1] to match
    // the convention every sibling probe in this suite follows.
    fs.writeFile(probe, "fn main(argv: string[]) -> int ![io] {\n"
        + "    let id = process.spawn_with_env([argv[1]], []);\n"
        + "    let payload = \"sfn-1021-probe-payload\";\n"
        + "    let n = process.handle_write(id, payload);\n"
        + "    return n as int;\n"
        + "}\n");
    let ir = _emit_module("process_handle_write_probe", probe);
    assert ir != "EMIT_FAILED";
    assert _references(ir, "sfn_process_handle_write_bytes");
    // SFN-1021: the bare-`i8*` twin stays DEFINED (seed-built IR still
    // calls it) but must no longer be the target of a freshly emitted
    // call — that is what proves the length is carried rather than
    // dropped and re-derived with `strlen`.
    assert ! _has_call_site(ir, "sfn_process_handle_write");
    // SFN-1021: pin the operand SHAPE, not just the symbol. The aggregate
    // agrees with the callee's split `(data: *u8, len: i64)` params only
    // because a 16-byte by-value aggregate flattens to the same registers.
    // A `byval` would pass it INDIRECTLY instead — the body would read a
    // pointer-to-struct as its data pointer, silently corrupting on any
    // target whose C ABI passes 16-byte aggregates indirectly. Nothing
    // else in the suite would catch that; only this operand-shape
    // assertion does.
    let write_call = _call_line(ir, "sfn_process_handle_write_bytes");
    assert write_call != "";
    assert contains(write_call, "{i8*, i64}");
    assert ! contains(write_call, "byval");
}

test "runtime object exports both write twins" ![io] {
    let obj = _runtime_object("process");
    if obj.length == 0 {
        skip("build/sailfin/sfn__runtime-native__process.sfn-*.o not found — tree not built yet (SFN-1114)");
    }
    assert _nm_has_defined(obj, "sfn_process_handle_write");
    assert _nm_has_defined(obj, "sfn_process_handle_write_bytes");
}

test "handle_write round-trips a payload through a child's stdin" ![io] {
    let id = process.spawn_with_env([_echo_bin()], []);
    assert id != 0;
    let payload = "sfn-1021-payload\n";
    let n = process.handle_write(id, payload);
    assert n == payload.length;
    let echoed = process.handle_read_line_stdout(id);
    assert echoed == "sfn-1021-payload";
    // SFN-1021: a multi-byte UTF-8 payload is the assertion that would
    // regress if the aggregate's length were dropped and re-derived with
    // `strlen` — `strlen` counts bytes too, but a caller-derived
    // *character* count would silently diverge from it here, and this
    // pins that the returned count is the BYTE length.
    let unicode_payload = "héllo-ünïcode\n";
    let unicode_n = process.handle_write(id, unicode_payload);
    assert unicode_n == unicode_payload.length;
    assert unicode_n != 14;
    let unicode_echoed = process.handle_read_line_stdout(id);
    assert unicode_echoed == "héllo-ünïcode";
    process.handle_close_stdin(id);
    let exit = process.handle_wait(id);
    assert exit == 0;
}
