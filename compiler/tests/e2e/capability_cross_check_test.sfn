// End-to-end test for the capabilities-pillar cross-check (E0403)
// enforced on the CHECK PATH (`sailfin check <file>`).
//
// Contract: a function declaring an effect outside the capsule
// manifest's `[capabilities] required = [...]` surface must fail with
// diagnostic `E0403`. The logic lives in
// `validate_capsule_capabilities`
// (`compiler/capsules/analyzer/src/effect_checker/validations.sfn`,
// Phase F) and renders via `compiler/src/diagnostics_render.sfn`; both
// are already shipped and unit-tested
// (`compiler/tests/unit/effect_capabilities_test.sfn`). This test closes
// the build-path asymmetry: the in-module / cross-module gates
// (E0400 / E0402) have a `process.run_capture`-driven e2e
// (`effect_gate_build_path_test.sfn`) but E0403 had none.
//
// E0403 sources the allowed surface directly from `capsule.toml` via the
// resolver (`capsule_resolver.sfn` Phase F → `cli_check.sfn`), so — unlike
// the E0402 model — it needs no `--import-context` staging: a plain
// `sfn check` over a file whose capsule walks up to a `capsule.toml` with
// a non-empty `[capabilities] required` is enough.
//
// Each test stages its OWN isolated capsule (separate scratch dir keyed
// by tag) holding a single fixture, so the negative control can never be
// contaminated by the positive fixture's diagnostic regardless of how the
// resolver enumerates capsule sources, and the parallel pool never
// collides.
//
// NOTE: assert on captured stdout+stderr with `sfn/strings` predicates —
// the `sfn/test` `expect_*` matchers are `![pure]` and cannot be called
// from an `![io]` test. (#842.)
import { find } from "sfn/strings";
import { default_scratch_dir, sfn_bin_path } from "sfn/test";

// Child env for the spawned `sfn check`: `run_capture`'s `[]` is the
// EMPTY environment (not "inherit"), so thread through the variables the
// frontend check may consult. `SAILFIN_TEST_SCRATCH` keeps any
// per-invocation staging under the runner's scratch in the parallel pool.
fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

// A private capsule dir under the runner's scratch (or /tmp), keyed by
// `tag` so concurrent tests in the parallel pool never collide.
fn _scratch(tag: string) -> string ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = default_scratch_dir(); }
    let dir = base + "/sfn-capability-cross-check-" + tag;
    fs.createDirectory(dir + "/src", true);
    return dir;
}

// Stage a one-fixture capsule under a verbatim manifest. Callers own the
// whole `capsule.toml` text so a test can express manifest states that
// have no valid `[capabilities]` shape at all (SFN-764).
fn _stage_raw(tag: string, manifest: string, fixture_name: string, fixture_body: string) -> string ![io] {
    let dir = _scratch(tag);
    fs.writeFile(dir + "/capsule.toml", manifest);
    let fixture_path = dir + "/src/" + fixture_name;
    fs.writeFile(fixture_path, fixture_body);
    return fixture_path;
}

// A well-formed manifest header, with `caps` appended verbatim so each
// test picks its own `[capabilities]` state.
fn _manifest(caps: string) -> string {
    return "[capsule]\n" + "name = \"cross_check_fixture\"\n"
        + "version = \"0.0.0\"\n\n"
        + caps;
}

// Stage a one-fixture capsule with `[capabilities] required = ["io"]`.
// Returns the absolute path to the staged fixture for `sfn check`.
fn _stage_capsule(tag: string, fixture_name: string, fixture_body: string) -> string ![io] {
    return _stage_raw(tag, _manifest("[capabilities]\nrequired = [\"io\"]\n"), fixture_name, fixture_body);
}

struct CheckRun {
    exit: int,
    out: string
}

// Drive `sfn check <path>` and fold captured stdout+stderr together; the
// frontend check stops before codegen/link, so no clang/linker is spawned.
fn _check(path: string) -> CheckRun ![io] {
    let exit = process.run_capture([sfn_bin_path(), "check", path], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    return CheckRun { exit: exit, out: out + err };
}

// ---- Over-declared: ![net] is outside the ["io"] surface → E0403 ----
// The body needs no other effect, so the only diagnostic is the
// capability cross-check (no E0400 under-declaration noise).
test "capability cross-check: rejects effect outside manifest surface with E0403" ![io] {
    let fixture = _stage_capsule("overdeclared", "reach.sfn", "fn reach(x: number) -> number ![net] {\n"
        + "    return x + 1;\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit != 0;
    assert find(r.out, "E0403", 0) >= 0;
}

// ---- In-surface control: ![io] is within the ["io"] surface → clean ----
// Proves the manifest surface is the discriminator — `check` is not
// rejecting every effectful function. The body exercises `io` so there is
// no unused-effect concern; `io` is both declared and allowed.
test "capability cross-check: accepts effect within manifest surface" ![io] {
    let fixture = _stage_capsule("insurface", "local.sfn", "fn local() ![io] {\n"
        + "    print.info(\"in surface\");\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit == 0;
    assert find(r.out, "E0403", 0) < 0;
}

// ---- SFN-764: the three manifest states --------------------------------
//
// The bug these pin: `capabilities_required` alone cannot tell "declared
// nothing" from "declared an empty set", so an explicit `required = []`
// used to disable the cross-check outright — a capsule asserting it
// needed no capability silently received full authority. Presence of the
// section now decides whether the check runs; its contents decide what
// passes.
// State: `[capabilities]` present, `required = []` → deny-all.
// This is the whole point of SFN-764 and fails against the old compiler.
test "capability cross-check: an explicit empty surface denies every effect" ![io] {
    let fixture = _stage_raw("declared-empty", _manifest("[capabilities]\nrequired = []\n"), "touch.sfn", "fn touch() ![io] {\n"
        + "    print.info(\"denied\");\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit != 0;
    assert find(r.out, "E0403", 0) >= 0;
    // The effect the author actually declared must be named, so the
    // diagnostic is actionable rather than just "something is wrong".
    assert find(r.out, "io", 0) >= 0;
}

// State: no `[capabilities]` section → still skipped.
// The decisive control. Merging this state with the one above would break
// every capsule that has not yet written a manifest surface, which is why
// the flag tracks section PRESENCE and not list length.
test "capability cross-check: an absent capabilities section still skips" ![io] {
    let fixture = _stage_raw("absent-section", _manifest(""), "touch.sfn", "fn touch() ![io] {\n"
        + "    print.info(\"allowed\");\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit == 0;
    assert find(r.out, "E0403", 0) < 0;
}

// State: `[capabilities]` present but no readable `required` key.
// Fail-closed turns what was silent full authority into a loud E0403
// naming exactly the effect the author expected to have been granted.
test "capability cross-check: a section with no required key fails closed" ![io] {
    let fixture = _stage_raw("missing-key", _manifest("[capabilities]\n"), "touch.sfn", "fn touch() ![io] {\n"
        + "    print.info(\"denied\");\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit != 0;
    assert find(r.out, "E0403", 0) >= 0;
}

// `pure` is the empty effect set, not a capability, so it must survive a
// deny-all ceiling. Guards the carve-out in `_analyze_routine_capabilities`
// against a future refactor that treats the deny-all surface as "reject
// every effect token".
test "capability cross-check: pure passes under a deny-all surface" ![io] {
    let fixture = _stage_raw("pure-under-deny", _manifest("[capabilities]\nrequired = []\n"), "calc.sfn", "fn calc(x: number) -> number ![pure] {\n"
        + "    return x + 1;\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit == 0;
    assert find(r.out, "E0403", 0) < 0;
}

// ---- SFN-764: E0407, an unreadable manifest ----------------------------
//
// A manifest the resolver accepts but the scanner extracts nothing from
// (truncated write, conflict markers, a misspelled section header) used to
// degrade to "no capabilities declared, allow everything" — a fail-open
// bypass sitting underneath the fail-closed rule above. A capsule whose
// manifest cannot be read is not a capsule.
test "capability cross-check: an unreadable manifest is E0407, not full authority" ![io] {
    let fixture = _stage_raw("unreadable-manifest", "<<<<<<< HEAD\nname = \"clobbered\"\n=======\n>>>>>>> other\n", "touch.sfn", "fn touch() ![io] {\n"
        + "    print.info(\"should not be authorized\");\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit != 0;
    assert find(r.out, "E0407", 0) >= 0;
}

// ---- SFN-1216: dev-required widens the ceiling for tests only --------
//
// The forcing case is `sfn/crypto`: six timing and X.509-validity tests
// declare `![clock]` on a capsule that deliberately reads no ambient
// time. Without this key those tests would push `clock` into the shipped
// surface, which SFEP-0016 turns into a syscall mask.
test "capability cross-check: dev-required grants a test block" ![io] {
    let fixture = _stage_raw("dev-required-test", _manifest("[capabilities]\nrequired = [\"io\"]\ndev-required = [\"clock\"]\n"), "timing.sfn", "test \"budget holds\" ![clock] {\n"
        + "    assert true;\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit == 0;
    assert find(r.out, "E0403", 0) < 0;
}

test "capability cross-check: dev-required does not grant shipped code" ![io] {
    // The other half, and the one that matters: a dev-only effect must
    // still fail on a shipped `fn`, or `dev-required` would just be a
    // wider `required` with a friendlier name.
    let fixture = _stage_raw("dev-required-shipped", _manifest("[capabilities]\nrequired = [\"io\"]\ndev-required = [\"clock\"]\n"), "tick.sfn", "fn tick() ![clock] {\n"
        + "    return;\n"
        + "}\n");
    let r = _check(fixture);
    assert r.exit != 0;
    assert find(r.out, "E0403", 0) >= 0;
    assert find(r.out, "clock", 0) >= 0;
}
