// compiler/tests/e2e/coff_comdat_link_test.sfn
//
// E2E regression proving the COFF-link property target-conditioned COMDAT
// emission fixes (SFN-549), from a Linux runner. The native MSVC/COFF link
// of the compiler itself fails with duplicate-symbol errors because
// `linkonce_odr` type-descriptor / ABI-version globals are emitted into
// every referencing module — ELF auto-groups the duplicates, COFF requires
// an explicit `comdat` group to fold them. This test emits two modules
// that both declare the same struct with `SAILFIN_TARGET_OS=Windows`,
// assembles each to a COFF object with `llc`, and links them with
// `lld-link` — asserting a clean link with no duplicate-symbol error.
//
// A second case pins the sharp edge on the opposite side: Mach-O forbids
// `comdat` outright (`llc` hard-aborts with "MachO doesn't support
// COMDATs"), so an accidental *unconditional* comdat clause would abort
// `llc` for a Darwin target — caught here on a Linux runner with no macOS
// host required.
//
// Both `llc` and `lld-link` are probed first and the test skips (does not
// fail) when either tool is absent, per `docs/conventions/sanitizer-tests.md`
// and `docs/conventions/e2e-tests.md` ("External tools ... skip when
// absent"). Drives the compiler-under-test as a subprocess per
// `.claude/rules/no-bash-e2e.md`.
import { contains } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch } from "sfn/test";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = "/tmp"; }
    dir = dir + "/sfn-coff-comdat-link";
    fs.createDirectory(dir, true);
    return dir;
}

fn _base_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

// Probe `<candidate> --version`; return the first candidate that runs, or
// "" when none are on PATH (e.g. `llc-18` on Ubuntu/Debian, bare `llc`
// elsewhere).
fn _find_tool(candidates: string[]) -> string ![io] {
    let mut i = 0;
    loop {
        if i >= candidates.length { break; }
        let exit = process.run_capture([candidates[i], "--version"], _base_env());
        let _o = process.capture_take_stdout();
        let _e = process.capture_take_stderr();
        if exit == 0 { return candidates[i]; }
        i += 1;
    }
    return "";
}

fn _find_llc() -> string ![io] {
    let candidates: string[] = ["llc-18", "llc"];
    return _find_tool(candidates);
}

fn _find_lld_link() -> string ![io] {
    let candidates: string[] = ["lld-link"];
    return _find_tool(candidates);
}

// A struct shared by both fixture modules — the descriptor globals this
// produces are the ones that must fold at COFF link time.
fn _module_source(fn_suffix: string) -> string {
    return "struct SharedType {\n" + "    a: int;\n" + "    b: int;\n" + "}\n"
        + "\n"
        + "fn use_shared_"
        + fn_suffix
        + "() -> void {\n"
        + "    let s = SharedType { a: 1, b: 2 };\n"
        + "}\n";
}

// Trivial `mainCRTStartup` entry so `lld-link` has a resolvable entry
// point without pulling in the Windows CRT/SDK.
fn _entry_c_source() -> string { return "void mainCRTStartup(void) {}\n"; }

fn _emit_windows_ll(dir: string, tag: string, source: string) -> string ![io] {
    let src = dir + "/" + tag + ".sfn";
    let ll = dir + "/" + tag + ".ll";
    fs.writeFile(src, source);
    if fs.exists(ll) { fs.deleteFile(ll); }
    let mut e = clean_runner_env(nested_runner_scratch("coff-" + tag));
    e.push("SAILFIN_TARGET_OS=Windows");
    let exit = process.run_capture([_sfn_bin(), "emit", "-o", ll, "llvm", src], e);
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit != 0 { return ""; }
    if !fs.exists(ll) { return ""; }
    return ll;
}

test "coff comdat link: two modules sharing a type link cleanly with lld-link" ![io] {
    let llc = _find_llc();
    let lld_link = _find_lld_link();
    if llc.length == 0 || lld_link.length == 0 {
        // Neither `llc`/`llc-18` nor `lld-link` on PATH — skip, matching the
        // sanitizer-test precedent for an absent toolchain leg.
        assert true;
        return;
    }

    let dir = _scratch_dir();
    let ll1 = _emit_windows_ll(dir, "coff_mod1", _module_source("one"));
    let ll2 = _emit_windows_ll(dir, "coff_mod2", _module_source("two"));
    assert ll1.length > 0;
    assert ll2.length > 0;

    let obj1 = dir + "/coff_mod1.obj";
    let obj2 = dir + "/coff_mod2.obj";
    let obj_exit1 = process.run_capture([llc, "-mtriple=x86_64-pc-windows-msvc", "-filetype=obj", ll1, "-o", obj1], _base_env());
    let _o1 = process.capture_take_stdout();
    let _e1 = process.capture_take_stderr();
    assert obj_exit1 == 0;
    let obj_exit2 = process.run_capture([llc, "-mtriple=x86_64-pc-windows-msvc", "-filetype=obj", ll2, "-o", obj2], _base_env());
    let _o2 = process.capture_take_stdout();
    let _e2 = process.capture_take_stderr();
    assert obj_exit2 == 0;

    let entry_c = dir + "/coff_entry.c";
    let entry_obj = dir + "/coff_entry.obj";
    fs.writeFile(entry_c, _entry_c_source());
    let entry_exit = process.run_capture(["clang", "-target", "x86_64-pc-windows-msvc", "-c", entry_c, "-o", entry_obj], _base_env());
    let _eo = process.capture_take_stdout();
    let _ee = process.capture_take_stderr();
    if entry_exit != 0 {
        // clang unavailable or cannot cross-target COFF from this host —
        // the object-emission assertions above already pinned the fix.
        assert true;
        return;
    }

    let out_exe = dir + "/coff_out.exe";
    let link_exit = process.run_capture([lld_link, obj1, obj2, entry_obj, "/entry:mainCRTStartup", "/subsystem:console", "/nodefaultlib", "/out:"
        + out_exe], _base_env());
    let _lo = process.capture_take_stdout();
    let lerr = process.capture_take_stderr();
    assert link_exit == 0;
    assert ! contains(lerr, "duplicate symbol");
}

test "coff comdat link: Mach-O target never receives the comdat clause" ![io] {
    let llc = _find_llc();
    if llc.length == 0 {
        assert true;
        return;
    }

    let dir = _scratch_dir();
    let src = dir + "/coff_darwin_guard.sfn";
    let ll = dir + "/coff_darwin_guard.ll";
    fs.writeFile(src, _module_source("darwin"));
    if fs.exists(ll) { fs.deleteFile(ll); }
    let mut e = clean_runner_env(nested_runner_scratch("coff-darwin-guard"));
    e.push("SAILFIN_TARGET_OS=Darwin");
    let emit_exit = process.run_capture([_sfn_bin(), "emit", "-o", ll, "llvm", src], e);
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    assert emit_exit == 0;
    assert fs.exists(ll);
    // Pins the sharp edge directly: an accidental unconditional comdat
    // clause would abort `llc` here with "MachO doesn't support COMDATs"
    // (verified manually against a hand-authored comdat fixture, SFN-549).
    assert ! contains(fs.readFile(ll), "comdat");

    let obj = dir + "/coff_darwin_guard.obj";
    let obj_exit = process.run_capture([llc, "-mtriple=arm64-apple-darwin", "-filetype=obj", ll, "-o", obj], _base_env());
    let _oo = process.capture_take_stdout();
    let oerr = process.capture_take_stderr();
    assert obj_exit == 0;
    assert ! contains(oerr, "MachO doesn't support COMDATs");
}
