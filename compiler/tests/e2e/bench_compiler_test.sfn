// End-to-end smoke test for `sfn bench --compiler` (SFN-61, epic #1503),
// the native replacement for the retired compile-time bench script. Drives the compiler
// binary as a subprocess and asserts on exit code + summary output, per
// .claude/rules/no-bash-e2e.md. Skips when the import-context tree is not
// staged (bench requires `make compile` to have produced it).
import { find } from "sfn/strings";
import { nested_runner_scratch, report_child_failure } from "sfn/test";

fn _sfn_bin() -> string ![io] {
    let configured = env.get("SAILFIN_BIN");
    if configured.length > 0 { return configured; }
    return "build/bin/sfn";
}

fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

test "bench: --compiler on a single module reports a summary" ![io] {
    // Skip when import-context is not staged (no `make compile` yet).
    if !fs.exists("build/compiler/import-context") {
        assert true;
        return;
    }
    let work = nested_runner_scratch("bench-compiler-summary");
    assert work.length > 0;
    fs.createDirectory(work, true);
    let exit = process.run_capture([_sfn_bin(), "bench", "--compiler", "--module", "build_flags", "--top", "1", "--work-dir", work], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("bench --compiler summary", exit, out, err);
    assert exit == 0;
    assert find(out + err, "SUMMARY", 0) >= 0;
}

test "bench: --compiler honors an isolated work dir per invocation" ![io] {
    if !fs.exists("build/compiler/import-context") {
        assert true;
        return;
    }
    let work_a = nested_runner_scratch("bench-isolation-a");
    let work_b = nested_runner_scratch("bench-isolation-b");
    assert work_a.length > 0;
    assert work_b.length > 0;
    fs.createDirectory(work_a, true);
    fs.createDirectory(work_b, true);

    let shared = "build/bench/build_flags.ll";
    let shared_existed = fs.exists(shared);
    let mut shared_len_before = 0;
    if shared_existed { shared_len_before = fs.readFile(shared).length; }

    let exit_a = process.run_capture([_sfn_bin(), "bench", "--compiler", "--module", "build_flags", "--top", "1", "--work-dir", work_a], _child_env());
    let out_a = process.capture_take_stdout();
    let err_a = process.capture_take_stderr();
    report_child_failure("bench --compiler isolation a", exit_a, out_a, err_a);
    assert exit_a == 0;

    let exit_b = process.run_capture([_sfn_bin(), "bench", "--compiler", "--module", "build_flags", "--top", "1", "--work-dir", work_b], _child_env());
    let out_b = process.capture_take_stdout();
    let err_b = process.capture_take_stderr();
    report_child_failure("bench --compiler isolation b", exit_b, out_b, err_b);
    assert exit_b == 0;

    // Compiler bench mode deletes <work_dir>/<module>.ll before each emit
    // (_run_compiler_mode); a shared default work dir let parallel pool jobs
    // invalidate one another's output (SFN-723). Distinct --work-dir roots
    // must each retain their own non-empty build_flags.ll.
    assert fs.exists(work_a + "/build_flags.ll");
    assert fs.readFile(work_a + "/build_flags.ll").length > 0;
    assert fs.exists(work_b + "/build_flags.ll");
    assert fs.readFile(work_b + "/build_flags.ll").length > 0;

    // A before/after snapshot (not `assert !fs.exists(shared)`) because the
    // shared default may already hold a stale build_flags.ll from a
    // developer's earlier `make bench`; asserting absence would flake on
    // that pre-existing state. SFN-723 only requires that this invocation,
    // routed through --work-dir, leaves the shared default untouched.
    assert fs.exists(shared) == shared_existed;
    let mut shared_len_after = 0;
    if fs.exists(shared) {
        shared_len_after = fs.readFile(shared).length;
    }
    assert shared_len_after == shared_len_before;
}

// Without `--compiler`, `sfn bench` dispatches to runtime mode (SFN-63); the
// runtime-mode surface itself is covered by bench_runtime_runner_test.sfn.
// Here, assert the dispatch reaches runtime mode by pointing it at a path with
// no workloads, which the runtime runner reports as an error (exit 1) rather
// than the old "only --compiler is implemented" exit 2.
test "bench: default (no --compiler) dispatches to runtime mode" ![io, clock] {
    let exit = process.run_capture([_sfn_bin(), "bench", "benchmarks/does-not-exist"], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    assert exit == 1;
}
