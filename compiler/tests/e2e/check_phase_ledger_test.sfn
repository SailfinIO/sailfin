// End-to-end test for the `make check` phase ledger (#1124, epic #1056
// Phase 2). Locks the `phases[]` array that scripts/agent_report.sh
// composes into build/agent-report.check.json when `make check` runs under
// the report gate (JSON=1 / SAILFIN_AGENT_REPORT=1).
//
// Native (no-bash) replacement for the former `test_check_phase_ledger.sh`
// (test-infra Phase 3, epic #842; `.claude/rules/no-bash-e2e.md`).
//
// WHY THIS TEST IS SHAPED THIS WAY (SFN-724). The previous version hardcoded
// the 2026-06 banner text as `echo` stubs and asserted the ledger derived
// from them. That validated a fossil of its own assumptions: when #1502 moved
// the self-host stages out of Makefile shell into `sfn selfhost` — changing
// every banner — the classifier stopped matching anything and reported every
// `check` failure as a `compile` failure, while this test stayed green
// because it still fed the classifier the old wording. A test that
// manufactures its inputs cannot notice that its inputs are wrong.
//
// The fixtures are therefore no longer written here. They are READ from
// scripts/agent_report.sh's `CHECK_PHASE_MARKERS` table, and the first
// assertion is that every literal in that table still appears verbatim in the
// producer that prints it — the `check-impl` target in `Makefile`, or
// `sfn selfhost` in compiler/src/cli_selfhost.sfn. Rewording a banner in
// either producer without re-syncing the table now fails here, which is the
// alarm #1502 should have tripped. The behavioural cases then drive the real
// classifier with those same extracted literals, so the stubs cannot drift
// from the table either.
//
// Deliberately does NOT run a real `make check`: a 15-20 min pipeline does
// not belong in a test. Static extraction + stub-driven derivation covers the
// contract in milliseconds.
//
// Cases:
//   - markers:  every table literal is verbatim in a producer.
//   - warn marker: the nondeterminism literal is verbatim in cli_selfhost.sfn.
//   - order:    the phase names match the documented pipeline order.
//   - green:    every phase banner + fixed-point match, exit 0 -> phases in
//               order, top-level status "pass".
//   - fail:     every banner then a test failure, exit 1 -> status "fail",
//               phase "seedcheck-tests", failure "test-failure".
//   - pass1 banner: a PASSING `0 failed` suite banner from the pass1 leg must
//               not classify a later build failure as "test-failure".
//   - warn:     every banner but `stage2 != stage3`, exit 0 -> status "warn",
//               failure "nondeterminism".
//
// Schema: docs/reference/make-result-schema.md (`sailfin-make/1`, phases[]).
//
// PLUMBING. agent_report.sh writes its report relative to cwd, and
// `process.run_capture` cannot cd. The faithful path (matching the bash
// `( cd "$sub"; env -u SAILFIN_INNER SAILFIN_AGENT_REPORT=1 bash WRAPPER
// ... )`) is therefore a single `bash -c` vehicle that does the cd + the
// env -u itself, since this case is inherently shell-composer plumbing.
// PATH/HOME are threaded so bash and the wrapper's tools resolve.
//
// On matchers: per the jq-less path the bash test already supports, the
// names-in-order check is an ORDERED-substring `contains` walk over the
// `"name":"<phase>"` markers, and the top-level status/phase/failure are read
// by FIRST-occurrence string matching (write_report_file emits every
// top-level field before phases[], so first-occurrence is the top-level
// value). Per-phase status asserts (jq-gated in the bash) are intentionally
// not reproduced — the top-level + ordered-names path is the jq-less contract
// the original falls back to. The `sfn/test` `expect_*` matchers are
// `![pure]` and cannot be called from this `![io]` test. (#842.)
import { find, contains, split } from "sfn/strings";

// Absolute repo root. The vehicle `cd`s into the per-run subdir before
// invoking the wrapper, so a relative `./scripts/agent_report.sh` would not
// resolve — the wrapper path (and the scratch subdir) must be absolute.
fn _repo_root() -> string ![io] {
    let root = env.get("SAILFIN_REPO_ROOT");
    if root.length > 0 && substring(root, 0, 1) == "/" { return root; }
    let exit = process.run_capture(["pwd"], _child_env());
    let out = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    if exit == 0 {
        let lines = split(out, "\n");
        if lines.length > 0 && lines[0].length > 0 { return lines[0]; }
    }
    if root.length > 0 { return root; }
    return ".";
}

fn _wrapper() -> string ![io] {
    return _repo_root() + "/scripts/agent_report.sh";
}

// Child env for the `bash -c` vehicle. SAILFIN_INNER / SAILFIN_AGENT_REPORT
// are deliberately omitted here AND cleared inside the vehicle via
// `env -u` (the wrapper sets SAILFIN_AGENT_REPORT=1 itself for the run).
fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

fn _scratch_base() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = "/tmp"; }
    dir = dir + "/sfn-check-ledger";
    fs.createDirectory(dir, true);
    return dir;
}

// ---- marker-table extraction ------------------------------------------------
// Last index of `needle` in `s`, or -1. No `rfind` in sfn/strings.
fn _rfind(s: string, needle: string) -> int {
    let mut best = 0 - 1;
    let mut pos = 0;
    loop {
        let at = find(s, needle, pos);
        if at < 0 { break; }
        best = at;
        pos = at + 1;
    }
    return best;
}

// Strip a shell single-quoted array element (`\t'record'`) down to `record`.
// Returns "" for a line carrying no quoted payload.
fn _unquote_element(line: string) -> string {
    let open = find(line, "'", 0);
    if open < 0 { return ""; }
    let close = _rfind(line, "'");
    if close <= open { return ""; }
    return substring(line, open + 1, close);
}

// The `CHECK_PHASE_MARKERS` records, verbatim, in declaration order. Each is
// `<phase-name>[|<literal>...]`. Reads the wrapper rather than restating the
// table, so the assertions below can never disagree with the shipped one.
fn _marker_records() -> string[] ![io] {
    let src = fs.readFile(_wrapper());
    let lines = split(src, "\n");
    let mut records: string[] = [];
    let mut inside = false;
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        i = i + 1;
        if !inside {
            // Line-start match, like _nondeterminism_marker below: a comment
            // mentioning the table by name must not hijack the scan.
            if find(line, "CHECK_PHASE_MARKERS=(", 0) == 0 { inside = true; }
            continue;
        }
        if contains(line, ")") && !contains(line, "'") { break; }
        let rec = _unquote_element(line);
        if rec.length > 0 { records.push(rec); }
    }
    return records;
}

// The `CHECK_MARKER_NONDETERMINISM` literal from the wrapper, or "".
fn _nondeterminism_marker() -> string ![io] {
    let src = fs.readFile(_wrapper());
    let lines = split(src, "\n");
    let mut i = 0;
    loop {
        if i >= lines.length { break; }
        let line = lines[i];
        i = i + 1;
        if find(line, "CHECK_MARKER_NONDETERMINISM=", 0) == 0 {
            return _unquote_element(line);
        }
    }
    return "";
}

// The record for `name`, or "" when absent. Preferred over indexing by
// position: an out-of-range index panics rather than failing an assertion.
fn _record_for(records: string[], name: string) -> string {
    let mut i = 0;
    loop {
        if i >= records.length { break; }
        if _record_name(records[i]) == name { return records[i]; }
        i = i + 1;
    }
    return "";
}

fn _record_name(record: string) -> string {
    let parts = split(record, "|");
    if parts.length == 0 { return ""; }
    return parts[0];
}

// The literals of a record (everything after the phase name). Empty for
// `compile`, which is unconditionally reached and carries no banner.
fn _record_literals(record: string) -> string[] {
    let parts = split(record, "|");
    let mut lits: string[] = [];
    let mut i = 1;
    loop {
        if i >= parts.length { break; }
        if parts[i].length > 0 { lits.push(parts[i]); }
        i = i + 1;
    }
    return lits;
}

// The two producers that print the banners the table keys off.
fn _producer_text() -> string ![io] {
    let root = _repo_root();
    return fs.readFile(root + "/Makefile") + "\n" + fs.readFile(root
        + "/compiler/src/cli_selfhost.sfn");
}

// ---- stub driving -----------------------------------------------------------
// Run agent_report.sh for `--target check` over a stub that prints the
// `banners` script and exits with `rc`. Creates a fresh per-test subdir,
// runs the wrapper inside it via a single `bash -c` vehicle (cd + env -u),
// reads and returns the composed report file's contents (or "").
fn _run_check_stub(tag: string, banners: string, rc: int) -> string ![io] {
    let mut sub = _scratch_base() + "/run-" + tag;
    // The vehicle `cd`s into `sub`, so it must be absolute (the runner-managed
    // SAILFIN_TEST_SCRATCH can be the relative `build/sailfin/...`).
    if sub.length > 0 && substring(sub, 0, 1) != "/" {
        sub = _repo_root() + "/" + sub;
    }
    // Per-tag subdir; the stale report is cleared so a wrapper that writes
    // nothing reads as "" rather than as the previous run's verdict.
    fs.createDirectory(sub, true);
    let report = sub + "/build/agent-report.check.json";
    if fs.exists(report) { fs.deleteFile(report); }

    // The inner command the wrapper runs: `bash -c "<banners>\nexit <rc>"`.
    // The wrapper claims the verdict (SAILFIN_AGENT_REPORT=1 turns the
    // report-file gate on; SAILFIN_INNER is cleared so it is the outer
    // target). The whole thing is composed as a single `bash -c` so the cd
    // + env -u happen in-shell, faithful to the original.
    let inner = banners + "\nexit " + _int_to_string(rc);
    let vehicle = "cd '" + sub
        + "' && env -u SAILFIN_INNER SAILFIN_AGENT_REPORT=1 "
        + "bash '"
        + _wrapper()
        + "' --target check -- bash -c '"
        + inner
        + "' >/dev/null 2>&1 || true";

    let _exit = process.run_capture(["bash", "-c", vehicle], _child_env());
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();

    if !fs.exists(report) { return ""; }
    return fs.readFile(report);
}

// One `echo "<literal>"` line per phase, built from the live marker table.
// `swap_from`/`swap_to` substitutes one literal (used by the warn case to
// emit the `stage2 != stage3` outcome instead of the matching one) — the
// fixed-point record carries every outcome line, and its FIRST literal is
// the matching one.
fn _banners_from_table(records: string[], swap_from: string, swap_to: string) -> string {
    let mut out = "";
    let mut i = 0;
    loop {
        if i >= records.length { break; }
        let lits = _record_literals(records[i]);
        i = i + 1;
        if lits.length == 0 { continue; }
        let mut lit = lits[0];
        if swap_from.length > 0 && lit == swap_from { lit = swap_to; }
        if out.length > 0 { out = out + "\n"; }
        out = out + "echo \"" + lit + "\"";
    }
    return out;
}

// Banners for every phase up to and including `stop_after`, so a stub can
// fail partway through the pipeline.
fn _banners_upto(records: string[], stop_after: string) -> string {
    let mut out = "";
    let mut i = 0;
    loop {
        if i >= records.length { break; }
        let name = _record_name(records[i]);
        let lits = _record_literals(records[i]);
        if lits.length > 0 {
            if out.length > 0 { out = out + "\n"; }
            out = out + "echo \"" + lits[0] + "\"";
        }
        if name == stop_after { break; }
        i = i + 1;
    }
    return out;
}

// Local int->decimal-string (no runtime builtin; mirrors the helper in
// lowering_no_bare_runtime_emissions_test.sfn).
fn _int_to_string(n: int) -> string {
    if n == 0 { return "0"; }
    let mut v = n;
    let mut neg = false;
    if v < 0 {
        neg = true;
        v = 0 - v;
    }
    let digits = "0123456789";
    let mut s = "";
    loop {
        if v == 0 { break; }
        let d = v % 10;
        s = digits[d] + s;
        v = v / 10;
    }
    if neg { s = "-" + s; }
    return s;
}

// jq-less first-occurrence read of `"field":"value"` -> value, or "".
fn _json_str_field(json: string, field: string) -> string {
    let key = "\"" + field + "\":\"";
    let at = find(json, key, 0);
    if at < 0 { return ""; }
    let value_start = at + key.length;
    let close = find(json, "\"", value_start);
    if close < 0 { return ""; }
    return substring(json, value_start, close);
}

// Ordered-substring walk: each marker must appear after the previous one.
// Mirrors the bash `grep -Eq '"name":"compile".*..."name":"seedcheck-tests"'`.
fn _names_in_order(json: string, records: string[]) -> boolean {
    let mut pos = 0;
    let mut i = 0;
    loop {
        if i >= records.length { break; }
        let marker = "\"name\":\"" + _record_name(records[i]) + "\"";
        let at = find(json, marker, pos);
        if at < 0 { return false; }
        pos = at + marker.length;
        i = i + 1;
    }
    return true;
}

// ---- static contract: the table still describes the real pipeline -----------
test "check ledger: every marker literal appears verbatim in a producer" ![io] {
    let records = _marker_records();
    // The table exists and was parsed (7 phases; `compile` plus six banners).
    assert records.length == 7;
    let producers = _producer_text();
    assert producers.length > 0;

    let mut i = 0;
    let mut literal_count = 0;
    loop {
        if i >= records.length { break; }
        let lits = _record_literals(records[i]);
        let mut j = 0;
        loop {
            if j >= lits.length { break; }
            // The alarm #1502 should have tripped: a banner reworded in
            // Makefile / cli_selfhost.sfn without re-syncing the table.
            assert contains(producers, lits[j]);
            // Stub construction wraps each literal in double quotes inside a
            // single-quoted `bash -c`, so anything the shell interprets there
            // — quotes, `$`, command substitution, escapes — would silently
            // corrupt the behavioural cases below.
            assert ! contains(lits[j], "\"");
            assert ! contains(lits[j], "`");
            assert ! contains(lits[j], "\\");
            assert ! contains(lits[j], "'");
            assert ! contains(lits[j], "$");
            literal_count = literal_count + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    // `compile` carries none; every other phase carries at least one.
    assert _record_literals(records[0]).length == 0;
    assert literal_count >= 6;
}

test "check ledger: nondeterminism marker appears verbatim in cli_selfhost" ![io] {
    let marker = _nondeterminism_marker();
    assert marker.length > 0;
    let selfhost = fs.readFile(_repo_root() + "/compiler/src/cli_selfhost.sfn");
    // `status:"warn"` / `failure:"nondeterminism"` is reachable only through
    // this literal; if `sfn selfhost` rewords it the warn path goes dark and
    // a fixed-point mismatch becomes invisible to agents (SFN-724).
    assert contains(selfhost, marker);
}

test "check ledger: phase names match the documented pipeline order" ![io] {
    let records = _marker_records();
    // Real order: `sfn selfhost` runs stage2 -> smoke -> stage3 -> fixed-point
    // as one internal chain, and the seedcheck suite runs AFTER it.
    let expected = ["compile", "pass1-smoke", "seedcheck-build", "seedcheck-smoke", "stage3-build", "fixed-point", "seedcheck-tests"];
    assert records.length == expected.length;
    let mut i = 0;
    loop {
        if i >= records.length { break; }
        assert _record_name(records[i]) == expected[i];
        i = i + 1;
    }
}

// ---- behavioural contract: the classifier derives the right verdict ---------
test "check ledger green: phases in order, top-level status=pass" ![io] {
    let records = _marker_records();
    let banners = _banners_from_table(records, "", "");
    let report = _run_check_stub("green", banners, 0);
    assert report.length > 0;
    assert _names_in_order(report, records);
    assert _json_str_field(report, "status") == "pass";
}

test "check ledger fail: seedcheck-tests fail, top-level fail/phase/failure" ![io] {
    let records = _marker_records();
    // Every phase banner, then a test-failure signature and a non-zero exit:
    // the failure lands in the last phase reached, which is the seedcheck
    // suite. Before SFN-724 this reported `compile` for any `check` failure.
    let banners = _banners_from_table(records, "", "")
        + "\necho \"unit: 3/4 passed, 1 failed\"";
    let report = _run_check_stub("fail", banners, 1);
    assert report.length > 0;
    assert _names_in_order(report, records);
    assert _json_str_field(report, "status") == "fail";
    assert _json_str_field(report, "phase") == "seedcheck-tests";
    assert _json_str_field(report, "failure") == "test-failure";
}

test "check ledger: a passing pass1 suite banner does not mask a build failure" ![io] {
    let records = _marker_records();
    // `sfn test` prints `═══ <suite>: N/M passed, K failed ═══` for EVERY
    // suite, pass or fail, so a plain `make check` always carries a `0
    // failed` banner from its pass1 leg. A `failed` count matched without a
    // non-zero anchor made that banner classify every LATER failure as
    // `test-failure` — a stage2 build break reported as a failing test, with
    // the agent sent to read test output that does not exist.
    let banners = _banners_upto(records, "seedcheck-build")
        + "\necho \"═══ sfn/test: 5/5 passed, 0 failed ═══\""
        + "\necho \"[selfhost] stage2 build failed (exit=1)\"";
    let report = _run_check_stub("pass1-banner", banners, 1);
    assert report.length > 0;
    assert _json_str_field(report, "status") == "fail";
    assert _json_str_field(report, "phase") == "seedcheck-build";
    assert _json_str_field(report, "failure") != "test-failure";
}

test "check ledger warn: nondeterminism, top-level warn/failure, exit 0" ![io] {
    let records = _marker_records();
    let fixed_point = _record_for(records, "fixed-point");
    assert fixed_point.length > 0;
    let fp_lits = _record_literals(fixed_point);
    assert fp_lits.length > 0;
    // The record's FIRST literal is the matching outcome; swap in the
    // mismatch line to drive the warn path.
    let matched = fp_lits[0];
    let mismatched = _nondeterminism_marker();
    assert matched != mismatched;
    let banners = _banners_from_table(records, matched, mismatched);
    let report = _run_check_stub("warn", banners, 0);
    assert report.length > 0;
    assert _names_in_order(report, records);
    assert _json_str_field(report, "status") == "warn";
    assert _json_str_field(report, "failure") == "nondeterminism";
    assert _json_str_field(report, "phase") == "fixed-point";
}
