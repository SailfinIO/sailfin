// End-to-end coverage for `sfn completion <shell>` script generation.
//
// The completion script is emitted from the live `sfn/cli` HelpNode derived
// from the root command tree — the same introspection source as
// `--help --json` — not a hand-maintained list. This test pins deterministic
// output, command coverage, target-shell syntax validity, and the
// unsupported-/missing-shell error paths (SFN-130, SFEP-0027 Phase D).
import { contains } from "sfn/strings";
import {
    bash_path,
    clean_runner_env,
    default_scratch_dir,
    host_is_windows,
    sfn_bin_path,
    skip,
    tool_present
} from "sfn/test";

// Derived by subtraction from the real environment via `clean_runner_env`,
// not built up key-by-key (SFN-1114).
fn _child_env() -> string[] ![io] {
    return clean_runner_env(env.get("SAILFIN_TEST_SCRATCH"));
}

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = default_scratch_dir(); }
    fs.createDirectory(dir, true);
    return dir;
}

// Native Windows resolves a bare `bash` through CreateProcess rather than the
// GitHub Actions step-shell selection that points at Git Bash. Prefer the Git
// for Windows provider whose MSYS path contract `bash_path` targets, then
// retain PATH lookup for custom hosts.
fn _bash_tool() -> string ![io] {
    if !host_is_windows() { return "bash"; }
    let program_files = env.get("ProgramFiles");
    if program_files.length > 0 {
        let system_git_bash = program_files + "\\Git\\bin\\bash.exe";
        if fs.exists(system_git_bash) { return system_git_bash; }
    }
    let local_app_data = env.get("LOCALAPPDATA");
    if local_app_data.length > 0 {
        let user_git_bash = local_app_data + "\\Programs\\Git\\bin\\bash.exe";
        if fs.exists(user_git_bash) { return user_git_bash; }
    }
    return "bash.exe";
}

test "cli completion: bash script is deterministic and names registered commands" ![io] {
    let exit1 = process.run_capture([sfn_bin_path(), "completion", "bash"], _child_env());
    let out1 = process.capture_take_stdout();
    let err1 = process.capture_take_stderr();
    assert exit1 == 0;
    assert err1.length == 0;

    let exit2 = process.run_capture([sfn_bin_path(), "completion", "bash"], _child_env());
    let out2 = process.capture_take_stdout();
    let err2 = process.capture_take_stderr();
    assert exit2 == 0;
    assert err2.length == 0;
    assert strings_equal(out1, out2);

    // The `complete -F` registration and the completion function are the
    // structural anchors of a bash completion script.
    assert contains(out1, "complete -F _sfn_complete sfn");
    assert contains(out1, "_sfn_complete()");
    assert contains(out1, "compgen -W");

    // Command coverage is derived from the registered tree. Anchor on the
    // per-command `case` arm label ("    <name>)") rather than a bare
    // substring: an unanchored `contains(out, "run")` would also match the
    // script's `return` statements and mask a missing `run` subcommand.
    assert contains(out1, "\n    build)\n");
    assert contains(out1, "\n    run)\n");
    assert contains(out1, "\n    check)\n");
    assert contains(out1, "\n    test)\n");
    assert contains(out1, "\n    completion)\n");
}

test "cli completion: generated bash script passes bash -n syntax check" ![io] {
    let bash = _bash_tool();
    if !tool_present(bash) {
        skip("Bash syntax oracle unavailable: no Git Bash provider or bash executable was found");
    }
    let exit = process.run_capture([sfn_bin_path(), "completion", "bash"], _child_env());
    let script = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;

    let path = _scratch_dir() + "/sfn-completion.bash";
    fs.writeFile(path, script);

    // `bash -n` parses without executing: a syntactically invalid completion
    // script fails here even though `sfn` emitted it happily.
    let check_exit = process.run_capture([bash, "-n", bash_path(path)], _child_env());
    let check_out = process.capture_take_stdout();
    let check_err = process.capture_take_stderr();
    assert check_exit == 0;
    assert check_out.length == 0;
    assert check_err.length == 0;
}

test "cli completion: unsupported shell exits 2 with a diagnostic" ![io] {
    let exit = process.run_capture([sfn_bin_path(), "completion", "powershell"], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 2;
    assert contains(out + err, "unsupported shell");
}

test "cli completion: missing shell argument is a usage error" ![io] {
    let exit = process.run_capture([sfn_bin_path(), "completion"], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 2;
    assert contains(out + err, "usage:");
    assert contains(out + err, "sfn completion");
}
