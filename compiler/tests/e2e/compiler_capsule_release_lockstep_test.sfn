// Release-version lockstep guard for private compiler implementation capsules
// (SFEP-0020, established with sfn/syntax in SFN-741).
import { remove_all } from "sfn/fs";
import { contains, find } from "sfn/strings";
import {
    bash_path,
    clean_runner_env,
    clean_runner_env_without,
    git_bash_path,
    nested_runner_scratch,
    report_child_failure
} from "sfn/test";

import { capsule_artifact_dir } from "../../src/capsule_artifact";
import { compiler_capsule_role } from "../../src/capsule_names";
import { load_workspace_members, validate_unique_workspace_member_names } from "../../src/capsule_resolver/workspace";
import { toml_get_publish, toml_get_version } from "../../src/toml_parser";

extern fn realpath(path: *u8, resolved: *u8) -> *u8;

fn _lockstep_repo_root() -> string ![io] {
    let configured = env.get("SAILFIN_REPO_ROOT");
    if configured.length > 0 { return configured; }
    let resolved: *u8 = realpath("." as *u8, null);
    if resolved as i64 != 0 { return resolved as string; }
    let pwd = env.get("PWD");
    if pwd.length > 0 { return pwd; }
    return ".";
}

fn _release_git(argv: string[], child_env: string[], cwd: string) -> string ![io] {
    let exit = process.run_capture_cwd(argv, child_env, cwd);
    let output = process.capture_take_stdout();
    let error = process.capture_take_stderr();
    if exit != 0 {
        throw "release fixture git command failed (exit " + exit.toString()
            + "): "
            + error;
    }
    return output;
}

fn _release_relocation_fixture(label: string, semantic_suffix: string) -> string[] ![io] {
    let root = nested_runner_scratch("capsule-release-" + label);
    assert remove_all(root);
    fs.createDirectory(root + "/capsules/sfn/probe/tests", true);
    fs.writeFile(root + "/capsules/sfn/probe/capsule.toml", "[capsule]\nname = \"sfn/probe\"\nversion = \"1.2.3\"\n\n"
        + "[build]\nentry = \"src/mod.sfn\"\nkind = \"library\"\n");
    fs.writeFile(root + "/capsules/sfn/probe/tests/path_test.sfn", "let alpha = 1;\nlet beta = 2;\nlet gamma = 3;\n"
        + "let fixture = \"capsules/sfn/probe/tests/fixture.sfn\";\n"
        + "let delta = 4;\nlet epsilon = 5;\n");
    let child_env = clean_runner_env(bash_path(root + "/runner-scratch"));
    let _ = _release_git(["git", "init", "-q"], child_env, root);
    let _ = _release_git(["git", "config", "user.email", "test@sailfin.dev"], child_env, root);
    let _ = _release_git(["git", "config", "user.name", "Sailfin Test"], child_env, root);
    let _ = _release_git(["git", "add", "."], child_env, root);
    let _ = _release_git(["git", "commit", "-qm", "baseline"], child_env, root);
    let before_line = _release_git(["git", "rev-parse", "HEAD"], child_env, root);
    let before = substring(before_line, 0, before_line.length - 1);

    fs.createDirectory(root + "/stdlib/probe/tests", true);
    fs.writeFile(root + "/stdlib/probe/capsule.toml", fs.readFile(root
        + "/capsules/sfn/probe/capsule.toml"));
    fs.writeFile(root + "/stdlib/probe/tests/path_test.sfn", "let alpha = 1;\nlet beta = 2;\nlet gamma = 3;\n"
        + "let fixture = \"stdlib/probe/tests/fixture.sfn\";\n"
        + "let delta = 4;\nlet epsilon = 5;\n"
        + semantic_suffix);
    fs.deleteFile(root + "/capsules/sfn/probe/capsule.toml");
    fs.deleteFile(root + "/capsules/sfn/probe/tests/path_test.sfn");
    let _ = _release_git(["git", "add", "-A"], child_env, root);
    let _ = _release_git(["git", "commit", "-qm", "relocate"], child_env, root);
    let after_line = _release_git(["git", "rev-parse", "HEAD"], child_env, root);
    let after = substring(after_line, 0, after_line.length - 1);
    let status_line = _release_git(["git", "diff", "--name-status", "--find-renames=50%", before, after, "--", "capsules/sfn/probe/tests/path_test.sfn", "stdlib/probe/tests/path_test.sfn"], child_env, root);
    let first_tab = find(status_line, "\t", 0);
    assert first_tab > 0;
    let status = substring(status_line, 0, first_tab);
    assert substring(status, 0, 1) == "R";
    fs.writeFile(root + "/before-public", "sfn/probe\tcapsules/sfn/probe\t\n");
    return [root, before, after, status];
}

fn _release_topology_exit(fixture: string[], expected_exit: int) -> int ![io] {
    let root = fixture[0];
    let classifier = bash_path(_lockstep_repo_root()
        + "/scripts/capsule-release-topology-only.sh");
    let temp = root + "/classifier temp";
    fs.createDirectory(temp, true);
    let mut child_env = clean_runner_env_without(bash_path(root
        + "/classifier-scratch"), ["RUNNER_TEMP", "TMPDIR"]);
    child_env.push("RUNNER_TEMP=" + bash_path(temp));
    let exit = process.run_capture_cwd([git_bash_path(), classifier, fixture[1], fixture[2], bash_path(root
        + "/before-public"), "sfn/probe", "stdlib/probe", fixture[3], bash_path("capsules/sfn/probe/tests/path_test.sfn"), bash_path("stdlib/probe/tests/path_test.sfn")], child_env, root);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    let mut result = exit;
    if expected_exit == 1 && err.length > 0 {
        report_child_failure("capsule-release topology classifier", exit, out, err);
        result = -1;
    } else if exit != expected_exit {
        report_child_failure("capsule-release topology classifier", exit, out, err);
    }
    assert remove_all(root);
    return result;
}

test "compiler capsule release: every private manifest matches the compiler version" ![io] {
    let root = _lockstep_repo_root();
    let members = load_workspace_members(root);
    assert validate_unique_workspace_member_names(members, root);
    let mut compiler_version = "";
    let mut ci: int = 0;
    loop {
        if ci >= members.length { break; }
        if members[ci].name == "sfn/compiler" {
            compiler_version = toml_get_version(fs.readFile(root + "/" + members[ci].member_path
                + "/capsule.toml"));
            break;
        }
        ci += 1;
    }
    if compiler_version.length == 0 {
        throw "compiler manifest version is missing";
    }

    let mut checked = 0;
    let mut i = 0;
    loop {
        if i >= members.length { break; }
        let member = members[i];
        i += 1;
        if compiler_capsule_role(member.name).length == 0 { continue; }
        let manifest = root + "/" + member.member_path + "/capsule.toml";
        let text = fs.readFile(manifest);
        let version = toml_get_version(text);
        if version != compiler_version {
            throw member.name + " at " + manifest + " has version " + version
                + " which does not match compiler "
                + compiler_version;
        }
        let publish = toml_get_publish(text);
        if publish.error.length > 0 || publish.publish == null {
            throw member.name + " has an invalid [capsule] publish policy";
        }
        if publish.publish != null {
            let allowed: boolean = publish.publish;
            if allowed {
                throw member.name + " must set [capsule] publish = false";
            }
        }
        checked += 1;
    }
    if checked != 6 {
        throw "expected six canonical compiler-role manifests, checked "
            + checked.toString();
    }
    assert capsule_artifact_dir("sfn", "compiler") == "build/capsules/sfn/compiler";
    assert capsule_artifact_dir("sfn", "syntax") == "build/capsules/sfn/syntax";
    assert capsule_artifact_dir("sfn", "analyzer") == "build/capsules/sfn/analyzer";
    assert capsule_artifact_dir("sfn", "ir") == "build/capsules/sfn/ir";
    assert capsule_artifact_dir("sfn", "codegen") == "build/capsules/sfn/codegen";
    assert capsule_artifact_dir("sfn", "codegen-llvm") == "build/capsules/sfn/codegen-llvm";
}

test "compiler capsule release: workflows select private manifests by identity" ![io] {
    let root = _lockstep_repo_root();
    let release = fs.readFile(root + "/.github/workflows/release.yml");
    let tag = fs.readFile(root + "/.github/workflows/release-tag.yml");
    let train = fs.readFile(root + "/.github/workflows/release-train.yml");

    assert contains(release, "--member-manifest sfn/compiler");
    assert contains(release, "--compiler-manifests");
    assert contains(release, "git add --");
    assert contains(release, "compiler_manifests");
    assert contains(release, "Expected six compiler-role manifests");
    assert ! contains(release, "find compiler/capsules");
    assert ! contains(release, "git add compiler/capsule.toml");

    assert contains(tag, "--compiler-manifests");
    assert contains(tag, "expected six compiler-role manifests");
    assert contains(tag, "Retroactive rebuilds may check out a tag older");
    assert contains(train, "--member-manifest");
    assert contains(train, "workspaceFacts(r.head_sha).freshness");
    assert ! contains(train, "SELFHOST_PREFIXES");
    assert ! contains(train, "<diff too large to verify>");
}

test "compiler capsule release: public discovery spans topology roots without move bumps" ![io] {
    let workflow = fs.readFile(_lockstep_repo_root()
        + "/.github/workflows/capsule-release.yml");
    assert contains(workflow, "- 'capsules/**'");
    assert contains(workflow, "- 'stdlib/**'");
    assert contains(workflow, "- 'runtime/prelude.sfn'");
    assert contains(workflow, "--public-members");
    assert contains(workflow, "--find-renames=50%");
    assert contains(workflow, "capsule-release-topology-only.sh");
    assert contains(workflow, "before_public");
    assert contains(workflow, "topology_classifier");
    assert contains(workflow, "changed_external_entries");
    assert contains(workflow, "git add --");
    assert contains(workflow, "changed_manifests");
    assert ! contains(workflow, "find capsules -name capsule.toml");
}

test "compiler capsule release: relocation path rewrites do not bump versions" ![io] {
    let fixture = _release_relocation_fixture("path-only", "");
    assert _release_topology_exit(fixture, 0) == 0;
}

test "compiler capsule release: relocation plus semantic edits still bumps versions" ![io] {
    let fixture = _release_relocation_fixture("semantic", "let behavior = 2;\n");
    assert _release_topology_exit(fixture, 1) == 1;
}

test "compiler capsule release: CI formatter and checks use workspace views" ![io] {
    let workflow = fs.readFile(_lockstep_repo_root()
        + "/.github/workflows/ci.yml");
    assert contains(workflow, "--compiler-sources");
    assert contains(workflow, "--maintainer-sources");
    assert contains(workflow, "--member-manifest sfn/ir");
    assert ! contains(workflow, "find compiler/src compiler/capsules runtime");
    assert ! contains(workflow, "sfn check compiler/src compiler/capsules runtime");
}
