// Release-version lockstep guard for private compiler implementation capsules
// (SFEP-0020, established with sfn/syntax in SFN-741).
import { contains } from "sfn/strings";

import { capsule_artifact_dir } from "../../src/capsule_artifact";
import { compiler_capsule_role } from "../../src/capsule_names";
import { load_workspace_members, validate_unique_workspace_member_names } from "../../src/capsule_resolver/workspace";
import { toml_get_publish, toml_get_version } from "../../src/toml_parser";

fn _lockstep_repo_root() -> string ![io] {
    let root = env.get("SAILFIN_REPO_ROOT");
    if root.length > 0 { return root; }
    return ".";
}

test "compiler capsule release: every private manifest matches the compiler version" ![io] {
    let root = _lockstep_repo_root();
    let members = load_workspace_members(root);
    assert validate_unique_workspace_member_names(members, root);
    let mut compiler_version = "";
    let mut ci: int = 0;
    loop {
        if ci >= members.length { break; }
        if members[ci].name == "sfn/compiler" {
            compiler_version = toml_get_version(fs.readFile(root + "/" + members[ci].member_path
                + "/capsule.toml"));
            break;
        }
        ci += 1;
    }
    if compiler_version.length == 0 {
        throw "compiler manifest version is missing";
    }

    let mut checked = 0;
    let mut i = 0;
    loop {
        if i >= members.length { break; }
        let member = members[i];
        i += 1;
        if compiler_capsule_role(member.name).length == 0 { continue; }
        let manifest = root + "/" + member.member_path + "/capsule.toml";
        let text = fs.readFile(manifest);
        let version = toml_get_version(text);
        if version != compiler_version {
            throw member.name + " at " + manifest + " has version " + version
                + " which does not match compiler "
                + compiler_version;
        }
        let publish = toml_get_publish(text);
        if publish.error.length > 0 || publish.publish == null {
            throw member.name + " has an invalid [capsule] publish policy";
        }
        if publish.publish != null {
            let allowed: boolean = publish.publish;
            if allowed {
                throw member.name + " must set [capsule] publish = false";
            }
        }
        checked += 1;
    }
    if checked != 6 {
        throw "expected six canonical compiler-role manifests, checked "
            + checked.toString();
    }
    assert capsule_artifact_dir("sfn", "compiler") == "build/capsules/sfn/compiler";
    assert capsule_artifact_dir("sfn", "syntax") == "build/capsules/sfn/syntax";
    assert capsule_artifact_dir("sfn", "analyzer") == "build/capsules/sfn/analyzer";
    assert capsule_artifact_dir("sfn", "ir") == "build/capsules/sfn/ir";
    assert capsule_artifact_dir("sfn", "codegen") == "build/capsules/sfn/codegen";
    assert capsule_artifact_dir("sfn", "codegen-llvm") == "build/capsules/sfn/codegen-llvm";
}

test "compiler capsule release: workflows select private manifests by identity" ![io] {
    let root = _lockstep_repo_root();
    let release = fs.readFile(root + "/.github/workflows/release.yml");
    let tag = fs.readFile(root + "/.github/workflows/release-tag.yml");
    let train = fs.readFile(root + "/.github/workflows/release-train.yml");

    assert contains(release, "--member-manifest sfn/compiler");
    assert contains(release, "--compiler-manifests");
    assert contains(release, "git add --");
    assert contains(release, "compiler_manifests");
    assert contains(release, "Expected six compiler-role manifests");
    assert ! contains(release, "find compiler/capsules");
    assert ! contains(release, "git add compiler/capsule.toml");

    assert contains(tag, "--compiler-manifests");
    assert contains(tag, "expected six compiler-role manifests");
    assert contains(tag, "Retroactive rebuilds may check out a tag older");
    assert contains(train, "--member-manifest");
    assert contains(train, "workspaceFacts(r.head_sha).freshness");
    assert ! contains(train, "SELFHOST_PREFIXES");
    assert ! contains(train, "<diff too large to verify>");
}

test "compiler capsule release: public discovery spans topology roots without move bumps" ![io] {
    let workflow = fs.readFile(_lockstep_repo_root()
        + "/.github/workflows/capsule-release.yml");
    assert contains(workflow, "- 'capsules/**'");
    assert contains(workflow, "- 'stdlib/**'");
    assert contains(workflow, "- 'runtime/prelude.sfn'");
    assert contains(workflow, "--public-members");
    assert contains(workflow, "--find-renames=100%");
    assert contains(workflow, "status\" = \"R100");
    assert contains(workflow, "before_public");
    assert contains(workflow, "old_identity");
    assert contains(workflow, "changed_external_entries");
    assert contains(workflow, "git add --");
    assert contains(workflow, "changed_manifests");
    assert ! contains(workflow, "find capsules -name capsule.toml");
}

test "compiler capsule release: CI formatter and checks use workspace views" ![io] {
    let workflow = fs.readFile(_lockstep_repo_root()
        + "/.github/workflows/ci.yml");
    assert contains(workflow, "--compiler-sources");
    assert contains(workflow, "--maintainer-sources");
    assert contains(workflow, "--member-manifest sfn/ir");
    assert ! contains(workflow, "find compiler/src compiler/capsules runtime");
    assert ! contains(workflow, "sfn check compiler/src compiler/capsules runtime");
}
