test "toolchain dispatch: a + selector below the project floor is rejected unless skipped" ![io] {
    let store = _scratch_root() + "/cli-below-floor-store";
    let proj = _scratch_root() + "/cli-below-floor-proj";
    let marker = "DISPATCH_CLI_BELOW_FLOOR_888_2f6c";
    _seed_stub(store, "888.0.0", marker, true);
    let src = _seed_project(proj, "999.0.0");
    let run_env = _env_with(["INSTALL_BASE=" + store]);

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+888.0.0", "check", src], run_env, proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert contains(err, "does not satisfy the project pin");
    assert contains(err, "999.0.0");
    assert ! contains(out + err, marker);

    _require_reexec();
    let skip_exit = process.run_capture_cwd([sfn_bin_abs_path(), "+888.0.0", "--skip-toolchain-check", "check", src], run_env, proj);
    let skip_out = process.capture_take_stdout();
    let skip_err = process.capture_take_stderr();
    report_child_failure("toolchain-dispatch cli-below-floor skip run", skip_exit, skip_out, skip_err);
    assert contains(skip_out + skip_err, marker);
    assert skip_exit == 0;
}

test "toolchain dispatch: local refuses to fetch a + selected version" ![io] {
    let store = _scratch_root() + "/cli-local-store";
    let proj = _scratch_root() + "/cli-local-proj";
    // 555.0.0 is never seeded — the store entry stays absent.
    let src = _seed_project(proj, "0.0.1");

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+555.0.0", "check", src], _env_with(["INSTALL_BASE="
        + store, "SAILFIN_TOOLCHAIN=local"]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert contains(err, "local");
    assert contains(err, "555.0.0");
}

test "toolchain dispatch: a + selector forwards a command this toolchain does not recognize" ![io] {
    _require_reexec();
    let store = _scratch_root() + "/cli-unfamiliar-cmd-store";
    let proj = _scratch_root() + "/cli-unfamiliar-cmd-proj";
    let marker = "DISPATCH_UNFAMILIAR_CMD_888_71ad";
    _seed_stub(store, "888.0.0", marker, true);
    let _ = _seed_project(proj, "0.0.1");

    // `totally-not-a-real-command` is not a registered subcommand of this
    // toolchain's own command tree; the prefix scan must forward it to the
    // selected payload rather than failing THIS toolchain's argument parsing.
    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+888.0.0", "totally-not-a-real-command", "--weird-flag"], _env_with(["INSTALL_BASE="
        + store]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("toolchain-dispatch unfamiliar-command run", exit, out, err);
    assert contains(out + err, marker);
    assert exit == 0;
}

test "toolchain dispatch: re-exec preserves the dispatched child's exit code" ![io] {
    _require_reexec();
    let store = _scratch_root() + "/exit-code-store";
    let proj = _scratch_root() + "/exit-code-proj";
    let marker = "DISPATCH_EXIT_CODE_888_5a3e";
    _seed_stub_exit_code(store, "888.0.0", marker, "42");
    let src = _seed_project(proj, "0.0.1");

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+888.0.0", "check", src], _env_with(["INSTALL_BASE="
        + store]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert contains(out + err, marker);
    assert exit == 42;
}

test "toolchain dispatch: a channel selector is rejected as not yet available" ![io] {
    let proj = _scratch_root() + "/channel-selector-proj";
    let src = _seed_project(proj, "0.0.1");

    let exit = process.run_capture([sfn_bin_path(), "+stable", "check", src], _env_with([]));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 2;
    assert contains(err, "channel selectors");
    assert contains(err, "not available yet");
}

// The exact version string this compiler-under-test reports for itself, so
// a selector naming it can be constructed without hardcoding a version that
// would drift out of sync with the binary under test.
fn _running_version() -> string ![io] {
    let exit = process.run_capture([sfn_bin_abs_path(), "--version"], _env_with([]));
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("toolchain-dispatch running-version probe", exit, out, err);
    assert exit == 0;
    let parts = split(trim(out), " ");
    assert parts.length >= 2;
    return parts[1];
}

// SFN-1065 bug fix regression: `_dispatch_child_env` used to forward the
// parent's exact `SAILFIN_TOOLCHAIN` verbatim, handing the dispatched child a
// selection knob disagreeing with what it IS. The child's own dispatch-loop
// guard would then die on that self-contradiction. The env-reporting stub is
// the only seeded entry that can observe this: every marker-only stub prints
// and exits without ever re-entering the dispatcher.
test "toolchain dispatch: the dispatched child does not inherit a conflicting exact knob" ![io] {
    _require_reexec();
    let store = _scratch_root() + "/child-env-conflict-store";
    let proj = _scratch_root() + "/child-env-conflict-proj";
    _seed_env_report_stub(store, "888.0.0", "child_env_conflict");
    let src = _seed_project(proj, "0.0.1");

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+888.0.0", "check", src], _env_with(["INSTALL_BASE="
        + store, "SAILFIN_TOOLCHAIN=999.0.0"]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("toolchain-dispatch child-env-conflict run", exit, out, err);
    assert exit == 0;
    // The dispatched child sees itself as the target, never the stale knob.
    assert contains(out, "MARKER=888.0.0");
    assert contains(out, "KNOB=\n");
}

// A mode word (unlike an exact version) constrains fetching/floor behavior
// rather than selecting a version, so it must survive into the child.
test "toolchain dispatch: a mode word survives into the dispatched child" ![io] {
    _require_reexec();
    let store = _scratch_root() + "/child-env-mode-store";
    let proj = _scratch_root() + "/child-env-mode-proj";
    _seed_env_report_stub(store, "888.0.0", "child_env_mode");
    let src = _seed_project(proj, "0.0.1");

    // `local` forbids fetching, not dispatching an already-seeded entry.
    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+888.0.0", "check", src], _env_with(["INSTALL_BASE="
        + store, "SAILFIN_TOOLCHAIN=local"]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("toolchain-dispatch child-env-mode run", exit, out, err);
    assert exit == 0;
    assert contains(out, "MARKER=888.0.0");
    assert contains(out, "KNOB=local\n");
}

// SFN-1065 bug fix regression: a `+<version>` selector that resolves to the
// running toolchain in-process must outrank an exact `SAILFIN_TOOLCHAIN` in
// the command's own gate too (`ctx.selector_resolved`), not just at the
// selector site itself — otherwise the lower-ranked env knob reopens a
// decision the selector already made.
test "toolchain dispatch: a CLI selector naming the running toolchain beats the env knob" ![io] {
    let store = _scratch_root() + "/cli-running-beats-env-store";
    let proj = _scratch_root() + "/cli-running-beats-env-proj";
    let env_marker = "DISPATCH_ENV_999_SHOULD_NOT_RUN_9f3c";
    _seed_stub(store, "999.0.0", env_marker, true);
    let src = _seed_project(proj, "0.0.1");
    let running = _running_version();

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+" + running, "check", src], _env_with(["INSTALL_BASE="
        + store, "SAILFIN_TOOLCHAIN=999.0.0"]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("toolchain-dispatch cli-running-beats-env run", exit, out, err);
    assert exit == 0;
    // The 999.0.0 store stub never ran — the selector resolved in-process.
    assert ! contains(out + err, env_marker);
}

// `_dispatch_normalize_ver` strips a leading `v`; nothing else in this file
// exercises a `v`-prefixed selector.
test "toolchain dispatch: a v-prefixed selector normalizes" ![io] {
    _require_reexec();
    let store = _scratch_root() + "/v-prefixed-store";
    let proj = _scratch_root() + "/v-prefixed-proj";
    let marker = "DISPATCH_V_PREFIXED_888_6b1e";
    _seed_stub(store, "888.0.0", marker, true);
    let src = _seed_project(proj, "0.0.1");

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+v888.0.0", "check", src], _env_with(["INSTALL_BASE="
        + store]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    report_child_failure("toolchain-dispatch v-prefixed run", exit, out, err);
    assert contains(out + err, marker);
    assert exit == 0;
}

test "toolchain dispatch: toolchain run --help renders help and never dispatches" ![io] {
    let store = _scratch_root() + "/toolchain-run-help-store";
    let proj = _scratch_root() + "/toolchain-run-help-proj";
    let marker = "DISPATCH_RUN_HELP_888_2a9d";
    _seed_stub(store, "888.0.0", marker, true);
    let _ = _seed_project(proj, "0.0.1");

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "toolchain", "run", "--help"], _env_with(["INSTALL_BASE="
        + store]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(out, "<version>");
    assert ! contains(out + err, marker);
}

// A `toolchain run <version>` with no forwarded command is a local usage
// error, not a dispatch — dispatching here would fetch a toolchain just to
// print its own usage.
test "toolchain dispatch: toolchain run with no forwarded command does not dispatch" ![io] {
    let store = _scratch_root() + "/toolchain-run-no-cmd-store";
    let proj = _scratch_root() + "/toolchain-run-no-cmd-proj";
    let marker = "DISPATCH_RUN_NO_CMD_888_2a9d";
    _seed_stub(store, "888.0.0", marker, true);
    let _ = _seed_project(proj, "0.0.1");

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "toolchain", "run", "888.0.0"], _env_with(["INSTALL_BASE="
        + store]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert contains(out + err, "usage:");
    assert ! contains(out + err, marker);
}

test "toolchain dispatch: a + version query never fetches and still reports the entry version" ![io] {
    let store = _scratch_root() + "/version-query-store";
    let proj = _scratch_root() + "/version-query-proj";
    // 888.0.0 is never seeded — the version query must stay network-silent
    // and fall through rather than fetching it just to print its version.
    let _ = _seed_project(proj, "0.0.1");

    let exit = process.run_capture_cwd([sfn_bin_abs_path(), "+888.0.0", "--version"], _env_with(["INSTALL_BASE="
        + store]), proj);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert contains(err, "sfn toolchain install 888.0.0");
    // Falls through to the entry toolchain's own version report.
    assert contains(out, "sfn ");
}
