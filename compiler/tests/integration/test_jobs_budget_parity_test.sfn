// compiler/tests/integration/test_jobs_budget_parity_test.sfn
//
// SFN-794: the test-pool job budget is implemented twice and the two forms
// must agree by contract —
//
//   * `_test_jobs_budget(memsize_bytes, nproc, is_darwin)` in
//     `compiler/src/cli/commands/test/arg_and_jobs.sfn`, byte arithmetic,
//     behind `sfn test`'s native `--jobs` default
//   * `scripts/detect_test_jobs.sh`, whole-MiB arithmetic, behind the
//     Makefile's `TEST_JOBS ?=` default
//
// Nothing checked that they agree. SFN-781 was the second hand-edit of these
// constants (SFN-626 was the first) and left three caller comments stating the
// superseded policy; all three were caught by review, none by CI. A divergence
// in the *arithmetic* would have been equally invisible, and its failure mode
// is an OOMed runner rather than a red test. This file drives both
// implementations over one shared table so a one-sided edit fails the build.
//
// Driving a checked-in `scripts/*.sh` from a thin `.sfn` wrapper is the shape
// sanctioned by `docs/conventions/e2e-tests.md` (SANCTIONED-SHIM): the script is the
// subject under test, not a vehicle for work a Sailfin primitive should do.
// `run_capture`'s env is the EMPTY environment rather than "inherit", so PATH
// is threaded explicitly — the script calls `uname`/`nproc`/`awk`. No build is
// spawned, so the `SAILFIN_TEST_SCRATCH` / `clean_runner_env` isolation rules
// do not apply here.
//
// This file only observes: it asserts the two forms agree and pins the answers
// they agree on. It is deliberately not a place to change policy — a constant
// moves in `arg_and_jobs.sfn` and `detect_test_jobs.sh` together, and the table
// below is then re-derived.
//
// What the table samples is a property that actually holds everywhere, which is
// worth knowing before adding rows to it. Writing the native input as
// `m * 2^20` bytes, `floor(m * 2^20 * 80/100)` is `floor(m * 80/100)` MiB plus a
// remainder strictly under 1 MiB; because the reserve (5120 MiB) and the
// per-job divisor (3072 MiB) are both whole MiB, that sub-MiB remainder can
// never carry the quotient across an integer boundary, and the `<=`-vs-`-le`
// branch shapes coincide for the same reason. So the twins agree at EVERY
// whole-MiB input, and the rows below are chosen to be legible rather than to
// be exhaustive. The load-bearing half is the whole-MiB property itself, which
// the exact-MiB-boundary test further down pins directly — that is the one a
// new constant can break.
import { int_to_string, parse_int, trim } from "sfn/strings";
import { skip, tool_present } from "sfn/test";

import { _resolve_auto_test_jobs, _test_jobs_budget } from "../../src/cli/commands/test/arg_and_jobs";

// The bash twin works in whole MiB and the native twin in bytes, so every row
// below is stated once in MiB and scaled for the native call.
fn _mib() -> int { return 1048576; }

fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let path = env.get("PATH");
    if path.length > 0 { e.push("PATH=" + path); }
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    return e;
}

// The job count the bash twin prints for one row of the table, or -1 when it
// exits non-zero or prints something unparseable. -1 can never equal a native
// budget (which floors at 1), so a broken script fails the comparison rather
// than being read as agreement.
fn _bash_jobs_argv(args: string[]) -> int ![io] {
    let mut argv: string[] = ["bash", "scripts/detect_test_jobs.sh"];
    let mut i: int = 0;
    loop {
        if i >= args.length { break; }
        argv.push(args[i]);
        i += 1;
    }
    let exit = process.run_capture(argv, _child_env());
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    if exit != 0 { return -1; }
    let mut jobs: int = -1;
    match parse_int(trim(out)) {
        Result.Ok { value } => { jobs = value; },
        Result.Err { error } => { return -1; }
    }
    return jobs;
}

fn _bash_jobs(mem_mib: int, cores: int, uname_s: string) -> int ![io] {
    return _bash_jobs_argv([int_to_string(mem_mib), int_to_string(cores), uname_s]);
}

fn _uname_for(is_darwin: boolean) -> string {
    if is_darwin { return "Darwin"; }
    return "Linux";
}

// Name the row in the log before asserting on it. A bare `assert` reports only
// that the loop failed, which on a 17-row sweep is the difference between a
// one-line diagnosis and a bisect.
fn _report_row(mem_mib: int, cores: int, uname_s: string, native: int, bash_jobs: int, expected: int) -> void ![io] {
    print.info("test-jobs parity: mem_mib=" + int_to_string(mem_mib) + " cores="
        + int_to_string(cores)
        + " uname="
        + uname_s
        + " native="
        + int_to_string(native)
        + " bash="
        + int_to_string(bash_jobs)
        + " expected="
        + int_to_string(expected));
}

// The shared table. Every row is a structural boundary of the budget, not a
// sampled host:
//
//   0        an unmeasurable host — the native early return on `<= 0` bytes
//            against the bash `mem_mb=1536` sanitize fallback, which is
//            deliberately below the parent reserve so both floor to serial
//   1536     that fallback value itself
//   6400     `usable` is EXACTLY the 5 GiB parent reserve — the native `<=`
//            early return and the bash `-le` branch, taken together
//   6401     the branch shapes diverge here and must still agree: the native
//            form leaves its early return while bash's truncated `usable` is
//            still 5120, so bash stays on the `-le` side for one more MiB
//   6402     both forms are past the reserve and both hit the `by_mem < 1`
//            floor
//   10239/10240  the 1-job threshold, which the floor masks on both sides
//   14079/14080  the 2-job threshold — the first observable 1 -> 2 step
//   15019    a non-threshold host whose 80% slice truncates in both forms
//   16075    the host from the SFN-781 report (MemTotal 16461004 kB), which
//            the old policy gave 4 jobs and SIGKILLed at 17.26 GiB tree RSS
//   32768/0  the `cores < 1` sanitize, native `cores = 1` vs bash `cores=1`
//   32768/16 memory-bound at 6 jobs
//   65536/2  CPU-bound below a large memory budget
//   1048576  the global cap of 16, and the Darwin cap of 2 over the same row
//   10240 Darwin  a Darwin host where memory binds below the Darwin cap, so
//            the cap is not what produces the answer
//   -1/-4    a negative measurement, which both forms sanitize rather than
//            propagate into the arithmetic
test "test-jobs budget: the native and bash twins agree across the shared table (SFN-794)" ![io] {
    if !tool_present("bash") { skip("bash not on PATH"); }
    let mem_mib: int[] = [0, 1536, 6400, 6401, 6402, 10239, 10240, 14079, 14080, 15019, 16075, 32768, 32768, 65536, 1048576, 1048576, 10240, -1];
    let cores: int[] = [8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 4, 0, 16, 2, 64, 64, 8, -4];
    let darwin: boolean[] = [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, true, true, false];
    let expected: int[] = [1, 1, 1, 1, 1, 1, 1, 1, 2, 2, 2, 1, 6, 2, 16, 2, 1, 1];

    let mut i: int = 0;
    loop {
        if i >= mem_mib.length { break; }
        let uname_s = _uname_for(darwin[i]);
        let native = _test_jobs_budget(mem_mib[i] * _mib(), cores[i], darwin[i]);
        let bash_jobs = _bash_jobs(mem_mib[i], cores[i], uname_s);
        if native != bash_jobs || native != expected[i] {
            _report_row(mem_mib[i], cores[i], uname_s, native, bash_jobs, expected[i]);
        }
        // Agreement is the contract; the pinned value is what keeps a
        // coordinated-but-wrong edit from moving both forms in step.
        assert native == bash_jobs;
        assert native == expected[i];
        i += 1;
    }
}

// The invariant that makes the twins' different arithmetic safe, and the one
// no sampled table can pin: the native budget's step points land on EXACT MiB
// boundaries, so the bash form's whole-MiB truncation loses nothing.
//
// The k-job threshold is `(6400 + 3840k)` MiB — both `5120 * 5/4` and
// `3072 * 5/4` are whole, which is only true while the reserves are whole MiB
// and the slice maps them onto whole MiB. Asserting the step happens between
// `T * 1 MiB - 1` and `T * 1 MiB` says exactly that: if a future constant put a
// threshold at a fractional MiB, the step would fall strictly inside a MiB,
// both probes would return the same value, and this test goes red — while the
// table above, which samples whole-MiB inputs, would stay green.
//
// Only `k >= 2` is observable. At `k = 1` the `by_mem < 1` floor returns 1 on
// both sides of the boundary, so the step is invisible; `cores = 64` keeps CPU
// from binding before the global cap of 16 does.
test "test-jobs budget: every job threshold lands on an exact MiB boundary (SFN-794)" {
    let k: int[] = [2, 3, 4, 5];
    let threshold_mib: int[] = [14080, 17920, 21760, 25600];
    let mut i: int = 0;
    loop {
        if i >= k.length { break; }
        let at = threshold_mib[i] * _mib();
        assert _test_jobs_budget(at, 64, false) == k[i];
        assert _test_jobs_budget(at - 1, 64, false) == k[i] - 1;
        i += 1;
    }
}

// The parent-reserve boundary is the one place the twins take structurally
// different branches — a native early `return 1` versus a bash `if/else` whose
// truncated `usable` keeps it on the `-le` side for one MiB longer. Sweeping
// it at 1-MiB stride pins the two shapes to the same answer instead of
// trusting the three sampled points in the table above.
test "test-jobs budget: the twins agree across the parent-reserve boundary (SFN-794)" ![io] {
    if !tool_present("bash") { skip("bash not on PATH"); }
    let mut mem: int = 6395;
    loop {
        if mem > 6405 { break; }
        let native = _test_jobs_budget(mem * _mib(), 8, false);
        let bash_jobs = _bash_jobs(mem, 8, "Linux");
        if native != bash_jobs || native != 1 {
            _report_row(mem, 8, "Linux", native, bash_jobs, 1);
        }
        assert native == bash_jobs;
        // The whole band floors to serial: 6400 MiB at 80% is exactly the
        // 5 GiB parent reserve, and nothing above it affords a job's 3 GiB
        // until 10240 MiB.
        assert native == 1;
        mem += 1;
    }
}

// The bash twin has one branch with no counterpart in `_test_jobs_budget`:
// MSYS/Cygwin/Git Bash force serial because `xargs -P` parallelism is
// unreliable under the Windows shell wrappers. The native side expresses that
// a level up, in `_resolve_auto_test_jobs`, which returns 1 for any host that
// is neither Linux nor Darwin without consulting the budget at all — so this
// row is asserted against the constant 1, not against the budget function.
test "test-jobs budget: the bash twin forces serial on Windows shells (SFN-794)" ![io] {
    if !tool_present("bash") { skip("bash not on PATH"); }
    assert _bash_jobs(65536, 16, "MINGW64_NT-10.0") == 1;
    assert _bash_jobs(65536, 16, "MSYS_NT-10.0") == 1;
    assert _bash_jobs(65536, 16, "CYGWIN_NT-10.0") == 1;
}

// The injection interface itself, which the table above only reaches through
// its three-argument form. The two-argument form exists so a caller comparing
// Linux budgets need not restate the platform; it is only correct if it is
// indistinguishable from naming `Linux` explicitly.
test "test-jobs budget: the script's argument forms and sanitize path (SFN-794)" ![io] {
    if !tool_present("bash") { skip("bash not on PATH"); }
    assert _bash_jobs_argv(["32768", "16"]) == _bash_jobs(32768, 16, "Linux");
    assert _bash_jobs_argv(["32768", "16"]) == 6;
    // A measurement the script cannot parse falls back to 1536 MB / 1 core.
    // 1536 MB is deliberately below the parent reserve, so an unmeasurable host
    // floors to serial exactly as `_test_jobs_budget`'s fail-closed branch does
    // on a non-positive byte count.
    assert _bash_jobs_argv(["not-a-number", "also-not"]) == 1;
    assert _test_jobs_budget(0, 1, false) == 1;
    // An argument count the interface does not define is a usage error, not a
    // silently probed host — a mistyped call must not look like a measurement.
    // `-1` is `_bash_jobs_argv`'s non-zero-exit sentinel.
    assert _bash_jobs_argv(["4096"]) == -1;
    assert _bash_jobs_argv(["4096", "8", "Linux", "extra"]) == -1;
}

// The injected forms above are only worth anything if the no-argument form —
// the only one the Makefile calls — still probes the real host. Comparing it
// against `_resolve_auto_test_jobs()` rather than a hardcoded range checks the
// probes too, which the injected table by construction cannot: the native probe
// reads `MemTotal` in kB and scales to bytes, while bash truncates the same
// figure to whole MiB. That is the one residual difference between the two
// implementations, and it can only surface on a host sitting within a MiB of a
// job threshold. If this assertion ever fails on a real runner it is that case,
// not a policy divergence — the fix is to make the bash probe keep the kB
// precision, not to loosen this test.
test "test-jobs budget: the no-argument form agrees with the native host probe (SFN-794)" ![io] {
    if !tool_present("bash") { skip("bash not on PATH"); }
    let exit = process.run_capture(["bash", "scripts/detect_test_jobs.sh"], _child_env());
    let out = process.capture_take_stdout();
    let _err = process.capture_take_stderr();
    assert exit == 0;
    let mut jobs: int = -1;
    match parse_int(trim(out)) {
        Result.Ok { value } => { jobs = value; },
        Result.Err { error } => { jobs = -1; }
    }
    let native = _resolve_auto_test_jobs();
    if jobs != native {
        print.info("test-jobs parity: no-arg script=" + int_to_string(jobs)
            + " native probe="
            + int_to_string(native));
    }
    assert jobs == native;
    // The runner's `--jobs` accepts [1, 256]; this budget's own cap is 16.
    assert jobs >= 1;
    assert jobs <= 16;
}
