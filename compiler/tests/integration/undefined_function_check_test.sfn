// compiler/tests/integration/undefined_function_check_test.sfn
//
// Regression corpus for the E0420 undefined-function policy (#813,
// closing the documentation/test half of #616). The enforcement flip
// landed in #812: a `Call` whose callee is a bare `Identifier` that
// resolves to neither an in-scope binding, an imported function, nor a
// builtin/runtime envelope name produces
// `error[E0420]: undefined function \`name\``.
//
// This test pins the *envelope* end-to-end by driving the shipped
// `sfn check` binary over a fixture (not by calling the typechecker
// internals), so the auto-injection allowlist can't silently drift
// without a red integration run. Two cases: a bare undefined callee
// must exit non-zero with the `E0420` string, and a locally-defined
// callee must check clean.
//
// Runs from the repo root (`make test-integration` invokes
// `build/bin/sfn test compiler/tests/integration`), so the
// `build/bin/sfn` binary resolves relative to that cwd. The
// child is launched with an *empty* environment on purpose: the binary
// is named by an explicit slashed path (so `posix_spawnp` never
// consults `PATH`), the runtime root is resolved exe-relative rather
// than via the environment, and `sfn check`'s only env knobs
// (`SAILFIN_EFFECT_ENFORCE` / `SAILFIN_USE_ARENA`) must stay unset so
// the test exercises the shipped defaults deterministically instead of
// inheriting an ambient shell setting.
import { remove_all } from "sfn/fs";

import { module_name_from_path } from "../../src/module_paths";

fn _contains(haystack: string, needle: string) -> boolean {
    if needle.length == 0 { return true; }
    if needle.length > haystack.length { return false; }
    let mut i: int = 0;
    let limit = haystack.length - needle.length;
    loop {
        if i > limit { break; }
        if substring(haystack, i, i + needle.length) == needle { return true; }
        i += 1;
    }
    return false;
}

// Mint a collision-free fixture. `fs.mkdtemp` returns a kernel-unique
// `0700` scratch dir (anchored under `$TMPDIR` / `/tmp`), so parallel
// `sfn test` invocations never share a fixture path. The fs surface
// has no `rmdir` primitive, so the caller deletes the fixture file and
// only the empty unique dir is left behind — strictly less residue
// than a fixed `/tmp/<name>` path.
fn _mint_fixture(name: string, source: string) -> string ![io] {
    let dir = fs.mkdtemp("sfn-e0420-");
    assert dir.length > 0;
    let path = dir + "/" + name;
    fs.writeFile(path, source);
    return path;
}

// Run `build/bin/sfn check <path>` capturing both streams, and
// return the combined stdout+stderr so a case can assert on diagnostic
// text regardless of which stream the renderer used.
fn _check_output(path: string) -> string ![io] {
    let _rc = process.run_capture(["build/bin/sfn", "check", path], []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    return out + err;
}

fn _check_exit(path: string) -> i64 ![io] {
    let rc = process.run_capture(["build/bin/sfn", "check", path], []);
    // Drain the stashed capture buffers so a later `_check_output` /
    // `capture_take_*` call doesn't hand back this run's streams.
    let _o = process.capture_take_stdout();
    let _e = process.capture_take_stderr();
    return rc;
}

fn _delete_if_exists(path: string) -> void ![io] {
    if fs.exists(path) { fs.deleteFile(path); }
}

fn _delete_staged_module(slug: string, source_path: string) -> void ![io] {
    let context_root = "build/compiler/import-context";
    let artifact_base = context_root + "/" + slug;
    _delete_if_exists(artifact_base + ".import-deps");
    _delete_if_exists(artifact_base + ".srchash");
    _delete_if_exists(artifact_base + ".layout-manifest");
    _delete_if_exists(artifact_base + ".sfn-asm");

    let path_slug = module_name_from_path(source_path);
    _delete_if_exists(context_root + "/" + path_slug + ".slugalias");
}

test "E0420: undefined free-function callee exits non-zero with the diagnostic" ![io] {
    let fixture = _mint_fixture("undef.sfn", "fn main() {\n    notarealfunction_813(\"hi\");\n}\n");

    let rc = _check_exit(fixture);
    assert rc != 0;

    let combined = _check_output(fixture);
    assert _contains(combined, "E0420");
    assert _contains(combined, "undefined function");
    assert _contains(combined, "notarealfunction_813");

    fs.deleteFile(fixture);
}

test "E0420: locally-defined callee checks clean (envelope negative case)" ![io] {
    let fixture = _mint_fixture("ok.sfn", "fn greet() {}\nfn main() {\n    greet();\n}\n");

    let rc = _check_exit(fixture);
    assert rc == 0;

    let combined = _check_output(fixture);
    assert ! _contains(combined, "E0420");

    fs.deleteFile(fixture);
}

test "SFN-544: workspace export missing from imports reports span and provider" ![io] {
    // Stage a provider with a collision-resistant logical name immediately
    // before checking its consumer. Depending on the ambient compiler entry
    // artifact made this assertion order-dependent: another test building a
    // temporary `main.sfn` can legitimately replace the shared `main` slot.
    let dir = fs.mkdtemp("sfn-544-provider-");
    assert dir.length > 0;
    let unique_suffix = substring(dir, dir.length - 6, dir.length);
    let provider_slug = "sfn544_workspace_export_provider_" + unique_suffix;
    fs.createDirectory(dir + "/src", true);
    let provider = dir + "/src/" + provider_slug + ".sfn";
    let support_slug = "sfn544_workspace_export_support_" + unique_suffix;
    let support = dir + "/src/" + support_slug + ".sfn";
    let consumer = dir + "/consumer.sfn";
    let manifest = dir + "/capsule.toml";
    let out_bin = dir + "/provider-bin";
    fs.writeFile(manifest, "[capsule]\nname = \"sfn544-provider-fixture\"\nversion = \"0.1.0\"\n\n"
        + "[build]\nentry = \"src/"
        + provider_slug
        + ".sfn\"\nkind = \"binary\"\n");
    fs.writeFile(provider, "fn compile_to_sailfin(source: string) -> string { return source; }\n"
        + "fn main() {}\n");
    // Binary capsule staging excludes the entry from the source walk and
    // publishes it alongside the remaining source set. Keep one sibling so
    // this fixture exercises that real entry-inventory path.
    fs.writeFile(support, "fn sfn544_support() -> int { return 1; }\n");
    fs.writeFile(consumer, "// SFN-544 regression fixture.\n\n"
        + "fn unresolved_identifier_repro() -> string { return compile_to_sailfin(\"x\"); }\n");

    let build_rc = process.run_capture(["build/bin/sfn", "build", "-p", dir, "-o", out_bin], process.environ());
    let build_log = process.capture_take_stdout() + process.capture_take_stderr();
    if build_rc != 0 { print.err(build_log); }
    assert build_rc == 0;

    let rc = _check_exit(consumer);
    assert rc != 0;

    let combined = _check_output(consumer);
    assert _contains(combined, "error[E0420]: undefined function `compile_to_sailfin`");
    assert _contains(combined, "3 | fn unresolved_identifier_repro() -> string { return compile_to_sailfin(\"x\"); }");
    assert _contains(combined, "^^^^^^^^^^^^^^^^^^");
    assert _contains(combined, "import { compile_to_sailfin }");
    assert _contains(combined, "from \"" + provider_slug + "\"");
    assert ! _contains(combined, "internal compiler error");
    assert ! _contains(combined, "ice.md");

    _delete_staged_module(provider_slug, provider);
    _delete_staged_module(support_slug, support);
    remove_all(dir);
}

test "check resolver: a broken configured entry does not fail a healthy file" ![io] {
    let dir = fs.mkdtemp("sfn-check-broken-entry-");
    assert dir.length > 0;
    let manifest = dir + "/capsule.toml";
    let broken = dir + "/broken.sfn";
    let healthy = dir + "/healthy.sfn";
    fs.writeFile(manifest, "[capsule]\nname = \"broken-entry-fixture\"\nversion = \"0.1.0\"\n\n"
        + "[build]\nentry = \"broken.sfn\"\nkind = \"binary\"\n");
    fs.writeFile(broken, "fn broken( {\n");
    fs.writeFile(healthy, "fn healthy() -> int { return 1; }\n");

    let rc = process.run_capture(["build/bin/sfn", "check", healthy], []);
    let combined = process.capture_take_stdout() + process.capture_take_stderr();
    assert rc == 0;
    assert ! _contains(combined, "failed to stage import-context");
    assert ! _contains(combined, "broken.sfn");

    fs.deleteFile(healthy);
    fs.deleteFile(broken);
    fs.deleteFile(manifest);
}

test "check resolver: a stale entry artifact is not provider inventory" ![io] {
    let dir = fs.mkdtemp("sfn-check-stale-entry-");
    assert dir.length > 0;
    let manifest_path = dir + "/capsule.toml";
    let entry = dir + "/entry.sfn";
    let consumer = dir + "/consumer.sfn";
    fs.writeFile(manifest_path, "[capsule]\nname = \"stale-entry-fixture\"\nversion = \"0.1.0\"\n\n"
        + "[build]\nentry = \"entry.sfn\"\nkind = \"binary\"\n");
    fs.writeFile(entry, "fn current_entry() -> int { return 1; }\n");
    fs.writeFile(consumer, "fn consumer() -> int { return stale_export(); }\n");

    let slug = module_name_from_path(entry);
    let context_root = "build/compiler/import-context";
    let artifact_dir = context_root + "/" + substring(slug, 0, slug.length - "entry".length);
    fs.createDirectory(artifact_dir, true);
    let artifact_base = context_root + "/" + slug;
    fs.writeFile(artifact_base + ".sfn-asm", "; stale fixture\n.module " + slug
        + "\n\n.fn stale_export() -> int\n.meta return int\n    ret 1\n.endfn\n");
    fs.writeFile(artifact_base + ".layout-manifest", "");
    fs.writeFile(artifact_base + ".srchash", "definitely-stale");

    let rc = process.run_capture(["build/bin/sfn", "check", consumer], []);
    let combined = process.capture_take_stdout() + process.capture_take_stderr();
    assert rc != 0;
    assert _contains(combined, "undefined function `stale_export`");
    assert ! _contains(combined, "import { stale_export }");

    fs.deleteFile(artifact_base + ".srchash");
    fs.deleteFile(artifact_base + ".layout-manifest");
    fs.deleteFile(artifact_base + ".sfn-asm");
    fs.deleteFile(consumer);
    fs.deleteFile(entry);
    fs.deleteFile(manifest_path);
}
