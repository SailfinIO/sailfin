// compiler/tests/integration/selfhost_diff_test.sfn
//
// Regression coverage for the I/O surface of `sfn selfhost`
// (issue #1502, epic #513 Phase 1): the `.ll`-dir snapshot loader
// (`_selfhost_collect_ll_files` + `_selfhost_snapshot`) feeding the
// reused determinism comparator, plus `handle_selfhost_command`'s
// early-return arg handling. The pure comparator is covered by
// `unit/build_report_determinism_test.sfn`; the pure string helpers by
// `unit/selfhost_helpers_test.sfn`. This test exercises the real
// filesystem enumeration + sha256 path on hand-built fixtures.
import { host_is_windows } from "../../src/build/target";
import { compare_for_determinism } from "../../src/build_report";
import {
    _selfhost_collect_ll_files,
    _selfhost_has_compiler_ir,
    _selfhost_promote_binary,
    _selfhost_remove_tree,
    _selfhost_snapshot,
    handle_selfhost_command
} from "../../src/cli_selfhost";

// Write `<caps_dir>/<name>` with `content`, creating `caps_dir`.
fn _write_ll(caps_dir: string, name: string, content: string) ![io] {
    process.run(["mkdir", "-p", caps_dir]);
    fs.writeFile(caps_dir + "/" + name, content);
}

// --------------------------------------------------------------
// _selfhost_collect_ll_files — enumeration
// --------------------------------------------------------------
test "selfhost_collect_ll_files: finds only .ll files" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-collect-");
    assert root.length > 0;
    let caps = root + "/capsules";
    _write_ll(caps, "mod_a.ll", "; a\n");
    _write_ll(caps, "mod_b.ll", "; b\n");
    // A non-.ll sibling must be ignored.
    fs.writeFile(caps + "/notes.txt", "ignore me");

    let files = _selfhost_collect_ll_files(caps);
    assert files.length == 2;
}

test "selfhost_collect_ll_files: missing dir yields empty list" ![io] {
    let files = _selfhost_collect_ll_files("/definitely/not/a/real/capsules/dir");
    assert files.length == 0;
}

test "selfhost compiler IR gate: empty tree is rejected" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-empty-compiler-ir-");
    assert ! _selfhost_has_compiler_ir(root);
    _write_ll(root + "/nested", "mod.ll", "; compiler module\n");
    assert _selfhost_has_compiler_ir(root);
}

// --------------------------------------------------------------
// _selfhost_snapshot + compare_for_determinism — fixed-point path
// --------------------------------------------------------------
test "selfhost_snapshot: identical .ll sets + same binary => fixed point" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-match-");
    let bin = root + "/fakebin";
    fs.writeFile(bin, "ELF-ish bytes");

    let s2 = root + "/s2/capsules";
    let s3 = root + "/s3/capsules";
    _write_ll(s2, "mod_a.ll", "; identical a\n");
    _write_ll(s2, "mod_b.ll", "; identical b\n");
    _write_ll(s3, "mod_a.ll", "; identical a\n");
    _write_ll(s3, "mod_b.ll", "; identical b\n");

    // Point both snapshots at the same binary so binary_sha256 agrees;
    // the `.ll` digests then carry the fixed-point decision. No runtime
    // dir fixture is written, so `_selfhost_collect_ll_files` returns
    // empty for it — the capsules-dir behavior is unaffected.
    let snap2 = _selfhost_snapshot(s2, root + "/s2/runtime", bin);
    let snap3 = _selfhost_snapshot(s3, root + "/s3/runtime", bin);
    let diff = compare_for_determinism(snap2, snap3);
    assert diff.matched;
    assert diff.binary_match;
    assert diff.module_diffs.length == 0;
}

test "selfhost_snapshot: nested duplicate basenames retain distinct slugs" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-nested-slugs-");
    let bin = root + "/fakebin";
    fs.writeFile(bin, "same binary");

    let s2 = root + "/s2/capsules";
    let s3 = root + "/s3/capsules";
    _write_ll(s2 + "/build", "mod.ll", "; build module\n");
    _write_ll(s2 + "/cli", "mod.ll", "; cli module\n");
    _write_ll(s3 + "/build", "mod.ll", "; build module\n");
    _write_ll(s3 + "/cli", "mod.ll", "; cli module\n");

    let snap2 = _selfhost_snapshot(s2, root + "/s2/runtime", bin);
    let snap3 = _selfhost_snapshot(s3, root + "/s3/runtime", bin);
    let diff = compare_for_determinism(snap2, snap3);
    assert snap2.modules.length == 2;
    assert diff.matched;
    assert diff.module_diffs.length == 0;
}

test "selfhost_snapshot: one differing .ll surfaces as a module diff" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-differ-");
    let bin = root + "/fakebin";
    fs.writeFile(bin, "same binary");

    let s2 = root + "/s2/capsules";
    let s3 = root + "/s3/capsules";
    _write_ll(s2, "mod_a.ll", "; a\n");
    _write_ll(s2, "mod_b.ll", "; b original\n");
    _write_ll(s3, "mod_a.ll", "; a\n");
    _write_ll(s3, "mod_b.ll", "; b PERTURBED\n");

    let diff = compare_for_determinism(_selfhost_snapshot(s2, root
        + "/s2/runtime", bin), _selfhost_snapshot(s3, root
        + "/s3/runtime", bin));
    assert ! diff.matched;
    assert diff.binary_match;
    assert diff.module_diffs.length == 1;
    assert diff.module_diffs[0].slug == "mod_b.ll";
    assert diff.module_diffs[0].kind == "differ";
}

test "selfhost_snapshot: module missing in stage3 surfaces as only_in_a" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-missing-");
    let bin = root + "/fakebin";
    fs.writeFile(bin, "same binary");

    let s2 = root + "/s2/capsules";
    let s3 = root + "/s3/capsules";
    _write_ll(s2, "mod_a.ll", "; a\n");
    _write_ll(s2, "mod_b.ll", "; b\n");
    _write_ll(s3, "mod_a.ll", "; a\n");

    let diff = compare_for_determinism(_selfhost_snapshot(s2, root
        + "/s2/runtime", bin), _selfhost_snapshot(s3, root
        + "/s3/runtime", bin));
    assert ! diff.matched;
    assert diff.module_diffs.length == 1;
    assert diff.module_diffs[0].slug == "mod_b.ll";
    assert diff.module_diffs[0].kind == "only_in_a";
}

// --------------------------------------------------------------
// _selfhost_snapshot — runtime/cache-dir `.ll` coverage (SFN-87 / #1726).
// Every case above passes a `<root>/sN/runtime` path that is never
// created, so `_selfhost_collect_ll_files` returns empty for it and the
// runtime-dir branch of `_selfhost_snapshot` (cli_selfhost.sfn:213-221) is
// never exercised. These cases actually populate that dir.
// --------------------------------------------------------------
test "selfhost_snapshot: runtime dir .ll contributes a module slugged cache/<basename>" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-runtime-slug-");
    let bin = root + "/fakebin";
    fs.writeFile(bin, "same binary");

    let caps = root + "/capsules";
    _write_ll(caps, "mod_a.ll", "; a\n");
    let runtime = root + "/runtime";
    _write_ll(runtime, "arena.ll", "; arena\n");

    let snap = _selfhost_snapshot(caps, runtime, bin);
    assert snap.modules.length == 2;
    let mut found = false;
    let mut i: int = 0;
    loop {
        if i >= snap.modules.length { break; }
        if snap.modules[i].slug == "cache/arena.ll" { found = true; }
        i += 1;
    }
    assert found;
}

test "selfhost_snapshot: runtime-only divergence surfaces as a named module diff" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-runtime-differ-");
    let bin = root + "/fakebin";
    fs.writeFile(bin, "same binary");

    let s2 = root + "/s2/capsules";
    let s3 = root + "/s3/capsules";
    _write_ll(s2, "mod_a.ll", "; a\n");
    _write_ll(s3, "mod_a.ll", "; a\n");

    let s2_runtime = root + "/s2/runtime";
    let s3_runtime = root + "/s3/runtime";
    _write_ll(s2_runtime, "arena.ll", "; arena original\n");
    _write_ll(s3_runtime, "arena.ll", "; arena PERTURBED\n");

    let diff = compare_for_determinism(_selfhost_snapshot(s2, s2_runtime, bin), _selfhost_snapshot(s3, s3_runtime, bin));
    assert ! diff.matched;
    assert diff.binary_match;
    assert diff.module_diffs.length == 1;
    assert diff.module_diffs[0].slug == "cache/arena.ll";
    assert diff.module_diffs[0].kind == "differ";
}

test "selfhost_snapshot: runtime module does not collide with a same-basename capsule module" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-runtime-collide-");
    let bin = root + "/fakebin";
    fs.writeFile(bin, "same binary");

    let caps = root + "/capsules";
    let runtime = root + "/runtime";
    // Same basename in both dirs: the capsule slug is bare ("arena.ll"),
    // the runtime slug is prefixed ("cache/arena.ll") — distinct entries.
    _write_ll(caps, "arena.ll", "; capsule arena\n");
    _write_ll(runtime, "arena.ll", "; runtime arena\n");

    let snap = _selfhost_snapshot(caps, runtime, bin);
    assert snap.modules.length == 2;
    let mut has_bare = false;
    let mut has_prefixed = false;
    let mut i: int = 0;
    loop {
        if i >= snap.modules.length { break; }
        if snap.modules[i].slug == "arena.ll" { has_bare = true; }
        if snap.modules[i].slug == "cache/arena.ll" { has_prefixed = true; }
        i += 1;
    }
    assert has_bare;
    assert has_prefixed;
}

// --------------------------------------------------------------
// handle_selfhost_command — early-return arg handling (no build)
// --------------------------------------------------------------
test "selfhost cmd: -h returns 0 without building" ![io] {
    assert handle_selfhost_command(["selfhost", "-h"], "") == 0;
}

test "selfhost cmd: unknown flag returns usage exit 2" ![io] {
    assert handle_selfhost_command(["selfhost", "--bogus"], "") == 2;
}

test "selfhost cmd: flag missing its value returns exit 2" ![io] {
    assert handle_selfhost_command(["selfhost", "--work-dir"], "") == 2;
}

test "selfhost cmd: missing first-pass binary returns exit 1" ![io] {
    assert handle_selfhost_command(["selfhost", "--first-pass", "/no/such/sailfin/binary"], "") == 1;
}

// --------------------------------------------------------------
// _selfhost_remove_tree — the shell-free `rm -rf` (SFN-489)
// --------------------------------------------------------------
test "selfhost_remove_tree: removes a nested tree including empty dirs" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-rmtree-");
    let caps = root + "/capsules";
    _write_ll(caps, "mod_a.ll", "; a\n");
    _write_ll(caps + "/nested/deeper", "mod_b.ll", "; b\n");
    // An empty directory is the case the unlink-probe must classify
    // correctly: `fs.listDirectory` reports it as having no entries, so a
    // heuristic keyed on emptiness would mistake it for a file.
    fs.createDirectory(caps + "/empty", true);
    assert fs.exists(caps + "/nested/deeper/mod_b.ll");

    assert _selfhost_remove_tree(caps);
    assert ! fs.exists(caps);
    // The parent must survive — the walk removes `root` and below, nothing above.
    assert fs.exists(root);
}

test "selfhost_remove_tree: a missing root is a no-op, not a failure" ![io] {
    assert _selfhost_remove_tree("/definitely/not/a/real/scratch/capsules");
}

// `rm -rf <file>` removes a plain file; the reverse pass alone would
// `rmdir` it and fail, so the unlink probe runs on the root too.
test "selfhost_remove_tree: removes a file root" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-rmfile-");
    let target = root + "/lonely.ll";
    fs.writeFile(target, "; content\n");
    assert _selfhost_remove_tree(target);
    assert ! fs.exists(target);
}

// SFN-681: `fs.exists` is `stat(2)` and follows symlinks, so a dangling link
// root reads as absent. Probing existence before the unlink therefore
// returned the absent-root `true` and left the link in place — a removal
// reported that did not happen. Unlinking first removes it and the report
// tells the truth.
test "selfhost_remove_tree: removes a dangling symlink root" ![io] {
    // `fs.symlink` requires Developer Mode or `SeCreateSymbolicLinkPrivilege`
    // on Windows (SFN-1143) and there is no seam here to grant either, so
    // the fixture this rests on cannot be built there.
    if host_is_windows() { return; }
    let root = fs.mkdtemp("sfn-selfhost-rmdangle-");
    let link = root + "/dangling";
    assert fs.symlink(root + "/definitely-not-here", link);
    // The predicate the old ordering trusted: the link is present on disk,
    // but `fs.exists` follows it to a missing target and reports absence.
    assert ! fs.exists(link);

    assert _selfhost_remove_tree(link);
    // `fs.exists` cannot witness the removal for the same reason, so re-create
    // the link and check that the second `fs.symlink` succeeds — `symlink(2)`
    // fails EEXIST while the old link is still there.
    assert fs.symlink(root + "/definitely-not-here", link);
    assert fs.deleteFile(link);
    assert fs.exists(root);
}

// A link root is unlinked, never followed: the live target outside the tree
// must survive. `unlink(2)` gives this for free; `rm -rf` needed the trailing
// slash omitted to get it.
test "selfhost_remove_tree: unlinks a live symlink root without touching its target" ![io] {
    if host_is_windows() { return; }
    let root = fs.mkdtemp("sfn-selfhost-rmlive-");
    let outside = fs.mkdtemp("sfn-selfhost-rmlive-target-");
    fs.writeFile(outside + "/keep.ll", "; keep\n");
    let link = root + "/link-to-outside";
    assert fs.symlink(outside, link);

    assert _selfhost_remove_tree(link);
    assert ! fs.exists(link);
    assert fs.exists(outside + "/keep.ll");
}

// --------------------------------------------------------------
// _selfhost_promote_binary — staged copy + mode carry + rename (SFN-489)
// --------------------------------------------------------------
// The regression the mode step exists for: `_copy_file` creates a missing
// destination via `fopen(…, "wb")`, whose 0666-and-umask default is not
// executable, where the displaced `cp -f` carried the source mode across.
// A non-executable promoted `sfn` fails everything downstream of it.
test "selfhost_promote_binary: a fresh destination is left executable" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-promote-");
    let src = root + "/stage-bin";
    fs.writeFile(src, "#!/bin/sh\necho hi\n");
    assert fs.set_perms(src, 493);
    assert fs.is_executable(src);

    let dst = root + "/bin/sfn";
    fs.createDirectory(root + "/bin", true);
    assert _selfhost_promote_binary(src, dst);
    assert fs.exists(dst);
    assert fs.is_executable(dst);
}

test "selfhost_promote_binary: overwrites an existing destination" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-promote-over-");
    let src = root + "/new-bin";
    let dst = root + "/old-bin";
    fs.writeFile(src, "new contents\n");
    assert fs.set_perms(src, 493);
    fs.writeFile(dst, "stale contents\n");

    assert _selfhost_promote_binary(src, dst);
    assert fs.readFile(dst) == "new contents\n";
    assert fs.is_executable(dst);
}

// The staged sibling must not survive a successful promotion — a leftover
// `.sfn_stage.*` beside `build/bin/sfn` would be collected by nothing.
test "selfhost_promote_binary: leaves no staging file behind" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-promote-clean-");
    let src = root + "/src-bin";
    fs.writeFile(src, "payload\n");
    assert _selfhost_promote_binary(src, root + "/dst-bin");
    // `src` and `dst` only — any third entry is staging residue.
    assert fs.listDirectory(root).length == 2;
}

test "selfhost_promote_binary: a missing source fails rather than truncating" ![io] {
    let root = fs.mkdtemp("sfn-selfhost-promote-missing-");
    let dst = root + "/dst-bin";
    fs.writeFile(dst, "must survive\n");
    assert ! _selfhost_promote_binary(root + "/no-such-source", dst);
    // The rename never ran, so the prior destination is intact.
    assert fs.readFile(dst) == "must survive\n";
}
