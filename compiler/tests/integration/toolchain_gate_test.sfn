// compiler/tests/integration/toolchain_gate_test.sfn
//
// SFN-167 / SFEP-0046 Phase 1: the `[toolchain]` pin gate on the
// project-build path. Drives `sfn check <dir>` over a crafted `capsule.toml`
// and asserts on the gate's behavior. `check` is frontend-only (no link, no
// `program.ll` build cache), so this is fast and pool-safe. Native (no-bash)
// per `.claude/rules/no-bash-e2e.md`: it spawns the compiler-under-test with
// the runtime `process.*` builtins and asserts on captured output with
// `sfn/strings::find` (the `![pure]` `expect_*` matchers can't be called from
// an `![io]` test).
import { find } from "sfn/strings";
import { default_scratch_dir, sfn_bin_abs_path, sfn_bin_path } from "sfn/test";

// `run_capture`'s empty array is the *empty* environment; thread the vars the
// nested `check` needs for a writable scratch under the parallel pool. No PATH
// needed — `check` never links.
fn _child_env() -> string[] ![io] {
    let mut e: string[] = [];
    let home = env.get("HOME");
    if home.length > 0 { e.push("HOME=" + home); }
    let tmpdir = env.get("TMPDIR");
    if tmpdir.length > 0 { e.push("TMPDIR=" + tmpdir); }
    let scratch = env.get("SAILFIN_TEST_SCRATCH");
    if scratch.length > 0 { e.push("SAILFIN_TEST_SCRATCH=" + scratch); }
    return e;
}

// Seed a unique project dir with a `capsule.toml` carrying `toolchain_body`
// (the `[toolchain]` stanza under test) plus a trivial, valid `src/main.sfn`.
// A per-`tag` path keeps concurrent children from colliding under the pool.
fn _make_project(tag: string, toolchain_body: string) -> string ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = default_scratch_dir(); }
    let dir = base + "/sfn-toolchain-gate-" + tag;
    fs.createDirectory(dir, true);
    fs.createDirectory(dir + "/src", true);
    let manifest = "[capsule]\nname = \"gatefix\"\nversion = \"0.1.0\"\n\n"
        + toolchain_body
        + "\n[build]\nentry = \"src/main.sfn\"\n";
    fs.writeFile(dir + "/capsule.toml", manifest);
    fs.writeFile(dir + "/src/main.sfn", "fn main() ![io] {\n    print(\"hi\");\n}\n");
    return dir;
}

// Seed a workspace root carrying `workspace_toolchain_body` (the root
// `[toolchain]` floor under test) plus one member capsule. `member_toolchain_body`
// is the member's own `[toolchain]` stanza (pass "" for a member that inherits
// the workspace floor). `sfn check <root>/member` drives `toolchain_decide`,
// which discovers the workspace root above the member (floor) and the member
// capsule.toml (per-field override). A per-`tag` path keeps concurrent children
// from colliding under the pool.
fn _make_workspace(tag: string, workspace_toolchain_body: string, member_toolchain_body: string) -> string ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = default_scratch_dir(); }
    let root = base + "/sfn-toolchain-ws-" + tag;
    let member = root + "/member";
    fs.createDirectory(member + "/src", true);
    let workspace = "[workspace]\nmembers = [\"member\"]\n\n"
        + workspace_toolchain_body;
    fs.writeFile(root + "/workspace.toml", workspace);
    let manifest = "[capsule]\nname = \"wsmember\"\nversion = \"0.1.0\"\n\n"
        + member_toolchain_body
        + "\n[build]\nentry = \"src/main.sfn\"\n";
    fs.writeFile(member + "/capsule.toml", manifest);
    fs.writeFile(member + "/src/main.sfn", "fn main() ![io] {\n    print(\"hi\");\n}\n");
    return member;
}

// SFEP-0073 §3.3 rank 3 (`toolchain_select_project_exact`) resolves the root
// from the CURRENT WORKING DIRECTORY, not the entry-hint argument — unlike
// the floor gate above, which discovers from the `check <src>` argument. Its
// `toolchain_print_version_error` diagnostic (SFN-1070, SFEP-0073 §3.2 rules
// 2/4) is only reachable on that cwd-resolved path, so every exact-`version`
// assertion below must run with `dir` as cwd via `sfn_bin_abs_path()` — a
// relative `sfn_bin_path()` would break once cwd shifts off the repo root.
fn _run_check_cwd(dir: string, extra_env: string[]) -> int ![io] {
    let mut e = _child_env();
    let mut i: int = 0;
    loop {
        if i >= extra_env.length { break; }
        e.push(extra_env[i]);
        i += 1;
    }
    return process.run_capture_cwd([sfn_bin_abs_path(), "check", "src/main.sfn"], e, dir);
}

test "workspace toolchain floor: an unsatisfiable workspace pin hard-errors" ![io] {
    // The member declares no `[toolchain]`, so it inherits the workspace-root
    // floor. `SAILFIN_TOOLCHAIN=local` selects the verify-only path (no fetch).
    // The mismatch attributes the pin to `workspace.toml`, proving the floor
    // flows from the workspace root rather than a member pin.
    let member = _make_workspace("hi-floor", "[toolchain]\nsfn = \"99.0.0\"\n", "");
    let mut e = _child_env();
    e.push("SAILFIN_TOOLCHAIN=local");
    let exit = process.run_capture([sfn_bin_path(), "check", member], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "toolchain mismatch", 0) >= 0;
    assert find(out + err, "workspace.toml [toolchain]", 0) >= 0;
}

test "workspace toolchain floor: a member capsule.toml overrides the workspace pin per field" ![io] {
    // Workspace pins an unsatisfiable `sfn`; the member overrides just `sfn`
    // with a satisfiable floor. Per-field override means the member value wins,
    // so the gate passes.
    let member = _make_workspace("member-override", "[toolchain]\nsfn = \"99.0.0\"\n", "[toolchain]\nsfn = \"0.0.1\"\n");
    let exit = process.run_capture([sfn_bin_path(), "check", member], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert find(out + err, "toolchain mismatch", 0) < 0;
}

test "workspace toolchain floor: channel = stable rejects a prerelease toolchain" ![io] {
    // Conditioned on the running toolchain, mirroring the capsule-level channel
    // case: a workspace `channel = "stable"` floor only rejects when the running
    // `sfn` is itself a prerelease. The member inherits the workspace channel.
    let _v = process.run_capture([sfn_bin_path(), "--version"], _child_env());
    let ver = process.capture_take_stdout() + process.capture_take_stderr();
    let is_prerelease = find(ver, "-alpha", 0) >= 0 || find(ver, "-beta", 0) >= 0
        || find(ver, "-rc", 0) >= 0;

    let member = _make_workspace("chan-floor", "[toolchain]\nchannel = \"stable\"\n", "");
    let exit = process.run_capture([sfn_bin_path(), "check", member], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    if is_prerelease {
        assert exit != 0;
        assert find(out + err, "toolchain mismatch", 0) >= 0;
        assert find(out + err, "workspace.toml [toolchain]", 0) >= 0;
    } else { assert find(out + err, "toolchain mismatch", 0) < 0; }
}

test "toolchain gate: an unsatisfiable version pin hard-errors" ![io] {
    // `SAILFIN_TOOLCHAIN=local` selects the verify-only path (SFN-172): the
    // gate prints the fail-closed mismatch and never fetches. The default
    // `auto` would instead try to fetch-and-dispatch the pinned version — that
    // dispatch path is covered by `e2e/toolchain_dispatch_test.sfn`.
    let dir = _make_project("hi-pin", "[toolchain]\nsfn = \"99.0.0\"\n");
    let mut e = _child_env();
    e.push("SAILFIN_TOOLCHAIN=local");
    let exit = process.run_capture([sfn_bin_path(), "check", dir], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "toolchain mismatch", 0) >= 0;
}

test "toolchain gate: --skip-toolchain-check downgrades the pin to a warning" ![io] {
    let dir = _make_project("skip", "[toolchain]\nsfn = \"99.0.0\"\n");
    let exit = process.run_capture([sfn_bin_path(), "check", "--skip-toolchain-check", dir], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    // The mismatch is downgraded and the command proceeds to a clean check.
    assert exit == 0;
    assert find(out + err, "error: toolchain mismatch", 0) < 0;
}

test "toolchain gate: SAILFIN_TOOLCHAIN=off downgrades the pin to a warning" ![io] {
    let dir = _make_project("env-off", "[toolchain]\nsfn = \"99.0.0\"\n");
    let mut e = _child_env();
    e.push("SAILFIN_TOOLCHAIN=off");
    let exit = process.run_capture([sfn_bin_path(), "check", dir], e);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert find(out + err, "error: toolchain mismatch", 0) < 0;
}

test "toolchain gate: a satisfiable version pin passes the gate" ![io] {
    let dir = _make_project("low-pin", "[toolchain]\nsfn = \"0.0.1\"\n");
    let exit = process.run_capture([sfn_bin_path(), "check", dir], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    // A satisfied pin passes the gate and the check itself succeeds.
    assert exit == 0;
    assert find(out + err, "toolchain mismatch", 0) < 0;
}

test "toolchain gate: channel = stable rejects a prerelease toolchain" ![io] {
    // Conditioned on the running toolchain: `channel = "stable"` only rejects
    // when the running `sfn` is itself a prerelease. This keeps the test valid
    // after the project ships a stable (no-prerelease) toolchain.
    let _v = process.run_capture([sfn_bin_path(), "--version"], _child_env());
    let ver = process.capture_take_stdout() + process.capture_take_stderr();
    let is_prerelease = find(ver, "-alpha", 0) >= 0 || find(ver, "-beta", 0) >= 0
        || find(ver, "-rc", 0) >= 0;

    let dir = _make_project("chan", "[toolchain]\nchannel = \"stable\"\n");
    let exit = process.run_capture([sfn_bin_path(), "check", dir], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    if is_prerelease {
        assert exit != 0;
        assert find(out + err, "toolchain mismatch", 0) >= 0;
    } else {
        // A stable running toolchain satisfies `channel = "stable"`.
        assert find(out + err, "toolchain mismatch", 0) < 0;
    }
}

// SFN-1070 / SFEP-0073 §3.2 rule 1: `sfn` retains its SFEP-0046 floor
// semantics unchanged, so a manifest with no `version` field must never grow
// the new exact-selection diagnostic.
test "toolchain gate: an unversioned manifest retains byte-compatible floor behavior" ![io] {
    let dir = _make_project("byte-compat", "[toolchain]\nsfn = \"0.0.1\"\n");
    let exit = process.run_capture([sfn_bin_path(), "check", dir], _child_env());
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit == 0;
    assert find(out + err, "toolchain mismatch", 0) < 0;
    assert find(out + err, "invalid [toolchain] version", 0) < 0;
}

// SFEP-0073 §3.2 rule 2: build metadata makes an exact `version` unusable —
// two signed artifacts must never collapse onto one exact store identity.
test "toolchain gate: a version with build metadata is rejected before fetch" ![io] {
    let dir = _make_project("ver-build-meta", "[toolchain]\nsfn = \"0.0.1\"\nversion = \"0.10.6+dev.abc123\"\n");
    let exit = _run_check_cwd(dir, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "is not an exact release version", 0) >= 0;
    // The failure is the manifest error itself, not a store/download error —
    // this diagnostic never reaches the fetch path at all.
    assert find(out + err, "install", 0) < 0;
}

// SFEP-0073 §3.2 rule 2: an incomplete semver is not a complete release
// version.
test "toolchain gate: an incomplete version is rejected before fetch" ![io] {
    let dir = _make_project("ver-incomplete", "[toolchain]\nsfn = \"0.0.1\"\nversion = \"0.10\"\n");
    let exit = _run_check_cwd(dir, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "is not an exact release version", 0) >= 0;
    assert find(out + err, "install", 0) < 0;
}

// SFEP-0073 §3.2 rule 2: a channel alias is a moving target and must never
// become a floating project field.
test "toolchain gate: a channel alias version is rejected before fetch" ![io] {
    let dir = _make_project("ver-alias", "[toolchain]\nsfn = \"0.0.1\"\nversion = \"stable\"\n");
    let exit = _run_check_cwd(dir, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "is not an exact release version", 0) >= 0;
    assert find(out + err, "install", 0) < 0;
}

// SFEP-0073 §3.2 rule 4: an exact version below the project's own `sfn`
// floor is invalid and must fail before any fetch.
test "toolchain gate: an exact version below the project's own sfn floor is rejected" ![io] {
    let dir = _make_project("ver-below-sfn", "[toolchain]\nsfn = \"9.9.9\"\nversion = \"1.0.0\"\n");
    let exit = _run_check_cwd(dir, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "does not satisfy the project's own requirement", 0) >= 0;
}

// SFEP-0073 §3.2 rule 4, the channel variant: an exact version below the
// project's own stability constraint is invalid the same way.
test "toolchain gate: an exact version below the project's own channel constraint is rejected" ![io] {
    let dir = _make_project("ver-below-channel", "[toolchain]\nchannel = \"stable\"\nversion = \"1.0.0-alpha.1\"\n");
    let exit = _run_check_cwd(dir, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "does not satisfy the project's own requirement", 0) >= 0;
}

// SFEP-0073 §3.2 rule 5: per-field workspace/member merge, provenance case 1
// — a workspace-supplied `version` with no member override attributes the
// diagnostic to `workspace.toml`.
test "toolchain gate: a workspace-only exact version error attributes workspace.toml" ![io] {
    let member = _make_workspace("ws-ver-source", "[toolchain]\nversion = \"stable\"\n", "");
    let exit = _run_check_cwd(member, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "workspace.toml sets version", 0) >= 0;
}

// Provenance case 2 — a member `capsule.toml version` overriding a workspace
// `version` attributes the diagnostic to `capsule.toml`, proving per-field
// override rather than workspace-wins.
test "toolchain gate: a member exact version override attributes capsule.toml" ![io] {
    let member = _make_workspace("member-ver-source", "[toolchain]\nversion = \"1.0.0\"\n", "[toolchain]\nversion = \"stable\"\n");
    let exit = _run_check_cwd(member, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "capsule.toml sets version", 0) >= 0;
}

// Provenance case 3 — the mixed merge: the workspace supplies `sfn`, the
// member supplies `version`. The two fields merge independently, so the
// error names the member as the version's source while still evaluating it
// against the workspace-supplied floor.
test "toolchain gate: workspace sfn plus member version merge validates against the merged floor" ![io] {
    let member = _make_workspace("mixed-merge", "[toolchain]\nsfn = \"9.9.9\"\n", "[toolchain]\nversion = \"1.0.0\"\n");
    let exit = _run_check_cwd(member, []);
    let out = process.capture_take_stdout();
    let err = process.capture_take_stderr();
    assert exit != 0;
    assert find(out + err, "invalid [toolchain] version", 0) >= 0;
    assert find(out + err, "does not satisfy the project's own requirement", 0) >= 0;
    assert find(out + err, "capsule.toml sets version", 0) >= 0;
}
