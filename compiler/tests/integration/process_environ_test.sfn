// Integration coverage for the environ-iteration primitive (#1242).
// `runtime/sfn/process.sfn:sfn_process_environ` walks the libc
// `environ` block (via `sailfin_runtime_get_environ`) and returns
// every `"KEY=VALUE"` entry as an `SfnArray<string>`;
// `compiler/capsules/codegen-llvm/src/runtime_helpers/registry_process.sfn` routes the
// `process.environ` target onto it. These tests pin the raw
// `process.*` builtin surface independently of the higher-level
// `sfn/os::env_from_current` wrapper exercised by
// `stdlib/os/tests/env_from_current_test.sfn`.
//
// The test harness always runs with a populated environment (PATH at
// minimum — the runner spawns children through it), so the
// non-empty / PATH assertions hold without the suite setting any
// dedicated variable.
import { process_fixture_bin } from "sfn/test";

// Index of the first '=' in `text`, or -1 when absent. Local copy of
// the split helper — the entry shape contract is "everything before
// the FIRST '=' is the key".
fn _index_of_eq(text: string) -> int {
    let mut i: int = 0;
    loop {
        if i >= text.length { break; }
        if strings_equal(grapheme_at(text, i), "=") { return i; }
        i += 1;
    }
    return -1;
}

// Windows environment names are case-insensitive even though
// `GetEnvironmentStringsA` preserves whichever spelling entered the block.
// POSIX remains exact. `NUL` keeps the Windows answer available even when a
// caller deliberately supplied an empty environment.
fn _host_env_keys_case_insensitive() -> boolean ![io] {
    if fs.exists("/proc/self/status") { return false; }
    if fs.exists("/System/Library/CoreServices") { return false; }
    if env.get("SystemRoot").length > 0 { return true; }
    if env.get("windir").length > 0 { return true; }
    if env.get("ComSpec").length > 0 { return true; }
    return fs.exists("NUL");
}

fn _env_key_equal(left: string, right: string, case_insensitive: boolean) -> boolean {
    if !case_insensitive { return strings_equal(left, right); }
    if left.length != right.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= left.length { break; }
        let mut lc: int = char_code(left[i]);
        let mut rc: int = char_code(right[i]);
        if lc >= 65 && lc <= 90 { lc += 32; }
        if rc >= 65 && rc <= 90 { rc += 32; }
        if lc != rc { return false; }
        i += 1;
    }
    return true;
}

test "process.environ: returns a non-empty list of KEY=VALUE entries" ![io] {
    let entries = process.environ();
    assert entries.length > 0;
    let mut i = 0;
    loop {
        if i >= entries.length { break; }
        let entry = entries[i];
        // Every entry is `KEY=VALUE`-shaped: it contains an '=' with a
        // non-empty key in front of it.
        assert _index_of_eq(entry) > 0;
        i += 1;
    }
}

test "process.environ: includes PATH with the value env.get reports" ![io] {
    // Cross-check the iteration surface against the per-variable read:
    // the PATH entry's value half must match `env.get("PATH")` exactly.
    // Windows may enumerate it as `Path`, matching that host's
    // case-insensitive lookup contract; POSIX still requires exact `PATH`.
    let expected = env.get("PATH");
    assert expected.length > 0;
    let case_insensitive = _host_env_keys_case_insensitive();
    if case_insensitive { assert env.get("Path") == expected; }
    let entries = process.environ();
    let mut found = false;
    let mut i = 0;
    loop {
        if i >= entries.length { break; }
        let entry = entries[i];
        let eq = _index_of_eq(entry);
        if eq > 0 {
            if _env_key_equal(substring(entry, 0, eq), "PATH", case_insensitive) {
                assert strings_equal(substring(entry, eq + 1, entry.length), expected);
                found = true;
            }
        }
        i += 1;
    }
    assert found;
}

test "process.environ: snapshot propagates a parent variable to a spawned child" ![io] {
    // End-to-end inheritance shape: a child spawned with the full
    // environ snapshot sees a variable the parent placed in it — the
    // exact pattern the post-pin `_pool_env_snapshot` migration (scoped
    // out of #1242) will rely on.
    //
    // A synthetic variable tests the environment block without depending on
    // host utilities or their platform-specific output conventions.
    let probe = "SFN_ENVIRON_PROBE";
    let expected = "propagated-snapshot-value";
    let mut snapshot = process.environ();
    snapshot.push(probe + "=" + expected);
    let argv = [process_fixture_bin(), "env", probe];
    let id = process.spawn_with_env(argv, snapshot);
    assert id != 0;
    process.handle_close_stdin(id);
    let out = process.handle_read_stdout(id);
    assert out == expected;
    let exit = process.handle_wait(id);
    assert exit == 0;
}
