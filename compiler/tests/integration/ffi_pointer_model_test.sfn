// SFN-1296: run the shipped raw-pointer operations through native lowering.
import {
    clean_runner_env,
    expect_contains_str,
    expect_eq_bool,
    nested_runner_scratch,
    sfn_bin_path
} from "sfn/test";

fn _fixture_source() -> string {
    return "extern fn malloc(size: usize) -> *u8;\n"
        + "extern fn free(ptr: *u8) -> void;\n"
        + "struct Cell { value: i32; }\n"
        + "fn main() -> i32 ![io] {\n"
        + "    let raw: *u8 = malloc(64 as usize);\n"
        + "    let p32: *i32 = raw as *i32;\n"
        + "    *p32 = 31;\n"
        + "    if *p32 != 31 { return 1; }\n"
        + "    let next32: *i32 = p32 + 1;\n"
        + "    if (next32 as i64) - (p32 as i64) != 4 { return 2; }\n"
        + "    if ((next32 - 1) as i64) != (p32 as i64) { return 3; }\n"
        + "    let p64: *i64 = raw as *i64;\n"
        + "    if (((p64 + 1) as i64) - (p64 as i64)) != 8 { return 4; }\n"
        + "    if (((p64 + 1 - 1) as i64) != (p64 as i64)) { return 5; }\n"
        + "    if (((raw + 1) as i64) - (raw as i64)) != 1 { return 6; }\n"
        + "    if (((raw + 1 - 1) as i64) != (raw as i64)) { return 7; }\n"
        + "    let cell: *Cell = raw as *Cell;\n"
        + "    cell.value = 41;\n"
        + "    if cell.value != 41 { return 8; }\n"
        + "    let owned = Cell { value: 5 };\n"
        + "    let owned_ptr: *Cell = owned as *Cell;\n"
        + "    if owned_ptr.value != 5 { return 9; }\n"
        + "    let zero: *i32 = 0 as *i32;\n"
        + "    if zero != null { return 10; }\n"
        + "    if null == raw { return 11; }\n"
        + "    free(raw);\n"
        + "    print(\"pointer model ok\");\n"
        + "    return 0;\n"
        + "}\n";
}

test "ffi pointer model: stores, scaling, casts, and null run correctly" ![io] {
    let scratch = nested_runner_scratch("sfn1296-pointer-model");
    fs.createDirectory(scratch, true);
    let source = scratch + "/pointer_model.sfn";
    let binary = scratch + "/pointer_model";
    fs.writeFile(source, _fixture_source());
    let child_env = clean_runner_env(scratch);
    let build_exit = process.run_capture([sfn_bin_path(), "build", "-o", binary, source], child_env);
    let build_output = process.capture_take_stdout() + process.capture_take_stderr();
    if build_exit != 0 { print.err(build_output); }
    assert expect_eq_bool(build_exit == 0, true).ok;
    let run_exit = process.run_capture([binary], child_env);
    let run_output = process.capture_take_stdout() + process.capture_take_stderr();
    if run_exit != 0 { print.err(run_output); }
    assert expect_eq_bool(run_exit == 0, true).ok;
    assert expect_contains_str(run_output, "pointer model ok").ok;
}

test "ffi pointer model: imported const pointer fields reject stores" ![io] {
    let scratch = nested_runner_scratch("sfn1296-imported-const-field");
    fs.createDirectory(scratch, true);
    let definitions = scratch + "/defs.sfn";
    let consumer = scratch + "/consumer.sfn";
    fs.writeFile(definitions, "struct Cell { value: i32; }\n"
        + "struct Holder { ptr: *const Cell; }\n"
        + "export { Cell, Holder };\n");
    fs.writeFile(consumer, "import { Cell, Holder } from \"./defs\";\n"
        + "fn write(h: *Holder) { h.ptr.value = 2; }\n"
        + "fn main() -> i32 { return 0; }\n");
    let child_env = clean_runner_env(scratch);
    let exit_code = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(exit_code != 0, true).ok;
    assert expect_contains_str(output, "E0852").ok;
}

test "ffi pointer model: imported struct field uses the selected provider" ![io] {
    let scratch = nested_runner_scratch("sfn1296-struct-provider");
    fs.createDirectory(scratch, true);
    let first = scratch + "/a.sfn";
    let second = scratch + "/b.sfn";
    let consumer = scratch + "/consumer.sfn";
    fs.writeFile(first, "struct Holder { ptr: *i32; }\n"
        + "fn other() -> i32 { return 1; }\nexport { other };\n");
    fs.writeFile(second, "struct Holder { ptr: *const i32; }\nexport { Holder };\n");
    fs.writeFile(consumer, "import { other } from \"./a\";\n"
        + "import { Holder } from \"./b\";\n"
        + "fn write(h: Holder) { *h.ptr = 7; }\n"
        + "fn main() -> i32 { return other(); }\n");
    let child_env = clean_runner_env(scratch);
    let exit_code = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(exit_code != 0, true).ok;
    assert expect_contains_str(output, "E0852").ok;
}

