test "ffi pointer model: imported generic returns retain argument qualifiers" ![io] {
    let scratch = nested_runner_scratch("sfn1296-generic-imported-return");
    fs.createDirectory(scratch, true);
    let definitions = scratch + "/defs.sfn";
    let consumer = scratch + "/consumer.sfn";
    fs.writeFile(definitions, "type T = *i32;\n"
        + "fn identity<T>(value: T) -> T { return value; }\n"
        + "struct Box<U> { value: U; }\n"
        + "fn unbox<U>(box: Box<U>) -> U { return box.value; }\n"
        + "struct Holder { fn echo<T>(self: Holder, value: T) -> T { return value; } }\n"
        + "export { identity, unbox, Box, Holder };\n");
    fs.writeFile(consumer, "import { identity, unbox, Box, Holder } from \"./defs\";\n"
        + "fn write(h: Holder, b: Box<*const i32>, p: *const i32) { *identity(p) = 7; *h.echo(p) = 8; *unbox(b) = 9; }\n"
        + "fn main() -> i32 { return 0; }\n");
    let child_env = clean_runner_env(scratch);
    let exit_code = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(exit_code != 0, true).ok;
    assert expect_contains_str(output, "checked 1 files: 3 errors").ok;
    assert expect_contains_str(output, "E0852").ok;
}

test "ffi pointer model: imported method private aliases preserve qualifiers" ![io] {
    let scratch = nested_runner_scratch("sfn1296-private-method-alias");
    fs.createDirectory(scratch, true);
    let definitions = scratch + "/defs.sfn";
    let consumer = scratch + "/consumer.sfn";
    fs.writeFile(definitions, "type ReadOnly = *const i32;\n"
        + "type Writable = *i32;\n"
        + "struct Holder { ptr: ReadOnly;\n"
        + "    fn get(self: Holder) -> ReadOnly { return self.ptr; }\n"
        + "    fn put(self: Holder, q: Writable) { *q = 7; }\n"
        + "}\n"
        + "export { Holder };\n");
    fs.writeFile(consumer, "import { Holder } from \"./defs\";\n"
        + "fn write(h: Holder) { *h.get() = 7; }\n"
        + "fn main() -> i32 { return 0; }\n");
    let child_env = clean_runner_env(scratch);
    let exit_code = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(exit_code != 0, true).ok;
    assert expect_contains_str(output, "E0852").ok;
    let put_consumer = scratch + "/consumer_put.sfn";
    fs.writeFile(put_consumer, "import { Holder } from \"./defs\";\n"
        + "fn write(h: Holder, p: *const i32) { h.put(p); }\n"
        + "fn main() -> i32 { return 0; }\n");
    let put_exit = process.run_capture([sfn_bin_path(), "check", put_consumer], child_env);
    let put_output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(put_exit != 0, true).ok;
    assert expect_contains_str(put_output, "E0852").ok;
}

test "ffi pointer model: conflicting closure aliases do not guess constness" ![io] {
    let scratch = nested_runner_scratch("sfn1296-alias-collision");
    fs.createDirectory(scratch, true);
    let first = scratch + "/a.sfn";
    let second = scratch + "/b.sfn";
    let consumer = scratch + "/consumer.sfn";
    fs.writeFile(first, "type Ptr = *const i32;\n"
        + "fn other() -> i32 { return 1; }\n"
        + "export { other };\n");
    fs.writeFile(second, "type Ptr = *i32;\n" + "export { Ptr };\n");
    fs.writeFile(consumer, "import { other } from \"./a\";\n"
        + "import { Ptr } from \"./b\";\n"
        + "fn write(p: Ptr) { *p = 7; }\n"
        + "fn main() -> i32 { return other(); }\n");
    let child_env = clean_runner_env(scratch);
    let exit_code = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(exit_code == 0, true).ok;
    assert expect_eq_bool(expect_contains_str(output, "E0852").ok, false).ok;
}

