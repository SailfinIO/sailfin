}

test "ffi pointer model: imported function return retains private struct shape" ![io] {
    let scratch = nested_runner_scratch("sfn1296-return-private-struct");
    fs.createDirectory(scratch, true);
    let definitions = scratch + "/defs.sfn";
    let consumer = scratch + "/consumer.sfn";
    fs.writeFile(definitions, "struct Holder { ptr: *const i32; }\n"
        + "fn get() -> Holder { return Holder { ptr: 0 as *const i32 }; }\n"
        + "export { Holder, get };\n");
    fs.writeFile(consumer, "import { get } from \"./defs\";\n"
        + "fn write() { *get().ptr = 7; }\n"
        + "fn main() -> i32 { return 0; }\n");
    let child_env = clean_runner_env(scratch);
    let exit_code = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(exit_code != 0, true).ok;
    assert expect_contains_str(output, "E0852").ok;
    fs.writeFile(consumer, "import { Holder as ReadHolder, get } from \"./defs\";\n"
        + "fn write() { *get().ptr = 7; }\n"
        + "fn main() -> i32 { return 0; }\n");
    let renamed_exit = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let renamed_output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(renamed_exit != 0, true).ok;
    assert expect_contains_str(renamed_output, "E0852").ok;
    fs.writeFile(consumer, "import { get } from \"./defs\";\n"
        + "fn write() { let h = get(); *h.ptr = 7; }\n"
        + "fn main() -> i32 { return 0; }\n");
    let inferred_exit = process.run_capture([sfn_bin_path(), "check", consumer], child_env);
    let inferred_output = process.capture_take_stdout() + process.capture_take_stderr();
    assert expect_eq_bool(inferred_exit != 0, true).ok;
    assert expect_contains_str(inferred_output, "E0852").ok;
}

