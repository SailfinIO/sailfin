// Stage D PR1 regression tests for
// `compiler/src/runtime_capsule_resolver.sfn`.
//
// `enumerate_runtime_capsule_artifacts` is the surface every
// downstream consumer (link phase, cache key digester, future
// cross-target resolver) reads from to find `kind = "runtime"`
// capsules in the workspace and surface their declarative C /
// LL / include / link-libs metadata. These tests construct
// real workspace.toml + capsule.toml files in a scratch dir
// (under build/sailfin/.runtime-resolver-test/) and assert the
// resolver returns the right shape.
//
// Pure-resolver unit testing — no compile, no link. Stage D PR2
// is when the e2e shape gets exercised through `sfn build`.
import {
    RuntimeCapsuleArtifacts,
    _rcr_normalize_path,
    _rcr_path_join,
    _rcr_resolve_path,
    empty_runtime_capsule_artifacts,
    enumerate_runtime_capsule_artifacts
} from "../../src/runtime_capsule_resolver";

// --------------------------------------------------------------
// empty_runtime_capsule_artifacts defaults
// --------------------------------------------------------------
test "empty_runtime_capsule_artifacts: every list is empty" {
    let a = empty_runtime_capsule_artifacts();
    assert a.capsule_name == "";
    assert a.manifest_dir == "";
    assert a.c_sources.length == 0;
    assert a.ll_sources.length == 0;
    assert a.sfn_sources.length == 0;
    assert a.include_dirs.length == 0;
    assert a.link_libs.length == 0;
    assert a.prelude_entry == "";
}

// --------------------------------------------------------------
// enumerate_runtime_capsule_artifacts: scratch workspace
// --------------------------------------------------------------
// Build a minimal scratch workspace under build/sailfin/<scratch>/
// so each test gets a deterministic on-disk layout the resolver
// can walk. The repo's actual workspace.toml + runtime/native/
// would also work, but we want hermetic asserts on the exact
// path resolution rules — not "happens to match what's in main."
import { remove_all } from "sfn/fs";

fn _setup_scratch_workspace(scratch: string) ![io] {
    remove_all(scratch);
    fs.createDirectory(scratch + "/runtime/native/src", true);
    fs.createDirectory(scratch + "/runtime/native/include", true);
    fs.createDirectory(scratch + "/runtime/native/ir", true);
    fs.createDirectory(scratch + "/capsules/sfn/library-cap", true);

    fs.writeFile(scratch + "/workspace.toml", "[workspace]\nmembers = [\"runtime/native\", \"capsules/sfn/library-cap\"]\n");

    let runtime_manifest = "[capsule]\n" + "name = \"sfn/runtime-native\"\n"
        + "version = \"0.1.0\"\n"
        + "\n"
        + "[capabilities]\n"
        + "required = []\n"
        + "\n"
        + "[build]\n"
        + "kind = \"runtime\"\n"
        + "sfn-source-root = \"../sfn\"\n"
        + "sfn-module-prefix = \"runtime/sfn\"\n"
        + "c-sources = [\"src/sailfin_arena.c\", \"src/sailfin_runtime.c\"]\n"
        + "ll-sources = [\"ir/runtime_globals.ll\"]\n"
        + "sfn-sources = [\"../sfn/io.sfn\", \"../sfn/clock.sfn\"]\n"
        + "include-dirs = [\"include\"]\n"
        + "link-libs = [\"-lm\", \"-lpthread\"]\n"
        + "prelude-entry = \"../prelude.sfn\"\n"
        + "\n"
        + "[targets.x86_64-w64-mingw32]\n"
        + "sfn-sources-replace = [\"../sfn/io.sfn=../sfn/platform/io_windows.sfn\"]\n"
        + "sfn-sources-add = [\"../sfn/platform/clock_windows.sfn\"]\n"
        + "sfn-sources-drop = [\"../sfn/clock.sfn\"]\n"
        + "ll-sources-add = [\"ir/target.ll\"]\n"
        + "link-libs-drop = [\"-lpthread\"]\n"
        + "link-libs-add = [\"-lws2_32\"]\n";
    fs.writeFile(scratch + "/runtime/native/capsule.toml", runtime_manifest);

    // A `kind = "library"` capsule alongside the runtime capsule —
    // the resolver must NOT include this in its results because
    // its kind isn't "runtime".
    let library_manifest = "[capsule]\n" + "name = \"sfn/library-cap\"\n"
        + "version = \"0.1.0\"\n"
        + "\n"
        + "[build]\n"
        + "kind = \"library\"\n"
        + "entry = \"src/mod.sfn\"\n";
    fs.writeFile(scratch + "/capsules/sfn/library-cap/capsule.toml", library_manifest);
}

test "enumerate: returns runtime capsule from workspace" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-1";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    assert result.length == 1;
    assert result[0].capsule_name == "sfn/runtime-native";
    remove_all(scratch);
}

test "enumerate: skips kind != runtime members" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-2";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    // The library-cap member exists in workspace.toml but has
    // kind="library"; it MUST be filtered out.
    let mut i: int = 0;
    loop {
        if i >= result.length { break; }
        assert result[i].capsule_name != "sfn/library-cap";
        i += 1;
    }
    remove_all(scratch);
}

test "enumerate: c_sources resolved to workspace-rooted paths" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-3";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    assert result.length == 1;
    let a = result[0];
    assert a.c_sources.length == 2;
    // Path is relative-to-manifest-dir resolved against
    // workspace_root + member_path. Manifest declared
    // `c-sources = ["src/sailfin_arena.c", ...]`; manifest dir
    // is `runtime/native/`; so the resolved path is
    // `<scratch>/runtime/native/src/sailfin_arena.c`.
    assert a.c_sources[0] == scratch + "/runtime/native/src/sailfin_arena.c";
    assert a.c_sources[1] == scratch + "/runtime/native/src/sailfin_runtime.c";
    remove_all(scratch);
}

test "enumerate: sfn_sources resolved relative to manifest dir" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-sfn-sources";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    assert result.length == 1;
    let a = result[0];
    // The fixture declares two `sfn-sources` whose paths are
    // relative to the manifest dir (`runtime/native/`). Per the
    // `_rcr_resolve_path` rule, `../sfn/io.sfn` joins against
    // `runtime/native/` and the result is normalized to collapse
    // the `..` segment — `runtime/sfn/io.sfn` lands canonical so
    // downstream `sfn emit` invocations don't trip the import
    // resolver on unnormalized paths (see `_rcr_normalize_path`
    // for the rationale).
    assert a.sfn_source_root == scratch + "/runtime/sfn";
    assert a.sfn_module_prefix == "runtime/sfn";
    assert a.sfn_sources.length == 2;
    assert a.sfn_sources[0] == scratch + "/runtime/sfn/io.sfn";
    assert a.sfn_sources[1] == scratch + "/runtime/sfn/clock.sfn";
    remove_all(scratch);
}

test "enumerate: rejects sfn source outside declared source root" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-source-escape";
    _setup_scratch_workspace(scratch);
    fs.writeFile(scratch + "/runtime/native/capsule.toml", "[capsule]\nname = \"sfn/runtime-native\"\nversion = \"0.1.0\"\n\n"
        + "[build]\nkind = \"runtime\"\n"
        + "sfn-source-root = \"../sfn\"\n"
        + "sfn-module-prefix = \"runtime/sfn\"\n"
        + "sfn-sources = [\"../../escape.sfn\"]\n");
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: rejects runtime module prefix with dot segments" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-prefix-escape";
    _setup_scratch_workspace(scratch);
    fs.writeFile(scratch + "/runtime/native/capsule.toml", "[capsule]\nname = \"sfn/runtime-native\"\nversion = \"0.1.0\"\n\n"
        + "[build]\nkind = \"runtime\"\n"
        + "sfn-source-root = \"../sfn\"\n"
        + "sfn-module-prefix = \"runtime/../escape\"\n"
        + "sfn-sources = [\"../sfn/io.sfn\"]\n");
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: rejects gated source outside declared source root" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-gate-escape";
    _setup_scratch_workspace(scratch);
    let manifest_path = scratch + "/runtime/native/capsule.toml";
    let manifest = fs.readFile(manifest_path)
        + "\n[sfn-source-gates]\nnet = [\"../../escape.sfn\"]\n";
    fs.writeFile(manifest_path, manifest);
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: ll_sources resolved with same join rule as c_sources" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-4";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    assert result.length == 1;
    let a = result[0];
    assert a.ll_sources.length == 1;
    assert a.ll_sources[0] == scratch + "/runtime/native/ir/runtime_globals.ll";
    remove_all(scratch);
}

test "enumerate: include_dirs resolved to manifest-relative dirs" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-5";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    assert result.length == 1;
    assert result[0].include_dirs.length == 1;
    assert result[0].include_dirs[0] == scratch + "/runtime/native/include";
    remove_all(scratch);
}

test "enumerate: link_libs flow through verbatim (not path-resolved)" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-6";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    assert result.length == 1;
    assert result[0].link_libs.length == 2;
    // `-lm` and `-lpthread` are linker flags, not paths — they
    // must NOT be prepended with the manifest dir.
    assert result[0].link_libs[0] == "-lm";
    assert result[0].link_libs[1] == "-lpthread";
    remove_all(scratch);
}

test "enumerate: target runtime tables are resolved once at the manifest boundary" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-targets";
    _setup_scratch_workspace(scratch);
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 1;
    assert result[0].target_artifacts.length == 1;
    let target = result[0].target_artifacts[0];
    assert target.triple == "x86_64-w64-mingw32";
    assert target.sfn_source_replacements[0] == scratch
        + "/runtime/sfn/io.sfn\t"
        + scratch
        + "/runtime/sfn/platform/io_windows.sfn";
    assert target.sfn_sources_add[0] == scratch
        + "/runtime/sfn/platform/clock_windows.sfn";
    assert target.sfn_sources_drop[0] == scratch + "/runtime/sfn/clock.sfn";
    assert target.ll_sources_add[0] == scratch + "/runtime/native/ir/target.ll";
    assert target.link_libs_drop[0] == "-lpthread";
    assert target.link_libs_add[0] == "-lws2_32";
    remove_all(scratch);
}

test "enumerate: malformed target replacement fails closed" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-target-malformed";
    _setup_scratch_workspace(scratch);
    let path = scratch + "/runtime/native/capsule.toml";
    let manifest = fs.readFile(path);
    fs.writeFile(path, manifest
        + "\n[targets.bad-target]\nsfn-sources-replace = [\"missing-equals\"]\n");
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: duplicate target replacement sources fail closed" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-target-duplicate-from";
    _setup_scratch_workspace(scratch);
    let path = scratch + "/runtime/native/capsule.toml";
    let manifest = fs.readFile(path);
    fs.writeFile(path, manifest
        + "\n[targets.duplicate-from]\nsfn-sources-replace = ["
        + "\"../sfn/io.sfn=../sfn/platform/io_windows.sfn\", "
        + "\"../sfn/io.sfn=../sfn/platform/clock_windows.sfn\"]\n");
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: target IR additions cannot escape the runtime capsule" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-target-ir-owner";
    _setup_scratch_workspace(scratch);
    let path = scratch + "/runtime/native/capsule.toml";
    let manifest = fs.readFile(path);
    fs.writeFile(path, manifest
        + "\n[targets.bad-ir-target]\nll-sources-add = [\"../../outside.ll\"]\n");
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: replacement source must exist in the base runtime set" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-target-from";
    _setup_scratch_workspace(scratch);
    let path = scratch + "/runtime/native/capsule.toml";
    let manifest = fs.readFile(path);
    fs.writeFile(path, manifest
        + "\n[targets.bad-target]\nsfn-sources-replace = [\"../sfn/missing.sfn=../sfn/platform/io_windows.sfn\"]\n");
    let result = enumerate_runtime_capsule_artifacts(scratch, []);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: prelude_entry resolved relative to manifest dir" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-7";
    _setup_scratch_workspace(scratch);
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts(scratch, empty);
    assert result.length == 1;
    // `prelude-entry = "../prelude.sfn"` from
    // `<scratch>/runtime/native/capsule.toml` resolves to
    // `<scratch>/runtime/prelude.sfn` after `_rcr_normalize_path`
    // collapses the `..` segment. Canonical paths matter for
    // any downstream consumer that feeds the path back into the
    // compiler's import resolver.
    assert result[0].prelude_entry == scratch + "/runtime/prelude.sfn";
    remove_all(scratch);
}

test "enumerate: dep_specs filter narrows the result set" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-8";
    _setup_scratch_workspace(scratch);
    // Only ask for sfn/runtime-native — the library capsule was
    // already filtered out by kind, but this test locks the
    // dep_specs path even when multiple runtime capsules
    // hypothetically exist.
    let specs = ["sfn/runtime-native"];
    let result = enumerate_runtime_capsule_artifacts(scratch, specs);
    assert result.length == 1;
    assert result[0].capsule_name == "sfn/runtime-native";
    remove_all(scratch);
}

test "enumerate: dep_specs with unknown name returns empty" ![io] {
    let scratch = "build/sailfin/.runtime-resolver-test-9";
    _setup_scratch_workspace(scratch);
    let specs = ["sfn/does-not-exist"];
    let result = enumerate_runtime_capsule_artifacts(scratch, specs);
    assert result.length == 0;
    remove_all(scratch);
}

test "enumerate: missing workspace.toml returns empty" ![io] {
    // No setup — pass a non-existent workspace root.
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts("/tmp/sfn-no-such-workspace-xyz", empty);
    assert result.length == 0;
}

test "enumerate: empty workspace_root returns empty" ![io] {
    let empty: string[] = [];
    let result = enumerate_runtime_capsule_artifacts("", empty);
    assert result.length == 0;
}

// --------------------------------------------------------------
// _rcr_normalize_path — SFN-642 root and separator handling
// --------------------------------------------------------------
// Pure string logic: no filesystem, no Windows host, no target
// conditioning. The Windows expectations below are not invented —
// each was read off Win32 `[System.IO.Path]::GetFullPath` and is
// cited on the case it pins.
test "normalize-path: POSIX behaviour is unchanged" {
    // The documented motivating case from the function header.
    assert _rcr_normalize_path("runtime/native/../sfn/io.sfn") == "runtime/sfn/io.sfn";
    assert _rcr_normalize_path("/a/b/../c") == "/a/c";
    assert _rcr_normalize_path("./a") == "a";
    assert _rcr_normalize_path("a/b/..") == "a";
    assert _rcr_normalize_path("") == "";
}

test "normalize-path: an absolute POSIX root absorbs excess .." {
    assert _rcr_normalize_path("/..") == "/";
    assert _rcr_normalize_path("/a/../../..") == "/";
}

test "normalize-path: a relative path keeps uncollapsible leading .." {
    assert _rcr_normalize_path("../sfn/io.sfn") == "../sfn/io.sfn";
    assert _rcr_normalize_path("a/../..") == "..";
}

// A doubled leading slash is a legal POSIX path, NOT a UNC root.
// This is why `_rcr_root_prefix_len` detects UNC only in its
// backslash form — recognizing `//` would silently change this.
test "normalize-path: a doubled POSIX slash is not a UNC root" {
    assert _rcr_normalize_path("//home/x") == "/home/x";
}

// The exact corruption reported in SFN-642: with `/`-only splitting
// the drive-qualified prefix was one opaque segment and the `..`
// deleted it, yielding a bare relative `runtime`.
test "normalize-path: a mixed-separator drive path keeps its drive" {
    assert _rcr_normalize_path("C:\\Users\\foo\\bin/../runtime") == "C:/Users/foo/runtime";
    assert _rcr_normalize_path("C:\\a\\b") == "C:/a/b";
    assert _rcr_normalize_path("C:\\a\\b/../c") == "C:/a/c";
}

// The case that separator-agnostic splitting ALONE does not fix: the
// drive prefix must be a root, or one extra `..` pops it.
// Win32: GetFullPath("C:/a/b/../../../../c") -> "C:\c"
test "normalize-path: a drive root absorbs excess .." {
    assert _rcr_normalize_path("C:\\a\\..\\..\\b") == "C:/b";
    assert _rcr_normalize_path("C:/a/b/../../../../c") == "C:/c";
    assert _rcr_normalize_path("C:\\") == "C:/";
    assert _rcr_normalize_path("C:\\..") == "C:/";
}

// `C:a` is drive-RELATIVE (the working directory on drive C), which
// is a different file from `C:\a` — so the root must not acquire a
// separator, and a leading `..` stays meaningful.
test "normalize-path: a drive-relative root is not absolute" {
    assert _rcr_normalize_path("C:a/../b") == "C:b";
    assert _rcr_normalize_path("C:..\\x") == "C:../x";
    assert _rcr_normalize_path("C:") == "C:";
}

// Win32: GetFullPath("//server/share/a/../..") -> "\\server\share"
// The share is part of the root; `..` never climbs to `\\server`.
test "normalize-path: a UNC root spans the share and absorbs .." {
    assert _rcr_normalize_path("\\\\server\\share\\a\\..\\b") == "\\\\server\\share/b";
    assert _rcr_normalize_path("\\\\server\\share\\a\\..\\..") == "\\\\server\\share";
}

// Extended-length and device paths bypass Win32 path parsing and are
// valid only with backslashes, so they are handed back untouched.
test "normalize-path: extended-length and device paths pass through" {
    assert _rcr_normalize_path("\\\\?\\C:\\a\\..\\b") == "\\\\?\\C:\\a\\..\\b";
    assert _rcr_normalize_path("\\\\.\\PIPE\\x") == "\\\\.\\PIPE\\x";
}

// `_rcr_artifacts_from_manifest` re-normalizes `manifest_dir`
// whether or not it has already been normalized, so a second pass
// must be a no-op. This is what forbids rewriting a `\\server\share`
// root to `//server/share`: the next pass would read that back as a
// POSIX root and return `/server/share`.
test "normalize-path: normalization is idempotent" {
    // Includes every output that CLAMPS to a bare root, because those
    // are the outputs whose re-parse is least obvious — and the
    // function is re-fed its own output 5+ times per capsule.
    let cases = ["/a/b/../c", "runtime/native/../sfn/io.sfn", "C:\\Users\\foo\\bin/../runtime", "C:\\a\\..\\..\\b", "C:a/../b", "\\\\server\\share\\a\\..\\b", "//home/x", "/..", "C:\\..", "C:", "\\\\server\\share\\a\\..\\..", "a/..", "a/../..", "\\\\", "\\\\srv", "\\\\srv\\", "\\\\srv\\\\a\\b"];
    let mut i: int = 0;
    loop {
        if i >= cases.length { break; }
        let once = _rcr_normalize_path(cases[i]);
        assert _rcr_normalize_path(once) == once;
        i += 1;
    }
}

// `a/..` is the ONLY way to reach the `return "."` branch — `a/b/..`
// and `a/../..` both miss it.
test "normalize-path: collapsing to nothing yields a dot" {
    assert _rcr_normalize_path("a/..") == ".";
    assert _rcr_normalize_path(".") == ".";
}

test "normalize-path: POSIX shape edge cases" {
    assert _rcr_normalize_path("/") == "/";
    assert _rcr_normalize_path("..") == "..";
    assert _rcr_normalize_path("a/b/") == "a/b";
    assert _rcr_normalize_path("/a//b") == "/a/b";
}

// A `\` is legal in a POSIX filename, so host-agnostic string logic
// cannot tell it from a Windows separator. These two inputs change
// meaning by design; pinned so the trade-off is visible rather than
// discovered later.
test "normalize-path: a backslash is always a separator" {
    assert _rcr_normalize_path("dir/a\\b") == "dir/a/b";
    assert _rcr_normalize_path("\\a") == "/a";
}

test "normalize-path: degenerate UNC roots survive" {
    assert _rcr_normalize_path("\\\\") == "\\\\";
    assert _rcr_normalize_path("\\\\srv") == "\\\\srv";
    assert _rcr_normalize_path("\\\\srv\\") == "\\\\srv\\";
}

// A doubled separator yields an EMPTY share, which makes the token
// after it an ordinary poppable segment. That is counter-intuitive,
// so it is pinned against the platform rather than against intuition:
//   GetFullPath("//srv//a/../../b")   -> "\\srv\b"     a is popped
//   GetFullPath("//srv/sh/a/../../b") -> "\\srv\sh\b"  sh is kept
test "normalize-path: a doubled UNC separator gives an empty share" {
    assert _rcr_normalize_path("\\\\srv\\\\a\\..\\..\\b") == "\\\\srv\\b";
    assert _rcr_normalize_path("\\\\srv\\sh\\a\\..\\..\\b") == "\\\\srv\\sh/b";
}

// --------------------------------------------------------------
// _rcr_path_join / _rcr_resolve_path — the composition
// --------------------------------------------------------------
// `_rcr_resolve_path` is normalize(join(dir, rel)), and it is what
// every artifact path actually goes through. Testing the normalizer
// alone missed a join bug that silently promoted a drive-RELATIVE
// root to drive-absolute.
test "path-join: a bare drive-relative root takes no separator" {
    // `C:` + `sfn` is `C:sfn` (cwd on drive C), NOT `C:/sfn` (root of
    // drive C). Those are different files.
    assert _rcr_path_join("C:", "sfn") == "C:sfn";
    // `C:a` already has a segment, so it joins normally.
    assert _rcr_path_join("C:a", "b") == "C:a/b";
    assert _rcr_path_join("a", "b") == "a/b";
    assert _rcr_path_join("a/", "b") == "a/b";
    // A backslash already terminates the base — do not add a second
    // separator.
    assert _rcr_path_join("C:\\a\\", "b") == "C:\\a\\b";
}

test "path-resolve: manifest-relative paths keep their root" {
    assert _rcr_resolve_path("runtime/native", "../sfn/io.sfn") == "runtime/sfn/io.sfn";
    assert _rcr_resolve_path("C:/rt", "../sfn/io.sfn") == "C:/sfn/io.sfn";
    assert _rcr_resolve_path("C:\\rt", "./x.c") == "C:/rt/x.c";
    assert _rcr_resolve_path("\\\\srv\\share", "../x.c") == "\\\\srv\\share/x.c";
    // The drive-relative root must survive the round trip.
    assert _rcr_resolve_path("C:", "sfn/io.sfn") == "C:sfn/io.sfn";
}
