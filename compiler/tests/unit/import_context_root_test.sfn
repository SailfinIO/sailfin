// compiler/tests/unit/import_context_root_test.sfn
//
// SFN-167/SFN-736: the driver derives an import-context root per invocation
// and passes the resulting loaded data into LLVM. No process-global reader
// root remains in the lowering subtree.
import { NativeImport } from "sfn/ir";

import { import_context_root, load_imported_module_context } from "../../src/import_context";

test "import-context reader: empty work dir resolves the canonical shared default" {
    assert import_context_root("") == "build/compiler/import-context";
}

test "import-context reader: a work dir gets an isolated explicit root" {
    assert import_context_root("/w") == "/w/compiler/import-context";
}

test "import-context reader: native-only capsule entry takes the mod fallback" ![io] {
    let root = fs.mkdtemp("sfn-import-context-");
    let provider_dir = root + "/sfn/example";
    fs.createDirectory(root + "/sfn");
    fs.createDirectory(provider_dir);
    let native_text = ".module sfn/example/mod\n";
    fs.writeFile(provider_dir + "/mod.sfn-asm", native_text);

    let imports: NativeImport[] = [NativeImport {
        kind: "import", module: "sfn/example", specifiers: []
    }];
    let context = load_imported_module_context(imports, "runtime/probe", root);

    assert context.native_texts.length == 1;
    assert context.native_texts[0] == native_text;
    assert context.module_aliases.length == 1;
    assert context.module_aliases[0].import_slug == "sfn/example";
    assert context.module_aliases[0].provider_slug == "sfn/example/mod";
}

test "import-context reader: directory import follows a physical mod alias" ![io] {
    let root = fs.mkdtemp("sfn-import-context-alias-");
    fs.createDirectory(root + "/compiler/src/capsule_resolver", true);
    fs.createDirectory(root + "/capsule_resolver", true);
    let native_text = ".module capsule_resolver/mod\n";
    fs.writeFile(root + "/capsule_resolver/mod.sfn-asm", native_text);
    fs.writeFile(root + "/compiler/src/capsule_resolver/mod.slugalias", "capsule_resolver/mod");

    let imports: NativeImport[] = [NativeImport {
        kind: "import", module: "../../src/capsule_resolver", specifiers: []
    }];
    let context = load_imported_module_context(imports, "compiler/tests/unit/probe", root);

    assert context.native_texts.length == 1;
    assert context.native_texts[0] == native_text;
    assert context.module_aliases.length == 1;
    assert context.module_aliases[0].import_slug == "compiler/src/capsule_resolver";
    assert context.module_aliases[0].provider_slug == "capsule_resolver/mod";
}
