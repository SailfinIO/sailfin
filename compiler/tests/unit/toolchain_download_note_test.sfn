// compiler/tests/unit/toolchain_download_note_test.sfn
//
// Regression for SFN-924: a failed `sfn toolchain install` printed only
// "error: failed to download release manifest" and the URL, which reads
// as a dead network or a missing asset. On a Windows host both are
// usually wrong — mingw cross-built binaries carry no TLS at all
// (`tls.sfn` is out of `RUNTIME_MODS`, and `tls_client_ctx` resolves to
// the null-returning stub in `runtime/ir/windows_stubs.ll`), so every
// `https://` request fails before a socket is opened. The release URLs
// are all https, so the command cannot work on such a build, and the
// old message gave the reader nothing to act on.
//
// There is no runtime `setenv`, so a `.sfn` process cannot flip
// `SAILFIN_HOST_OS` for an in-process call mid-test (the SFN-478
// pattern). This file's Windows leg is exercised by RUNNING it with the
// override set, matching `toolchain_host_detect_test.sfn`:
//   SAILFIN_HOST_OS=Windows build/bin/sfn test compiler/tests/unit/toolchain_download_note_test.sfn
// The plain suite run takes the host's own leg.
import { contains } from "sfn/strings";

import { build_host_os } from "../../src/build/target";
import { _download_failure_note, _is_https_url } from "../../src/cli/commands/toolchain";

test "toolchain-download-note: https scheme detection" {
    assert _is_https_url("https://example.com/a");
    assert ! _is_https_url("http://example.com/a");
    // Prefix-only match: the scheme must lead, not merely appear.
    assert ! _is_https_url("ftp://example.com/https://x");
    assert ! _is_https_url("");
    // Shorter than the scheme itself must not index out of range.
    assert ! _is_https_url("htt");
}

test "toolchain-download-note: a plaintext URL never carries the TLS note" ![io] {
    // Plain http works even on a TLS-less build, so the note would be
    // actively misleading there — it must stay empty on every host.
    assert _download_failure_note("http://example.com/SHA256SUMS").length == 0;
}

test "toolchain-download-note: the note is Windows-only and names the cause" ![io] {
    let host = build_host_os();
    let note = _download_failure_note("https://example.com/SHA256SUMS");
    if host == "Windows" {
        assert note.length > 0;
        // The note has to survive rewording, so assert on the load-bearing
        // content rather than the exact prose: what is broken, and the
        // discriminator that lets a reader confirm it themselves.
        assert contains(note, "TLS");
        assert contains(note, "http://");
        assert contains(note, "SFN-923");
    } else {
        // A native Windows build links the real tls.sfn and is unaffected,
        // and no other host has the defect at all.
        assert note.length == 0;
    }
}
