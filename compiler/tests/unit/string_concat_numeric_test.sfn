// Regression coverage for SFN-548: `print("n=" + n)` where `n: int` compiled
// and exited 0 but silently dropped the call from the IR. The fix defines
// `string + <numeric/bool>` as sugar for `string + (<numeric/bool> as string)`,
// so these tests pin the resulting text against the existing `as string` cast
// semantics (booleans render as "1"/"0", not "true"/"false") and guard the
// pre-existing char/byte concat shape the fix must not disturb.
//
// The first attempt at this fix keyed the gate off "string-shaped" operands,
// which at the LLVM level includes bare `i8*` — but `*u8`, `*opaque`, and
// unresolved types ALL lower to `i8*` too, so `buf + n` on a raw byte buffer
// silently stopped emitting `getelementptr` and instead called `strlen` on a
// non-NUL-terminated buffer and concatenated: an out-of-bounds read replacing
// pointer arithmetic. The fix narrowed the gate to the `{i8*, i64}` string
// aggregate specifically. The test below pins the behavioral contract that
// narrowing protects.
extern fn malloc(size: usize) -> *u8;

test "string concat: *u8 pointer arithmetic still GEPs offsets, not string-concats" {
    // If the string-concat gate ever widens back to bare `i8*`, `buf + n`
    // would stop offsetting and instead treat `buf` as a NUL-terminated
    // string operand, corrupting these writes/reads (or reading out of
    // bounds via `strlen` on unterminated malloc'd memory).
    let buf: *u8 = malloc(4 as usize);

    let p0 = buf + 0;
    let p1 = buf + 1;
    let p2 = buf + 2;
    let p3 = buf + 3;

    *p0 = 11 as u8;
    *p1 = 22 as u8;
    *p2 = 33 as u8;
    *p3 = 44 as u8;

    let v0 = *p0;
    let v1 = *p1;
    let v2 = *p2;
    let v3 = *p3;

    assert(v0 as i64) == 11;
    assert(v1 as i64) == 22;
    assert(v2 as i64) == 33;
    assert(v3 as i64) == 44;
}

test "string concat: string + int yields concatenated text" {
    let n = 42;
    let out = "n=" + n;
    assert out == "n=42";
}

test "string concat: string + float yields concatenated text" {
    let f = 1.5;
    let out = "f=" + f;
    assert out == "f=1.5";
}

test "string concat: string + bool renders as 1/0, not true/false" {
    let t = true;
    let f = false;
    let out_true = "t=" + t;
    let out_false = "f=" + f;
    assert out_true == "t=1";
    assert out_false == "f=0";
}

test "string concat: string + s.length concatenates the int shape" {
    let s = "ab";
    let out = "len=" + s.length;
    assert out == "len=2";
}

test "string concat: char operand still concatenates as its character" {
    // Pre-existing: indexing a string yields a single-character string, not a
    // numeric code point. The numeric-stringification fix must not reinterpret
    // this already-string operand as anything other than its character.
    let s = "abc";
    let c = s[1];
    let out = "char=" + c;
    assert out == "char=b";
}

test "string concat: numeric on the left stringifies too" {
    let n = 3;
    let out = n + " items";
    assert out == "3 items";
}

test "string concat: string local and parameter operands stringify" {
    // Literals, locals and parameters all reach lowering as the `{i8*, i64}`
    // aggregate, which is the shape the numeric-concat clause keys off.
    let s = "n=";
    let n = 42;
    let out = s + n;
    assert out == "n=42";
}

test "string concat: concatenated result is a usable string downstream" {
    // Guards the produced aggregate's length field, not just its bytes: a
    // malformed shape still compares equal byte-wise but reports a bad length.
    let n = 42;
    let out = "n=" + n;
    assert out.length == 4;
}

test "string concat: result bound to a variable before use" {
    // Previously the specific shape that produced wrong output: assigning the
    // concat result to a variable, rather than passing it inline to a call.
    let n = 7;
    let m = "n=" + n;
    assert m == "n=7";
}
