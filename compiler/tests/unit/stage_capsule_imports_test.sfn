// Regression tests for #514: `stage_capsule_imports` must invalidate its
// staged `.sfn-asm` + `.layout-manifest` cache by source-content hash, not
// by file existence or mtime.
//
// Before #514 the staging cache treated a present `.sfn-asm` + `.layout-manifest`
// pair as an authoritative hit purely by existence, so the Makefile had to
// wipe `build/compiler/import-context/*.sfn-asm` by hand on every rebuild. The
// fix records a `.srchash` sidecar holding the SHA-256 of the source; a hit
// now requires that sidecar to match the source's current hash.
//
// These tests pin the content-hash semantics so a future "mtime is faster"
// refactor can't silently regress: `git checkout` resets mtimes to checkout
// time, so timestamps lie — only the content hash is trustworthy.
//
// The resolver decomposition keeps the staging module within the standalone
// unit-test timeout, so these tests exercise the production cache helpers.
//
// Each test uses its own `/tmp` namespace so parallel runs don't collide,
// and cleans up on exit.
import { BuildCacheConfig, sha256_of_file } from "../../src/build_cache";
import { _cr_ensure_dir, _cr_import_context_root } from "../../src/capsule_resolver/paths";
import { capsule_origin_local, capsule_origin_workspace } from "../../src/capsule_resolver/provenance";
import {
    _cr_collect_per_source_dep_slugs,
    _cr_disabled_stage_cache_ctx,
    _cr_srchash_path,
    _cr_stage_cache_hit,
    _cr_stage_one_outcome,
    _cr_write_srchash,
    stage_capsule_imports
} from "../../src/capsule_resolver/staging";
import { CapsuleSource } from "../../src/capsule_resolver/types";

// --------------------------------------------------------------
// Fixture helpers
// --------------------------------------------------------------
fn _sct_tmp_root(label: string) -> string ![io] {
    let root = "/tmp/sfn_stage_cache_test_" + label;
    process.run(["rm", "-rf", root]);
    process.run(["mkdir", "-p", root]);
    return root;
}

fn _sct_cleanup(path: string) ![io] {
    process.run(["rm", "-rf", path]);
}

// These tests exercise the local `.srchash`-gated cache exclusively; the
// SFN-861 shared cache is covered by `stage_cache_key_test.sfn`.
fn _sct_no_cache() -> BuildCacheConfig {
    return BuildCacheConfig {
        enabled: false,
        trace: false,
        clean: false,
        capsule_name: ""
    };
}

// Stage the three on-disk artifacts a real cache hit needs:
// `<root>/<slug>.sfn-asm`, `<root>/<slug>.layout-manifest`, and the
// `.srchash` sidecar recording the current source hash.
fn _sct_stage(root: string, slug: string, src_path: string, asm_path: string, manifest_path: string) ![io] {
    fs.writeFile(asm_path, "; staged native IR placeholder\n");
    fs.writeFile(manifest_path, ".layout foo i64\n");
    _cr_write_srchash(_cr_srchash_path(root, slug), src_path);
}

// --------------------------------------------------------------
// Sidecar path shape
// --------------------------------------------------------------
test "stage cache: srchash sidecar is a sibling of the staged artifacts" {
    assert _cr_srchash_path("build/compiler/import-context", "cli_main") == "build/compiler/import-context/cli_main.srchash";
    assert _cr_srchash_path("build/compiler/import-context", "sfn/cli/mod") == "build/compiler/import-context/sfn/cli/mod.srchash";
}

// --------------------------------------------------------------
// Cache hit / miss by content
// --------------------------------------------------------------
test "stage cache: hit when source is unchanged" ![io] {
    let root = _sct_tmp_root("hit_unchanged");
    let slug = "mymod";
    let src_path = root + "/mymod.sfn";
    let asm_path = root + "/" + slug + ".sfn-asm";
    let manifest_path = root + "/" + slug + ".layout-manifest";
    fs.writeFile(src_path, "fn main() { }\n");
    _sct_stage(root, slug, src_path, asm_path, manifest_path);
    assert _cr_stage_cache_hit(asm_path, manifest_path, _cr_srchash_path(root, slug), src_path);
    _sct_cleanup(root);
}

test "stage cache: miss when source content changes" ![io] {
    let root = _sct_tmp_root("miss_changed");
    let slug = "mymod";
    let src_path = root + "/mymod.sfn";
    let asm_path = root + "/" + slug + ".sfn-asm";
    let manifest_path = root + "/" + slug + ".layout-manifest";
    fs.writeFile(src_path, "fn main() { }\n");
    _sct_stage(root, slug, src_path, asm_path, manifest_path);
    // The sidecar now records the OLD hash; changing the bytes must miss.
    fs.writeFile(src_path, "fn main() { print.info(\"changed\"); }\n");
    assert ! _cr_stage_cache_hit(asm_path, manifest_path, _cr_srchash_path(root, slug), src_path);
    _sct_cleanup(root);
}

// The headline guarantee: a pure mtime bump (rewrite of byte-identical
// content) must NOT invalidate. An mtime-based cache would wrongly miss
// here; the content-hash predicate must still hit.
test "stage cache: identical content after rewrite still hits (content-hash, not mtime)" ![io] {
    let root = _sct_tmp_root("mtime_only");
    let slug = "mymod";
    let src_path = root + "/mymod.sfn";
    let asm_path = root + "/" + slug + ".sfn-asm";
    let manifest_path = root + "/" + slug + ".layout-manifest";
    let body = "fn main() { }\n";
    fs.writeFile(src_path, body);
    _sct_stage(root, slug, src_path, asm_path, manifest_path);
    fs.writeFile(src_path, body);
    assert _cr_stage_cache_hit(asm_path, manifest_path, _cr_srchash_path(root, slug), src_path);
    _sct_cleanup(root);
}

// --------------------------------------------------------------
// Cache miss guards
// --------------------------------------------------------------
test "stage cache: miss when sidecar absent" ![io] {
    let root = _sct_tmp_root("no_sidecar");
    let slug = "mymod";
    let src_path = root + "/mymod.sfn";
    let asm_path = root + "/" + slug + ".sfn-asm";
    let manifest_path = root + "/" + slug + ".layout-manifest";
    fs.writeFile(src_path, "fn main() { }\n");
    fs.writeFile(asm_path, "; ir\n");
    fs.writeFile(manifest_path, "");
    // asm + manifest exist but no `.srchash` -> miss (forces fresh emit).
    assert ! _cr_stage_cache_hit(asm_path, manifest_path, _cr_srchash_path(root, slug), src_path);
    _sct_cleanup(root);
}

test "stage cache: miss when asm or manifest missing" ![io] {
    let root = _sct_tmp_root("missing_artifact");
    let slug = "mymod";
    let src_path = root + "/mymod.sfn";
    let asm_path = root + "/" + slug + ".sfn-asm";
    let manifest_path = root + "/" + slug + ".layout-manifest";
    fs.writeFile(src_path, "fn main() { }\n");
    _cr_write_srchash(_cr_srchash_path(root, slug), src_path);
    // Sidecar matches, but artifacts are absent -> miss.
    assert ! _cr_stage_cache_hit(asm_path, manifest_path, _cr_srchash_path(root, slug), src_path);
    fs.writeFile(asm_path, "; ir\n");
    // asm present, manifest still absent -> miss.
    assert ! _cr_stage_cache_hit(asm_path, manifest_path, _cr_srchash_path(root, slug), src_path);
    _sct_cleanup(root);
}

// --------------------------------------------------------------
// Underlying content-addressing primitive
// --------------------------------------------------------------
test "stage cache: sha256_of_file is content-addressed, not mtime-addressed" ![io] {
    let root = _sct_tmp_root("sha_content");
    let a = root + "/a.sfn";
    fs.writeFile(a, "fn x() { }\n");
    let h1 = sha256_of_file(a);
    assert h1.length == 64;
    // Rewrite byte-identical content (bumps mtime) -> same hash.
    fs.writeFile(a, "fn x() { }\n");
    assert sha256_of_file(a) == h1;
    // Different bytes -> different hash.
    fs.writeFile(a, "fn y() { }\n");
    assert sha256_of_file(a) != h1;
    _sct_cleanup(root);
}

// --------------------------------------------------------------
// Per-source dep slugs (SFN-661)
// --------------------------------------------------------------
// `_cr_collect_per_source_dep_slugs` is the resolution half of the
// module-split cache fix: `cache_key_for` now mixes a dependency's
// slug into the digest, so the resolver must be able to report, per
// source, the slugs of its direct imports through the real import
// scan (including the directory-import fallback `./dep` -> `dep/mod.sfn`
// when `dep.sfn` does not exist). This test proves that splitting a
// dependency module changes its dependents' reported dep slugs even
// when the dependent's own source bytes are untouched — exactly the
// input that busts the dependent's cache key.
test "capsule resolver: splitting a dependency module changes its dependents' dep slugs" ![io] {
    let root = _sct_tmp_root("split_dep_slugs");
    let a_path = root + "/a.sfn";
    let a_body = "import { helper } from \"./dep\";\nfn use_helper() -> int { return helper(); }\n";
    fs.writeFile(a_path, a_body);

    // Before the split: a single `dep.sfn` provides `helper`.
    let dep_path = root + "/dep.sfn";
    fs.writeFile(dep_path, "export fn helper() -> int { return 1; }\n");

    let a_src = CapsuleSource {
        spec: "",
        source_path: a_path,
        slug: "a",
        ll_path: "",
        origin: capsule_origin_local()
    };
    let dep_src = CapsuleSource {
        spec: "",
        source_path: dep_path,
        slug: "dep",
        ll_path: "",
        origin: capsule_origin_local()
    };
    let before = _cr_collect_per_source_dep_slugs([a_src, dep_src], [a_src, dep_src]);
    assert before[0].length == 1;
    assert before[0][0] == "dep";

    // Perform the split: delete `dep.sfn`, replace with `dep/mod.sfn`
    // (re-exporting) + `dep/impl.sfn` (the real definition). `a.sfn`
    // is left byte-identical.
    process.run(["rm", "-f", dep_path]);
    process.run(["mkdir", "-p", root + "/dep"]);
    let dep_mod_path = root + "/dep/mod.sfn";
    let dep_impl_path = root + "/dep/impl.sfn";
    fs.writeFile(dep_impl_path, "export fn helper() -> int { return 1; }\n");
    fs.writeFile(dep_mod_path, "export { helper } from \"./impl\";\n");
    assert fs.readFile(a_path) == a_body;

    let dep_mod_src = CapsuleSource {
        spec: "",
        source_path: dep_mod_path,
        slug: "dep/mod",
        ll_path: "",
        origin: capsule_origin_local()
    };
    let dep_impl_src = CapsuleSource {
        spec: "",
        source_path: dep_impl_path,
        slug: "dep/impl",
        ll_path: "",
        origin: capsule_origin_local()
    };
    let after = _cr_collect_per_source_dep_slugs([a_src, dep_mod_src], [a_src, dep_mod_src, dep_impl_src]);
    // `a.sfn` did not change, but its resolved dep slug did — this is
    // the input `cache_key_for` now hashes to bust `a`'s stale cache
    // entry after the split (SFN-661).
    assert after[0].length == 1;
    assert after[0][0] == "dep/mod";

    _sct_cleanup(root);
}

// --------------------------------------------------------------
// Fail-closed provenance guard (SFN-715)
// --------------------------------------------------------------
// `stage_capsule_imports` picks one of three staging strategies, and only two
// of them call `_cr_stage_one_outcome` — the parallel branch builds its emit
// tasks directly. The cache-hit probe inside `_cr_stage_one_outcome` also
// returns early. A guard placed downstream of either is dead on the paths a
// real build uses, so these tests pin the ordering rather than just the
// predicate.
fn _sct_source(path: string, slug: string, origin: string) -> CapsuleSource {
    return CapsuleSource {
        spec: "",
        source_path: path,
        slug: slug,
        ll_path: "",
        origin: origin
    };
}

test "capsule-resolver: staging refuses a source with unstamped provenance" ![io] {
    let root = _sct_tmp_root("provenance_unstamped");
    let src_path = root + "/mymod.sfn";
    fs.writeFile(src_path, "fn unused_helper() -> int { return 1; }\n");
    // An unstamped source is a construction site that forgot to declare where
    // the bytes came from — it must not stage.
    assert ! stage_capsule_imports([_sct_source(src_path, "mymod", "")], _sct_no_cache(), "", root);
    // An origin outside the known set is refused the same way, so adding a new
    // provenance without teaching the guard fails closed.
    assert ! stage_capsule_imports([_sct_source(src_path, "mymod", "registry")], _sct_no_cache(), "", root);
    _sct_cleanup(root);
}

test "capsule-resolver: provenance guard precedes the staging cache hit" ![io] {
    let root = _sct_tmp_root("provenance_cache_hit");
    let slug = "mymod";
    let src_path = root + "/mymod.sfn";
    fs.writeFile(src_path, "fn unused_helper() -> int { return 1; }\n");
    // Warm the staged artifacts so the cache-hit probe would succeed and
    // short-circuit. The guard must still refuse.
    let context_root = _cr_import_context_root(root);
    _cr_ensure_dir(context_root);
    let asm_path = context_root + "/" + slug + ".sfn-asm";
    let manifest_path = context_root + "/" + slug + ".layout-manifest";
    _sct_stage(context_root, slug, src_path, asm_path, manifest_path);
    assert _cr_stage_cache_hit(asm_path, manifest_path, _cr_srchash_path(context_root, slug), src_path);
    assert ! _cr_stage_one_outcome(_sct_source(src_path, slug, ""), _cr_disabled_stage_cache_ctx(), "", root).ok;
    assert ! stage_capsule_imports([_sct_source(src_path, slug, "")], _sct_no_cache(), "", root);
    _sct_cleanup(root);
}

// Two sources plus a non-empty exe selects the multi-source strategy, which
// never calls `_cr_stage_one_outcome`. Both sources are pre-warmed into the staging
// cache so that strategy dispatches no emit at all: a fully-stamped set then
// succeeds without touching the (deliberately unusable) exe, which is what
// makes the unstamped variant's failure attributable to provenance and nothing
// else. An earlier version of this test asserted only the failure and passed
// even with the guard disabled, because the bogus exe failed the emit anyway.
fn _sct_warm(root: string, slug: string, src_path: string) ![io] {
    let context_root = _cr_import_context_root(root);
    _cr_ensure_dir(context_root);
    _sct_stage(context_root, slug, src_path, context_root + "/" + slug
        + ".sfn-asm", context_root
        + "/"
        + slug
        + ".layout-manifest");
}

test "capsule-resolver: provenance is validated before a staging strategy is chosen" ![io] {
    let root = _sct_tmp_root("provenance_before_strategy");
    let a_path = root + "/a.sfn";
    let b_path = root + "/b.sfn";
    fs.writeFile(a_path, "fn unused_a() -> int { return 1; }\n");
    fs.writeFile(b_path, "fn unused_b() -> int { return 2; }\n");
    _sct_warm(root, "a", a_path);
    _sct_warm(root, "b", b_path);
    // Assert the warm-up actually took before relying on it. If a cache hit
    // silently failed, the control case below would dispatch a real emit
    // against the unusable exe and hang rather than fail — so pin it here.
    let ctx = _cr_import_context_root(root);
    assert _cr_stage_cache_hit(ctx + "/a.sfn-asm", ctx + "/a.layout-manifest", _cr_srchash_path(ctx, "a"), a_path);
    assert _cr_stage_cache_hit(ctx + "/b.sfn-asm", ctx + "/b.layout-manifest", _cr_srchash_path(ctx, "b"), b_path);
    let unusable_exe = root + "/no-such-sfn-binary";
    let good_a = _sct_source(a_path, "a", capsule_origin_local());
    let good_b = _sct_source(b_path, "b", capsule_origin_workspace());
    // Control: fully stamped, all cache hits — succeeds, no emit dispatched.
    assert stage_capsule_imports([good_a, good_b], _sct_no_cache(), unusable_exe, root);
    // One unstamped source must fail the whole set, on the same strategy.
    let bad_b = _sct_source(b_path, "b", "");
    assert ! stage_capsule_imports([good_a, bad_b], _sct_no_cache(), unusable_exe, root);
    _sct_cleanup(root);
}
