// #1236 / SFN-91: unit coverage for the explicit jobs parser and the pure
// RAM+CPU budget behind the native default. SFN-547 introduced the
// reconciled per-job reserve (originally 3 GiB) and the nested-fan-out pin
// in `_pool_child_env`; SFN-626 re-sized it to 2.5 GiB after re-measuring
// the worst emit worker. SFN-781 stopped borrowing the emit worker's figure
// altogether — a pooled test child is a different workload — and made the
// parent runner an explicit term, so every expectation below moved.
//
// This file covers the native budget alone. Its agreement with the bash twin
// `scripts/detect_test_jobs.sh` — the Makefile's `TEST_JOBS ?=` default — is a
// separate contract, enforced over a shared boundary table by SFN-794's
// `compiler/tests/integration/test_jobs_budget_parity_test.sfn`. A constant
// moved here has to move there too, and both files then go red.
import { _parse_jobs_value, _test_jobs_budget } from "../../src/cli/commands/test/arg_and_jobs";
import { _pool_child_env } from "../../src/cli/commands/test/pool";

test "jobs: plain positive integer parses" {
    assert _parse_jobs_value("4") == 4;
}

test "jobs: 1 parses (serial default shape)" {
    assert _parse_jobs_value("1") == 1;
}

test "jobs: multi-digit value parses" {
    assert _parse_jobs_value("32") == 32;
}

test "jobs: cap value 256 accepted" {
    assert _parse_jobs_value("256") == 256;
}

test "jobs: above-cap value rejected" {
    assert _parse_jobs_value("257") == -1;
}

test "jobs: zero rejected" { assert _parse_jobs_value("0") == -1; }

test "jobs: negative rejected" { assert _parse_jobs_value("-2") == -1; }

test "jobs: empty rejected" { assert _parse_jobs_value("") == -1; }

test "jobs: non-numeric rejected" { assert _parse_jobs_value("four") == -1; }

test "jobs: trailing garbage rejected" {
    assert _parse_jobs_value("4x") == -1;
}

test "jobs: leading whitespace rejected" {
    assert _parse_jobs_value(" 4") == -1;
}

test "jobs: auto budget is bounded by CPU and memory (SFN-91)" {
    // 16 GiB * 80% = 12.8 GiB, less the 5 GiB parent = 7.8 GiB / 3 GiB = 2,
    // below the 8-core ceiling.
    assert _test_jobs_budget(17179869184, 8, false) == 2;
    // 1.5 GiB cannot seat the parent runner alone — floors to serial.
    assert _test_jobs_budget(1610612736, 8, false) == 1;
    // CPU-bound: 64 GiB affords 15 jobs, 2 cores allows 2.
    assert _test_jobs_budget(68719476736, 2, false) == 2;
}

// SFN-781: the reserve no longer matches the emit fan-out
// (`_cr_ram_budget_jobs` keeps 2.5 GiB out of 66%). A pooled
// `--no-test-cache` test child measures 2.63-3.08 GiB against the 1.55 GiB
// emit worker that figure was sized from, and the parent runner — the
// largest process in the tree at 3.65-4.85 GiB — is now subtracted off the
// top instead of being left to an implicit remainder.
test "jobs: auto budget reserves the parent runner plus 3 GiB per job (SFN-781)" {
    // 14 GiB * 80% = 11.2 GiB - 5 GiB = 6.2 GiB / 3 GiB = 2.
    assert _test_jobs_budget(15032385536, 16, false) == 2;
    // 8 GiB * 80% = 6.4 GiB seats the parent but leaves 1.4 GiB — under one
    // job's reserve, so the pool floors to serial rather than over-fanning.
    assert _test_jobs_budget(8589934592, 8, false) == 1;
    // 32 GiB * 80% = 25.6 GiB - 5 GiB = 20.6 GiB / 3 GiB = 6.
    assert _test_jobs_budget(34359738368, 16, false) == 6;
}

// The exact host from the SFN-781 report: MemTotal 16461004 kB, 4 cores, no
// swap. The old policy prescribed 4 jobs here and was SIGKILLed at 17.26 GiB
// tree RSS; 2 jobs completes at a 10.4 GiB peak.
test "jobs: the reported 16 GiB / 4-core host resolves to 2 (SFN-781)" {
    assert _test_jobs_budget(16856068096, 4, false) == 2;
}

test "jobs: auto budget floors small and unknown hosts to serial (SFN-91)" {
    assert _test_jobs_budget(268435456, 8, false) == 1;
    assert _test_jobs_budget(0, 8, false) == 1;
}

test "jobs: auto budget applies global and Darwin caps (SFN-91)" {
    // 1 TiB * 80% = 819.2 GiB, less the parent, / 3 GiB = 271 — so memory
    // does not bind; 64 cores does, and the global cap then clamps to 16.
    assert _test_jobs_budget(1099511627776, 64, false) == 16;
    assert _test_jobs_budget(1099511627776, 64, true) == 2;
}

// SFN-980: `_test_jobs_budget` is pure, so a native Windows host resolving
// through `windows_physical_ram_bytes` (an extern the test suite cannot
// exercise on a Linux runner) is covered by feeding it Windows-plausible
// inputs directly rather than faking the probe.
test "jobs: Windows-plausible 16 GiB / 8-core host affords more than serial (SFN-980)" {
    // 16 GiB * 80% = 12.8 GiB, less the 5 GiB parent = 7.8 GiB / 3 GiB = 2.
    assert _test_jobs_budget(17179869184, 8, false) == 2;
}

test "jobs: Windows-plausible 128 GiB / 64-core host hits the global cap (SFN-980)" {
    // 128 GiB * 80% = 102.4 GiB, less the 5 GiB parent, / 3 GiB = 32 jobs by
    // memory — below the 64 cores, so memory binds; the global cap then
    // clamps 32 to 16.
    assert _test_jobs_budget(137438953472, 64, false) == 16;
}

test "jobs: Windows-plausible low-RAM host floors to serial (SFN-980)" {
    // 2 GiB cannot seat the 5 GiB parent reserve alone.
    assert _test_jobs_budget(2147483648, 8, false) == 1;
}

// SFN-547: a pooled child must not fan its own per-module emit out beside
// `jobs - 1` siblings doing the same — the pool is the parallelism layer.
test "jobs: pooled children are pinned to serial emit (SFN-547)" {
    // Not named `env`: that shadows the `env` builtin module, and member
    // access then resolves against the builtin (an `![io]` effect) instead
    // of the local array.
    let child_env = _pool_child_env(["PATH=/usr/bin"], "/tmp/s", "/tmp/o", "", false, false, "/build/bin/sfn");
    let mut found: boolean = false;
    let mut i: int = 0;
    loop {
        if i >= child_env.length { break; }
        if child_env[i] == "SAILFIN_BUILD_JOBS=1" { found = true; }
        i += 1;
    }
    assert found;
}

// An explicit override outranks the pin: the inherited entry is kept and no
// competing default is appended (POSIX `getenv` returns the first match).
test "jobs: inherited SAILFIN_BUILD_JOBS outranks the serial pin (SFN-547)" {
    let child_env = _pool_child_env(["SAILFIN_BUILD_JOBS=4"], "/tmp/s", "/tmp/o", "", false, false, "/build/bin/sfn");
    let mut pins: int = 0;
    let mut kept: boolean = false;
    let mut i: int = 0;
    loop {
        if i >= child_env.length { break; }
        if child_env[i] == "SAILFIN_BUILD_JOBS=1" { pins += 1; }
        if child_env[i] == "SAILFIN_BUILD_JOBS=4" { kept = true; }
        i += 1;
    }
    assert kept;
    assert pins == 0;
}
