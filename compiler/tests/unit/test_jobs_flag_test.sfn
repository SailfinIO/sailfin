// #1236 / SFN-91: unit coverage for the explicit jobs parser and the pure
// RAM+CPU budget behind the native default. SFN-547 introduced the
// reconciled per-job reserve (originally 3 GiB) and the nested-fan-out pin
// in `_pool_child_env`; SFN-626 re-sized it to 2.5 GiB after re-measuring the
// worst emit worker. The reserve is now 4 GiB — measured from the pooled test
// child itself rather than from the emit worker it can spawn (GitHub issue
// #2817); see `_test_jobs_budget`'s header for the RSS data.
import { _parse_jobs_value, _test_jobs_budget } from "../../src/cli/commands/test/arg_and_jobs";
import { _pool_child_env } from "../../src/cli/commands/test/pool";

test "jobs: plain positive integer parses" {
    assert _parse_jobs_value("4") == 4;
}

test "jobs: 1 parses (serial default shape)" {
    assert _parse_jobs_value("1") == 1;
}

test "jobs: multi-digit value parses" {
    assert _parse_jobs_value("32") == 32;
}

test "jobs: cap value 256 accepted" {
    assert _parse_jobs_value("256") == 256;
}

test "jobs: above-cap value rejected" {
    assert _parse_jobs_value("257") == -1;
}

test "jobs: zero rejected" { assert _parse_jobs_value("0") == -1; }

test "jobs: negative rejected" { assert _parse_jobs_value("-2") == -1; }

test "jobs: empty rejected" { assert _parse_jobs_value("") == -1; }

test "jobs: non-numeric rejected" { assert _parse_jobs_value("four") == -1; }

test "jobs: trailing garbage rejected" {
    assert _parse_jobs_value("4x") == -1;
}

test "jobs: leading whitespace rejected" {
    assert _parse_jobs_value(" 4") == -1;
}

test "jobs: auto budget is bounded by CPU and memory (SFN-91)" {
    // 16 GiB * 66% = 10.56 GiB / 4 GiB = 2, below the 8-core ceiling. This is
    // the CI runner class that was taking 4 jobs and losing the VM.
    assert _test_jobs_budget(17179869184, 8, false) == 2;
    // 1.5 GiB is under a single job's reserve — floors to serial.
    assert _test_jobs_budget(1610612736, 8, false) == 1;
    // CPU-bound: 64 GiB affords 10 jobs, 2 cores allows 2.
    assert _test_jobs_budget(68719476736, 2, false) == 2;
}

// The reserve deliberately no longer matches the emit fan-out
// (`_cr_ram_budget_jobs`, still 2.5 GiB): a pooled test child compiles the
// compiler dep closure in-process and peaks at 3.2-4.1 GiB, where the emit
// worker SFN-626 measured peaks at 1.55 GiB. Sizing the pool off the emit
// worker over-subscribed every 8-16 GiB host. The 14 GiB host from the
// SFN-547 report resolved to 16 jobs under the original 384 MiB reserve and
// killed itself; it resolves to 2 here.
test "jobs: auto budget reserves 4 GiB per job out of 66% of RAM" {
    assert _test_jobs_budget(15032385536, 16, false) == 2;
    // 8 GiB * 66% = 5.28 GiB — one job's reserve fits, a second does not.
    assert _test_jobs_budget(8589934592, 8, false) == 1;
    // 32 GiB * 66% = 21.12 GiB / 4 GiB = 5.
    assert _test_jobs_budget(34359738368, 16, false) == 5;
}

test "jobs: auto budget floors small and unknown hosts to serial (SFN-91)" {
    assert _test_jobs_budget(268435456, 8, false) == 1;
    assert _test_jobs_budget(0, 8, false) == 1;
}

test "jobs: auto budget applies global and Darwin caps (SFN-91)" {
    // 1 TiB * 66% = 675.8 GiB / 4 GiB = 168, clamped to the global cap of 16.
    assert _test_jobs_budget(1099511627776, 64, false) == 16;
    assert _test_jobs_budget(1099511627776, 64, true) == 2;
}

// SFN-547: a pooled child must not fan its own per-module emit out beside
// `jobs - 1` siblings doing the same — the pool is the parallelism layer.
test "jobs: pooled children are pinned to serial emit (SFN-547)" {
    // Not named `env`: that shadows the `env` builtin module, and member
    // access then resolves against the builtin (an `![io]` effect) instead
    // of the local array.
    let child_env = _pool_child_env(["PATH=/usr/bin"], "/tmp/s", "/tmp/o", "", false, false, "/build/bin/sfn");
    let mut found: boolean = false;
    let mut i: int = 0;
    loop {
        if i >= child_env.length { break; }
        if child_env[i] == "SAILFIN_BUILD_JOBS=1" { found = true; }
        i += 1;
    }
    assert found;
}

// An explicit override outranks the pin: the inherited entry is kept and no
// competing default is appended (POSIX `getenv` returns the first match).
test "jobs: inherited SAILFIN_BUILD_JOBS outranks the serial pin (SFN-547)" {
    let child_env = _pool_child_env(["SAILFIN_BUILD_JOBS=4"], "/tmp/s", "/tmp/o", "", false, false, "/build/bin/sfn");
    let mut pins: int = 0;
    let mut kept: boolean = false;
    let mut i: int = 0;
    loop {
        if i >= child_env.length { break; }
        if child_env[i] == "SAILFIN_BUILD_JOBS=1" { pins += 1; }
        if child_env[i] == "SAILFIN_BUILD_JOBS=4" { kept = true; }
        i += 1;
    }
    assert kept;
    assert pins == 0;
}
