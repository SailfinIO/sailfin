// Unit coverage for the unified diagnostic leaf module (SFN-534).
import {
    Diag,
    Span,
    diag_from_typecheck,
    diag_is_error,
    stamp_spans
} from "sfn/analyzer/diagnostic";
import {
    diag_from_legacy_lowering_error,
    diag_to_legacy_string,
    lowering_error_diag,
    stamp_lowering_diag_spans
} from "sfn/codegen-llvm/utils";
import { LoweringDiagnostic, NativeSourceSpan } from "sfn/ir";

fn _diag(severity: string, span: Span?) -> Diag {
    return Diag {
        code: "E1003",
        severity: severity,
        message: "unable to lower expression",
        file_path: "sample.sfn",
        span: span,
        stage: "lowering",
        suggestion: null
    };
}

fn _lowering_diag(severity: string, span: NativeSourceSpan?) -> LoweringDiagnostic {
    return LoweringDiagnostic {
        code: "E1003",
        severity: severity,
        message: "unable to lower expression",
        file_path: "sample.sfn",
        span: span,
        stage: "lowering"
    };
}

test "diag_from_typecheck converts token coordinates to a span" {
    let diag = diag_from_typecheck("E0001", "error", "unknown name", "sample.sfn", 3, 7, 4, true, "typecheck", null);
    assert diag.span != null;
    let span: Span? = diag.span;
    assert span.start_line == 3;
    assert span.start_column == 7;
    assert span.end_line == 3;
    assert span.end_column == 11;
}

test "diag_from_typecheck preserves an unknown location" {
    let diag = diag_from_typecheck("E0001", "error", "unknown name", "sample.sfn", 0, 0, 0, false, "typecheck", null);
    assert diag.span == null;
}

test "diag_is_error checks structured severity" {
    assert diag_is_error(_diag("error", null));
    assert ! diag_is_error(_diag("warning", null));
    assert ! diag_is_error(_diag("note", null));
}

test "stamp_spans fills only missing spans" {
    let existing = Span {
        start_line: 1,
        start_column: 2,
        end_line: 1,
        end_column: 3
    };
    let fallback = Span {
        start_line: 8,
        start_column: 4,
        end_line: 8,
        end_column: 9
    };
    let mut diags: Diag[] = [];
    diags.push(_diag("note", null));
    diags.push(_diag("error", existing));
    let stamped = stamp_spans(diags, fallback);
    let first: Span? = stamped[0].span;
    let second: Span? = stamped[1].span;
    assert first.start_line == 8;
    assert first.end_column == 9;
    assert second.start_line == 1;
    assert second.end_column == 3;
}

test "lowering diagnostics: stamp_lowering_diag_spans fills only missing spans" {
    let existing = NativeSourceSpan {
        start_line: 1,
        start_column: 2,
        end_line: 1,
        end_column: 3
    };
    let fallback = NativeSourceSpan {
        start_line: 8,
        start_column: 4,
        end_line: 8,
        end_column: 9
    };
    let mut diags: LoweringDiagnostic[] = [];
    diags.push(_lowering_diag("note", null));
    diags.push(_lowering_diag("error", existing));
    let stamped = stamp_lowering_diag_spans(diags, fallback);
    let first: NativeSourceSpan? = stamped[0].span;
    let second: NativeSourceSpan? = stamped[1].span;
    assert first.start_line == 8;
    assert first.end_column == 9;
    assert second.start_line == 1;
    assert second.end_column == 3;

    let mut unchanged: LoweringDiagnostic[] = [];
    unchanged.push(_lowering_diag("note", null));
    unchanged.push(_lowering_diag("error", existing));
    let untouched = stamp_lowering_diag_spans(unchanged, null);
    assert untouched[0].span == null;
    let untouched_second: NativeSourceSpan? = untouched[1].span;
    assert untouched_second.start_line == 1;
    assert untouched_second.end_column == 3;
}

test "diag_to_legacy_string preserves lowering spelling" {
    assert diag_to_legacy_string(_lowering_diag("error", null)) == "llvm lowering [fatal] [E1003]: unable to lower expression";
    assert diag_to_legacy_string(_lowering_diag("note", null)) == "llvm lowering: unable to lower expression";
}

test "lowering diagnostic preserves native IR source coordinates" {
    let span = NativeSourceSpan {
        start_line: 4,
        start_column: 6,
        end_line: 4,
        end_column: 12
    };
    let diag = lowering_error_diag("E1003", "unable to lower expression", span);
    assert diag.span != null;
    assert diag.span.start_line == 4;
    assert diag.span.end_column == 12;
}

test "legacy lowering conversion preserves an allocated code" {
    let diag = diag_from_legacy_lowering_error("llvm lowering [fatal] [E0806]: unsupported atomic operation");
    assert diag != null;
    assert diag.code == "E0806";
    assert diag.message == "unsupported atomic operation";
    assert diag.stage == "lowering";
}

test "legacy lowering conversion normalizes interpolation code spelling" {
    let diag = diag_from_legacy_lowering_error("llvm lowering [fatal]: E0832: interpolation operand is not stringifiable");
    assert diag != null;
    assert diag.code == "E0832";
    assert diag.message == "interpolation operand is not stringifiable";
}

test "legacy lowering conversion allocates call failures to E1007" {
    let diag = diag_from_legacy_lowering_error("llvm lowering [fatal]: unable to emit call to unresolved callee");
    assert diag != null;
    assert diag.code == "E1007";
    assert diag.message == "unable to emit call to unresolved callee";
}

test "legacy lowering conversion uses E1006 for an uncategorized invariant" {
    let diag = diag_from_legacy_lowering_error("llvm lowering [fatal]: unexpected backend invariant");
    assert diag != null;
    assert diag.code == "E1006";
}

test "legacy lowering conversion ignores non-fatal output" {
    assert diag_from_legacy_lowering_error("llvm lowering: advisory") == null;
}
