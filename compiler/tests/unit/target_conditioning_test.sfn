// compiler/tests/unit/target_conditioning_test.sfn
//
// Regression guard for the M6 build-target conditioning (SFN-52,
// SFEP-0021 §4.2(A)): the driver must invoke clang/linker for the MSVC
// Windows target (triple `x86_64-pc-windows-msvc`, `-fuse-ld=lld`, no
// POSIX/OpenSSL link libs) while leaving the Linux/macOS clang argv and
// link inputs byte-identical (#1112 zero-behaviour gate).
//
// These are pure assertions over the target-conditioning helpers
// (`build/target.sfn`) plus the clang-argv builders that consume them, so
// the Windows leg is exercised on any host without a real Windows link —
// the same override-driven pattern the emit-time locator tests use
// (`errno_locator_test.sfn`), and the argv-shape pattern of
// `backend_link_libs_parity_test.sfn`.
import { lower_to_llvm_ir_from_text_with_provider_context } from "sfn/codegen-llvm/lowering/entrypoints";
import {
    LLVMProviderContext,
    build_target_os,
    skip_module_globals,
    target_arch_for_lowering,
    target_setjmp_call_line,
    target_setjmp_declare,
    target_setjmp_symbol,
    test_runner_active,
    test_runner_trace,
    trace_call_lowering,
    trace_lowering
} from "sfn/codegen-llvm/lowering_debug_state";
import { contains } from "sfn/strings";
import { expect_eq_bool, expect_eq_str, expect_eq_str_array } from "sfn/test";

import { LinkPlan, _llvm_text_link_program_argv, _llvm_text_link_test_argv } from "../../src/backend";
import { _llvm_text_assemble_argv } from "../../src/build/clang_argv";
import { emit_child_argv } from "../../src/build/emit_child_argv";
import { empty_llvm_import_context, resolve_llvm_provider_context } from "../../src/build/llvm_provider_context";
import {
    build_host_os,
    build_target_triple,
    host_exe_name,
    target_artifact_tag,
    target_clang_flags,
    target_clang_triple,
    target_condition_runtime_sfn_sources,
    target_exe_name,
    target_extra_link_libs,
    target_filter_link_libs,
    target_forced_linker_flag,
    target_os_is_windows,
    target_reproducible_link_flag,
    target_uses_gnu_link_gc,
    triple_abi,
    triple_artifact_tags,
    triple_is_supported,
    triple_target_arch,
    triple_target_os
} from "../../src/build/target";
import { active_build_target, clear_build_target, set_build_target } from "../../src/build/target_state";

// Membership check over an emitted argv (`string[]`).
fn _argv_contains(argv: string[], needle: string) -> boolean ![pure] {
    let mut i: int = 0;
    loop {
        if i >= argv.length { break; }
        if argv[i] == needle { return true; }
        i += 1;
    }
    return false;
}

// An LLVM entrypoint must replace the complete primitive snapshot on every
// invocation. This guards in-process compiler/test runs from inheriting a
// previous target, debug toggle, or test-runner state.
test "target: provider entrypoint overwrites its complete context" ![io] {
    let first = LLVMProviderContext {
        target_os: "Darwin",
        target_arch: "aarch64",
        trace_lowering: false,
        trace_call_lowering: false,
        skip_module_globals: false,
        test_runner_active: false,
        test_runner_trace: false
    };
    let _first_ir = lower_to_llvm_ir_from_text_with_provider_context("", "provider_context_first", empty_llvm_import_context(), first);
    assert expect_eq_str(build_target_os(), "Darwin").ok;
    assert expect_eq_str(target_arch_for_lowering(), "aarch64").ok;
    assert expect_eq_bool(trace_lowering(), false).ok;
    assert expect_eq_bool(trace_call_lowering(), false).ok;
    assert expect_eq_bool(skip_module_globals(), false).ok;
    assert expect_eq_bool(test_runner_active(), false).ok;
    assert expect_eq_bool(test_runner_trace(), false).ok;

    let second = LLVMProviderContext {
        target_os: "Windows",
        target_arch: "x86_64",
        trace_lowering: true,
        trace_call_lowering: true,
        skip_module_globals: true,
        test_runner_active: true,
        test_runner_trace: true
    };
    let _second_ir = lower_to_llvm_ir_from_text_with_provider_context("", "provider_context_second", empty_llvm_import_context(), second);
    assert expect_eq_str(build_target_os(), "Windows").ok;
    assert expect_eq_str(target_arch_for_lowering(), "x86_64").ok;
    assert expect_eq_bool(trace_lowering(), true).ok;
    assert expect_eq_bool(trace_call_lowering(), true).ok;
    assert expect_eq_bool(skip_module_globals(), true).ok;
    assert expect_eq_bool(test_runner_active(), true).ok;
    assert expect_eq_bool(test_runner_trace(), true).ok;
}

// ---- Target OS classification ----
test "target: only Windows is classified as the MSVC target" ![pure] {
    assert expect_eq_bool(target_os_is_windows("Windows"), true).ok;
    assert expect_eq_bool(target_os_is_windows("Linux"), false).ok;
    assert expect_eq_bool(target_os_is_windows("Darwin"), false).ok;
}

// ---- The triple axis (SFN-774 / SFEP-0068 §3.1) ----
test "target: the closed triple set is supported, everything else is rejected" ![pure] {
    assert expect_eq_bool(triple_is_supported("x86_64-unknown-linux-gnu"), true).ok;
    assert expect_eq_bool(triple_is_supported("aarch64-unknown-linux-gnu"), true).ok;
    assert expect_eq_bool(triple_is_supported("x86_64-apple-darwin"), true).ok;
    assert expect_eq_bool(triple_is_supported("arm64-apple-darwin"), true).ok;
    assert expect_eq_bool(triple_is_supported("x86_64-pc-windows-msvc"), true).ok;
    assert expect_eq_bool(triple_is_supported("x86_64-w64-mingw32"), true).ok;
    assert expect_eq_bool(triple_is_supported("x86_64-unknown-linux-musl"), false).ok;
    assert expect_eq_bool(triple_is_supported(""), false).ok;
}

test "target: triple_target_os decomposes both Windows triples to Windows" ![pure] {
    assert expect_eq_str(triple_target_os("x86_64-unknown-linux-gnu"), "Linux").ok;
    assert expect_eq_str(triple_target_os("aarch64-unknown-linux-gnu"), "Linux").ok;
    assert expect_eq_str(triple_target_os("x86_64-apple-darwin"), "Darwin").ok;
    assert expect_eq_str(triple_target_os("arm64-apple-darwin"), "Darwin").ok;
    assert expect_eq_str(triple_target_os("x86_64-pc-windows-msvc"), "Windows").ok;
    assert expect_eq_str(triple_target_os("x86_64-w64-mingw32"), "Windows").ok;
    assert expect_eq_str(triple_target_os("unknown-triple"), "").ok;
}

test "target: triple_abi distinguishes the two Windows ABIs" ![pure] {
    assert expect_eq_str(triple_abi("x86_64-pc-windows-msvc"), "msvc").ok;
    assert expect_eq_str(triple_abi("x86_64-w64-mingw32"), "gnu").ok;
    assert expect_eq_str(triple_abi("x86_64-unknown-linux-gnu"), "gnu").ok;
    assert expect_eq_str(triple_abi("x86_64-apple-darwin"), "mach").ok;
    assert expect_eq_str(triple_abi("unknown-triple"), "").ok;
}

// ---- clang -target triple ----
test "target: host targets add no -target triple" ![pure] {
    // Every non-Windows triple keeps clang's host default → empty triple,
    // empty flags, so no `-target` flag is ever added (byte-identical argv).
    assert expect_eq_str(target_clang_triple("x86_64-unknown-linux-gnu"), "").ok;
    assert expect_eq_str(target_clang_triple("aarch64-unknown-linux-gnu"), "").ok;
    assert expect_eq_str(target_clang_triple("x86_64-apple-darwin"), "").ok;
    assert expect_eq_str(target_clang_triple("arm64-apple-darwin"), "").ok;
    let empty: string[] = [];
    assert expect_eq_str_array(target_clang_flags("x86_64-unknown-linux-gnu"), empty).ok;
    assert expect_eq_str_array(target_clang_flags("x86_64-apple-darwin"), empty).ok;
}

test "target: both Windows triples pass their own triple to clang" ![pure] {
    assert expect_eq_str(target_clang_triple("x86_64-pc-windows-msvc"), "x86_64-pc-windows-msvc").ok;
    let expected_msvc: string[] = ["-target", "x86_64-pc-windows-msvc"];
    assert expect_eq_str_array(target_clang_flags("x86_64-pc-windows-msvc"), expected_msvc).ok;
    assert expect_eq_str(target_clang_triple("x86_64-w64-mingw32"), "x86_64-w64-mingw32").ok;
    let expected_gnu: string[] = ["-target", "x86_64-w64-mingw32"];
    assert expect_eq_str_array(target_clang_flags("x86_64-w64-mingw32"), expected_gnu).ok;
}

// ---- Linker selection ----
test "target: msvc forces lld, host targets and windows-gnu do not" ![pure] {
    assert expect_eq_str(target_forced_linker_flag("x86_64-pc-windows-msvc"), "-fuse-ld=lld").ok;
    // A2 (SFN-775) fills the windows-gnu driver in; this slice's contract
    // is only that it does not falsely inherit the msvc flag.
    assert expect_eq_str(target_forced_linker_flag("x86_64-w64-mingw32"), "").ok;
    assert expect_eq_str(target_forced_linker_flag("x86_64-unknown-linux-gnu"), "").ok;
    assert expect_eq_str(target_forced_linker_flag("x86_64-apple-darwin"), "").ok;
}

test "target: msvc requests /Brepro, host targets and windows-gnu do not" ![pure] {
    assert expect_eq_str(target_reproducible_link_flag("x86_64-pc-windows-msvc"), "-Wl,/Brepro").ok;
    assert expect_eq_str(target_reproducible_link_flag("x86_64-w64-mingw32"), "").ok;
    assert expect_eq_str(target_reproducible_link_flag("x86_64-unknown-linux-gnu"), "").ok;
    assert expect_eq_str(target_reproducible_link_flag("x86_64-apple-darwin"), "").ok;
    assert expect_eq_str(target_reproducible_link_flag("arm64-apple-darwin"), "").ok;
}

test "target: GNU section-GC flags are skipped only for msvc" ![pure] {
    // lld-link rejects `-Wl,--gc-sections` / `-Wl,-u,<sym>`; the driver
    // must skip them for the msvc ABI and keep them everywhere else,
    // including windows-gnu (mingw's GNU-family linker accepts them).
    assert expect_eq_bool(target_uses_gnu_link_gc("x86_64-unknown-linux-gnu"), true).ok;
    assert expect_eq_bool(target_uses_gnu_link_gc("x86_64-apple-darwin"), true).ok;
    assert expect_eq_bool(target_uses_gnu_link_gc("x86_64-w64-mingw32"), true).ok;
    assert expect_eq_bool(target_uses_gnu_link_gc("x86_64-pc-windows-msvc"), false).ok;
}

// ---- Link-lib filtering ----
test "target: host link libs pass through unchanged" ![pure] {
    let libs: string[] = ["-lm", "-lpthread"];
    // Identity on Linux/macOS → the POSIX libs are preserved.
    assert expect_eq_str_array(target_filter_link_libs(libs, "x86_64-unknown-linux-gnu"), libs).ok;
    assert expect_eq_str_array(target_filter_link_libs(libs, "x86_64-apple-darwin"), libs).ok;
}

test "target: msvc drops POSIX link libs, keeps others" ![pure] {
    let libs: string[] = ["-L/some/dir", "-lm", "-lpthread", "-lcustom"];
    // MSVC/UCRT auto-links its CRT. Non-lib flags (`-L…`) and unrelated
    // libs survive.
    let expected: string[] = ["-L/some/dir", "-lcustom"];
    assert expect_eq_str_array(target_filter_link_libs(libs, "x86_64-pc-windows-msvc"), expected).ok;
}

test "target: windows-gnu keeps -lm/-lpthread, unlike msvc" ![pure] {
    // mingw-w64's CRT is POSIX-compatible, so windows-gnu keeps the POSIX
    // libs msvc drops (SFEP-0068 §3.1) — identity, same as a host target.
    let libs: string[] = ["-L/some/dir", "-lm", "-lpthread", "-lcustom"];
    assert expect_eq_str_array(target_filter_link_libs(libs, "x86_64-w64-mingw32"), libs).ok;
}

// ---- Runtime module-set conditioning ----
test "target: host runtime module set is unchanged" ![pure] {
    let sources: string[] = ["/rt/sfn/runtime_globals.sfn", "/rt/sfn/process.sfn", "/rt/sfn/platform/rlimit.sfn", "/rt/sfn/io.sfn"];
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Linux"), sources).ok;
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Darwin"), sources).ok;
}

test "target: Windows swaps process.sfn, rlimit.sfn, rand.sfn, fs_exec_mode.sfn, and cert_roots.sfn to their Win32 siblings, leaves tls.sfn unconditioned, and appends the six anchor-less siblings" ![pure] {
    // SFN-549: rlimit.sfn used to be DROPPED here (a no-op stub in
    // windows_stubs.ll resolved apply_default_mem_limit for the mingw
    // bridge only); the native MSVC path no longer links that stub, so
    // rlimit.sfn now swaps to its own Win32 sibling instead of vanishing.
    // terminal.sfn swaps to terminal_windows.sfn (`isatty` -> `_isatty`).
    // rand.sfn swaps the same way (BCryptGenRandom in place of
    // getentropy/`/dev/urandom`). tls.sfn is no longer swapped (SFN-341
    // deleted the OpenSSL link surface, so there is no OpenSSL-backed
    // module left to replace). process.sfn → its existing Win32 sibling.
    // fs_exec_mode.sfn swaps to fs_exec_mode_windows.sfn: POSIX X_OK (1)
    // is not a legal UCRT `_access` mode, and passing it terminates the
    // process via `_invalid_parameter_noinfo` -> `__fastfail` (0xC0000409)
    // rather than returning an error, so the sibling supplies F_OK
    // (SFN-649). cert_roots.sfn swaps to cert_roots_windows.sfn: Windows
    // has no CA-bundle file anywhere, so the system `ROOT` certificate
    // store reached through Crypt32 is the only trust source there
    // (SFN-808). The eight anchor-less siblings (realpath_windows.sfn,
    // clock_windows.sfn, pthread_windows.sfn, popen_windows.sfn,
    // mkstemp_windows.sfn, strcasestr_windows.sfn, opendir_windows.sfn,
    // mkdtemp_windows.sfn) have no POSIX .sfn
    // counterpart to swap FROM (each backs a bare libc/pthreads symbol,
    // not a Sailfin module), so they are APPENDED at the end rather than
    // replacing a matched basename. Every other module is preserved in
    // order.
    let sources: string[] = ["/rt/sfn/runtime_globals.sfn", "/rt/sfn/process.sfn", "/rt/sfn/platform/rlimit.sfn", "/rt/sfn/platform/terminal.sfn", "/rt/sfn/platform/rand.sfn", "/rt/sfn/platform/tls.sfn", "/rt/sfn/platform/fs_exec_mode.sfn", "/rt/sfn/platform/cert_roots.sfn", "/rt/sfn/io.sfn",];
    let expected: string[] = ["/rt/sfn/runtime_globals.sfn", "/rt/sfn/platform/process_windows.sfn", "/rt/sfn/platform/rlimit_windows.sfn", "/rt/sfn/platform/terminal_windows.sfn", "/rt/sfn/platform/rand_windows.sfn", "/rt/sfn/platform/tls.sfn", "/rt/sfn/platform/fs_exec_mode_windows.sfn", "/rt/sfn/platform/cert_roots_windows.sfn", "/rt/sfn/io.sfn", "/rt/sfn/platform/realpath_windows.sfn", "/rt/sfn/platform/clock_windows.sfn", "/rt/sfn/platform/pthread_windows.sfn", "/rt/sfn/platform/popen_windows.sfn", "/rt/sfn/platform/mkstemp_windows.sfn", "/rt/sfn/platform/strcasestr_windows.sfn", "/rt/sfn/platform/opendir_windows.sfn", "/rt/sfn/platform/mkdtemp_windows.sfn",];
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Windows"), expected).ok;
}

test "target: Windows conditioning never double-joins platform/platform" ![pure] {
    // rlimit.sfn/rand.sfn/tls.sfn already live in platform/, so their
    // siblings must join directly onto that same directory rather than
    // appending a second platform/ segment; process.sfn does NOT live in
    // platform/, so it alone gets the platform/ prefix. This double-join
    // bug was caught pre-ship once already (SFN-549) — assert no emitted
    // path, swapped or appended, ever contains platform/platform.
    let sources: string[] = ["/rt/sfn/process.sfn", "/rt/sfn/platform/rlimit.sfn", "/rt/sfn/platform/rand.sfn", "/rt/sfn/platform/tls.sfn"];
    let out = target_condition_runtime_sfn_sources(sources, "Windows");
    let mut i: int = 0;
    loop {
        if i >= out.length { break; }
        assert expect_eq_bool(contains(out[i], "platform/platform"), false).ok;
        i += 1;
    }
}

test "target: Windows append anchors on exec.sfn when rlimit.sfn/rand.sfn/tls.sfn are absent" ![pure] {
    // The append doesn't require rlimit.sfn/rand.sfn/tls.sfn specifically —
    // any of the four platform/ modules anchors it, exec.sfn included.
    let sources: string[] = ["/rt/sfn/runtime_globals.sfn", "/rt/sfn/platform/exec.sfn", "/rt/sfn/io.sfn"];
    let expected: string[] = ["/rt/sfn/runtime_globals.sfn", "/rt/sfn/platform/exec.sfn", "/rt/sfn/io.sfn", "/rt/sfn/platform/realpath_windows.sfn", "/rt/sfn/platform/clock_windows.sfn", "/rt/sfn/platform/pthread_windows.sfn", "/rt/sfn/platform/popen_windows.sfn", "/rt/sfn/platform/mkstemp_windows.sfn", "/rt/sfn/platform/strcasestr_windows.sfn", "/rt/sfn/platform/opendir_windows.sfn", "/rt/sfn/platform/mkdtemp_windows.sfn",];
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Windows"), expected).ok;
}

test "target: Windows skips the anchor-less appends with no platform/ anchor present" ![pure] {
    // No rlimit.sfn / rand.sfn / tls.sfn / exec.sfn in this fixture, so
    // there is nothing to anchor the appends on — the function does not
    // guess a path, it just leaves the list as swapped (unchanged here,
    // since nothing else matches either).
    let sources: string[] = ["/rt/sfn/runtime_globals.sfn", "/rt/sfn/io.sfn"];
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Windows"), sources).ok;
}

test "target: extra link libs — msvc needs bcrypt, crypt32, and ws2_32; windows-gnu needs crypt32 and ws2_32" ![pure] {
    // `-lbcrypt` backs BCryptGenRandom in platform/rand_windows.sfn
    // (SFN-549) — msvc-only, since windows-gnu resolves it through its
    // own mingw-w64 import libs. `-lcrypt32` backs
    // CertOpenSystemStoreA/CertEnumCertificatesInStore/
    // CertFreeCertificateContext/CertCloseStore in
    // platform/cert_roots_windows.sfn (SFN-808) — required on BOTH
    // Windows ABIs, unlike bcrypt, because crypt32 is not in mingw-w64's
    // default auto-linked import-lib set. `-lws2_32` backs the 11 socket
    // symbols the net and websocket adapters declare as bare externs —
    // free from libc on POSIX, exported from ws2_32.dll on BOTH Windows
    // ABIs (SFN-649). ws2_32 and crypt32 are required even for a program
    // that opens no socket and loads no certificate: COFF resolves every
    // external reference before dead-stripping, and those runtime
    // modules are always linked. Every host target keeps the
    // identity/empty result (#1112).
    let expected_msvc: string[] = ["-lbcrypt", "-lcrypt32", "-lws2_32"];
    assert expect_eq_str_array(target_extra_link_libs("x86_64-pc-windows-msvc"), expected_msvc).ok;
    let expected_gnu: string[] = ["-lcrypt32", "-lws2_32"];
    assert expect_eq_str_array(target_extra_link_libs("x86_64-w64-mingw32"), expected_gnu).ok;
    let none: string[] = [];
    assert expect_eq_str_array(target_extra_link_libs("x86_64-unknown-linux-gnu"), none).ok;
    assert expect_eq_str_array(target_extra_link_libs("x86_64-apple-darwin"), none).ok;
}

test "target: Windows fs_exec_mode swap survives without the other platform anchors" ![pure] {
    // fs_exec_mode.sfn is itself a platform/ anchor, so the swap must
    // work (and the anchor-less appends must still fire) even when
    // rlimit/rand/tls/exec are all absent. Guards against the swap being
    // reachable only via another module's anchor discovery — the same
    // class of coupling the exec.sfn anchor test above pins.
    let sources: string[] = ["/rt/sfn/platform/fs_exec_mode.sfn"];
    let out = target_condition_runtime_sfn_sources(sources, "Windows");
    assert expect_eq_str(out[0], "/rt/sfn/platform/fs_exec_mode_windows.sfn").ok;
    assert expect_eq_bool(out.length > 1, true).ok;
}

test "target: Windows socket_ops swap survives without the other platform anchors" ![pure] {
    // socket_ops.sfn is itself a platform/ anchor, so the swap must fire
    // with rlimit/rand/tls/exec all absent — same coupling guard as the
    // fs_exec_mode test above (SFN-671).
    let sources: string[] = ["/rt/sfn/platform/socket_ops.sfn"];
    let out = target_condition_runtime_sfn_sources(sources, "Windows");
    assert expect_eq_str(out[0], "/rt/sfn/platform/socket_ops_windows.sfn").ok;
    assert expect_eq_bool(out.length > 1, true).ok;
}

test "target: Windows cert_roots swap survives without the other platform anchors" ![pure] {
    // cert_roots.sfn is itself a platform/ anchor, so the swap must fire
    // with rlimit/rand/tls/exec all absent — same coupling guard as the
    // fs_exec_mode test above (SFN-808).
    let sources: string[] = ["/rt/sfn/platform/cert_roots.sfn"];
    let out = target_condition_runtime_sfn_sources(sources, "Windows");
    assert expect_eq_str(out[0], "/rt/sfn/platform/cert_roots_windows.sfn").ok;
    assert expect_eq_bool(out.length > 1, true).ok;
}

test "target: host targets keep the POSIX close/socket module" ![pure] {
    // The identity contract (#1112). This one is load-bearing beyond
    // byte-identity: swapping socket_ops_windows.sfn in for every target
    // would route POSIX disposal through `closesocket`, which does not
    // exist outside ws2_32, and would call `WSAStartup` on Linux. Windows
    // is the exception here, not the default (SFN-671).
    let sources: string[] = ["/rt/sfn/platform/socket_ops.sfn", "/rt/sfn/io.sfn"];
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Linux"), sources).ok;
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Darwin"), sources).ok;
}

test "target: Windows rename_ops swap survives without the other platform anchors" ![pure] {
    // rename_ops.sfn is itself a platform/ anchor, so the swap must fire
    // with rlimit/rand/tls/exec all absent — same coupling guard as the
    // fs_exec_mode test above (SFN-720).
    let sources: string[] = ["/rt/sfn/platform/rename_ops.sfn"];
    let out = target_condition_runtime_sfn_sources(sources, "Windows");
    assert expect_eq_str(out[0], "/rt/sfn/platform/rename_ops_windows.sfn").ok;
    assert expect_eq_bool(out.length > 1, true).ok;
}

test "target: host targets keep the POSIX rename module" ![pure] {
    // The identity contract (#1112), and load-bearing beyond byte-identity:
    // swapping rename_ops_windows.sfn in for every target would route POSIX
    // publishes through MoveFileExA, which does not exist outside kernel32.
    // Windows is the exception, not the default (SFN-720).
    let sources: string[] = ["/rt/sfn/platform/rename_ops.sfn", "/rt/sfn/io.sfn"];
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Linux"), sources).ok;
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Darwin"), sources).ok;
}

test "target: host targets keep the POSIX X_OK fs_exec_mode module" ![pure] {
    // The identity contract (#1112): Linux and macOS DO have an execute
    // permission bit, so they must keep platform/fs_exec_mode.sfn and its
    // X_OK. Swapping in F_OK for every target would "fix" Windows by
    // silently downgrading the executable check to a mere existence
    // check on the two platforms where it is meaningful (SFN-649).
    let sources: string[] = ["/rt/sfn/platform/fs_exec_mode.sfn", "/rt/sfn/io.sfn"];
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Linux"), sources).ok;
    assert expect_eq_str_array(target_condition_runtime_sfn_sources(sources, "Darwin"), sources).ok;
}

// ---- Assemble argv splicing ----
test "target: assemble argv is byte-identical with no target flags" ![pure] {
    // The host path passes [] and must reproduce the pre-conditioning argv
    // exactly (#1112).
    let no_target: string[] = [];
    let no_includes: string[] = [];
    let argv = _llvm_text_assemble_argv("in.ll", "out.o", "-O2", no_includes, no_target);
    let expected: string[] = ["clang", "-O2", "-Wno-override-module", "-ffunction-sections", "-fdata-sections", "-c", "in.ll", "-o", "out.o"];
    assert expect_eq_str_array(argv, expected).ok;
}

test "target: assemble argv splices -target after the opt flag" ![pure] {
    let target: string[] = ["-target", "x86_64-pc-windows-msvc"];
    let includes: string[] = ["-Iinc"];
    let argv = _llvm_text_assemble_argv("in.ll", "out.o", "-O2", includes, target);
    let expected: string[] = ["clang", "-O2", "-target", "x86_64-pc-windows-msvc", "-Wno-override-module", "-ffunction-sections", "-fdata-sections", "-Iinc", "-c", "in.ll", "-o", "out.o"];
    assert expect_eq_str_array(argv, expected).ok;
}

// ---- Link argv carries the -target driver flag ----
fn _driver_plan(test_mode: boolean) -> LinkPlan ![pure] {
    return LinkPlan {
        objects: ["runtime.o", "main.o"],
        out_path: "a.exe",
        opt_flag: "-O2",
        link_flags: [],
        libs: [],
        test_mode: test_mode
    };
}

test "target: program link argv carries -target when the driver flags do" ![pure] {
    // `LlvmTextBackend.link` prefixes `target_clang_flags(triple)` onto
    // the driver-flag slice both layouts splice after `-Wno-override-module`.
    let driver_flags: string[] = ["-target", "x86_64-pc-windows-msvc"];
    let argv = _llvm_text_link_program_argv(_driver_plan(false), driver_flags);
    assert expect_eq_bool(_argv_contains(argv, "-target"), true).ok;
    assert expect_eq_bool(_argv_contains(argv, "x86_64-pc-windows-msvc"), true).ok;
}

test "target: test link argv carries -target when the driver flags do" ![pure] {
    let driver_flags: string[] = ["-target", "x86_64-pc-windows-msvc"];
    let argv = _llvm_text_link_test_argv(_driver_plan(true), driver_flags);
    assert expect_eq_bool(_argv_contains(argv, "-target"), true).ok;
    assert expect_eq_bool(_argv_contains(argv, "x86_64-pc-windows-msvc"), true).ok;
}

// Sanity: the host driver-flag slice ([]) adds no -target to either layout.
test "target: host link argv carries no -target flag" ![pure] {
    let no_driver: string[] = [];
    let program_argv = _llvm_text_link_program_argv(_driver_plan(false), no_driver);
    let test_argv = _llvm_text_link_test_argv(_driver_plan(true), no_driver);
    assert expect_eq_bool(_argv_contains(program_argv, "-target"), false).ok;
    assert expect_eq_bool(_argv_contains(test_argv, "-target"), false).ok;
}

// ---- SFN-617 / SFN-774: the artifact tag that keys cached objects by target ----
test "target: artifact tag maps each triple in the closed set to a distinct token" ![pure] {
    assert expect_eq_str(target_artifact_tag("x86_64-unknown-linux-gnu"), "linux-x86_64").ok;
    assert expect_eq_str(target_artifact_tag("aarch64-unknown-linux-gnu"), "linux-aarch64").ok;
    assert expect_eq_str(target_artifact_tag("x86_64-apple-darwin"), "darwin-x86_64").ok;
    assert expect_eq_str(target_artifact_tag("arm64-apple-darwin"), "darwin-arm64").ok;
    assert expect_eq_str(target_artifact_tag("x86_64-pc-windows-msvc"), "windows-msvc").ok;
    assert expect_eq_str(target_artifact_tag("x86_64-w64-mingw32"), "windows-gnu").ok;
}

// SFEP-0068 §3.6, the non-optional half: before the triple axis, both
// Windows triples shared the single `"windows"` tag and could overwrite
// each other's cached runtime objects on disk. They must now be distinct
// so an msvc build and a mingw build never cross-link.
test "target: msvc and windows-gnu artifact tags are distinct" ![pure] {
    assert expect_eq_bool(target_artifact_tag("x86_64-pc-windows-msvc") == target_artifact_tag("x86_64-w64-mingw32"), false).ok;
}

// SFN-774 H1 drift guard: `clean_runtime_object_cache`'s `--clean` sweep
// (`build/runtime_objs.sfn`) now iterates `triple_artifact_tags()` rather
// than a hand-maintained literal, so every tag `target_artifact_tag` can
// actually produce for a supported triple must appear in that list — the
// exact drift that let `--clean` silently stop sweeping runtime objects
// once `target_artifact_tag` grew the `linux-x86_64`/`linux-aarch64`/
// `darwin-x86_64`/`darwin-arm64`/`windows-msvc`/`windows-gnu` tags.
test "target: every supported triple's artifact tag is in triple_artifact_tags" ![pure] {
    let triples: string[] = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin", "arm64-apple-darwin", "x86_64-pc-windows-msvc", "x86_64-w64-mingw32"];
    let tags = triple_artifact_tags();
    let mut i: int = 0;
    loop {
        if i >= triples.length { break; }
        let tag = target_artifact_tag(triples[i]);
        let mut found: boolean = false;
        let mut ti: int = 0;
        loop {
            if ti >= tags.length { break; }
            if tags[ti] == tag { found = true; }
            ti += 1;
        }
        assert expect_eq_bool(found, true).ok;
        i += 1;
    }
}

// An unrecognized target collapses to a single bucket on purpose. The
// cache key carries the RAW triple, so two unknown targets that share
// this tag still mismatch on key and recompile — the tag only has to be
// path-safe and stable, never injective.
test "target: artifact tag collapses an unrecognized target to other" ![pure] {
    assert expect_eq_str(target_artifact_tag("Plan9"), "other").ok;
    assert expect_eq_str(target_artifact_tag(""), "other").ok;
}

// The tag is interpolated into a filesystem path, and a resolved triple
// may originate from unvalidated environment input, so a hostile value
// must never reach the path. The closed mapping is the guard: anything
// unrecognized — including traversal and separator attempts — becomes
// `other`.
test "target: artifact tag never yields a path separator or traversal" ![pure] {
    assert expect_eq_str(target_artifact_tag("../../etc/passwd"), "other").ok;
    assert expect_eq_str(target_artifact_tag("a/b"), "other").ok;
    assert expect_eq_str(target_artifact_tag("a\\b"), "other").ok;
    assert expect_eq_bool(contains(target_artifact_tag("x86_64-unknown-linux-gnu"), "/"), false).ok;
    assert expect_eq_bool(contains(target_artifact_tag("x86_64-pc-windows-msvc"), ".."), false).ok;
}

// ---- SFN-647: the exception save point's per-target spelling ----
//
// Windows x64 has no one-argument `setjmp`: the UCRT header maps
// `setjmp(buf)` onto `_setjmp(buf, frame)`, and `longjmp` reads that second
// argument back out of `_JUMP_BUFFER.Frame` to choose between a plain
// register restore and a full `RtlUnwindEx` SEH unwind. Emitting the POSIX
// one-argument call left the frame register holding garbage, so the first
// `throw` in a natively-built program died before any catch block ran —
// `try-catch-finally.sfn` exited 40 having printed nothing.
test "target: the save point is _setjmp on Windows and setjmp elsewhere" ![pure] {
    assert expect_eq_str(target_setjmp_symbol("Windows"), "_setjmp").ok;
    assert expect_eq_str(target_setjmp_symbol("Linux"), "setjmp").ok;
    assert expect_eq_str(target_setjmp_symbol("Darwin"), "setjmp").ok;
}

// An unrecognized target must read as non-Windows here exactly as it does
// everywhere else — `target_os_is_windows` is an exact match, so a typo in
// `SAILFIN_TARGET_OS` keeps the POSIX save point rather than emitting a
// two-argument call libc would not resolve.
test "target: an unrecognized target keeps the POSIX save point" ![pure] {
    assert expect_eq_str(target_setjmp_symbol("Plan9"), "setjmp").ok;
    assert expect_eq_str(target_setjmp_symbol(""), "setjmp").ok;
}

// The declaration must agree with the call's arity, or LLVM rejects the
// module. Both halves are derived from the same `target_os` so they cannot
// drift apart.
test "target: the save-point declaration matches the call arity" ![pure] {
    assert expect_eq_str(target_setjmp_declare("Windows"), "declare i32 @_setjmp(i8*, i8*)").ok;
    assert expect_eq_str(target_setjmp_declare("Linux"), "declare i32 @setjmp(i8*)").ok;
}

// The Windows call passes a NULL frame. That is the load-bearing detail:
// a zero `_JUMP_BUFFER.Frame` is what selects longjmp's non-unwinding
// path, which is the one Sailfin's exception model wants (`sfn_throw`
// longjmps straight to the matching save point, with no SEH handlers to
// run on the way out).
test "target: the Windows save-point call passes a null frame" ![pure] {
    assert expect_eq_str(target_setjmp_call_line("Windows", "%sj", "%jmpbuf_i8"), "  %sj = call i32 @_setjmp(i8* %jmpbuf_i8, i8* null)").ok;
}

// Non-Windows emission is byte-identical to the pre-SFN-647 line, so the
// Linux/macOS IR does not move (#1112 zero-behaviour gate).
test "target: the POSIX save-point call is unchanged" ![pure] {
    assert expect_eq_str(target_setjmp_call_line("Linux", "%sj", "%jmpbuf_i8"), "  %sj = call i32 @setjmp(i8* %jmpbuf_i8)").ok;
    assert expect_eq_str(target_setjmp_call_line("Darwin", "%sj.r0", "%jmpbuf.i8"), "  %sj.r0 = call i32 @setjmp(i8* %jmpbuf.i8)").ok;
}

// ---- SFN-693: the .exe suffix on compiler-derived Windows executables ----
//
// `CreateProcessA` (`runtime/sfn/platform/process_windows.sfn`) is called
// with `lpApplicationName = null`, so Win32 derives the module name from
// the command line and appends `.exe` only when the parsed name has no
// extension of its own — an extensionless PE this compiler produces is
// otherwise unlaunchable. This applies only to names the compiler itself
// derives; an explicit `-o` is never touched.
test "target: Windows appends .exe to a derived name" ![pure] {
    assert expect_eq_str(target_exe_name("build/sailfin/program", "Windows"), "build/sailfin/program.exe").ok;
}

test "target: host targets leave the derived name unchanged" ![pure] {
    assert expect_eq_str(target_exe_name("build/sailfin/program", "Linux"), "build/sailfin/program").ok;
    assert expect_eq_str(target_exe_name("build/sailfin/program", "Darwin"), "build/sailfin/program").ok;
}

// An unrecognized `target_os` (e.g. `_package_target_os`'s fallback for a
// target string outside its closed set, `compiler/src/cli/commands/
// package.sfn`) must leave the name unchanged rather than defaulting to
// the Windows branch.
test "target: an unrecognized target_os leaves the derived name unchanged" ![pure] {
    assert expect_eq_str(target_exe_name("sfn", ""), "sfn").ok;
}

test "target: an already-.exe name is not doubled" ![pure] {
    assert expect_eq_str(target_exe_name("build/sailfin/program.exe", "Windows"), "build/sailfin/program.exe").ok;
}

test "target: a dot elsewhere in the name still gets .exe on Windows" ![pure] {
    assert expect_eq_str(target_exe_name("build/sailfin/my.app", "Windows"), "build/sailfin/my.app.exe").ok;
}

// ---- SFN-701: host_exe_name, the host-side sibling of target_exe_name ----
//
// `target_exe_name` names what a build EMITS for its target;
// `host_exe_name` names a binary THIS machine must execute (the
// installed compiler, a self-host stage's own output). Regression guard
// that adding `host_exe_name` did not perturb `target_exe_name` itself.
test "target: target_exe_name is unchanged for the Windows/Linux pair" ![pure] {
    assert expect_eq_str(target_exe_name("build/bin/sfn", "Windows"), "build/bin/sfn.exe").ok;
    assert expect_eq_str(target_exe_name("build/bin/sfn", "Linux"), "build/bin/sfn").ok;
}

// `host_exe_name` reads the real host (`![io]`), so its answer is
// host-dependent and must never be asserted directly (the exact defect
// fixed in the SFN-693 e2e test). Assert only the invariant that holds on
// every host: it is `target_exe_name` gated on `build_host_os()`, and it
// is idempotent.
test "target: host_exe_name matches target_exe_name(x, build_host_os())" ![io] {
    let host = build_host_os();
    assert expect_eq_str(host_exe_name("build/bin/sfn"), target_exe_name("build/bin/sfn", host)).ok;
    assert expect_eq_str(host_exe_name("build/bin/sfn-seedcheck"), target_exe_name("build/bin/sfn-seedcheck", host)).ok;
}

test "target: host_exe_name is idempotent" ![io] {
    let once = host_exe_name("build/bin/sfn");
    assert expect_eq_str(host_exe_name(once), once).ok;
}

// ---- SFN-774 / SFEP-0068 §3.2: the `--target` process cell ----
//
// `set_build_target`/`clear_build_target`/`active_build_target` mirror
// `test_runner_state.sfn`'s lifecycle contract; `build_target_triple`
// checks the cell FIRST, ahead of every env/host fallback, so an explicit
// `--target` always wins for the running invocation regardless of what
// `SAILFIN_TARGET_TRIPLE`/`SAILFIN_TARGET_OS` (if any) say.
test "target: the cell starts clear and set/clear round-trips" ![io] {
    assert expect_eq_str(active_build_target(), "").ok;
    set_build_target("x86_64-w64-mingw32");
    assert expect_eq_str(active_build_target(), "x86_64-w64-mingw32").ok;
    clear_build_target();
    assert expect_eq_str(active_build_target(), "").ok;
}

test "target: build_target_triple honors the active cell over any fallback" ![io] {
    set_build_target("x86_64-pc-windows-msvc");
    assert expect_eq_str(build_target_triple(), "x86_64-pc-windows-msvc").ok;
    clear_build_target();
}

test "target: clear_build_target is idempotent" ![io] {
    clear_build_target();
    clear_build_target();
    assert expect_eq_str(active_build_target(), "").ok;
}

// ---- SFN-923: the arch axis (`triple_target_arch`, `_resolve_llvm_target_arch`) ----
test "target: triple_target_arch resolves each triple in the closed set" ![pure] {
    assert expect_eq_str(triple_target_arch("x86_64-unknown-linux-gnu"), "x86_64").ok;
    assert expect_eq_str(triple_target_arch("aarch64-unknown-linux-gnu"), "aarch64").ok;
    assert expect_eq_str(triple_target_arch("x86_64-apple-darwin"), "x86_64").ok;
    assert expect_eq_str(triple_target_arch("arm64-apple-darwin"), "aarch64").ok;
    assert expect_eq_str(triple_target_arch("x86_64-pc-windows-msvc"), "x86_64").ok;
    assert expect_eq_str(triple_target_arch("x86_64-w64-mingw32"), "x86_64").ok;
}

test "target: triple_target_arch is empty for an unrecognized triple" ![pure] {
    assert expect_eq_str(triple_target_arch("bogus-triple"), "").ok;
}

// The SFN-923 defect, pinned: `_resolve_llvm_target_arch`
// (`build/llvm_provider_context.sfn`) previously probed only the HOST,
// ignoring the resolved TARGET triple entirely — so `--target=aarch64-
// unknown-linux-gnu` on an x86_64 host baked `x86_64` codegen into the
// LLVM provider context regardless. With the cell set to an aarch64
// triple, the resolved `target_arch` must be `aarch64` even though this
// test host is x86_64.
test "target: resolve_llvm_provider_context derives target_arch from an explicit --target, not the host" ![io] {
    set_build_target("aarch64-unknown-linux-gnu");
    let ctx = resolve_llvm_provider_context();
    assert expect_eq_str(ctx.target_arch, "aarch64").ok;
    clear_build_target();
}

// ---- SFN-923 (review A1): the PARENT half — `emit_child_argv` itself ----
//
// The e2e coverage in `cross_target_emit_test.sfn` drives `sfn emit
// --target=…` directly, which only pins the CHILD-side wiring (the flag
// parses, `set_build_target` seeds the cell, the comdat gate flips). It
// exercises nothing about whether a build's per-module emit spawners
// (`native_emit_subprocess.sfn`, `emit_helpers.sfn`,
// `capsule_emit_parallel.sfn`, `cli/commands/bench.sfn`) actually call
// through `emit_child_argv` to REACH that flag. This test pins the other
// half directly: the constructor itself must append `--target` and the
// resolved triple to the complete argv it builds, for every caller shape
// (with and without an import-context root).
test "emit_child_argv: the full argv carries --target and the resolved triple" ![io] {
    set_build_target("x86_64-pc-windows-msvc");
    let argv = emit_child_argv("sailfin", "mymod", "out.ll", "llvm", "in.sfn", "");
    assert expect_eq_bool(_argv_contains(argv, "--target"), true).ok;
    assert expect_eq_bool(_argv_contains(argv, "x86_64-pc-windows-msvc"), true).ok;
    clear_build_target();
}

test "emit_child_argv: --target is still carried when an import-context root is present" ![io] {
    set_build_target("aarch64-unknown-linux-gnu");
    let argv = emit_child_argv("sailfin", "mymod", "out.ll", "native", "in.sfn", "/tmp/import-ctx");
    assert expect_eq_bool(_argv_contains(argv, "--target"), true).ok;
    assert expect_eq_bool(_argv_contains(argv, "aarch64-unknown-linux-gnu"), true).ok;
    assert expect_eq_bool(_argv_contains(argv, "--import-context"), true).ok;
    clear_build_target();
}

// No explicit `--target` (the common host-build path): `emit_child_argv`
// still appends the flag unconditionally, carrying whatever
// `build_target_triple()` resolves absent the cell — same-host builds are
// unaffected because that is exactly what the child would have probed for
// itself (design note §8).
test "emit_child_argv: --target is appended even with no active cell" ![io] {
    clear_build_target();
    let argv = emit_child_argv("sailfin", "mymod", "out.ll", "llvm", "in.sfn", "");
    assert expect_eq_bool(_argv_contains(argv, "--target"), true).ok;
}
