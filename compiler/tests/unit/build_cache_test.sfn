// Unit tests for `compiler/src/build_cache.sfn`.
//
// The cache module is the foundation for incremental builds in
// Stage C of `docs/proposals/0006-build-architecture.md`. PR1 ships
// the module parse-only / unwired; these tests gate the
// invariants the wiring (PR1b) will rely on:
//
//   - Cache keys are deterministic — identical inputs (source
//     bytes, dep manifest contents, compiler version, flags)
//     always produce the same digest, regardless of how the
//     dep list is ordered.
//   - Cache keys are sensitive — any input change produces a
//     different digest, so a stale cache can never satisfy a
//     build that has actually drifted.
//   - The on-disk layout is sharded (`<root>/<key[0..2]>/<key>/`)
//     and versioned (`build/cache/v1/...`) so future schema
//     changes can coexist with existing entries.
//   - `cache_store` + `cache_lookup_complete` round-trip
//     successfully against a fresh tmp directory.
//
// Tests parameterize the cache root explicitly (passing a tmp
// directory rather than relying on `$SAILFIN_BUILD_CACHE_DIR`)
// because Sailfin's runtime has no `setenv` primitive — the env
// var contract is intentionally read-only. Each test cleans up
// its tmp tree on exit.
import { remove_all } from "sfn/fs";
import { find } from "sfn/strings";
import { expect_eq_bool, expect_eq_str, scratch_root } from "sfn/test";

import {
    BuildCacheConfig,
    CacheKey,
    CacheStats,
    build_cache_schema_version,
    cache_artifact_path,
    cache_clean,
    cache_compiler_identity,
    cache_copy_artifact_to,
    cache_key_for,
    cache_lookup_artifact,
    cache_lookup_complete,
    cache_paths_for,
    cache_root_from,
    cache_root_with_override,
    cache_stats_is_empty,
    cache_store,
    cache_store_artifact,
    canonicalize_flags,
    empty_build_cache_config,
    empty_cache_stats,
    is_compiler_selfhost_capsule,
    is_valid_digest,
    merge_cache_stats,
    runtime_link_inputs_identity,
    runtime_object_entry_key_from_str,
    test_bin_cache_key,
    test_bin_cache_root_with_override,
    test_bin_cache_schema_version,
    test_bin_compiler_identity
} from "../../src/build_cache";
import { _strip_build_metadata } from "../../src/version";

fn _has_stage_residue(dir: string) -> bool ![io] {
    let entries = fs.listDirectory(dir);
    let mut i = 0;
    loop {
        if i >= entries.length { break; }
        if find(entries[i], "sfn_stage", 0) >= 0 { return true; }
        i += 1;
    }
    return false;
}

// --------------------------------------------------------------
// Fixture helpers
// --------------------------------------------------------------
// Each test block gets its own tmp namespace under the portable
// scratch root (SFN-978); `mkdtemp` mints a unique directory per
// call so parallel test runs never collide.
fn _test_tmp_root(label: string) -> string ![io] {
    let base = scratch_root();
    fs.createDirectory(base, true);
    return fs.mkdtemp(base + "/sfn_build_cache_test_" + label + "_");
}

fn _cleanup(path: string) ![io] { remove_all(path); }

fn _write_file(path: string, content: string) ![io] {
    fs.writeFile(path, content);
}

// --------------------------------------------------------------
// Schema version
// --------------------------------------------------------------
test "build_cache: schema version is v2" {
    assert build_cache_schema_version() == "v2";
}

test "build_cache: cache_root_with_override empty -> in-tree default" {
    assert cache_root_with_override("") == "build/cache/v2";
}

test "build_cache: cache_root_with_override non-empty -> override + version" {
    assert cache_root_with_override("/tmp/sfn-shared-cache") == "/tmp/sfn-shared-cache/v2";
}

// Cache-root ladder (SFEP-0040 §3.1). Pure inputs so precedence is
// verified without any process-global env mutation.
test "build_cache: cache_root_from explicit override wins over all" {
    // Explicit ($SAILFIN_BUILD_CACHE_DIR) beats even the self-host
    // pin, so CI can redirect the compiler's own cache.
    assert cache_root_from("/ci/cache", true, "/cfg", "/xdg", "/home/dev") == "/ci/cache/v2";
    assert cache_root_from("/ci/cache", false, "/cfg", "/xdg", "/home/dev") == "/ci/cache/v2";
}

test "build_cache: cache_root_from self-host pins in-tree over XDG/HOME" {
    assert cache_root_from("", true, "/cfg", "/xdg", "/home/dev") == "build/cache/v2";
}

test "build_cache: scoped compiler identity selects the self-host cache" {
    assert is_compiler_selfhost_capsule("sfn/compiler");
    assert ! is_compiler_selfhost_capsule("sailfin");
    assert ! is_compiler_selfhost_capsule("sfn/codegen");
}

test "build_cache: cache_root_from XDG_CACHE_HOME beats HOME" {
    assert cache_root_from("", false, "", "/xdg", "/home/dev") == "/xdg/sailfin/v2";
}

test "build_cache: cache_root_from HOME is the global default" {
    assert cache_root_from("", false, "", "", "/home/dev") == "/home/dev/.cache/sailfin/v2";
}

test "build_cache: cache_root_from all-empty falls back in-tree" {
    // Hermetic fallback when $HOME is unresolvable (containers, CI).
    assert cache_root_from("", false, "", "", "") == "build/cache/v2";
}

// --------------------------------------------------------------
// Path layout
// --------------------------------------------------------------
test "build_cache: artifact paths shard by 2-char prefix" {
    let key = CacheKey { digest: "abcdef0123456789" };
    let root = "build/cache/v1";
    assert cache_artifact_path(root, key, "sfn-asm") == "build/cache/v1/ab/abcdef0123456789/ir.sfn-asm";
    assert cache_artifact_path(root, key, "layout-manifest") == "build/cache/v1/ab/abcdef0123456789/layout.manifest";
    assert cache_artifact_path(root, key, "ll") == "build/cache/v1/ab/abcdef0123456789/mod.ll";
    assert cache_artifact_path(root, key, "obj") == "build/cache/v1/ab/abcdef0123456789/mod.o";
}

test "build_cache: unknown artifact kind returns empty filename" {
    let key = CacheKey { digest: "abcdef0123456789" };
    let path = cache_artifact_path("build/cache/v1", key, "this-kind-does-not-exist");
    // Sentinel form: `…/abcdef0123456789/` (filename is "").
    assert path == "build/cache/v1/ab/abcdef0123456789/";
}

test "build_cache: cache_paths_for returns all four artifact slots" {
    let key = CacheKey { digest: "deadbeef" };
    let paths = cache_paths_for("build/cache/v1", key);
    assert paths.sfn_asm == "build/cache/v1/de/deadbeef/ir.sfn-asm";
    assert paths.layout_manifest == "build/cache/v1/de/deadbeef/layout.manifest";
    assert paths.ll == "build/cache/v1/de/deadbeef/mod.ll";
    assert paths.obj == "build/cache/v1/de/deadbeef/mod.o";
}

// --------------------------------------------------------------
// Flag canonicalization
// --------------------------------------------------------------
test "build_cache: canonicalize_flags empty list is empty JSON array" {
    let empty: string[] = [];
    assert canonicalize_flags(empty) == "[]";
}

test "build_cache: canonicalize_flags single flag" {
    assert canonicalize_flags(["--release"]) == "[\"--release\"]";
}

test "build_cache: canonicalize_flags sorts entries" {
    let a = canonicalize_flags(["-O2", "--release"]);
    let b = canonicalize_flags(["--release", "-O2"]);
    // Sort order means both inputs produce the same output.
    assert a == b;
    // And the entries are in lexicographic order regardless of
    // input order.
    assert a == "[\"--release\",\"-O2\"]";
}

test "build_cache: canonicalize_flags escapes embedded quotes and backslashes" {
    let escaped = canonicalize_flags(["a\"b", "c\\d"]);
    // Sorted: ["a\"b", "c\\d"] → ["a\\\"b","c\\\\d"]
    assert escaped == "[\"a\\\"b\",\"c\\\\d\"]";
}

// --------------------------------------------------------------
// Key derivation — determinism
// --------------------------------------------------------------
test "build_cache: cache_key_for same inputs -> same digest" ![io] {
    let scratch = _test_tmp_root("key_determinism");
    let src = scratch + "/source.sfn";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    let no_deps: string[] = [];
    let no_dep_slugs: string[] = [];
    let key1 = cache_key_for(src, no_dep_slugs, no_deps, "0.5.10-alpha.2", "[]", "key_determinism", "Linux");
    let key2 = cache_key_for(src, no_dep_slugs, no_deps, "0.5.10-alpha.2", "[]", "key_determinism", "Linux");
    assert key1.digest == key2.digest;
    assert key1.digest.length == 64;
    _cleanup(scratch);
}

test "build_cache: cache_key_for invariant under dep order" ![io] {
    let scratch = _test_tmp_root("dep_order");
    let src = scratch + "/source.sfn";
    let dep_a = scratch + "/dep_a.layout-manifest";
    let dep_b = scratch + "/dep_b.layout-manifest";
    let dep_c = scratch + "/dep_c.layout-manifest";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    _write_file(dep_a, "module: alpha; layout: ...");
    _write_file(dep_b, "module: beta; layout: ...");
    _write_file(dep_c, "module: gamma; layout: ...");
    // Slug is held constant — it's a digest input (schema v2), so the
    // invariant under test is dep *order*, not slug. The tmp suffix
    // collision concern only applies to concurrent workers; these
    // calls run sequentially.
    //
    // `dep_slugs` is permuted in lock-step with the manifest array so
    // the test asserts order-invariance of the (slug, manifest) PAIR,
    // not accidental insensitivity to slug (SFN-661).
    let key_abc = cache_key_for(src, ["alpha", "beta", "gamma"], [dep_a, dep_b, dep_c], "0.5.10-alpha.2", "[]", "dep_order", "Linux");
    let key_cba = cache_key_for(src, ["gamma", "beta", "alpha"], [dep_c, dep_b, dep_a], "0.5.10-alpha.2", "[]", "dep_order", "Linux");
    let key_bac = cache_key_for(src, ["beta", "alpha", "gamma"], [dep_b, dep_a, dep_c], "0.5.10-alpha.2", "[]", "dep_order", "Linux");
    assert key_abc.digest == key_cba.digest;
    assert key_abc.digest == key_bac.digest;
    _cleanup(scratch);
}

// --------------------------------------------------------------
// Key derivation — sensitivity
// --------------------------------------------------------------
test "build_cache: cache_key_for changes when source changes" ![io] {
    let scratch = _test_tmp_root("source_sensitive");
    let src = scratch + "/source.sfn";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    let no_deps: string[] = [];
    let no_dep_slugs: string[] = [];
    let key1 = cache_key_for(src, no_dep_slugs, no_deps, "0.5.10-alpha.2", "[]", "source_sens_1", "Linux");
    _write_file(src, "fn hello() -> string { return \"WORLD\"; }");
    let key2 = cache_key_for(src, no_dep_slugs, no_deps, "0.5.10-alpha.2", "[]", "source_sens_2", "Linux");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

test "build_cache: cache_key_for changes when dep manifest changes" ![io] {
    let scratch = _test_tmp_root("dep_sensitive");
    let src = scratch + "/source.sfn";
    let dep = scratch + "/dep.layout-manifest";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    _write_file(dep, "module: alpha; layout: original");
    let key1 = cache_key_for(src, ["alpha"], [dep], "0.5.10-alpha.2", "[]", "dep_sens_1", "Linux");
    _write_file(dep, "module: alpha; layout: changed");
    let key2 = cache_key_for(src, ["alpha"], [dep], "0.5.10-alpha.2", "[]", "dep_sens_2", "Linux");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

// SFN-661: a module split (e.g. `parser/declarations.sfn` ->
// `parser/declarations/mod.sfn`) can leave a dependency's
// `.layout-manifest` content BYTE-IDENTICAL (a module declaring no
// structs emits an empty manifest) while its provider slug changes —
// and the provider slug is what determines call-site name mangling
// (`parse_function__parser__declarations` vs
// `parse_function__parser__declarations__mod`). Until SFN-661 mixed the
// DEP slug into the key, this left a dependent's cache key unchanged
// across the split, serving stale IR that referenced the old mangled
// symbol and failing the link with undefined references.
//
// Distinct from #527, which mixed the module's OWN slug in and bumped
// the schema to v2. SFN-661 adds the dep slug and bumps nothing — it
// only makes keys more distinguishing, so old entries age out unread.
test "build_cache: cache_key_for changes when a dep slug changes" ![io] {
    let scratch = _test_tmp_root("dep_slug_sensitive");
    let src = scratch + "/source.sfn";
    let dep = scratch + "/dep.layout-manifest";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    // Empty manifest content — the real-world case for a module
    // declaring no structs.
    _write_file(dep, "");
    let key1 = cache_key_for(src, ["parser/declarations"], [dep], "0.5.10-alpha.2", "[]", "dep_slug_sens", "Linux");
    let key2 = cache_key_for(src, ["parser/declarations/mod"], [dep], "0.5.10-alpha.2", "[]", "dep_slug_sens", "Linux");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

test "build_cache: cache_key_for is stable when dep slug and content are unchanged" ![io] {
    let scratch = _test_tmp_root("dep_slug_stable");
    let src = scratch + "/source.sfn";
    let dep = scratch + "/dep.layout-manifest";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    _write_file(dep, "");
    let key1 = cache_key_for(src, ["parser/declarations"], [dep], "0.5.10-alpha.2", "[]", "dep_slug_stable", "Linux");
    let key2 = cache_key_for(src, ["parser/declarations"], [dep], "0.5.10-alpha.2", "[]", "dep_slug_stable", "Linux");
    assert key1.digest == key2.digest;
    _cleanup(scratch);
}

// `dep_slugs` and `dep_layout_manifest_paths` must be parallel arrays.
// On a length mismatch `cache_key_for` returns an empty digest rather
// than pairing them up best-effort: an empty digest is rejected by
// `_is_valid_digest`, so every cache helper treats it as a hard miss
// (recompile) instead of serving a key derived from a bogus pairing —
// which would reconstruct the exact collision SFN-661 fixes.
test "build_cache: cache_key_for yields an empty digest on a dep-slug/manifest length mismatch" ![io] {
    let scratch = _test_tmp_root("dep_len_mismatch");
    let src = scratch + "/source.sfn";
    let dep_a = scratch + "/dep_a.layout-manifest";
    let dep_b = scratch + "/dep_b.layout-manifest";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    _write_file(dep_a, "module: alpha; layout: ...");
    _write_file(dep_b, "module: beta; layout: ...");

    // dep_slugs shorter than the manifest array.
    let short_key = cache_key_for(src, ["alpha"], [dep_a, dep_b], "0.5.10-alpha.2", "[]", "dep_len_short", "Linux");
    assert short_key.digest.length == 0;
    assert short_key.digest.length != 64;

    // dep_slugs longer than the manifest array.
    let long_key = cache_key_for(src, ["alpha", "beta", "gamma"], [dep_a, dep_b], "0.5.10-alpha.2", "[]", "dep_len_long", "Linux");
    assert long_key.digest.length == 0;
    assert long_key.digest.length != 64;

    _cleanup(scratch);
}

// Control: the guard must not swallow the normal equal-length path.
test "build_cache: cache_key_for matching lengths still yield a valid digest" ![io] {
    let scratch = _test_tmp_root("dep_len_match");
    let src = scratch + "/source.sfn";
    let dep_a = scratch + "/dep_a.layout-manifest";
    let dep_b = scratch + "/dep_b.layout-manifest";
    _write_file(src, "fn hello() -> string { return \"world\"; }");
    _write_file(dep_a, "module: alpha; layout: ...");
    _write_file(dep_b, "module: beta; layout: ...");
    let key = cache_key_for(src, ["alpha", "beta"], [dep_a, dep_b], "0.5.10-alpha.2", "[]", "dep_len_match", "Linux");
    assert key.digest.length == 64;
    _cleanup(scratch);
}

// --------------------------------------------------------------
// Per-test binary cache (#1230)
// --------------------------------------------------------------
test "build_cache: test_bin cache schema + root layout" ![io] {
    assert test_bin_cache_schema_version() == "v4";
    // In-tree default sits beside (not under) the module cache's
    // `<base>/v<N>` tree so the two schema lines age out independently.
    assert test_bin_cache_root_with_override("") == "build/cache/test-bin/v4";
    assert test_bin_cache_root_with_override("/shared/cache") == "/shared/cache/test-bin/v4";
}

test "build_cache: test_bin_cache_key same inputs -> same digest" ![io] {
    let scratch = _test_tmp_root("tbk_determinism");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let native_texts: string[] = ["sfn-asm: helper"];
    let key1 = test_bin_cache_key(test_src, [dep_ll], native_texts, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_det", "x86_64-unknown-linux-gnu");
    let key2 = test_bin_cache_key(test_src, [dep_ll], native_texts, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_det", "x86_64-unknown-linux-gnu");
    assert key1.digest == key2.digest;
    assert key1.digest.length == 64;
    _cleanup(scratch);
}

test "build_cache: test_bin_cache_key changes when a dep .ll hash changes" ![io] {
    let scratch = _test_tmp_root("tbk_dep_ll");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    let native_texts: string[] = ["sfn-asm: helper"];
    _write_file(dep_ll, "; ModuleID = 'dep'\ndefine i64 @f() { ret i64 1 }");
    let key1 = test_bin_cache_key(test_src, [dep_ll], native_texts, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_dll_1", "x86_64-unknown-linux-gnu");
    // A changed transitive dep → changed hash → changed key → cache
    // miss. This is the correctness hinge: a stale binary can never be
    // served after a dep edit (acceptance criterion: misses for exactly
    // the transitive importers of an edited compiler/src file).
    _write_file(dep_ll, "; ModuleID = 'dep'\ndefine i64 @f() { ret i64 2 }");
    let key2 = test_bin_cache_key(test_src, [dep_ll], native_texts, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_dll_2", "x86_64-unknown-linux-gnu");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

test "build_cache: test_bin_cache_key changes when a native_text dep changes" ![io] {
    let scratch = _test_tmp_root("tbk_native");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let key1 = test_bin_cache_key(test_src, [dep_ll], ["sfn-asm: original"], "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_nt_1", "x86_64-unknown-linux-gnu");
    let key2 = test_bin_cache_key(test_src, [dep_ll], ["sfn-asm: changed"], "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_nt_2", "x86_64-unknown-linux-gnu");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

test "build_cache: test_bin_cache_key invariant under dep_ll order" ![io] {
    let scratch = _test_tmp_root("tbk_order");
    let test_src = scratch + "/foo_test.sfn";
    let dep_a = scratch + "/a.ll";
    let dep_b = scratch + "/b.ll";
    let dep_c = scratch + "/c.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_a, "; alpha");
    _write_file(dep_b, "; beta");
    _write_file(dep_c, "; gamma");
    let nt: string[] = [];
    let key_abc = test_bin_cache_key(test_src, [dep_a, dep_b, dep_c], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_ord", "x86_64-unknown-linux-gnu");
    let key_cba = test_bin_cache_key(test_src, [dep_c, dep_b, dep_a], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_ord", "x86_64-unknown-linux-gnu");
    assert key_abc.digest == key_cba.digest;
    _cleanup(scratch);
}

test "build_cache: test_bin_cache_key changes when test source changes" ![io] {
    let scratch = _test_tmp_root("tbk_src");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    let key1 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_src_1", "x86_64-unknown-linux-gnu");
    _write_file(test_src, "test \"x\" { assert 2 == 2; }");
    let key2 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_src_2", "x86_64-unknown-linux-gnu");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

test "build_cache: test_bin_cache_key changes when compiler identity changes" ![io] {
    let scratch = _test_tmp_root("tbk_ident");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    let bin_a = _identity_tmp("test_bin_a", "fake-compiler-bytes-A\n");
    let bin_b = _identity_tmp("test_bin_b", "fake-compiler-bytes-B\n");
    let identity_a = test_bin_compiler_identity("0.7.0", bin_a);
    let identity_b = test_bin_compiler_identity("0.7.0", bin_b);
    // Same capsule version, different compiler bytes: the exact
    // cross-compiler poisoning shape from SFN-545 must miss.
    assert identity_a != identity_b;
    let key1 = test_bin_cache_key(test_src, [dep_ll], nt, identity_a, "rt0", "[\"-O0\"]", "", "", "tbk_id_1", "x86_64-unknown-linux-gnu");
    let key2 = test_bin_cache_key(test_src, [dep_ll], nt, identity_b, "rt0", "[\"-O0\"]", "", "", "tbk_id_2", "x86_64-unknown-linux-gnu");
    assert key1.digest != key2.digest;
    remove_all(bin_a);
    remove_all(bin_b);
    _cleanup(scratch);
}

test "build_cache: test-bin compiler identity is content-addressed" ![io] {
    let bin_a = _identity_tmp("test_bin_stable_a", "same-compiler-bytes\n");
    let bin_b = _identity_tmp("test_bin_stable_b", "same-compiler-bytes\n");
    assert test_bin_compiler_identity("0.7.0", bin_a) == test_bin_compiler_identity("0.7.0", bin_b);
    remove_all(bin_a);
    remove_all(bin_b);
}

test "build_cache: test-bin compiler identity fails closed" ![io] {
    assert test_bin_compiler_identity("", "/tmp/sfn_unused_test_bin_compiler") == "";
    assert test_bin_compiler_identity("0.7.0", "") == "";
}

// The version component stays commit-stable; the full identity adds the
// compiler binary hash in `test_bin_compiler_identity` (SFN-545).
test "version: _strip_build_metadata collapses +dev.<hash> stamps" {
    assert _strip_build_metadata("0.7.0-alpha.28+dev.f944726") == "0.7.0-alpha.28";
    assert _strip_build_metadata("0.7.0-alpha.28+dev.f944726.dirty") == "0.7.0-alpha.28";
    assert _strip_build_metadata("0.7.0-alpha.28+bin.abcdef0") == "0.7.0-alpha.28";
    // No build metadata → unchanged (a tagged release stamp).
    assert _strip_build_metadata("0.7.0-alpha.28") == "0.7.0-alpha.28";
    assert _strip_build_metadata("") == "";
    // Two different commits at the same version collapse to one identity.
    assert _strip_build_metadata("0.7.0-alpha.28+dev.aaaaaaa") == _strip_build_metadata("0.7.0-alpha.28+dev.bbbbbbb");
}

test "build_cache: test_bin_cache_key changes when runtime identity changes" ![io] {
    let scratch = _test_tmp_root("tbk_rtid");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    // A runtime edit changes the folded runtime identity → busts the key
    // (this is what replaces the former per-commit-stamp backstop).
    let key1 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt-aaa", "[\"-O0\"]", "", "", "tbk_rt_1", "x86_64-unknown-linux-gnu");
    let key2 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt-bbb", "[\"-O0\"]", "", "", "tbk_rt_2", "x86_64-unknown-linux-gnu");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

// SFN-676: a cross-target `sfn test` invocation must never serve a
// binary linked for a different OS/triple. Every other input held
// fixed, only `target_triple` differs.
test "build_cache: test_bin_cache_key changes when target triple changes" ![io] {
    let scratch = _test_tmp_root("tbk_target");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    let key1 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_tgt_1", "x86_64-unknown-linux-gnu");
    let key2 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_tgt_2", "x86_64-pc-windows-msvc");
    assert key1.digest != key2.digest;
    _cleanup(scratch);
}

// SFN-1199: the active `-k`/`--tag` selection is a key input. The filter cut
// runs upstream of emit, so a filtered link produces a binary holding only
// the surviving tests; a filtered and an unfiltered run of identical source
// must therefore never share a key. Every other input is held fixed in each
// case below so only the filter pair can move the digest.
test "build_cache: test_bin_cache_key changes when a name filter is active" ![io] {
    let scratch = _test_tmp_root("tbk_filter_name");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    let unfiltered = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "", "tbk_flt_u", "x86_64-unknown-linux-gnu");
    let filtered = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "alpha", "", "tbk_flt_f", "x86_64-unknown-linux-gnu");
    assert unfiltered.digest != filtered.digest;
    _cleanup(scratch);
}

test "build_cache: test_bin_cache_key separates two different name filters" ![io] {
    let scratch = _test_tmp_root("tbk_filter_two");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    let key_a = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "alpha", "", "tbk_flt_a", "x86_64-unknown-linux-gnu");
    let key_b = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "beta", "", "tbk_flt_b", "x86_64-unknown-linux-gnu");
    assert key_a.digest != key_b.digest;
    _cleanup(scratch);
}

test "build_cache: test_bin_cache_key separates the name and tag filter axes" ![io] {
    let scratch = _test_tmp_root("tbk_filter_axes");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    // `-k slow` selects by test name, `--tag slow` by decorator: same string,
    // different selection, so the two must not alias.
    let by_name = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "slow", "", "tbk_flt_n", "x86_64-unknown-linux-gnu");
    let by_tag = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "", "slow", "tbk_flt_t", "x86_64-unknown-linux-gnu");
    assert by_name.digest != by_tag.digest;
    // The pair is self-delimiting: a split moved across the axis boundary is
    // a different key, so ("ab", "c") cannot alias ("a", "bc").
    let split_1 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "ab", "c", "tbk_flt_s1", "x86_64-unknown-linux-gnu");
    let split_2 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "a", "bc", "tbk_flt_s2", "x86_64-unknown-linux-gnu");
    assert split_1.digest != split_2.digest;
    _cleanup(scratch);
}

// The common path must not regress: two runs sharing one filter state — the
// unfiltered case above all, which is every `sfn test <path>` — still agree.
test "build_cache: test_bin_cache_key is stable for a repeated filter" ![io] {
    let scratch = _test_tmp_root("tbk_filter_stable");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    let key1 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "alpha", "slow", "tbk_flt_r1", "x86_64-unknown-linux-gnu");
    let key2 = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "alpha", "slow", "tbk_flt_r2", "x86_64-unknown-linux-gnu");
    assert key1.digest == key2.digest;
    _cleanup(scratch);
}

// A filter carrying the fold's own separators must not absorb the field that
// follows it. Folding the axes by value would let this selector alias a
// different (filter, target) tuple; each axis folds as a fixed-width digest
// precisely so it cannot.
test "build_cache: test_bin_cache_key resists a separator-bearing filter" ![io] {
    let scratch = _test_tmp_root("tbk_filter_sep");
    let test_src = scratch + "/foo_test.sfn";
    let dep_ll = scratch + "/dep.ll";
    _write_file(test_src, "test \"x\" { assert 1 == 1; }");
    _write_file(dep_ll, "; ModuleID = 'dep'");
    let nt: string[] = [];
    let crafted = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "a\ntgt1:x86_64-pc-windows-msvc", "", "tbk_flt_sep1", "x86_64-unknown-linux-gnu");
    let plain = test_bin_cache_key(test_src, [dep_ll], nt, "0.7.0", "rt0", "[\"-O0\"]", "a", "", "tbk_flt_sep2", "x86_64-pc-windows-msvc");
    assert crafted.digest != plain.digest;
    _cleanup(scratch);
}

test "build_cache: runtime_link_inputs_identity is content-addressed + order-invariant" ![io] {
    let scratch = _test_tmp_root("rtid");
    let a = scratch + "/a.c";
    let b = scratch + "/b.ll";
    let c = scratch + "/prelude.sfn";
    _write_file(a, "int a(void){return 1;}");
    _write_file(b, "; beta");
    _write_file(c, "fn p() {}");
    let libs: string[] = ["-lm", "-lpthread"];
    // Same inputs → same digest; invariant under source-path order.
    let id_abc = runtime_link_inputs_identity([a, b, c], libs, "rtid_1");
    let id_cba = runtime_link_inputs_identity([c, b, a], libs, "rtid_2");
    assert id_abc == id_cba;
    assert id_abc.length == 64;
    // Editing one source's bytes → different digest (runtime edit busts).
    _write_file(b, "; beta-changed");
    let id_edited = runtime_link_inputs_identity([a, b, c], libs, "rtid_3");
    assert id_edited != id_abc;
    // A changed value input (link lib / include dir) → different digest.
    _write_file(b, "; beta");
    let id_more_libs = runtime_link_inputs_identity([a, b, c], ["-lm", "-lpthread", "-lfoo"], "rtid_4");
    assert id_more_libs != id_abc;
    // Each source folds in as `<path>@<hash>`, so two DIFFERENT unreadable
    // paths (both empty digest) do NOT alias to the same identity.
    let no_libs: string[] = [];
    let id_missing_x = runtime_link_inputs_identity([scratch + "/nope-x.h"], no_libs, "rtid_5");
    let id_missing_y = runtime_link_inputs_identity([scratch + "/nope-y.h"], no_libs, "rtid_6");
    assert id_missing_x != id_missing_y;
    _cleanup(scratch);
}

