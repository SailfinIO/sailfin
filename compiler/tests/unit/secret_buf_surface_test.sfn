// Surface tests for the dormant, internal `SecretBuf` runtime
// (`runtime/sfn/memory/secretbuf.sfn`, SFN-783, design SFEP-0069
// §§3.2 and 3.5). `SecretBuf` is module-private and not importable by
// safe source — SFN-790 is the atomic activation slice — so these
// tests pin the trusted-runtime layout and lowered shape directly
// against the real file, the same strategy
// `owned_buf_surface_test.sfn` uses for `OwnedBuf`.
//
// Strategy:
//   - Struct layout via `emit_native_text_with_module_name` over an
//     inline fixture matching the SFEP-0069 §3.2 declaration verbatim.
//   - `define` surface over the real `secretbuf.sfn` read via
//     `fs.readFile`, asserting the seven public function signatures.
//   - Wipe-path IR shape: a `secure_zero` call composed inside
//     `_secret_buf_wipe`/`secret_buf_zeroize` lowers to the volatile
//     byte-store loop `secure_zero.sfn` documents (ONE lowering call
//     for the whole file, matching the suite's per-process memory
//     budget discipline noted in `owned_buf_surface_test.sfn` and
//     `secure_zero_lowering_test.sfn`).
import { parse_program } from "sfn/syntax";

import { empty_llvm_import_context, resolve_llvm_provider_context } from "../../src/build/llvm_provider_context";
import { emit_native_text_with_module_name } from "../../src/codegen_driver";
import { lower_to_llvm_ir_from_text_with_provider_context } from "../../src/llvm/lowering/entrypoints";
import { index_of } from "../../src/string_utils";

fn _contains(haystack: string, needle: string) -> boolean {
    return index_of(haystack, needle) >= 0;
}

fn _emit(source: string) -> string ![io] {
    let program = parse_program(source);
    return emit_native_text_with_module_name(program, "secret_buf_surface_test");
}

test "secret_buf_surface: SecretBuf struct parses with four i64 fields" ![io] {
    let asm = _emit("struct SecretBuf { ptr_addr: i64; len: i64; cap: i64; cleanup_token: i64; }");
    assert _contains(asm, ".field ptr_addr: i64");
    assert _contains(asm, ".field len: i64");
    assert _contains(asm, ".field cap: i64");
    assert _contains(asm, ".field cleanup_token: i64");
    // Four 8-byte slots — the SFEP-0069 §3.2 layout is 32 bytes, no
    // `arena_addr` (SecretBuf is never arena-backed).
    assert _contains(asm, ".layout struct name=SecretBuf size=32 align=8");
}

test "secret_buf_surface: SfnSecretCleanupNode struct parses with five i64 fields" ![io] {
    let asm = _emit("struct SfnSecretCleanupNode { previous_addr: i64; kind: i64; ptr_addr: i64; cap: i64; state: i64; }");
    assert _contains(asm, ".field previous_addr: i64");
    assert _contains(asm, ".field kind: i64");
    assert _contains(asm, ".field ptr_addr: i64");
    assert _contains(asm, ".field cap: i64");
    assert _contains(asm, ".field state: i64");
    // Five 8-byte slots — the SFEP-0069 §3.5 owner-node shape
    // `{ previous, kind, ptr, cap, state }`.
    assert _contains(asm, ".layout struct name=SfnSecretCleanupNode size=40 align=8");
}

test "secret_buf_surface: lowering pins the SecretBuf aggregate and seven public defines" ![io] {
    let source = fs.readFile("runtime/sfn/memory/secretbuf.sfn");
    let program = parse_program(source);
    let native = emit_native_text_with_module_name(program, "runtime/sfn/memory/secretbuf");
    let ir = lower_to_llvm_ir_from_text_with_provider_context(native, "runtime/sfn/memory/secretbuf", empty_llvm_import_context(), resolve_llvm_provider_context());

    // Pinned aggregate layout: every `_addr` field rides as an i64
    // slot (the `ownedbuf.sfn` discipline this module follows), so
    // SecretBuf is 4 x i64 with no `arena_addr` slot.
    assert _contains(ir, "%SecretBuf = type { i64, i64, i64, i64 }");
    assert _contains(ir, "%SfnSecretCleanupNode = type { i64, i64, i64, i64, i64 }");

    // The seven SFEP-0069 §3.2 public functions.
    assert _contains(ir, "@secret_buf_new(");
    assert _contains(ir, "@secret_buf_len(");
    assert _contains(ir, "@secret_buf_declassify_byte(");
    assert _contains(ir, "@secret_buf_set(");
    assert _contains(ir, "@secret_buf_append(");
    assert _contains(ir, "@secret_buf_zeroize(");
    assert _contains(ir, "@secret_buf_declassify_copy(");

    // The wipe path must go through the non-elidable `secure_zero`
    // lowering (SFEP-0069 §3.6), not an ordinary store loop — assert
    // the golden-IR shape `secure_zero_lowering_test.sfn` pins is
    // present in this module's lowered output.
    assert _contains(ir, "store volatile i8 0");
    assert _contains(ir, "align 1");
    assert _contains(ir, "secure_zero_body_");
    assert _contains(ir, "secure_zero_done_");
}
