// Surface tests for the dormant, internal `SecretBuf` runtime
// (`runtime/sfn/memory/secretbuf.sfn`, SFN-783, design SFEP-0069
// §§3.2 and 3.5). `SecretBuf` is module-private and not importable by
// safe source — SFN-790 is the atomic activation slice — so these
// tests pin the trusted-runtime layout and lowered shape directly
// against the real file, the same strategy
// `owned_buf_surface_test.sfn` uses for `OwnedBuf`.
//
// Strategy:
//   - Struct layout via `emit_native_text_with_module_name` over an
//     inline fixture matching the SFEP-0069 §3.2 declaration verbatim.
//
// The lowered surface — the two aggregate layouts, the seven public
// `define`s, and the volatile byte-store wipe shape — is pinned by
// `compiler/tests/e2e/secret_buf_runtime_test.sfn` instead, which
// reaches them through `sfn emit-llvm` as a subprocess. Asserting them
// a second time here would need the in-process lowering entrypoint,
// and that is a link dependency this shard does not otherwise carry.
import { parse_program } from "sfn/syntax";

import { emit_native_text_with_module_name } from "../../src/codegen_driver";
import { index_of } from "../../src/string_utils";

fn _contains(haystack: string, needle: string) -> boolean {
    return index_of(haystack, needle) >= 0;
}

fn _emit(source: string) -> string ![io] {
    let program = parse_program(source);
    return emit_native_text_with_module_name(program, "secret_buf_surface_test");
}

test "secret_buf_surface: SecretBuf struct parses with four i64 fields" ![io] {
    let asm = _emit("struct SecretBuf { ptr_addr: i64; len: i64; cap: i64; cleanup_token: i64; }");
    assert _contains(asm, ".field ptr_addr: i64");
    assert _contains(asm, ".field len: i64");
    assert _contains(asm, ".field cap: i64");
    assert _contains(asm, ".field cleanup_token: i64");
    // Four 8-byte slots — the SFEP-0069 §3.2 layout is 32 bytes, no
    // `arena_addr` (SecretBuf is never arena-backed).
    assert _contains(asm, ".layout struct name=SecretBuf size=32 align=8");
}

test "secret_buf_surface: SfnSecretCleanupNode struct parses with five i64 fields" ![io] {
    let asm = _emit("struct SfnSecretCleanupNode { previous_addr: i64; kind: i64; ptr_addr: i64; cap: i64; state: i64; }");
    assert _contains(asm, ".field previous_addr: i64");
    assert _contains(asm, ".field kind: i64");
    assert _contains(asm, ".field ptr_addr: i64");
    assert _contains(asm, ".field cap: i64");
    assert _contains(asm, ".field state: i64");
    // Five 8-byte slots — the SFEP-0069 §3.5 owner-node shape
    // `{ previous, kind, ptr, cap, state }`.
    assert _contains(asm, ".layout struct name=SfnSecretCleanupNode size=40 align=8");
}
