// #1308 (M1.A.2): regression coverage for the Sailfin-native substring body
// (`_sfn_substring_unchecked` in `runtime/sfn/string.sfn`) that replaced the C
// `sailfin_runtime_substring_unchecked` entrypoint (now `static`). The
// `substring_unchecked(...)` builtin lowers via the registry to
// `sfn_str_slice_lv` (SFN-632), which bounds the span against the carried
// length — the source of the clamping cases below. With the
// immediate-codepoint encoding
// retired (#1420/#822), `src[i]` yields an ordinary grapheme string, so these
// tests pin the real-pointer substring behavior.
test "string: substring_unchecked returns expected slice" {
    let text = "hello";
    let result = substring_unchecked(text, 1, 4);
    assert result == "ell";
}

test "string: substring_unchecked handles empty spans" {
    let text = "hello";
    assert substring_unchecked(text, 2, 2) == "";
}

test "string: substring_unchecked full-range and head/tail slices" {
    let text = "hello";
    assert substring_unchecked(text, 0, 5) == "hello";
    assert substring_unchecked(text, 0, 1) == "h";
    assert substring_unchecked(text, 4, 5) == "o";
}

test "string: substring_unchecked clamps a negative start to 0" {
    let text = "hello";
    assert substring_unchecked(text, -3, 2) == "he";
}

test "string: substring_unchecked on an empty string is empty" {
    let text = "";
    assert substring_unchecked(text, 0, 0) == "";
}

// Single-character grapheme from indexing: `src[i]` yields an ordinary
// one-byte string that the real-pointer substring path slices directly.
test "string: substring_unchecked of an immediate grapheme (full)" {
    let src = "hello";
    let g = src[0];
    assert substring_unchecked(g, 0, 1) == "h";
}

test "string: substring_unchecked of an immediate grapheme (empty span)" {
    let src = "hello";
    let g = src[1];
    assert substring_unchecked(g, 0, 0) == "";
}

// End beyond the string width clamps to its length; slicing a 1-byte
// grapheme with [0, 5) yields the whole grapheme.
test "string: substring_unchecked of an immediate grapheme clamps end" {
    let src = "hello";
    let g = src[2];
    assert substring_unchecked(g, 0, 5) == "l";
}

// Start at/after the string width yields empty.
test "string: substring_unchecked of an immediate grapheme past end" {
    let src = "hello";
    let g = src[3];
    assert substring_unchecked(g, 1, 1) == "";
}

// SFN-632: `substring_unchecked` now lowers to `sfn_str_slice_lv`, which
// clamps `end` against the LENGTH CARRIED IN THE AGGREGATE rather than
// scanning to a NUL. `end` past the string's length must clamp to it.
test "string: substring_unchecked clamps end beyond the string length" {
    let text = "hello";
    assert substring_unchecked(text, 0, 9) == "hello";
    assert substring_unchecked(text, 2, 9) == "llo";
}

// `start` at/beyond the string length yields empty rather than reading past
// the payload.
test "string: substring_unchecked with start beyond the length is empty" {
    let text = "hello";
    assert substring_unchecked(text, 5, 5) == "";
    assert substring_unchecked(text, 9, 9) == "";
}

// `start > end` yields empty rather than an inverted or out-of-bounds slice.
test "string: substring_unchecked with start past end is empty" {
    let text = "hello";
    assert substring_unchecked(text, 4, 1) == "";
}
