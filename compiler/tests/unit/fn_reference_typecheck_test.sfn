// Unit tests for named functions in value position. SFN-667 admits a bare,
// concrete top-level function only where an exact `fn(...)` type is expected;
// legacy raw-address spellings retain their existing diagnostics.
//
// #1146 made `<fn> as * u8` lower to a real `bitcast @sym to i8*` for a
// concrete function; #1147 rejects every other function-reference spelling
// instead of letting it silently lower to `null` / a wrong closure-pair
// coercion.
//
// #1627 re-scoped the C-ABI guard: an erased `* u8` target is `void*` and
// carries no calling convention, so producing it violates none — a concrete
// (non-generic) function is accepted as `* u8` regardless of its signature
// ABI (this is what lets the struct-ABI http trampoline self-host). Typed `* fn (...)` targets are Sailfin function pointers, so concrete
// non-C-ABI handlers such as `fn(Request) -> Response` are accepted for
// capsule APIs. #1627 also
// structured every `<fn> as *T` cast into an `Expression.Cast`, so the
// classification now lives in the walker's `Cast` arm (via
// `classify_fn_cast`); only the residual `& fn` address-of (no prefix parse
// yet) still flows through the `Raw`/`Identifier` arms. Driven here
// end-to-end via parse + typecheck (no lowering import, per the #331 atomics
// 180s-timeout precedent).
import { typecheck_diagnostics } from "sfn/analyzer/typecheck";
import { parse_program } from "sfn/syntax";

fn _count_code(source: string, code: string) -> int ![io] {
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    let mut count: int = 0;
    let mut i: int = 0;
    loop {
        if i >= diagnostics.length { break; }
        if strings_equal(diagnostics[i].code, code) { count += 1; }
        i += 1;
    }
    return count;
}

// ── E0808: unsupported value-position spellings ──
test "fn-ref: bare function in a let initializer is E0808" ![io] {
    assert _count_code("fn worker() { } fn main() { let f = worker; }", "E0808") == 1;
}

test "fn-ref: `& fn` (address-of) is E0808" ![io] {
    assert _count_code("fn worker() { } fn main() { let f = & worker; }", "E0808") == 1;
}

test "fn-ref: `<fn> as <non-pointer>` is E0808" ![io] {
    assert _count_code("fn worker() { } fn main() { let f = worker as i64; }", "E0808") == 1;
}

test "fn-ref: bare function passed as an argument is E0808" ![io] {
    let source = "fn worker() { } fn take(f: * u8) { } fn main() { take(worker); }";
    assert _count_code(source, "E0808") == 1;
}

// ── SFN-667: exact function-typed expectation sites ──
test "fn-value: typed let accepts an exact top-level named function" ![io] {
    let source = "fn worker(x: int) -> int { return x + 1; } fn main() { let f: fn (int) -> int = worker; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: function-typed call argument accepts a named function" ![io] {
    let source = "fn worker(x: int) -> int { return x + 1; } fn apply(f: fn (int) -> int, x: int) -> int { return f(x); } fn main() { apply(worker, 4); }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: function-typed return accepts a named function" ![io] {
    let source = "fn worker(x: int) -> int { return x + 1; } fn choose() -> fn (int) -> int { return worker; } fn main() { }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: function-typed assignment accepts a named function" ![io] {
    let source = "fn one(x: int) -> int { return x + 1; } fn two(x: int) -> int { return x + 2; } fn main() { let mut f: fn (int) -> int = one; f = two; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: function-typed array element accepts a named function" ![io] {
    let source = "fn worker(x: int) -> int { return x + 1; } fn main() { let fs: (fn (int) -> int)[] = [worker]; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: function-typed struct initializer accepts a named function" ![io] {
    let source = "struct Handler { call: fn (int) -> int } fn worker(x: int) -> int { return x + 1; } fn main() { let h = Handler { call: worker }; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: conditional result branches inherit the fn expectation" ![io] {
    let source = "fn one(x: int) -> int { return x + 1; } fn two(x: int) -> int { return x + 2; } fn main() { let f: fn (int) -> int = true ? one : two; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: fn expectation does not leak into binary operands" ![io] {
    let source = "fn worker(x: int) -> int { return x; } fn main() { let f: fn (int) -> int = worker + 1; }";
    assert _count_code(source, "E0808") == 1;
}

test "fn-value: fn expectation does not leak into a conditional condition" ![io] {
    let source = "fn worker(x: int) -> int { return x; } fn other(x: int) -> int { return x + 1; } fn main() { let f: fn (int) -> int = worker ? other : other; }";
    assert _count_code(source, "E0808") == 1;
}

test "fn-value: imported placeholder fails closed under fn expectation" ![io] {
    let source = "import { remote } from \"pkg\"; fn main() { let f: fn (int) -> int = remote; }";
    assert _count_code(source, "E0808") == 1;
}

test "fn-value: generic named function stays rejected under fn expectation" ![io] {
    let source = "fn identity<T>(x: T) -> T { return x; } fn main() { let f: fn (int) -> int = identity; }";
    assert _count_code(source, "E0808") == 1;
}

test "fn-value: nested function stays rejected under fn expectation" ![io] {
    let source = "fn main() { fn local(x: int) -> int { return x; } let f: fn (int) -> int = local; }";
    assert _count_code(source, "E0808") == 1;
}

test "fn-value: async function is E0839 under synchronous fn expectation" ![io] {
    let source = "async fn worker(x: int) -> int { return x; } fn main() { let f: fn (int) -> int = worker; }";
    assert _count_code(source, "E0839") == 1;
}

test "fn-value: main is E0839 under fn expectation" ![io] {
    let source = "fn main(x: int) -> int { let f: fn (int) -> int = main; return 0; }";
    assert _count_code(source, "E0839") == 1;
}

test "fn-value: parameter mismatch is E0839" ![io] {
    let source = "fn worker(x: i64) -> int { return 1; } fn main() { let f: fn (int) -> int = worker; }";
    assert _count_code(source, "E0839") == 1;
}

test "fn-value: return mismatch is E0839" ![io] {
    let source = "fn worker(x: int) -> i64 { return 1; } fn main() { let f: fn (int) -> int = worker; }";
    assert _count_code(source, "E0839") == 1;
}

test "fn-value: number scalar signature is accepted" ![io] {
    let source = "fn worker(x: number) -> number { return x; } fn main() { let f: fn (number) -> number = worker; }";
    assert _count_code(source, "E0839") == 0;
    assert _count_code(source, "E0840") == 0;
}

test "fn-value: broader expected effect row accepts a narrower source row" ![io] {
    let source = "fn worker(x: int) -> int ![io.fs] { return x; } fn main() { let f: fn (int) -> int ![io] = worker; }";
    assert _count_code(source, "E0839") == 0;
}

test "fn-value: narrower expected effect row rejects a broader source row" ![io] {
    let source = "fn worker(x: int) -> int ![io] { return x; } fn main() { let f: fn (int) -> int ![io.fs] = worker; }";
    assert _count_code(source, "E0839") == 1;
}

test "fn-value: aggregate parameter signature is E0840" ![io] {
    let source = "fn worker(x: string) -> int { return x.length; } fn main() { let f: fn (string) -> int = worker; }";
    assert _count_code(source, "E0840") == 1;
}

test "fn-value: aggregate return signature is E0840" ![io] {
    let source = "struct Point { x: int } fn worker(x: int) -> Point { return Point { x: x }; } fn main() { let f: fn (int) -> Point = worker; }";
    assert _count_code(source, "E0840") == 1;
}

// ── E0809: generic function address has no single concrete code symbol ──
test "fn-ref: generic function `as * u8` is E0809" ![io] {
    let source = "fn gen<T>(x: T) -> T { return x; } fn main() { let f = gen as * u8; }";
    assert _count_code(source, "E0809") == 1;
}

// #1627: an erased `* u8` target is conventionless `void*`, so a concrete
// (non-generic) function with a non-C-ABI signature is now ACCEPTED as
// `* u8` — the C-ABI guard no longer fires on the erased target. (Before
// #1627 this was E0809; the struct-ABI http trampoline `as * u8` relies on
// this to self-host.)
test "fn-ref: non-C-ABI function `as * u8` is accepted (#1627 erased target)" ![io] {
    let source = "fn nc(x: number) -> number { return x; } fn main() { let f = nc as * u8; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0809") == 0;
}

// Typed `* fn (...)` targets are Sailfin function pointers. A concrete
// non-C-ABI signature is accepted so typed capsule callbacks (for example
// `sfn/http` handlers) can be passed without erasing them to `* u8`.
test "fn-ref: non-C-ABI function as typed `* fn (...)` is accepted" ![io] {
    let source = "fn nc(x: number) -> number { return x; } fn main() { let f = nc as * fn (number) -> number; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0809") == 0;
}

// ── Supported form stays clean (the #1146 happy path) ──
test "fn-ref: concrete C-ABI `<fn> as * u8` is accepted (no E0808/E0809)" ![io] {
    let source = "fn worker(arg: * u8) -> * u8 { return arg; } fn main() { let f = worker as * u8; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0809") == 0;
}

// ── Self-host gate: a non-function `as * u8` cast must NOT be flagged ──
// (the compiler driver casts `label`/`argv[0]` as `* u8`; flagging those
// would break `make compile`).
test "fn-ref: non-function `<value> as * u8` is not flagged" ![io] {
    let source = "fn main() { let label = \"x\"; let p = label as * u8; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0809") == 0;
}

// ── Only `* u8` is the supported address target (#1147 review) ──
test "fn-ref: `<fn> as * i32` (non-u8 pointer target) is E0808" ![io] {
    let source = "fn worker(arg: * u8) -> * u8 { return arg; } fn main() { let f = worker as * i32; }";
    assert _count_code(source, "E0808") == 1;
}

// ── Parenthesized forms are still classified (#1147 review) ──
test "fn-ref: `(<generic-fn>) as * u8` is still E0809 (parens don't hide it)" ![io] {
    let source = "fn gen<T>(x: T) -> T { return x; } fn main() { let f = (gen) as * u8; }";
    assert _count_code(source, "E0809") == 1;
}

test "fn-ref: `(<concrete C-ABI fn>) as * u8` is accepted" ![io] {
    let source = "fn worker(arg: * u8) -> * u8 { return arg; } fn main() { let f = (worker) as * u8; }";
    assert _count_code(source, "E0808") == 0;
    assert _count_code(source, "E0809") == 0;
}

// ── A normal call is not a value reference (Risk-1 guard) ──
test "fn-ref: a normal function call is not flagged as a value use" ![io] {
    assert _count_code("fn worker() { } fn main() { worker(); }", "E0808") == 0;
}
