// compiler/tests/unit/runtime_obj_target_identity_test.sfn
//
// Regression guard for SFN-617: a cached runtime object must carry the
// build TARGET in its identity, so an object compiled for one target is
// never served to a link for another.
//
// The defect was reproduced as a Windows-target build in a brand-new
// work-dir receiving ELF objects and dying with `lld-link: unknown file
// type`. Codegen was correct throughout — the objects were fetched from
// the shared content-addressed cache, whose entry key is a hash of the
// runtime-object key string. Because neither that key nor the on-disk
// filename recorded a target, one target's artifacts satisfied another's
// lookup.
//
// Both halves are pinned here:
//
//   * `_runtime_obj_key_with_target` is the CORRECTNESS half. It gates
//     the shared cache and the work-dir `.o.key` sidecar compare, both of
//     which are content-key driven, so a target fold here is what
//     actually stops a cross-target reuse.
//   * `_runtime_obj_stem` is the ISOLATION half. Distinct filenames keep
//     two targets' objects from overwriting each other in one work-dir
//     (and make a mismatched artifact visible in a directory listing
//     rather than silently mislabelled).
//
// SFN-870 extends the same file to the third axis of a runtime object's
// identity, the module SLUG, in its own section at the bottom.
//
// Pure assertions over the composers — no build, no link, no target
// probe — so every leg is exercised on any host.
import { contains } from "sfn/strings";
import { expect_eq_bool, expect_eq_str } from "sfn/test";

import {
    _runtime_obj_key_with_slug,
    _runtime_obj_key_with_target,
    _runtime_obj_stem
} from "../../src/build/runtime_objs";
import { target_artifact_tag } from "../../src/build/target";

// ---- The stem: filename isolation ----
test "runtime-obj identity: stem places the target tag between basename and opt flag" ![pure] {
    // `opt_flag` already carries its own leading `-`, so the composed stem
    // reads `<prefix><basename>-<tag><opt_flag>`.
    let stem = _runtime_obj_stem("sfn__runtime-native__", "/rt/sfn/clock.sfn", "-O2", "linux");
    assert expect_eq_str(stem, "sfn__runtime-native__clock.sfn-linux-O2").ok;
}

test "runtime-obj identity: stem drops the source directory, keeping only the basename" ![pure] {
    // Two capsules' sources collide on basename by design; the capsule
    // prefix is what separates them, not the path.
    let deep = _runtime_obj_stem("p__", "/a/very/deep/path/io.sfn", "-O0", "darwin");
    assert expect_eq_str(deep, "p__io.sfn-darwin-O0").ok;
}

test "runtime-obj identity: stems differ across targets for one source" ![pure] {
    // The SFN-617 contract on the filename half: same capsule, same
    // source, same opt flag, different target -> different path, so the
    // two objects coexist instead of overwriting each other.
    let linux = _runtime_obj_stem("sfn__runtime-native__", "/rt/sfn/prelude.sfn", "-O2", "linux");
    let windows = _runtime_obj_stem("sfn__runtime-native__", "/rt/sfn/prelude.sfn", "-O2", "windows");
    assert expect_eq_bool(linux == windows, false).ok;
    assert expect_eq_bool(contains(linux, "-linux-"), true).ok;
    assert expect_eq_bool(contains(windows, "-windows-"), true).ok;
}

// ---- The key: cross-target reuse gate ----
test "runtime-obj identity: key folds the raw target under a scheme tag" ![pure] {
    // A host target contributes no clang flags, so the fold is exactly the
    // scheme tag plus the raw target string. Pinning the literal keeps the
    // scheme greppable and makes an accidental format change loud.
    // SFN-774 / SFEP-0068 §3.6: the marker bumped `tgt1:` -> `tgt2:` when
    // the fold input moved from `target_os` to the triple, so a
    // pre-promotion entry can never collide with a post-promotion one.
    assert expect_eq_str(_runtime_obj_key_with_target("BASE", "Linux"), "BASE\ntgt2:Linux").ok;
}

test "runtime-obj identity: key folds the raw target and nothing after it" ![pure] {
    // The fold is exactly the scheme tag plus the raw target string,
    // for every target including Windows. It deliberately does NOT
    // append `target_clang_flags`: those are a total function of
    // the triple, so they add no distinguishing power, and appending
    // them let a crafted target spell the same key (see the absorption
    // test below). Pinning the literal keeps the scheme greppable and
    // makes an accidental format change loud.
    assert expect_eq_str(_runtime_obj_key_with_target("BASE", "Windows"), "BASE\ntgt2:Windows").ok;
}

test "runtime-obj identity: a crafted target cannot absorb a following component" ![pure] {
    // SFN-677. `target_os` is an unvalidated env string, so the fold
    // puts it last with nothing after it. While the flags were
    // appended, these two targets — which compile to different objects,
    // one with the MSVC triple and one without, since
    // `target_os_is_windows` is an exact match — collapsed onto one
    // key, resurrecting the cross-target reuse SFN-617 closed.
    let plain = _runtime_obj_key_with_target("BASE", "Windows");
    let crafted = _runtime_obj_key_with_target("BASE", "Windows -target x86_64-pc-windows-msvc");
    assert expect_eq_bool(plain == crafted, false).ok;
}

test "runtime-obj identity: keys differ across targets for one base key" ![pure] {
    // The SFN-617 contract on the correctness half. Identical source
    // content, opt flag, compiler identity and sibling deps all collapse
    // into one base key; only the target distinguishes them.
    let linux = _runtime_obj_key_with_target("SAME-BASE", "Linux");
    let windows = _runtime_obj_key_with_target("SAME-BASE", "Windows");
    let darwin = _runtime_obj_key_with_target("SAME-BASE", "Darwin");
    assert expect_eq_bool(linux == windows, false).ok;
    assert expect_eq_bool(linux == darwin, false).ok;
    assert expect_eq_bool(windows == darwin, false).ok;
}

test "runtime-obj identity: key distinguishes two unrecognized targets" ![pure] {
    // `target_artifact_tag` collapses unknown targets to a shared `other`
    // filename bucket. That is only safe because the key keeps the RAW
    // target, so the two still miss and recompile rather than cross-link.
    let a = _runtime_obj_key_with_target("BASE", "Plan9");
    let b = _runtime_obj_key_with_target("BASE", "Haiku");
    assert expect_eq_bool(a == b, false).ok;
}

test "runtime-obj identity: an unhashable base key stays empty" ![pure] {
    // "" is the always-recompile fallback the callers propagate when a
    // source cannot be hashed. Folding a target onto it must not
    // manufacture a usable key, which would cache an object under an
    // identity that never saw its own source content.
    assert expect_eq_str(_runtime_obj_key_with_target("", "Linux"), "").ok;
    assert expect_eq_str(_runtime_obj_key_with_target("", "Windows"), "").ok;
}

test "runtime-obj identity: key composition is stable across calls" ![pure] {
    // A key that varied per call would miss on every build, silently
    // turning the cache off rather than failing loudly.
    let first = _runtime_obj_key_with_target("BASE", "Windows");
    let second = _runtime_obj_key_with_target("BASE", "Windows");
    assert expect_eq_str(first, second).ok;
}

// ---- SFN-774 / SFEP-0068 §3.6: the two Windows ABIs must not collide ----
test "runtime-obj identity: msvc and mingw triples yield different cache keys" ![pure] {
    // Before the triple axis, both Windows triples folded to the OS string
    // `"Windows"` and would have shared this key despite compiling to
    // different objects — an msvc build and a mingw build cross-linking
    // silently. The key must now carry the full triple.
    let msvc = _runtime_obj_key_with_target("SAME-BASE", "x86_64-pc-windows-msvc");
    let mingw = _runtime_obj_key_with_target("SAME-BASE", "x86_64-w64-mingw32");
    assert expect_eq_bool(msvc == mingw, false).ok;
}

test "runtime-obj identity: msvc and mingw triples yield different artifact tags" ![pure] {
    // The on-disk half of the same fix: distinct tags so the two ABIs'
    // cached runtime objects land at distinct paths instead of
    // overwriting each other.
    let msvc_tag = target_artifact_tag("x86_64-pc-windows-msvc");
    let mingw_tag = target_artifact_tag("x86_64-w64-mingw32");
    assert expect_eq_bool(msvc_tag == mingw_tag, false).ok;
}

test "runtime-obj identity: msvc and mingw triples yield distinct stems for one source" ![pure] {
    let src = "/rt/sfn/prelude.sfn";
    let msvc_stem = _runtime_obj_stem("sfn__runtime-native__", src, "-O2", target_artifact_tag("x86_64-pc-windows-msvc"));
    let mingw_stem = _runtime_obj_stem("sfn__runtime-native__", src, "-O2", target_artifact_tag("x86_64-w64-mingw32"));
    assert expect_eq_bool(msvc_stem == mingw_stem, false).ok;
}

// ---- Both halves together ----
test "runtime-obj identity: one source yields a distinct stem and key per target" ![pure] {
    // The end-to-end SFN-617 contract: nothing about a Linux-targeted
    // object — neither where it is written nor what it is keyed by —
    // can satisfy a Windows-targeted lookup.
    let src = "/rt/sfn/prelude.sfn";
    let linux_stem = _runtime_obj_stem("sfn__runtime-native__", src, "-O2", "linux");
    let windows_stem = _runtime_obj_stem("sfn__runtime-native__", src, "-O2", "windows");
    let linux_key = _runtime_obj_key_with_target("BASE", "Linux");
    let windows_key = _runtime_obj_key_with_target("BASE", "Windows");
    assert expect_eq_bool(linux_stem == windows_stem, false).ok;
    assert expect_eq_bool(linux_key == windows_key, false).ok;
}

// ---- SFN-870: the module slug is part of the object's identity ----
//
// The `.o`-side twin of the SFN-861 `asm1:` fold. The object is compiled
// from a `.ll` carrying slug-derived symbol names, emitted from a
// `.sfn-asm` whose first directive is `.module <slug>` — so two
// byte-identical sources built under different slugs produce different
// object bytes. Before this fold they hashed to one address: the base key
// sees only source bytes, an opt-flag tag and the compiler identity, and
// `_runtime_obj_key_with_sibling_deps` spends its `slug` argument on the
// `.import-deps` lookup alone, returning the base key byte-for-byte for a
// module with no sidecar. Reverting the `"\nobj1:" + slug` line in
// `_runtime_obj_key_with_slug` fails the discrimination tests below.
test "runtime-obj identity: key folds the slug under a scheme tag" ![pure] {
    // Pinning the literal keeps the scheme greppable and makes an
    // accidental format change loud, matching the `tgt2:` pin above.
    assert expect_eq_str(_runtime_obj_key_with_slug("BASE", "runtime/sfn/string"), "BASE\nobj1:runtime/sfn/string").ok;
}

test "runtime-obj identity: keys differ across slugs for one base key" ![pure] {
    // The SFN-870 contract. Identical source content, opt flag, compiler
    // identity and sibling deps all collapse into one base key; only the
    // slug distinguishes them. The realistic collision is a shared
    // helper re-exported into a dep capsule's own namespace, or a module
    // split whose halves are briefly identical.
    let a = _runtime_obj_key_with_slug("SAME-BASE", "runtime/sfn/util");
    let b = _runtime_obj_key_with_slug("SAME-BASE", "dep/sfn/util");
    assert expect_eq_bool(a == b, false).ok;
}

test "runtime-obj identity: a one-character slug difference still separates keys" ![pure] {
    // No prefix-collapsing or truncation in the fold: the whole slug is
    // key material.
    let a = _runtime_obj_key_with_slug("SAME-BASE", "runtime/sfn/io");
    let b = _runtime_obj_key_with_slug("SAME-BASE", "runtime/sfn/io2");
    assert expect_eq_bool(a == b, false).ok;
}

test "runtime-obj identity: an unhashable base key stays empty under the slug fold" ![pure] {
    // "" is the always-recompile fallback the callers propagate. Folding
    // a slug onto it must not manufacture a usable key, matching the
    // target fold's behaviour on the same input.
    assert expect_eq_str(_runtime_obj_key_with_slug("", "runtime/sfn/string"), "").ok;
}

test "runtime-obj identity: slug fold composition is stable across calls" ![pure] {
    // A key that varied per call would miss on every build, silently
    // turning the cache off rather than failing loudly.
    let first = _runtime_obj_key_with_slug("BASE", "runtime/prelude");
    let second = _runtime_obj_key_with_slug("BASE", "runtime/prelude");
    assert expect_eq_str(first, second).ok;
}

test "runtime-obj identity: the slug fold nests inside the target fold, leaving the triple last" ![pure] {
    // Both `.sfn`-source call sites — `_prepare_runtime_sfn_object` and
    // `write_runtime_identity_stamp`'s stamped entry — compose the two
    // folds in this order. The triple stays last with nothing after it,
    // preserving the SFN-677 absorption guarantee that the target fold's
    // own comment documents.
    let composed = _runtime_obj_key_with_target(_runtime_obj_key_with_slug("BASE", "runtime/sfn/string"), "Linux");
    assert expect_eq_str(composed, "BASE\nobj1:runtime/sfn/string\ntgt2:Linux").ok;
}

test "runtime-obj identity: one base key yields a distinct composed key per slug at one target" ![pure] {
    // The end-to-end SFN-870 contract, at the composition the call sites
    // actually build: same source, same target, different module identity
    // must not share a cache address.
    let a = _runtime_obj_key_with_target(_runtime_obj_key_with_slug("SAME-BASE", "runtime/sfn/util"), "Linux");
    let b = _runtime_obj_key_with_target(_runtime_obj_key_with_slug("SAME-BASE", "dep/sfn/util"), "Linux");
    assert expect_eq_bool(a == b, false).ok;
    assert expect_eq_bool(contains(a, "\ntgt2:Linux"), true).ok;
    assert expect_eq_bool(contains(b, "\ntgt2:Linux"), true).ok;
}

test "runtime-obj identity: the slug fold reshapes the key, orphaning pre-SFN-870 entries" ![pure] {
    // Adding the component changes every `.sfn`-source object key, so a
    // pre-fix entry can never be served under the new derivation — the
    // same no-collision property the `tgt1:` -> `tgt2:` bump relied on.
    let pre_fix = _runtime_obj_key_with_target("BASE", "Linux");
    let post_fix = _runtime_obj_key_with_target(_runtime_obj_key_with_slug("BASE", "runtime/sfn/string"), "Linux");
    assert expect_eq_bool(pre_fix == post_fix, false).ok;
}
