// Unit tests for `_read_file_bytes`/`_free_file_bytes` (SFN-659), the
// binary-safe counterpart to `fs.readFile` that reads a file's raw
// bytes into a heap buffer instead of a NUL-truncating Sailfin string.
// Fixtures containing embedded NUL bytes are written with `malloc` +
// `memset` + `fwrite` since a Sailfin `string` cannot hold byte 0x00
// (`char_from_code(0)` yields `""`, so `fs.writeFile` cannot carry it).
import { _read_file_bytes, _free_file_bytes } from "../../src/build/fs";

extern fn fopen(path: *u8, mode: *u8) -> *File;

extern fn fwrite(buf: *u8, size: usize, nmemb: usize, f: *File) -> usize;

extern fn fclose(f: *File) -> i32;

extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(ptr: *u8, value: i32, n: usize) -> *u8;

fn _scratch_dir() -> string ![io] {
    let mut dir = env.get("SAILFIN_TEST_SCRATCH");
    if dir.length == 0 { dir = "/tmp"; }
    dir = dir + "/sfn-read-file-bytes-unit";
    fs.createDirectory(dir, true);
    return dir;
}

// Write `n` bytes to `path`, one byte at a time via `memset`, so the
// fixture can carry NUL bytes that a Sailfin `string` cannot hold.
fn _write_byte_fixture(path: string, bytes: int[]) -> void ![io] {
    let mode: string = "wb";
    let f: *File = fopen(path as *u8, mode as *u8);
    assert(f as i64) != 0;
    let buf: *u8 = malloc(1 as usize);
    assert(buf as i64) != 0;
    let mut i: int = 0;
    loop {
        if i >= bytes.length { break; }
        memset(buf, bytes[i] as i32, 1 as usize);
        let _ = fwrite(buf, 1 as usize, 1 as usize, f);
        i += 1;
    }
    free(buf);
    let _ = fclose(f);
}

test "read-file-bytes: embedded NULs round-trip at full length" ![io] {
    let dir = _scratch_dir();
    let path = dir + "/embedded-nuls.bin";
    let bytes: int[] = [65, 0, 66, 0, 0, 67, 10, 0];
    _write_byte_fixture(path, bytes);

    let b = _read_file_bytes(path);
    assert b.status == 0;
    assert b.length == 8;
    let mut i: int = 0;
    loop {
        if i >= bytes.length { break; }
        assert load_byte(b.addr + i) == bytes[i];
        i += 1;
    }
    _free_file_bytes(b);
}

// Not a multiple of the 65536 chunk, so the final short read and
// several capacity doublings are exercised.
test "read-file-bytes: >1 MiB file reads with no truncation" ![io] {
    let dir = _scratch_dir();
    let path = dir + "/large.bin";
    let total: int = 1572869;
    let mode: string = "wb";
    let f: *File = fopen(path as *u8, mode as *u8);
    assert(f as i64) != 0;
    let buf: *u8 = malloc(1 as usize);
    assert(buf as i64) != 0;
    let mut i: int = 0;
    loop {
        if i >= total { break; }
        memset(buf, (i % 251) as i32, 1 as usize);
        let _ = fwrite(buf, 1 as usize, 1 as usize, f);
        i += 1;
    }
    free(buf);
    let _ = fclose(f);

    let b = _read_file_bytes(path);
    assert b.status == 0;
    assert b.length == total;
    assert load_byte(b.addr + 0) == 0 % 251;
    assert load_byte(b.addr + 1) == 1 % 251;
    assert load_byte(b.addr + 65535) == 65535 % 251;
    assert load_byte(b.addr + 65536) == 65536 % 251;
    assert load_byte(b.addr + 65537) == 65537 % 251;
    assert load_byte(b.addr + 250) == 250 % 251;
    assert load_byte(b.addr + 251) == 251 % 251;
    assert load_byte(b.addr + 1048576) == 1048576 % 251;
    assert load_byte(b.addr + 1572868) == 1572868 % 251;
    _free_file_bytes(b);
}

test "read-file-bytes: missing file returns status 1, addr 0, length 0" ![io] {
    let dir = _scratch_dir();
    let path = dir + "/does-not-exist.bin";
    if fs.exists(path) { fs.deleteFile(path); }

    let b = _read_file_bytes(path);
    assert b.status == 1;
    assert b.addr == 0;
    assert b.length == 0;
    // Pins the documented no-op on a non-zero status — the guard that
    // keeps a failure result from turning into a double free.
    _free_file_bytes(b);
}

// A directory is the root-safe way to exercise the unreadable leg: a
// `chmod 0` fixture is a no-op when the suite runs as root in CI.
// `fopen` on a directory succeeds and the first `fread` fails, so this
// pins the post-loop `ferror` check specifically — without it the
// directory would report `status 0, length 0` and be indistinguishable
// from the genuinely empty file below.
test "read-file-bytes: unreadable path returns status 2, addr 0" ![io] {
    let dir = _scratch_dir();
    let path = dir + "/a-directory.bin";
    fs.createDirectory(path, true);

    let b = _read_file_bytes(path);
    assert b.status == 2;
    assert b.addr == 0;
    assert b.length == 0;
}

test "read-file-bytes: empty file returns status 0, length 0, non-zero addr" ![io] {
    let dir = _scratch_dir();
    let path = dir + "/empty.bin";
    fs.writeFile(path, "");

    let b = _read_file_bytes(path);
    assert b.status == 0;
    assert b.length == 0;
    assert b.addr != 0;
    _free_file_bytes(b);
}
