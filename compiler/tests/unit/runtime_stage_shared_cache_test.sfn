// End-to-end coverage for the SFN-861 shared content-addressed cache layer
// on the RUNTIME staging path (`_stage_one_runtime_sfn_import_context`,
// `compiler/src/build/runtime_objs.sfn`) — the mirror of
// `stage_shared_cache_test.sfn`'s CAPSULE staging coverage (e87cc220), for
// the second, larger of the two staging roots
// (`<work>/sailfin/rt-import-context/`, ~68 of the 102 `.sfn-asm` a build
// emits).
//
// Unlike the capsule staging path, the runtime staging path has no
// in-process emit fallback — `_stage_one_runtime_sfn_import_context`
// always drives a real `<self_path> emit --no-resolve-gate native` child.
// So every test here calls it directly against the built `sfn` binary
// (`SAILFIN_BIN` or `build/bin/sfn`), rather than an in-process stub.
//
// A plain boolean return gives no `cache_hit`/`cache_stored` flag to
// assert on directly, so "this call was served from the shared cache, not
// a fresh emit" is proven by pointing `self_path` at a binary that does
// not exist: if the call still succeeds and produces correct content, the
// emit subprocess was never invoked.
//
// Each test uses its own scratch namespace so parallel runs don't
// collide, and cleans up on exit.
import { sfn_bin_path } from "sfn/test";

import { _stage_one_runtime_sfn_import_context, runtime_asm_cache_key } from "../../src/build/runtime_objs";
import {
    CacheKey,
    cache_lookup_artifact,
    cache_store_artifact,
    is_valid_digest,
    runtime_object_cache_key_with_identity,
    runtime_object_entry_key_from_str
} from "../../src/build_cache";

// A self_path that cannot resolve to a runnable binary. Used to prove a
// call was served from the shared cache without ever reaching the emit
// subprocess.
fn _rsc_unusable_self_path() -> string {
    return "/nonexistent/sfn-861-should-not-be-invoked";
}

// A fixed, non-empty compiler identity. Any call that relies on the shared
// cache actually being consulted (proven via `_rsc_unusable_self_path`)
// must pass a non-empty identity — the function disables the shared cache
// in-function when `compiler_identity` is empty (SFN-861 review
// follow-up).
fn _rsc_identity() -> string { return "sfn-861-review-identity"; }

fn _rsc_tmp_root(label: string) -> string ![io] {
    let mut base = env.get("SAILFIN_TEST_SCRATCH");
    if base.length == 0 { base = "/tmp"; }
    let dir = base + "/sfn_runtime_stage_shared_cache_test_" + label;
    process.run(["rm", "-rf", dir]);
    process.run(["mkdir", "-p", dir]);
    return dir;
}

fn _rsc_cleanup(path: string) ![io] {
    process.run(["rm", "-rf", path]);
}

// --------------------------------------------------------------
// 1. store -> fresh work dir -> restore
// --------------------------------------------------------------
test "runtime stage shared cache: a fresh work dir restores a module staged by a prior run" ![io] {
    let cache_root = _rsc_tmp_root("t1_cache");
    let src_root = _rsc_tmp_root("t1_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    let ctx_root1 = _rsc_tmp_root("t1_ctx1");
    let ok1 = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "mymod", ctx_root1, _rsc_identity(), cache_root);
    assert ok1;
    let asm_path1 = ctx_root1 + "/mymod.sfn-asm";
    let asm1 = fs.readFile(asm_path1);
    assert asm1.length > 0;

    // A DIFFERENT, never-before-seen ctx root, and a self_path that would
    // fail if the emit subprocess were ever invoked: any success here must
    // come from the shared cache written above, not a fresh emit.
    let ctx_root2 = _rsc_tmp_root("t1_ctx2");
    let ok2 = _stage_one_runtime_sfn_import_context(_rsc_unusable_self_path(), src_path, "mymod", ctx_root2, _rsc_identity(), cache_root);
    assert ok2;
    let asm_path2 = ctx_root2 + "/mymod.sfn-asm";
    assert fs.readFile(asm_path2) == asm1;
    // The restore also writes the work-dir `.key` sidecar so a same-work-dir
    // rebuild fast-paths through `_runtime_obj_cache_hit`.
    assert fs.exists(asm_path2 + ".key");

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root1);
    _rsc_cleanup(ctx_root2);
}

// --------------------------------------------------------------
// 2. a changed source does NOT hit the stored entry
// --------------------------------------------------------------
test "runtime stage shared cache: a changed source does not hit the entry stored for the old content" ![io] {
    let cache_root = _rsc_tmp_root("t2_cache");
    let src_root = _rsc_tmp_root("t2_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    let ctx_root1 = _rsc_tmp_root("t2_ctx1");
    let ok1 = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "mymod", ctx_root1, "", cache_root);
    assert ok1;
    let asm1 = fs.readFile(ctx_root1 + "/mymod.sfn-asm");
    assert asm1.length > 0;

    // Same slug, DIFFERENT bytes: the content key must miss the entry
    // stored for the old content, forcing a real (successful) re-emit
    // rather than a bogus shared-cache hit.
    fs.writeFile(src_path, "fn hello() -> int { return 2; }\n");
    let ctx_root2 = _rsc_tmp_root("t2_ctx2");
    let ok2 = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "mymod", ctx_root2, "", cache_root);
    assert ok2;
    let asm2 = fs.readFile(ctx_root2 + "/mymod.sfn-asm");
    assert asm2.length > 0;
    assert asm2 != asm1;

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root1);
    _rsc_cleanup(ctx_root2);
}

// --------------------------------------------------------------
// 3. an empty `shared_cache_root` is inert
// --------------------------------------------------------------
test "runtime stage shared cache: an empty shared_cache_root neither reads nor writes the shared cache" ![io] {
    let cache_root = _rsc_tmp_root("t3_cache");
    let src_root = _rsc_tmp_root("t3_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    // Pre-populate `cache_root` with a WRONG entry for this exact key —
    // if the empty-`shared_cache_root` call below ever consulted it, it
    // would restore this bogus content instead of emitting fresh.
    let key_str = runtime_object_cache_key_with_identity(src_path, "", "");
    let key: CacheKey = runtime_object_entry_key_from_str(key_str, "mymod");
    assert is_valid_digest(key.digest);
    let bogus_asm = src_root + "/bogus.sfn-asm";
    fs.writeFile(bogus_asm, "; this must never be served\n");
    assert cache_store_artifact(cache_root, key, "sfn-asm", bogus_asm);

    let ctx_root = _rsc_tmp_root("t3_ctx");
    let ok = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "mymod", ctx_root, "", "");
    assert ok;
    let asm = fs.readFile(ctx_root + "/mymod.sfn-asm");
    assert asm.length > 0;
    assert asm != "; this must never be served\n";

    // No publish either: a second, unrelated slug staged with an empty
    // `shared_cache_root` must not add an entry under `cache_root`.
    let src_path2 = src_root + "/othermod.sfn";
    fs.writeFile(src_path2, "fn other() -> int { return 3; }\n");
    let key_str2 = runtime_object_cache_key_with_identity(src_path2, "", "");
    let key2: CacheKey = runtime_object_entry_key_from_str(key_str2, "othermod");
    assert is_valid_digest(key2.digest);
    let ctx_root2 = _rsc_tmp_root("t3_ctx2");
    let ok2 = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path2, "othermod", ctx_root2, "", "");
    assert ok2;
    assert ! cache_lookup_artifact(cache_root, key2, "sfn-asm");

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root);
    _rsc_cleanup(ctx_root2);
}

// --------------------------------------------------------------
// 4. a missing shared entry falls open to a fresh emit
// --------------------------------------------------------------
test "runtime stage shared cache: a missing shared entry falls open to a fresh emit" ![io] {
    let cache_root = _rsc_tmp_root("t4_cache");
    let src_root = _rsc_tmp_root("t4_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    // `cache_root` exists but has never seen this key — a genuine cold
    // shared cache. The call must still succeed via a real emit.
    let ctx_root = _rsc_tmp_root("t4_ctx");
    let ok = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "mymod", ctx_root, _rsc_identity(), cache_root);
    assert ok;
    let asm_path = ctx_root + "/mymod.sfn-asm";
    assert fs.readFile(asm_path).length > 0;
    assert fs.exists(asm_path + ".key");

    // And the fresh emit was published, so a subsequent fresh work dir
    // (proven via the unusable self_path trick) now hits it.
    let ctx_root2 = _rsc_tmp_root("t4_ctx2");
    let ok2 = _stage_one_runtime_sfn_import_context(_rsc_unusable_self_path(), src_path, "mymod", ctx_root2, _rsc_identity(), cache_root);
    assert ok2;
    assert fs.readFile(ctx_root2 + "/mymod.sfn-asm") == fs.readFile(asm_path);

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root);
    _rsc_cleanup(ctx_root2);
}

// --------------------------------------------------------------
// 5. slug discrimination (SFN-861 review follow-up, regression for the
// missing-slug-fold defect): the shared cache key must fold the module
// slug in, because the emitted native text's `.module <slug>` directive
// makes the slug part of the artifact's content.
// --------------------------------------------------------------
test "runtime stage shared cache: a shared entry stored under one slug is never served to a different slug" ![io] {
    let cache_root = _rsc_tmp_root("t5_cache");
    let src_root = _rsc_tmp_root("t5_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    // Stage the source under slug "a" with a real self_path: this
    // publishes a shared-cache entry whose bytes embed `.module a`.
    let ctx_root_a = _rsc_tmp_root("t5_ctx_a");
    let ok_a = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "a", ctx_root_a, _rsc_identity(), cache_root);
    assert ok_a;
    let asm_a = fs.readFile(ctx_root_a + "/a.sfn-asm");
    assert asm_a.length > 0;

    // The SAME source bytes staged under a DIFFERENT slug, into a fresh
    // ctx root, with a self_path that fails if the emit subprocess is
    // ever invoked. A key that ignores the slug (the pre-fix defect)
    // would serve slug "a"'s stored bytes here; the fix must either miss
    // the shared cache outright (and therefore fail, since the emit
    // subprocess cannot run) or, at minimum, never hand back "a"'s bytes
    // under "b"'s name.
    let ctx_root_b = _rsc_tmp_root("t5_ctx_b");
    let ok_b = _stage_one_runtime_sfn_import_context(_rsc_unusable_self_path(), src_path, "b", ctx_root_b, _rsc_identity(), cache_root);
    if ok_b {
        let asm_b = fs.readFile(ctx_root_b + "/b.sfn-asm");
        assert asm_b != asm_a;
    } else { assert ! ok_b; }

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root_a);
    _rsc_cleanup(ctx_root_b);
}

// --------------------------------------------------------------
// 6. a changed compiler identity misses a stored entry
// --------------------------------------------------------------
test "runtime stage shared cache: a changed compiler identity misses the entry stored for the old identity" ![io] {
    let cache_root = _rsc_tmp_root("t6_cache");
    let src_root = _rsc_tmp_root("t6_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    let ctx_root1 = _rsc_tmp_root("t6_ctx1");
    let ok1 = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "mymod", ctx_root1, "identity-one", cache_root);
    assert ok1;
    assert fs.readFile(ctx_root1 + "/mymod.sfn-asm").length > 0;

    // Same source, same slug, DIFFERENT identity, and a self_path that
    // fails if the emit subprocess is ever invoked: a miss must be a
    // hard failure here, proving the old identity's entry was not
    // served under the new identity's key.
    let ctx_root2 = _rsc_tmp_root("t6_ctx2");
    let ok2 = _stage_one_runtime_sfn_import_context(_rsc_unusable_self_path(), src_path, "mymod", ctx_root2, "identity-two", cache_root);
    assert ! ok2;

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root1);
    _rsc_cleanup(ctx_root2);
}

// --------------------------------------------------------------
// 7. kind isolation: an entry stored as `runtime-obj` is not served to
// an `sfn-asm` probe
// --------------------------------------------------------------
test "runtime stage shared cache: an entry stored under kind runtime-obj is not served to the sfn-asm probe" ![io] {
    let cache_root = _rsc_tmp_root("t7_cache");
    let src_root = _rsc_tmp_root("t7_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    // Store a bogus artifact under the EXACT key the sfn-asm staging call
    // below will compute, but under kind "runtime-obj" instead of
    // "sfn-asm".
    let key_str = runtime_asm_cache_key(src_path, "mymod", _rsc_identity());
    let key: CacheKey = runtime_object_entry_key_from_str(key_str, "mymod");
    assert is_valid_digest(key.digest);
    let bogus = src_root + "/bogus.o";
    fs.writeFile(bogus, "not an sfn-asm artifact\n");
    assert cache_store_artifact(cache_root, key, "runtime-obj", bogus);

    // A self_path that fails if the emit subprocess is ever invoked: the
    // call must fail rather than cross-serve the `runtime-obj` entry.
    let ctx_root = _rsc_tmp_root("t7_ctx");
    let ok = _stage_one_runtime_sfn_import_context(_rsc_unusable_self_path(), src_path, "mymod", ctx_root, _rsc_identity(), cache_root);
    assert ! ok;

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root);
}

// --------------------------------------------------------------
// 8. an empty/truncated shared entry falls open to a fresh emit
// --------------------------------------------------------------
test "runtime stage shared cache: a zero-length shared entry falls open to a fresh emit" ![io] {
    let cache_root = _rsc_tmp_root("t8_cache");
    let src_root = _rsc_tmp_root("t8_src");
    let src_path = src_root + "/mymod.sfn";
    fs.writeFile(src_path, "fn hello() -> int { return 1; }\n");

    // Publish a zero-length artifact under the exact key/kind a real
    // staging call would look up — simulating a truncated store write
    // left by `_cache_atomic_copy`'s non-atomic degrade
    // (`build_cache.sfn:823-834`).
    let key_str = runtime_asm_cache_key(src_path, "mymod", _rsc_identity());
    let key: CacheKey = runtime_object_entry_key_from_str(key_str, "mymod");
    assert is_valid_digest(key.digest);
    let empty_artifact = src_root + "/empty.sfn-asm";
    fs.writeFile(empty_artifact, "");
    assert cache_store_artifact(cache_root, key, "sfn-asm", empty_artifact);

    // A real self_path: the zero-length entry must be treated as a miss,
    // falling through to a genuine fresh emit rather than being trusted
    // (and blessed via the work-dir `.key` sidecar) as-is.
    let ctx_root = _rsc_tmp_root("t8_ctx");
    let ok = _stage_one_runtime_sfn_import_context(sfn_bin_path(), src_path, "mymod", ctx_root, _rsc_identity(), cache_root);
    assert ok;
    let asm_path = ctx_root + "/mymod.sfn-asm";
    assert fs.readFile(asm_path).length > 0;

    _rsc_cleanup(cache_root);
    _rsc_cleanup(src_root);
    _rsc_cleanup(ctx_root);
}
