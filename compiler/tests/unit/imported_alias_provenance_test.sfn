// SFN-1296: a re-exported alias keeps the qualifier of its defining module.
import { ImportProviderBinding } from "sfn/analyzer/effect_imports";
import { localize_imported_type_aliases } from "sfn/analyzer/typecheck/symbols";
import { ImportedTypeAlias } from "sfn/analyzer/typecheck_imports";
import { parse_program } from "sfn/syntax";

test "re-exported pointer alias selects its provider and original name" {
    let mutable_alias = parse_program("type Ptr = *i32;").statements[0];
    let const_alias = parse_program("type Ptr = *const i32;").statements[0];
    let aliases = [ImportedTypeAlias {
        declaration: mutable_alias, provider_module: "sfn/example/a"
    }, ImportedTypeAlias {
        declaration: const_alias, provider_module: "sfn/example/z"
    }];
    let program = parse_program("import { ReadOnly } from \"sfn/example\";");
    let providers = [ImportProviderBinding {
        source: "sfn/example", provider_module: "sfn/example/mod", symbol_name: "", provider_symbol_name: ""
    }, ImportProviderBinding {
        source: "sfn/example", provider_module: "sfn/example/z", symbol_name: "ReadOnly", provider_symbol_name: "Ptr"
    }];
    let localized = localize_imported_type_aliases(program, [], aliases, providers);
    assert localized.length == 1;
    assert localized[0].variant == "TypeAliasDeclaration";
    assert localized[0].name == "ReadOnly";
    assert localized[0].aliased_type.text == "*const i32";
}

test "same-provider struct name survives an additional alias" {
    let foreign_ctx = parse_program("struct Ctx { id: int; }").statements[0];
    let ctx = parse_program("struct Ctx { id: int; }").statements[0];
    let struct_verb = parse_program("struct StructVerb { run: fn (Ctx) -> int ![io]; }").statements[0];
    let aliases = [ImportedTypeAlias {
        declaration: foreign_ctx, provider_module: "sfn/other"
    }, ImportedTypeAlias { declaration: ctx, provider_module: "sfn/registry" }, ImportedTypeAlias {
        declaration: struct_verb, provider_module: "sfn/registry"
    }];
    let program = parse_program("import { Ctx as Alias, Ctx, StructVerb } from \"sfn/registry\";");
    let providers = [ImportProviderBinding {
        source: "sfn/registry", provider_module: "sfn/registry", symbol_name: "", provider_symbol_name: ""
    }, ImportProviderBinding {
        source: "sfn/registry", provider_module: "sfn/registry", symbol_name: "Ctx", provider_symbol_name: "Ctx"
    }, ImportProviderBinding {
        source: "sfn/registry", provider_module: "sfn/registry", symbol_name: "StructVerb", provider_symbol_name: "StructVerb"
    }];
    let localized = localize_imported_type_aliases(program, [], aliases, providers);
    assert localized[2].name == "StructVerb";
    assert localized[2].fields[0].type_annotation.text == "fn (Ctx) -> int ![io]";
    assert localized[5].fields[0].type_annotation.text == "fn (__sfn_import_1_Ctx) -> int ![io]";

    let renamed_only = parse_program("import { Ctx as Alias, StructVerb } from \"sfn/registry\";");
    let renamed_localized = localize_imported_type_aliases(renamed_only, [], aliases, providers);
    assert renamed_localized[1].fields[0].type_annotation.text == "fn (__sfn_import_1_Ctx) -> int ![io]";
}
