// Regression coverage for W0210 bare-assert soft-deprecation
// (compiler/capsules/analyzer/src/bare_assert_check.sfn, issue #1173, epic #842 Phase 3).
//
// `collect_bare_assert_findings` walks every top-level `test { ... }`
// block and returns one finding per bare `assert` in its body
// (recursively through nested blocks). The parser desugars `assert cond;`
// into an `IfStatement` calling `runtime_assert_fail_fn`, so the collector
// recognizes that desugared shape. `assert` outside a `test` block is
// never visited.
import { collect_bare_assert_findings } from "sfn/analyzer/bare_assert_check";
import { parse_program } from "sfn/syntax";

test "w0210: flags a bare assert inside a test block" ![io] {
    let program = parse_program("test \"t\" { assert 1 == 1; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

test "w0210: recovers the assert source location" ![io] {
    let program = parse_program("test \"t\" {\n    assert 1 == 1;\n}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
    assert findings[0].line == 2;
}

test "w0210: flags multiple bare asserts in one test block" ![io] {
    let program = parse_program("test \"t\" { assert 1 == 1; assert 2 == 2; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 2;
}

test "w0210: assert outside a test block is never flagged" ![io] {
    let program = parse_program("fn f() { assert 1 == 1; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: a test block with no asserts produces no findings" ![io] {
    let program = parse_program("test \"t\" { let x = 1; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: flags a bare assert nested inside an if in a test block" ![io] {
    let program = parse_program("test \"t\" { if true { assert 1 == 1; } }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

test "w0210: flags a bare assert nested inside a loop in a test block" ![io] {
    let program = parse_program("test \"t\" { loop { assert 1 == 1; break; } }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

test "w0210: counts only test-block asserts when fn asserts coexist" ![io] {
    let program = parse_program("fn f() { assert 9 == 9; } test \"t\" { assert 1 == 1; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

// SFN-859: `assert <matcher>(...).ok;` is the form W0210's own fix
// suggestion recommends, so it must not be flagged.
test "w0210: the expect matcher form is not flagged" ![io] {
    let program = parse_program("test \"t\" { assert expect_eq_int(1, 1).ok; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: every expect_ matcher is exempt" ![io] {
    let program = parse_program("test \"t\" {\n"
        + "    assert expect_eq_str(a, b).ok;\n"
        + "    assert expect_eq_bool(a, b).ok;\n"
        + "    assert expect_eq_int_array(a, b).ok;\n"
        + "    assert expect_contains_str(a, b).ok;\n"
        + "    assert expect_to_throw(f).ok;\n"
        + "    assert expect_snapshot(actual, key).ok;\n"
        + "}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: non-expect MatchResult helpers are exempt" ![io] {
    let program = parse_program("test \"t\" {\n"
        + "    assert assert_compiles(source, expect).ok;\n"
        + "    assert assert_does_not_compile(source, expect).ok;\n"
        + "    assert snapshot_match_in(actual, dir, key, update).ok;\n"
        + "    assert match_ok().ok;\n"
        + "    assert match_fail(msg).ok;\n"
        + "}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

// `matcher_*` is module-private to `capsules/sfn/test/src/matcher.sfn`, but
// a test importing that module directly reaches it and would otherwise
// reproduce the SFN-859 false positive.
test "w0210: the module-private matcher_ family is exempt" ![io] {
    let program = parse_program("test \"t\" {\n"
        + "    assert matcher_eq_int(a, b).ok;\n"
        + "    assert matcher_eq_string(a, b).ok;\n"
        + "    assert matcher_contains_string(a, b).ok;\n"
        + "}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: the matcher form is exempt when nested in a block" ![io] {
    let program = parse_program("test \"t\" { if true { assert expect_eq_int(1, 1).ok; } }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: the matcher form is exempt inside loop and match bodies" ![io] {
    let program = parse_program("test \"t\" {\n"
        + "    loop { assert expect_eq_int(1, 1).ok; break; }\n"
        + "    match v { Some(x) => { assert expect_eq_int(x, 1).ok; } }\n"
        + "}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

// The condition is recovered by re-parsing the assert's tokens, which falls
// back to `Expression.Raw` when the parse does not consume them cleanly —
// and a Raw condition is not recognizable as a matcher. These argument
// shapes are the ones most likely to trip that path.
test "w0210: the matcher form is exempt with a lambda argument" ![io] {
    let program = parse_program("test \"t\" { assert expect_to_throw(fn () -> int { return boom(); }).ok; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: the matcher form is exempt with a struct-literal argument" ![io] {
    let program = parse_program("test \"t\" { assert expect_eq_int(Point { x: 1, y: 2 }.x, 1).ok; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

test "w0210: the matcher form is exempt when its call spans lines" ![io] {
    let program = parse_program("test \"t\" {\n" + "    assert expect_eq_str(\n"
        + "        actual,\n"
        + "        expected\n"
        + "    ).ok;\n"
        + "}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 0;
}

// The exemption is narrow: only a `.ok` read on a direct matcher call.
test "w0210: a bare call assert is still flagged" ![io] {
    let program = parse_program("test \"t\" { assert contains(out, \"x\"); }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

// Pins the underscore in the `expect_` / `matcher_` prefixes: without it,
// any identifier merely starting with "expect" or "matcher" is exempted.
test "w0210: a prefix-adjacent name without the underscore is still flagged" ![io] {
    let program = parse_program("test \"t\" {\n"
        + "    assert expectation(x).ok;\n"
        + "    assert matchers(y).ok;\n"
        + "}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 2;
}

test "w0210: a .ok read on a non-matcher call is still flagged" ![io] {
    let program = parse_program("test \"t\" { assert parse_semver(text).ok; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

test "w0210: a .ok read on a plain variable is still flagged" ![io] {
    let program = parse_program("test \"t\" { assert result.ok; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

test "w0210: a matcher call not read through .ok is still flagged" ![io] {
    let program = parse_program("test \"t\" { assert expect_eq_int(1, 1).message == \"\"; }");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
}

test "w0210: flags only the bare assert when both forms coexist" ![io] {
    let program = parse_program("test \"t\" {\n"
        + "    assert expect_eq_int(1, 1).ok;\n"
        + "    assert 2 == 2;\n"
        + "}");
    let findings = collect_bare_assert_findings(program);
    assert findings.length == 1;
    assert findings[0].line == 3;
}
