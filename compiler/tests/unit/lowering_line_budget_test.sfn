// Line-budget sentinel for compiler/capsules/codegen-llvm/src/lowering/.
//
// lowering_core.sfn reached 1,762 lines and was split into the
// lowering_core/ modules, with the orchestrator kept below 750 lines.
// The folder walk covers future submodules automatically. Existing
// oversized siblings are pinned at their present sizes and may only
// shrink; every other module must remain below 750 lines.
//
// Raising a grandfathered ceiling requires an explicit reviewed change.
// SFN-639 tracks removing the grandfather list as the remaining modules
// are decomposed.
import { ends_with, find_char_local } from "../../src/string_utils";

let LOWERING_MODULE_LINE_BUDGET: int = 750;
let LOWERING_ROOT: string = "compiler/capsules/codegen-llvm/src/lowering";

fn _count_lowering_newlines(source: string) -> int {
    let mut count: int = 0;
    let mut pos: int = 0;
    loop {
        let idx = find_char_local(source, "\n", pos);
        if idx < 0 { break; }
        count += 1;
        pos = idx + 1;
    }
    return count;
}

fn _grandfathered_lowering_ceiling(path: string) -> int {
    // SFN-915 (SFEP-0061 S4b) raises four entries below: `ExpressionResult`
    // and `CoercionResult` gained a `diags` field, and Sailfin rejects a
    // partial struct literal at lowering (`E1002`), so every literal and
    // every forwarding frame in these modules must name it. No net-zero form
    // exists; each ceiling is pinned to its exact new length.
    //
    // SFN-1061 raises `instructions_match.sfn` 926 -> 928 for the same
    // reason: `MatchCaseStructure` gained `span` and `MatchCaseCondition`
    // gained `diags`, so the two case literals and the condition forwarding
    // frame each cost a line. Without the `diags` carrier an `error` diag
    // raised in match-condition lowering could never reach `has_error_diag`.
    //
    // SFN-1168 raises it again, 928 -> 963. A guard on an enum destructuring
    // arm was dropped because the guard was lowered before the pattern's
    // payload binders existed, so a guarded arm now needs a third basic block
    // between its tag test and its body: a label per case, the branch that
    // selects it, and the binder-materialization that has to precede the
    // guard. The guard emission itself was extracted to
    // `emit_match_guard_branch` in `instructions_match_condition.sfn` rather
    // than kept here, which is why the raise is 35 lines and not 83.
    //
    // This is a raise on an already-grandfathered module, against the
    // shrink-only rule above, and it is called out for review rather than
    // absorbed quietly. The remaining bulk is the ~130-line payload-binder
    // materialization block, which is self-contained and the obvious next
    // extraction; it was left alone here because it is untouched by the fix.
    // SFN-639 tracks the decomposition.
    if path == LOWERING_ROOT + "/lowering_helpers.sfn" { return 1512; }
    if path == LOWERING_ROOT + "/lowering_recovery.sfn" { return 1056; }
    if path == LOWERING_ROOT + "/instructions_let.sfn" { return 984; }
    if path == LOWERING_ROOT + "/instructions_match.sfn" { return 908; }
    if path == LOWERING_ROOT + "/instructions.sfn" { return 779; }
    if path == LOWERING_ROOT + "/instructions_helpers.sfn" { return 849; }
    // SFN-916 raises `instructions_if.sfn` 784 -> 785. Retiring the legacy
    // `diagnostics: string[]` channel exposed call sites that forwarded the
    // legacy array but never the structured `diags`, so an `error` diag
    // raised below them could not reach `has_error_diag`. The single added
    // line forwards `lower_condition_to_i1`'s diags. A raise against the
    // shrink-only rule, called out rather than absorbed: the alternative is
    // an if-condition whose sub-expression failure is silently discarded.
    if path == LOWERING_ROOT + "/instructions_if.sfn" { return 785; }
    if path == LOWERING_ROOT + "/emission.sfn" { return 776; }
    return 0;
}

test "LLVM lowering: every module stays within its line budget" ![io] {
    let mut dir_queue: string[] = [LOWERING_ROOT];
    let mut head: int = 0;
    let mut checked: int = 0;

    loop {
        if head >= dir_queue.length { break; }
        let dir = dir_queue[head];
        head += 1;
        let entries = fs.listDirectory(dir);
        let mut i: int = 0;
        loop {
            if i >= entries.length { break; }
            let entry = entries[i];
            let full = dir + "/" + entry;
            if ends_with(entry, ".sfn") {
                let source = fs.readFile(full);
                assert source.length > 0;
                let lines = _count_lowering_newlines(source);
                assert lines > 0;
                let ceiling = _grandfathered_lowering_ceiling(full);
                if ceiling > 0 { assert lines <= ceiling; } else {
                    assert lines < LOWERING_MODULE_LINE_BUDGET;
                }
                checked += 1;
            } else { dir_queue.push(full); }
            i += 1;
        }
    }

    assert checked > 30;
}

test "LLVM lowering: the flat lowering_core module does not shadow the folder" ![io] {
    assert ! fs.exists(LOWERING_ROOT + "/lowering_core.sfn");
    assert fs.exists(LOWERING_ROOT + "/lowering_core/mod.sfn");
}
