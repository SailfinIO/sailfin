// Unit coverage for the pure helpers in `compiler/src/cli_selfhost.sfn`
// (issue #1502 — `sfn selfhost`). The fixed-point comparator itself is
// covered by `build_report_determinism_test.sfn`; these target the
// selfhost-specific string helpers that feed the smoke gate and the
// `.ll`-dir snapshot loader, plus the argv/env builders that spawn each
// stage child without a shell (SFN-489).
import { expect_eq_bool, expect_eq_str_array } from "sfn/test";

import {
    _selfhost_basename,
    _selfhost_compiler_ir_dir,
    _selfhost_contains,
    _selfhost_env_entry_has_key,
    _selfhost_relative_ll_slug,
    _selfhost_stage_argv,
    _selfhost_stage_env
} from "../../src/cli_selfhost";

test "selfhost paths: compiler IR uses the scoped capsule prefix" {
    assert _selfhost_compiler_ir_dir() == "build/capsules/sfn/compiler/ir";
}

test "selfhost paths: nested IR slugs stay root-relative" {
    let root = "build/capsules/sfn/compiler/ir";
    assert _selfhost_relative_ll_slug(root, root + "/cli/commands/build.ll") == "cli/commands/build.ll";
    assert _selfhost_relative_ll_slug(root + "/", root + "/build/cache.ll") == "build/cache.ll";
    assert _selfhost_relative_ll_slug(root, "elsewhere/mod.ll") == "mod.ll";
}

// --------------------------------------------------------------
// _selfhost_contains — substring scan (smoke-gate grep)
// --------------------------------------------------------------
test "selfhost_contains: finds greeting in combined output" {
    assert _selfhost_contains("prefix\nHello, Sailfin!\nrest", "Hello, Sailfin!");
}

test "selfhost_contains: empty needle is vacuously present" {
    assert _selfhost_contains("anything", "");
}

test "selfhost_contains: needle longer than haystack is absent" {
    assert ! _selfhost_contains("hi", "hello");
}

test "selfhost_contains: match at the very start" {
    assert _selfhost_contains("Hello, Sailfin!", "Hello");
}

test "selfhost_contains: match at the very end" {
    assert _selfhost_contains("run: Hello, Sailfin!", "Sailfin!");
}

test "selfhost_contains: absent needle reports false" {
    assert ! _selfhost_contains("goodbye world", "Sailfin");
}

// --------------------------------------------------------------
// _selfhost_basename — slug for a `.ll` path
// --------------------------------------------------------------
test "selfhost_basename: strips directory components" {
    assert _selfhost_basename("build/selfhost/native-seedcheck/scratch/capsules/sailfin__main.ll") == "sailfin__main.ll";
}

test "selfhost_basename: no slash returns the input" {
    assert _selfhost_basename("sailfin__main.ll") == "sailfin__main.ll";
}

test "selfhost_basename: trailing slash yields empty basename" {
    assert _selfhost_basename("a/b/") == "";
}

// --------------------------------------------------------------
// _selfhost_env_entry_has_key — `"KEY=VALUE"` key match
// --------------------------------------------------------------
test "selfhost_env_entry_has_key: matches a bound key" {
    assert expect_eq_bool(_selfhost_env_entry_has_key("SAILFIN_BOOTSTRAP=off", "SAILFIN_BOOTSTRAP"), true).ok;
}

test "selfhost_env_entry_has_key: matches an empty value" {
    assert expect_eq_bool(_selfhost_env_entry_has_key("SAILFIN_BOOTSTRAP=", "SAILFIN_BOOTSTRAP"), true).ok;
}

test "selfhost_env_entry_has_key: matches a valueless binding" {
    assert expect_eq_bool(_selfhost_env_entry_has_key("SAILFIN_BOOTSTRAP", "SAILFIN_BOOTSTRAP"), true).ok;
}

// The prefix guard that keeps the override filter from dropping unrelated
// variables which merely start with the same characters.
test "selfhost_env_entry_has_key: rejects a longer key sharing a prefix" {
    assert expect_eq_bool(_selfhost_env_entry_has_key("SAILFIN_BOOTSTRAP_MODE=x", "SAILFIN_BOOTSTRAP"), false).ok;
}

test "selfhost_env_entry_has_key: rejects an unrelated key" {
    assert expect_eq_bool(_selfhost_env_entry_has_key("PATH=/usr/bin", "SAILFIN_BOOTSTRAP"), false).ok;
}

// --------------------------------------------------------------
// _selfhost_stage_env — per-stage child environment
//
// The load-bearing helper. Silently losing `SAILFIN_BOOTSTRAP=off` makes
// each stage dispatch to the pinned seed instead of the binary under
// test, subverting the entire fixed-point check while still reporting
// green (SFEP-0047's exact-match bootstrap gate). Losing a distinct
// `SAILFIN_TEST_SCRATCH` collapses both stages onto one `.ll` dir and
// makes the diff vacuous.
//
// These assert the whole array rather than probing for membership: the
// exact contents also pin the ordering and prove no *second* binding for
// either key survives, which membership checks would miss.
// --------------------------------------------------------------
test "selfhost_stage_env: appends both overrides to the inherited env" {
    assert expect_eq_str_array(_selfhost_stage_env(["PATH=/usr/bin", "HOME=/root"], "build/selfhost/s2/scratch"), ["PATH=/usr/bin", "HOME=/root", "SAILFIN_BOOTSTRAP=off", "SAILFIN_TEST_SCRATCH=build/selfhost/s2/scratch"]).ok;
}

// A duplicate key in `envp` resolves unspecified, so an inherited `=on`
// must be dropped, not merely followed by `=off`.
test "selfhost_stage_env: replaces an inherited SAILFIN_BOOTSTRAP" {
    assert expect_eq_str_array(_selfhost_stage_env(["SAILFIN_BOOTSTRAP=on", "PATH=/usr/bin"], "s"), ["PATH=/usr/bin", "SAILFIN_BOOTSTRAP=off", "SAILFIN_TEST_SCRATCH=s"]).ok;
}

test "selfhost_stage_env: replaces an inherited SAILFIN_TEST_SCRATCH" {
    assert expect_eq_str_array(_selfhost_stage_env(["SAILFIN_TEST_SCRATCH=/stale", "PATH=/usr/bin"], "fresh"), ["PATH=/usr/bin", "SAILFIN_BOOTSTRAP=off", "SAILFIN_TEST_SCRATCH=fresh"]).ok;
}

test "selfhost_stage_env: an empty parent env still carries both overrides" {
    assert expect_eq_str_array(_selfhost_stage_env([], "s"), ["SAILFIN_BOOTSTRAP=off", "SAILFIN_TEST_SCRATCH=s"]).ok;
}

test "selfhost_stage_env: keeps a variable that merely shares a prefix" {
    assert expect_eq_str_array(_selfhost_stage_env(["SAILFIN_BOOTSTRAP_MODE=x"], "s"), ["SAILFIN_BOOTSTRAP_MODE=x", "SAILFIN_BOOTSTRAP=off", "SAILFIN_TEST_SCRATCH=s"]).ok;
}

// --------------------------------------------------------------
// _selfhost_stage_argv — the stage build command line
// --------------------------------------------------------------
// Whole-array equality is the point: it pins `argv[0]` to the driver and
// proves no `sh`/`-c` wrapper crept back in.
// The trailing `--skip-toolchain-check` keeps a stage build on the driver
// binary named in `argv[0]` instead of a recorded per-user default
// (SFN-1068, SFEP-0073 §3.3 rank 4); a stage that selected a different
// compiler would not be measuring self-hosting at all.
test "selfhost_stage_argv: invokes the driver directly, with no shell" {
    assert expect_eq_str_array(_selfhost_stage_argv("build/bin/sfn", "build/selfhost/s2", "build/selfhost/s2/bin/sfn"), ["build/bin/sfn", "build", "--no-cache", "-p", "compiler", "--work-dir", "build/selfhost/s2", "-o", "build/selfhost/s2/bin/sfn", "--skip-toolchain-check"]).ok;
}

// Arguments reach `execve` verbatim, so a space stays inside one argument
// instead of being shell-quoted — the former `sh -c` command string
// needed `_shell_single_quote_arg` for exactly this.
test "selfhost_stage_argv: passes a spaced path through unquoted" {
    assert expect_eq_str_array(_selfhost_stage_argv("drv", "work dir", "out bin"), ["drv", "build", "--no-cache", "-p", "compiler", "--work-dir", "work dir", "-o", "out bin", "--skip-toolchain-check"]).ok;
}
