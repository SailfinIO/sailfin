// SFN-1294: extern effect attestations participate in ordinary call checking.
import { validate_effects, validate_recognized_effects } from "sfn/analyzer/effect_checker";
import { typecheck_diagnostics } from "sfn/analyzer/typecheck";
import { parse_program } from "sfn/syntax";

test "extern effects: explicit pure and unattested remain distinct" {
    let program = parse_program("extern fn pure_call() -> i32 ![];\nextern fn unknown_call() -> i32;\n");
    assert program.statements.length == 2;
    let pure_call = program.statements[0];
    let unknown_call = program.statements[1];
    assert pure_call.variant == "ExternFunctionDeclaration";
    assert unknown_call.variant == "ExternFunctionDeclaration";
    assert pure_call.effects_attested;
    assert pure_call.signature.effects.length == 0;
    assert ! unknown_call.effects_attested;
    assert unknown_call.signature.effects.length == 0;
}

test "extern effects: declaration is accepted and caller needs attested net" {
    let program = parse_program("extern fn connect(fd: i32) -> i32 ![net];\nfn caller() -> i32 { return connect(0); }\n");
    let diagnostics = typecheck_diagnostics(program);
    assert diagnostics.length == 0;
    let violations = validate_effects(program);
    assert violations.length == 1;
    assert violations[0].missing_effects.length == 1;
    assert violations[0].missing_effects[0] == "net";
}

test "extern effects: declared parent subsumes attested sub-effect" {
    let program = parse_program("extern fn connect(fd: i32) -> i32 ![net.http];\nfn caller() -> i32 ![net] { return connect(0); }\n");
    assert validate_effects(program).length == 0;
}

test "extern effects: unattested call contributes no requirement" {
    let program = parse_program("extern fn connect(fd: i32) -> i32;\nfn caller() -> i32 { return connect(0); }\n");
    assert validate_effects(program).length == 0;
}

test "extern effects: unknown attested root is rejected" {
    let program = parse_program("extern fn probe() -> i32 ![disk];\n");
    let violations = validate_recognized_effects(program);
    assert violations.length == 1;
    assert violations[0].unrecognized_effects[0] == "disk";
}
