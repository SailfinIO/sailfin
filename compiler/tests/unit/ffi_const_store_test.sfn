// SFN-1296: a `*const T` permits reads but rejects every assignment form.
import { typecheck_diagnostics } from "sfn/analyzer/typecheck";
import { parse_program } from "sfn/syntax";
import { expect_eq_bool } from "sfn/test";

fn _count_const_store(source: string) -> int {
    let diagnostics = typecheck_diagnostics(parse_program(source));
    let mut count: int = 0;
    let mut i: int = 0;
    loop {
        if i >= diagnostics.length { break; }
        if diagnostics[i].code == "E0852" { count += 1; }
        i += 1;
    }
    return count;
}

test "const pointer: deref store is rejected" ![io] {
    let source = "fn write(p: *const i32) { *p = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: member store is rejected" ![io] {
    let source = "struct Box { value: i32; }\n"
        + "fn write(p: *const Box) { p.value = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: compound assignments are rejected" ![io] {
    let source = "struct Box { value: i32; }\n"
        + "fn write(p: *const i32, b: *const Box) { *p += 1; b.value += 1; }";
    assert expect_eq_bool(_count_const_store(source) == 2, true).ok;
}

test "const pointer: a load and mutable pointer stores are accepted" ![io] {
    let source = "struct Box { value: i32; }\n"
        + "fn read(p: *const i32) -> i32 { return *p; }\n"
        + "fn write(p: *i32, b: *mut Box) { *p = 7; b.value = 8; }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}

test "const pointer: cast and pointer arithmetic retain constness" ![io] {
    let source = "fn write(p: *const i32) { *(p + 1) = 3; *(p as *const i32) = 4; }";
    assert expect_eq_bool(_count_const_store(source) == 2, true).ok;
}

test "const pointer: integer-left pointer arithmetic retains constness" ![io] {
    let source = "fn write(p: *const i32) { *(1 + p) = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: indexed pointer element retains inner const" ![io] {
    let source = "fn write(p: **const i32) { *p[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: indexed mutable pointer remains writable" ![io] {
    let source = "fn write(p: *const *mut i32) { p[0][0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}

test "const pointer: a mutable pointer field remains writable" ![io] {
    let source = "struct Inner { value: i32; }\n"
        + "struct Outer { next: *mut Inner; }\n"
        + "fn write(p: *const Outer) { p.next.value = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}

test "const pointer: unannotated aliases preserve read-only status" ![io] {
    let source = "fn write(p: *const i32) { let q = p; let r = q; *r = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: a type alias preserves read-only status" ![io] {
    let source = "type ReadOnly = *const i32;\n"
        + "fn write(p: ReadOnly) { *p = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: generic function parameter shadows a type alias" ![io] {
    let source = "type T = *i32;\n"
        + "fn identity<T>(value: T) -> T { return value; }\n"
        + "fn write(p: *const i32) { identity(p); }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}

test "const pointer: generic method parameter shadows a type alias" ![io] {
    let source = "type T = *i32;\n"
        + "struct Holder { fn echo<T>(self: Holder, value: T) -> T { return value; } }\n"
        + "fn write(h: Holder, p: *const i32) { h.echo(p); }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}

test "const pointer: generic returns retain the argument qualifier" ![io] {
    let source = "type T = *i32;\n"
        + "fn identity<T>(value: T) -> T { return value; }\n"
        + "struct Holder { fn echo<T>(self: Holder, value: T) -> T { return value; } }\n"
        + "fn write(h: Holder, p: *const i32) { *identity(p) = 7; *h.echo(p) = 8; }";
    assert expect_eq_bool(_count_const_store(source) == 2, true).ok;
}

test "const pointer: nested generic argument retains return qualifier" ![io] {
    let source = "struct Box<T> { value: T; }\n"
        + "fn unbox<T>(box: Box<T>) -> T { return box.value; }\n"
        + "fn write(box: Box<*const i32>) { *unbox(box) = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: method generic shadows owner parameter" ![io] {
    let source = "struct Box<T> { value: T;\n"
        + "fn id<T>(self: Box<T>, value: T) -> T { return value; } }\n"
        + "fn write(box: Box<i32>, p: *const i32) { *box.id(p) = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: conditional pointer result remains read-only" ![io] {
    let source = "fn write(p: *const i32, c: bool) { *(c ? p : p) = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: conditional array cannot discard element const" ![io] {
    let source = "fn write(ps: (*const i32)[], ms: (*i32)[], c: bool) {"
        + " let qs: (*i32)[] = c ? ps : ms; *qs[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: conditional generic cannot discard field const" ![io] {
    let source = "struct Holder<T> { ptr: T; }\n"
        + "fn write(a: Holder<*const i32>, b: Holder<*i32>, c: bool) {"
        + " let h: Holder<*i32> = c ? a : b; *h.ptr = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: inferred conditional array keeps element const" ![io] {
    let source = "fn write(ps: (*const i32)[], ms: (*i32)[], c: bool) {"
        + " let qs = c ? ps : ms; *qs[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: complementary conditional generic qualifiers remain read only" ![io] {
    let source = "struct Pair<A, B> { first: A; second: B; }\n"
        + "fn write(a: Pair<*const i32, *i32>, b: Pair<*i32, *const i32>, c: bool) {"
        + " let pair = c ? a : b; *pair.first = 7; *pair.second = 8; }";
    assert expect_eq_bool(_count_const_store(source) == 2, true).ok;
}

test "const pointer: a generic alias preserves read-only status" ![io] {
    let source = "type ReadOnly<T> = *const T;\n"
        + "fn write(p: ReadOnly<i32>) { *p = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: implicit qualifier removal is rejected" ![io] {
    let source = "fn write(p: *const i32) { let q: *i32 = p; *q = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: reassignment cannot discard const" ![io] {
    let source = "fn write(p: *const i32, q: *i32) { q = p; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: method return remains read-only" ![io] {
    let source = "struct Holder { p: *const i32; fn get(self: Holder) -> *const i32 { return self.p; } }\n"
        + "fn write(h: Holder) { *h.get() = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: callable field return remains read-only" ![io] {
    let source = "struct Holder { cb: fn () -> *const i32; }\n"
        + "fn write(h: Holder) { *h.cb() = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: callable field arguments cannot discard const" ![io] {
    let source = "struct Holder { cb: fn (*i32) -> void; }\n"
        + "fn write(h: Holder, p: *const i32) { h.cb(p); }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: function value return cannot discard const" ![io] {
    let source = "fn write(f: fn () -> *const i32) { let g: fn () -> *i32 = f; *g() = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: function value return alias cannot discard const" ![io] {
    let source = "type RO = *const i32;\n"
        + "fn write(f: fn () -> RO) { let g: fn () -> *i32 = f; *g() = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: function value parameters cannot accept a const pointer" ![io] {
    let source = "fn write(f: fn (*i32) -> void) { let g: fn (*const i32) -> void = f; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: function value return remains read-only" ![io] {
    let source = "fn get() -> *const i32 { return 0 as *const i32; }\n"
        + "fn write() { let f: fn () -> *const i32 = get; *f() = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: generic field substitution preserves const" ![io] {
    let source = "struct Holder<T> { p: T; }\n"
        + "fn write(h: *Holder<*const i32>) { *h.p = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: generic identity alias preserves const" ![io] {
    let source = "type Identity<T> = T;\n"
        + "fn write(p: Identity<*const i32>) { *p = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: nested aliases cannot lose inner const" ![io] {
    let source = "type ReadOnly = *const i32;\n"
        + "fn write(p: *ReadOnly) { let q: **i32 = p; **q = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: function arguments cannot discard const" ![io] {
    let source = "fn put(q: *i32) { *q = 7; }\n"
        + "fn write(p: *const i32) { put(p); }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: method arguments cannot discard const" ![io] {
    let source = "struct Sink { fn put(self: Sink, q: *i32) { *q = 7; } }\n"
        + "fn write(s: Sink, p: *const i32) { s.put(p); }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: array element stores remain read only" ![io] {
    let source = "fn write(ps: (*const i32)[]) { *ps[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: writable arrays cannot capture read-only pointers" ![io] {
    let source = "fn write(p: *const i32) { let ps: (*i32)[] = [p]; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: array push cannot discard const" ![io] {
    let source = "fn write(p: *const i32) { let mut ps: (*i32)[] = []; ps.push(p); }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: struct fields cannot discard const" ![io] {
    let source = "struct Holder { ptr: *i32; }\n"
        + "fn write(p: *const i32) { let h = Holder { ptr: p }; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: read-only array slots accept read-only pointers" ![io] {
    let source = "fn write(p: *const i32) { let ps: (*const i32)[] = [p]; }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}

test "const pointer: whole-array assignment cannot remove element const" ![io] {
    let source = "fn write(ps: (*const i32)[]) { let qs: (*i32)[] = ps; *qs[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: indexing a literal retains element const" ![io] {
    let source = "fn write(p: *const i32) { let q: *i32 = [p][0]; *q = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: mixed pointer array literal index retains const" ![io] {
    let source = "fn write(p: *const i32, m: *i32) { let q: *i32 = [p, m][0]; *q = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: inferred array keeps read-only elements" ![io] {
    let source = "fn write(p: *const i32) { let xs = [p]; *xs[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: inferred struct keeps read-only fields" ![io] {
    let source = "struct Holder { ptr: *const i32; }\n"
        + "fn write(p: *const i32) { let h = Holder { ptr: p }; *h.ptr = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: inferred call result keeps read-only struct fields" ![io] {
    let source = "struct Holder { ptr: *const i32; }\n"
        + "fn get() -> Holder { return Holder { ptr: 0 as *const i32 }; }\n"
        + "fn write() { let h = get(); let alias = h; *alias.ptr = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: indexed fields of read-only struct remain read only" ![io] {
    let source = "struct Holder { values: i32[]; }\n"
        + "fn write(p: *const Holder) { p.values[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: indexed read-only array pointee remains read only" ![io] {
    let source = "fn write(p: *const i32[]) { (*p)[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: indexed mutable pointer field remains writable" ![io] {
    let source = "struct Holder { next: *mut i32; }\n"
        + "fn write(p: *const Holder) { p.next[0] = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}

test "const pointer: generic struct literal checks substituted field type" ![io] {
    let source = "struct Box<T> { ptr: T; }\n"
        + "fn write(p: *const i32) { let b = Box<*i32> { ptr: p }; *b.ptr = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: return values cannot discard const" ![io] {
    let source = "fn expose(p: *const i32) -> *i32 { return p; }";
    assert expect_eq_bool(_count_const_store(source) == 1, true).ok;
}

test "const pointer: an explicit cast can change the pointer view" ![io] {
    let source = "fn write(p: *const i32) { let q: *i32 = p as *i32; *q = 7; }";
    assert expect_eq_bool(_count_const_store(source) == 0, true).ok;
}
