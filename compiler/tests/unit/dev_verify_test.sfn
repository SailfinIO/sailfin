// Unit coverage for the pure helpers in
// `compiler/src/cli/commands/dev_verify.sfn` (SFN-725 — `sfn dev verify`,
// SFEP-0014 Phase 6).
//
// These target the two pieces that decide what the verdict block SAYS:
// the exit-status classifier (§3.7) and the flat-scalar scrape that reads
// a child's `--json` sub-envelope back (§3.5). Driving the real five-phase
// pipeline from a test is unaffordable — it is a 15–20 minute self-host —
// and SFEP-0014 §5 records why a recorded transcript would just become the
// next fossil, so the pipeline's *wiring* is covered end-to-end by
// `compiler/tests/e2e/dev_verify_test.sfn` on the phases that fail cheaply,
// and its *decisions* are covered exhaustively here.
import { expect_eq_str, expect_eq_str_array } from "sfn/test";

import {
    _dv_env_without,
    _dv_last_line_containing,
    _dv_scrape_scalar,
    _dv_test_argv
} from "../../src/cli/commands/dev_verify";
import {
    Verdict,
    verdict_classify,
    verdict_json,
    verdict_json_or_null
} from "../../src/cli/verdict";
import { load_workspace_inventory } from "../../src/workspace_inventory";

// --------------------------------------------------------------
// verdict_classify — producer-emitted failure taxonomy
// --------------------------------------------------------------
test "dev verify: a clean exit classifies as no failure" {
    assert expect_eq_str(verdict_classify(0, "build"), "").ok;
    assert expect_eq_str(verdict_classify(0, "test"), "").ok;
}

test "dev verify: exit 2 is a setup error in every phase kind" {
    // SFEP-0003 §3.3 point 6: `2` means the tool never ran.
    assert expect_eq_str(verdict_classify(2, "build"), "setup-error").ok;
    assert expect_eq_str(verdict_classify(2, "test"), "setup-error").ok;
}

test "dev verify: a supervisor deadline classifies as timeout, not oom" {
    // `_dv_run_bounded` remaps its own SIGKILL (137) to 124 before this
    // ever sees it, so 124 is unambiguously OUR deadline.
    assert expect_eq_str(verdict_classify(124, "build"), "timeout").ok;
    assert expect_eq_str(verdict_classify(124, "test"), "timeout").ok;
}

test "dev verify: an unsolicited SIGKILL classifies as oom" {
    // 137 that reaches the classifier was not sent by this supervisor —
    // it is the 8 GiB RLIMIT_AS self-cap or the host OOM killer.
    assert expect_eq_str(verdict_classify(137, "build"), "oom").ok;
    assert expect_eq_str(verdict_classify(137, "test"), "oom").ok;
}

test "dev verify: fatal signals classify as crash" {
    assert expect_eq_str(verdict_classify(139, "test"), "crash").ok;
    assert expect_eq_str(verdict_classify(135, "test"), "crash").ok;
    assert expect_eq_str(verdict_classify(136, "test"), "crash").ok;
    assert expect_eq_str(verdict_classify(132, "test"), "crash").ok;
}

// Windows raises no signals, so the `128 + signal` codes above never
// occur there and every crash arrives as a sign-extended NT status.
// Before these were classified, the `rc < 0` never-ran rule claimed all
// of them and a crashed child was reported as a broken harness.
test "dev verify: an NT fault status classifies as crash" {
    // 0xC0000005 ACCESS_VIOLATION — the Windows counterpart of the 139
    // (SIGSEGV) case above.
    assert expect_eq_str(verdict_classify(-1073741819, "test"), "crash").ok;
    assert expect_eq_str(verdict_classify(-1073741819, "build"), "crash").ok;
    // 0xC0000409 STACK_BUFFER_OVERRUN — what `__fastfail` raises, and
    // what an aborting Sailfin runtime actually produces on Windows.
    assert expect_eq_str(verdict_classify(-1073740791, "test"), "crash").ok;
    // 0xC00000FD STACK_OVERFLOW.
    assert expect_eq_str(verdict_classify(-1073741571, "test"), "crash").ok;
}

// The half that makes the classification mean something: not every
// negative status is a crash, and the ones that are not must keep
// answering `setup-error`.
test "dev verify: a loader NT status is a setup error, not a crash" {
    // 0xC0000135 STATUS_DLL_NOT_FOUND and 0xC0000139
    // STATUS_ENTRYPOINT_NOT_FOUND: the image was never entered, which is
    // the same thing `-1` and `127` mean below.
    assert expect_eq_str(verdict_classify(-1073741515, "test"), "setup-error").ok;
    assert expect_eq_str(verdict_classify(-1073741511, "test"), "setup-error").ok;
}

test "dev verify: a failed spawn is still a setup error" {
    // `run_capture` reports -1 when no process was produced. The NT
    // classification above must not have captured it.
    assert expect_eq_str(verdict_classify(-1, "test"), "setup-error").ok;
    assert expect_eq_str(verdict_classify(127, "test"), "setup-error").ok;
}

test "dev verify: SIGABRT is a test failure, never a crash" {
    // A clean `assert` aborts 134. Classifying it as a crash would send an
    // agent chasing a fault that does not exist.
    assert expect_eq_str(verdict_classify(134, "test"), "test-failure").ok;
}

test "dev verify: a plain non-zero exit splits by phase kind" {
    assert expect_eq_str(verdict_classify(1, "build"), "compile-error").ok;
    assert expect_eq_str(verdict_classify(1, "test"), "test-failure").ok;
}

test "dev verify: a failed spawn is a setup error, not a phase failure" {
    // `run_capture` reports -1 and the handle path reports 127 when no
    // process was ever created. Neither is the tool disagreeing with you.
    assert expect_eq_str(verdict_classify(0 - 1, "build"), "setup-error").ok;
    assert expect_eq_str(verdict_classify(127, "test"), "setup-error").ok;
}

// --------------------------------------------------------------
// _dv_scrape_scalar — flat-scalar read of a child sub-envelope
// --------------------------------------------------------------
//
// The fixture is a real `sailfin-selfhost/1` line in the shape
// `cli_selfhost.sfn::_selfhost_envelope_json` emits.
fn _selfhost_envelope_fixture(failed: string, checked: string, fp: string) -> string {
    return "{\"schema_version\":\"sailfin-selfhost/1\",\"command\":\"selfhost\""
        + ",\"exit_code\":0,\"strict\":false,\"failed_phase\":"
        + failed
        + ",\"fixed_point_checked\":"
        + checked
        + ",\"fixed_point\":"
        + fp
        + ",\"binary_match\":true,\"phases\":[{\"name\":\"stage2\",\"status\":\"pass\""
        + ",\"exit_code\":0}],\"determinism\":null}";
}

test "dev verify: scrapes a quoted string scalar" {
    let env = _selfhost_envelope_fixture("\"stage3\"", "false", "false");
    assert expect_eq_str(_dv_scrape_scalar(env, "failed_phase"), "stage3").ok;
    assert expect_eq_str(_dv_scrape_scalar(env, "command"), "selfhost").ok;
    assert expect_eq_str(_dv_scrape_scalar(env, "schema_version"), "sailfin-selfhost/1").ok;
}

test "dev verify: scrapes bare literals without consuming the separator" {
    let env = _selfhost_envelope_fixture("null", "true", "false");
    assert expect_eq_str(_dv_scrape_scalar(env, "failed_phase"), "null").ok;
    assert expect_eq_str(_dv_scrape_scalar(env, "fixed_point_checked"), "true").ok;
    assert expect_eq_str(_dv_scrape_scalar(env, "fixed_point"), "false").ok;
    assert expect_eq_str(_dv_scrape_scalar(env, "binary_match"), "true").ok;
    assert expect_eq_str(_dv_scrape_scalar(env, "exit_code"), "0").ok;
}

test "dev verify: an absent key scrapes as empty, not as false" {
    // The distinction is load-bearing: `fixed_point` absent means the run
    // never reached the diff, which must NOT read as a mismatch.
    let env = _selfhost_envelope_fixture("\"stage2\"", "false", "false");
    assert expect_eq_str(_dv_scrape_scalar(env, "no_such_key"), "").ok;
    assert expect_eq_str(_dv_scrape_scalar("", "fixed_point"), "").ok;
}

test "dev verify: the nondeterminism predicate needs a completed diff" {
    // status:"warn" / failure:"nondeterminism" fires only when the diff
    // RAN and disagreed — `checked && !fixed_point`.
    let mismatch = _selfhost_envelope_fixture("\"fixed-point\"", "true", "false");
    assert expect_eq_str(_dv_scrape_scalar(mismatch, "fixed_point_checked"), "true").ok;
    assert expect_eq_str(_dv_scrape_scalar(mismatch, "fixed_point"), "false").ok;

    // An early exit (stage2 died) never reached the diff: same
    // `fixed_point:false`, but `checked` is false, so it must classify as
    // the stage failure it is rather than as nondeterminism.
    let early = _selfhost_envelope_fixture("\"stage2\"", "false", "false");
    assert expect_eq_str(_dv_scrape_scalar(early, "fixed_point_checked"), "false").ok;
    assert expect_eq_str(_dv_scrape_scalar(early, "failed_phase"), "stage2").ok;
}

// --------------------------------------------------------------
// _dv_last_line_containing — envelope isolation
// --------------------------------------------------------------
test "dev verify: picks the last matching line out of noisy output" {
    let text = "warning: something\n"
        + "{\"schema_version\":\"sailfin-selfhost/1\",\"failed_phase\":\"stage2\"}\n"
        + "note: retried\n"
        + "{\"schema_version\":\"sailfin-selfhost/1\",\"failed_phase\":\"stage3\"}\n";
    let line = _dv_last_line_containing(text, "\"schema_version\":\"sailfin-selfhost/1\"");
    assert expect_eq_str(_dv_scrape_scalar(line, "failed_phase"), "stage3").ok;
}

test "dev verify: finds a match on an unterminated final line" {
    let text = "banner\n{\"schema_version\":\"sailfin-selfhost/1\",\"failed_phase\":\"stage2\"}";
    let line = _dv_last_line_containing(text, "sailfin-selfhost/1");
    assert expect_eq_str(_dv_scrape_scalar(line, "failed_phase"), "stage2").ok;
}

test "dev verify: no match yields empty" {
    assert expect_eq_str(_dv_last_line_containing("a\nb\nc\n", "sailfin-selfhost/1"), "").ok;
    assert expect_eq_str(_dv_last_line_containing("", "sailfin-selfhost/1"), "").ok;
}

// --------------------------------------------------------------
// verdict_json_or_null — the "" null sentinel
// --------------------------------------------------------------
test "dev verify: empty strings render as JSON null" {
    assert expect_eq_str(verdict_json_or_null(""), "null").ok;
    assert expect_eq_str(verdict_json_or_null("compile"), "\"compile\"").ok;
}

// --------------------------------------------------------------
// _dv_env_without — child-env scrubbing
// --------------------------------------------------------------
test "dev verify: drops an exact key without touching prefixed siblings" {
    let src: string[] = ["PATH=/usr/bin", "SAILFIN_TEST_TIMEOUT=1", "SAILFIN_TEST_TIMEOUTX=keep", "HOME=/root"];
    assert expect_eq_str_array(_dv_env_without(src, "SAILFIN_TEST_TIMEOUT"), ["PATH=/usr/bin", "SAILFIN_TEST_TIMEOUTX=keep", "HOME=/root"]).ok;
}

test "dev verify: scrubbing an absent key is a no-op" {
    let src: string[] = ["PATH=/usr/bin"];
    assert expect_eq_str_array(_dv_env_without(src, "SAILFIN_TEST_TIMEOUT"), ["PATH=/usr/bin"]).ok;
}

// --------------------------------------------------------------
// _dv_test_argv — the cold-backstop invariant
// --------------------------------------------------------------
test "dev verify: full-suite phases always run cold" ![io] {
    // Both full-suite phases exist as COLD backstops (`make check`
    // hard-codes `TEST_BIN_CACHE_FLAGS=--no-test-cache`), so a warm
    // per-test binary cache would defeat the point of running them.
    let inventory = load_workspace_inventory(".");
    let mut expected: string[] = ["build/bin/sfn-seedcheck", "test"];
    let mut i: int = 0;
    loop {
        if i >= inventory.test_roots.length { break; }
        expected.push(inventory.test_roots[i]);
        i += 1;
    }
    expected.push("--no-test-cache");
    assert expect_eq_str_array(_dv_test_argv("build/bin/sfn-seedcheck", 0, false), expected).ok;
}

test "dev verify: an explicit --jobs threads into the suite argv" ![io] {
    let inventory = load_workspace_inventory(".");
    let mut expected: string[] = ["build/bin/sfn", "test"];
    let mut i: int = 0;
    loop {
        if i >= inventory.test_roots.length { break; }
        expected.push(inventory.test_roots[i]);
        i += 1;
    }
    expected.push("--no-test-cache");
    expected.push("--jobs");
    expected.push("4");
    expected.push("--json");
    assert expect_eq_str_array(_dv_test_argv("build/bin/sfn", 4, true), expected).ok;
}

// --------------------------------------------------------------
// verdict_json — the wire shape itself
// --------------------------------------------------------------
//
// Field-at-a-time probes are order- and comma-insensitive, so they would
// pass through a reordering, a doubled separator, or a field dropped
// between two others. This pins the rendered line verbatim, which is what
// makes `docs/reference/run-result-schema.md`'s normative field order
// enforceable rather than advisory. It is also the single assertion that
// proves the trailer and the report file cannot carry two different
// schema literals, since both compose from `verdict_fields`.
test "dev verify: a fully populated verdict renders the documented field order" {
    let v = Verdict {
        host: "sfn dev verify",
        target: "verify",
        status: "fail",
        failure: "test-failure",
        phase: "tests-seedcheck",
        first_error: "tests-seedcheck",
        report: "build/agent-report.verify.json"
    };
    assert expect_eq_str(verdict_json(v), "{\"schema_version\":\"sailfin-run/2\",\"host\":\"sfn dev verify\",\"target\":\"verify\",\"status\":\"fail\",\"failure\":\"test-failure\",\"phase\":\"tests-seedcheck\",\"first_error\":\"tests-seedcheck\",\"report\":\"build/agent-report.verify.json\"}").ok;
}

test "dev verify: a clean verdict renders its nullable fields as JSON null" {
    let v = Verdict {
        host: "sfn dev verify",
        target: "verify",
        status: "pass",
        failure: "",
        phase: "",
        first_error: "",
        report: "build/agent-report.verify.json"
    };
    assert expect_eq_str(verdict_json(v), "{\"schema_version\":\"sailfin-run/2\",\"host\":\"sfn dev verify\",\"target\":\"verify\",\"status\":\"pass\",\"failure\":null,\"phase\":null,\"first_error\":null,\"report\":\"build/agent-report.verify.json\"}").ok;
}
