// SFN-930: relative traversal and manifest discovery must converge on the
// same source-identity service for binary, library, and runtime members.
import { module_name_for_source_with_members } from "../../src/capsule_resolver/identity";
import { WorkspaceMember } from "../../src/capsule_resolver/types";

fn _member(name: string, path: string, root: string, kind: string, prefix: string) -> WorkspaceMember {
    return WorkspaceMember {
        name: name,
        member_path: path,
        src_dir: root,
        build_kind: kind,
        module_prefix: prefix,
        implicit: false
    };
}

fn _members() -> WorkspaceMember[] {
    let mut out: WorkspaceMember[] = [];
    out.push(_member("sfn/compiler", "compiler", "compiler/src", "binary", ""));
    out.push(_member("sfn/crypto", "capsules/sfn/crypto", "capsules/sfn/crypto/src", "library", ""));
    out.push(_member("sfn/runtime-native", "runtime", "runtime/sfn", "runtime", "runtime/sfn"));
    return out;
}

test "relative identity: selected binary source is source-root relative" {
    assert module_name_for_source_with_members("compiler/src/llvm/lowering/abi_hash.sfn", _members()) == "llvm/lowering/abi_hash";
}

test "relative identity: library source is manifest prefixed" {
    assert module_name_for_source_with_members("capsules/sfn/crypto/src/util/hex.sfn", _members()) == "sfn/crypto/util/hex";
}

test "relative identity: runtime source uses declared virtual prefix" {
    assert module_name_for_source_with_members("runtime/sfn/memory/arena.sfn", _members()) == "runtime/sfn/memory/arena";
}

test "relative identity: arbitrary member root uses manifest name" {
    let mut members: WorkspaceMember[] = [];
    members.push(_member("sfn/syntax", "/workspace/private/parser", "/workspace/private/parser/src", "library", ""));
    assert module_name_for_source_with_members("/workspace/private/parser/src/ast/mod.sfn", members) == "sfn/syntax/ast/mod";
}

test "relative identity: longest owning source root wins" {
    let mut members: WorkspaceMember[] = [];
    members.push(_member("sfn/outer", "/workspace/outer", "/workspace/outer/src", "library", ""));
    members.push(_member("sfn/nested", "/workspace/outer/src/vendor", "/workspace/outer/src/vendor/src", "library", ""));
    assert module_name_for_source_with_members("/workspace/outer/src/vendor/src/mod.sfn", members) == "sfn/nested/mod";
}

test "relative identity: non-member source uses repository-agnostic fallback" {
    assert module_name_for_source_with_members("fixtures/helper.sfn", _members()) == "fixtures/helper";
}
