// Unit test for `_strip_trailing_slashes_cmd` — the path-normalization
// helper extracted from `_collect_sfn_files_cmd` to make the regression
// for `sfn check compiler/src/` (trailing slash → double-slashed paths
// → SIGSEGV) cheaply testable without a full-tree e2e invocation.
//
// The e2e test (`compiler/tests/e2e/test_check_compiler_src.sh`) used
// to run the full 132-file analysis loop twice — once per slash form
// — to gate this regression. Each invocation costs ~2 min on Linux
// CI. This unit test gates the same logic in milliseconds, so the
// e2e test now runs the canonical scenario exactly once.
import { starts_with } from "sfn/strings";

import {
    _atomic_rename_into_place,
    _copy_file,
    _dirname_cmd,
    _mktemp_from_template_cmd,
    _mktemp_sibling_cmd,
    _publish_lines_atomic,
    _sha256_of_file_cmd,
    _strip_trailing_slashes_cmd
} from "../../src/build/fs";
import { _collect_test_files_cmd, _suite_name_from_path } from "../../src/cli/commands/test/discovery";

test "path-norm: bare directory unchanged" {
    assert _strip_trailing_slashes_cmd("compiler/src") == "compiler/src";
}

test "path-norm: single trailing slash stripped" {
    assert _strip_trailing_slashes_cmd("compiler/src/") == "compiler/src";
}

test "path-norm: multiple trailing slashes stripped" {
    assert _strip_trailing_slashes_cmd("compiler/src///") == "compiler/src";
}

test "path-norm: root '/' preserved" {
    assert _strip_trailing_slashes_cmd("/") == "/";
}

test "path-norm: empty string unchanged" {
    assert _strip_trailing_slashes_cmd("") == "";
}

test "path-norm: single character preserved" {
    assert _strip_trailing_slashes_cmd("x") == "x";
}

test "path-norm: relative path with trailing slash" {
    assert _strip_trailing_slashes_cmd("./foo/bar/") == "./foo/bar";
}

test "path-norm: absolute path with trailing slash" {
    assert _strip_trailing_slashes_cmd("/usr/local/lib/") == "/usr/local/lib";
}

test "path-norm: idempotent (double application)" {
    let once = _strip_trailing_slashes_cmd("compiler/src/");
    let twice = _strip_trailing_slashes_cmd(once);
    assert once == twice;
}

test "path-norm: no internal slashes touched" {
    assert _strip_trailing_slashes_cmd("a/b/c/d") == "a/b/c/d";
}

// Regression: `sfn test compiler/tests/unit/` (trailing slash) used
// to produce paths like `compiler/tests/unit//foo_test.sfn`, which
// `_cr_resolve_and_dedupe`'s relative-import walker could not
// navigate. The resolver returned `deps=0` and the now-deleted
// `llvm-objcopy --weaken` block in `_clang_link_test_cmd_with_deps`
// silently masked every "missing" symbol with the weakened
// self-hosted compiler binary. After normalizing `root` at the top
// of `_collect_test_files_cmd` (mirroring the Phase 5a fix to
// `_collect_sfn_files_cmd`), the slash-form invariant holds: the
// returned file list contains no `//` substrings regardless of how
// the user spells the root directory.
test "collect-test-files: trailing slash on root produces clean paths" ![io] {
    let with_slash = _collect_test_files_cmd("compiler/tests/unit/", 25);
    assert with_slash.length > 0;
    let mut i: int = 0;
    loop {
        if i >= with_slash.length { break; }
        let p = with_slash[i];
        let mut j: int = 0;
        loop {
            if j + 1 >= p.length { break; }
            // No "//" should appear anywhere in any returned path.
            // Pre-fix, paths looked like `compiler/tests/unit//foo_test.sfn`.
            assert ! (p[j] == "/" && p[j + 1] == "/");
            j += 1;
        }
        i += 1;
    }
}

test "collect-test-files: trailing-slash and bare root produce identical lists" ![io] {
    let bare = _collect_test_files_cmd("compiler/tests/unit", 25);
    let with_slash = _collect_test_files_cmd("compiler/tests/unit/", 25);
    assert bare.length == with_slash.length;
    let mut i: int = 0;
    loop {
        if i >= bare.length { break; }
        assert bare[i] == with_slash[i];
        i += 1;
    }
}

// `_suite_name_from_path` derives the per-suite banner label that
// `_emit_suite_banners` prints (issue #848 — the four Makefile
// shell-loop banners moved into `handle_test_command`). Same
// canonical labels regardless of how the user spells the path —
// trailing slashes, bare names, relative prefixes, all collapse to
// the directory's basename.
test "suite-name: bare directory yields basename" {
    assert _suite_name_from_path("compiler/tests/unit") == "unit";
    assert _suite_name_from_path("compiler/tests/integration") == "integration";
    assert _suite_name_from_path("compiler/tests/e2e") == "e2e";
}

test "suite-name: single segment returns itself" {
    assert _suite_name_from_path("capsules") == "capsules";
}

test "suite-name: trailing slash stripped" {
    assert _suite_name_from_path("compiler/tests/unit/") == "unit";
    assert _suite_name_from_path("capsules///") == "capsules";
}

test "suite-name: empty path degenerates to '.'" {
    assert _suite_name_from_path("") == ".";
}

test "suite-name: dot stays dot" { assert _suite_name_from_path(".") == "."; }

test "suite-name: relative prefix discarded" {
    assert _suite_name_from_path("./foo/bar") == "bar";
}

// --------------------------------------------------------------
// Atomic-publish primitives (#1011 / #1034)
// --------------------------------------------------------------
// `_mktemp_sibling_cmd` + `_atomic_rename_into_place` underpin the
// race-free staging/cache publish: write to a temp BESIDE the
// destination (same filesystem → atomic `mv`), then rename. These
// gate the same-directory invariant — a temp in `/tmp` would make
// `mv` a non-atomic cross-device copy and reintroduce the torn-read
// race. `_dirname_cmd` edge cases are locked because the temp's
// directory is derived from it.
test "dirname: nested path returns parent dir" {
    assert _dirname_cmd("build/cache/v1/ab/mod.ll") == "build/cache/v1/ab";
}

test "dirname: no slash returns dot" { assert _dirname_cmd("mod.ll") == "."; }

test "dirname: top-level absolute returns root" {
    assert _dirname_cmd("/mod.ll") == "/";
}

test "atomic-publish: temp lives in dest dir and rename round-trips" ![io] {
    let scratch = "/tmp/sfn_atomic_publish_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let dst = scratch + "/artifact.ll";

    // The temp MUST be a sibling of `dst` (same dir) so the later
    // `mv` is an atomic same-filesystem rename, not a cross-device copy.
    let tmp = _mktemp_sibling_cmd(dst);
    assert tmp.length > 0;
    assert _dirname_cmd(tmp) == scratch;

    fs.writeFile(tmp, "; published");
    assert _atomic_rename_into_place(tmp, dst);
    assert fs.exists(dst);
    assert fs.readFile(dst) == "; published";
    // The rename consumed the temp — it must not linger as a partial
    // sibling a concurrent reader could pick up.
    assert ! fs.exists(tmp);

    process.run(["rm", "-rf", scratch]);
}

// SFN-720: the test above publishes onto an ABSENT destination, which
// is why the Windows defect survived — the CRT's `rename()` succeeds
// exactly once per destination and then fails `EEXIST`, where POSIX
// `rename(2)` replaces atomically. Republishing is the overwhelmingly
// common case in this toolchain (every incremental rebuild, every
// cache refresh, every `sfn selfhost` after the first), so pin it.
//
// This asserts a property, not a platform: on POSIX it always held; on
// Windows it holds only because `_atomic_rename_into_place` now routes
// through `sfn_rename_replace`, whose Windows sibling uses
// `MoveFileExA` + `MOVEFILE_REPLACE_EXISTING`.
test "atomic-publish: a second publish REPLACES an existing destination" ![io] {
    let scratch = "/tmp/sfn_atomic_republish_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let dst = scratch + "/artifact.ll";

    let first = _mktemp_sibling_cmd(dst);
    assert first.length > 0;
    fs.writeFile(first, "; first");
    assert _atomic_rename_into_place(first, dst);
    assert fs.readFile(dst) == "; first";

    // The destination now EXISTS. This is the case that failed on
    // Windows.
    let second = _mktemp_sibling_cmd(dst);
    assert second.length > 0;
    fs.writeFile(second, "; second");
    assert _atomic_rename_into_place(second, dst);
    assert fs.exists(dst);
    assert fs.readFile(dst) == "; second";
    assert ! fs.exists(second);

    // A third, to catch a fix that special-cases only the first
    // overwrite (e.g. a delete-then-rename that leaves stale state).
    let third = _mktemp_sibling_cmd(dst);
    assert third.length > 0;
    fs.writeFile(third, "; third");
    assert _atomic_rename_into_place(third, dst);
    assert fs.readFile(dst) == "; third";

    process.run(["rm", "-rf", scratch]);
}

// `_mktemp_sibling_cmd` mints its name into a `calloc(n + 1)` buffer
// that libc rewrites in place, then hands the raw pointer back as a
// `string` whose length is recovered by scanning for the NUL. An
// off-by-one in the sizing, or a lost terminator, would still satisfy
// the `length > 0` and dirname checks above, so pin the exact length
// and the `O_EXCL` uniqueness contract directly (SFN-490).
test "atomic-publish: temp name is template-length and unique per call" ![io] {
    let scratch = "/tmp/sfn_mktemp_sibling_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let dst = scratch + "/artifact.ll";

    let first = _mktemp_sibling_cmd(dst);
    let second = _mktemp_sibling_cmd(dst);
    assert first.length == (scratch + "/.sfn_stage.XXXXXX").length;
    assert second.length == first.length;
    // `mkstemp` creates with `O_EXCL`, so two calls cannot collide.
    assert first != second;
    assert fs.exists(first);
    assert fs.exists(second);

    process.run(["rm", "-rf", scratch]);
}

// `_mktemp_from_template_cmd` is the libc `mkstemp` primitive the
// staging mint is built on: `_mktemp_sibling_cmd` wraps it for the
// sibling case every emit publish uses (SFN-506). The assertions above
// hold for a shell `mktemp` too, so they cannot tell the two
// implementations apart — these pin the libc contract itself.
test "temp-mint: explicit template yields an exact-length unique file" ![io] {
    let scratch = "/tmp/sfn_mktemp_template_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);

    let template = scratch + "/probe.XXXXXX";
    let first = _mktemp_from_template_cmd(template);
    let second = _mktemp_from_template_cmd(template);

    // `mkstemp` rewrites the six trailing `X`s in place, so the minted
    // name is exactly as long as the template — an off-by-one in the
    // `calloc(n + 1)` sizing or a lost NUL terminator would show here.
    assert first.length == template.length;
    assert second.length == template.length;
    // Created `O_EXCL`, so two calls can never collide.
    assert first != second;
    assert fs.exists(first);
    assert fs.exists(second);

    process.run(["rm", "-rf", scratch]);
}

// There is deliberately no test pinning what a template lacking the
// trailing `XXXXXX` does: it is not portable. glibc rejects it with
// EINVAL, while BSD/Darwin's `_gettemp` finds no `X`s to substitute
// and creates the literal path verbatim — a predictable, non-unique
// name. Every caller supplies a six-`X` template, so the divergence is
// unreachable; asserting either behaviour would pin a libc quirk
// rather than this helper's contract.
// A mint into a directory that does not exist must degrade rather than
// fabricate a path — this is the branch `_cr_run_parallel_emit` relies
// on to fall back to a non-atomic in-place write, and the branch that
// would silently disable atomic publishing for an entire build if it
// ever returned a non-empty path.
test "temp-mint: missing directory degrades to empty" ![io] {
    assert _mktemp_from_template_cmd("/tmp/sfn_mktemp_absent_dir/probe.XXXXXX") == "";
}

// --------------------------------------------------------------
// `_copy_file` (SFN-490) — chunked libc copy underpinning artifact
// publish. The digest comparison is the load-bearing assertion: a
// truncated or duplicated chunk would still leave `dst` present but
// with a different SHA-256 than `src`.
// --------------------------------------------------------------
test "copy-file: multi-chunk payload round-trips byte-for-byte" ![io] {
    let scratch = "/tmp/sfn_copy_file_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let src = scratch + "/src.bin";
    let dst = scratch + "/dst.bin";

    // Double a seed string past 3 chunk boundaries (196608 bytes) so
    // the copy loop runs several full iterations and ends on a
    // partial chunk.
    let mut payload = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd";
    let mut guard = 0;
    loop {
        if payload.length > 200000 { break; }
        guard += 1;
        if guard > 20 { break; }
        payload = payload + payload;
    }

    fs.writeFile(src, payload);
    assert _copy_file(src, dst);
    assert fs.exists(dst);

    let src_digest = _sha256_of_file_cmd(src);
    let dst_digest = _sha256_of_file_cmd(dst);
    // Guard against a vacuous pass: `_sha256_of_file_cmd` returns ""
    // on a read failure, so two empty strings would satisfy a bare
    // equality without proving anything.
    assert src_digest.length > 0;
    assert dst_digest.length > 0;
    assert src_digest == dst_digest;

    process.run(["rm", "-rf", scratch]);
}

test "copy-file: missing source returns false" ![io] {
    let scratch = "/tmp/sfn_copy_file_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let src = scratch + "/does-not-exist.bin";
    let dst = scratch + "/dst.bin";

    assert ! _copy_file(src, dst);
    assert ! fs.exists(dst);

    process.run(["rm", "-rf", scratch]);
}

test "copy-file: overwrites an existing destination" ![io] {
    let scratch = "/tmp/sfn_copy_file_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let src = scratch + "/src.bin";
    let dst = scratch + "/dst.bin";

    fs.writeFile(src, "short");
    fs.writeFile(dst, "this pre-existing destination content is much longer");

    // A wrong "ab" mode would append rather than truncate, leaving
    // stale bytes from the pre-existing longer content behind.
    assert _copy_file(src, dst);
    assert fs.readFile(dst) == "short";

    process.run(["rm", "-rf", scratch]);
}

// --------------------------------------------------------------
// `_publish_lines_atomic` (SFN-578) — the IR emit publish path.
// --------------------------------------------------------------
// Composes the mint + rename primitives above into the helper both IR
// emit call sites use, so a partially-written `.ll`/`.sfn-asm` is never
// observable at the destination. Unobservability itself cannot be
// asserted without a real race, so these pin the mechanism: the exact
// published bytes, and that every failure path is both *reported* and
// leaves no `.sfn_stage.*` sibling behind. The reported-failure case is
// the one that justifies publishing at this layer rather than inside
// the `-> void` runtime writer, which cannot report anything.
// Counts leftover staging siblings in `dir`, so a publish that failed to
// clean up after itself is distinguishable from one that succeeded.
fn _stage_residue_count(dir: string) -> int ![io] {
    if !fs.exists(dir) { return 0; }
    let entries = fs.listDirectory(dir);
    let mut found: int = 0;
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        if starts_with(entries[i], ".sfn_stage.") { found += 1; }
        i += 1;
    }
    return found;
}

test "publish-lines: writes exact content and leaves no staging residue" ![io] {
    let scratch = "/tmp/sfn_publish_lines_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let dst = scratch + "/artifact.ll";

    assert _publish_lines_atomic(dst, ["; header", "define i32 @main() {", "}"]);
    assert fs.exists(dst);
    // `fs.writeLines` terminates every line, including the last, so the
    // published payload ends with a trailing newline.
    assert fs.readFile(dst) == "; header\ndefine i32 @main() {\n}\n";
    assert _stage_residue_count(scratch) == 0;

    process.run(["rm", "-rf", scratch]);
}

test "publish-lines: replaces an existing destination" ![io] {
    let scratch = "/tmp/sfn_publish_lines_replace_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let dst = scratch + "/artifact.ll";

    fs.writeFile(dst, "; a previous build's output, considerably longer\n");
    // `rename` replaces the destination wholesale, so no stale tail from
    // the longer prior content may survive.
    assert _publish_lines_atomic(dst, ["; fresh"]);
    assert fs.readFile(dst) == "; fresh\n";
    assert _stage_residue_count(scratch) == 0;

    process.run(["rm", "-rf", scratch]);
}

test "publish-lines: empty array publishes a zero-length artifact" ![io] {
    let scratch = "/tmp/sfn_publish_lines_empty_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let dst = scratch + "/artifact.ll";

    // Preserves the pre-SFN-578 `write_llvm_lines_chunked` contract: an
    // empty line array is a successful zero-length publish, not a failure.
    assert _publish_lines_atomic(dst, []);
    assert fs.exists(dst);
    assert fs.readFile(dst) == "";
    assert _stage_residue_count(scratch) == 0;

    process.run(["rm", "-rf", scratch]);
}

test "publish-lines: destination in a missing directory is reported as failure" ![io] {
    let scratch = "/tmp/sfn_publish_lines_absent_test";
    process.run(["rm", "-rf", scratch]);
    let dst = scratch + "/nested/artifact.ll";

    // The mint degrades to "" for a missing parent, the in-place fallback
    // `fopen` then fails too, and the helper must return false rather
    // than report a publish that never happened. This is the assertion
    // the `-> void` runtime writer structurally cannot make.
    assert ! _publish_lines_atomic(dst, ["; unreachable"]);
    assert ! fs.exists(dst);

    process.run(["rm", "-rf", scratch]);
}

test "publish-lines: a failed rename is reported and leaves no residue" ![io] {
    let scratch = "/tmp/sfn_publish_lines_rename_fail_test";
    process.run(["rm", "-rf", scratch]);
    process.run(["mkdir", "-p", scratch]);
    let dst = scratch + "/artifact.ll";

    // A directory destination fails `rename(2)` with EISDIR while the
    // sibling mint and the staged write both succeed — the only way to
    // reach the rename-failure branch without fault injection.
    process.run(["mkdir", "-p", dst]);
    assert ! _publish_lines_atomic(dst, ["; staged but never published"]);
    // `_atomic_rename_into_place` removes the temp on rename failure, so a
    // caller retrying into the same directory sees no stale sibling.
    assert _stage_residue_count(scratch) == 0;
    // The destination survives: the failure path's `fs.deleteFile` is
    // `unlink(2)`, which refuses a directory. The publish is still
    // correctly reported as failed, which is what callers act on.
    assert fs.exists(dst);

    process.run(["rm", "-rf", scratch]);
}
