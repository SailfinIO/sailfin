// Unit tests for the `secure_zero` builtin (SFN-782, design SFEP-0069
// §3.6). `secure_zero(addr: int, len: int) -> void` writes zero to every
// byte in `[addr, addr + len)` with volatile stores the optimizer may not
// delete, shorten, merge, or reorder against other volatile operations —
// the erase-key-material guarantee an ordinary array overwrite cannot make.
//
// Two layers of coverage, mirroring `byte_load_lowering_test.sfn`:
//   1. Predicate surface — `is_secure_zero_builtin` gates the dispatch
//      hook (compiler/src/llvm/secure_zero.sfn). A regression that
//      loosens it to a prefix/suffix match is caught here.
//   2. Golden-IR shape — the guarded volatile byte-store loop, pinned
//      in-process via parse → emit_native → lower_to_llvm_ir. ONE
//      lowering call for the file (the suite's per-process memory budget
//      makes multiple lowerings a poor trade).
import { validate_effects } from "sfn/analyzer/effect_checker";
import { parse_program } from "sfn/syntax";

import { empty_llvm_import_context, resolve_llvm_provider_context } from "../../src/build/llvm_provider_context";
import { emit_native_text_with_module_name } from "../../src/codegen_driver";
import { lower_to_llvm_ir_from_text_with_provider_context } from "../../src/llvm/lowering/entrypoints";
import { is_secure_zero_builtin } from "../../src/llvm/secure_zero";
import { index_of } from "../../src/string_utils";

fn _contains(haystack: string, needle: string) -> boolean {
    return index_of(haystack, needle) >= 0;
}

// ── Predicate recognises the reserved name ──
test "secure zero: is_secure_zero_builtin recognises secure_zero" {
    assert is_secure_zero_builtin("secure_zero");
}

test "secure zero: is_secure_zero_builtin tolerates surrounding whitespace" {
    assert is_secure_zero_builtin("  secure_zero  ");
}

// ── Predicate rejects non-matching / near-miss identifiers ──
test "secure zero: is_secure_zero_builtin rejects unrelated identifiers" {
    assert ! is_secure_zero_builtin("");
    assert ! is_secure_zero_builtin("load_byte");
    assert ! is_secure_zero_builtin("zero");
}

test "secure zero: is_secure_zero_builtin rejects partial / near-miss names" {
    // Defence against a future regression that loosens the predicate to
    // a startsWith / endsWith match — only the exact name should fire.
    assert ! is_secure_zero_builtin("secure_zero_x");
}

// ── Golden-IR shape ──
// `secure_zero(addr, len)` lowers to a preheader that null/length-guards
// the loop, a body block with a phi-carried index and a
// `store volatile i8 0` at each element, and a done block the guard can
// jump straight to. Assert the stable opcodes and label stems (per the
// template documented at the top of `secure_zero.sfn`), not exact SSA
// register names or the `_N` label suffix, which are allocator-dependent.
test "secure zero: lowering emits a volatile byte-store loop" ![io] {
    let source = "fn wipe(addr: int, len: int) -> void {\n"
        + "    secure_zero(addr, len);\n"
        + "}";
    let program = parse_program(source);
    let native = emit_native_text_with_module_name(program, "secure_zero_test");
    let ir = lower_to_llvm_ir_from_text_with_provider_context(native, "secure_zero_test", empty_llvm_import_context(), resolve_llvm_provider_context());

    assert _contains(ir, "store volatile i8 0");
    assert _contains(ir, "align 1");
    assert _contains(ir, "getelementptr i8, i8*");
    assert _contains(ir, "inttoptr i64");
    assert _contains(ir, "phi i64");
    // Length guard: the loop is entered only when `len > 0`.
    assert _contains(ir, "icmp sgt i64");
    // Null-address guard: the loop is entered only when `addr != 0`.
    assert _contains(ir, "icmp ne i64");
    assert _contains(ir, "secure_zero_body_");
    assert _contains(ir, "secure_zero_done_");
    // The preheader edge is the whole reason this lowering can use a phi
    // instead of an `alloca` accumulator (see the header comment in
    // `secure_zero.sfn`): both phi incoming edges must be statically
    // known. `"phi i64"` alone does not pin that the zero-initialized
    // edge actually arrives from the preheader block — this substring
    // ties the literal `[ 0, ...]` incoming value to the
    // `%secure_zero_pre_` label, catching a malformed phi (e.g. a
    // swapped or dropped preheader edge) that the looser checks above
    // would miss.
    assert _contains(ir, "[ 0, %secure_zero_pre_");
}

// ── Effect-neutrality (SFEP-0069 §4) ──
// `secure_zero` adds no effect atom of its own: a function that calls it
// with no effect annotation must type/effect-check clean. This guards
// against a future change to the effect registry silently attaching an
// effect to the reserved name. Uses the (cheap) AST-level effect checker
// directly, not a second `lower_to_llvm_ir_*` call — the golden-IR test
// above is the one lowering call this file's memory budget allows.
test "secure zero: calling secure_zero with no effect annotation type/effect-checks clean" {
    let source = "fn wipe(addr: int, len: int) -> void {\n"
        + "    secure_zero(addr, len);\n"
        + "}";
    let program = parse_program(source);
    let violations = validate_effects(program);
    assert violations.length == 0;
}
