import {
    is_syscall_builtin,
    render_syscall_constraints,
    syscall_contract_error
} from "../../src/llvm/syscall";
import { index_of } from "../../src/string_utils";

fn _contains(text: string, needle: string) -> boolean {
    return index_of(text, needle) >= 0;
}

test "syscall: reserves the complete arity family" {
    assert is_syscall_builtin("syscall1");
    assert is_syscall_builtin("syscall2");
    assert is_syscall_builtin("syscall3");
    assert is_syscall_builtin("syscall4");
    assert is_syscall_builtin("syscall5");
    assert is_syscall_builtin("syscall6");
    assert ! is_syscall_builtin("syscall0");
    assert ! is_syscall_builtin("syscall7");
}

test "syscall: rejects callers outside the owned runtime module" {
    let error = syscall_contract_error("syscall1", 2, "main", "Linux", "x86_64");
    assert _contains(error, "runtime/sfn/platform/syscall_linux.sfn");
}

test "syscall: rejects unsupported operating systems and architectures" {
    assert _contains(syscall_contract_error("syscall1", 2, "runtime/sfn/platform/syscall_linux", "Darwin", "x86_64"), "Linux x86-64");
    assert _contains(syscall_contract_error("syscall1", 2, "runtime/sfn/platform/syscall_linux", "Linux", "aarch64"), "Linux x86-64");
}

test "syscall: constraint renderer pins registers and clobbers" {
    assert render_syscall_constraints(2) == "={rax},{rax},{rdi},~{rcx},~{r11},~{memory}";
    assert render_syscall_constraints(3) == "={rax},{rax},{rdi},{rsi},~{rcx},~{r11},~{memory}";
    assert render_syscall_constraints(4) == "={rax},{rax},{rdi},{rsi},{rdx},~{rcx},~{r11},~{memory}";
    assert render_syscall_constraints(5) == "={rax},{rax},{rdi},{rsi},{rdx},{r10},~{rcx},~{r11},~{memory}";
    assert render_syscall_constraints(6) == "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},~{rcx},~{r11},~{memory}";
    assert render_syscall_constraints(7) == "={rax},{rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}";
}
