// Regression tests for the `sfn check` analysis orchestrator's pure
// string-building helpers.
//
// Import envelope (corrects this file's prior header):
// The blocker for importing real `compiler/src` symbols here is
// *import-closure size*, NOT a linker incapacity and NOT the
// `char_code` / `string_utils → runtime` chain the old comment blamed.
// The `sfn test` runner links `runtime/prelude` (which exports
// `char_code`) into every test via `assemble_runtime_capsule_link_inputs`
// (`compiler/src/cli_commands.sfn:51,176`), so the runtime chain always
// resolves. What costs is the transitive `from "..."` closure the
// resolver must compile + link for an imported symbol's home module.
//
//   - `join_effects` and `code_for_missing_effect` live in
//     `diagnostics_render.sfn`, whose closure is light (~8 modules:
//     effect_checker, string_utils, token, typecheck_types). These are
//     imported below and exercised against the REAL exported symbols.
//   - `int_to_string` and `render_summary` are now also imported from
//     the real source. #986 first extracted integer formatting out of
//     `main.sfn` into a compiler-private leaf module; SFN-735 retired
//     that module for `sfn/strings::int_to_string`, whose closure is
//     that one capsule plus the prelude globals it uses (`substring`,
//     `strings_equal`, `char_code`) — and per the paragraph above the
//     runner links `runtime/prelude` into every test regardless, so
//     that half costs nothing here. Either way `main.sfn`'s full
//     ~130-module backend stays out of `tools/check.sfn`'s closure, so
//     `render_summary` (`tools/check.sfn`) is unit-test-linkable. The
//     old `_local_num_to_string` / `_local_render_summary` mirrors are
//     deleted.
//
// See docs/conventions/unit-test-import-envelope.md for the supported
// test-import envelope, and docs/proposals/design-notes/unit-test-import-envelope.md
// for the full root-cause analysis (#619, #986).
// -------------------------------------------------------------------
// Imports — real exported symbols (light closure via diagnostics_render)
// -------------------------------------------------------------------
import { AnalyzerInput, analyze_program } from "sfn/analyzer";
import { EffectRequirement } from "sfn/analyzer/effect_checker/types";
import { empty_import_symbols } from "sfn/analyzer/effect_imports";
import {
    ClosureSymbolSet,
    ImportResolutionContext,
    collect_import_resolution_findings
} from "sfn/analyzer/import_resolution_check";
import {
    append_intrinsic_effects,
    empty_intrinsic_effects,
    intrinsic_effects_for_callee_target
} from "sfn/ir";
import { int_to_string } from "sfn/strings";
import { ImportSpecifier, Program, Statement } from "sfn/syntax";

import { code_for_missing_effect, join_effects } from "../../src/diagnostics_render";
import { CheckSummary, render_summary } from "../../src/tools/check";

// -------------------------------------------------------------------
// Tests — pure analyzer facade
// -------------------------------------------------------------------
test "check: analyzer facade accepts resolved parsed input without authority" {
    let statements: Statement[] = [];
    let interfaces: Statement[] = [];
    let names: string[] = [];
    let globals: string[] = [];
    let capabilities: string[] = [];
    let resolved_specs: string[] = [];
    let result = analyze_program(AnalyzerInput {
        program: Program { statements: statements }, file_path: "clean.sfn", imported_interfaces: interfaces, imported_symbols: empty_import_symbols(), prelude_globals: globals, capabilities_required: capabilities, capabilities_declared: false, capabilities_dev_required: capabilities, import_context: ImportResolutionContext {
            closure_symbols: ClosureSymbolSet { names: names, complete: true }, resolved_relative_specs: resolved_specs, resolved_capsule_specs: [], capsule_specs_known: false
        }, intrinsic_effects: empty_intrinsic_effects(), allow_bare_assert: false, effect_severity: "error", implicit_symbols: [], imported_structs: []
    });
    assert result.diagnostics.length == 0;
    assert result.error_count == 0;
    assert result.warning_count == 0;
    assert result.analyzed_program.program.statements.length == 0;
}

test "check: analyzer facade imports no driver, codegen, or LLVM modules" ![io] {
    let source = fs.readFile("compiler/capsules/analyzer/src/analyzer.sfn");
    let effect_diagnostics = fs.readFile("compiler/capsules/analyzer/src/effect_diagnostics.sfn");
    let effect_collector = fs.readFile("compiler/capsules/analyzer/src/effect_checker/collector.sfn");
    let import_checker = fs.readFile("compiler/capsules/analyzer/src/import_resolution_check.sfn");
    let ownership_checker = fs.readFile("compiler/capsules/analyzer/src/ownership_checker.sfn");
    assert ! _contains(source, "![io");
    assert ! _contains(source, "![net");
    assert ! _contains(source, "![clock");
    assert ! _contains(source, "from \"./build");
    assert ! _contains(source, "from \"./cli");
    assert ! _contains(source, "from \"./emit");
    assert ! _contains(source, "from \"./llvm");
    assert ! _contains(source, "diagnostics_render");
    assert ! _contains(effect_diagnostics, "render_diagnostic");
    assert ! _contains(effect_diagnostics, "![io");
    assert ! _contains(effect_collector, "from \"../llvm");
    assert ! _contains(import_checker, "![io");
    assert ! _contains(import_checker, "fs.");
    assert ! _contains(ownership_checker, "render_diagnostic");
    assert ! _contains(ownership_checker, "fn run_ownership_checker");
    assert ! _contains(ownership_checker, "print.err");
}

test "check: intrinsic effects preserve exact and namespace lookup" {
    let mut table = empty_intrinsic_effects();
    table = append_intrinsic_effects(table, "http.get", ["net.http"]);
    table = append_intrinsic_effects(table, "http.download", ["net.http", "io"]);
    let exact = intrinsic_effects_for_callee_target(table, "http.get");
    assert exact.length == 1;
    assert exact[0] == "net.http";
    let fallback = intrinsic_effects_for_callee_target(table, "http.unknown");
    assert fallback.length == 2;
    assert fallback[0] == "net.http";
    assert fallback[1] == "io";
}

// -------------------------------------------------------------------
// Local helpers
// -------------------------------------------------------------------
fn _index_of(haystack: string, needle: string) -> int {
    if needle.length == 0 { return 0; }
    if haystack.length < needle.length { return -1; }
    let mut i: int = 0;
    let limit = haystack.length - needle.length;
    loop {
        if i > limit { break; }
        let mut j: int = 0;
        let mut matches: boolean = true;
        loop {
            if j >= needle.length { break; }
            if haystack[i + j] != needle[j] {
                matches = false;
                break;
            }
            j += 1;
        }
        if matches { return i; }
        i += 1;
    }
    return -1;
}

fn _contains(haystack: string, needle: string) -> boolean {
    return _index_of(haystack, needle) >= 0;
}

// `_local_build_effect_message` has no exported peer — the build-path
// message is inlined inside `effect_violation_to_diagnostic`
// (`diagnostics_render.sfn:92`), not a standalone export. It is kept
// local but now composes the REAL `join_effects` import rather than a
// mirrored copy, so the "joins multiple missing effects" assertion
// below exercises the live separator logic transitively.
fn _local_build_effect_message(routine_name: string, missing_effects: string[]) -> string {
    let effects_text = join_effects(missing_effects);
    let mut message = "function `" + routine_name
        + "` is missing required effects: !["
        + effects_text
        + "]";
    if missing_effects.length > 0 {
        message = message + " suggestion: add ![" + effects_text
            + "] to the function signature";
    }
    return message;
}

// Drives the REAL `code_for_missing_effect` (diagnostics_render.sfn:54)
// through a single flat `EffectRequirement` carrying `desc`. The real
// signature is `(missing_effects: string[], requirements:
// EffectRequirement[])`; the error code is derived from the
// requirement descriptions, so we wrap one description into a flat,
// single-level struct literal (`trigger: null`) to stay clear of the
// nested-struct-literal segfault caveat. `effect` is threaded into both
// the requirement's `effect` field and the `missing` array so the
// fixture stays self-consistent with the description (e.g. an
// `![net]` description carries `effect: "net"`) — future-proofing the
// test if `code_for_missing_effect` ever consults those fields too.
fn _code_for_desc(effect: string, desc: string) -> string {
    let reqs: EffectRequirement[] = [EffectRequirement {
        effect: effect, description: desc, trigger: null
    }];
    let missing: string[] = [effect];
    return code_for_missing_effect(missing, reqs);
}

// -------------------------------------------------------------------
// Tests — join_effects
// -------------------------------------------------------------------
test "check: join_effects empty" {
    let empty: string[] = [];
    assert strings_equal(join_effects(empty), "");
}

test "check: join_effects single" {
    assert strings_equal(join_effects(["io"]), "io");
}

test "check: join_effects multiple" {
    assert strings_equal(join_effects(["io", "net"]), "io, net");
    assert strings_equal(join_effects(["io", "net", "clock"]), "io, net, clock");
}

// -------------------------------------------------------------------
// Tests — effect message building
// -------------------------------------------------------------------
test "check: effect message names the routine" {
    let msg = _local_build_effect_message("process", ["io"]);
    assert _contains(msg, "process");
    assert _contains(msg, "io");
}

test "check: effect message joins multiple missing effects" {
    let msg = _local_build_effect_message("fetch_order", ["io", "net"]);
    assert _contains(msg, "io, net");
}

test "check: effect message suggests fix" {
    let msg = _local_build_effect_message("write_log", ["io"]);
    assert _contains(msg, "suggestion");
    assert _contains(msg, "![io]");
}

// -------------------------------------------------------------------
// Tests — error-code classification
// -------------------------------------------------------------------
test "check: plain missing-effect requirement is E0400" {
    assert strings_equal(_code_for_desc("net", "http.get"), "E0400");
    assert strings_equal(_code_for_desc("io", "fs.readFile"), "E0400");
}

test "check: decorator-implied effect is E0401" {
    assert strings_equal(_code_for_desc("io", "@trace decorator"), "E0401");
    assert strings_equal(_code_for_desc("io", "@logExecution"), "E0401");
}

test "check: empty description defaults to E0400" {
    assert strings_equal(_code_for_desc("io", ""), "E0400");
}

test "check: cross-module imported description is E0402" {
    // Phase E: descriptions emitted by
    // `effect_checker._propagate_imported_callee_effects` carry the
    // prefix `imported \`<name>\` declares !\[…\]`. Pin the prefix
    // → E0402 mapping so a refactor that "tidies" the description
    // string (e.g. drops the backtick or capitalises) doesn't
    // silently regress the cross-module diagnostic to E0400.
    assert strings_equal(_code_for_desc("net", "imported `fetch` declares ![net]"), "E0402");
    assert strings_equal(_code_for_desc("io", "imported `read_file` declares ![io]"), "E0402");
}

test "check: imported substring without prefix stays E0400" {
    // Defensive — make sure the prefix check doesn't false-match
    // descriptions that merely contain the word "imported" later
    // in the string (e.g. an in-module helper named "use_imported").
    assert strings_equal(_code_for_desc("io", "use_imported_helper requires ![io]"), "E0400");
    assert strings_equal(_code_for_desc("io", "filesystem helper usage"), "E0400");
}

test "check: decorator precedence wins over cross-module import" {
    // Real `code_for_missing_effect` scans ALL requirements and the
    // decorator (`@`) prefix outranks the `imported \`` prefix
    // (diagnostics_render.sfn:65-77). Build two flat requirements to
    // exercise the multi-requirement scan the old single-string mirror
    // could not reach.
    let reqs: EffectRequirement[] = [EffectRequirement {
        effect: "net", description: "imported `fetch` declares ![net]", trigger: null
    }, EffectRequirement {
        effect: "io", description: "@logExecution", trigger: null
    }];
    assert strings_equal(code_for_missing_effect(["io", "net"], reqs), "E0401");
}

// -------------------------------------------------------------------
// Tests — summary rendering
// -------------------------------------------------------------------
test "check: summary says ok when no errors" {
    let text = render_summary(CheckSummary {
        files_checked: 3, total_errors: 0, total_warnings: 0
    });
    assert _contains(text, "3 files");
    assert _contains(text, "ok");
}

test "check: summary reports plural errors" {
    let text = render_summary(CheckSummary {
        files_checked: 2, total_errors: 5, total_warnings: 0
    });
    assert _contains(text, "5 errors");
}

test "check: summary reports singular error" {
    let text = render_summary(CheckSummary {
        files_checked: 1, total_errors: 1, total_warnings: 0
    });
    assert _contains(text, "1 error");
    assert ! _contains(text, "errors");
}

// -------------------------------------------------------------------
// Tests — number-to-string helper
// -------------------------------------------------------------------
test "check: num_to_string handles zero" {
    assert strings_equal(int_to_string(0), "0");
}

test "check: num_to_string handles small positives" {
    assert strings_equal(int_to_string(7), "7");
    assert strings_equal(int_to_string(42), "42");
    assert strings_equal(int_to_string(120), "120");
}

// -------------------------------------------------------------------
// Tests — diagnostic header rendering (severity drives the prefix)
// -------------------------------------------------------------------
//
// Mirrors `render_diagnostic` in compiler/src/tools/check.sfn — the
// header is `severity + "[" + code + "]: " + message`. These tests
// guard the contract without importing the renderer (the diamond-rule
// constraint described at the top of this file).
fn _local_render_header(severity: string, code: string, message: string) -> string {
    return severity + "[" + code + "]: " + message;
}

test "check: header uses error severity for typecheck diagnostics" {
    let header = _local_render_header("error", "E0001", "duplicate function `foo` declared");
    assert _contains(header, "error[E0001]:");
    assert _contains(header, "duplicate function");
}

test "check: header uses warning severity for load diagnostics" {
    let header = _local_render_header("warning", "W0001", "missing import-context artifact");
    assert _contains(header, "warning[W0001]:");
    assert ! _contains(header, "error[");
}

test "check: header carries severity verbatim for hint and info" {
    assert _contains(_local_render_header("hint", "H0100", "consider"), "hint[H0100]:");
    assert _contains(_local_render_header("info", "I0100", "note"), "info[I0100]:");
}

// -------------------------------------------------------------------
// Tests — file_path appears on the location line
// -------------------------------------------------------------------
//
// Mirrors the location-only branch of `render_diagnostic` (the path
// shown when `primary == null`, used for warnings emitted by the
// load/staging layer). With A3, file_path comes off the Diagnostic
// struct rather than a separate parameter.
fn _local_render_location_only(file_path: string) -> string {
    return "  --> " + file_path;
}

test "check: location-only line includes file_path" {
    let line = _local_render_location_only("compiler/src/foo.sfn");
    assert _contains(line, "  --> compiler/src/foo.sfn");
}

test "check: location-only line works for arbitrary missing-artifact paths" {
    let line = _local_render_location_only("build/compiler/import-context/sfn_prelude/mod.sfn-asm");
    assert _contains(line, "import-context/sfn_prelude");
    assert _contains(line, ".sfn-asm");
}

// -------------------------------------------------------------------
// Tests — W01xx warning code allocation
// -------------------------------------------------------------------
//
// W0001 = missing import-context artifact (resolver staged a path
// that's no longer on disk). W0002 = artifact existed but the
// native-IR parser rejected it. The W01xx range is reserved for
// load/staging warnings emitted by `sfn check` infrastructure;
// program-analysis warnings (e.g. future `sfn vet`) live in W02xx+.
test "check: W0001 and W0002 are distinct codes" {
    assert ! strings_equal("W0001", "W0002");
}

test "check: W01xx codes do not collide with E0xxx error ranges" {
    assert ! strings_equal("W0001", "E0001");
    assert ! strings_equal("W0002", "E0301");
}

// -------------------------------------------------------------------
// Import-resolution findings (SFN-686) — pure, no driver, no filesystem
// -------------------------------------------------------------------
fn _ir_import(name: string, source: string) -> Statement {
    let spec = ImportSpecifier { name: name, alias: null };
    return Statement.ImportDeclaration {
        import_specifiers: [spec],
        source: source
    };
}

// `resolved_capsule_specs` is what the check resolver located;
// `closure_names` is the staged closure's symbol surface.
fn _ir_findings(source: string, name: string, resolved_capsule_specs: string[], closure_names: string[], capsule_specs_known: boolean, prelude_globals: string[]) -> int {
    let relative_specs: string[] = [];
    let context = ImportResolutionContext {
        closure_symbols: ClosureSymbolSet {
            names: closure_names,
            complete: true
        },
        resolved_relative_specs: relative_specs,
        resolved_capsule_specs: resolved_capsule_specs,
        capsule_specs_known: capsule_specs_known
    };
    let program = Program { statements: [_ir_import(name, source)] };
    let findings = collect_import_resolution_findings(program, "consumer.sfn", context, prelude_globals);
    return findings.length as int;
}

fn _ir_first_code(source: string, name: string, resolved_capsule_specs: string[], closure_names: string[]) -> string {
    let relative_specs: string[] = [];
    let no_globals: string[] = [];
    let context = ImportResolutionContext {
        closure_symbols: ClosureSymbolSet {
            names: closure_names,
            complete: true
        },
        resolved_relative_specs: relative_specs,
        resolved_capsule_specs: resolved_capsule_specs,
        capsule_specs_known: true
    };
    let program = Program { statements: [_ir_import(name, source)] };
    let findings = collect_import_resolution_findings(program, "consumer.sfn", context, no_globals);
    if findings.length == 0 { return ""; }
    return findings[0].code;
}

test "import resolution: unresolved capsule spec is E0430" {
    assert strings_equal(_ir_first_code("sfn/not-a-capsule", "x", ["sfn/strings"], ["x"]), "E0430");
}

test "import resolution: symbol absent from the closure is E0431" {
    assert strings_equal(_ir_first_code("sfn/strings", "nope", ["sfn/strings"], ["find"]), "E0431");
}

test "import resolution: submodule import matches its capsule entry" {
    assert _ir_findings("sfn/http/client", "get", ["sfn/http"], ["get"], true, []) == 0;
}

// SFN-686 regression: a capsule name may carry more than two segments, so a
// fixed truncation to `<scope>/<name>` misses the recorded entry and mints a
// spurious E0430 on a capsule that resolved perfectly.
test "import resolution: multi-segment capsule name resolves" {
    assert _ir_findings("acme/router/middleware/auth", "verify", ["acme/router/middleware/auth"], ["verify"], true, []) == 0;
}

// The prefix match must not spill across a name boundary.
test "import resolution: a capsule entry does not match a longer sibling name" {
    assert strings_equal(_ir_first_code("sfn/httpx", "get", ["sfn/http"], ["get"]), "E0430");
}

// A prelude global lives in `runtime/prelude.sfn`, never in a staged
// artifact, so it is absent from the closure surface while the link defines
// it. Importing one from a capsule is legal under global-by-name resolution.
test "import resolution: a prelude global imported from a capsule is exempt" {
    assert _ir_findings("sfn/strings", "strings_equal", ["sfn/strings"], [], true, ["strings_equal"]) == 0;
}

test "import resolution: runtime specs are never diagnosed" {
    assert _ir_findings("runtime/sfn/string", "whatever", [], [], true, []) == 0;
}

test "import resolution: bare-name specs are never diagnosed" {
    assert _ir_findings("barename", "whatever", [], [], true, []) == 0;
}

// Without a resolver pass an empty spec set means "unknown", not "resolved
// nothing" — the standalone `check_source` adapter has no pass.
test "import resolution: capsule specs are unchecked when no resolver pass ran" {
    assert _ir_findings("sfn/not-a-capsule", "x", [], [], false, []) == 0;
}
