// compiler/tests/unit/user_config_test.sfn
//
// Resolver-contract coverage for `compiler/src/user_config.sfn` (SFN-1259,
// SFEP-0076 section 3.3 rung 4: `~/.sfn/config.toml`). Exercises the pure
// text-level resolvers directly (no filesystem) and the explicit-path `_at`
// variant against a file the test materialises itself — never the real home
// directory, which would be non-hermetic and, on CI, silently vacuous. The
// no-argument `user_config_linker` / `user_config_cc` (which read the real
// `~/.sfn`) are deliberately never called here; the e2e precedence contract
// lives in `compiler/tests/e2e/user_config_precedence_test.sfn`.
import { scratch_root } from "sfn/test";

import { toml_section_key_names, toml_section_malformed_lines } from "../../src/toml_parser";
import {
    _uc_parse_jobs,
    user_config_build_cache_dir_at,
    user_config_build_cache_dir_from_text,
    user_config_build_jobs_at,
    user_config_build_jobs_from_text,
    user_config_build_key_is_admitted,
    user_config_key_is_admitted,
    user_config_linker_origin,
    user_config_target_section,
    user_config_target_value_at,
    user_config_target_value_from_text
} from "../../src/user_config";

// ---------------------------------------------------------------------------
// Group A — pure, text-level (no filesystem, no ![io]).
// ---------------------------------------------------------------------------
test "user_config: target section with both admitted keys resolves each" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\ncc = \"clang-18\"\n";
    let triple = "x86_64-unknown-linux-gnu";
    assert user_config_target_section(triple) == "target.x86_64-unknown-linux-gnu";
    assert user_config_target_value_from_text(text, triple, "linker") == "mold";
    assert user_config_target_value_from_text(text, triple, "cc") == "clang-18";
}

test "user_config: absent section resolves to empty string" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\n";
    assert user_config_target_value_from_text(text, "aarch64-apple-darwin", "linker") == "";
}

test "user_config: present section, absent key resolves to empty string" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\n";
    assert user_config_target_value_from_text(text, "x86_64-unknown-linux-gnu", "cc") == "";
}

// Acceptance criterion: a `[target.<other-triple>]` section in the same file
// must never leak its value onto a different triple's lookup.
test "user_config: a darwin section is not consulted for a linux triple" ![pure] {
    let text = "[target.aarch64-apple-darwin]\nlinker = \"ld64\"\n\n"
        + "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\n";
    assert user_config_target_value_from_text(text, "x86_64-unknown-linux-gnu", "linker") == "mold";
    assert user_config_target_value_from_text(text, "aarch64-apple-darwin", "linker") == "ld64";
}

test "user_config: empty text and empty triple both resolve to empty string" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\n";
    assert user_config_target_value_from_text("", "x86_64-unknown-linux-gnu", "linker") == "";
    assert user_config_target_value_from_text(text, "", "linker") == "";
    assert user_config_target_section("") == "";
}

test "user_config: an unadmitted key resolves to empty string and is not admitted" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\nsysroot = \"/x\"\n";
    assert user_config_target_value_from_text(text, "x86_64-unknown-linux-gnu", "sysroot") == "";
    assert user_config_key_is_admitted("sysroot") == false;
    assert user_config_key_is_admitted("linker") == true;
    assert user_config_key_is_admitted("cc") == true;
}

test "user_config: quoted and unquoted values strip to the same result" ![pure] {
    let quoted = "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\n";
    let unquoted = "[target.x86_64-unknown-linux-gnu]\nlinker = mold\n";
    let triple = "x86_64-unknown-linux-gnu";
    assert user_config_target_value_from_text(quoted, triple, "linker") == user_config_target_value_from_text(unquoted, triple, "linker");
    assert user_config_target_value_from_text(quoted, triple, "linker") == "mold";
}

test "user_config: linker_origin names the config path, section, and key" ![pure] {
    assert user_config_linker_origin("x86_64-unknown-linux-gnu") == "~/.sfn/config.toml target.x86_64-unknown-linux-gnu.linker";
}

test "user_config: malformed lines are reported only for the named section" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\n" + "# comment\n" + "\n"
        + "badline-no-equals\n"
        + "linker = \"mold\"\n"
        + "\n"
        + "[target.aarch64-apple-darwin]\n"
        + "other-bad-line\n";
    let malformed = toml_section_malformed_lines(text, "target.x86_64-unknown-linux-gnu");
    assert malformed.length == 1;
    assert malformed[0] == "badline-no-equals";
}

test "user_config: section key names come back in file order, section-scoped" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\n" + "cc = \"clang-18\"\n"
        + "linker = \"mold\"\n"
        + "\n"
        + "[target.aarch64-apple-darwin]\n"
        + "linker = \"ld64\"\n";
    let keys = toml_section_key_names(text, "target.x86_64-unknown-linux-gnu");
    assert keys.length == 2;
    assert keys[0] == "cc";
    assert keys[1] == "linker";
}

// ---------------------------------------------------------------------------
// Group B — explicit-path, ![io]. The file is materialised by the test, so
// this never touches the real `~/.sfn`.
// ---------------------------------------------------------------------------
fn _dir() -> string ![io] {
    let dir = scratch_root() + "/user-config-unit";
    fs.createDirectory(dir, true);
    return dir;
}

test "user_config: a path that does not exist resolves to empty string" ![io] {
    let path = _dir() + "/absent.toml";
    if fs.exists(path) { fs.deleteFile(path); }
    assert user_config_target_value_at(path, "x86_64-unknown-linux-gnu", "linker") == "";
}

test "user_config: an empty path string resolves to empty string" ![io] {
    assert user_config_target_value_at("", "x86_64-unknown-linux-gnu", "linker") == "";
}

test "user_config: an existing file with the right section and key resolves the value" ![io] {
    let path = _dir() + "/present.toml";
    fs.writeFile(path, "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\n");
    assert user_config_target_value_at(path, "x86_64-unknown-linux-gnu", "linker") == "mold";
}

test "user_config: an existing but empty file resolves to empty string" ![io] {
    let path = _dir() + "/empty.toml";
    fs.writeFile(path, "");
    assert user_config_target_value_at(path, "x86_64-unknown-linux-gnu", "linker") == "";
}

test "user_config: garbage content resolves to empty string without panicking" ![io] {
    let path = _dir() + "/garbage.toml";
    fs.writeFile(path, "!!! not toml <<<");
    assert user_config_target_value_at(path, "x86_64-unknown-linux-gnu", "linker") == "";
}

// ---------------------------------------------------------------------------
// Group C — [build] section (SFN-1260, SFEP-0076 section 3.4).
// ---------------------------------------------------------------------------
test "user_config: both [build] keys are admitted, unrelated keys are not" ![pure] {
    assert user_config_build_key_is_admitted("cache-dir") == true;
    assert user_config_build_key_is_admitted("jobs") == true;
    assert user_config_build_key_is_admitted("linker") == false;
    assert user_config_build_key_is_admitted("cc") == false;
    assert user_config_build_key_is_admitted("sysroot") == false;
    // The two admission predicates are disjoint: a `[build]` key is never
    // admitted by the `[target.<triple>]` predicate.
    assert user_config_key_is_admitted("jobs") == false;
    assert user_config_key_is_admitted("cache-dir") == false;
}

test "user_config: an absolute POSIX cache-dir and jobs resolve together" ![pure] {
    let text = "[build]\ncache-dir = \"/var/cache/sfn\"\njobs = 4\n";
    assert user_config_build_cache_dir_from_text(text) == "/var/cache/sfn";
    assert user_config_build_jobs_from_text(text) == 4;
}

test "user_config: a Windows drive-absolute cache-dir resolves" ![pure] {
    let text = "[build]\ncache-dir = \"C:/Users/dev/cache\"\n";
    assert user_config_build_cache_dir_from_text(text) == "C:/Users/dev/cache";
}

test "user_config: a relative cache-dir resolves to empty string" ![pure] {
    let text = "[build]\ncache-dir = \".cache/sfn\"\n";
    assert user_config_build_cache_dir_from_text(text) == "";
}

test "user_config: a bare relative cache-dir with no separator resolves to empty string" ![pure] {
    let text = "[build]\ncache-dir = \"cache\"\n";
    assert user_config_build_cache_dir_from_text(text) == "";
}

test "user_config: absent [build] section resolves to empty string and zero" ![pure] {
    let text = "[target.x86_64-unknown-linux-gnu]\nlinker = \"mold\"\n";
    assert user_config_build_cache_dir_from_text(text) == "";
    assert user_config_build_jobs_from_text(text) == 0;
}

test "user_config: present [build] section, absent key resolves to empty string and zero" ![pure] {
    let with_dir_only = "[build]\ncache-dir = \"/var/cache/sfn\"\n";
    assert user_config_build_jobs_from_text(with_dir_only) == 0;
    let with_jobs_only = "[build]\njobs = 4\n";
    assert user_config_build_cache_dir_from_text(with_jobs_only) == "";
}

// Acceptance criterion: a `[target.<triple>]` section carrying build-shaped
// keys must never leak into the `[build]` lookup, and a `[build]` section
// carrying a target-shaped key must never leak into the `[target.<triple>]`
// lookup.
test "user_config: [target.<triple>] and [build] sections do not leak into each other" ![pure] {
    let triple = "x86_64-unknown-linux-gnu";
    let target_only = "[target." + triple
        + "]\ncache-dir = \"/wrong\"\njobs = 4\n";
    assert user_config_build_cache_dir_from_text(target_only) == "";
    assert user_config_build_jobs_from_text(target_only) == 0;

    let build_only = "[build]\nlinker = \"mold\"\n";
    assert user_config_target_value_from_text(build_only, triple, "linker") == "";
}

test "user_config: build jobs parses valid positive decimals up to the ceiling" ![pure] {
    assert user_config_build_jobs_from_text("[build]\njobs = 4\n") == 4;
    assert user_config_build_jobs_from_text("[build]\njobs = 1\n") == 1;
    assert user_config_build_jobs_from_text("[build]\njobs = 8\n") == 8;
    // The resolver does NOT clamp to the [1, 8] worker ceiling — that clamp
    // is `_cr_jobs_from_config`'s job (`capsule_emit_parallel.sfn`); this
    // rung only validates "is it a usable positive decimal".
    assert user_config_build_jobs_from_text("[build]\njobs = 12\n") == 12;
    assert user_config_build_jobs_from_text("[build]\njobs = 1000000\n") == 1000000;

    assert _uc_parse_jobs("4") == 4;
    assert _uc_parse_jobs("1") == 1;
    assert _uc_parse_jobs("8") == 8;
    assert _uc_parse_jobs("12") == 12;
    assert _uc_parse_jobs("1000000") == 1000000;
}

test "user_config: build jobs rejects empty, non-positive, non-decimal, and out-of-range input" ![pure] {
    assert user_config_build_jobs_from_text("[build]\njobs = \n") == 0;
    assert user_config_build_jobs_from_text("[build]\njobs = 0\n") == 0;
    assert user_config_build_jobs_from_text("[build]\njobs = -2\n") == 0;
    assert user_config_build_jobs_from_text("[build]\njobs = abc\n") == 0;
    assert user_config_build_jobs_from_text("[build]\njobs = 2.5\n") == 0;
    assert user_config_build_jobs_from_text("[build]\njobs = 1000001\n") == 0;

    assert _uc_parse_jobs("") == 0;
    assert _uc_parse_jobs("0") == 0;
    assert _uc_parse_jobs("-2") == 0;
    assert _uc_parse_jobs("abc") == 0;
    assert _uc_parse_jobs("2.5") == 0;
    assert _uc_parse_jobs("1000001") == 0;
    // Unlike `_cr_parse_positive_int`, which tolerates trailing whitespace
    // because it parses `nproc` output, a TOML value already arrives trimmed
    // by `toml_get_string`, so trailing space here means the user typed
    // something that is not a number — exercised directly since a value
    // routed through `toml_get_string` would already have it trimmed away.
    assert _uc_parse_jobs("4 ") == 0;
}

test "user_config: quoted and unquoted jobs values agree" ![pure] {
    assert user_config_build_jobs_from_text("[build]\njobs = \"4\"\n") == user_config_build_jobs_from_text("[build]\njobs = 4\n");
    assert user_config_build_jobs_from_text("[build]\njobs = \"4\"\n") == 4;
}

test "user_config: build_cache_dir_at and build_jobs_at on an empty path resolve to empty string and zero" ![io] {
    assert user_config_build_cache_dir_at("") == "";
    assert user_config_build_jobs_at("") == 0;
}

test "user_config: build_cache_dir_at and build_jobs_at on an absent path resolve to empty string and zero" ![io] {
    let path = _dir() + "/build-absent.toml";
    if fs.exists(path) { fs.deleteFile(path); }
    assert user_config_build_cache_dir_at(path) == "";
    assert user_config_build_jobs_at(path) == 0;
}

test "user_config: build_cache_dir_at and build_jobs_at on an existing empty file resolve to empty string and zero" ![io] {
    let path = _dir() + "/build-empty.toml";
    fs.writeFile(path, "");
    assert user_config_build_cache_dir_at(path) == "";
    assert user_config_build_jobs_at(path) == 0;
}

test "user_config: build_cache_dir_at and build_jobs_at on garbage content resolve to empty string and zero without panicking" ![io] {
    let path = _dir() + "/build-garbage.toml";
    fs.writeFile(path, "!!! not toml <<<");
    assert user_config_build_cache_dir_at(path) == "";
    assert user_config_build_jobs_at(path) == 0;
}

test "user_config: build_cache_dir_at and build_jobs_at resolve a real file's values" ![io] {
    let path = _dir() + "/build-present.toml";
    fs.writeFile(path, "[build]\ncache-dir = \"/tmp/sfn-cache\"\njobs = 2\n");
    assert user_config_build_cache_dir_at(path) == "/tmp/sfn-cache";
    assert user_config_build_jobs_at(path) == 2;
}
