// compiler/tests/unit/compiler_capsule_boundary_test.sfn
//
// Static dependency ratchet for SFEP-0020 §§3.3, 3.5, and 8. It classifies the
// monolith by semantic role, follows future physical capsule moves, and keeps
// every migration exception exact and stale-on-repair.
import {
    contains,
    ends_with,
    replace,
    split,
    starts_with,
    substring,
    trim
} from "sfn/strings";

import { capsule_artifact_dir, parse_scope_name } from "../../src/capsule_artifact";
import { collect_scoped_import_specs } from "../../src/capsule_import_scan";
import { compiler_capsule_role, compiler_module_role } from "../../src/capsule_names";
import { module_name_for_source_with_members } from "../../src/capsule_resolver/identity";
import { WorkspaceMember } from "../../src/capsule_resolver/types";
import { load_workspace_members, validate_unique_workspace_member_names } from "../../src/capsule_resolver/workspace";
import {
    toml_get_capabilities_required,
    toml_get_dependencies,
    toml_get_publish,
    toml_get_version,
    toml_has_capabilities_section
} from "../../src/toml_parser";

let ROLE_SYNTAX: string = "syntax";
let ROLE_ANALYZER: string = "analyzer";
let ROLE_IR: string = "ir";
let ROLE_CODEGEN: string = "codegen";
let ROLE_LLVM: string = "codegen-llvm";
let ROLE_DRIVER: string = "compiler-driver";
let ROLE_STDLIB: string = "narrow-stdlib";
let ROLE_AUTHORITY: string = "authority-bearing-stdlib";
let ROLE_UNKNOWN: string = "unclassified-dependency";
let ROLE_COMPAT_LEAF: string = "monolith-narrow-leaf";
let ROLE_RUNTIME_PRELUDE: string = "runtime-prelude";
let ROLE_RUNTIME_INTERNAL: string = "runtime-implementation";

struct BoundaryException {
    importer: string;
    importee: string;
    seam: string;
}

struct AuthorityException {
    module: string;
    token: string;
    expected_count: int;
    seam: string;
}

fn _boundary_exception(importer: string, importee: string, seam: string) -> BoundaryException {
    return BoundaryException {
        importer: importer,
        importee: importee,
        seam: seam
    };
}

fn _boundary_exceptions() -> BoundaryException[] { return []; }

fn _authority_exception(module: string, token: string, expected_count: int, seam: string) -> AuthorityException {
    return AuthorityException {
        module: module,
        token: token,
        expected_count: expected_count,
        seam: seam
    };
}

fn _authority_exceptions() -> AuthorityException[] { return []; }

fn _strip_sfn(path: string) -> string {
    if !ends_with(path, ".sfn") { return path; }
    return substring(path, 0, path.length - 4);
}

fn _monolith_module_id(path: string) -> string {
    let prefix = "compiler/src/";
    if !starts_with(path, prefix) { return ""; }
    return _strip_sfn(substring(path, prefix.length, path.length));
}

fn _spec_is_capsule(spec: string, capsule: string) -> boolean {
    return spec == capsule || starts_with(spec, capsule + "/");
}

fn _role_from_internal_spec(spec: string) -> string {
    if spec == "runtime/prelude" { return ROLE_RUNTIME_PRELUDE; }
    if starts_with(spec, "runtime/") { return ROLE_RUNTIME_INTERNAL; }
    if _spec_is_capsule(spec, "sfn/runtime-native") {
        return ROLE_RUNTIME_INTERNAL;
    }
    let compiler_role = compiler_module_role(spec);
    if compiler_role.length > 0 { return compiler_role; }
    if _spec_is_capsule(spec, "sfn/archive") || _spec_is_capsule(spec, "sfn/bench")
        || _spec_is_capsule(spec, "sfn/cli")
        || _spec_is_capsule(spec, "sfn/device")
        || _spec_is_capsule(spec, "sfn/fs")
        || _spec_is_capsule(spec, "sfn/http")
        || _spec_is_capsule(spec, "sfn/layers")
        || _spec_is_capsule(spec, "sfn/log")
        || _spec_is_capsule(spec, "sfn/net")
        || _spec_is_capsule(spec, "sfn/nn")
        || _spec_is_capsule(spec, "sfn/os")
        || _spec_is_capsule(spec, "sfn/process")
        || _spec_is_capsule(spec, "sfn/tensor")
        || _spec_is_capsule(spec, "sfn/test")
        || _spec_is_capsule(spec, "sfn/time") { return ROLE_AUTHORITY; }
    if _spec_is_capsule(spec, "sfn/crypto") || _spec_is_capsule(spec, "sfn/json")
        || _spec_is_capsule(spec, "sfn/losses")
        || _spec_is_capsule(spec, "sfn/math")
        || _spec_is_capsule(spec, "sfn/path")
        || _spec_is_capsule(spec, "sfn/prelude")
        || _spec_is_capsule(spec, "sfn/strings")
        || _spec_is_capsule(spec, "sfn/sync")
        || _spec_is_capsule(spec, "sfn/toml") { return ROLE_STDLIB; }
    if starts_with(spec, "sfn/") { return ROLE_UNKNOWN; }
    return "";
}

fn _manifest_dependency_role(name: string) -> string {
    let role = _role_from_internal_spec(name);
    if role.length > 0 { return role; }
    return ROLE_UNKNOWN;
}

fn _member(name: string, member_path: string, src_dir: string, build_kind: string) -> WorkspaceMember {
    return WorkspaceMember {
        name: name,
        member_path: member_path,
        src_dir: src_dir,
        build_kind: build_kind,
        module_prefix: "",
        implicit: false
    };
}

fn _source_member_index(path: string, members: WorkspaceMember[]) -> int {
    let normalized = _normalize_path(path);
    let mut best: int = -1;
    let mut best_len: int = -1;
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        let root = _normalize_path(members[i].src_dir);
        if (normalized == root || starts_with(normalized, root + "/")) && root.length > best_len {
            best = i;
            best_len = root.length;
        }
        i += 1;
    }
    return best;
}

fn _module_role(path: string, members: WorkspaceMember[]) -> string {
    let index = _source_member_index(path, members);
    if index < 0 { return ""; }
    return compiler_capsule_role(members[index].name);
}

fn _member_src_dir(members: WorkspaceMember[], name: string) -> string {
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        if members[i].name == name { return members[i].src_dir; }
        i += 1;
    }
    return "";
}

fn _role_rule(importer_role: string, importee_role: string) -> string {
    if importer_role == ROLE_STDLIB {
        return "top-level standard-library capsules must not import internal compiler capsules";
    }
    if importee_role == ROLE_AUTHORITY {
        return "only sfn/compiler may depend on capability-bearing standard-library capsules";
    }
    if importee_role == ROLE_UNKNOWN {
        return "every dependency must be classified before a compiler role imports it";
    }
    if importee_role == ROLE_RUNTIME_INTERNAL {
        return "only syntax, IR, and compiler-driver roles may import runtime/prelude; only compiler-driver may import runtime implementation modules";
    }
    if importee_role == ROLE_RUNTIME_PRELUDE {
        return "only syntax, IR, and compiler-driver roles may import runtime/prelude";
    }
    if importee_role == ROLE_COMPAT_LEAF {
        return "monolith compatibility helpers require an exact importer/importee migration exception";
    }
    if importee_role == ROLE_DRIVER && importer_role != ROLE_DRIVER {
        return "internal libraries must not import sfn/compiler or driver-owned modules";
    }
    if importer_role == ROLE_SYNTAX {
        return "syntax may depend only on syntax and narrow standard-library contracts";
    }
    if importer_role == ROLE_IR {
        return "IR may not depend on syntax, analyzer, codegen, LLVM, or driver modules";
    }
    if importer_role == ROLE_ANALYZER {
        return "analyzer may depend only on syntax, IR, analyzer, and narrow standard-library contracts";
    }
    if importer_role == ROLE_CODEGEN {
        return "codegen may depend only on syntax, analyzer, IR, codegen, and narrow standard-library contracts";
    }
    if importer_role == ROLE_LLVM {
        return "codegen-llvm may depend only on IR, codegen-llvm, and narrow standard-library contracts";
    }
    return "the import is outside the SFEP-0020 role dependency graph";
}

fn _role_import_allowed(importer_role: string, importee_role: string) -> boolean {
    if importer_role.length == 0 || importee_role.length == 0 { return true; }
    if importee_role == ROLE_UNKNOWN { return false; }
    if importer_role == ROLE_DRIVER { return true; }
    if importer_role == importee_role { return true; }
    if importer_role == ROLE_SYNTAX || importer_role == ROLE_IR {
        return importee_role == ROLE_STDLIB || importee_role == ROLE_RUNTIME_PRELUDE;
    }
    if importer_role == ROLE_ANALYZER {
        return importee_role == ROLE_SYNTAX || importee_role == ROLE_IR
            || importee_role == ROLE_STDLIB;
    }
    if importer_role == ROLE_CODEGEN {
        return importee_role == ROLE_SYNTAX || importee_role == ROLE_ANALYZER
            || importee_role == ROLE_IR
            || importee_role == ROLE_STDLIB;
    }
    if importer_role == ROLE_LLVM {
        return importee_role == ROLE_IR || importee_role == ROLE_STDLIB;
    }
    return false;
}

fn _is_internal_compiler_role(role: string) -> boolean {
    return role == ROLE_SYNTAX || role == ROLE_ANALYZER || role == ROLE_IR
        || role == ROLE_CODEGEN
        || role == ROLE_LLVM
        || role == ROLE_DRIVER;
}

fn _dirname(path: string) -> string {
    let mut last: int = -1;
    let mut i: int = 0;
    loop {
        if i >= path.length { break; }
        if path[i] == "/" { last = i; }
        i += 1;
    }
    if last < 0 { return "."; }
    return substring(path, 0, last);
}

fn _normalize_path(path: string) -> string {
    let components = split(path, "/");
    let mut stack: string[] = [];
    let mut depth: int = 0;
    let mut i: int = 0;
    loop {
        if i >= components.length { break; }
        let part = components[i];
        i += 1;
        if part.length == 0 || part == "." { continue; }
        if part == ".." {
            if depth > 0 { depth -= 1; }
            continue;
        }
        if depth < stack.length { stack[depth] = part; } else {
            stack.push(part);
        }
        depth += 1;
    }
    let mut out = "";
    let mut j: int = 0;
    loop {
        if j >= depth { break; }
        if out.length > 0 { out = out + "/"; }
        out = out + stack[j];
        j += 1;
    }
    return out;
}

fn _resolve_relative_import(importer: string, spec: string) -> string ![io] {
    let base = _normalize_path(_dirname(importer) + "/" + spec);
    if ends_with(base, ".sfn") {
        if fs.exists(base) { return base; }
        let without_extension = substring(base, 0, base.length - 4);
        if fs.exists(without_extension + "/mod.sfn") {
            return without_extension + "/mod.sfn";
        }
    }
    if fs.exists(base + ".sfn") { return base + ".sfn"; }
    if fs.exists(base + "/mod.sfn") { return base + "/mod.sfn"; }
    return "";
}

fn _collect_sfn_files(root: string, acc: string[]) -> string[] ![io] {
    let mut out = acc;
    if !fs.exists(root) { return out; }
    let entries = fs.listDirectory(root);
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        i += 1;
        if name == "." || name == ".." { continue; }
        let full = root + "/" + name;
        let children = fs.listDirectory(full);
        if children.length > 0 { out = _collect_sfn_files(full, out); } else if ends_with(name, ".sfn") {
            out.push(full);
        }
    }
    return out;
}

fn _collect_compiler_sources(members: WorkspaceMember[]) -> string[] ![io] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        let member = members[i];
        i += 1;
        if compiler_capsule_role(member.name).length == 0 { continue; }
        out = _collect_sfn_files(member.src_dir, out);
    }
    return out;
}

fn _is_stdlib_reverse_edge_member(member: WorkspaceMember) -> boolean {
    if member.build_kind == "runtime" { return false; }
    if compiler_capsule_role(member.name).length > 0 { return false; }
    return starts_with(member.name, "sfn/");
}

fn _collect_stdlib_sources(members: WorkspaceMember[]) -> string[] ![io] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        let member = members[i];
        i += 1;
        if !_is_stdlib_reverse_edge_member(member) { continue; }
        out = _collect_sfn_files(member.src_dir, out);
    }
    return out;
}

// "Declared, and declared empty" — the state this audit wants each
// compiler-internal capsule to be in. Anchored on
// `toml_has_capabilities_section` rather than a raw-text `!= "[]"` probe
// so there is exactly one implementation of "was a surface declared" in
// the tree; a second, divergent answer to that question is the shape of
// the defect SFN-764 fixed.
fn _has_empty_capability_ceiling(manifest: string) -> boolean {
    if !toml_has_capabilities_section(manifest) { return false; }
    return toml_get_capabilities_required(manifest).length == 0;
}

// The production scoped scanner deliberately excludes runtime/* because the
// resolver stages runtime separately. Rewriting only the prefix lets the same
// comment/string-aware scanner expose those specs to this architectural audit.
fn _collect_runtime_import_specs(source: string) -> string[] {
    let marker = "sfn-runtime-audit/";
    let rewritten = replace(source, "runtime/", marker);
    let scanned = collect_scoped_import_specs(rewritten);
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= scanned.length { break; }
        let spec = scanned[i];
        i += 1;
        if !starts_with(spec, marker) { continue; }
        out.push("runtime/" + substring(spec, marker.length, spec.length));
    }
    return out;
}

fn _is_identifier_char(ch: string) -> boolean {
    return contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", ch);
}

fn _word_at(source: string, index: int, word: string) -> boolean {
    if !_text_at(source, index, word) { return false; }
    if index > 0 && _is_identifier_char(source[index - 1]) { return false; }
    let after = index + word.length;
    if after < source.length && _is_identifier_char(source[after]) {
        return false;
    }
    return true;
}

fn _skip_trivia(source: string, start: int) -> int {
    let mut i = start;
    loop {
        if i >= source.length { return i; }
        if _is_space(source[i]) {
            i += 1;
            continue;
        }
        if source[i] == "/" && _text_at(source, i + 1, "/") {
            i += 2;
            loop {
                if i >= source.length || source[i] == "\n" { break; }
                i += 1;
            }
            continue;
        }
        if source[i] == "/" && _text_at(source, i + 1, "*") {
            i += 2;
            loop {
                if i >= source.length { return i; }
                if source[i] == "*" && _text_at(source, i + 1, "/") {
                    i += 2;
                    break;
                }
                i += 1;
            }
            continue;
        }
        return i;
    }
}

fn _find_import_from(source: string, start: int) -> int {
    let mut i = start;
    let mut in_string = false;
    let mut escaping = false;
    let mut brace_depth: int = 1;
    loop {
        if i >= source.length { return -1; }
        let ch = source[i];
        if in_string {
            if escaping { escaping = false; } else if ch == "\\" {
                escaping = true;
            } else if ch == "\"" { in_string = false; }
            i += 1;
            continue;
        }
        let after_trivia = _skip_trivia(source, i);
        if after_trivia != i {
            i = after_trivia;
            continue;
        }
        if ch == "\"" {
            in_string = true;
            i += 1;
            continue;
        }
        if ch == "{" { brace_depth += 1; }
        if ch == "}" {
            brace_depth -= 1;
            if brace_depth == 0 {
                let from_start = _skip_trivia(source, i + 1);
                if _word_at(source, from_start, "from") {
                    return from_start + 4;
                }
                return -1;
            }
        }
        i += 1;
    }
}

fn _decode_import_string(text: string) -> string {
    let mut decoded = "";
    let mut i: int = 0;
    loop {
        if i >= text.length { break; }
        let ch = text[i];
        if ch != "\\" || i + 1 >= text.length {
            decoded = decoded + ch;
            i += 1;
            continue;
        }
        let escaped = text[i + 1];
        if escaped == "n" { decoded = decoded + "\n"; } else if escaped == "t" {
            decoded = decoded + "\t";
        } else if escaped == "r" { decoded = decoded + "\r"; } else if escaped == "\"" {
            decoded = decoded + "\"";
        } else if escaped == "\\" { decoded = decoded + "\\"; } else if escaped == "$" {
            decoded = decoded + "$";
        } else { decoded = decoded + escaped; }
        i += 2;
    }
    return decoded;
}

fn _collect_parser_import_specs(source: string) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= source.length { break; }
        let after_trivia = _skip_trivia(source, i);
        if after_trivia != i {
            i = after_trivia;
            continue;
        }
        if source[i] == "\"" {
            i += 1;
            let mut escaping = false;
            loop {
                if i >= source.length { break; }
                if escaping { escaping = false; } else if source[i] == "\\" {
                    escaping = true;
                } else if source[i] == "\"" {
                    i += 1;
                    break;
                }
                i += 1;
            }
            continue;
        }
        if !_word_at(source, i, "import") && !_word_at(source, i, "export") {
            i += 1;
            continue;
        }
        let specifier_start = _skip_trivia(source, i + 6);
        if specifier_start >= source.length || source[specifier_start] != "{" {
            i += 6;
            continue;
        }
        let from_end = _find_import_from(source, specifier_start + 1);
        if from_end < 0 {
            i += 6;
            continue;
        }
        let spec_start = _skip_trivia(source, from_end);
        if spec_start >= source.length { break; }
        if source[spec_start] == "\"" {
            let mut end = spec_start + 1;
            let mut escaping = false;
            loop {
                if end >= source.length { break; }
                if escaping { escaping = false; } else if source[end] == "\\" {
                    escaping = true;
                } else if source[end] == "\"" { break; }
                end += 1;
            }
            if end <= source.length {
                out.push(_decode_import_string(substring(source, spec_start + 1, end)));
            }
            i = end + 1;
            continue;
        }
        let mut end = spec_start;
        loop {
            if end >= source.length || source[end] == ";" { break; }
            end += 1;
        }
        let spec = trim(substring(source, spec_start, end));
        if spec.length > 0 { out.push(spec); }
        i = end + 1;
    }
    return out;
}

fn _all_import_specs(source: string) -> string[] {
    return _collect_parser_import_specs(source);
}

fn _importee_path(importer: string, spec: string) -> string ![io] {
    if starts_with(spec, "./") || starts_with(spec, "../") {
        return _resolve_relative_import(importer, spec);
    }
    return spec;
}

fn _importee_role(path_or_spec: string, members: WorkspaceMember[]) -> string {
    let scoped = _role_from_internal_spec(path_or_spec);
    if scoped.length > 0 { return scoped; }
    let module_role = _module_role(path_or_spec, members);
    if module_role.length > 0 { return module_role; }
    // These monolith-local helpers are driver-owned compatibility leaves, but
    // imports to their pure contracts stand in for the narrow standard-library
    // dependencies allowed by SFEP-0020 §3.5.7. They are not a common capsule.
    let id = _monolith_module_id(path_or_spec);
    if id == "string_utils" { return ROLE_COMPAT_LEAF; }
    return ROLE_UNKNOWN;
}

fn _edge_module_id(path_or_spec: string, members: WorkspaceMember[]) -> string {
    let member_index = _source_member_index(path_or_spec, members);
    if member_index >= 0 {
        let member = members[member_index];
        let module_name = module_name_for_source_with_members(path_or_spec, members);
        let prefix = member.name + "/";
        let mut relative = module_name;
        if starts_with(module_name, prefix) {
            relative = substring(module_name, prefix.length, module_name.length);
        }
        if compiler_capsule_role(member.name) == ROLE_LLVM {
            return "llvm/" + _strip_sfn(relative);
        }
        return _strip_sfn(relative);
    }
    let scoped_syntax = "sfn/syntax/";
    if starts_with(path_or_spec, scoped_syntax) {
        return _strip_sfn(substring(path_or_spec, scoped_syntax.length, path_or_spec.length));
    }
    let scoped_analyzer = "sfn/analyzer/";
    if starts_with(path_or_spec, scoped_analyzer) {
        return _strip_sfn(substring(path_or_spec, scoped_analyzer.length, path_or_spec.length));
    }
    let scoped_ir = "sfn/ir/";
    if starts_with(path_or_spec, scoped_ir) {
        return _strip_sfn(substring(path_or_spec, scoped_ir.length, path_or_spec.length));
    }
    let scoped_codegen = "sfn/codegen/";
    if starts_with(path_or_spec, scoped_codegen) {
        return _strip_sfn(substring(path_or_spec, scoped_codegen.length, path_or_spec.length));
    }
    let scoped_llvm = "sfn/codegen-llvm/";
    if starts_with(path_or_spec, scoped_llvm) {
        return "llvm/" + _strip_sfn(substring(path_or_spec, scoped_llvm.length, path_or_spec.length));
    }
    let scoped_driver = "sfn/compiler/";
    if starts_with(path_or_spec, scoped_driver) {
        return _strip_sfn(substring(path_or_spec, scoped_driver.length, path_or_spec.length));
    }
    return path_or_spec;
}

fn _find_exception(exceptions: BoundaryException[], importer: string, importee: string) -> int {
    let mut i: int = 0;
    loop {
        if i >= exceptions.length { break; }
        if exceptions[i].importer == importer && exceptions[i].importee == importee {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn _find_authority_exception(exceptions: AuthorityException[], module: string, token: string) -> int {
    let mut i: int = 0;
    loop {
        if i >= exceptions.length { break; }
        if exceptions[i].module == module && exceptions[i].token == token {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn _boundary_string_index(items: string[], needle: string) -> int {
    let mut index: int = 0;
    loop {
        if index >= items.length { break; }
        if items[index] == needle { return index; }
        index += 1;
    }
    return -1;
}

fn _text_at(source: string, index: int, value: string) -> boolean {
    if index < 0 || index + value.length > source.length { return false; }
    return substring(source, index, index + value.length) == value;
}

fn _is_space(ch: string) -> boolean {
    return ch == " " || ch == "\t" || ch == "\n" || ch == "\r";
}

fn _next_nontrivia_char(source: string, start: int) -> string {
    let mut i = start;
    loop {
        if i >= source.length { return ""; }
        let ch = source[i];
        if _is_space(ch) {
            i += 1;
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "/") {
            i += 2;
            loop {
                if i >= source.length || source[i] == "\n" { break; }
                i += 1;
            }
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "*") {
            i += 2;
            loop {
                if i >= source.length { return ""; }
                if source[i] == "*" && _text_at(source, i + 1, "/") {
                    i += 2;
                    break;
                }
                i += 1;
            }
            continue;
        }
        return ch;
    }
}

fn _previous_nontrivia_index(source: string, before: int) -> int {
    let mut i: int = 0;
    let mut last: int = -1;
    let mut in_string = false;
    let mut escaping = false;
    loop {
        if i >= before || i >= source.length { break; }
        let ch = source[i];
        if in_string {
            if escaping { escaping = false; } else if ch == "\\" {
                escaping = true;
            } else if ch == "\"" {
                in_string = false;
                last = i;
            }
            i += 1;
            continue;
        }
        if _is_space(ch) {
            i += 1;
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "/") {
            i += 2;
            loop {
                if i >= before || i >= source.length || source[i] == "\n" {
                    break;
                }
                i += 1;
            }
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "*") {
            i += 2;
            loop {
                if i >= before || i >= source.length { break; }
                if source[i] == "*" && _text_at(source, i + 1, "/") {
                    i += 2;
                    break;
                }
                i += 1;
            }
            continue;
        }
        if ch == "\"" { in_string = true; }
        last = i;
        i += 1;
    }
    return last;
}

fn _parenthesized_authority_has_follow(source: string, root_start: int, root_end: int, expected: string) -> boolean {
    let mut after = _skip_trivia(source, root_end);
    let mut closing_count: int = 0;
    loop {
        if after >= source.length || source[after] != ")" { break; }
        closing_count += 1;
        after = _skip_trivia(source, after + 1);
    }
    if closing_count == 0 || after >= source.length || source[after] != expected {
        return false;
    }
    let mut before = root_start;
    let mut opening_count: int = 0;
    loop {
        let previous = _previous_nontrivia_index(source, before);
        if previous < 0 || source[previous] != "(" { break; }
        opening_count += 1;
        before = previous;
    }
    if opening_count != closing_count { return false; }
    let receiver = _previous_nontrivia_index(source, before);
    if receiver < 0 { return true; }
    let receiver_ch = source[receiver];
    if receiver_ch == ")" || receiver_ch == "]" || receiver_ch == "." {
        return false;
    }
    if !_is_identifier_char(receiver_ch) { return true; }
    let mut word_start = receiver;
    loop {
        if word_start <= 0 || !_is_identifier_char(source[word_start - 1]) {
            break;
        }
        word_start -= 1;
    }
    let word = substring(source, word_start, receiver + 1);
    return word == "if" || word == "while" || word == "return" || word == "else"
        || word == "match";
}

fn _effect_annotation_end(source: string, bang_index: int) -> int {
    if !_text_at(source, bang_index, "!") { return -1; }
    let open = _skip_trivia(source, bang_index + 1);
    if open >= source.length || source[open] != "[" { return -1; }
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.,";
    let mut i = open + 1;
    loop {
        if i >= source.length { return -1; }
        let after_trivia = _skip_trivia(source, i);
        if after_trivia != i {
            i = after_trivia;
            continue;
        }
        let ch = source[i];
        if ch == "]" {
            let after = _skip_trivia(source, i + 1);
            if after >= source.length { return -1; }
            if source[after] == "{" || source[after] == ";" || _text_at(source, after, "->")
                || _text_at(source, after, "=>") { return i + 1; }
            return -1;
        }
        if !contains(allowed, ch) { return -1; }
        i += 1;
    }
}

fn _effect_annotation_has_root(source: string, bang_index: int, annotation_end: int, root: string) -> boolean {
    let open = _skip_trivia(source, bang_index + 1);
    let mut i = open + 1;
    loop {
        i = _skip_trivia(source, i);
        if i >= annotation_end || source[i] == "]" { break; }
        if !_is_identifier_char(source[i]) || contains("0123456789", source[i]) {
            i += 1;
            continue;
        }
        let start = i;
        i += 1;
        loop {
            if i >= annotation_end || !_is_identifier_char(source[i]) { break; }
            i += 1;
        }
        let mut effect = substring(source, start, i);
        loop {
            if i >= annotation_end || source[i] != "." { break; }
            let segment_start = i + 1;
            if segment_start >= annotation_end || !_is_identifier_char(source[segment_start])
                || contains("0123456789", source[segment_start]) { break; }
            i = segment_start + 1;
            loop {
                if i >= annotation_end || !_is_identifier_char(source[i]) {
                    break;
                }
                i += 1;
            }
            effect = effect + "." + substring(source, segment_start, i);
        }
        if effect == root || starts_with(effect, root + ".") { return true; }
    }
    return false;
}

fn _declared_authority_effect_count(source: string, root: string) -> int {
    let mut count: int = 0;
    let mut i: int = 0;
    let mut in_string = false;
    let mut escaping = false;
    let mut in_line_comment = false;
    let mut in_block_comment = false;
    loop {
        if i >= source.length { break; }
        let ch = source[i];
        if in_line_comment {
            if ch == "\n" { in_line_comment = false; }
            i += 1;
            continue;
        }
        if in_block_comment {
            if ch == "*" && _text_at(source, i + 1, "/") {
                in_block_comment = false;
                i += 2;
            } else { i += 1; }
            continue;
        }
        if in_string {
            if escaping { escaping = false; } else if ch == "\\" {
                escaping = true;
            } else if ch == "\"" { in_string = false; }
            i += 1;
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "/") {
            in_line_comment = true;
            i += 2;
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "*") {
            in_block_comment = true;
            i += 2;
            continue;
        }
        if ch == "\"" {
            in_string = true;
            i += 1;
            continue;
        }
        if ch == "!" {
            let annotation_end = _effect_annotation_end(source, i);
            if annotation_end >= 0 {
                if _effect_annotation_has_root(source, i, annotation_end, root) {
                    count += 1;
                }
                i = annotation_end;
                continue;
            }
        }
        i += 1;
    }
    return count;
}

// Count one direct authority token outside comments and ordinary string text.
// Interpolation expressions are executable, so `${ ... }` re-enters code mode.
// Runtime-helper metadata contains quoted target names; a plain substring scan
// would misclassify that declarative lowering data as I/O.
fn _direct_authority_count(source: string, token: string) -> int {
    let mut root = token;
    let dotted = ends_with(token, ".");
    if dotted { root = substring(token, 0, token.length - 1); }
    let identifier_chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    let mut count: int = 0;
    let mut i: int = 0;
    let mut in_string = false;
    let mut escaping = false;
    let mut in_line_comment = false;
    let mut in_block_comment = false;
    let mut interpolation_depth: int = 0;
    let mut string_resume_depths: int[] = [];
    let mut string_resume_count: int = 0;
    let mut previous_significant = "";
    loop {
        if i >= source.length { break; }
        let ch = source[i];
        if in_line_comment {
            if ch == "\n" { in_line_comment = false; }
            i += 1;
            continue;
        }
        if in_block_comment {
            if ch == "*" && _text_at(source, i + 1, "/") {
                in_block_comment = false;
                i += 2;
            } else { i += 1; }
            continue;
        }
        if in_string {
            if escaping { escaping = false; } else if ch == "\\" {
                escaping = true;
            } else if ch == "$" && _text_at(source, i + 1, "{") {
                in_string = false;
                if string_resume_count < string_resume_depths.length {
                    string_resume_depths[string_resume_count] = interpolation_depth;
                } else { string_resume_depths.push(interpolation_depth); }
                string_resume_count += 1;
                interpolation_depth += 1;
                previous_significant = "{";
                i += 2;
                continue;
            } else if ch == "\"" {
                in_string = false;
                previous_significant = "value";
            }
            i += 1;
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "/") {
            in_line_comment = true;
            i += 2;
            continue;
        }
        if ch == "/" && _text_at(source, i + 1, "*") {
            in_block_comment = true;
            i += 2;
            continue;
        }
        if ch == "!" && _text_at(source, i + 1, "[") {
            let effect_end = _effect_annotation_end(source, i);
            if effect_end >= 0 {
                i = effect_end;
                continue;
            }
        }
        if ch == "\"" {
            in_string = true;
            i += 1;
            continue;
        }
        if interpolation_depth > 0 && ch == "{" {
            interpolation_depth += 1;
            previous_significant = "{";
            i += 1;
            continue;
        }
        if interpolation_depth > 0 && ch == "}" {
            interpolation_depth -= 1;
            if string_resume_count > 0 {
                let resume_depth = string_resume_depths[string_resume_count - 1];
                if resume_depth == interpolation_depth {
                    string_resume_count -= 1;
                    in_string = true;
                }
            }
            previous_significant = "}";
            i += 1;
            continue;
        }
        if _is_space(ch) {
            i += 1;
            continue;
        }
        if contains(identifier_chars, ch) && !contains("0123456789", ch) {
            let start = i;
            i += 1;
            loop {
                if i >= source.length || !contains(identifier_chars, source[i]) {
                    break;
                }
                i += 1;
            }
            let word = substring(source, start, i);
            if word == root && previous_significant != "." {
                let mut expected = "(";
                if dotted { expected = "."; }
                let direct = _next_nontrivia_char(source, i) == expected;
                let mut parenthesized = false;
                if !direct {
                    parenthesized = _parenthesized_authority_has_follow(source, start, i, expected);
                }
                if direct || parenthesized { count += 1; }
            }
            previous_significant = "identifier";
            continue;
        }
        previous_significant = ch;
        i += 1;
    }
    return count;
}

fn _violation_diagnostic(importer: string, importee: string, importer_role: string, importee_role: string) -> string {
    return "compiler capsule boundary: importer '" + importer + "' ("
        + importer_role
        + ") imports '"
        + importee
        + "' ("
        + importee_role
        + "); violated rule: "
        + _role_rule(importer_role, importee_role);
}

fn _int_text(value: int) -> string {
    if value == 0 { return "0"; }
    let digits = "0123456789";
    let mut n = value;
    let mut out = "";
    loop {
        if n <= 0 { break; }
        out = digits[n % 10] + out;
        n = n / 10;
    }
    return out;
}

fn _report_boundary_failures(failures: string[]) ![io] {
    let mut i: int = 0;
    loop {
        if i >= failures.length { break; }
        print.error(failures[i]);
        i += 1;
    }
    assert failures.length == 0;
}

test "capsule roles: encode every SFEP-0020 dependency invariant" {
    assert ! _role_import_allowed(ROLE_SYNTAX, ROLE_ANALYZER);
    assert ! _role_import_allowed(ROLE_IR, ROLE_SYNTAX);
    assert ! _role_import_allowed(ROLE_IR, ROLE_ANALYZER);
    assert ! _role_import_allowed(ROLE_IR, ROLE_CODEGEN);
    assert ! _role_import_allowed(ROLE_IR, ROLE_LLVM);
    assert ! _role_import_allowed(ROLE_IR, ROLE_DRIVER);
    assert ! _role_import_allowed(ROLE_LLVM, ROLE_SYNTAX);
    assert ! _role_import_allowed(ROLE_LLVM, ROLE_ANALYZER);
    assert ! _role_import_allowed(ROLE_LLVM, ROLE_CODEGEN);
    assert ! _role_import_allowed(ROLE_LLVM, ROLE_DRIVER);
    assert ! _role_import_allowed(ROLE_ANALYZER, ROLE_DRIVER);
    assert ! _role_import_allowed(ROLE_CODEGEN, ROLE_DRIVER);
    assert ! _role_import_allowed(ROLE_LLVM, ROLE_AUTHORITY);
    assert ! _role_import_allowed(ROLE_CODEGEN, ROLE_AUTHORITY);
    assert ! _role_import_allowed(ROLE_ANALYZER, ROLE_UNKNOWN);
    assert ! _role_import_allowed(ROLE_DRIVER, ROLE_UNKNOWN);
    assert _role_import_allowed(ROLE_CODEGEN, ROLE_STDLIB);
    assert _role_import_allowed(ROLE_LLVM, ROLE_STDLIB);
    assert ! _role_import_allowed(ROLE_LLVM, ROLE_RUNTIME_INTERNAL);
    assert _role_import_allowed(ROLE_DRIVER, ROLE_SYNTAX);
    assert _role_import_allowed(ROLE_DRIVER, ROLE_ANALYZER);
    assert _role_import_allowed(ROLE_DRIVER, ROLE_IR);
    assert _role_import_allowed(ROLE_DRIVER, ROLE_CODEGEN);
    assert _role_import_allowed(ROLE_DRIVER, ROLE_LLVM);
    assert _role_import_allowed(ROLE_ANALYZER, ROLE_STDLIB);
    assert _role_import_allowed(ROLE_SYNTAX, ROLE_STDLIB);
    assert _role_import_allowed(ROLE_IR, ROLE_STDLIB);
    assert ! _role_import_allowed(ROLE_CODEGEN, ROLE_COMPAT_LEAF);
    assert ! _role_import_allowed(ROLE_ANALYZER, ROLE_RUNTIME_PRELUDE);
    assert ! _role_import_allowed(ROLE_LLVM, ROLE_RUNTIME_PRELUDE);
    assert _role_import_allowed(ROLE_SYNTAX, ROLE_RUNTIME_PRELUDE);
    assert _role_import_allowed(ROLE_IR, ROLE_RUNTIME_PRELUDE);
}

test "capsule roles: classification survives physical compiler capsule moves" {
    let current: WorkspaceMember[] = [_member("sfn/compiler", "compiler", "compiler/src", "binary"), _member("sfn/syntax", "compiler/capsules/syntax", "compiler/capsules/syntax/src", "library"), _member("sfn/analyzer", "compiler/capsules/analyzer", "compiler/capsules/analyzer/src", "library"), _member("sfn/ir", "compiler/capsules/ir", "compiler/capsules/ir/src", "library"), _member("sfn/codegen", "compiler/capsules/codegen", "compiler/capsules/codegen/src", "library"), _member("sfn/codegen-llvm", "compiler/capsules/codegen-llvm", "compiler/capsules/codegen-llvm/src", "library")];
    let moved: WorkspaceMember[] = [_member("sfn/compiler", "compiler/driver", "compiler/driver/src", "binary"), _member("sfn/syntax", "compiler/syntax", "compiler/syntax/src", "library"), _member("sfn/analyzer", "compiler/analyzer", "compiler/analyzer/src", "library"), _member("sfn/ir", "compiler/ir", "compiler/ir/src", "library"), _member("sfn/codegen", "compiler/codegen", "compiler/codegen/src", "library"), _member("sfn/codegen-llvm", "compiler/codegen-llvm", "compiler/codegen-llvm/src", "library")];
    assert _module_role("compiler/capsules/syntax/src/parser/mod.sfn", current) == ROLE_SYNTAX;
    assert _module_role("compiler/syntax/src/parser/mod.sfn", moved) == ROLE_SYNTAX;
    assert _module_role("compiler/capsules/analyzer/src/mod.sfn", current) == ROLE_ANALYZER;
    assert _module_role("compiler/analyzer/src/mod.sfn", moved) == ROLE_ANALYZER;
    assert _module_role("compiler/capsules/ir/src/native_ir.sfn", current) == ROLE_IR;
    assert _module_role("compiler/ir/src/native_ir.sfn", moved) == ROLE_IR;
    assert _module_role("compiler/capsules/codegen/src/emit_native.sfn", current) == ROLE_CODEGEN;
    assert _module_role("compiler/codegen/src/emit_native.sfn", moved) == ROLE_CODEGEN;
    assert _module_role("compiler/capsules/codegen-llvm/src/lowering/mod.sfn", current) == ROLE_LLVM;
    assert _module_role("compiler/codegen-llvm/src/lowering/mod.sfn", moved) == ROLE_LLVM;
    assert _edge_module_id("compiler/capsules/analyzer/src/type_interner.sfn", current) == "type_interner";
    assert _edge_module_id("compiler/analyzer/src/type_interner.sfn", moved) == "type_interner";
    assert _edge_module_id("compiler/capsules/codegen-llvm/src/lowering/mod.sfn", current) == "llvm/lowering/mod";
    assert _edge_module_id("compiler/codegen-llvm/src/lowering/mod.sfn", moved) == "llvm/lowering/mod";
    let moved_authority = _edge_module_id("compiler/codegen-llvm/src/atomics.sfn", moved);
    assert _find_authority_exception(_authority_exceptions(), moved_authority, "effect:io") < 0;
    assert _role_from_internal_spec("sfn/compiler/build") == ROLE_DRIVER;
    assert _role_from_internal_spec("sfn/fs/private") == ROLE_AUTHORITY;
    assert _role_from_internal_spec("sfn/strings/scan") == ROLE_STDLIB;
    assert _role_from_internal_spec("sfn/future-pure") == ROLE_UNKNOWN;
    assert _role_from_internal_spec("runtime/prelude") == ROLE_RUNTIME_PRELUDE;
    assert _role_from_internal_spec("runtime/sfn/filesystem") == ROLE_RUNTIME_INTERNAL;
    let impostor: WorkspaceMember[] = [_member("vendor/not-syntax", "compiler/syntax", "compiler/syntax/src", "library")];
    assert _module_role("compiler/syntax/src/parser/mod.sfn", impostor) == "";
}

test "capsule roles: current and target fixture roots keep one policy identity" ![io] {
    let current_root = "compiler/tests/unit/fixtures/repository_topology/transitional";
    let target_root = "compiler/tests/unit/fixtures/repository_topology/target";
    let current = load_workspace_members(current_root);
    let target = load_workspace_members(target_root);
    assert validate_unique_workspace_member_names(current, current_root);
    assert validate_unique_workspace_member_names(target, target_root);
    let current_source = _member_src_dir(current, "sfn/syntax") + "/mod.sfn";
    let target_source = _member_src_dir(target, "sfn/syntax") + "/mod.sfn";
    assert _module_role(current_source, current) == ROLE_SYNTAX;
    assert _module_role(target_source, target) == ROLE_SYNTAX;
    assert module_name_for_source_with_members(current_source, current) == "sfn/syntax/mod";
    assert module_name_for_source_with_members(target_source, target) == "sfn/syntax/mod";
    assert _edge_module_id(current_source, current) == _edge_module_id(target_source, target);
    let identity = parse_scope_name("sfn/syntax");
    assert capsule_artifact_dir(identity.scope, identity.name) == "build/capsules/sfn/syntax";
    let current_manifest = fs.readFile(current_root
        + "/compiler/capsules/syntax/capsule.toml");
    let target_manifest = fs.readFile(target_root
        + "/compiler/syntax/capsule.toml");
    assert toml_get_version(current_manifest) == toml_get_version(target_manifest);
    assert _has_empty_capability_ceiling(current_manifest);
    assert _has_empty_capability_ceiling(target_manifest);
    let current_publish = toml_get_publish(current_manifest);
    let target_publish = toml_get_publish(target_manifest);
    assert current_publish.publish != null;
    assert target_publish.publish != null;
    if current_publish.publish != null {
        let allowed: boolean = current_publish.publish;
        assert ! allowed;
    }
    if target_publish.publish != null {
        let allowed: boolean = target_publish.publish;
        assert ! allowed;
    }
}

test "capsule roles: duplicate canonical fixture names fail through workspace identity" ![io] {
    let root = "compiler/tests/unit/fixtures/repository_topology/duplicate_name";
    let members = load_workspace_members(root);
    assert members.length == 2;
    assert ! validate_unique_workspace_member_names(members, root);
}

test "compiler driver: orchestration and terminal-output owners classify as driver" {
    let members: WorkspaceMember[] = [_member("sfn/compiler", "compiler", "compiler/src", "binary")];
    assert _module_role("compiler/src/capsule_resolver/mod.sfn", members) == ROLE_DRIVER;
    assert _module_role("compiler/src/build/fs.sfn", members) == ROLE_DRIVER;
    assert _module_role("compiler/src/backend.sfn", members) == ROLE_DRIVER;
    assert _module_role("compiler/src/cli/commands/build.sfn", members) == ROLE_DRIVER;
    assert _module_role("compiler/src/terminal_output.sfn", members) == ROLE_DRIVER;
}

test "compiler capsule manifests: identity owns privacy, capability, dependency, and artifact policy" ![io] {
    let members = load_workspace_members(".");
    let mut checked: int = 0;
    let mut i: int = 0;
    loop {
        if i >= members.length { break; }
        let member = members[i];
        i += 1;
        let importer_role = compiler_capsule_role(member.name);
        if importer_role.length == 0 { continue; }
        let manifest_path = member.member_path + "/capsule.toml";
        let manifest = fs.readFile(manifest_path);
        let publish = toml_get_publish(manifest);
        assert publish.error.length == 0;
        assert publish.publish != null;
        if publish.publish != null {
            let allowed: boolean = publish.publish;
            assert ! allowed;
        }
        if importer_role != ROLE_DRIVER {
            assert _has_empty_capability_ceiling(manifest);
        }
        let dependencies = split(toml_get_dependencies(manifest), "\n");
        let mut di: int = 0;
        loop {
            if di >= dependencies.length { break; }
            let dependency = split(dependencies[di], "=");
            di += 1;
            if dependency.length == 0 || dependency[0].length == 0 { continue; }
            let importee_role = _manifest_dependency_role(dependency[0]);
            if !_role_import_allowed(importer_role, importee_role) {
                throw member.name + " (" + importer_role
                    + ") declares disallowed dependency "
                    + dependency[0]
                    + " ("
                    + importee_role
                    + ")";
            }
        }
        let identity = parse_scope_name(member.name);
        assert capsule_artifact_dir(identity.scope, identity.name) == "build/capsules/"
            + member.name;
        checked += 1;
    }
    assert checked == 6;
}

test "compiler capsule manifests: unknown dependencies fail closed" {
    let role = _manifest_dependency_role("vendor/capability");
    assert role == ROLE_UNKNOWN;
    assert ! _role_import_allowed(ROLE_CODEGEN, role);
    assert ! _role_import_allowed(ROLE_DRIVER, role);
}

test "compiler capsule manifests: capability ceilings must be explicitly empty" {
    assert _has_empty_capability_ceiling("[capabilities]\nrequired = []\n");
    assert ! _has_empty_capability_ceiling("[capsule]\nname = \"sfn/syntax\"\n");
    assert ! _has_empty_capability_ceiling("[capabilities]\nrequired = [\"io\"]\n");
}

test "stdlib reverse edges: future canonical libraries stay in the audit" {
    let future = _member("sfn/future-pure", "capsules/sfn/future-pure", "capsules/sfn/future-pure/src", "library");
    let compiler = _member("sfn/syntax", "compiler/syntax", "compiler/syntax/src", "library");
    let runtime = _member("sfn/runtime-native", "runtime", "runtime", "runtime");
    let vendor = _member("vendor/other", "vendor/other", "vendor/other/src", "library");
    assert _is_stdlib_reverse_edge_member(future);
    assert ! _is_stdlib_reverse_edge_member(compiler);
    assert ! _is_stdlib_reverse_edge_member(runtime);
    assert ! _is_stdlib_reverse_edge_member(vendor);
}

test "stdlib reverse edges: driver leaves stay internal across root moves" {
    let current: WorkspaceMember[] = [_member("sfn/compiler", "compiler", "compiler/src", "binary")];
    let moved: WorkspaceMember[] = [_member("sfn/compiler", "compiler/driver", "compiler/driver/src", "binary")];
    let current_role = _importee_role("compiler/src/string_utils.sfn", current);
    let moved_role = _importee_role("compiler/driver/src/string_utils.sfn", moved);
    assert current_role == ROLE_DRIVER;
    assert moved_role == ROLE_DRIVER;
    assert _is_internal_compiler_role(current_role);
    assert _is_internal_compiler_role(moved_role);
    let no_members: WorkspaceMember[] = [];
    assert _importee_role("compiler/src/string_utils.sfn", no_members) == ROLE_COMPAT_LEAF;
}

test "capsule diagnostics: new reverse edge identifies importer, importee, and role rule" {
    let message = _violation_diagnostic("compiler/capsules/ir/src/model.sfn", "sfn/analyzer", ROLE_IR, ROLE_ANALYZER);
    assert contains(message, "importer 'compiler/capsules/ir/src/model.sfn'");
    assert contains(message, "imports 'sfn/analyzer'");
    assert contains(message, "violated rule: IR may not depend on");
    let stdlib_message = _violation_diagnostic("stdlib/json/src/mod.sfn", "sfn/compiler", ROLE_STDLIB, ROLE_DRIVER);
    assert contains(stdlib_message, "violated rule: top-level standard-library capsules must not import internal compiler capsules");
}

test "capsule authority: scanner counts every unquoted token kind exactly" {
    let source = "// fs.readFile ignored\n"
        + "let quoted = \"process.run and env.get\";\n"
        + "if fs.exists(path) { fs.readFile(path); }\n"
        + "process.run(args);\n"
        + "env.get(\"HOME\");\n"
        + "io.read_line(0);\n"
        + "let rendered = \""
        + "$"
        + "{fs.readFile(path)} "
        + "$"
        + "{process.run(args)} "
        + "$"
        + "{http.download(url, dest)}\";\n"
        + "let nested = \""
        + "$"
        + "{ \"inner "
        + "$"
        + "{fs.readFile(path)}\" } "
        + "$"
        + "{process.run(args)}\";\n"
        + "let nested_member = record.fs.readFile;\n"
        + "let spaced_member = record. fs.readFile;\n"
        + "fs\n"
        + "    // direct-root trivia\n"
        + "    .readFile(path);\n"
        + "record.\n"
        + "    // nested-member trivia\n"
        + "    fs.readFile;\n"
        + "(fs).readFile(path);\n"
        + "((process)).run(args);\n"
        + "(record.fs).readFile;\n"
        + "let denied = ![fs.exists(path)][0];\n"
        + "serve(handler, 8080);\n"
        + "runtime_serve_fn(handler, config);\n"
        + "logExecution(task);\n"
        + "runtime_log_execution_fn(task);\n"
        + "((sleep))(1.0);\n"
        + "fn console_only() -> void ![io.console] {}\n"
        + "let refs = value; refs.length;\n";
    assert _direct_authority_count(source, "fs.") == 7;
    assert _direct_authority_count(source, "process.") == 4;
    assert _direct_authority_count(source, "env.") == 1;
    assert _direct_authority_count(source, "http.") == 1;
    assert _direct_authority_count(source, "io.") == 1;
    assert _direct_authority_count(source, "websocket.") == 0;
    assert _direct_authority_count(source, "serve") == 1;
    assert _direct_authority_count(source, "runtime_serve_fn") == 1;
    assert _direct_authority_count(source, "logExecution") == 1;
    assert _direct_authority_count(source, "runtime_log_execution_fn") == 1;
    assert _direct_authority_count(source, "sleep") == 1;
    let effects = "fn write() -> void ![io] { fs_write_file(path, text); }\n"
        + "@logExecution fn traced() -> void ![io] {}\n"
        + "fn server() -> void ![io, net] { runtime_serve_fn(handler, config); }\n"
        + "fn timed() -> int ![clock] { return runtime_monotonic_millis_fn(); }\n"
        + "fn effect_first() ![io] -> int { return 0; }\n"
        + "let lambda = fn () ![io] => 0;\n"
        + "fn spaced_bang() ! /* declaration trivia */ [io] -> int { return 0; }\n"
        + "fn listed_comment() -> void ![io /* list trivia */] {}\n"
        + "fn accelerator() -> void ![gpu, model, rand] {}\n";
    assert _declared_authority_effect_count(effects, "io") == 7;
    assert _declared_authority_effect_count(effects, "net") == 1;
    assert _declared_authority_effect_count(effects, "clock") == 1;
    assert _declared_authority_effect_count(effects, "gpu") == 1;
    assert _declared_authority_effect_count(effects, "model") == 1;
    assert _declared_authority_effect_count(effects, "rand") == 1;
}

test "capsule imports: runtime audit sees prelude and rejects hidden implementation specs" {
    let members: WorkspaceMember[] = [];
    let source = "import { char_code } from \"runtime/prelude\";\n"
        + "// import { hidden } from \"runtime/sfn/filesystem\";\n"
        + "import { read_secret } from \"runtime/sfn/filesystem\";\n";
    let specs = _collect_runtime_import_specs(source);
    assert specs.length == 2;
    assert specs[0] == "runtime/prelude";
    assert specs[1] == "runtime/sfn/filesystem";
    assert _role_import_allowed(ROLE_IR, _importee_role(specs[0], members));
    assert ! _role_import_allowed(ROLE_LLVM, _importee_role(specs[1], members));
}

test "capsule imports: scanner audits scoped and bare unknown dependencies" {
    let members: WorkspaceMember[] = [];
    let source = "import { strings_equal } from \"sfn/strings\";\n"
        + "// import { hidden } from \"vendor/hidden\";\n"
        + "import { reverse } from /* parser trivia */ \"../../typecheck/foo\";\n"
        + "import { scoped } from // line trivia\n\"vendor/capability\";\n"
        + "import { bare } from bare-package;\n"
        + "import { from as origin } from \"sfn/syntax\";\n"
        + "export { from as analyzed } from \"sfn/analyzer\";\n"
        + "export fn f(from: string) -> string { return from; }\n"
        + "fn export(from: string) -> string { return from; }\n"
        + "export { ir } from \"sfn/ir\"";
    let specs = _all_import_specs(source);
    assert specs.length == 7;
    assert specs[0] == "sfn/strings";
    assert specs[1] == "../../typecheck/foo";
    assert specs[2] == "vendor/capability";
    assert specs[3] == "bare-package";
    assert specs[4] == "sfn/syntax";
    assert specs[5] == "sfn/analyzer";
    assert specs[6] == "sfn/ir";
    assert _importee_role(specs[0], members) == ROLE_STDLIB;
    assert _importee_role(specs[2], members) == ROLE_UNKNOWN;
    assert _importee_role(specs[3], members) == ROLE_UNKNOWN;
    assert ! _role_import_allowed(ROLE_ANALYZER, _importee_role(specs[2], members));
    assert ! _role_import_allowed(ROLE_DRIVER, _importee_role(specs[3], members));
    assert _decode_import_string("..\\/diagnostic.sfn") == "../diagnostic.sfn";
}

test "capsule imports: explicit Sailfin extension resolves to the imported module" ![io] {
    let resolved = _resolve_relative_import("compiler/capsules/analyzer/src/typecheck_types/mod.sfn", "../diagnostic.sfn");
    assert resolved == "compiler/capsules/analyzer/src/diagnostic.sfn";
    let directory = _resolve_relative_import("compiler/capsules/analyzer/src/analyzer.sfn", "./typecheck.sfn");
    assert directory == "compiler/capsules/analyzer/src/typecheck/mod.sfn";
}

test "capsule boundaries: compiler imports obey the role graph and exact exception inventory" ![io] {
    let members = load_workspace_members(".");
    assert validate_unique_workspace_member_names(members, ".");
    let files = _collect_compiler_sources(members);
    let exceptions = _boundary_exceptions();
    let authority_exceptions = _authority_exceptions();
    let mut seen: boolean[] = [];
    let mut authority_seen: boolean[] = [];
    let mut ei: int = 0;
    loop {
        if ei >= exceptions.length { break; }
        seen.push(false);
        ei += 1;
    }
    let mut aei: int = 0;
    loop {
        if aei >= authority_exceptions.length { break; }
        authority_seen.push(false);
        aei += 1;
    }
    let mut failures: string[] = [];
    let mut syntax_count: int = 0;
    let mut analyzer_count: int = 0;
    let mut ir_count: int = 0;
    let mut codegen_count: int = 0;
    let mut llvm_count: int = 0;
    let mut driver_count: int = 0;
    let mut import_count: int = 0;
    let mut fi: int = 0;
    loop {
        if fi >= files.length { break; }
        let importer = files[fi];
        fi += 1;
        let importer_role = _module_role(importer, members);
        if importer_role.length == 0 {
            failures.push("unclassified compiler module: '" + importer
                + "'; assign one SFEP-0020 semantic role before adding dependencies");
            continue;
        }
        if importer_role == ROLE_SYNTAX { syntax_count += 1; }
        if importer_role == ROLE_ANALYZER { analyzer_count += 1; }
        if importer_role == ROLE_IR { ir_count += 1; }
        if importer_role == ROLE_CODEGEN { codegen_count += 1; }
        if importer_role == ROLE_LLVM { llvm_count += 1; }
        if importer_role == ROLE_DRIVER { driver_count += 1; }
        let source = fs.readFile(importer);
        if importer_role == ROLE_CODEGEN {
            let frontend_apis: string[] = ["analyze_lambda_captures", "parse_program"];
            let mut frontend_api_index: int = 0;
            loop {
                if frontend_api_index >= frontend_apis.length { break; }
                let frontend_api = frontend_apis[frontend_api_index];
                frontend_api_index += 1;
                if contains(source, frontend_api) {
                    failures.push("codegen frontend re-entry: module '"
                        + importer
                        + "' references '"
                        + frontend_api
                        + "'; violated rule: capture analysis and parsing finish before the IR boundary");
                }
            }
        }
        if importer_role == ROLE_LLVM {
            // SFEP-0020 §3.5.3: target providers own symbol and ABI lowering,
            // not target-neutral intrinsic identity or semantic effects. IR is
            // otherwise a legal dependency, so guard the semantic APIs by name.
            let intrinsic_semantic_apis: string[] = ["IntrinsicEffectEntry", "IntrinsicEffectTable", "append_intrinsic_effects", "empty_intrinsic_effects", "intrinsic_effect_table", "intrinsic_effects_for_callee_target", "intrinsic_effects_for_exact_target", "intrinsic_effects_for_target"];
            let mut intrinsic_api_index: int = 0;
            loop {
                if intrinsic_api_index >= intrinsic_semantic_apis.length {
                    break;
                }
                let intrinsic_api = intrinsic_semantic_apis[intrinsic_api_index];
                intrinsic_api_index += 1;
                if contains(source, intrinsic_api) {
                    failures.push("LLVM provider imports target-neutral intrinsic semantics: module '"
                        + importer
                        + "' references '"
                        + intrinsic_api
                        + "'; violated rule: LLVM owns only symbol and ABI lowering");
                }
            }
        }
        if importer_role != ROLE_DRIVER {
            // Provider libraries may still carry temporary I/O effect
            // exceptions, but persistent artifact publication is driver-only.
            // Quoted runtime-helper names are ignored by
            // `_direct_authority_count`.
            let publication_tokens: string[] = ["fs.appendFile", "fs.createDirectory", "fs.deleteFile", "fs.mkdtemp", "fs.removeDirectory", "fs.set_perms", "fs.symlink", "fs.writeFile", "fs.writeLines"];
            let mut publication_i: int = 0;
            loop {
                if publication_i >= publication_tokens.length { break; }
                let publication_token = publication_tokens[publication_i];
                publication_i += 1;
                let publication_count = _direct_authority_count(source, publication_token);
                if publication_count > 0 {
                    failures.push("compiler capsule persistent mutation authority: module '"
                        + importer
                        + "' ("
                        + importer_role
                        + ") calls '"
                        + publication_token
                        + "' directly; violated rule: only the compiler driver mutates persistent artifact state");
                }
            }
            // Compilable Sailfin code must declare every transitive effect, so
            // capability effects are the stable authority boundary even when
            // prelude roots are locally aliased or renamed during extraction.
            let authority_effects: string[] = ["clock", "gpu", "io", "model", "net", "rand"];
            let mut authority_effect_i: int = 0;
            loop {
                if authority_effect_i >= authority_effects.length { break; }
                let effect = authority_effects[authority_effect_i];
                authority_effect_i += 1;
                let effect_count = _declared_authority_effect_count(source, effect);
                if effect_count <= 0 { continue; }
                let effect_token = "effect:" + effect;
                let authority_module = _edge_module_id(importer, members);
                let authority_index = _find_authority_exception(authority_exceptions, authority_module, effect_token);
                if authority_index >= 0 {
                    authority_seen[authority_index] = true;
                    let expected = authority_exceptions[authority_index].expected_count;
                    if effect_count != expected {
                        failures.push("compiler capsule authority effect count changed: module '"
                            + importer
                            + "' ("
                            + importer_role
                            + ") declares '"
                            + effect
                            + "' "
                            + _int_text(effect_count)
                            + " times; exact exception expects "
                            + _int_text(expected));
                    }
                } else {
                    failures.push("compiler capsule authority effect: module '"
                        + importer
                        + "' ("
                        + importer_role
                        + ") declares '"
                        + effect
                        + "' "
                        + _int_text(effect_count)
                        + " times; violated rule: internal compiler libraries target required = []");
                }
            }
        }
        let specs = _all_import_specs(source);
        import_count += specs.length;
        let mut si: int = 0;
        loop {
            if si >= specs.length { break; }
            let spec = specs[si];
            let importee = _importee_path(importer, spec);
            si += 1;
            if importee.length == 0 { continue; }
            if importer_role == ROLE_CODEGEN {
                if contains(spec, "typecheck_captures") || contains(spec, "/parser") {
                    failures.push("codegen frontend re-entry: module '"
                        + importer
                        + "' imports '"
                        + spec
                        + "'; violated rule: capture analysis and parsing finish before the IR boundary");
                }
            }
            let importee_role = _importee_role(importee, members);
            if importee_role.length == 0 { continue; }
            if _role_import_allowed(importer_role, importee_role) { continue; }
            let importer_id = _edge_module_id(importer, members);
            let importee_id = _edge_module_id(importee, members);
            let exception_index = _find_exception(exceptions, importer_id, importee_id);
            if exception_index >= 0 {
                seen[exception_index] = true;
                continue;
            }
            failures.push(_violation_diagnostic(importer, importee, importer_role, importee_role));
        }
    }
    let mut stale_i: int = 0;
    loop {
        if stale_i >= exceptions.length { break; }
        if !seen[stale_i] {
            let stale = exceptions[stale_i];
            failures.push("stale compiler capsule exception: importer '" + stale.importer
                + "' no longer imports '"
                + stale.importee
                + "'; remove seam '"
                + stale.seam
                + "'");
        }
        stale_i += 1;
    }
    let mut stale_authority_i: int = 0;
    loop {
        if stale_authority_i >= authority_exceptions.length { break; }
        if !authority_seen[stale_authority_i] {
            let stale = authority_exceptions[stale_authority_i];
            failures.push("stale compiler capsule authority exception: module '"
                + stale.module
                + "' no longer uses exact token '"
                + stale.token
                + "' "
                + _int_text(stale.expected_count)
                + " times; remove seam '"
                + stale.seam
                + "'");
        }
        stale_authority_i += 1;
    }
    assert files.length > 300;
    assert syntax_count > 20;
    assert analyzer_count > 20;
    assert ir_count > 10;
    assert codegen_count > 5;
    assert llvm_count > 100;
    assert driver_count > 50;
    assert import_count > 500;
    _report_boundary_failures(failures);
}

test "capsule boundaries: check multi-capsule staging excludes LLVM lowering" ![io] {
    let members = load_workspace_members(".");
    let driver_src = _member_src_dir(members, "sfn/compiler");
    let analyzer_src = _member_src_dir(members, "sfn/analyzer");
    assert driver_src.length > 0;
    assert analyzer_src.length > 0;
    let mut queue: string[] = [driver_src + "/check/engine.sfn"];
    let mut seen: string[] = [];
    let mut analyzer_seen: int = 0;
    let mut index: int = 0;
    loop {
        if index >= queue.length { break; }
        let path = queue[index];
        index += 1;
        if !fs.exists(path) { continue; }
        if _boundary_string_index(seen, path) >= 0 { continue; }
        seen.push(path);
        let specs = _all_import_specs(fs.readFile(path));
        let mut spec_index: int = 0;
        loop {
            if spec_index >= specs.length { break; }
            let mut imported = _importee_path(path, specs[spec_index]);
            spec_index += 1;
            if imported == "sfn/analyzer" {
                imported = analyzer_src + "/mod.sfn";
            } else if starts_with(imported, "sfn/analyzer/") {
                let analyzer_prefix = "sfn/analyzer/";
                let suffix = substring(imported, analyzer_prefix.length, imported.length);
                let file_candidate = analyzer_src + "/" + suffix + ".sfn";
                let module_candidate = analyzer_src + "/" + suffix + "/mod.sfn";
                if fs.exists(file_candidate) { imported = file_candidate; } else if fs.exists(module_candidate) {
                    imported = module_candidate;
                }
            }
            let imported_role = _module_role(imported, members);
            if imported_role == ROLE_DRIVER || imported_role == ROLE_ANALYZER {
                queue.push(imported);
            }
        }
    }
    let mut closure_index: int = 0;
    loop {
        if closure_index >= seen.length { break; }
        let module_path = seen[closure_index];
        let module_role = _module_role(module_path, members);
        if module_role == ROLE_ANALYZER { analyzer_seen += 1; }
        assert module_role != ROLE_LLVM;
        assert module_path != driver_src + "/main.sfn";
        closure_index += 1;
    }
    assert seen.length > 20;
    assert analyzer_seen > 20;
}

test "capsule boundaries: top-level standard-library capsules do not import compiler internals" ![io] {
    let members = load_workspace_members(".");
    let files = _collect_stdlib_sources(members);
    let mut failures: string[] = [];
    let mut fi: int = 0;
    loop {
        if fi >= files.length { break; }
        let importer = files[fi];
        fi += 1;
        let specs = _all_import_specs(fs.readFile(importer));
        let mut si: int = 0;
        loop {
            if si >= specs.length { break; }
            let importee = _importee_path(importer, specs[si]);
            si += 1;
            if importee.length == 0 { continue; }
            let importee_role = _importee_role(importee, members);
            if !_is_internal_compiler_role(importee_role) { continue; }
            failures.push(_violation_diagnostic(importer, importee, ROLE_STDLIB, importee_role));
        }
    }
    assert files.length > 20;
    _report_boundary_failures(failures);
}
