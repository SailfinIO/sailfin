// Regression tests for toml_get_dependencies() and capsule dependency
// resolution helpers used by compile-time dependency resolution.
import {
    toml_get_capabilities_dev_required,
    toml_get_capabilities_required,
    toml_get_dependencies,
    toml_get_dev_dependencies,
    toml_has_capabilities_section,
    toml_merge_capabilities_required
} from "../../src/toml_parser";

// -- Local helpers for string assertions --
fn _str_eq(a: string, b: string) -> boolean { return strings_equal(a, b); }

fn _contains(haystack: string, needle: string) -> boolean {
    if needle.length == 0 { return true; }
    if haystack.length < needle.length { return false; }
    let mut i: int = 0;
    loop {
        if i + needle.length > haystack.length { break; }
        let mut j: int = 0;
        let mut matches: boolean = true;
        loop {
            if j >= needle.length { break; }
            if haystack[i + j] != needle[j] {
                matches = false;
                break;
            }
            j += 1;
        }
        if matches { return true; }
        i += 1;
    }
    return false;
}

fn _starts_with(value: string, prefix: string) -> boolean {
    if prefix.length > value.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= prefix.length { break; }
        if value[i] != prefix[i] { return false; }
        i += 1;
    }
    return true;
}

// Lookup a dep version from the newline-separated deps string.
// Duplicated here to test the format contract independently.
fn _test_lookup_dep(deps: string, name: string) -> string {
    if deps.length == 0 { return ""; }
    let mut start: int = 0;
    let len = deps.length;
    loop {
        if start >= len { break; }
        let mut end: int = start;
        loop {
            if end >= len { break; }
            if deps[end] == "\n" { break; }
            end += 1;
        }
        let mut eq_pos: int = -1;
        let mut ei: int = start;
        loop {
            if ei >= end { break; }
            if deps[ei] == "=" {
                eq_pos = ei;
                break;
            }
            ei += 1;
        }
        if eq_pos > start {
            let dep_name = substring(deps, start, eq_pos);
            if strings_equal(dep_name, name) {
                return substring(deps, eq_pos + 1, end);
            }
        }
        start = end + 1;
    }
    return "";
}

// -- Tests --
test "toml_get_dependencies: empty toml returns empty string" {
    let toml = "[capsule]\nname = \"test\"\nversion = \"0.1.0\"\n";
    let deps = toml_get_dependencies(toml);
    assert _str_eq(deps, "");
}

test "toml_get_dependencies: empty deps section returns empty string" {
    let toml = "[capsule]\nname = \"test\"\n\n[dependencies]\n\n[build]\nentry = \"src/main.sfn\"\n";
    let deps = toml_get_dependencies(toml);
    assert _str_eq(deps, "");
}

test "toml_get_dependencies: single dependency" {
    let toml = "[capsule]\nname = \"myapp\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"cli\" = \"0.2.0\"\n";
    let deps = toml_get_dependencies(toml);
    assert _str_eq(deps, "cli=0.2.0");
}

test "toml_get_dependencies: multiple dependencies" {
    let toml = "[capsule]\nname = \"myapp\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"cli\" = \"0.2.0\"\n\"acme/router\" = \"1.0.0\"\n";
    let deps = toml_get_dependencies(toml);
    assert _contains(deps, "cli=0.2.0");
    assert _contains(deps, "acme/router=1.0.0");
    // Should be newline-separated
    assert _contains(deps, "\n");
}

test "toml_get_dependencies: round-trip lookup" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\n\"cli\" = \"0.2.0\"\n\"http\" = \"0.3.1\"\n\"acme/router\" = \"2.0.0\"\n";
    let deps = toml_get_dependencies(toml);

    // Lookup each dependency by name
    assert _str_eq(_test_lookup_dep(deps, "cli"), "0.2.0");
    assert _str_eq(_test_lookup_dep(deps, "http"), "0.3.1");
    assert _str_eq(_test_lookup_dep(deps, "acme/router"), "2.0.0");

    // Non-existent dependency returns ""
    assert _str_eq(_test_lookup_dep(deps, "nonexistent"), "");
    assert _str_eq(_test_lookup_dep(deps, ""), "");
}

test "toml_get_dependencies: dev-deps are excluded" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\n\"cli\" = \"0.2.0\"\n\n[dev-dependencies]\n\"test\" = \"0.1.0\"\n";
    let deps = toml_get_dependencies(toml);
    assert _str_eq(_test_lookup_dep(deps, "cli"), "0.2.0");
    // dev-deps should NOT appear
    assert _str_eq(_test_lookup_dep(deps, "test"), "");
}

test "toml_get_dependencies: quoted keys preserved" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\n\"sfn/special\" = \"0.5.0\"\n";
    let deps = toml_get_dependencies(toml);
    // The toml parser strips quotes, so the key should be "sfn/special"
    assert _str_eq(_test_lookup_dep(deps, "sfn/special"), "0.5.0");
}

// -- toml_get_dev_dependencies (SFN-988) --
test "toml_get_dev_dependencies: absent section returns empty string" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\n\"cli\" = \"0.2.0\"\n";
    assert _str_eq(toml_get_dev_dependencies(toml), "");
}

test "toml_get_dev_dependencies: same line format as toml_get_dependencies" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dev-dependencies]\n\"sfn/test\" = \"0.1.0\"\n\"demo/mock\" = \"*\"\n";
    let deps = toml_get_dev_dependencies(toml);
    assert _str_eq(deps, "sfn/test=0.1.0\ndemo/mock=*");
    assert _str_eq(_test_lookup_dep(deps, "sfn/test"), "0.1.0");
    assert _str_eq(_test_lookup_dep(deps, "demo/mock"), "*");
}

test "toml_get_dev_dependencies: normal deps are excluded" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\n\"cli\" = \"0.2.0\"\n\n[dev-dependencies]\n\"test\" = \"0.1.0\"\n";
    let deps = toml_get_dev_dependencies(toml);
    assert _str_eq(_test_lookup_dep(deps, "test"), "0.1.0");
    assert _str_eq(_test_lookup_dep(deps, "cli"), "");
}

// -- toml_merge_capabilities_required (#1395) --
test "merge caps: into empty required set records dep capabilities" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\n[capabilities]\nrequired = []\n\n[build]\nentry = \"src/main.sfn\"\n";
    let merged = toml_merge_capabilities_required(toml, ["io", "net"]);
    let caps = toml_get_capabilities_required(merged);
    assert caps.length == 2;
    assert _contains(merged, "\"io\"");
    assert _contains(merged, "\"net\"");
}

test "merge caps: union preserves existing and dedupes" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\n[capabilities]\nrequired = [\"io\"]\n\n[build]\nentry = \"src/main.sfn\"\n";
    let merged = toml_merge_capabilities_required(toml, ["io", "net"]);
    let caps = toml_get_capabilities_required(merged);
    // io already present, net is new — union of size 2, no duplicate io.
    assert caps.length == 2;
    assert _str_eq(caps[0], "io");
    assert _str_eq(caps[1], "net");
}

test "merge caps: empty list leaves required unchanged" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\n[capabilities]\nrequired = [\"io\"]\n\n[build]\nentry = \"src/main.sfn\"\n";
    let empty: string[] = [];
    let merged = toml_merge_capabilities_required(toml, empty);
    let caps = toml_get_capabilities_required(merged);
    assert caps.length == 1;
    assert _str_eq(caps[0], "io");
}

test "merge caps: dependency surface preserved through write round-trip" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"sfn/http\" = \"0.3.0\"\n\n[capabilities]\nrequired = []\n\n[build]\nentry = \"src/main.sfn\"\n";
    let merged = toml_merge_capabilities_required(toml, ["io", "net"]);
    // Dependency must survive the parse/merge/write round-trip.
    let deps = toml_get_dependencies(merged);
    assert _contains(deps, "sfn/http=0.3.0");
    let caps = toml_get_capabilities_required(merged);
    assert caps.length == 2;
}

// -------------------------------------------------------------------
// SFN-764: section presence, independent of section contents
// -------------------------------------------------------------------
// `toml_get_capabilities_required` returns an empty list for three
// different manifests, so it cannot answer "did the author declare a
// ceiling?". These pin the predicate that can. The header-recognition
// edges live here rather than in an e2e because they are pure string
// scanning — driving a subprocess to test `#` handling would be absurd.
test "capabilities section: an explicit empty required is still declared" {
    // The case the whole issue turns on. Both calls see an empty list;
    // only the predicate distinguishes the deny-all ceiling from an
    // absent section.
    let toml = "[capsule]\nname = \"app\"\n\n[capabilities]\nrequired = []\n";
    assert toml_has_capabilities_section(toml);
    assert toml_get_capabilities_required(toml).length == 0;
}

test "capabilities section: absent when the manifest has no such section" {
    let toml = "[capsule]\nname = \"app\"\nversion = \"0.1.0\"\n\n[build]\nentry = \"src/main.sfn\"\n";
    assert ! toml_has_capabilities_section(toml);
    assert toml_get_capabilities_required(toml).length == 0;
}

test "capabilities section: declared when required is present and non-empty" {
    let toml = "[capsule]\nname = \"app\"\n\n[capabilities]\nrequired = [\"io\", \"net\"]\n";
    assert toml_has_capabilities_section(toml);
    assert toml_get_capabilities_required(toml).length == 2;
}

test "capabilities section: declared even when the required key is missing" {
    // Fail-closed depends on this: a section whose `required` key never
    // parsed must still count as declared, so the ceiling denies rather
    // than silently granting everything.
    let toml = "[capsule]\nname = \"app\"\n\n[capabilities]\n\n[build]\nentry = \"src/main.sfn\"\n";
    assert toml_has_capabilities_section(toml);
    assert toml_get_capabilities_required(toml).length == 0;
}

test "capabilities section: a commented-out header does not count" {
    // `#` lines are skipped before the header test, matching every other
    // section scan in the parser. A reader who comments the section out
    // has removed it, and must not get a surprise deny-all ceiling.
    let toml = "[capsule]\nname = \"app\"\n\n# [capabilities]\n# required = []\n";
    assert ! toml_has_capabilities_section(toml);
}

test "capabilities section: a differently-scoped header does not count" {
    // `[workspace.capabilities]` is the SFEP-0051 envelope, a different
    // tier; `[capsule.capabilities]` is a plausible misspelling. Neither
    // is this capsule's ceiling, so both read as absent — the residue
    // E0407 exists to catch when the manifest is unreadable outright.
    let ws = "[capsule]\nname = \"app\"\n\n[workspace.capabilities]\nallow = [\"io\"]\n";
    assert ! toml_has_capabilities_section(ws);
    let misspelled = "[capsule]\nname = \"app\"\n\n[capsule.capabilities]\nrequired = [\"io\"]\n";
    assert ! toml_has_capabilities_section(misspelled);
}

test "capabilities section: header recognition tolerates whitespace and comments" {
    // Same trimming and first-`]` scan `toml_get_string_array` uses, so
    // the two can never disagree about whether a section exists.
    assert toml_has_capabilities_section("  [capabilities]  \nrequired = []\n");
    assert toml_has_capabilities_section("[ capabilities ]\nrequired = []\n");
    assert toml_has_capabilities_section("[capabilities] # the ceiling\nrequired = []\n");
}

test "capabilities section: absent from an empty or non-manifest text" {
    assert ! toml_has_capabilities_section("");
    assert ! toml_has_capabilities_section("this is not a manifest at all\n");
}

// -------------------------------------------------------------------
// SFN-1216: dev-required, the test-time half of the ceiling
// -------------------------------------------------------------------
test "dev-required: parsed independently of required" {
    let toml = "[capsule]\nname = \"app\"\n\n[capabilities]\nrequired = [\"io\", \"rand\"]\ndev-required = [\"clock\"]\n";
    let shipped = toml_get_capabilities_required(toml);
    assert shipped.length == 2;
    let dev = toml_get_capabilities_dev_required(toml);
    assert dev.length == 1;
    assert _str_eq(dev[0], "clock");
}

test "dev-required: absent means empty, so old manifests are unchanged" {
    // The compatibility guarantee: a manifest written before the key
    // existed must behave exactly as it did.
    let toml = "[capsule]\nname = \"app\"\n\n[capabilities]\nrequired = [\"io\"]\n";
    assert toml_get_capabilities_dev_required(toml).length == 0;
    assert toml_get_capabilities_required(toml).length == 1;
}

test "dev-required: does not leak into the shipped surface" {
    // `required` must not pick up dev entries. The key names overlap by
    // suffix, so this pins that the scan matches whole keys.
    let toml = "[capsule]\nname = \"app\"\n\n[capabilities]\ndev-required = [\"clock\"]\n";
    assert toml_get_capabilities_required(toml).length == 0;
    assert toml_get_capabilities_dev_required(toml).length == 1;
    // The section still counts as declared, so the ceiling is deny-all
    // for shipped code even though a dev entry exists.
    assert toml_has_capabilities_section(toml);
}
