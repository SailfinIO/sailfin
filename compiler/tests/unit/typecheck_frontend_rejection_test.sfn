// Unit tests for the SFN-385/SFN-584 check/build divergence closures: four
// static-analysis diagnostics that make `sfn check` reject programs that
// previously checked green but only failed at `sfn build` (or lowering).
//
// - E0012 — a method call on a primitive type that resolves to nothing
//   (e.g. `field.to_uppercase()` where `field: string`).
// - E0830 — a malformed array type spelling (`[int]` or `[]string`
//   instead of the canonical `int[]` / `string[]`).
// - E0306 — arithmetic mixing a proven `int` and `float` operand.
// - E0308 — arithmetic on two named, explicitly typed struct operands.
// - E0310 — an array assignment (struct-literal field init, annotated `let`,
//   or plain assignment) whose two sides prove distinct element classes.
//
// These parse a small `.sfn` source through `parse_program` and run
// `typecheck_diagnostics` end-to-end, asserting on the `Diagnostic.code`
// field, mirroring typecheck_bare_fn_type_test.sfn.
import { typecheck_diagnostics } from "sfn/analyzer/typecheck";
import { Diagnostic } from "sfn/analyzer/typecheck_types";
import { parse_program } from "sfn/syntax";

fn _has_code(diagnostics: Diagnostic[], code: string) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= diagnostics.length { break; }
        if strings_equal(diagnostics[i].code, code) { return true; }
        i += 1;
    }
    return false;
}

// -------------------------------------------------------------------
// E0012 — method call on a primitive that resolves to nothing.
// -------------------------------------------------------------------
test "frontend-rejection: rejects unknown method on string-typed param (E0012)" ![io] {
    let source = "fn u(field: string) -> string { return field.to_uppercase(); } "
        + "fn main() -> int { let _ = u(\"h\"); return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0012");
}

test "frontend-rejection: accepts real method on string-typed param" ![io] {
    let source = "fn t(s: string) -> string { return s.substring(0, 1); } "
        + "fn main() -> int { let _ = t(\"h\"); return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0012");
}

test "frontend-rejection: unannotated receiver stays silent for E0012 (fail-open)" ![io] {
    let source = "fn main() -> int { let x = something(); let _ = x.whatever(); return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0012");
}

// -------------------------------------------------------------------
// E0830 — malformed array type spelling.
// -------------------------------------------------------------------
test "frontend-rejection: rejects bracket-prefix array type [int] (E0830)" ![io] {
    let source = "fn main() -> int { let xs: [int] = []; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0830");
}

test "frontend-rejection: rejects bracket-prefix array type []string (E0830)" ![io] {
    let source = "fn main() -> int { let xs: []string = []; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0830");
}

test "frontend-rejection: accepts canonical array type int[]" ![io] {
    let source = "fn main() -> int { let xs: int[] = []; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0830");
}

test "frontend-rejection: accepts canonical array type string[]" ![io] {
    let source = "fn main() -> int { let xs: string[] = []; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0830");
}

test "frontend-rejection: rejects malformed array type in parameter position (E0830)" ![io] {
    let source = "fn f(xs: []string) -> int { return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0830");
}

// -------------------------------------------------------------------
// E0306 — arithmetic mixing a proven int and float.
// -------------------------------------------------------------------
test "frontend-rejection: rejects named int+float arithmetic mix (E0306)" ![io] {
    let source = "fn main() -> int { let a: int = 3; let b: float = 2.0; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0306");
}

// Deliberate fail-open boundary: a literal-involving mix (`3 + 2.0`) is NOT
// caught by E0306 at check time. The lowerer coerces a literal against its
// sibling in an order/direction-dependent way, so a frontend rule over literals
// would risk false positives on the valid coercions; such mixes are left to the
// lowerer's own "ABI primitive mismatch" fatal (still rejected end-to-end, just
// not at the frontend). E0306 fires only on two typed (named) operands.
test "frontend-rejection: literal-only int+float mix is left to the lowerer (no E0306)" ![io] {
    let source = "fn main() -> int { let c = 3 + 2.0; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0306");
}

test "frontend-rejection: accepts same-type int arithmetic" ![io] {
    let source = "fn main() -> int { let a: int = 3; let b: int = 2; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0306");
}

test "frontend-rejection: accepts mixed-width int-class arithmetic" ![io] {
    let source = "fn main() -> int { let a: int = 3; let b: i32 = 2; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0306");
}

// A bare numeric literal paired with a typed operand coerces to the typed
// side's kind in lowering (bidirectional literal-context propagation in
// `lower_binary_operation`), so `float_var + int_literal` compiles and must NOT
// be rejected — pinning the literal-coercion exemption that keeps E0306 in exact
// parity with the lowerer (regression: numeric_int_default_test.sfn case 3).
test "frontend-rejection: accepts typed-var plus numeric-literal arithmetic" ![io] {
    let source = "fn main() -> int { let a: float = 2.0; let c = a + 5; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0306");
}

// -------------------------------------------------------------------
// E0308 — arithmetic on proven struct operands.
// -------------------------------------------------------------------
test "frontend-rejection: rejects named Point+Point arithmetic at the operator (E0308)" ![io] {
    let source = "struct Point { x: int; } "
        + "fn main() -> int { let a: Point = Point { x: 1 }; "
        + "let b: Point = Point { x: 2 }; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    let mut found: Diagnostic? = null;
    let mut i: int = 0;
    loop {
        if i >= diagnostics.length { break; }
        if strings_equal(diagnostics[i].code, "E0308") {
            found = diagnostics[i];
            break;
        }
        i += 1;
    }
    assert found != null;
    assert found.primary != null;
    assert strings_equal(found.primary.lexeme, "+");
}

test "frontend-rejection: inferred struct bindings stay silent for E0308" ![io] {
    let source = "struct Point { x: int; } "
        + "fn main() -> int { let a = Point { x: 1 }; "
        + "let b = Point { x: 2 }; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0308");
}

test "frontend-rejection: rejects named generic struct arithmetic (E0308)" ![io] {
    let source = "struct Box<T> { value: T; } "
        + "fn main() -> int { let a: Box<int> = Box<int> { value: 1 }; "
        + "let b: Box<int> = Box<int> { value: 2 }; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: rejects explicitly typed top-level struct arithmetic (E0308)" ![io] {
    let source = "struct Point { x: int; } "
        + "let a: Point = Point { x: 1 }; let b: Point = Point { x: 2 }; "
        + "fn main() -> int { let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: forward struct declaration proves top-level arithmetic" ![io] {
    let source = "let a: Point = Point { x: 1 }; let b: Point = Point { x: 2 }; "
        + "let c = a + b; struct Point { x: int; } fn main() -> int { return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: top-level value and type duplicate stays E0001 in either order" ![io] {
    let function_first = parse_program("fn Point() -> int { return 0; } struct Point { x: int; }");
    let struct_first = parse_program("struct Point { x: int; } fn Point() -> int { return 0; }");
    assert _has_code(typecheck_diagnostics(function_first), "E0001");
    assert _has_code(typecheck_diagnostics(struct_first), "E0001");
}

test "frontend-rejection: rejects explicitly typed struct parameters (E0308)" ![io] {
    let source = "struct Point { x: int; } "
        + "fn add(a: Point, b: Point) -> int { let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: rejects explicitly typed struct lambda parameters (E0308)" ![io] {
    let source = "struct Point { x: int; } "
        + "fn main() -> int { let f = fn(a: Point, b: Point) -> int { "
        + "let c = a + b; return 0; }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: value local named Point does not hide struct proof" ![io] {
    let source = "struct Point { x: int; } "
        + "fn main() -> int { let Point: int = 0; "
        + "let a: Point = Point { x: 1 }; let b: Point = Point { x: 2 }; "
        + "let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: lambda value parameter named Point does not hide struct proof" ![io] {
    let source = "struct Point { x: int; } "
        + "fn main() -> int { let f = fn(Point: int, a: Point, b: Point) -> int { "
        + "let c = a + b; return 0; }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: nested function named Point does not hide struct proof" ![io] {
    let source = "struct Point { x: int; } fn outer() -> int { "
        + "fn Point() -> int { return 0; } "
        + "fn add(a: Point, b: Point) -> int { let c = a + b; return 0; } "
        + "return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: generic struct arrays stay on E0307, not E0308" ![io] {
    let source = "struct Box<T> { value: T; } "
        + "fn main() -> int { let a: Box<int>[] = []; "
        + "let b: Box<int>[] = []; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0307");
    assert ! _has_code(diagnostics, "E0308");
}

test "frontend-rejection: function type parameter shadowing a struct stays silent for E0308" ![io] {
    let source = "struct T { value: int; } "
        + "fn add<T>(a: T, b: T) -> int { let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0308");
}

test "frontend-rejection: global structs stay proven under use-site generic shadowing" ![io] {
    let source = "struct Point { x: int; } "
        + "let a: Point = Point { x: 1 }; let b: Point = Point { x: 2 }; "
        + "fn use<Point>() -> int { let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0308");
}

test "frontend-rejection: generic owner type parameter shadowing a struct stays silent" ![io] {
    let source = "struct T { value: int; } "
        + "struct Box<T> { fn add(a: T, b: T) -> int { let c = a + b; return 0; } }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0308");
}

test "frontend-rejection: struct type aliases stay silent for E0308" ![io] {
    let source = "struct Point { x: int; } type P = Point; "
        + "fn main() -> int { let a: P = Point { x: 1 }; "
        + "let b: P = Point { x: 2 }; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0308");
}

test "frontend-rejection: enum operands do not masquerade as structs for E0308" ![io] {
    let source = "enum Choice { A, B } "
        + "fn main() -> int { let a: Choice = Choice.A; "
        + "let b: Choice = Choice.B; let c = a + b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0308");
}

// Fail-open across a capture boundary: a primitive local captured into a
// nested fn is tagged `outer_local` with no `declared_prim`, so a method
// call on it stays silent (E0012 must not fire — under-firing is safe).
test "frontend-rejection: captured outer primitive stays silent (no E0012)" ![io] {
    let source = "fn outer() -> int { let s: string = \"hi\"; fn inner() -> int { let _ = s.to_uppercase(); return 0; } return inner(); }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0012");
}

// -------------------------------------------------------------------
// E0310 — array element type mismatch (SFN-910).
// -------------------------------------------------------------------
test "frontend-rejection: rejects struct-literal field init with Member actual (E0310)" ![io] {
    let source = "struct Diag { code: string; } struct Holder { labels: string[]; } struct Source { diags: Diag[]; } "
        + "fn main() -> int { let src: Source = Source { diags: [] }; "
        + "let h: Holder = Holder { labels: src.diags }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects struct-literal field init in the reverse direction (E0310)" ![io] {
    let source = "struct Diag { code: string; } struct Holder { labels: string[]; } struct Source { diags: Diag[]; } "
        + "fn main() -> int { let h: Holder = Holder { labels: [] }; "
        + "let src: Source = Source { diags: h.labels }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects annotated let with Identifier actual (E0310)" ![io] {
    let source = "struct Diag { code: string; } "
        + "fn main() -> int { let ds: Diag[] = []; let strs: string[] = ds; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects member-target array assignment (E0310)" ![io] {
    let source = "struct Diag { code: string; } struct Holder { labels: string[]; } struct Source { diags: Diag[]; } "
        + "fn main() -> int { let h: Holder = Holder { labels: [] }; "
        + "let src: Source = Source { diags: [] }; h.labels = src.diags; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects identifier-target array assignment (E0310)" ![io] {
    let source = "struct Diag { code: string; } "
        + "fn main() -> int { let mut strs: string[] = []; let structs: Diag[] = []; "
        + "strs = structs; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects a parameter as the mismatched actual (E0310)" ![io] {
    let source = "struct Diag { code: string; } struct Holder { labels: string[]; } "
        + "fn f(ds: Diag[]) -> Holder { return Holder { labels: ds }; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects struct A array assigned where struct B array is declared (E0310)" ![io] {
    let source = "struct A { x: int; } struct B { y: int; } "
        + "fn main() -> int { let mut a: A[] = []; let b: B[] = []; a = b; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects int[] assigned where string[] is declared (E0310)" ![io] {
    let source = "fn main() -> int { let n: int[] = []; let s: string[] = n; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects a lambda-body let mismatch (E0310)" ![io] {
    let source = "struct Diag { code: string; } "
        + "fn main() -> int { let f = fn() -> int { "
        + "let ds: Diag[] = []; let ss: string[] = ds; return 0; }; return f(); }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}

// The empty array literal `[]` is the universal bottom the backend
// materializes as a zeroed `double*` descriptor and bitcasts to the target
// type; every reader below pins the exemption load-bearing for the
// self-hosted tree's own empty-literal bottoms (`ir/src/typed_ssa.sfn:1080-1097`).
test "frontend-rejection: empty array literal stays silent on an annotated let (no E0310)" ![io] {
    let source = "fn main() -> int { let labels: string[] = []; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: empty array literal stays silent on a member-target assignment (no E0310)" ![io] {
    let source = "struct Holder { labels: string[]; } "
        + "fn main() -> int { let h: Holder = Holder { labels: [] }; h.labels = []; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: empty array literal stays silent on a struct-literal field (no E0310)" ![io] {
    let source = "struct Holder { labels: string[]; } "
        + "fn main() -> int { let h: Holder = Holder { labels: [] }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: non-empty array literal actual stays silent (no E0310)" ![io] {
    let source = "struct Holder { labels: string[]; } "
        + "fn main() -> int { let h: Holder = Holder { labels: [\"x\"] }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: call actual stays silent (no E0310)" ![io] {
    let source = "struct Diag { code: string; } struct Holder { labels: string[]; } "
        + "fn make_diags() -> Diag[] { return []; } "
        + "fn main() -> int { let h: Holder = Holder { labels: make_diags() }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: unannotated binding actual stays silent (no E0310)" ![io] {
    let source = "struct Diag { code: string; } struct Holder { labels: string[]; } "
        + "fn make_diags() -> Diag[] { return []; } "
        + "fn main() -> int { let ds = make_diags(); let h: Holder = Holder { labels: ds }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: SfnString[] into string[] is accepted (no E0310)" ![io] {
    let source = "fn main() -> int { let a: SfnString[] = []; let b: string[] = a; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: i64[] into int[] is accepted (no E0310)" ![io] {
    let source = "fn main() -> int { let a: i64[] = []; let b: int[] = a; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: string[] into string[] is the accepted baseline (no E0310)" ![io] {
    let source = "fn main() -> int { let a: string[] = []; let b: string[] = a; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

// `Box<T>`'s declared field annotation is the unsubstituted `T[]`, and a
// program-level struct named `T` (shadowing the type-parameter name, mirroring
// the E0308 precedent at line 264) proves a REAL struct class for that bare
// name. Without the `generic_struct_names` guard this would misclassify the
// unsubstituted `T[]` as `struct:T` and fire a false positive against the
// `Diag[]` actual (SFN-910).
test "frontend-rejection: generic struct field annotation stays silent (no E0310)" ![io] {
    // The INFERRED form `Box { ... }` is the one that exercises the guard: an
    // explicitly parameterized `Box<T> { ... }` parses to the single type-name
    // segment `Box<T>`, which `_struct_field_expected_type` fails to resolve,
    // so the check bails on a null expected type before the guard is read
    // (SFN-910).
    let source = "struct T { value: int; } struct Diag { code: string; } "
        + "struct Box<T> { items: T[]; } "
        + "fn main() -> int { let ds: Diag[] = []; "
        + "let b = Box { items: ds }; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: a scoped type-parameter element stays silent (no E0310)" ![io] {
    // A top-level `struct T` plus a DIFFERING expected class is what makes
    // this bite: without the type-parameter gate the scoped `T` would resolve
    // against that struct declaration and conflict with `string[]`. Same-class
    // or no-such-struct shapes pass whether the gate runs or not (SFN-910).
    let source = "struct T { value: int; } "
        + "fn f<T>(xs: T[]) -> int { let ss: string[] = xs; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: a member read off a generic instantiation stays silent (no E0310)" ![io] {
    // `_struct_field_annotation_text` refuses a receiver whose declared struct
    // carries type arguments: `Pair<string>` still declares `first: T[]`, and
    // reading that unsubstituted `T[]` against the top-level `struct T` would
    // fire a false positive on correct code (SFN-910).
    let source = "struct T { value: int; } struct Pair<T> { first: T[]; } "
        + "fn use_pair(p: Pair<string>) -> int { "
        + "let ss: string[] = p.first; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: an element type with no declaration stays silent (no E0310)" ![io] {
    let source = "struct Diag { code: string; } "
        + "fn main() -> int { let ds: Diag[] = []; let bogus: Bogus[] = ds; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: nested Diag[][] into string[][] stays silent (no E0310)" ![io] {
    let source = "struct Diag { code: string; } "
        + "fn main() -> int { let a: Diag[][] = []; let b: string[][] = a; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: optional element Diag?[] into string?[] stays silent (no E0310)" ![io] {
    let source = "struct Diag { code: string; } "
        + "fn main() -> int { let a: Diag?[] = []; let b: string?[] = a; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: a type-alias element stays silent (no E0310)" ![io] {
    let source = "type Str = string; "
        + "fn main() -> int { let a: Str[] = []; let b: string[] = a; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: an enum element stays silent (no E0310)" ![io] {
    let source = "enum Choice { A, B } "
        + "fn main() -> int { let a: Choice[] = []; let b: string[] = a; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: compound array assignment stays off E0310" ![io] {
    let source = "struct Diag { code: string; } struct Holder { labels: string[]; } struct Source { diags: Diag[]; } "
        + "fn main() -> int { let h: Holder = Holder { labels: [] }; "
        + "let src: Source = Source { diags: [] }; h.labels += src.diags; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert ! _has_code(diagnostics, "E0310");
}

test "frontend-rejection: rejects a top-level (module-global) let as the actual (E0310)" ![io] {
    let source = "struct Diag { code: string; } let ds: Diag[] = []; "
        + "fn main() -> int { let ss: string[] = ds; return 0; }";
    let program = parse_program(source);
    let diagnostics = typecheck_diagnostics(program);
    assert _has_code(diagnostics, "E0310");
}
