// Unit coverage for SFEP-0057 `${ }` string interpolation (SFN-482 Phase 1).
// Black-box (compile + evaluate), mirroring string_append_test.sfn — the
// scanner (`parse_dollar_interpolated_template`) is a lowering-time concern
// with no directly callable front-end entry point, so behavior is asserted
// through compiled program output.
struct Boxed {
    a: int;
}

test "interpolation: ${ } basic identifier" {
    let name = "world";
    let result = "Hello, ${name}!";
    assert result == "Hello, world!";
}

test "interpolation: ${ } whitespace at the edges is insignificant" {
    let name = "world";
    assert "a${name}b" == "aworldb";
    assert "a${ name }b" == "aworldb";
}

test "interpolation: ${ } multiple segments" {
    let a = "x";
    let b = "y";
    assert "${a}-${b}-${a}" == "x-y-x";
}

test "interpolation: ${ } with an int expression" {
    let n = 42;
    assert "n=${n}" == "n=42";
}

test "interpolation: bare $ not followed by a brace stays literal" {
    let name = "world";
    assert "Total: $5 for ${name}" == "Total: $5 for world";
}

test "interpolation: nested braces are matched by depth, not the first }" {
    let boxed = Boxed { a: 7 };
    assert "v=${ (Boxed { a: 7 }).a }" == "v=7";
    assert boxed.a == 7;
}

// SFEP-0057 Phase 4 removal gate: `{{ }}` carries no special meaning and is
// no longer scanned, so a brace pair survives into the string as literal text.
test "interpolation: {{ }} is literal text, not an interpolation" {
    let name = "world";
    // The expected value is assembled from fragments that never contain an
    // adjacent `{{` pair, so it stays literal under any scanner — comparing
    // against a `{{name}}` literal would pass even if the form still
    // interpolated (both sides would expand alike).
    let expected = "Hello, " + "{" + "{name}" + "}" + "!";
    assert "Hello, {{name}}!" == expected;
    assert "Hello, {{name}}!".length == 16;
    // Keeps `name` live now that no literal above references it.
    assert name == "world";
}

test "interpolation: {{ }} and ${ } in one literal only expands ${ }" {
    let name = "world";
    assert "{{name}}=${name}" == "{{name}}=world";
}
