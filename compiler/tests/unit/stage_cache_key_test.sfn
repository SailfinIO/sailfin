// Unit tests for `stage_cache_key_for` (SFN-861), the cache key for the
// STAGING artifacts (`.sfn-asm` + `.layout-manifest`), distinct from
// `cache_key_for`'s per-module `.ll`/`.o` key.
//
// Mirrors the determinism/sensitivity coverage `build_cache_test.sfn`
// already has for `cache_key_for`, scoped to `stage_cache_key_for`'s
// narrower input set (no dep manifests — see the function's doc comment
// for why).
import { remove_all } from "sfn/fs";
import { scratch_root } from "sfn/test";

import { cache_key_for, is_valid_digest, stage_cache_key_for } from "../../src/build_cache";
import { SourceIdentityOwner, source_identity_for, source_role_library } from "../../src/module_paths";

fn _sck_tmp_root(label: string) -> string ![io] {
    let base = scratch_root();
    fs.createDirectory(base, true);
    return fs.mkdtemp(base + "/sfn_stage_cache_key_test_" + label + "_");
}

fn _sck_cleanup(path: string) ![io] { remove_all(path); }

fn _sck_write(path: string, content: string) ![io] {
    fs.writeFile(path, content);
}

// --------------------------------------------------------------
// Determinism
// --------------------------------------------------------------
test "stage_cache_key_for: same inputs -> same digest" ![io] {
    let scratch = _sck_tmp_root("determinism");
    let src = scratch + "/source.sfn";
    _sck_write(src, "fn hello() -> string { return \"world\"; }");
    let key1 = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    let key2 = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    assert key1.digest == key2.digest;
    assert key1.digest.length == 64;
    _sck_cleanup(scratch);
}

// --------------------------------------------------------------
// Sensitivity
// --------------------------------------------------------------
test "stage_cache_key_for: differing slug -> different digest" ![io] {
    let scratch = _sck_tmp_root("slug_sensitive");
    let src = scratch + "/source.sfn";
    _sck_write(src, "fn hello() -> string { return \"world\"; }");
    let key_a = stage_cache_key_for(src, "mod_a", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    let key_b = stage_cache_key_for(src, "mod_b", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    assert key_a.digest != key_b.digest;
    _sck_cleanup(scratch);
}

test "stage_cache_key_for: physical move with stable manifest identity reuses digest" ![io] {
    let scratch = _sck_tmp_root("manifest_identity_move");
    let old_root = scratch + "/old/src";
    let new_root = scratch + "/new/src";
    fs.createDirectory(old_root, true);
    fs.createDirectory(new_root, true);
    let old_source = old_root + "/mod.sfn";
    let new_source = new_root + "/mod.sfn";
    _sck_write(old_source, "fn hello() -> string { return \"world\"; }");
    _sck_write(new_source, "fn hello() -> string { return \"world\"; }");
    let old_identity = source_identity_for(old_source, SourceIdentityOwner {
        manifest_name: "sfn/example", member_root: scratch + "/old", source_root: old_root, module_prefix: ""
    }, source_role_library());
    let new_identity = source_identity_for(new_source, SourceIdentityOwner {
        manifest_name: "sfn/example", member_root: scratch + "/new", source_root: new_root, module_prefix: ""
    }, source_role_library());
    assert old_identity.ok;
    assert new_identity.ok;
    assert old_identity.module_name == new_identity.module_name;
    let old_key = stage_cache_key_for(old_source, old_identity.module_name, "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    let new_key = stage_cache_key_for(new_source, new_identity.module_name, "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    assert old_key.digest == new_key.digest;
    let no_deps: string[] = [];
    let no_dep_slugs: string[] = [];
    let old_module_key = cache_key_for(old_source, no_dep_slugs, no_deps, "0.5.10-alpha.2", "[]", old_identity.module_name, "x86_64-unknown-linux-gnu");
    let new_module_key = cache_key_for(new_source, no_dep_slugs, no_deps, "0.5.10-alpha.2", "[]", new_identity.module_name, "x86_64-unknown-linux-gnu");
    assert old_module_key.digest == new_module_key.digest;
    _sck_cleanup(scratch);
}

test "stage_cache_key_for: manifest rename invalidates digest" ![io] {
    let scratch = _sck_tmp_root("manifest_identity_rename");
    let source_root = scratch + "/src";
    fs.createDirectory(source_root, true);
    let source = source_root + "/mod.sfn";
    _sck_write(source, "fn hello() -> string { return \"world\"; }");
    let first = source_identity_for(source, SourceIdentityOwner {
        manifest_name: "sfn/first", member_root: scratch, source_root: source_root, module_prefix: ""
    }, source_role_library());
    let second = source_identity_for(source, SourceIdentityOwner {
        manifest_name: "sfn/second", member_root: scratch, source_root: source_root, module_prefix: ""
    }, source_role_library());
    let first_key = stage_cache_key_for(source, first.module_name, "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    let second_key = stage_cache_key_for(source, second.module_name, "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    assert first_key.digest != second_key.digest;
    _sck_cleanup(scratch);
}

test "stage_cache_key_for: differing compiler version -> different digest" ![io] {
    let scratch = _sck_tmp_root("version_sensitive");
    let src = scratch + "/source.sfn";
    _sck_write(src, "fn hello() -> string { return \"world\"; }");
    let key1 = stage_cache_key_for(src, "mymod", "0.5.10-alpha.1", "x86_64-unknown-linux-gnu");
    let key2 = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    assert key1.digest != key2.digest;
    _sck_cleanup(scratch);
}

test "stage_cache_key_for: differing target triple -> different digest" ![io] {
    let scratch = _sck_tmp_root("target_sensitive");
    let src = scratch + "/source.sfn";
    _sck_write(src, "fn hello() -> string { return \"world\"; }");
    let key_linux = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    let key_darwin = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "aarch64-apple-darwin");
    assert key_linux.digest != key_darwin.digest;
    _sck_cleanup(scratch);
}

test "stage_cache_key_for: differing source content -> different digest" ![io] {
    let scratch = _sck_tmp_root("source_sensitive");
    let src = scratch + "/source.sfn";
    _sck_write(src, "fn hello() -> string { return \"world\"; }");
    let key1 = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    _sck_write(src, "fn hello() -> string { return \"WORLD\"; }");
    let key2 = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    assert key1.digest != key2.digest;
    _sck_cleanup(scratch);
}

// --------------------------------------------------------------
// Fail-open on an unreadable source
// --------------------------------------------------------------
test "stage_cache_key_for: missing source -> empty, invalid digest" ![io] {
    let scratch = _sck_tmp_root("missing_source");
    let src = scratch + "/does-not-exist.sfn";
    let key = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    assert key.digest == "";
    assert ! is_valid_digest(key.digest);
    _sck_cleanup(scratch);
}

// --------------------------------------------------------------
// Domain separation from `cache_key_for`
// --------------------------------------------------------------
// `stage1:` vs `tgt2:` keeps the two key spaces disjoint even for the
// same source/slug/version/triple tuple with empty dep lists — a
// staging-cache entry can never alias a `.ll` cache entry.
test "stage_cache_key_for: digest differs from cache_key_for for the same source/slug/version/triple" ![io] {
    let scratch = _sck_tmp_root("domain_separation");
    let src = scratch + "/source.sfn";
    _sck_write(src, "fn hello() -> string { return \"world\"; }");
    let no_deps: string[] = [];
    let no_dep_slugs: string[] = [];
    let stage_key = stage_cache_key_for(src, "mymod", "0.5.10-alpha.2", "x86_64-unknown-linux-gnu");
    let module_key = cache_key_for(src, no_dep_slugs, no_deps, "0.5.10-alpha.2", "[]", "mymod", "x86_64-unknown-linux-gnu");
    assert stage_key.digest != module_key.digest;
    _sck_cleanup(scratch);
}
