// Structured-diagnostic coverage for the `emit_native` channel — SFN-538,
// design SFEP-0061 §5.2 S7. Before this, `EmitNativeResult.diagnostics` was
// produced and never read at any of its `main.sfn` call sites; the typed
// `EmitNativeResult.diags` sidecar added alongside it carries a code, a
// stage, a severity, and a real span.
//
// Scope: emission only, via the two in-process entry points. SFN-608 gave the
// primary lines path its own `EmitNativeLines` carrier, so both are covered
// here; the CLI-level assertion lives in
// `compiler/tests/e2e/emit_native_structured_diagnostic_test.sfn`.
import { parse_program } from "sfn/syntax";

import { empty_llvm_import_context, resolve_llvm_provider_context } from "../../src/build/llvm_provider_context";
import { diag_is_error } from "../../src/diagnostic";
import {
    emit_native_diag_lines,
    emit_native_lines_with_module_name,
    emit_native_with_module_name
} from "../../src/emit_native";
import { lower_native_lines_to_llvm_artifact_with_context_and_provider } from "../../src/llvm/lowering/entrypoints";
import { index_of } from "../../src/string_utils";

fn _contains(haystack: string, needle: string) -> boolean {
    return index_of(haystack, needle) >= 0;
}

// A struct field whose annotation resolves to neither a primitive, a known
// struct, nor a known enum takes the pointer-layout fallback in
// `analyze_type_layout` (`emit_native_layout.sfn`), which is the most common
// emit-native diagnostic in practice.
fn _unresolved_field_source() -> string {
    return "struct Holder { payload: NotAKnownType; }\nfn main() ![io] { let h: int = 1; }";
}

// The layout diagnostics reach `NativeState` through
// `state_merge_layout_diagnostics`, which stamps the declaration's
// `name_span` onto each one — so a message produced deep in the layout walk,
// where no span survives, still renders with a location.
test "emit_native: a layout diagnostic carries code, stage, severity and a span" ![io] {
    let program = parse_program(_unresolved_field_source());
    let result = emit_native_with_module_name(program, "test_emit_native_diag");
    let mut found: boolean = false;
    let mut index: int = 0;
    loop {
        if index >= result.diags.length { break; }
        let diag = result.diags[index];
        if diag.code == "E1018" {
            found = true;
            assert diag.stage == "emit-native";
            assert diag.severity == "note";
            assert _contains(diag.message, "native layout:");
            assert diag.span != null;
            assert diag.span.start_line == 1;
        }
        index += 1;
    }
    assert found;
}

// Invariant guard: the sidecar is purely additive. The legacy `string[]`
// channel — which `state_add_diagnostic` also writes into the `.sfn-asm`
// builder as a `"; <message>"` comment — must keep carrying the raw message,
// never a rendered form, or the emitted IR bytes shift.
test "emit_native: the legacy string channel stays byte-identical to the raw message" ![io] {
    let program = parse_program(_unresolved_field_source());
    let result = emit_native_with_module_name(program, "test_emit_native_diag");
    assert result.diagnostics.length == result.diags.length;
    let mut index: int = 0;
    loop {
        if index >= result.diags.length { break; }
        assert result.diagnostics[index] == result.diags[index].message;
        index += 1;
    }
}

// The renderer mirrors `render_lowering_error_diag` (`llvm/utils.sfn`): the
// legacy spelling on line one, then an indented `-->` location line.
test "emit_native: the renderer emits the code and a location line" ![io] {
    let program = parse_program(_unresolved_field_source());
    let result = emit_native_with_module_name(program, "test_emit_native_diag");
    let lines = emit_native_diag_lines(result.diags);
    let mut found: boolean = false;
    let mut index: int = 0;
    loop {
        if index >= lines.length { break; }
        if _contains(lines[index], "E1018") {
            if _contains(lines[index], "--> ") {
                if _contains(lines[index], ":1:") { found = true; }
            }
        }
        index += 1;
    }
    assert found;
}

// SFN-608 parity guard. `emit_native_lines_with_module_name` is the path every
// normal compile takes; `emit_native_with_module_name` is the fallback one the
// tests above cover. Both project the same `_emit_native_state` core, so their
// sidecars must agree entry-for-entry — if they ever diverge, the primary path
// is silently dropping (or inventing) diagnostics that no other test would see.
//
// Both calls run against the SAME `Program`, so this also guards the
// lifting-idempotence assumption the deleted fallback reports rest on: if
// `lift_non_capturing_lambdas` ever mutated its input, the second emit would
// diverge and this test would catch it.
test "emit_native: the lines path carries the same diags as the module path" ![io] {
    let program = parse_program(_unresolved_field_source());
    let module_result = emit_native_with_module_name(program, "test_emit_native_diag");
    let lines_result = emit_native_lines_with_module_name(program, "test_emit_native_diag");
    assert lines_result.artifact_name == module_result.module.artifacts[0].name;
    assert lines_result.artifact_format == module_result.module.artifacts[0].format;
    assert lines_result.diags.length > 0;
    assert lines_result.diags.length == module_result.diags.length;
    let mut index: int = 0;
    loop {
        if index >= module_result.diags.length { break; }
        assert lines_result.diags[index].code == module_result.diags[index].code;
        assert lines_result.diags[index].message == module_result.diags[index].message;
        assert lines_result.diags[index].severity == module_result.diags[index].severity;
        assert lines_result.diags[index].stage == module_result.diags[index].stage;
        index += 1;
    }
}

test "emit artifacts: LLVM lowering returns identity and lines without a destination" ![io] {
    let program = parse_program("fn main() -> int { return 0; }");
    let native = emit_native_lines_with_module_name(program, "artifact_contract_test");
    let llvm = lower_native_lines_to_llvm_artifact_with_context_and_provider(native.lines, "artifact_contract_test", empty_llvm_import_context(), resolve_llvm_provider_context());
    assert llvm.ok;
    assert llvm.artifact_name == "module.ll";
    assert llvm.artifact_format == "llvm-ir-text";
    assert llvm.lines.length > 0;
    assert llvm.failure_message.length == 0;
}

// SFEP-0061 §4 and D2: every previously-untagged site migrates to `note`,
// never `warning` or `error`. An `error` here would turn a currently-green
// build red, which SFN-538's acceptance criteria forbid.
test "emit_native: no diagnostic is promoted to error severity" ![io] {
    let program = parse_program(_unresolved_field_source());
    let result = emit_native_with_module_name(program, "test_emit_native_diag");
    assert result.diags.length > 0;
    let mut index: int = 0;
    loop {
        if index >= result.diags.length { break; }
        assert ! diag_is_error(result.diags[index]);
        index += 1;
    }
}
