// Regression for SFN-719: `sfn run` must not write its built binary to a
// FIXED path. On Windows a running `.exe` is locked by the OS, so a nested
// or concurrent `sfn run` sharing the same fixed name fails to link over
// it; every platform also risks one run's binary being clobbered by
// another's before it finishes executing.
//
// `run_scratch_isolation_test.sfn` (#1411) already locks the
// `SAILFIN_TEST_SCRATCH`-guarded pool path, where per-invocation isolation
// comes from the scratch dir itself and the fixed `run` name is
// deliberately left untouched. This test locks the OTHER branch: the
// unguarded default (`build/sailfin`, relative to CWD) that a plain-CLI or
// nested invocation hits when no scratch is set. It drives children in a
// private, per-test CWD (so relative `build/sailfin` never touches the
// repo's own or another test's) with `SAILFIN_TEST_SCRATCH` explicitly
// absent from the child env.
//
// Both tests spawn asynchronously (`process.spawn_with_env_cwd` +
// `process.handle_wait`, not `process.run_capture`) so the fixture can be
// probed WHILE still running — a blocking `run_capture` only ever sees
// the directory after `sfn run`'s own post-exit cleanup has already run,
// which would make the naming assertion vacuous.
import { find, int_to_string } from "sfn/strings";
import { clean_runner_env, nested_runner_scratch, sfn_bin_abs_path } from "sfn/test";

// A self-contained fixture (no external capsule deps) written under a
// private per-test directory, which also serves as the CHILD's cwd — so
// its own `build/sailfin` is isolated from the repo's and from every
// other test. `sleep_ms` gives an external observer a window to probe
// `build/sailfin` (or spawn an overlapping second invocation) while the
// built binary is still executing.
fn _ensure_fixture(root: string, sleep_ms: int) -> void ![io] {
    fs.createDirectory(root + "/src", true);
    fs.writeFile(root + "/capsule.toml", "[capsule]\n"
        + "name = \"sfn719/probe\"\n"
        + "version = \"0.1.0\"\n\n"
        + "[build]\n"
        + "entry = \"src/main.sfn\"\n"
        + "kind = \"binary\"\n");
    fs.writeFile(root + "/src/main.sfn", "fn main() -> int ![clock, io] {\n"
        + "    sleep("
        + int_to_string(sleep_ms)
        + ");\n"
        + "    print(\"7\");\n"
        + "    return 0;\n"
        + "}\n");
}

fn _ends_with(text: string, suffix: string) -> boolean {
    if suffix.length > text.length { return false; }
    return substring(text, text.length - suffix.length, text.length) == suffix;
}

// Count EXECUTABLE entries directly under `dir` whose name starts with
// "run-" — the per-invocation naming scheme (`_unique_run_stem` in
// `compiler/src/cli/commands/run.sfn`).
//
// The `.ll` and `.work` exclusions are load-bearing, not tidiness. It used to be free:
// the IR was the fixed `run.ll`, which starts with "run." and so never
// matched the "run-" prefix. SFN-1004 moved the IR onto the same
// per-invocation stem as the exe, so `run-<millis>.ll` now sits beside
// `run-<millis>[.exe]`; SFN-1144 adds `run-<millis>.work` for transient
// runtime/link artifacts. Both would match without the suffix filters.
fn _count_run_exe_entries(dir: string) -> int ![io] {
    if !fs.exists(dir) { return 0; }
    let entries = fs.listDirectory(dir);
    let mut count: int = 0;
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        if find(name, "run-", 0) == 0 && !_ends_with(name, ".ll") && !_ends_with(name, ".work") {
            count += 1;
        }
        i += 1;
    }
    return count;
}

// Poll `dir` for a "run-" entry up to `~deadline_ms`, sleeping between
// probes. `sfn run` needs to compile+link before the fixture's own
// `sleep()` even starts, so the exe doesn't appear the instant the
// process is spawned.
fn _wait_for_run_exe_entry(dir: string, deadline_ms: int) -> boolean ![clock, io] {
    let mut waited: int = 0;
    loop {
        if _count_run_exe_entries(dir) > 0 { return true; }
        if waited >= deadline_ms { return false; }
        sleep(100);
        waited += 100;
    }
}

// Every EXECUTABLE entry directly under `dir` whose name starts with
// "run-" (SFN-974), mirroring `_count_run_exe_entries`'s filters.
fn _run_exe_names(dir: string) -> string[] ![io] {
    if !fs.exists(dir) { return []; }
    let entries = fs.listDirectory(dir);
    let mut names: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        if find(name, "run-", 0) == 0 && !_ends_with(name, ".ll") && !_ends_with(name, ".work") {
            names.push(name);
        }
        i += 1;
    }
    return names;
}

// Every "run-*.ll" entry directly under `dir` (SFN-1004's per-invocation IR).
fn _count_run_ll_entries(dir: string) -> int ![io] {
    if !fs.exists(dir) { return 0; }
    let entries = fs.listDirectory(dir);
    let mut count: int = 0;
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        if find(name, "run-", 0) == 0 && _ends_with(name, ".ll") { count += 1; }
        i += 1;
    }
    return count;
}

// Every per-invocation runtime/link workspace (SFN-1144).
fn _count_run_work_entries(dir: string) -> int ![io] {
    if !fs.exists(dir) { return 0; }
    let entries = fs.listDirectory(dir);
    let mut count: int = 0;
    let mut i: int = 0;
    loop {
        if i >= entries.length { break; }
        let name = entries[i];
        if find(name, "run-", 0) == 0 && _ends_with(name, ".work") {
            count += 1;
        }
        i += 1;
    }
    return count;
}

// Fold `names` into `set`, keeping `set` a duplicate-free union across
// repeated polls (a name observed on poll N and again on poll N+1 must not
// double-count).
fn _union_unique(set: string[], names: string[]) -> string[] {
    let mut out: string[] = set;
    let mut i: int = 0;
    loop {
        if i >= names.length { break; }
        let name = names[i];
        let mut already: boolean = false;
        let mut j: int = 0;
        loop {
            if j >= out.length { break; }
            if out[j] == name {
                already = true;
                break;
            }
            j += 1;
        }
        if !already { out.push(name); }
        i += 1;
    }
    return out;
}

test "run: unguarded default path mints a per-invocation exe name and cleans up after itself" ![clock, io] {
    let root = nested_runner_scratch("run-exe-isolation-single");
    _ensure_fixture(root, 1500);
    // Deliberately no `SAILFIN_TEST_SCRATCH` in the child env: this
    // exercises the unguarded default (`build/sailfin`, relative to the
    // child's own cwd), not the already-isolated scratch-guarded branch.
    let child_env = clean_runner_env("");
    let sailfin_dir = root + "/build/sailfin";

    let handle = process.spawn_with_env_cwd([sfn_bin_abs_path(), "run", "src/main.sfn"], child_env, root);
    assert handle != 0;
    // While the fixture is still sleeping inside its own execution, its
    // exe must be present under a per-invocation "run-" name — never the
    // fixed legacy `run`/`run.exe`.
    assert _wait_for_run_exe_entry(sailfin_dir, 60000);
    assert ! fs.exists(sailfin_dir + "/run");
    assert ! fs.exists(sailfin_dir + "/run.exe");
    assert _count_run_exe_entries(sailfin_dir) == 1;

    let out = process.handle_read_stdout(handle);
    let _err = process.handle_read_stderr(handle);
    let exit = process.handle_wait(handle);
    assert exit == 0;
    assert find(out, "7", 0) >= 0;
    // `sfn run` deletes its own exe once its child has exited — the
    // per-invocation scheme stays bounded rather than accumulating a new
    // binary on every `sfn run`.
    assert _count_run_exe_entries(sailfin_dir) == 0;
    assert _count_run_work_entries(sailfin_dir) == 0;
}

// SFN-974: three, not two and not four — three is enough to demonstrate
// N-way claiming, and each extra concurrent `sfn run` child costs ~3 GiB
// against the pool's memory budget (`.claude/rules/compiler-safety.md`),
// so doubling the prior two-child count is not free.
test "run: three overlapping invocations in one directory all succeed with distinct names" ![clock, io] {
    let root = nested_runner_scratch("run-exe-isolation-overlap");
    _ensure_fixture(root, 1500);
    let child_env = clean_runner_env("");
    let bin = sfn_bin_abs_path();
    let sailfin_dir = root + "/build/sailfin";

    // Start all three before waiting on any, so their builds and their
    // fixtures' own `sleep()` genuinely overlap in the same directory —
    // the acceptance criterion in SFN-719 ("concurrent `sfn run` invocations
    // in one directory all succeed"), extended by SFN-974 to prove they also
    // claim distinct names rather than merely not crashing each other.
    let handle_a = process.spawn_with_env_cwd([bin, "run", "src/main.sfn"], child_env, root);
    let handle_b = process.spawn_with_env_cwd([bin, "run", "src/main.sfn"], child_env, root);
    let handle_c = process.spawn_with_env_cwd([bin, "run", "src/main.sfn"], child_env, root);
    assert handle_a != 0;
    assert handle_b != 0;
    assert handle_c != 0;

    // Poll the directory every 50ms, unioning every observed "run-" name,
    // WHILE all three are still overlapping (before any `handle_wait`
    // blocks on one). Reliable rather than timing-dependent because of the
    // design this pins: the claim happens before the compile (SFN-974), so
    // each name sits on disk for the whole compile+link+run window
    // (seconds), not just the fixture's 1500ms sleep.
    let mut seen: string[] = [];
    let mut waited: int = 0;
    loop {
        seen = _union_unique(seen, _run_exe_names(sailfin_dir));
        if seen.length >= 3 { break; }
        if waited >= 60000 { break; }
        sleep(50);
        waited += 50;
    }

    let out_a = process.handle_read_stdout(handle_a);
    let err_a = process.handle_read_stderr(handle_a);
    let exit_a = process.handle_wait(handle_a);

    let out_b = process.handle_read_stdout(handle_b);
    let err_b = process.handle_read_stderr(handle_b);
    let exit_b = process.handle_wait(handle_b);

    let out_c = process.handle_read_stdout(handle_c);
    let err_c = process.handle_read_stderr(handle_c);
    let exit_c = process.handle_wait(handle_c);

    // SFN-1004: surface each child's own stderr before asserting. This test
    // failed once in a nightly `make check` and the log carried nothing but
    // the bare assertion line, because every child's stderr was read and
    // discarded — so the one artifact that would have named the cause (an
    // `sfn run: no binary at <path>` from the exec, or a link diagnostic)
    // was thrown away. A concurrency failure here is rare and timing-bound;
    // when it does happen the run has to be self-explaining, because it may
    // not reproduce on the next one.
    if exit_a != 0 {
        print.error("run A failed, exit " + int_to_string(exit_a) + ": " + err_a);
    }
    if exit_b != 0 {
        print.error("run B failed, exit " + int_to_string(exit_b) + ": " + err_b);
    }
    if exit_c != 0 {
        print.error("run C failed, exit " + int_to_string(exit_c) + ": " + err_c);
    }

    assert exit_a == 0;
    assert exit_b == 0;
    assert exit_c == 0;
    assert find(out_a, "7", 0) >= 0;
    assert find(out_b, "7", 0) >= 0;
    assert find(out_c, "7", 0) >= 0;

    // The deterministic core (SFN-974): under the pre-fix probe, two
    // concurrent invocations took the SAME stem every time on this host
    // (max 1 concurrent exe observed across ~6.6s of real overlap) — so
    // three distinct names here is the regression pin, not a formality.
    assert seen.length == 3;

    // The release path (SFN-974 design §5) leaks nothing: every claimed
    // exe AND its per-invocation `.ll` are gone once all three have joined.
    assert _count_run_exe_entries(sailfin_dir) == 0;
    assert _count_run_ll_entries(sailfin_dir) == 0;
    assert _count_run_work_entries(sailfin_dir) == 0;
}
