// runtime/sfn/memory/secretbuf.sfn
//
// `SecretBuf` — internal libc-backed secret byte buffer (SFN-783,
// design SFEP-0069 §§3.2 and 3.5). Nothing here is exported, and
// nothing is intended for safe source. Note that is a convention, not
// a barrier: Sailfin resolves imported names GLOBALLY across the link
// closure rather than against a module's export list (see
// `compiler/src/typecheck_import_loader.sfn`), so safe source naming
// `secret_buf_new` today would resolve and link. SFN-790 is the single
// atomic activation slice that makes the sealed type genuinely public
// and lands the conformance gate; until SFN-784 supplies the sealed-type
// and use-after-zeroize diagnostics there is no enforcement behind that
// convention, so treat every function here as unguarded. Ownership
// enforcement (E0903/E0904/E0908/E0909/E0916/E0917/E0918), transitive
// aggregate classification, and exception-frame cleanup are explicit
// follow-ups (SFN-784, SFN-791, SFN-785, SFN-786) — this module only
// provides the allocation primitive, the explicit consuming wipe, and
// the per-thread owner cleanup-record stack.
//
// Model: closely follows the house style in
// `runtime/sfn/memory/ownedbuf.sfn` — read that file's header first.
// Layout is the SFEP-0069 §3.2 declaration verbatim:
//
//   struct SecretBuf { ptr_addr: i64; len: i64; cap: i64; cleanup_token: i64; }
//
// Every address-bearing field carries the `_addr` discipline
// `ownedbuf.sfn` documents (the seed silently drops stores to `* T`
// struct fields routed through a `* StructTy` pointer). `SecretBuf`
// deliberately has no `arena_addr` — per SFEP-0069 §3.5 it is v1
// libc-backed only and is never constructed from an arena.
//
// Why inline `extern fn` declarations? Same cross-module extern
// resolution limitation `arena.sfn` / `ownedbuf.sfn` / `mem.sfn`
// document: importing these from `runtime/sfn/platform/libc.sfn`
// still trips the seed's extern accept-list, so `malloc` / `free` /
// `memcpy` are declared inline here too.
//
// `secure_zero(addr, len)` is a compiler builtin (SFN-782, pinned in
// seed 0.9.5 — see `## Required in pinned seed` below); it is called
// by bare name, needs no extern declaration or import, and cannot be
// shadowed. Every wipe in this module goes through it rather than an
// ordinary store loop, so the erase is the non-elidable volatile-store
// contract SFEP-0069 §3.6 specifies, not a dead store the optimizer
// can delete.
//
// ## Required in pinned seed: SFN-782
//
// The cleanup-record stack. A per-thread intrusive singly-linked
// stack of owner nodes, modeled on `runtime/sfn/exception.sfn`'s
// `sfn_exception_frame_head_addr` chain (read its push/pop functions
// before touching this one) — same `thread_local let mut <name>_addr`
// head declaration, same push-onto-head / unlink-with-defensive-scan
// shape. Node layout is the SFEP-0069 §3.5 shape restricted to the
// owner half; `kind`/`state` distinguish an owner node from a future
// `epoch_marker` node, but only owner nodes are constructed here — the
// exception-frame marker half is SFN-786's scope, explicitly out of
// scope for this module.
//
//   cleanup node = { previous, kind, ptr, cap, state }
//
// `SecretBuf.cleanup_token` is the node's address. `kind` is always
// the owner constant in this module; `state` distinguishes live from
// draining, the double-drop guard normal cleanup and `zeroize` share.
//
// Wipe covers `cap`, not `len` — every wipe call passes the full
// allocated capacity (SFEP-0069 §3.1 item 2, §3.5 item 6), covering
// truncated bytes and any spare capacity left by a prior append.
//
// Growth wipes the old block before freeing it — a deliberate
// DIVERGENCE from `owned_buf_append`, whose header explains it
// intentionally does not free its old libc block. `SecretBuf` frees
// (after wiping) on every relocation so no historical copy of secret
// bytes survives; the cleanup record is updated only once the new
// allocation and the byte transfer both succeed.
//
// Allocation failure returns the canonical empty `SecretBuf`
// (`ptr_addr: 0, len: 0, cap: 0, cleanup_token: 0`), whose drop is a
// no-op — a second DIVERGENCE from `mem.sfn`'s `sfn_alloc_struct` /
// `sfn_env_alloc`, which abort the process on OOM. This module never
// aborts on an allocation failure; it always degrades to the
// canonical empty descriptor, matching `owned_buf_new`'s convention
// rather than the abort-on-OOM primitives in `mem.sfn`.
// `OwnedBuf` is the ordinary declassification destination
// (`secret_buf_declassify_copy`). Importing the type (not an
// `extern fn`) works across modules today — `string.sfn` imports the
// same type from the same relative path (see the Makefile's
// #1289/#1283 Gap 1 note on why the layout, not just the signature,
// must be resolvable) — so this is a plain import, unlike the inlined
// libc externs below.
import { OwnedBuf } from "./ownedbuf";

extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

// `SecretBuf` — sealed nominal compiler/runtime type (SFEP-0069
// §3.2). Trusted-runtime layout only; safe source cannot construct,
// project, or destructure this shape once the sealed-construction
// diagnostics land (SFN-784). Today the module is dormant and
// module-private, so no enforcement is required yet.
struct SecretBuf {
    ptr_addr: i64;
    len: i64;
    cap: i64;
    cleanup_token: i64;
}

// `SfnSecretCleanupNode` — the owner half of the per-thread
// cleanup-record stack (SFEP-0069 §3.5). `previous_addr` chains
// toward the bottom of the stack; `kind` is always
// `_secret_cleanup_kind_owner()` here (the `epoch_marker` kind is
// SFN-786's scope); `ptr_addr`/`cap` mirror the owned `SecretBuf`'s
// backing allocation so a relocation (append growth) can update the
// record in place; `state` is the double-drop guard shared by normal
// cleanup and `secret_buf_zeroize`.
struct SfnSecretCleanupNode {
    previous_addr: i64;
    kind: i64;
    ptr_addr: i64;
    cap: i64;
    state: i64;
}

// `_secret_cleanup_kind_owner()` — the only node kind this module
// constructs. Function form (not a top-level `const`) matches the
// house convention `mem.sfn`'s `_sfn_mem_safe_buf_size()` uses for
// small fixed constants in this runtime layer.
fn _secret_cleanup_kind_owner() -> i64 { return 1; }

// `_secret_cleanup_state_live()` / `_secret_cleanup_state_draining()`
// — the double-drop guard states. A live record has not yet started
// its wipe/free sequence; a draining record has, so a second
// `secret_buf_zeroize` call (or, once SFN-785 lands, a scope-exit
// cleanup racing an explicit zeroize) becomes a no-op rather than a
// double free.
fn _secret_cleanup_state_live() -> i64 { return 0; }

fn _secret_cleanup_state_draining() -> i64 { return 1; }

// `_secret_cleanup_node_size()` — `SfnSecretCleanupNode` is five i64
// slots (40 bytes). Kept in sync with the struct manually, same
// discipline as `exception.sfn`'s `sfn_exception_alloc_frame` (`24`
// = three pointer slots) — a regression that adds a field but forgets
// to bump this literal corrupts subsequent allocations, caught by the
// IR-shape assertions in `secret_buf_surface_test.sfn`.
fn _secret_cleanup_node_size() -> i64 { return 40; }

// Chain head (per-thread `thread_local`; mirrors
// `exception.sfn`'s `sfn_exception_frame_head_addr`). `0` means "no
// live secret owner on this thread".
thread_local let mut sfn_secret_cleanup_head_addr: i64 = 0;

// `_secret_cleanup_push(node_addr)` links the node at `node_addr`
// onto the head of the chain. Mirrors
// `sfn_exception_push_frame`'s push-onto-head shape.
fn _secret_cleanup_push(node_addr: i64) -> void {
    let node: *SfnSecretCleanupNode = node_addr as *SfnSecretCleanupNode;
    node.previous_addr = sfn_secret_cleanup_head_addr;
    sfn_secret_cleanup_head_addr = node_addr;
}

// `_secret_cleanup_unlink(node_addr)` unlinks the node at
// `node_addr` from the chain. The common case (node is the current
// head) is O(1); a mismatched unlink falls back to a defensive linear
// scan — mirrors `sfn_exception_pop_frame`'s fallback for a
// non-head unlink. Idempotent: a null address or a node already off
// the chain is a no-op.
fn _secret_cleanup_unlink(node_addr: i64) -> void {
    if node_addr == 0 { return; }
    if sfn_secret_cleanup_head_addr == node_addr {
        let node: *SfnSecretCleanupNode = node_addr as *SfnSecretCleanupNode;
        sfn_secret_cleanup_head_addr = node.previous_addr;
        return;
    }
    let mut cur_addr: i64 = sfn_secret_cleanup_head_addr;
    let mut prev_addr: i64 = 0;
    loop {
        if cur_addr == 0 { return; }
        let cur: *SfnSecretCleanupNode = cur_addr as *SfnSecretCleanupNode;
        if cur_addr == node_addr {
            if prev_addr == 0 {
                sfn_secret_cleanup_head_addr = cur.previous_addr;
            } else {
                let prev: *SfnSecretCleanupNode = prev_addr as *SfnSecretCleanupNode;
                prev.previous_addr = cur.previous_addr;
            }
            return;
        }
        prev_addr = cur_addr;
        cur_addr = cur.previous_addr;
    }
}

// `_secret_cleanup_alloc_owner(ptr_addr, cap)` allocates and links a
// fresh owner node for a backing allocation that already exists at
// `ptr_addr`/`cap`. Returns the node's address, or `0` on allocation
// failure — callers are responsible for rolling back the backing
// allocation on failure (SFEP-0069 §3.5: "If backing allocation
// succeeds but cleanup-record allocation fails, construction wipes
// and frees the backing block before returning empty").
fn _secret_cleanup_alloc_owner(ptr_addr: i64, cap: i64) -> i64 {
    let mut node_addr: i64 = 0;
    // Raw cleanup-record allocation (mirrors the
    // `sfn_exception_alloc_frame` interior): the extern `malloc` call
    // is the author-asserted unsafe region.
    unsafe {
        let raw: *u8 = malloc(_secret_cleanup_node_size() as usize);
        node_addr = raw as i64;
    }
    if node_addr == 0 { return 0; }
    let node: *SfnSecretCleanupNode = node_addr as *SfnSecretCleanupNode;
    node.previous_addr = 0;
    node.kind = _secret_cleanup_kind_owner();
    node.ptr_addr = ptr_addr;
    node.cap = cap;
    node.state = _secret_cleanup_state_live();
    _secret_cleanup_push(node_addr);
    return node_addr;
}

// `_secret_buf_wipe(ptr_addr, cap)` wipes every byte of
// `[ptr_addr, ptr_addr + cap)` through the non-elidable
// `secure_zero` builtin. No-op on a null pointer or non-positive
// `cap` — the canonical-empty descriptor's wipe is always a no-op.
fn _secret_buf_wipe(ptr_addr: i64, cap: i64) -> void {
    if ptr_addr == 0 { return; }
    if cap <= 0 { return; }
    secure_zero(ptr_addr, cap);
}

// `_secret_buf_load_byte(addr)` reads the byte at `addr` via the
// enclosing 8-aligned i64 word — the same read-modify-write technique
// `ownedbuf.sfn`'s `_owned_buf_load_byte` uses (the seed does not yet
// lower a direct single-byte load through a `* u8` slot). Callers
// bounds-check before calling; every backing allocation here is
// 8-aligned with a capacity that is a multiple of 8.
fn _secret_buf_load_byte(addr: i64) -> i64 {
    let word_addr: i64 = (addr / 8) * 8;
    let shift: i64 = (addr - word_addr) * 8;
    let slot: *i64 = word_addr as *i64;
    let word: i64 = atomic_load(slot);
    let shifted: i64 = word >> shift;
    return shifted & 255;
}

// `_secret_buf_put_byte(addr, value)` writes the low byte of `value`
// at `addr` via read-modify-write of the enclosing i64 word — the
// same technique `string.sfn`'s `_num_put_byte` uses (same
// single-byte-store codegen gap). The enclosing word is always
// in-bounds under the same 8-aligned/multiple-of-8 discipline.
fn _secret_buf_put_byte(addr: i64, value: i64) -> void {
    let word_addr: i64 = (addr / 8) * 8;
    let shift: i64 = (addr - word_addr) * 8;
    let slot: *i64 = word_addr as *i64;
    let word: i64 = atomic_load(slot);
    let mask: i64 = 255 << shift;
    let current: i64 = word & mask;
    let placed: i64 = (value & 255) << shift;
    atomic_store(slot, (word - current) + placed);
}

// `secret_buf_new(capacity)` allocates a fresh `SecretBuf` of at
// least `capacity` bytes, rounded up to a multiple of 8 (matching
// `owned_buf_new`'s word-load discipline), backed by libc `malloc`
// only — NEVER the arena (SFEP-0069 §3.5). Also allocates and links
// the owner cleanup record. A non-positive `capacity`, a backing
// allocation failure, or a cleanup-record allocation failure all
// yield the canonical empty `SecretBuf` (`ptr_addr: 0, len: 0,
// cap: 0, cleanup_token: 0`), whose drop is a no-op. If the backing
// allocation succeeds but the cleanup-record allocation fails, the
// backing block is wiped and freed before returning empty — no
// unregistered secret allocation escapes this function.
fn secret_buf_new(capacity: i64) -> SecretBuf {
    let empty = SecretBuf {
        ptr_addr: 0,
        len: 0,
        cap: 0,
        cleanup_token: 0
    };
    if capacity <= 0 { return empty; }

    let stepped: i64 = (capacity + 7) / 8;
    let cap: i64 = stepped * 8;
    let mut ptr_addr: i64 = 0;
    // Raw backing allocation (mirrors `owned_buf_new`'s unsafe
    // region): the libc `malloc` call is the author-asserted unsafe
    // region.
    unsafe {
        let heap: *u8 = malloc(cap as usize);
        ptr_addr = heap as i64;
    }
    if ptr_addr == 0 { return empty; }

    let node_addr: i64 = _secret_cleanup_alloc_owner(ptr_addr, cap);
    if node_addr == 0 {
        // Cleanup-record allocation failed: wipe and free the backing
        // block before returning empty (SFEP-0069 §3.5 rollback rule)
        // so no unregistered secret allocation escapes.
        _secret_buf_wipe(ptr_addr, cap);
        unsafe { free(ptr_addr as *u8); }
        return empty;
    }

    return SecretBuf {
        ptr_addr: ptr_addr,
        len: 0,
        cap: cap,
        cleanup_token: node_addr
    };
}

// `secret_buf_len(self)` — bytes currently written. Pure field read;
// a non-consuming read borrow per SFEP-0069 §3.2.
fn secret_buf_len(self: SecretBuf) -> i64 { return self.len; }

// `secret_buf_declassify_byte(self, index)` — the byte at `index`,
// or `-1` when `index` is outside `[0, len)`. A non-consuming
// scalar-only read borrow (SFEP-0069 §3.2): each call is one explicit
// one-byte declassification. The resulting scalar is outside this
// module's erasure guarantee — that classification is enforced by the
// checker diagnostics SFN-784 adds, not by this dormant runtime.
fn secret_buf_declassify_byte(self: SecretBuf, index: i64) -> i64 {
    if index < 0 { return -1; }
    if index >= self.len { return -1; }
    return _secret_buf_load_byte(self.ptr_addr + index);
}

// `secret_buf_set(self, index, value)` writes `value`'s low byte at
// `index` within the already-allocated capacity and consumes/returns
// `self`, extending `len` when `index` lands at or past the current
// length. An out-of-capacity `index` (negative or `>= cap`) returns
// `self` unchanged — `secret_buf_append` is the growth path.
fn secret_buf_set(self: SecretBuf, index: i64, value: i64) -> SecretBuf {
    if index < 0 { return self; }
    if index >= self.cap { return self; }
    _secret_buf_put_byte(self.ptr_addr + index, value);
    let mut new_len: i64 = self.len;
    if index >= new_len { new_len = index + 1; }
    return SecretBuf {
        ptr_addr: self.ptr_addr,
        len: new_len,
        cap: self.cap,
        cleanup_token: self.cleanup_token
    };
}

// `secret_buf_append(self, value)` consumes `self`, appends one byte,
// and returns the (possibly relocated) buffer. Growth doubles the
// capacity (minimum 16, rounded to a multiple of 8, matching
// `owned_buf_append`'s policy) via `malloc` + `memcpy`. Unlike
// `owned_buf_append`, a relocation WIPES the old block (all `cap`
// bytes) before freeing it, so no historical copy of secret bytes
// survives — the cleanup record is updated only after the new
// allocation and the byte copy both succeed. Growing a canonical
// empty `SecretBuf` (no existing cleanup record) allocates a fresh
// owner record at that point; if the fresh allocation or its record
// cannot be obtained, the operation wipes/frees whatever it
// provisionally allocated and returns `self` unchanged.
fn secret_buf_append(self: SecretBuf, value: i64) -> SecretBuf {
    let needed: i64 = self.len + 1;
    let mut ptr_addr: i64 = self.ptr_addr;
    let mut cap: i64 = self.cap;
    let mut cleanup_token: i64 = self.cleanup_token;

    if needed > cap {
        let mut new_cap: i64 = cap + cap;
        if new_cap < needed { new_cap = needed; }
        if new_cap < 16 { new_cap = 16; }
        let stepped: i64 = (new_cap + 7) / 8;
        new_cap = stepped * 8;
        if new_cap < needed { return self; }

        let mut fresh_addr: i64 = 0;
        // Raw grow interior (mirrors `owned_buf_append`'s unsafe
        // region): the relocate + `memcpy` sequence is the
        // author-asserted unsafe region. Soundness follows the same
        // unique-ownership argument `owned_buf_append` documents.
        unsafe {
            let fresh: *u8 = malloc(new_cap as usize);
            fresh_addr = fresh as i64;
        }
        if fresh_addr == 0 { return self; }

        if ptr_addr != 0 {
            if self.len > 0 {
                unsafe {
                    memcpy(fresh_addr as *u8, ptr_addr as *u8, self.len as usize);
                }
            }
            // Wipe the old block before freeing it — the DIVERGENCE
            // from `owned_buf_append` documented in the file header.
            _secret_buf_wipe(ptr_addr, cap);
            unsafe { free(ptr_addr as *u8); }
        }

        if cleanup_token == 0 {
            let new_node: i64 = _secret_cleanup_alloc_owner(fresh_addr, new_cap);
            if new_node == 0 {
                // No record could be allocated for the fresh block —
                // wipe and free it and refuse the growth (the source
                // was already the canonical empty, so nothing else to
                // roll back).
                _secret_buf_wipe(fresh_addr, new_cap);
                unsafe { free(fresh_addr as *u8); }
                return self;
            }
            cleanup_token = new_node;
        } else {
            let node: *SfnSecretCleanupNode = cleanup_token as *SfnSecretCleanupNode;
            node.ptr_addr = fresh_addr;
            node.cap = new_cap;
        }

        ptr_addr = fresh_addr;
        cap = new_cap;
    }

    _secret_buf_put_byte(ptr_addr + self.len, value);

    return SecretBuf {
        ptr_addr: ptr_addr,
        len: needed,
        cap: cap,
        cleanup_token: cleanup_token
    };
}

// `secret_buf_zeroize(self)` is the explicit consuming wipe. Normal
// cleanup order per SFEP-0069 §3.5, all five steps:
//
//   1. mark the record draining (double-drop guard);
//   2. wipe all `cap` bytes through `secure_zero`;
//   3. free the libc allocation;
//   4. unlink and free the cleanup record;
//   5. zero the descriptor fields where they remain addressable.
//
// Step 5 is what makes step 4 safe, and is not optional: it clears
// `cleanup_token`, so a second `zeroize` against this descriptor takes
// the `cleanup_token == 0` early return instead of reading `state` out
// of the record step 4 just freed. Omitting it leaves the guard reading
// freed memory, whose likely value is `_secret_cleanup_state_live()`
// (0) once the block is recycled — which passes the guard and
// double-frees both the backing block and the record.
//
// A canonical-empty `SecretBuf` (`cleanup_token == 0`) is a no-op.
// A descriptor whose record is already draining is also a no-op.
// A STALE COPY of a descriptor taken before this call still carries the
// old token and is not protected here; that is use-after-zeroize, and
// rejecting it is SFN-784's `E0903`.
fn secret_buf_zeroize(self: SecretBuf) -> void {
    if self.cleanup_token == 0 { return; }
    let node: *SfnSecretCleanupNode = self.cleanup_token as *SfnSecretCleanupNode;
    if node.state != _secret_cleanup_state_live() { return; }

    node.state = _secret_cleanup_state_draining();
    _secret_buf_wipe(node.ptr_addr, node.cap);
    // Releasing the backing block. Sound because the wipe above covers
    // all `cap` bytes and the draining mark means no other drain path
    // can reach this record; the address comes from the record rather
    // than the descriptor, so a stale pre-growth descriptor still frees
    // the current block.
    if node.ptr_addr != 0 {
        unsafe { free(node.ptr_addr as *u8); }
    }
    let token: i64 = self.cleanup_token;
    _secret_cleanup_unlink(token);
    // Releasing the record itself, which holds no secret bytes and is
    // now off the thread chain. Sound only in combination with step 5
    // below: that clears `cleanup_token`, so this address is never read
    // back through this descriptor.
    unsafe { free(token as *u8); }

    // Step 5 of the SFEP-0069 3.5 cleanup order: zero the descriptor
    // fields where they remain addressable. This is what makes a second
    // `secret_buf_zeroize` against the same descriptor safe — it takes
    // the `cleanup_token == 0` early return above instead of reading
    // `state` out of the record this call just freed. Without it the
    // guard is a use-after-free whose likely reading is
    // `_secret_cleanup_state_live()` (0), which would re-enter the drain
    // path and double-free both the backing block and the record.
    self.ptr_addr = 0;
    self.len = 0;
    self.cap = 0;
    self.cleanup_token = 0;
}

// `secret_buf_declassify_copy(self)` allocates a fresh ordinary
// `OwnedBuf`, copies `len` bytes from `self`, then zeroizes and
// consumes `self` — in that order, so the copy always completes
// before the source is wiped. If the ordinary destination cannot be
// allocated, no partial ordinary copy escapes: the source is still
// wiped and consumed, and the canonical empty `OwnedBuf` is returned.
// A canonical-empty source (`cleanup_token == 0`) has nothing to copy
// or wipe and returns the canonical empty `OwnedBuf` directly. The
// resulting `OwnedBuf` is an ordinary libc-backed buffer
// (`arena_addr: 0`) outside this module's erasure guarantee.
fn secret_buf_declassify_copy(self: SecretBuf) -> OwnedBuf {
    let mut result: OwnedBuf = OwnedBuf {
        ptr_addr: 0,
        len: 0,
        cap: 0,
        arena_addr: 0
    };
    if self.cleanup_token == 0 { return result; }

    if self.len > 0 {
        let mut dest_addr: i64 = 0;
        // Raw destination allocation + copy (declassification
        // boundary, SFEP-0069 §3.2): the extern `malloc`/`memcpy`
        // calls are the author-asserted unsafe region. The copy runs
        // before the source is wiped below.
        // `owned_buf_byte_at` reads through the enclosing 8-aligned i64
        // word, so every `OwnedBuf` capacity must be a multiple of 8 or
        // that read runs past the allocation (`ownedbuf.sfn`'s stated
        // invariant; `sfn_read_fd` rounds for the same reason). Round
        // here rather than handing back a `cap` of a raw `len`.
        let dest_cap: i64 = ((self.len + 7) / 8) * 8;
        unsafe {
            let fresh: *u8 = malloc(dest_cap as usize);
            dest_addr = fresh as i64;
        }
        if dest_addr != 0 {
            unsafe {
                memcpy(dest_addr as *u8, self.ptr_addr as *u8, self.len as usize);
            }
            result = OwnedBuf {
                ptr_addr: dest_addr,
                len: self.len,
                cap: dest_cap,
                arena_addr: 0
            };
        }
    }

    secret_buf_zeroize(self);
    return result;
}
