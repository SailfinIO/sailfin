// runtime/sfn/platform/fd_io.sfn
//
// Generic-fd `read`/`write`, isolated behind two symbols so the Windows
// divergence is expressible as a module swap. Swapped for
// `fd_io_windows.sfn` on a Windows target by
// `target_condition_runtime_sfn_sources`
// (`compiler/src/build/target.sfn`) — the same mechanism that swaps
// `fs_exec_mode.sfn`, and for the same reason (SFN-671).
//
// This module is deliberately separate from `socket_ops.sfn`, which
// fixes the identical `int`-vs-`ssize_t` width defect for `recv`/`send`
// (SFN-927): `socket_ops.sfn` is gated behind the `net` effect in
// `runtime/capsule.toml`'s `[sfn-source-gates]` (only linked when a
// program declares `![net]` transitively), but `io.sfn`/`assert.sfn` —
// the consumers here — are ungated and linked into every Sailfin
// binary. Reusing the gated module for an ungated consumer would leave
// `sfn_fd_read`/`sfn_fd_write` undefined at link time for any binary
// that prints or reads a file without touching the network.
//
// The UCRT's low-fd `_read`/`_write` (the CRT names — NOT usable on a
// Winsock `SOCKET`, which is a distinct handle space reached only
// through `recv`/`send`, see `socket_ops.sfn`) are `int` (32-bit), not
// POSIX's `ssize_t` (64-bit). A raw `-> i64` extern against them
// silently promotes a `-1` error into `4294967295`, defeating every
// `if n <= 0` / `if n < 0` guard downstream — the identical defect
// `socket_ops.sfn` fixes for `recv`/`send` (SFN-927).
//
// On POSIX both are pass-throughs, so this target's behaviour is
// unchanged.
extern fn read(fd: i32, buf: *u8, count: usize) -> i64;

extern fn write(fd: i32, buf: *u8, count: usize) -> i64;

fn sfn_fd_read(fd: i32, buf: *u8, count: usize) -> i64 {
    return read(fd, buf, count);
}

fn sfn_fd_write(fd: i32, buf: *u8, count: usize) -> i64 {
    return write(fd, buf, count);
}

export { sfn_fd_read, sfn_fd_write };
