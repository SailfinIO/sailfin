// runtime/sfn/platform/process_windows.sfn
//
// Windows (mingw-w64) process family — the module split that lets the
// last C runtime file (the retired C runtime, formerly `sailfin_runtime.c`) be
// deleted (#822 / epic #1308).
//
// WHY A SEPARATE MODULE. Sailfin has no source-level platform
// conditional (`#ifdef`); a plain `extern fn` lowers to an unconditional
// `declare`, and a plain call emits an unconditional `call`. So a single
// `process.sfn` cannot hold both the POSIX `posix_spawnp` body and the
// Win32 `CreateProcessA` body — the unused extern family would leave
// undefined references on each target. Instead:
//   - `runtime/sfn/process.sfn` keeps the POSIX bodies (posix_spawnp /
//     waitpid) in the manifest's base source set.
//   - this module provides the same `@sfn_process_*` symbols for Windows and
//     is selected by the manifest target replacement, so its Win32 externs
//     never enter Linux/macOS IR.
// This mirrors the retired `sailfin_runtime.c` `#if defined(_WIN32)`
// branch (the `CreateProcessA` body at :5564 and the `@sfn_process_*`
// forwarders at :8163). Target-manifest membership is pinned by
// `compiler/tests/e2e/cross_windows_runtime_modules_test.sfn`.
//
// CONTRACT. `run`, `exit`, and `run_capture` (+ its `capture_take_*`)
// are REAL: the shipped Windows installer must spawn clang/linker, and
// the self-host build captures the child compiler's output (#1487 /
// epic #1485). `run_capture` uses CreatePipe + CreateProcessA with
// redirected stdout/stderr + a deadlock-free two-pipe drain
// (PeekNamedPipe/ReadFile). The async streaming-handle family
// (`spawn_with_env` / `handle_*`) is ALSO real (SFN-497) — the enabling
// primitive none of the concurrent-child consumers can be built without.
// `environ` is ALSO real (SFN-498): `GetEnvironmentStringsA` parsed into
// a real `SfnArray`, needed so `process.spawn_with_env`'s callers can
// reproduce environment inheritance explicitly (an empty array means the
// EMPTY environment, never "inherit").
//
// CONSUMERS ARE NOT YET PORTED. A real spawn family is necessary but not
// sufficient: the existing in-tree consumers select on raw fds, which do
// not exist here (see the `handle_stdout_fd` note below). Concretely,
// the reap loops in `cli/commands/test/pool.sfn` and
// `cli/commands/test/exec.sfn` each build an fd list, find it empty on
// Windows, and break before reading a byte. Porting each consumer to
// the fd-free framed-read path is deliberately separate work (SFN-499) —
// so do NOT read "the family is real" as "`sfn test` / parallel emit work
// on Windows". They do not yet.
//
// INHERITANCE SERIALIZATION. `CreateProcessA` with `bInheritHandles=TRUE`
// grants the child EVERY inheritable handle open in the process, not
// just the three named in `STARTUPINFOA`. Three functions spawn that
// way, each with its own leak window:
//
//   - `_pw_spawn_impl` and `sfn_process_run_capture` close their
//     child-side pipe ends immediately after the spawn returns, so that
//     window is exactly the CreatePipe→CloseHandle span of ONE call.
//   - `sfn_process_run` (SFN-546) duplicates the parent's OWN standard
//     handles inheritable, so its window is the
//     `_pw_dup_inheritable`→`_pw_close_dup` span, and what leaks into a
//     concurrent child is the parent's stdout/stderr rather than a pipe
//     end.
//   - `sfn_process_run_capture` is in BOTH categories (SFN-572): besides
//     its pipe ends it holds an inheritable duplicate of the parent's
//     stdin across `CreateProcessA`, so it carries a second, narrower
//     `_pw_dup_inheritable`→`_pw_close_dup` window of the same shape.
//
// Two spawns overlapping IN DIFFERENT THREADS would otherwise cross-inherit: a
// victim's pipe read end would never see EOF (its pipe would still have
// a live writer), and a child holding a duplicate of the parent's stdout
// would wedge any capture reading it. Native Windows builds include the
// concurrency runtime, so the complete inheritable-handle lifetime is
// protected by one process-local SRW lock. The lock covers only handle setup,
// `CreateProcessA`, and parent-side closure; children still execute and drain
// concurrently. Every new inheritable-handle spawn path must use the same
// helpers.
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memset(ptr: *u8, value: i32, n: usize) -> *u8;

extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

extern fn strlen(s: *u8) -> usize;

extern fn getenv(name: *u8) -> *u8;

extern fn strcmp(a: *u8, b: *u8) -> i32;

extern fn exit(code: i32) -> void;

// Materializes a NUL-terminated C string by copying the carried-length bytes
// into the arena (#1705), same as `process.sfn`. Callers pass `null` for the
// arena slot to resolve the process-global arena.
extern fn sfn_str_to_cstr(s_data: *u8, s_len: i64, arena_slot: *u8) -> *u8;

// ── Win32 kernel32 (implicitly linked by mingw; no extra `-l`). ──────
extern fn CreateProcessA(app: *u8, cmdline: *u8, pattr: *u8, tattr: *u8, inherit: i32, flags: i32, env: *u8, cwd: *u8, si: *u8, pi: *u8) -> i32;

extern fn AcquireSRWLockExclusive(lock: *i64) -> void;

extern fn ReleaseSRWLockExclusive(lock: *i64) -> void;

extern fn WaitForSingleObject(handle: i64, ms: i32) -> i32;

extern fn GetExitCodeProcess(handle: i64, code: *i32) -> i32;

extern fn CloseHandle(handle: i64) -> i32;

// ── Win32 capture family (CreatePipe / ReadFile / PeekNamedPipe). ────
// `run_capture` redirects the child's stdout/stderr through anonymous
// pipes and drains both concurrently. All implicitly linked by mingw.
extern fn CreatePipe(read_handle: *i64, write_handle: *i64, sec_attrs: *u8, size: i32) -> i32;

extern fn SetHandleInformation(handle: i64, mask: i32, flags: i32) -> i32;

extern fn ReadFile(handle: i64, buffer: *u8, to_read: i32, read_count: *i32, overlapped: *u8) -> i32;

extern fn PeekNamedPipe(handle: i64, buffer: *u8, buf_size: i32, read_count: *i32, total_avail: *i32, left: *i32) -> i32;

extern fn GetStdHandle(which: i32) -> i64;

// ── fd → HANDLE bridge for `io.poll_readable` / `io.poll_any`.
// The `io.*` builtins take a CRT file descriptor, which is what POSIX
// `poll(2)` wants; every Win32 readiness primitive wants a HANDLE.
// `_get_osfhandle` is the UCRT's own bridge between the two — the leading
// underscore is the C symbol, not the Sailfin module-private convention.
// It answers `-1` for an fd that was never opened and `-2` for one with no
// underlying handle.
extern fn _get_osfhandle(fd: i32) -> i64;

// `GetFileType(handle)` — `FILE_TYPE_UNKNOWN` 0, `FILE_TYPE_DISK` 1,
// `FILE_TYPE_CHAR` 2, `FILE_TYPE_PIPE` 3. Only a pipe has a non-blocking
// peek, so this is what decides whether readiness is measurable or must be
// assumed.
extern fn GetFileType(handle: i64) -> i32;

// `DuplicateHandle` / `GetCurrentProcess` — the `run` passthrough path
// hands the child inheritable copies of the parent's standard handles
// rather than flipping `HANDLE_FLAG_INHERIT` on the parent's own
// (SFN-546). Both are implicitly linked by mingw like the rest of this
// family.
extern fn DuplicateHandle(src_proc: i64, src: i64, dst_proc: i64, dst: *i64, access: i32, inherit: i32, options: i32) -> i32;

extern fn GetCurrentProcess() -> i64;

extern fn Sleep(ms: i32) -> void;

// ── Monotonic clock for the bounded pipe pump (SFN-1092). Redeclared here
// rather than imported from `clock_windows.sfn`, per the file-header
// self-containment note above `PwGrowBuf`: this module is a wholesale
// target replacement for `sfn/process.sfn` and owns its own link
// contracts. `clock_windows.sfn:43-45` declares the same two symbols; a
// Win32 import declared by two modules resolves to one thunk at link.
//
// Deliberately NOT the `monotonic_millis()` builtin: that lowers to the
// runtime-helper descriptor `runtime_monotonic_millis_fn`, and the
// runtime's own pipe pump must not depend on a helper the pinned seed
// resolves for it. `QueryPerformanceCounter` is a bare Win32 call the
// seed compiles as an ordinary extern, which is what keeps SFN-1092
// free of a seed gate.
extern fn QueryPerformanceCounter(out_count: *i64) -> i32;

extern fn QueryPerformanceFrequency(out_freq: *i64) -> i32;

// `K32GetProcessMemoryInfo(process, counters, cb)` — peak working set for the
// metered `run_capture` (SFN-1520 family). Deliberately the `K32`-prefixed
// spelling: it is exported from `kernel32.dll`, which the msvc link already
// pulls in, whereas the unprefixed `GetProcessMemoryInfo` lives in `psapi` and
// would add a link library to every Windows binary for one call site.
extern fn K32GetProcessMemoryInfo(process: i64, counters: *u8, cb: i32) -> i32;

// ── Win32 async-handle family (SFN-497). `WriteFile` feeds the child's
// stdin pipe; `TerminateProcess` is the `handle_kill` primitive (Windows
// has no signals). Both implicitly linked by mingw.
extern fn WriteFile(handle: i64, buffer: *u8, to_write: i32, written: *i32, overlapped: *u8) -> i32;

extern fn TerminateProcess(handle: i64, code: i32) -> i32;

// ── Win32 environment-block family (SFN-498). `GetEnvironmentStringsA`
// hands back a contiguous "KEY=VALUE\0...\0\0" ANSI block; the caller
// owns freeing it via `FreeEnvironmentStringsA`. Both implicitly linked
// by mingw.
extern fn GetEnvironmentStringsA() -> *u8;

extern fn FreeEnvironmentStringsA(block: *u8) -> i32;

// `sfn_array_push_string` is the same linked runtime symbol
// `runtime/sfn/process.sfn` externs for its POSIX `sfn_process_environ`
// (defined in `runtime/sfn/array.sfn`, target-independent). Declared here
// too rather than imported, per the SFN-635 / file-header self-containment
// note above `PwGrowBuf` — this extern is a link contract, not a Sailfin
// import of the POSIX module.
extern fn sfn_array_push_string(arr: *u8, text: *u8) -> *u8;

// First field of `STARTUPINFOA` (104 bytes on x86_64). `CreateProcessA`
// requires `.cb = sizeof(STARTUPINFOA)`; every other field is zero. The
// buffer is `malloc(104)` + `memset 0`, then `.cb` is written through
// this one-field overlay (the remaining 100 bytes stay zero).
struct WinStartupInfo {
    cb: i32;
}

// One-field `i32` overlay for writing an aligned `DWORD` field of a
// Win32 struct through a computed offset (`STARTUPINFOA.cb` @0,
// `.dwFlags` @60 — both 4-byte aligned). A plain field store (`align 4`),
// unlike `atomic_store` (which requires `align 8`), so it can target the
// 4-aligned `dwFlags` slot directly.
struct PwDword {
    v: i32;
}

// Local growable byte buffer for accumulating captured pipe output. Kept
// module-private (the `process.sfn` `GrowBuf` lives in the POSIX module,
// which this file deliberately does NOT import — see the SFN-635 /
// file-header self-containment note). `{ addr, len, cap }` mirror the
// POSIX layout.
struct PwGrowBuf {
    addr: i64;
    len: i64;
    cap: i64;
}

// One live child of the async `spawn_with_env` family (SFN-497). The
// `handle_id` an `sfn_process_handle_*` builtin receives is the ADDRESS of
// one of these, cast to `i64` — never an index into a table. That mirrors
// the POSIX side, where the id is a `SailfinProcessHandle*`
// (`runtime/sfn/process.sfn`), and is what makes `0` a safe universal
// failure sentinel: `malloc` never hands back address 0 for a live
// allocation, so no valid handle can collide with it.
//
// The POSIX layout is NOT reused. There the three stream slots are `i32`
// fds sentinelled with `-1`; a Windows HANDLE is a 64-bit kernel value
// with `0` (never `-1`, which is INVALID_HANDLE_VALUE) as its natural
// "closed" marker, so the slots here are `i64` zeroed on close. Layout
// parity is unnecessary because the two modules never link together —
// exactly one of them is in a given binary (file header).
//
// The two `{ addr, len, cap }` triples are read through the `PwGrowBuf`
// overlay at the byte offsets noted below, the same address-arithmetic
// trick `process.sfn` uses for its stashes. `_pw_h_out_gb` / `_pw_h_err_gb`
// are the only places those offsets are spelled out.
struct PwProcHandle {
    // @0  child process HANDLE; 0 once reaped by `handle_wait`.
    h_process: i64;
    // @8  child primary thread HANDLE; closed alongside `h_process`.
    h_thread: i64;
    // @16 parent's WRITE end of the child's stdin; 0 once closed.
    h_stdin_wr: i64;
    // @24 parent's READ end of the child's stdout; 0 once drained to EOF.
    h_stdout_rd: i64;
    // @32 parent's READ end of the child's stderr; 0 once drained to EOF.
    h_stderr_rd: i64;
    // @40 stdout read-ahead stash (PwGrowBuf overlay).
    out_addr: i64;
    out_len: i64;
    out_cap: i64;
    // @64 stderr read-ahead stash (PwGrowBuf overlay).
    err_addr: i64;
    err_len: i64;
    err_cap: i64;
}

// `run_capture` stashes the malloc'd, NUL-terminated stdout/stderr here
// for the matching `capture_take_*`. `i64` addresses (not `* u8`) to dodge
// the seed's non-`i64` module-mutable-global quirk, exactly as
// `process.sfn` does for the POSIX capture slots.
let mut pw_capture_stdout_addr: i64 = 0;

let mut pw_capture_stderr_addr: i64 = 0;

// Metered-capture slots for `run_capture_metered` (#1520 / epic #1503),
// the measurement primitive the native `sfn bench` driver uses. Windows has
// no `getrusage`/`wait4`, but it does have equivalents for both halves —
// `QueryPerformanceCounter` for wall time and `K32GetProcessMemoryInfo`'s
// `PeakWorkingSetSize` for peak memory — so these carry real measurements
// rather than the `0` the earlier degraded contract returned.
//
// Peak WORKING SET is not the same quantity as POSIX `ru_maxrss`, though
// both are "the most physical memory this process ever held". Neither counts
// paged-out pages, and the two are close enough for a budget check; they are
// NOT close enough to compare a Linux and a Windows number against one
// shared threshold. A per-target budget is the honest use.
//
// `i64` slots to dodge the same non-`i64` module-mutable-global quirk noted
// above.
let mut pw_capture_wall_ms: i64 = 0;

let mut pw_capture_peak_rss_kb: i64 = 0;

// Whether the NEXT `_pw_run_capture_impl` should measure. Metering is opt-in
// so a plain `run_capture` reports `0` for both, exactly as the POSIX body
// does — `sfn_process_run_capture_metered` is the only thing that arms it,
// and the impl disarms it as it consumes it. Without this, a plain capture on
// Windows would hand back numbers its POSIX counterpart does not, and the two
// platforms' builtin contracts would quietly diverge.
let mut pw_capture_meter_armed: i64 = 0;

// A zero-initialized pointer-sized cell is `SRWLOCK_INIT`. Keeping the lock in
// this provider avoids depending on either pthread implementation: MinGW links
// winpthreads, while the MSVC target uses `pthread_windows.sfn`.
let mut pw_spawn_inherit_lock: i64 = 0;

fn _pw_lock_inheritable_spawn() -> void ![io] {
    AcquireSRWLockExclusive(& pw_spawn_inherit_lock);
}

fn _pw_unlock_inheritable_spawn() -> void ![io] {
    ReleaseSRWLockExclusive(& pw_spawn_inherit_lock);
}

// `_pw_dup_inheritable(proc, h)` — an inheritable duplicate of one of the
// parent's standard handles, or `0` when there is none to duplicate.
// `GetStdHandle` reports "no such handle" as either `0` or `-1`
// (INVALID_HANDLE_VALUE) and neither may be handed to `DuplicateHandle`,
// so both map to the `0` "nothing duplicated" sentinel. Options argument
// is DUPLICATE_SAME_ACCESS (2), which makes the requested-access argument
// ignored; `inherit` is TRUE (1) — that is the whole point of the call.
fn _pw_dup_inheritable(proc: i64, h: i64) -> i64 ![io] {
    if h == 0 { return 0; }
    if h == -1 { return 0; }
    let mut dup: i64 = 0;
    let dup_ptr: *i64 = & dup;
    let ok: i32 = DuplicateHandle(proc, h, proc, dup_ptr, 0, 1, 2);
    if ok == 0 { return 0; }
    return dup;
}

// `_pw_close_dup(h)` — release a handle from `_pw_dup_inheritable`,
// tolerating its `0` sentinel. `CreateProcessA` copies the handles named by
// `STARTUPINFOA` into the child, so the parent's duplicates are dead the
// moment the spawn call returns, success or failure.
fn _pw_close_dup(h: i64) -> void ![io] {
    if h == 0 { return; }
    let _c: i32 = CloseHandle(h);
}

// `_pw_app_name(argv0)` — the `lpApplicationName` `CreateProcessA` needs for
// `argv0`, or `null` to leave that parameter NULL and let it parse the module
// out of `lpCommandLine` itself.
//
// With a NULL `lpApplicationName`, `CreateProcessA` resolves the module
// through a search that does NOT include the process working directory, so a
// working-directory-relative path fails with `ERROR_FILE_NOT_FOUND` (2) even
// though the file is there. Measured on a native Windows host, spawning the
// same binary four ways: `build/bin/sfn.exe` and `build\bin\sfn.exe` both
// fail, while `./build/bin/sfn.exe` and the absolute path both succeed. The
// leading `./` is what anchors it, not the slash direction (SFN-1104).
//
// The os-capsule contract is the POSIX one: `posix_spawnp` searches `PATH`
// only for a name with no separator, and resolves anything else against the
// working directory. So a name carrying a separator is handed over as
// `lpApplicationName`, which `CreateProcessA` uses verbatim relative to the
// working directory, and a bare name keeps the NULL so the `PATH` search
// still runs. The split is load-bearing in both directions: `clang`, `cmp`,
// and `cp` are bare names that must keep searching, and naming one in
// `lpApplicationName` would break them twice over, since it also suppresses
// the implicit `.exe` suffix a bare name would otherwise receive.
//
// Arena-backed via `sfn_str_to_cstr`, so the caller must NOT free it — the
// same discipline every other `sfn_str_to_cstr` result in this file follows,
// as against the `malloc`'d `cmdline` beside it, which is freed.
fn _pw_app_name(argv0: string) -> *u8 {
    let a: *u8 = sfn_str_to_cstr(argv0 as *u8, argv0.length, null);
    let n: i64 = strlen(a) as i64;
    let mut i: i64 = 0;
    loop {
        if i >= n { break; }
        // 47 = '/', 92 = '\'. Both are Win32 path separators.
        let b: i64 = load_byte((a as i64) + i);
        if b == 47 || b == 92 { return a; }
        i = i + 1;
    }
    return 0 as *u8;
}

// `_pw_cwd_arg(cwd)` — the `lpCurrentDirectory` `CreateProcessA` needs for a
// per-child working directory, or `null` to leave the child in the parent's.
//
// `CreateProcessA`'s 8th parameter has always been in the extern declaration
// above; it was simply never wired, so `run_capture_cwd` and
// `spawn_with_env_cwd` accepted a directory, discarded it, and reported
// success while running the command in the parent's cwd. That is a fail-open,
// and it failed open onto `git add -A` + `git commit`: the two git fixtures in
// `compiler/tests/e2e/` committed the developer's entire repository twice
// during a native-Windows e2e run (SFN-1113).
//
// The POSIX contract this mirrors is `posix_spawn_file_actions_addchdir_np`
// (`runtime/sfn/process.sfn:1014`): an empty cwd inherits the parent, a
// non-empty one moves the child only — never a process-global `chdir`. Win32
// resolves a relative `lpCurrentDirectory` against the parent's cwd, which is
// what `chdir` does, so relative directories agree across platforms.
//
// One divergence, documented rather than hidden: `posix_spawn` runs its file
// actions BEFORE resolving the executable, so a relative `argv[0]` resolves
// against the NEW cwd. `lpApplicationName` (argument 1, SFN-1104) is resolved
// against the PARENT's. `run_capture_cwd(["./foo"], env, "sub")` therefore
// runs `sub/./foo` on POSIX and `./foo` on Windows. No in-tree caller relies
// on it — every one passes a bare name or an absolute path — and closing it
// would mean resolving `argv[0]` against `cwd` ourselves, which would break
// the bare-name `PATH` search `_pw_app_name` deliberately preserves.
fn _pw_cwd_arg(cwd: *u8) -> *u8 {
    if (cwd as i64) == 0 { return 0 as *u8; }
    if strlen(cwd) as i64 == 0 { return 0 as *u8; }
    return cwd;
}

// `sfn_process_run(argv)` — real Windows spawn. Mirrors the retired
// `sailfin_runtime.c:5564` `CreateProcessA` body: build a single quoted
// command line (`"arg0" "arg1" ...`), spawn, block until exit, return
// the child's exit code as a float. 127 on any setup/spawn failure (the
// conventional shell "could not execute" code, matching the POSIX body).
//
// The child runs on the parent's own stdout/stderr, matching POSIX
// `posix_spawnp` with no file actions (`runtime/sfn/process.sfn`) — this is
// the passthrough path, as against `sfn_process_run_capture` below, which
// redirects through pipes and must keep doing so.
fn sfn_process_run(argv: string[]) -> float ![io] {
    let len: i64 = argv.length;
    if len <= 0 { return 127.0; }

    // One encoder for every spawn site. This body used to build its own
    // copy of the command line inline; the two drifted the moment
    // `_pw_build_cmdline` learned the `CommandLineToArgvW` quoting rule,
    // and a `process.run` that mangles its argv differently from a
    // `process.run_capture` is the kind of divergence nothing observes
    // until a path with a space in it reaches only one of them.
    let cmdline: *u8 = _pw_build_cmdline(argv);
    if cmdline as i64 == 0 { return 127.0; }

    // STARTUPINFOA: zeroed, `.cb = 104`.
    let si: *u8 = malloc(104 as usize);
    if si as i64 == 0 {
        free(cmdline);
        return 127.0;
    }
    memset(si, 0, 104 as usize);
    let si_view: *WinStartupInfo = si as *WinStartupInfo;
    si_view.cb = 104;

    // PROCESS_INFORMATION (24 bytes): `{ hProcess@0, hThread@8, ... }`,
    // zeroed.
    let pi: *u8 = malloc(24 as usize);
    if pi as i64 == 0 {
        free(cmdline);
        free(si);
        return 127.0;
    }
    memset(pi, 0, 24 as usize);

    // Win32 has no POSIX-style "the child keeps the parent's fds" default:
    // with `bInheritHandles = 0` and no `STARTF_USESTDHANDLES` the child is
    // handed fresh console handles by the OS rather than the parent's own
    // streams. When the parent's stdout is REDIRECTED — a pipe or a file,
    // which is every CI and every `run_capture` caller — the child's output
    // goes to a console the parent is not reading, and is lost (SFN-546).
    // Naming handles in `STARTUPINFOA` only works if they are
    // actually inheritable, so duplicate each one inheritable rather than
    // setting `HANDLE_FLAG_INHERIT` on the parent's own — a process-wide
    // flip would also leak the std handles into every concurrently spawned
    // `run_capture` / `_pw_spawn_impl` child, whose pipe discipline assumes
    // it controls exactly which handles its child inherits.
    //
    // Duplicated after `pi` so that no early return sits between the
    // duplicates and the `_pw_close_dup` calls below.
    _pw_lock_inheritable_spawn();
    let self_proc: i64 = GetCurrentProcess();
    let h_in: i64 = _pw_dup_inheritable(self_proc, GetStdHandle(-10));
    let h_out: i64 = _pw_dup_inheritable(self_proc, GetStdHandle(-11));
    let h_err: i64 = _pw_dup_inheritable(self_proc, GetStdHandle(-12));

    // With no usable standard handle there is nothing to pass through and
    // nothing worth inheriting, so fall back to the un-redirected spawn.
    let mut inherit: i32 = 0;
    if h_in != 0 || h_out != 0 || h_err != 0 {
        // dwFlags@60 = STARTF_USESTDHANDLES (0x100 = 256), hStdInput@80,
        // hStdOutput@88, hStdError@96 — the offsets and `PwDword` overlay
        // discipline `sfn_process_run_capture` already uses.
        //
        // `STARTF_USESTDHANDLES` is all-or-nothing, so a slot whose
        // duplication failed stays `0` and the child gets no handle for that
        // one stream. That is a real trade, not a free degrade: a console
        // child that would have been handed a fresh console handle for that
        // stream now gets nothing. It is taken deliberately — the redirected
        // case above is the one that matters, and a partial failure here
        // means the parent had no usable handle to pass on anyway.
        let flags_view: *PwDword = (si as i64 + 60) as *PwDword;
        flags_view.v = 256;
        atomic_store((si as i64 + 80) as *i64, h_in);
        atomic_store((si as i64 + 88) as *i64, h_out);
        atomic_store((si as i64 + 96) as *i64, h_err);
        inherit = 1;
    }

    let app: *u8 = _pw_app_name(argv[0]);
    let ok: i32 = CreateProcessA(app, cmdline, null, null, inherit, 0, null, null, si, pi);
    free(cmdline);
    _pw_close_dup(h_in);
    _pw_close_dup(h_out);
    _pw_close_dup(h_err);
    _pw_unlock_inheritable_spawn();
    if ok == 0 {
        free(si);
        free(pi);
        return 127.0;
    }

    let h_process: i64 = atomic_load(pi as *i64);
    let h_thread: i64 = atomic_load((pi as i64 + 8) as *i64);

    // INFINITE = 0xFFFFFFFF. Passed as i32 `-1` (same bit pattern,
    // no hex literal — hex folds to 0 on the seed and would make the
    // wait non-blocking, racing the exit-code read).
    let _wait: i32 = WaitForSingleObject(h_process, -1);

    let mut code: i32 = 0;
    let code_ptr: *i32 = & code;
    let _got: i32 = GetExitCodeProcess(h_process, code_ptr);

    let _c1: i32 = CloseHandle(h_process);
    let _c2: i32 = CloseHandle(h_thread);
    free(si);
    free(pi);

    let result: float = code;
    return result;
}

// `sfn_process_exit(code)` — real. Mirrors the retired
// `sailfin_runtime.c:8189` `exit((int)code)`.
fn sfn_process_exit(code: float) -> void ![io] { exit(code as i32); }

// ── Degraded-but-linking family (preserves the retired `_WIN32`
// failure-sentinel contract). ───────────────────────────────────────
// `_pw_empty_cstr()` — a fresh 1-byte NUL-terminated buffer, the empty
// string the C `_WIN32` capture/read shims returned.
fn _pw_empty_cstr() -> *u8 {
    let p: *u8 = malloc(1 as usize);
    if p as i64 == 0 { return p; }
    memset(p, 0, 1 as usize);
    return p;
}

// `_pw_arg_needs_quotes(a, n)` — whether one argv element has to be
// wrapped in quotes to survive `CommandLineToArgvW` tokenization. An
// empty argument does (it is otherwise indistinguishable from the
// separator run), as does any argument containing a separator character
// or a quote of its own.
fn _pw_arg_needs_quotes(a: *u8, n: i64) -> boolean {
    if n == 0 { return true; }
    let mut i: i64 = 0;
    loop {
        if i >= n { break; }
        let b: i64 = load_byte((a as i64) + i);
        // space, tab, LF, VT, CR, `"`
        if b == 32 { return true; }
        if b == 9 { return true; }
        if b == 10 { return true; }
        if b == 11 { return true; }
        if b == 13 { return true; }
        if b == 34 { return true; }
        i = i + 1;
    }
    return false;
}

// `_pw_write_arg(base, wp, a, n, q, bs)` — encode one argv element at
// `base + wp` under the `CommandLineToArgvW` quoting rule, returning the
// new write offset.
//
// The rule (documented for `CommandLineToArgvW`, and what the MSVC CRT
// startup code parses): a backslash run is literal UNLESS it precedes a
// `"`, in which case each backslash must be doubled and the quote itself
// escaped with one more backslash. A backslash run that ends the
// argument sits in front of the CLOSING quote, so it doubles too. Runs
// are therefore buffered in `nbs` and flushed by whatever follows them.
//
// Wrapping every element in a bare quote pair — what this built before —
// encodes `C:\dir\` as `"C:\dir\"`, whose trailing `\"` the tokenizer
// reads as an escaped quote, so the argument swallows the separator and
// the rest of the command line. It also cannot express an argument that
// contains a quote at all: the callers that pass one (a `bash -c` script
// with quoted paths inside it) observed every backslash in a Windows
// path vanish.
fn _pw_write_arg(base: i64, wp: i64, a: *u8, n: i64, q: *u8, bs: *u8) -> i64 {
    let mut w: i64 = wp;
    if !_pw_arg_needs_quotes(a, n) {
        memcpy((base + w) as *u8, a, n as usize);
        return w + n;
    }
    memcpy((base + w) as *u8, q, 1 as usize);
    w = w + 1;
    let mut nbs: i64 = 0;
    let mut i: i64 = 0;
    loop {
        if i >= n { break; }
        let b: i64 = load_byte((a as i64) + i);
        if b == 92 { nbs = nbs + 1; } else if b == 34 {
            let run: i64 = nbs * 2 + 1;
            let mut k: i64 = 0;
            loop {
                if k >= run { break; }
                memcpy((base + w) as *u8, bs, 1 as usize);
                w = w + 1;
                k = k + 1;
            }
            memcpy((base + w) as *u8, q, 1 as usize);
            w = w + 1;
            nbs = 0;
        } else {
            let mut k: i64 = 0;
            loop {
                if k >= nbs { break; }
                memcpy((base + w) as *u8, bs, 1 as usize);
                w = w + 1;
                k = k + 1;
            }
            nbs = 0;
            memcpy((base + w) as *u8, ((a as i64) + i) as *u8, 1 as usize);
            w = w + 1;
        }
        i = i + 1;
    }
    let tail: i64 = nbs * 2;
    let mut t: i64 = 0;
    loop {
        if t >= tail { break; }
        memcpy((base + w) as *u8, bs, 1 as usize);
        w = w + 1;
        t = t + 1;
    }
    memcpy((base + w) as *u8, q, 1 as usize);
    return w + 1;
}

// `_pw_build_cmdline(argv)` — the space-separated Win32 command line
// `CreateProcessA` takes as `lpCommandLine`, with each element encoded
// by `_pw_write_arg`. Both spawn paths (`sfn_process_run` and
// `_pw_run_capture_impl`) share it; `lpApplicationName` names the
// program independently (`_pw_app_name`), so element 0 needs no special
// case here.
// Returns a malloc'd, NUL-terminated buffer the caller frees, or null on
// OOM. The buffer is writable (CreateProcessA may edit lpCommandLine in
// place). 1-char writes are `memcpy`'d (no single-byte store — a
// word-RMW byte store would over-read a malloc tail; #1316-class hazard).
fn _pw_build_cmdline(argv: string[]) -> *u8 {
    let len: i64 = argv.length;
    let quote: string = "\"";
    let space: string = " ";
    let backslash: string = "\\";
    let empty: string = "";
    let q: *u8 = sfn_str_to_cstr(quote as *u8, quote.length, null);
    let sp: *u8 = sfn_str_to_cstr(space as *u8, space.length, null);
    let bs: *u8 = sfn_str_to_cstr(backslash as *u8, backslash.length, null);
    let nul: *u8 = sfn_str_to_cstr(empty as *u8, empty.length, null);

    // Upper bound, not the exact length: an element of `n` bytes encodes
    // to at most `2n` (every byte a backslash, every one doubled) plus
    // two quotes plus one separator.
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    loop {
        if i >= len { break; }
        let a: *u8 = sfn_str_to_cstr(argv[i] as *u8, argv[i].length, null);
        total = total + (strlen(a) as i64) * 2 + 3;
        i = i + 1;
    }

    let cmdline: *u8 = malloc((total + 1) as usize);
    if cmdline as i64 == 0 { return cmdline; }
    let base: i64 = cmdline as i64;
    let mut wp: i64 = 0;
    i = 0;
    loop {
        if i >= len { break; }
        if i > 0 {
            memcpy((base + wp) as *u8, sp, 1 as usize);
            wp = wp + 1;
        }
        let a: *u8 = sfn_str_to_cstr(argv[i] as *u8, argv[i].length, null);
        wp = _pw_write_arg(base, wp, a, strlen(a) as i64, q, bs);
        i = i + 1;
    }
    memcpy((base + wp) as *u8, nul, 1 as usize);
    return cmdline;
}

// `_pw_build_env_block(env_flat)` — the Win32 ANSI environment block a
// `"KEY=VALUE\0KEY=VALUE\0\0"` double-NUL-terminated buffer for
// `CreateProcessA`'s `lpEnvironment`. An empty `env_flat` yields a valid
// empty block (two zero bytes), preserving the os-capsule contract that an
// empty array means the EMPTY environment, never "inherit" (mirrors the
// POSIX module). Returns a malloc'd buffer the caller frees, or null on OOM.
fn _pw_build_env_block(env_flat: string[]) -> *u8 {
    let n: i64 = env_flat.length;
    let mut total: i64 = 1;
    let mut i: i64 = 0;
    loop {
        if i >= n { break; }
        let e: *u8 = sfn_str_to_cstr(env_flat[i] as *u8, env_flat[i].length, null);
        total = total + (strlen(e) as i64) + 1;
        i = i + 1;
    }
    if total < 2 { total = 2; }
    let blk: *u8 = malloc(total as usize);
    if blk as i64 == 0 { return blk; }
    memset(blk, 0, total as usize);
    let base: i64 = blk as i64;
    let mut wp: i64 = 0;
    i = 0;
    loop {
        if i >= n { break; }
        let e: *u8 = sfn_str_to_cstr(env_flat[i] as *u8, env_flat[i].length, null);
        let l: i64 = strlen(e) as i64;
        if l > 0 { memcpy((base + wp) as *u8, e, l as usize); }
        // The NUL separator and the final terminator are already zero
        // from `memset`; just step past this entry's separator.
        wp = wp + l + 1;
        i = i + 1;
    }
    return blk;
}

// `_pw_gb_append(gb, src, n)` — append `n` bytes to a `PwGrowBuf`,
// doubling capacity as needed and reserving one byte of headroom so a
// later `_pw_gb_take` can NUL-terminate in place. OOM on growth silently
// drops the chunk (best-effort capture; never corrupts the buffer).
fn _pw_gb_append(gb: *PwGrowBuf, src: *u8, n: i64) -> void {
    if n <= 0 { return; }
    let need: i64 = gb.len + n + 1;
    if need > gb.cap {
        let mut newcap: i64 = gb.cap;
        if newcap < 4096 { newcap = 4096; }
        loop {
            if newcap >= need { break; }
            newcap = newcap * 2;
        }
        let nb: *u8 = malloc(newcap as usize);
        if nb as i64 == 0 { return; }
        if gb.len > 0 { memcpy(nb, gb.addr as *u8, gb.len as usize); }
        if gb.addr != 0 { free(gb.addr as *u8); }
        gb.addr = nb as i64;
        gb.cap = newcap;
    }
    memcpy((gb.addr + gb.len) as *u8, src, n as usize);
    gb.len = gb.len + n;
}

// `_pw_gb_take(gb)` — NUL-terminate and hand the buffer to the caller,
// resetting `gb` to empty. A never-grown buffer yields a fresh empty
// string. Caller owns the returned pointer (mirrors `process.sfn`'s
// `_growbuf_take`).
fn _pw_gb_take(gb: *PwGrowBuf) -> *u8 {
    let addr: i64 = gb.addr;
    let len: i64 = gb.len;
    if addr == 0 { return _pw_empty_cstr(); }
    memset((addr + len) as *u8, 0, 1 as usize);
    gb.addr = 0;
    gb.len = 0;
    gb.cap = 0;
    return addr as *u8;
}

// `_pw_read_chunk(h, buf, cap, gb)` — non-blocking single read of one
// pipe. `PeekNamedPipe` reports buffered bytes WITHOUT blocking; if any
// are available, `ReadFile` drains up to `cap` of them into `gb`. Returns
// the byte count appended (>= 0), or -1 when the pipe is broken / at EOF
// (`PeekNamedPipe`/`ReadFile` fail once the only writer — the child — has
// exited and the buffer is empty). Non-blocking is what makes the
// two-pipe drain deadlock-free.
fn _pw_read_chunk(h: i64, buf: *u8, cap: i64, gb: *PwGrowBuf) -> i64 ![io] {
    let mut avail: i32 = 0;
    let mut peeked: i32 = 0;
    let mut left: i32 = 0;
    let avail_ptr: *i32 = & avail;
    let peek_ptr: *i32 = & peeked;
    let left_ptr: *i32 = & left;
    let ok: i32 = PeekNamedPipe(h, null, 0, peek_ptr, avail_ptr, left_ptr);
    if ok == 0 { return -1; }
    if avail <= 0 { return 0; }
    let mut want: i64 = avail as i64;
    if want > cap { want = cap; }
    let mut got: i32 = 0;
    let got_ptr: *i32 = & got;
    let rok: i32 = ReadFile(h, buf, want as i32, got_ptr, null);
    if rok == 0 { return -1; }
    if got <= 0 { return -1; }
    _pw_gb_append(gb, buf, got as i64);
    return got as i64;
}

// `_pw_drain(out_rd, err_rd, gb_out, gb_err)` — drain BOTH pipe read ends
// concurrently until each hits EOF. Polling both (rather than reading one
// to completion first) is mandatory: a child writing > 64 KiB (the default
// pipe buffer) to one stream would otherwise deadlock the parent blocked on
// the other. `_pw_read_chunk` never blocks, so the alternation is safe; a
// `Sleep(1)` when both pipes are open-but-empty avoids a busy spin.
fn _pw_drain(out_rd: i64, err_rd: i64, gb_out: *PwGrowBuf, gb_err: *PwGrowBuf) -> void ![io] {
    let cap: i64 = 65536;
    let buf: *u8 = malloc(cap as usize);
    if buf as i64 == 0 { return; }
    let mut out_open: i64 = 1;
    let mut err_open: i64 = 1;
    loop {
        if out_open == 0 {
            if err_open == 0 { break; }
        }
        let mut did: i64 = 0;
        if out_open != 0 {
            let r: i64 = _pw_read_chunk(out_rd, buf, cap, gb_out);
            if r < 0 { out_open = 0; } else { did = did + r; }
        }
        if err_open != 0 {
            let r: i64 = _pw_read_chunk(err_rd, buf, cap, gb_err);
            if r < 0 { err_open = 0; } else { did = did + r; }
        }
        // Both pipes idle this round (open but empty): yield to avoid a
        // busy spin. The loop only reaches here while at least one pipe is
        // still open (the both-closed case breaks above), so an
        // unconditional sleep is correct.
        if did == 0 { Sleep(1); }
    }
    free(buf);
}

// `sfn_process_run_capture(argv, env_flat)` — real Windows capture.
// Spawns the child with stdout/stderr redirected through anonymous pipes,
// drains both to completion (deadlock-free), reaps the exit code, and
// stashes the captured streams for `capture_take_stdout/stderr`. Returns
// the child's exit code, or -1 on any setup/spawn failure (matching the
// POSIX `run_capture` contract, `process.sfn:740`). Modeled on that body
// with `CreatePipe`/`CreateProcessA`/`ReadFile` in place of
// `pipe`/`posix_spawnp`/`read`.
fn _pw_run_capture_impl(argv: string[], env_flat: string[], cwd: *u8) -> i64 ![io] {
    // Consume the metering arm-flag ONCE, up front. Read-and-clear here rather
    // than at the reporting site because this function has a dozen early
    // returns: leaving the flag set on any of them would meter the NEXT,
    // unrelated capture.
    let metered: i64 = pw_capture_meter_armed;
    pw_capture_meter_armed = 0;
    let meter_freq: i64 = _pw_qpc_freq();
    let meter_start: i64 = _pw_qpc_now();

    // Drop any capture left pending from a previous call.
    if pw_capture_stdout_addr != 0 {
        free(pw_capture_stdout_addr as *u8);
        pw_capture_stdout_addr = 0;
    }
    if pw_capture_stderr_addr != 0 {
        free(pw_capture_stderr_addr as *u8);
        pw_capture_stderr_addr = 0;
    }

    let len: i64 = argv.length;
    if len <= 0 { return -1; }

    let cmdline: *u8 = _pw_build_cmdline(argv);
    if cmdline as i64 == 0 { return -1; }
    let env_block: *u8 = _pw_build_env_block(env_flat);
    if env_block as i64 == 0 {
        free(cmdline);
        return -1;
    }

    // Inheritable SECURITY_ATTRIBUTES (24 bytes): `{ nLength@0,
    // lpSecurityDescriptor@8, bInheritHandle@16 }`. nLength=24,
    // bInheritHandle=TRUE so the child inherits the pipe write ends.
    let sa: *u8 = malloc(24 as usize);
    if sa as i64 == 0 {
        free(cmdline);
        free(env_block);
        return -1;
    }
    memset(sa, 0, 24 as usize);
    atomic_store(sa as *i64, 24);
    atomic_store((sa as i64 + 16) as *i64, 1);

    // Two anonymous pipes packed into one 32-byte buffer:
    // stdout (rd@0, wr@8), stderr (rd@16, wr@24).
    let hbuf: *u8 = malloc(32 as usize);
    if hbuf as i64 == 0 {
        free(cmdline);
        free(env_block);
        free(sa);
        return -1;
    }
    memset(hbuf, 0, 32 as usize);
    let hbase: i64 = hbuf as i64;
    _pw_lock_inheritable_spawn();
    if CreatePipe(hbase as *i64, (hbase + 8) as *i64, sa, 0) == 0 {
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(hbuf);
        return -1;
    }
    if CreatePipe((hbase + 16) as *i64, (hbase + 24) as *i64, sa, 0) == 0 {
        let o_rd: i64 = atomic_load(hbase as *i64);
        let o_wr: i64 = atomic_load((hbase + 8) as *i64);
        let _co1: i32 = CloseHandle(o_rd);
        let _co2: i32 = CloseHandle(o_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(hbuf);
        return -1;
    }
    let out_rd: i64 = atomic_load(hbase as *i64);
    let out_wr: i64 = atomic_load((hbase + 8) as *i64);
    let err_rd: i64 = atomic_load((hbase + 16) as *i64);
    let err_wr: i64 = atomic_load((hbase + 24) as *i64);
    free(hbuf);

    // The read ends are parent-only: clear HANDLE_FLAG_INHERIT (1) so the
    // child does not inherit (and leak) them.
    let s1: i32 = SetHandleInformation(out_rd, 1, 0);
    let s2: i32 = SetHandleInformation(err_rd, 1, 0);
    if s1 == 0 || s2 == 0 {
        let _c1: i32 = CloseHandle(out_rd);
        let _c2: i32 = CloseHandle(out_wr);
        let _c3: i32 = CloseHandle(err_rd);
        let _c4: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        return -1;
    }

    // STARTUPINFOA (104 bytes): zeroed, then cb@0=104,
    // dwFlags@60=STARTF_USESTDHANDLES(0x100=256),
    // hStdOutput@88=out_wr, hStdError@96=err_wr. cb/dwFlags are 4-aligned
    // DWORDs written via the `PwDword` overlay; the three HANDLEs are
    // 8-aligned and written with `atomic_store`. hStdInput@80 is filled in
    // after `pi` below, where its duplicate cannot leak past an early return.
    let si: *u8 = malloc(104 as usize);
    if si as i64 == 0 {
        let _c1: i32 = CloseHandle(out_rd);
        let _c2: i32 = CloseHandle(out_wr);
        let _c3: i32 = CloseHandle(err_rd);
        let _c4: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        return -1;
    }
    memset(si, 0, 104 as usize);
    let cb_view: *PwDword = si as *PwDword;
    cb_view.v = 104;
    let flags_view: *PwDword = (si as i64 + 60) as *PwDword;
    flags_view.v = 256;
    atomic_store((si as i64 + 88) as *i64, out_wr);
    atomic_store((si as i64 + 96) as *i64, err_wr);

    // PROCESS_INFORMATION (24 bytes): `{ hProcess@0, hThread@8, ... }`.
    let pi: *u8 = malloc(24 as usize);
    if pi as i64 == 0 {
        let _c1: i32 = CloseHandle(out_rd);
        let _c2: i32 = CloseHandle(out_wr);
        let _c3: i32 = CloseHandle(err_rd);
        let _c4: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(si);
        return -1;
    }
    memset(pi, 0, 24 as usize);

    // hStdInput@80: an inheritable duplicate of the parent's stdin, or `0`
    // when there is none. `STARTF_USESTDHANDLES` is set above, and a handle
    // named under it reaches the child as an *invalid* handle unless it is
    // actually inheritable — `GetStdHandle` promises nothing about that, and
    // reports "no handle"/"error" as `0`/`-1`, neither of which may be handed
    // to a child either (SFN-572). `_pw_dup_inheritable` collapses both
    // sentinels to `0`, which stores harmlessly. The stdout/stderr slots need
    // no such treatment: they hold this function's own `CreatePipe` write
    // ends, already inheritable via `sa`.
    //
    // Duplicated after `pi` so that no early return sits between it and the
    // `_pw_close_dup` below — the discipline `sfn_process_run` uses.
    let h_stdin: i64 = _pw_dup_inheritable(GetCurrentProcess(), GetStdHandle(-10));
    atomic_store((si as i64 + 80) as *i64, h_stdin);

    // bInheritHandles=TRUE(1) so the child inherits the redirected write
    // ends; flags=0 (ANSI environment block).
    let app: *u8 = _pw_app_name(argv[0]);
    let ok: i32 = CreateProcessA(app, cmdline, null, null, 1, 0, env_block, _pw_cwd_arg(cwd), si, pi);
    free(cmdline);
    free(env_block);
    free(sa);
    // `CreateProcessA` has copied the named handles into the child, so the
    // parent's duplicate is dead on both the success and the failure path.
    _pw_close_dup(h_stdin);
    // Close the inheritable write ends before releasing the process-wide
    // spawn lock. A concurrent spawn must never inherit these parent copies,
    // or this capture's read ends can remain open past child exit and wedge.
    let _cw1: i32 = CloseHandle(out_wr);
    let _cw2: i32 = CloseHandle(err_wr);
    _pw_unlock_inheritable_spawn();
    if ok == 0 {
        let _c1: i32 = CloseHandle(out_rd);
        let _c2: i32 = CloseHandle(err_rd);
        free(si);
        free(pi);
        return -1;
    }

    let h_process: i64 = atomic_load(pi as *i64);
    let h_thread: i64 = atomic_load((pi as i64 + 8) as *i64);

    let gb_out: *PwGrowBuf = malloc(24 as usize) as *PwGrowBuf;
    let gb_err: *PwGrowBuf = malloc(24 as usize) as *PwGrowBuf;
    if gb_out as i64 == 0 {
        let _c3: i32 = CloseHandle(out_rd);
        let _c4: i32 = CloseHandle(err_rd);
        if gb_err as i64 != 0 { free(gb_err as *u8); }
        let _w: i32 = WaitForSingleObject(h_process, -1);
        let _cp: i32 = CloseHandle(h_process);
        let _ct: i32 = CloseHandle(h_thread);
        free(si);
        free(pi);
        return -1;
    }
    if gb_err as i64 == 0 {
        let _c3: i32 = CloseHandle(out_rd);
        let _c4: i32 = CloseHandle(err_rd);
        free(gb_out as *u8);
        let _w: i32 = WaitForSingleObject(h_process, -1);
        let _cp: i32 = CloseHandle(h_process);
        let _ct: i32 = CloseHandle(h_thread);
        free(si);
        free(pi);
        return -1;
    }
    gb_out.addr = 0;
    gb_out.len = 0;
    gb_out.cap = 0;
    gb_err.addr = 0;
    gb_err.len = 0;
    gb_err.cap = 0;

    _pw_drain(out_rd, err_rd, gb_out, gb_err);

    let _cr1: i32 = CloseHandle(out_rd);
    let _cr2: i32 = CloseHandle(err_rd);

    // INFINITE = 0xFFFFFFFF, passed as i32 -1 (same bit pattern; a hex
    // literal folds to 0 on the seed — see `sfn_process_run`).
    let _w: i32 = WaitForSingleObject(h_process, -1);
    let mut code: i32 = 0;
    let code_ptr: *i32 = & code;
    let _g: i32 = GetExitCodeProcess(h_process, code_ptr);
    // Peak memory MUST be read before the close — see
    // `_pw_peak_working_set_kb`. Wall time is taken here too so both readings
    // describe the same span: spawn through reap, matching what the POSIX body
    // brackets.
    if metered != 0 {
        pw_capture_peak_rss_kb = _pw_peak_working_set_kb(h_process);
        if meter_freq > 0 {
            pw_capture_wall_ms = ((_pw_qpc_now() - meter_start) * 1000) / meter_freq;
        }
    }
    let _cp: i32 = CloseHandle(h_process);
    let _ct: i32 = CloseHandle(h_thread);
    free(si);
    free(pi);

    pw_capture_stdout_addr = _pw_gb_take(gb_out) as i64;
    pw_capture_stderr_addr = _pw_gb_take(gb_err) as i64;
    free(gb_out as *u8);
    free(gb_err as *u8);

    return code as i64;
}

// `process.run_capture` — no per-child directory, so the child inherits the
// parent working directory (a null `lpCurrentDirectory`).
fn sfn_process_run_capture(argv: string[], env_flat: string[]) -> i64 ![io] {
    return _pw_run_capture_impl(argv, env_flat, 0 as *u8);
}

// `process.run_capture_cwd` (#1167): runs the child in `cwd`. An empty or
// null `cwd` inherits the parent working directory, matching the POSIX
// contract at `runtime/sfn/process.sfn:1119`. See `_pw_cwd_arg` for the
// `lpApplicationName` divergence this deliberately does not close (SFN-1113).
fn sfn_process_run_capture_cwd(argv: string[], env_flat: string[], cwd: *u8) -> i64 ![io] {
    return _pw_run_capture_impl(argv, env_flat, cwd);
}

// `process.run_capture_rlimit_as` — the Windows leg, which runs the child
// UNCAPPED and ignores `as_bytes` (SFN-1114).
//
// The cap it names is `RLIMIT_AS`, a POSIX address-space rlimit with no Win32
// equivalent: a Job Object's `ProcessMemoryLimit` is a different quantity
// enforced at a different layer, so pretending to honour `as_bytes` here would
// report a cap this leg does not apply. Running uncapped is the contract the
// POSIX side already documents for a non-Linux host
// (`runtime/sfn/process.sfn:1130-1136`) — Darwin ignores `RLIMIT_AS` too, so
// this is the same no-op that leg already takes, not a new divergence.
//
// It exists at all because the symbol must RESOLVE. The runtime helper
// registry emits `sfn_process_run_capture_rlimit_as` unconditionally
// (`codegen-llvm/src/runtime_helpers/registry_process.sfn:95`), and this
// module wholly replaces `process.sfn` on a Windows target, so its absence
// was a link failure — `lld-link: undefined symbol` — not a graceful
// degradation. A caller that needs the cap enforced must gate on the host,
// exactly as it must on macOS.
fn sfn_process_run_capture_rlimit_as(argv: string[], env_flat: string[], as_bytes: i64) -> i64 ![io] {
    let _ignored_cap: i64 = as_bytes;
    return _pw_run_capture_impl(argv, env_flat, 0 as *u8);
}

// Hand off the captured stream stashed by the preceding `run_capture`,
// clearing the global so a second take yields empty. A fresh empty string
// is returned when no capture is pending (mirrors `process.sfn`).
fn sfn_process_capture_take_stdout() -> *u8 ![io] {
    let addr: i64 = pw_capture_stdout_addr;
    pw_capture_stdout_addr = 0;
    if addr == 0 { return _pw_empty_cstr(); }
    return addr as *u8;
}

fn sfn_process_capture_take_stderr() -> *u8 ![io] {
    let addr: i64 = pw_capture_stderr_addr;
    pw_capture_stderr_addr = 0;
    if addr == 0 { return _pw_empty_cstr(); }
    return addr as *u8;
}

// ── process.run_capture_metered (Windows) ─────────────────────────
// `_pw_peak_working_set_kb(process)` — the child's peak working set in KB, or
// `0` when it cannot be read.
//
// `PROCESS_MEMORY_COUNTERS` on x86_64: `cb` (DWORD@0), `PageFaultCount`
// (DWORD@4), then eight `SIZE_T`s — `PeakWorkingSetSize` first, at offset 8 —
// for 72 bytes total. `cb` must be set to that size before the call; the API
// rejects a struct whose declared size it does not recognise, which is how a
// caller that got the layout wrong finds out.
//
// MUST be called while the process handle is still open. Once
// `CloseHandle(h_process)` runs the counters are unreachable, and a peak read
// after the close silently answers `0` rather than failing — so the call site
// sits between `GetExitCodeProcess` and the close, not after it.
fn _pw_peak_working_set_kb(process: i64) -> i64 ![io] {
    let buf: *u8 = malloc(72 as usize);
    if buf as i64 == 0 { return 0; }
    memset(buf, 0, 72 as usize);
    let cb_view: *PwDword = buf as *PwDword;
    cb_view.v = 72;
    let ok: i32 = K32GetProcessMemoryInfo(process, buf, 72);
    if ok == 0 {
        free(buf);
        return 0;
    }
    let peak_bytes: i64 = atomic_load((buf as i64 + 8) as *i64);
    free(buf);
    if peak_bytes <= 0 { return 0; }
    return peak_bytes / 1024;
}

// Metered variant for the native `sfn bench` driver (#1520 / epic #1503).
//
// The POSIX body (`process.sfn`) brackets the child with the monotonic clock
// and threads a `struct rusage` through `wait4` for `ru_maxrss`. Windows has
// neither call, but it has both quantities: `QueryPerformanceCounter` (already
// used by this module's bounded pipe pump, SFN-1092) and
// `K32GetProcessMemoryInfo`'s `PeakWorkingSetSize`. This arms the measurement
// and delegates to the real `run_capture`, which takes both readings at the
// points where they are available — the wall clock around the whole spawn, and
// the peak while the process handle is still open.
//
// Before this, both readings were hard-coded `0`, which is worse than an
// absent feature: `sfn bench --budget-mem` compares a measured peak against a
// threshold, and a peak that is always `0` can never exceed any budget, so the
// budget silently passed everything on this target
// (`compiler/tests/e2e/bench_runtime_runner_test.sfn` asserts exit 2 on an
// unmeetable budget and got exit 0).
//
// Keeps the same `![clock, io]` signature as the POSIX body so the builtin
// descriptor (`llvm/runtime_helpers.sfn`) is platform-uniform.
fn sfn_process_run_capture_metered(argv: string[], env_flat: string[]) -> i64 ![clock, io] {
    pw_capture_wall_ms = 0;
    pw_capture_peak_rss_kb = 0;
    pw_capture_meter_armed = 1;
    return sfn_process_run_capture(argv, env_flat);
}

fn sfn_process_capture_take_wall_ms() -> i64 ![io] {
    let v: i64 = pw_capture_wall_ms;
    pw_capture_wall_ms = 0;
    return v;
}

fn sfn_process_capture_take_peak_rss_kb() -> i64 ![io] {
    let v: i64 = pw_capture_peak_rss_kb;
    pw_capture_peak_rss_kb = 0;
    return v;
}

// ── Async process-handle family (SFN-497) ───────────────────────────
// The two stash overlays. These are the only places the `PwProcHandle`
// byte offsets are spelled out; everything else goes through them.
fn _pw_h_out_gb(h: *PwProcHandle) -> *PwGrowBuf {
    return ((h as i64) + 40) as *PwGrowBuf;
}

fn _pw_h_err_gb(h: *PwProcHandle) -> *PwGrowBuf {
    return ((h as i64) + 64) as *PwGrowBuf;
}

// `_pw_h_pump_once(h, buf, cap)` — one non-blocking read pass over BOTH
// still-open pipes, appending whatever each has buffered to its own stash.
// A pipe reporting EOF/broken (`_pw_read_chunk` → -1) is closed and its
// slot zeroed, which is what later makes `*_at_eof` true. Returns the
// total bytes appended this pass (0 = both pipes open but idle).
//
// Both pipes are always pumped, never just the one a caller asked for: a
// child that fills the other pipe's 64 KiB buffer blocks in its own write
// and never reaches the write the caller is waiting on. That is the same
// deadlock `_pw_drain` avoids for `run_capture`, and the reason the POSIX
// peer polls both fds together.
fn _pw_h_pump_once(h: *PwProcHandle, buf: *u8, cap: i64) -> i64 ![io] {
    let mut got: i64 = 0;
    if h.h_stdout_rd != 0 {
        let r: i64 = _pw_read_chunk(h.h_stdout_rd, buf, cap, _pw_h_out_gb(h));
        if r < 0 {
            let _c: i32 = CloseHandle(h.h_stdout_rd);
            h.h_stdout_rd = 0;
        } else { got = got + r; }
    }
    if h.h_stderr_rd != 0 {
        let r: i64 = _pw_read_chunk(h.h_stderr_rd, buf, cap, _pw_h_err_gb(h));
        if r < 0 {
            let _c: i32 = CloseHandle(h.h_stderr_rd);
            h.h_stderr_rd = 0;
        } else { got = got + r; }
    }
    return got;
}

// Ticks of the Win32 performance counter, or 0 when unavailable. A 0
// return is the caller's signal to treat the budget as unbounded rather
// than to fail: a missing monotonic clock must degrade to the historical
// park-until-a-byte behaviour, never to a spin.
fn _pw_qpc_now() -> i64 ![io] {
    let mut counter: i64 = 0;
    let counter_ptr: *i64 = & counter;
    let ok: i32 = QueryPerformanceCounter(counter_ptr);
    if ok == 0 { return 0; }
    return sailfin_intrinsic_pointer_read_i64(counter_ptr);
}

// Performance-counter ticks per second, or 0 when unavailable. Same
// degrade-to-unbounded contract as `_pw_qpc_now`.
fn _pw_qpc_freq() -> i64 ![io] {
    let mut freq: i64 = 0;
    let freq_ptr: *i64 = & freq;
    let ok: i32 = QueryPerformanceFrequency(freq_ptr);
    if ok == 0 { return 0; }
    return sailfin_intrinsic_pointer_read_i64(freq_ptr);
}

// `_pw_h_pump(h, want_err, to_eof)` — pump both pipes until the requested
// stream (`want_err` 0 = stdout, 1 = stderr) is satisfied: to EOF when
// `to_eof` is 1 (the full-drain reads), or until THIS CALL has appended at
// least one byte to its stash when `to_eof` is 0 (the framed reads).
//
// "This call has appended" rather than "the stash is non-empty": a caller
// that leaves bytes in the stash between calls — `handle_read_line_stdout`
// holding a partial line while it looks for the newline — needs the pump to
// keep reading the pipe, and the weaker spelling let it return without
// reading at all.
//
// Unbounded: parks until a byte or EOF. The framing CONTRACT is
// preserved exactly — an empty return still cannot occur — though the
// idle sleep schedule is now shared with the bounded form, so noticing a
// byte after an idle gap can cost up to 8 ms rather than 1 ms. Kept as the
// historical contract for `sfn_process_handle_read_line_stdout` and the
// full-drain reads, whose framing must never observe a spurious empty
// return. Only the two chunk readers take a budget (SFN-1092).
fn _pw_h_pump(h: *PwProcHandle, want_err: i64, to_eof: i64) -> void ![io] {
    _pw_h_pump_bounded(h, want_err, to_eof, -1);
}

// `_pw_h_pump_bounded(h, want_err, to_eof, budget_ms)` — as `_pw_h_pump`,
// but returns after at most `budget_ms` of waiting when `budget_ms >= 0`.
// A negative budget is unbounded and reproduces the original loop exactly.
//
// This is where the POSIX blocking `read(2)` is reconstructed. Win32 has
// no blocking-with-EOF pipe read that is also safe to interleave, so the
// non-blocking `PeekNamedPipe` probe is looped with a `Sleep` on an idle
// pass. Sleeping (rather than returning empty) is what keeps the POSIX
// contract for the unbounded callers: a framed read must not report "no
// bytes" for a live child that simply has not written yet, or a caller
// framing until `*_at_eof` would spin at 100% CPU instead of parking.
//
// A bounded caller accepts exactly that empty return in exchange for
// getting control back, which is what makes a wall-clock deadline
// observable on Windows at all (SFN-1092). On budget exhaustion the stash
// and BOTH pipe handles are left untouched, so the call is a pure
// no-progress return: no byte is consumed, no EOF is synthesized, and the
// next call resumes where this one stopped.
//
// The idle `Sleep` backs off 1 → 2 → 4 → 8 ms, capped, and resets to 1 ms
// on any pass that appended bytes. A flat `Sleep(1)` against the 900 s
// default deadline (`compiler/src/cli/commands/test/exec.sfn`) is ~900k
// wakeups per silent child; the cap makes it ~112k while a chatty child
// still gets sub-millisecond turnaround, because the first idle pass
// after data always sleeps 1 ms.
fn _pw_h_pump_bounded(h: *PwProcHandle, want_err: i64, to_eof: i64, budget_ms: i64) -> void ![io] {
    // Already at EOF: nothing to pump. Checked before the buffer alloc so the
    // common already-drained call costs nothing.
    if want_err != 0 {
        if h.h_stderr_rd == 0 { return; }
    } else {
        if h.h_stdout_rd == 0 { return; }
    }
    let cap: i64 = 65536;
    let buf: *u8 = malloc(cap as usize);
    if buf as i64 == 0 {
        // Out of memory. Returning with state untouched would livelock the
        // caller: the stash stays empty so a framed read yields "", while the
        // stream handle stays open so `*_at_eof` stays false — and the
        // canonical `loop { if at_eof break; read_bytes() }` would spin
        // forever without draining the child. Close the requested stream so
        // EOF is reported instead. The POSIX peer reaches the same end by
        // returning -1 from `_framed_fill`, whose caller closes the fd.
        if want_err != 0 {
            let _ce: i32 = CloseHandle(h.h_stderr_rd);
            h.h_stderr_rd = 0;
        } else {
            let _co: i32 = CloseHandle(h.h_stdout_rd);
            h.h_stdout_rd = 0;
        }
        return;
    }
    let ogb: *PwGrowBuf = _pw_h_out_gb(h);
    let egb: *PwGrowBuf = _pw_h_err_gb(h);
    // A zero frequency means the counter is unusable; fall back to
    // unbounded rather than treating every pass as expired, which would
    // turn a bounded caller's park into a spin.
    let freq: i64 = _pw_qpc_freq();
    let mut bounded: i64 = 0;
    let mut started: i64 = 0;
    if budget_ms >= 0 && freq > 0 {
        started = _pw_qpc_now();
        // `started == 0` is the counter read failing. Staying unbounded
        // is the only safe degrade: a zero baseline would make the first
        // successful read measure ticks-since-boot as "elapsed", expire
        // instantly, and turn the caller's park into a 100% CPU spin.
        if started > 0 { bounded = 1; }
    }
    // The stash length THIS CALL started with. `to_eof == 0` means "return
    // once this call has appended something", and that is not the same
    // question as "is the stash non-empty" — the two coincide only when the
    // caller drains to empty before every call.
    //
    // `handle_read_bytes_stdout`/`_stderr` do drain first (they only pump
    // when `gb.len == 0`), so a zero baseline leaves them behaving exactly
    // as before. `handle_read_line_stdout` does NOT: it keeps a partial line
    // in the stash and pumps again looking for the newline. Against the old
    // `have > 0` spelling that call broke out of this loop on its first
    // iteration, BEFORE `_pw_h_pump_once` ran — so the pipe was never read
    // again, the remaining bytes and the eventual EOF were never observed,
    // and the caller span at full CPU forever. Any child whose write reached
    // the parent in more than one fragment hit it; one that arrived whole
    // did not, which is why it looked intermittent rather than broken.
    //
    // The POSIX peer has no equivalent short-circuit — `_framed_fill`
    // (`runtime/sfn/process.sfn`) always issues a real blocking `read(2)` and
    // returns only once it has appended or hit EOF — so this restores the
    // mirror the header claims.
    let mut baseline: i64 = 0;
    if want_err != 0 { baseline = egb.len; } else { baseline = ogb.len; }
    let mut idle_sleep_ms: i32 = 1;
    loop {
        let mut open: i64 = 0;
        let mut have: i64 = 0;
        if want_err != 0 {
            open = h.h_stderr_rd;
            have = egb.len;
        } else {
            open = h.h_stdout_rd;
            have = ogb.len;
        }
        // EOF on the requested stream ends every mode.
        if open == 0 { break; }
        if to_eof == 0 {
            if have > baseline { break; }
        }
        // Checked before the pump pass, NOT only on an idle one.
        // `_pw_h_pump_once` sums BOTH pipes, so a child that is silent on
        // the requested stream while streaming the other keeps returning
        // `n > 0` — gating the check on an idle pass would starve it and
        // leave a hung-but-noisy child unkillable, the narrowed form of
        // the very bug this bounds (SFN-1092). That shape is the common
        // one, not an edge case: the test runner's frame protocol rides
        // the child's stderr while stdout is often empty.
        //
        // Bytes appended by THIS call are never abandoned — the
        // `have > baseline` break above fires first. A pass that WOULD
        // have fetched new bytes can be skipped, but `_pw_h_pump_once`
        // never ran, so nothing was consumed from the pipe and the next
        // call retrieves them. That is the no-progress-return invariant
        // in the header.
        if bounded == 1 {
            // Multiply the ELAPSED tick delta, not the absolute counter:
            // the counter is ticks-since-boot and would overflow i64 when
            // scaled by 1000, while the delta spans one pump call.
            let elapsed_ticks: i64 = _pw_qpc_now() - started;
            if (elapsed_ticks * 1000) / freq >= budget_ms { break; }
        }
        let n: i64 = _pw_h_pump_once(h, buf, cap);
        if n > 0 { idle_sleep_ms = 1; } else {
            Sleep(idle_sleep_ms);
            if idle_sleep_ms < 8 { idle_sleep_ms = idle_sleep_ms * 2; }
        }
    }
    free(buf);
}

// Fault-injection seam for the two allocations owned by
// `_pw_framed_consume`. Production calls still make the same mallocs with
// the same sizes. A test process can set
// `SAILFIN_TEST_FRAMED_CONSUME_ALLOC_FAILURE` to `result` or `compact`
// to fail the matching allocation without starving unrelated runtime
// allocations.
fn _pw_framed_consume_alloc(size: usize, phase: i64) -> *u8 {
    let env_name: string = "SAILFIN_TEST_FRAMED_CONSUME_ALLOC_FAILURE";
    let requested: *u8 = getenv(env_name as *u8);
    if requested as i64 != 0 {
        let result_name: string = "result";
        let compact_name: string = "compact";
        if phase == 1 && strcmp(requested, result_name as *u8) == 0 {
            return null;
        }
        if phase == 2 && strcmp(requested, compact_name as *u8) == 0 {
            return null;
        }
    }
    return malloc(size);
}

// `_pw_framed_consume(gb, ret_len, consume_len)` — hand `ret_len` bytes
// from the front of the stash to the caller as a fresh NUL-terminated
// buffer, then drop `consume_len` from the front. The unconsumed remainder
// is compacted with two NON-OVERLAPPING `memcpy`s through a temp buffer:
// there is no `memmove` available here, and a single overlapping `memcpy`
// would be undefined. If either allocation fails, the entire stash is
// dropped: the result-allocation path returns the ordinary empty sentinel
// (which can itself be null under host OOM), while the compaction path
// returns the prefix it already copied. In both cases `gb.len == 0`, so
// callers make forward progress and never observe bytes that were not moved
// to the front. Mirrors the POSIX `_framed_consume`
// (`runtime/sfn/process.sfn`) exactly. `gb.cap` is untouched, so the
// append-side headroom invariant survives (`len` only ever shrinks here).
fn _pw_framed_consume(gb: *PwGrowBuf, ret_len: i64, consume_len: i64) -> *u8 {
    let addr: i64 = gb.addr;
    let len: i64 = gb.len;
    let res: *u8 = _pw_framed_consume_alloc((ret_len + 1) as usize, 1);
    if res as i64 == 0 {
        gb.len = 0;
        return _pw_empty_cstr();
    }
    if ret_len > 0 { memcpy(res, addr as *u8, ret_len as usize); }
    memset((res as i64 + ret_len) as *u8, 0, 1 as usize);
    let rem: i64 = len - consume_len;
    if rem > 0 {
        let tmp: *u8 = _pw_framed_consume_alloc(rem as usize, 2);
        if tmp as i64 == 0 {
            gb.len = 0;
            return res;
        }
        memcpy(tmp, (addr + consume_len) as *u8, rem as usize);
        memcpy(addr as *u8, tmp, rem as usize);
        free(tmp);
        gb.len = rem;
    } else { gb.len = 0; }
    return res;
}

// `_pw_framed_find_newline(gb)` — index of the first `'\n'` in the stash,
// or -1. Byte-oriented on purpose: a line is framed on the LF byte, so a
// CRLF stream keeps its `'\r'` at the end of the returned line exactly as
// the POSIX peer leaves it. The two must agree on that or a framed reader
// would see different line boundaries per platform (SFN-690).
//
// Reads through `load_byte`, a genuine one-byte load, rather than the
// `sailfin_intrinsic_pointer_read_i32` + mask the POSIX `_framed_find_newline`
// uses. That is a real difference, not a stylistic one: the i32 form loads
// FOUR bytes, and is safe on the POSIX side only because `_framed_fill`
// maintains `gb.cap >= gb.len + 8` (`runtime/sfn/process.sfn`). `PwGrowBuf`
// has no such invariant — `_pw_gb_append` reserves `len + n + 1`, one byte
// for the NUL — so scanning the final byte with a 4-byte load would read
// two bytes past the allocation. `load_byte` removes the dependency on any
// slack invariant instead of importing POSIX's, which is the same reason
// it exists at all (`runtime/sfn/string.sfn`).
fn _pw_framed_find_newline(gb: *PwGrowBuf) -> i64 {
    let addr: i64 = gb.addr;
    if addr == 0 { return -1; }
    let len: i64 = gb.len;
    let mut i: i64 = 0;
    loop {
        if i >= len { break; }
        if load_byte(addr + i) == 10 { return i; }
        i = i + 1;
    }
    return -1;
}

// `_pw_spawn_impl(argv, env_flat, cwd)` — real Windows non-blocking spawn. Three
// anonymous pipes (stdin/stdout/stderr) are wired to the child through
// `STARTUPINFOA`, the child is launched, and a live `PwProcHandle` address
// is returned as the id. Unlike `run_capture` this does NOT wait: the
// caller drives the child through the `handle_*` surface, which is what
// makes many children in flight at once expressible.
//
// Returns `0` on ANY failure (empty argv, OOM, CreatePipe, CreateProcessA)
// — the family's universal failure sentinel, `0` rather than `-1` to match
// the POSIX peer and the retired C `_WIN32` contract
// (`sailfin_runtime.c:8195`).
fn _pw_spawn_impl(argv: string[], env_flat: string[], cwd: *u8) -> i64 ![io] {
    let len: i64 = argv.length;
    if len <= 0 { return 0; }

    let cmdline: *u8 = _pw_build_cmdline(argv);
    if cmdline as i64 == 0 { return 0; }
    let env_block: *u8 = _pw_build_env_block(env_flat);
    if env_block as i64 == 0 {
        free(cmdline);
        return 0;
    }

    // Inheritable SECURITY_ATTRIBUTES (24 bytes): `{ nLength@0,
    // lpSecurityDescriptor@8, bInheritHandle@16 }`, as `run_capture` builds.
    let sa: *u8 = malloc(24 as usize);
    if sa as i64 == 0 {
        free(cmdline);
        free(env_block);
        return 0;
    }
    memset(sa, 0, 24 as usize);
    atomic_store(sa as *i64, 24);
    atomic_store((sa as i64 + 16) as *i64, 1);

    // Three anonymous pipes packed into one 48-byte buffer:
    // stdin (rd@0, wr@8), stdout (rd@16, wr@24), stderr (rd@32, wr@40).
    let hbuf: *u8 = malloc(48 as usize);
    if hbuf as i64 == 0 {
        free(cmdline);
        free(env_block);
        free(sa);
        return 0;
    }
    memset(hbuf, 0, 48 as usize);
    let hbase: i64 = hbuf as i64;

    _pw_lock_inheritable_spawn();
    if CreatePipe(hbase as *i64, (hbase + 8) as *i64, sa, 0) == 0 {
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(hbuf);
        return 0;
    }
    if CreatePipe((hbase + 16) as *i64, (hbase + 24) as *i64, sa, 0) == 0 {
        let _c1: i32 = CloseHandle(atomic_load(hbase as *i64));
        let _c2: i32 = CloseHandle(atomic_load((hbase + 8) as *i64));
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(hbuf);
        return 0;
    }
    if CreatePipe((hbase + 32) as *i64, (hbase + 40) as *i64, sa, 0) == 0 {
        let _c1: i32 = CloseHandle(atomic_load(hbase as *i64));
        let _c2: i32 = CloseHandle(atomic_load((hbase + 8) as *i64));
        let _c3: i32 = CloseHandle(atomic_load((hbase + 16) as *i64));
        let _c4: i32 = CloseHandle(atomic_load((hbase + 24) as *i64));
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(hbuf);
        return 0;
    }
    let in_rd: i64 = atomic_load(hbase as *i64);
    let in_wr: i64 = atomic_load((hbase + 8) as *i64);
    let out_rd: i64 = atomic_load((hbase + 16) as *i64);
    let out_wr: i64 = atomic_load((hbase + 24) as *i64);
    let err_rd: i64 = atomic_load((hbase + 32) as *i64);
    let err_wr: i64 = atomic_load((hbase + 40) as *i64);
    free(hbuf);

    // The parent-side ends are parent-only: clear HANDLE_FLAG_INHERIT (1)
    // so the child neither inherits nor leaks them. Leaving `in_wr`
    // inheritable would be the subtle one — the child would hold a writer
    // on its OWN stdin and never see EOF from `handle_close_stdin`.
    let s1: i32 = SetHandleInformation(in_wr, 1, 0);
    let s2: i32 = SetHandleInformation(out_rd, 1, 0);
    let s3: i32 = SetHandleInformation(err_rd, 1, 0);
    if s1 == 0 || s2 == 0 || s3 == 0 {
        let _c1: i32 = CloseHandle(in_rd);
        let _c2: i32 = CloseHandle(in_wr);
        let _c3: i32 = CloseHandle(out_rd);
        let _c4: i32 = CloseHandle(out_wr);
        let _c5: i32 = CloseHandle(err_rd);
        let _c6: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        return 0;
    }

    // STARTUPINFOA (104 bytes): cb@0=104, dwFlags@60=STARTF_USESTDHANDLES
    // (0x100=256), hStdInput@80, hStdOutput@88, hStdError@96. cb/dwFlags are
    // 4-aligned DWORDs written through the `PwDword` overlay; the three
    // HANDLEs are 8-aligned and written with `atomic_store`.
    let si: *u8 = malloc(104 as usize);
    if si as i64 == 0 {
        let _c1: i32 = CloseHandle(in_rd);
        let _c2: i32 = CloseHandle(in_wr);
        let _c3: i32 = CloseHandle(out_rd);
        let _c4: i32 = CloseHandle(out_wr);
        let _c5: i32 = CloseHandle(err_rd);
        let _c6: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        return 0;
    }
    memset(si, 0, 104 as usize);
    let cb_view: *PwDword = si as *PwDword;
    cb_view.v = 104;
    let flags_view: *PwDword = (si as i64 + 60) as *PwDword;
    flags_view.v = 256;
    atomic_store((si as i64 + 80) as *i64, in_rd);
    atomic_store((si as i64 + 88) as *i64, out_wr);
    atomic_store((si as i64 + 96) as *i64, err_wr);

    // PROCESS_INFORMATION (24 bytes): `{ hProcess@0, hThread@8, ... }`.
    let pi: *u8 = malloc(24 as usize);
    if pi as i64 == 0 {
        let _c1: i32 = CloseHandle(in_rd);
        let _c2: i32 = CloseHandle(in_wr);
        let _c3: i32 = CloseHandle(out_rd);
        let _c4: i32 = CloseHandle(out_wr);
        let _c5: i32 = CloseHandle(err_rd);
        let _c6: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(si);
        return 0;
    }
    memset(pi, 0, 24 as usize);

    // The handle record is allocated BEFORE the spawn: a post-spawn OOM
    // would leave a running child with no way to reap it.
    let h: *PwProcHandle = malloc(88 as usize) as *PwProcHandle;
    if h as i64 == 0 {
        let _c1: i32 = CloseHandle(in_rd);
        let _c2: i32 = CloseHandle(in_wr);
        let _c3: i32 = CloseHandle(out_rd);
        let _c4: i32 = CloseHandle(out_wr);
        let _c5: i32 = CloseHandle(err_rd);
        let _c6: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(cmdline);
        free(env_block);
        free(sa);
        free(si);
        free(pi);
        return 0;
    }
    memset(h as *u8, 0, 88 as usize);

    // bInheritHandles=TRUE(1) so the child inherits the three redirected
    // ends; flags=0 (ANSI environment block). The file-level inheritance
    // lock is held until the parent closes its child-side pipe ends below.
    let app: *u8 = _pw_app_name(argv[0]);
    let ok: i32 = CreateProcessA(app, cmdline, null, null, 1, 0, env_block, _pw_cwd_arg(cwd), si, pi);
    free(cmdline);
    free(env_block);
    free(sa);
    if ok == 0 {
        let _c1: i32 = CloseHandle(in_rd);
        let _c2: i32 = CloseHandle(in_wr);
        let _c3: i32 = CloseHandle(out_rd);
        let _c4: i32 = CloseHandle(out_wr);
        let _c5: i32 = CloseHandle(err_rd);
        let _c6: i32 = CloseHandle(err_wr);
        _pw_unlock_inheritable_spawn();
        free(h as *u8);
        free(si);
        free(pi);
        return 0;
    }

    h.h_process = atomic_load(pi as *i64);
    h.h_thread = atomic_load((pi as i64 + 8) as *i64);
    free(si);
    free(pi);

    // The parent drops the child's own ends immediately. Closing the two
    // write ends is what lets the read ends report EOF once the child (now
    // their only writer) exits — without it every drain would hang.
    let _cc1: i32 = CloseHandle(in_rd);
    let _cc2: i32 = CloseHandle(out_wr);
    let _cc3: i32 = CloseHandle(err_wr);
    _pw_unlock_inheritable_spawn();

    h.h_stdin_wr = in_wr;
    h.h_stdout_rd = out_rd;
    h.h_stderr_rd = err_rd;
    // Both stashes start empty (the `memset` above zeroed them).
    return h as i64;
}

// No per-child directory, so the child inherits the parent working
// directory (a null `lpCurrentDirectory`).
fn sfn_process_spawn_with_env(argv: string[], env_flat: string[]) -> i64 ![io] {
    return _pw_spawn_impl(argv, env_flat, 0 as *u8);
}

// `process.spawn_with_env_cwd` (#1167): spawns the child in `cwd`. An empty
// or null `cwd` inherits the parent working directory, matching the POSIX
// contract at `runtime/sfn/process.sfn:1359`. See `_pw_cwd_arg` for the
// `lpApplicationName` divergence this deliberately does not close (SFN-1113).
fn sfn_process_spawn_with_env_cwd(argv: string[], env_flat: string[], cwd: *u8) -> i64 ![io] {
    return _pw_spawn_impl(argv, env_flat, cwd);
}

// Write the whole NUL-terminated `data` to the child's stdin, resuming on
// a short `WriteFile`. Returns bytes written, or `-1` on a zero handle,
// null `data`, an already-closed stdin, or a write error.
fn sfn_process_handle_write(handle_id: i64, data: *u8) -> i64 ![io] {
    if handle_id == 0 { return -1; }
    if data as i64 == 0 { return -1; }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let hw: i64 = h.h_stdin_wr;
    if hw == 0 { return -1; }
    let total: i64 = strlen(data) as i64;
    if total <= 0 { return 0; }
    let base: i64 = data as i64;
    let mut off: i64 = 0;
    loop {
        if off >= total { break; }
        let mut wrote: i32 = 0;
        let wrote_ptr: *i32 = & wrote;
        let ok: i32 = WriteFile(hw, (base + off) as *u8, (total - off) as i32, wrote_ptr, null);
        if ok == 0 { return -1; }
        if wrote <= 0 { return -1; }
        off = off + (wrote as i64);
    }
    return off;
}

// Largest span handed to a single `WriteFile`. Comfortably inside the
// DWORD the API takes, so the i64 -> i32 narrowing below cannot wrap.
let PW_MAX_WRITE_CHUNK: i64 = 1073741824;

// Write exactly `len` bytes of `data` to the child's stdin. Unlike
// `handle_write`, which `strlen`s a NUL-terminated cstring, this honors an
// explicit length, so embedded NULs in a binary frame are written verbatim
// — the whole reason the framed protocol needs it. Returns bytes written
// (`== len` on success), or `-1` on a zero handle, null `data`, a negative
// length, an already-closed stdin, or a write error. `len == 0` writes
// nothing and returns 0.
//
// The POSIX peer resumes on `EINTR`; Win32 has no such interruption on a
// blocking `WriteFile` to a pipe, so a `FALSE` return is terminal here and
// a short write is resumed by the loop alone (SFN-690).
fn sfn_process_handle_write_bytes(handle_id: i64, data: *u8, len: i64) -> i64 ![io] {
    if handle_id == 0 { return -1; }
    if data as i64 == 0 { return -1; }
    if len < 0 { return -1; }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let hw: i64 = h.h_stdin_wr;
    if hw == 0 { return -1; }
    if len == 0 { return 0; }
    let base: i64 = data as i64;
    let mut off: i64 = 0;
    loop {
        if off >= len { break; }
        // `WriteFile`'s count is a DWORD, so the remaining span is clamped
        // before the narrowing cast. `len` is an i64 the caller chooses: a
        // frame above 2 GiB would otherwise wrap the cast negative and hand
        // Win32 a nonsense byte count. The loop already resumes short
        // writes, so capping a single pass costs nothing.
        let mut chunk: i64 = len - off;
        if chunk > PW_MAX_WRITE_CHUNK { chunk = PW_MAX_WRITE_CHUNK; }
        let mut wrote: i32 = 0;
        let wrote_ptr: *i32 = & wrote;
        let ok: i32 = WriteFile(hw, (base + off) as *u8, chunk as i32, wrote_ptr, null);
        if ok == 0 { return -1; }
        if wrote <= 0 { return -1; }
        off = off + (wrote as i64);
    }
    return off;
}

// Close the parent's write end so the child sees EOF on stdin. The slot is
// zeroed so `handle_wait`'s cleanup does not double-close it (the POSIX
// peer persists `-1` into `stdin_fd` for the same reason).
fn sfn_process_handle_close_stdin(handle_id: i64) -> void ![io] {
    if handle_id == 0 { return; }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    if h.h_stdin_wr == 0 { return; }
    let _c: i32 = CloseHandle(h.h_stdin_wr);
    h.h_stdin_wr = 0;
    return;
}

// Full-drain reads: pump to EOF, then hand the whole stash over. The
// returned pointer is a fresh NUL-terminated buffer the CALLER owns.
fn sfn_process_handle_read_stdout(handle_id: i64) -> *u8 ![io] {
    if handle_id == 0 { return _pw_empty_cstr(); }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    _pw_h_pump(h, 0, 1);
    return _pw_gb_take(_pw_h_out_gb(h));
}

fn sfn_process_handle_read_stderr(handle_id: i64) -> *u8 ![io] {
    if handle_id == 0 { return _pw_empty_cstr(); }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    _pw_h_pump(h, 1, 1);
    return _pw_gb_take(_pw_h_err_gb(h));
}

// Reap the child and destroy the handle. Mirrors the POSIX peer: this is
// the SOLE free path, so a handle never waited leaks its record, both
// stash buffers, and the kernel process/thread handles. Any still-open
// pipe end is closed first — undrained output is discarded, exactly as the
// POSIX peer discards it.
//
// Returns the child's raw Win32 exit code, or `-1` on a zero handle, an
// already-reaped handle, or a failed `GetExitCodeProcess`. A Windows exit
// code is a full DWORD, so unlike POSIX it is not confined to 0..255 and a
// child exiting with 0xFFFFFFFF is indistinguishable from the failure
// sentinel — the same aliasing `sfn_process_run` and `run_capture` already
// carry on this platform.
fn sfn_process_handle_wait(handle_id: i64) -> i64 ![io] {
    if handle_id == 0 { return -1; }
    let h: *PwProcHandle = handle_id as *PwProcHandle;

    if h.h_stdin_wr != 0 {
        let _c: i32 = CloseHandle(h.h_stdin_wr);
        h.h_stdin_wr = 0;
    }
    if h.h_stdout_rd != 0 {
        let _c: i32 = CloseHandle(h.h_stdout_rd);
        h.h_stdout_rd = 0;
    }
    if h.h_stderr_rd != 0 {
        let _c: i32 = CloseHandle(h.h_stderr_rd);
        h.h_stderr_rd = 0;
    }
    let ogb: *PwGrowBuf = _pw_h_out_gb(h);
    if ogb.addr != 0 {
        free(ogb.addr as *u8);
        ogb.addr = 0;
        ogb.len = 0;
        ogb.cap = 0;
    }
    let egb: *PwGrowBuf = _pw_h_err_gb(h);
    if egb.addr != 0 {
        free(egb.addr as *u8);
        egb.addr = 0;
        egb.len = 0;
        egb.cap = 0;
    }

    let hp: i64 = h.h_process;
    if hp == 0 {
        free(h as *u8);
        return -1;
    }

    // INFINITE = 0xFFFFFFFF, passed as i32 -1 (same bit pattern; a hex
    // literal folds to 0 on the seed — see `sfn_process_run`).
    let _w: i32 = WaitForSingleObject(hp, -1);
    let mut code: i32 = 0;
    let code_ptr: *i32 = & code;
    let got: i32 = GetExitCodeProcess(hp, code_ptr);
    let _cp: i32 = CloseHandle(hp);
    if h.h_thread != 0 {
        let _ct: i32 = CloseHandle(h.h_thread);
    }
    free(h as *u8);
    if got == 0 { return -1; }
    return code as i64;
}

// The fd accessors still answer `-1` on Windows, but the reason recorded
// here previously no longer holds and is corrected rather than repeated.
//
// It claimed two things. First, that "a Windows HANDLE is not a file
// descriptor, and there is no numbering space to project one onto" — the
// UCRT provides exactly that space in both directions: `_get_osfhandle`
// (declared above, and used by `_pw_fd_handle`) maps fd -> HANDLE, and its
// counterpart `_open_osfhandle` maps HANDLE -> fd. Second, that the only
// consumer, `io.poll_any`, "is itself unavailable here" — it is available:
// `sfn_io_poll_readable` and `sfn_io_poll_any` below are implemented over
// `PeekNamedPipe` and answer for pipe handles.
//
// So this is a genuine unimplemented capability (SFN-499), not a platform
// impossibility, and it should be described as one. What it costs is
// HANDLE OWNERSHIP: `_open_osfhandle` TRANSFERS the handle to the returned
// descriptor, so `_close` on the fd closes the underlying handle. A handle
// projected here would therefore have to be minted once, cached on the
// `PwHandle`, and released through the fd instead of through
// `CloseHandle(h_stdout)`/`CloseHandle(h_stderr)` in the teardown paths —
// or duplicated first. Getting that wrong is a double-close affecting every
// spawned child, which is why it is a deliberate piece of work rather than
// a one-line fix, and why the accessors stay honest at `-1` until it lands.
//
// Callers needing deadlock-free stdout/stderr demux on Windows today use
// the framed reads below: they pump BOTH pipes on every call, so neither
// stream can wedge the other — the property `poll_any` buys on POSIX.
fn sfn_process_handle_stdout_fd(handle_id: i64) -> i64 ![io] { return -1; }

fn sfn_process_handle_stderr_fd(handle_id: i64) -> i64 ![io] { return -1; }

// How long a chunk read waits on a silent child before returning empty.
//
// This is the Windows deadline-observation latency: a drain loop reads
// both streams per iteration, so a caller's wall-clock deadline is seen
// within ~2x this plus scheduler slop. Against the 900 s default
// (`compiler/src/cli/commands/test/exec.sfn`) that is ~0.006%.
//
// A budgeted pump actually spans ~31 ms, not 25: the backoff sleeps
// 1+2+4+8+8+8 before the pass that observes the budget spent. Idle cost
// is therefore ~7 `PeekNamedPipe` pairs per pump call, and with two pump
// calls per caller iteration ~225 pairs/s per silent child — paid only
// by a child producing nothing, and negligible either way.
//
// MUST stay positive. The budget is checked before the pump pass, so
// `budget_ms == 0` breaks on the first iteration and returns empty
// without ever probing the pipe — even with bytes already sitting in it.
// Nothing enforces this at the type level; the two call sites below are
// the only ones that pass it.
let PW_FRAMED_POLL_BUDGET_MS: i64 = 25;

// Framed reads (SFN-153 stdout twins, SFEP-0050 stderr twins): return AT
// MOST `n` bytes, stashing the remainder for the next call. When the stash
// is empty the pipes are pumped until the requested stream yields a byte,
// hits EOF, or `PW_FRAMED_POLL_BUDGET_MS` elapses.
//
// An empty return therefore does NOT mean EOF on Windows (SFN-1092): it
// means "nothing yet", and `*_at_eof` is the sole EOF oracle. That is
// already the contract every in-tree drain loop follows — each re-checks
// `*_at_eof` at the top of its iteration — and it is what makes a
// wall-clock deadline observable here at all. Before SFN-1092 these reads
// parked indefinitely, so a wholly silent child could never be killed.
//
// `sfn_process_handle_read_line_stdout` below is deliberately NOT bounded:
// its line framing treats an empty return as EOF.
fn sfn_process_handle_read_bytes_stdout(handle_id: i64, n: i64) -> *u8 ![io] {
    if handle_id == 0 { return _pw_empty_cstr(); }
    if n <= 0 { return _pw_empty_cstr(); }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let gb: *PwGrowBuf = _pw_h_out_gb(h);
    if gb.len == 0 {
        _pw_h_pump_bounded(h, 0, 0, PW_FRAMED_POLL_BUDGET_MS);
    }
    let mut take: i64 = n;
    if take > gb.len { take = gb.len; }
    if take <= 0 { return _pw_empty_cstr(); }
    return _pw_framed_consume(gb, take, take);
}

// Return one `'\n'`-delimited line from the child's stdout, without the
// trailing newline, leaving any bytes past it in the stash for the next
// call. On EOF the final unterminated partial line is returned, then the
// empty string. Mirrors the POSIX `sfn_process_handle_read_line_stdout`
// (`runtime/sfn/process.sfn`) — this is the framing entry point `sfn/os`'s
// `handle_read_line_stdout` calls, and without it nothing importing
// `sfn/test` links on Windows at all (SFN-690).
//
// The loop terminates because `_pw_h_pump(h, 0, 0)` returns only once the
// stash has grown or stdout hit EOF (which zeroes `h_stdout_rd`). Either
// outcome advances the next iteration: more bytes to scan, or the
// EOF branch above. It needs no guard counter for that reason — the
// progress condition is the pump's own postcondition, not the input.
fn sfn_process_handle_read_line_stdout(handle_id: i64) -> *u8 ![io] {
    if handle_id == 0 { return _pw_empty_cstr(); }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let gb: *PwGrowBuf = _pw_h_out_gb(h);
    loop {
        let idx: i64 = _pw_framed_find_newline(gb);
        if idx >= 0 { return _pw_framed_consume(gb, idx, idx + 1); }
        // No newline buffered. Once stdout is at EOF the stash tail is the
        // last (unterminated) line, and the call after that yields "".
        if h.h_stdout_rd == 0 {
            return _pw_framed_consume(gb, gb.len, gb.len);
        }
        _pw_h_pump(h, 0, 0);
    }
}

fn sfn_process_handle_read_bytes_stderr(handle_id: i64, n: i64) -> *u8 ![io] {
    if handle_id == 0 { return _pw_empty_cstr(); }
    if n <= 0 { return _pw_empty_cstr(); }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let gb: *PwGrowBuf = _pw_h_err_gb(h);
    if gb.len == 0 {
        _pw_h_pump_bounded(h, 1, 0, PW_FRAMED_POLL_BUDGET_MS);
    }
    let mut take: i64 = n;
    if take > gb.len { take = gb.len; }
    if take <= 0 { return _pw_empty_cstr(); }
    return _pw_framed_consume(gb, take, take);
}

// True once the stream is genuinely exhausted: its pipe was closed on a
// prior EOF read AND no read-ahead bytes remain. A pure state read — no
// Win32 call, so it never blocks. A zero handle reports `true`, matching
// the POSIX peer's dead-handle-is-EOF convention so a caller framing until
// EOF stops rather than spinning.
//
// Note this is `false` while the child is alive but silent: EOF is only
// observed by a read that finds the pipe broken, so a caller polls
// `handle_read_bytes_*` until this flips, it does not consult this first.
fn sfn_process_handle_stdout_at_eof(handle_id: i64) -> bool ![io] {
    if handle_id == 0 { return true; }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let gb: *PwGrowBuf = _pw_h_out_gb(h);
    if h.h_stdout_rd == 0 && gb.len == 0 { return true; }
    return false;
}

fn sfn_process_handle_stderr_at_eof(handle_id: i64) -> bool ![io] {
    if handle_id == 0 { return true; }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let gb: *PwGrowBuf = _pw_h_err_gb(h);
    if h.h_stderr_rd == 0 && gb.len == 0 { return true; }
    return false;
}

// Kill the child. Windows has no signals, so `TerminateProcess` stands in
// for the POSIX peer's SIGKILL. The exit code is forced to 137 so a later
// `handle_wait` reports the same value the POSIX peer synthesises for a
// SIGKILLed child (128 + 9) and a cross-platform caller sees one number;
// as there, 137 is therefore ambiguous with a child that genuinely exited
// 137, and a caller that must know tracks its own killed-on-deadline flag.
//
// Returns `0` on success, `-1` on a zero/invalid handle or a genuine
// failure. A child that already exited is reported as success:
// `TerminateProcess` fails with ERROR_ACCESS_DENIED on an exited process,
// whereas POSIX `kill(2)` on a not-yet-reaped zombie succeeds, so the
// exit-code probe below restores parity. Like POSIX, this does NOT reap —
// `handle_wait` is still required.
fn sfn_process_handle_kill(handle_id: i64) -> i64 ![io] {
    if handle_id == 0 { return -1; }
    let h: *PwProcHandle = handle_id as *PwProcHandle;
    let hp: i64 = h.h_process;
    if hp == 0 { return -1; }
    if TerminateProcess(hp, 137) != 0 { return 0; }
    let mut code: i32 = 0;
    let code_ptr: *i32 = & code;
    let got: i32 = GetExitCodeProcess(hp, code_ptr);
    // STILL_ACTIVE = 259. Anything else means the child is already gone,
    // which is the zombie case POSIX reports as a successful kill.
    if got != 0 && code != 259 { return 0; }
    return -1;
}

// `_pw_fd_handle(fd)` — the Win32 HANDLE behind a CRT file descriptor, or
// `0` when the descriptor carries none. `_get_osfhandle`'s two failure
// answers (`-1` never opened, `-2` no handle) collapse to that one `0`,
// which is not itself a valid handle for any fd this reaches.
fn _pw_fd_handle(fd: i64) -> i64 {
    if fd < 0 { return 0; }
    let h: i64 = _get_osfhandle(fd as i32);
    if h == -1 { return 0; }
    if h == -2 { return 0; }
    return h;
}

// `_pw_handle_readable_now(h)` — one NON-BLOCKING readiness probe, `1`
// when a follow-up read must run and `0` when the pipe is open and empty.
//
// That phrasing is the POSIX contract this mirrors, not "bytes are
// waiting": `poll(2)` reports a slot ready on data, EOF (`POLLHUP`), or
// error, because all three are conditions under which `read(2)` has to be
// called to make progress. So a `PeekNamedPipe` FAILURE is `1`, not `0` —
// it means the writer is gone, and the caller's read will report EOF.
// Answering `0` there would park a caller forever on a pipe that will
// never produce another byte, which is the deadlock this exists to avoid.
//
// A non-pipe handle has no peek primitive at all. A disk file is always
// readable in the `read(2)`-makes-progress sense, so `1` is right for it.
// For a console handle and for a socket (`GetFileType` also answers
// `FILE_TYPE_PIPE` for sockets, where `PeekNamedPipe` fails) `1` is a
// DEGRADE: the caller runs a read that may block. That is strictly better
// than the stub this replaces, which answered "never readable" for every
// handle and made a multiplexing caller hang outright, but it is not
// equivalent to `poll(2)` and a caller that must not block on a console
// or socket needs a real overlapped-I/O or `WSAPoll` path.
fn _pw_handle_readable_now(h: i64) -> i64 ![io] {
    // 3 = FILE_TYPE_PIPE, the only type with a non-blocking peek.
    if GetFileType(h) != 3 { return 1; }
    let mut avail: i32 = 0;
    let mut peeked: i32 = 0;
    let mut left: i32 = 0;
    let avail_ptr: *i32 = & avail;
    let peek_ptr: *i32 = & peeked;
    let left_ptr: *i32 = & left;
    let ok: i32 = PeekNamedPipe(h, null, 0, peek_ptr, avail_ptr, left_ptr);
    if ok == 0 { return 1; }
    if avail > 0 { return 1; }
    return 0;
}

// `_pw_poll_deadline_exceeded(start, freq, timeout_ms)` — whether a
// bounded wait that began at `start` ticks has run out. A `freq` of `0`
// means `QueryPerformanceFrequency` was unavailable, and the wait cannot
// be bounded at all; that answers "exceeded" so a finite timeout degrades
// to a single probe rather than to an unbounded spin.
fn _pw_poll_deadline_exceeded(start: i64, freq: i64, timeout_ms: i64) -> boolean ![io] {
    if timeout_ms < 0 { return false; }
    if freq <= 0 { return true; }
    let elapsed_ms: i64 = ((_pw_qpc_now() - start) * 1000) / freq;
    return elapsed_ms >= timeout_ms;
}

// `sfn_io_poll_readable(fd, timeout_ms)` — the `io.poll_readable` builtin
// (#1580) on Windows, over `PeekNamedPipe` rather than `poll(2)`.
//
// mingw has no `poll(2)` for stdio/pipe fds (`WSAPoll` covers sockets
// only), which is why this was a `return false` stub. That stub was not a
// safe degrade: `io.poll_readable` exists so bidirectional stdio
// forwarding can wait on `{own stdin, child stdout, child stderr}`
// together, and a permanent "not readable" makes such a caller wait on a
// stream that is never announced — `compiler/tests/integration/
// process_framed_stdio_test.sfn` hung to its 900-second per-file deadline
// on a native Windows host rather than failing.
//
// Timeout contract matches the POSIX body: `< 0` blocks until readable,
// `0` probes once and returns, `> 0` waits up to that many milliseconds.
// The wait is a 1 ms `Sleep` poll loop, the same shape (and the same
// reason) as `_pw_drain`'s idle sleep — Win32 offers no single wait that
// covers an anonymous pipe's byte availability.
fn sfn_io_poll_readable(fd: i64, timeout_ms: i64) -> bool ![io] {
    let h: i64 = _pw_fd_handle(fd);
    if h == 0 { return false; }
    if _pw_handle_readable_now(h) == 1 { return true; }
    if timeout_ms == 0 { return false; }
    let freq: i64 = _pw_qpc_freq();
    let start: i64 = _pw_qpc_now();
    loop {
        Sleep(1);
        if _pw_handle_readable_now(h) == 1 { return true; }
        if _pw_poll_deadline_exceeded(start, freq, timeout_ms) { return false; }
    }
}

// `sfn_io_poll_any(fds, timeout_ms)` — the multi-fd `io.poll_any` builtin
// (SFN-155) on Windows. Returns the READY FD (not its index), matching the
// POSIX body, or `-1` when none became ready within `timeout_ms`.
//
// Where POSIX arms every slot in one `poll(2)`, this scans the fds in
// order per round. The scan order is therefore a priority order — a
// permanently-hot fd early in the array can starve a later one — which
// `poll(2)` does not impose. Callers multiplexing a small fixed set
// (stdin/stdout/stderr) are unaffected because each is drained on every
// wake; a caller that cannot tolerate it should poll each fd itself.
//
// An fds array in which NOT ONE entry resolves to a handle returns `-1`
// immediately rather than sleeping out the timeout: there is nothing that
// could become ready, so waiting only delays the caller's error path.
fn sfn_io_poll_any(fds: int[], timeout_ms: i64) -> i64 ![io] {
    let n: i64 = fds.length;
    if n <= 0 { return -1; }
    let freq: i64 = _pw_qpc_freq();
    let start: i64 = _pw_qpc_now();
    loop {
        let mut any_handle: i64 = 0;
        let mut i: i64 = 0;
        loop {
            if i >= n { break; }
            let fd: i64 = fds[i];
            let h: i64 = _pw_fd_handle(fd);
            if h != 0 {
                any_handle = 1;
                if _pw_handle_readable_now(h) == 1 { return fd; }
            }
            i = i + 1;
        }
        if any_handle == 0 { return -1; }
        if timeout_ms == 0 { return -1; }
        Sleep(1);
        if _pw_poll_deadline_exceeded(start, freq, timeout_ms) { return -1; }
    }
}

// `sfn_process_exec(argv, env_flat)` — the `process.exec` re-exec primitive
// (SFN-199; consumed by toolchain dispatch, SFN-172) on Windows.
//
// Win32 has no `execve(2)`: no call replaces a running process image. What
// it has is spawn-wait-exit, and the OBSERVABLE contract `process.exec`
// actually carries is satisfiable that way — the child's exit code becomes
// the caller's, the child owns the parent's stdio, and control never returns
// to the code after the call. So this waits on the child and exits with its
// code instead of returning.
//
// Three ways it still diverges from `execve`, all of them stated rather than
// papered over:
//
//   * the parent process lives on, blocked in `WaitForSingleObject`, so a
//     dispatch chain costs one live process per hop rather than reusing one;
//   * `execve` keeps the process id, this does not — anything holding the
//     pre-exec pid (a job object, a supervisor) still sees the parent;
//   * POSIX signal pass-through has no Win32 counterpart. Console Ctrl-C
//     reaches both processes because they share a console group, which is
//     the behaviour that matters for an interactive dispatch, but a child
//     killed by `TerminateProcess` reports its exit code, not a signal.
//
// The failure contract is `execve`'s exactly: a return AT ALL means the exec
// did not happen, and the value is the `-1` sentinel. `CreateProcessA`
// failing to find the program is that case, and the toolchain dispatcher's
// actionable-error fallback still runs.
//
// The CRT `_exec*` family is deliberately not used. It is the same
// spawn-and-terminate emulation with less control — it terminates the parent
// immediately rather than waiting, so the child's exit code is LOST and the
// shell sees the parent's, which is the one property a dispatcher cannot
// give up.
fn sfn_process_exec(argv: string[], env_flat: string[]) -> int ![io] {
    let len: i64 = argv.length;
    if len <= 0 { return -1; }

    let cmdline: *u8 = _pw_build_cmdline(argv);
    if cmdline as i64 == 0 { return -1; }
    // Explicit environment, matching `execve`'s `envp`: an empty
    // `env_flat` means the EMPTY environment, never "inherit".
    let env_block: *u8 = _pw_build_env_block(env_flat);
    if env_block as i64 == 0 {
        free(cmdline);
        return -1;
    }

    // STARTUPINFOA: zeroed, `.cb = 104`.
    let si: *u8 = malloc(104 as usize);
    if si as i64 == 0 {
        free(cmdline);
        free(env_block);
        return -1;
    }
    memset(si, 0, 104 as usize);
    let si_view: *WinStartupInfo = si as *WinStartupInfo;
    si_view.cb = 104;

    // PROCESS_INFORMATION (24 bytes), zeroed.
    let pi: *u8 = malloc(24 as usize);
    if pi as i64 == 0 {
        free(cmdline);
        free(env_block);
        free(si);
        return -1;
    }
    memset(pi, 0, 24 as usize);

    // The child must own the parent's streams — that is what makes the
    // replacement look like one from the outside. Same inheritable-duplicate
    // discipline as `sfn_process_run` (SFN-546), taken under the same lock so
    // a concurrent `run_capture` cannot see these handles.
    _pw_lock_inheritable_spawn();
    let self_proc: i64 = GetCurrentProcess();
    let h_in: i64 = _pw_dup_inheritable(self_proc, GetStdHandle(-10));
    let h_out: i64 = _pw_dup_inheritable(self_proc, GetStdHandle(-11));
    let h_err: i64 = _pw_dup_inheritable(self_proc, GetStdHandle(-12));
    let mut inherit: i32 = 0;
    if h_in != 0 || h_out != 0 || h_err != 0 {
        let flags_view: *PwDword = (si as i64 + 60) as *PwDword;
        flags_view.v = 256;
        atomic_store((si as i64 + 80) as *i64, h_in);
        atomic_store((si as i64 + 88) as *i64, h_out);
        atomic_store((si as i64 + 96) as *i64, h_err);
        inherit = 1;
    }

    let app: *u8 = _pw_app_name(argv[0]);
    let ok: i32 = CreateProcessA(app, cmdline, null, null, inherit, 0, env_block, null, si, pi);
    free(cmdline);
    _pw_close_dup(h_in);
    _pw_close_dup(h_out);
    _pw_close_dup(h_err);
    _pw_unlock_inheritable_spawn();
    free(env_block);
    if ok == 0 {
        free(si);
        free(pi);
        return -1;
    }

    let h_process: i64 = atomic_load(pi as *i64);
    let h_thread: i64 = atomic_load((pi as i64 + 8) as *i64);

    // INFINITE = 0xFFFFFFFF, passed as i32 `-1` (same bit pattern; a hex
    // literal folds to 0 on the seed and would make the wait non-blocking,
    // racing the exit-code read).
    let _wait: i32 = WaitForSingleObject(h_process, -1);

    let mut code: i32 = 0;
    let code_ptr: *i32 = & code;
    let _got: i32 = GetExitCodeProcess(h_process, code_ptr);

    let _c1: i32 = CloseHandle(h_process);
    let _c2: i32 = CloseHandle(h_thread);
    free(si);
    free(pi);

    // Past this point the call has succeeded, so it must not return — a
    // return is the failure signal. Handles and heap are released above
    // rather than left to process teardown so the exit is clean under a
    // leak checker.
    exit(code);
    return -1;
}

// `sfn_process_environ()` — parses `GetEnvironmentStringsA`'s ANSI block
// into a real `SfnArray` of `"KEY=VALUE"` strings (SFN-498). Needed
// because `process.spawn_with_env(argv, env_flat)` takes an EXPLICIT
// environment — an empty array means the EMPTY environment, never
// "inherit" — so a caller reproducing inheritance passes
// `process.environ()` through verbatim. A perpetually-empty Windows
// result would silently drop `SystemRoot`, the only Windows leg of
// `build_host_os()` (`compiler/src/build/target.sfn:44`), making a child
// misdetect its host as Linux and emit the wrong platform legs.
//
// Header layout mirrors the POSIX `sfn_process_environ`
// (`runtime/sfn/process.sfn`): a malloc'd 24-byte `{ data@0, len@8,
// cap@16 }` SfnArray header, filled via the shared `sfn_array_push_string`
// helper. That helper stores the `char*` BY POINTER and does not copy
// (`runtime/sfn/process.sfn:130`), so each entry must be duplicated into
// its own allocation before it is pushed — exactly as the POSIX peer
// does. The `malloc` + `memcpy` below is therefore load-bearing, not
// redundant: dropping it would leave the returned array holding pointers
// into the block that `FreeEnvironmentStringsA` releases, turning every
// `process.environ()` call into a use-after-free of the whole
// environment.
//
// The block is a run of NUL-terminated `"KEY=VALUE"` entries, terminated
// by one extra NUL (two consecutive NUL bytes end the block). Entries
// starting with `=` (Windows per-drive cwd variables like `=C:`) are
// copied verbatim like any other entry — they are legitimate environment
// entries, and round-tripping them through `spawn_with_env` ->
// `_pw_build_env_block` -> `CreateProcess` keeps per-drive cwd semantics
// intact.
//
// Never returns null: if `GetEnvironmentStringsA` fails, or a mid-block
// allocation fails, the (possibly empty or partially filled) header built
// so far is returned so callers' `.length` reads do not crash — same
// contract as the prior stub.
fn sfn_process_environ() -> *u8 ![io] {
    let arr: *u8 = malloc(24 as usize);
    if arr as i64 == 0 { return arr; }
    memset(arr, 0, 24 as usize);
    let out: *u8 = arr;

    let block: *u8 = GetEnvironmentStringsA();
    if block as i64 == 0 { return out; }

    let base: i64 = block as i64;
    let mut off: i64 = 0;
    let mut guard: i64 = 0;
    loop {
        guard = guard + 1;
        if guard > 65536 { break; }
        let entry: *u8 = (base + off) as *u8;
        let n: i64 = strlen(entry) as i64;
        // A zero-length entry is the block's second (double-NUL) terminator.
        if n == 0 { break; }
        let copy: *u8 = malloc((n + 1) as usize);
        if copy as i64 == 0 { break; }
        memcpy(copy, entry, (n + 1) as usize);
        let pushed: *u8 = sfn_array_push_string(out, copy);
        if pushed as i64 == 0 {
            free(copy);
            break;
        }
        off = off + n + 1;
    }

    let _freed: i32 = FreeEnvironmentStringsA(block);
    return out;
}
