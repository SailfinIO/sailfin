// runtime/sfn/platform/tls_record.sfn
//
// TLS 1.3 record layer (RFC 8446 §5) in the runtime's `* u8` pointer idiom —
// the per-byte hot path of the native TLS stack (SFEP-0048 Phase D, SFN-768;
// design `docs/proposals/design-notes/sfn-341-native-tls-runtime-swap.md`
// §3.3).
//
// Why a second implementation. `runtime/sfn/crypto/tls13_record.sfn` (and its
// `capsules/sfn/crypto` original) express the same record layer over `int[]`.
// That idiom stores one byte per i64 array slot behind a bounds check — an 8x
// memory-traffic penalty before any arithmetic — and `tls13_open_record`
// additionally makes four full copies of every record's bytes. The handshake
// pays that cost once per connection and does not care; the record layer pays
// it per byte and does. Everything else in the native stack — key schedule,
// X25519, X.509, both handshake state machines — deliberately stays
// `int[]`-vendored.
//
// The `int[]` implementation stays the byte-exact differential oracle for this
// file: `compiler/tests/e2e/tls_record_pointer_differential_test.sfn` sweeps
// both against each other and against the RFC 8439 §2.8.2 AEAD vector.
//
// Idiom notes (the SFN-338 precedent, `runtime/sfn/adapters/websocket.sfn`):
//   * Sailfin exposes no pointer-store intrinsic, so every byte store is a
//     `memset(p, b, 1)` libc call. At `-O2` LLVM's InstCombine folds a
//     constant-length-1 `memset` into a single `store i8`; at `-O0` it stays a
//     real call, which is the dominant term in the `-O0` throughput figure.
//   * Byte loads use the `load_byte` builtin (a true `load i8` + `zext`,
//     `compiler/src/llvm/byte_load.sfn`) rather than the word-load
//     `sailfin_intrinsic_pointer_read_i32` the WebSocket helpers use. A true
//     i8 load is sound at any alignment and never reads past the buffer, so
//     callers owe this module no tail-slack over-allocation.
//   * File-local runtime helpers get external linkage, so every helper here
//     carries the `_tlsrec_` prefix to keep its symbol unique.
//   * This module is self-contained (its own `extern fn` declarations, no
//     cross-module import) per the SFN-635 runtime convention.
//
// Integer discipline: all arithmetic is on signed i64. 32-bit words are kept
// masked to `[0, 2^32)` and Poly1305 limbs to `[0, 2^26)`, so every `>>` acts
// as a logical shift and no intermediate product exceeds 2^59. There is
// exactly one deliberate exception — the `g4 >> 63` sign test in
// `_tlsrec_poly1305_tag`'s final reduction, whose operand may be negative;
// it is written so that it holds under either `ashr` or `lshr` (see the
// comment there).
extern fn malloc(size: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

extern fn memset(ptr: *u8, value: i32, n: usize) -> *u8;

// ── Fail-closed result codes ─────────────────────────────────────
// Every code maps 1:1 onto a guard in the `int[]` oracle, so a differential
// test can assert that both implementations reject the same input at the same
// point. Seal returns `[]` for its guards; open returns a `Result.Err` whose
// message is quoted beside each code below.
//
//   -1  bad key length                      (seal + open)
//   -2  bad iv length                       (seal + open)
//   -3  negative padding                    (seal)
//   -4  content length out of range        (seal: content > 2^14, or negative
//                                          — a caller bug with no oracle
//                                          analogue, since `int[].length`
//                                          cannot be negative; open:
//                                          recovered content > 2^14)
//   -5  record overflow                     (encrypted_record > 2^14 + 256)
//   -6  short record header                 (open)
//   -7  unexpected outer content type       (open)
//   -8  length mismatch                     (open)
//   -9  encrypted_record shorter than tag   (open)
//   -10 authentication failed               (open)
//   -11 no content type (all-zero plaintext) (open)
//   -12 out of memory                       (no oracle analogue)
fn sfn_tls_record_err_bad_key_length() -> i64 { return 0 - 1; }

fn sfn_tls_record_err_bad_iv_length() -> i64 { return 0 - 2; }

fn sfn_tls_record_err_negative_padding() -> i64 { return 0 - 3; }

fn sfn_tls_record_err_content_overflow() -> i64 { return 0 - 4; }

fn sfn_tls_record_err_record_overflow() -> i64 { return 0 - 5; }

fn sfn_tls_record_err_short_header() -> i64 { return 0 - 6; }

fn sfn_tls_record_err_unexpected_type() -> i64 { return 0 - 7; }

fn sfn_tls_record_err_length_mismatch() -> i64 { return 0 - 8; }

fn sfn_tls_record_err_short_encrypted_record() -> i64 { return 0 - 9; }

fn sfn_tls_record_err_auth_failed() -> i64 { return 0 - 10; }

fn sfn_tls_record_err_no_content_type() -> i64 { return 0 - 11; }

fn sfn_tls_record_err_oom() -> i64 { return 0 - 12; }

// ── Constants (RFC 8446 §5) ──────────────────────────────────────
// ContentType application_data(23): the outer opaque_type of every TLS 1.3
// TLSCiphertext. The real content type travels inside the encrypted
// TLSInnerPlaintext.
fn sfn_tls_record_application_data() -> i64 { return 23; }

// Poly1305 tag length appended by the AEAD (RFC 8439 §2.8).
fn sfn_tls_record_tag_len() -> i64 { return 16; }

// Maximum TLSPlaintext.fragment / decrypted content length, 2^14 (§5.1).
fn sfn_tls_record_max_plaintext() -> i64 { return 16384; }

// Maximum TLSCiphertext.encrypted_record length, 2^14 + 256 (§5.2).
fn sfn_tls_record_max_encrypted() -> i64 { return 16640; }

// ── Byte-level helpers ───────────────────────────────────────────
// Byte-stride pointer arithmetic for a variable offset.
fn _tlsrec_ptr_off(p: *u8, off: i64) -> *u8 {
    let addr: i64 = (p as i64) + off;
    return addr as *u8;
}

// Read the byte at `base + off` as 0..255 via a true i8 load.
fn _tlsrec_at(base: *u8, off: i64) -> i64 {
    return load_byte((base as i64) + off) & 255;
}

// Store the low byte of `b` at `dst + off`. The only pointer-store primitive
// Sailfin exposes is `memset`; length 1 folds to `store i8` at `-O2`.
fn _tlsrec_put(dst: *u8, off: i64, b: i64) -> void {
    memset(_tlsrec_ptr_off(dst, off), (b & 255) as i32, 1 as usize);
}

// Load a little-endian 32-bit word from `p + off`.
fn _tlsrec_le32(p: *u8, off: i64) -> i64 {
    return (_tlsrec_at(p, off) | (_tlsrec_at(p, off + 1) << 8) | (_tlsrec_at(p, off
        + 2) << 16) | (_tlsrec_at(p, off
        + 3) << 24)) & 4294967295;
}

// Store the low 32 bits of `w` little-endian at `dst + off`.
fn _tlsrec_put_le32(dst: *u8, off: i64, w: i64) -> void {
    _tlsrec_put(dst, off, w);
    _tlsrec_put(dst, off + 1, w >> 8);
    _tlsrec_put(dst, off + 2, w >> 16);
    _tlsrec_put(dst, off + 3, w >> 24);
}

// Store `n` little-endian in 8 bytes at `dst + off` (the AEAD length trailer).
fn _tlsrec_put_le64(dst: *u8, off: i64, n: i64) -> void {
    let mut i: i64 = 0;
    loop {
        if i >= 8 { break; }
        _tlsrec_put(dst, off + i, (n >> (8 * i)) & 255);
        i = i + 1;
    }
}

// Rotate the low 32 bits of `x` left by `n` (0 < n < 32).
fn _tlsrec_rotl32(x: i64, n: i64) -> i64 {
    let v: i64 = x & 4294967295;
    return ((v << n) | (v >> (32 - n))) & 4294967295;
}

// Constant-time equality over 16 bytes: fold every difference into one
// accumulator so the comparison never short-circuits on the first mismatch.
fn _tlsrec_ct_eq16(a: *u8, a_off: i64, b: *u8, b_off: i64) -> bool {
    let mut diff: i64 = 0;
    let mut i: i64 = 0;
    loop {
        if i >= 16 { break; }
        diff = diff | (_tlsrec_at(a, a_off + i) ^ _tlsrec_at(b, b_off + i));
        i = i + 1;
    }
    return diff == 0;
}

// ── ChaCha20 (RFC 8439 §2.3) ─────────────────────────────────────
// XOR four keystream bytes — the little-endian bytes of the 32-bit word `w` —
// into `dst[off .. off+4)` from `src[off .. off+4)`, stopping at `len`. This
// is the sole per-byte store in the cipher: the 16 state words stay in
// registers for the whole 20-round core and are consumed 4 bytes at a time
// here, so no 64-byte keystream buffer is ever materialized.
fn _tlsrec_xor4(src: *u8, dst: *u8, off: i64, len: i64, w: i64) -> void {
    let mut j: i64 = 0;
    loop {
        if j >= 4 { break; }
        let o: i64 = off + j;
        if o >= len { break; }
        _tlsrec_put(dst, o, _tlsrec_at(src, o) ^ ((w >> (8 * j)) & 255));
        j = j + 1;
    }
}

// ChaCha20-XOR `len` bytes of `src` into `dst` under the 32-byte `key` and
// 12-byte `nonce`, starting at block counter `counter0`. `src` and `dst` may
// be the same pointer (the in-place decrypt path). Keystream generation is
// register-resident: 16 `i64` locals hold the working state across all 10
// double rounds, which is what keeps the `int[]` idiom's ~15 bounds-checked
// array operations per byte off the hot path entirely.
fn _tlsrec_chacha_apply(key: *u8, nonce: *u8, counter0: i64, src: *u8, dst: *u8, len: i64) -> void {
    let m: i64 = 4294967295;
    // "expand 32-byte k" as four little-endian words.
    let c0: i64 = 1634760805;
    let c1: i64 = 857760878;
    let c2: i64 = 2036477234;
    let c3: i64 = 1797285236;
    let k0: i64 = _tlsrec_le32(key, 0);
    let k1: i64 = _tlsrec_le32(key, 4);
    let k2: i64 = _tlsrec_le32(key, 8);
    let k3: i64 = _tlsrec_le32(key, 12);
    let k4: i64 = _tlsrec_le32(key, 16);
    let k5: i64 = _tlsrec_le32(key, 20);
    let k6: i64 = _tlsrec_le32(key, 24);
    let k7: i64 = _tlsrec_le32(key, 28);
    let n0: i64 = _tlsrec_le32(nonce, 0);
    let n1: i64 = _tlsrec_le32(nonce, 4);
    let n2: i64 = _tlsrec_le32(nonce, 8);
    let mut ctr: i64 = counter0 & m;
    let mut off: i64 = 0;
    loop {
        if off >= len { break; }
        let mut x0: i64 = c0;
        let mut x1: i64 = c1;
        let mut x2: i64 = c2;
        let mut x3: i64 = c3;
        let mut x4: i64 = k0;
        let mut x5: i64 = k1;
        let mut x6: i64 = k2;
        let mut x7: i64 = k3;
        let mut x8: i64 = k4;
        let mut x9: i64 = k5;
        let mut x10: i64 = k6;
        let mut x11: i64 = k7;
        let mut x12: i64 = ctr;
        let mut x13: i64 = n0;
        let mut x14: i64 = n1;
        let mut x15: i64 = n2;
        let mut r: i64 = 0;
        loop {
            if r >= 10 { break; }
            // Column round: QR(0,4,8,12) QR(1,5,9,13) QR(2,6,10,14) QR(3,7,11,15)
            x0 = (x0 + x4) & m;
            x12 = _tlsrec_rotl32(x12 ^ x0, 16);
            x8 = (x8 + x12) & m;
            x4 = _tlsrec_rotl32(x4 ^ x8, 12);
            x0 = (x0 + x4) & m;
            x12 = _tlsrec_rotl32(x12 ^ x0, 8);
            x8 = (x8 + x12) & m;
            x4 = _tlsrec_rotl32(x4 ^ x8, 7);

            x1 = (x1 + x5) & m;
            x13 = _tlsrec_rotl32(x13 ^ x1, 16);
            x9 = (x9 + x13) & m;
            x5 = _tlsrec_rotl32(x5 ^ x9, 12);
            x1 = (x1 + x5) & m;
            x13 = _tlsrec_rotl32(x13 ^ x1, 8);
            x9 = (x9 + x13) & m;
            x5 = _tlsrec_rotl32(x5 ^ x9, 7);

            x2 = (x2 + x6) & m;
            x14 = _tlsrec_rotl32(x14 ^ x2, 16);
            x10 = (x10 + x14) & m;
            x6 = _tlsrec_rotl32(x6 ^ x10, 12);
            x2 = (x2 + x6) & m;
            x14 = _tlsrec_rotl32(x14 ^ x2, 8);
            x10 = (x10 + x14) & m;
            x6 = _tlsrec_rotl32(x6 ^ x10, 7);

            x3 = (x3 + x7) & m;
            x15 = _tlsrec_rotl32(x15 ^ x3, 16);
            x11 = (x11 + x15) & m;
            x7 = _tlsrec_rotl32(x7 ^ x11, 12);
            x3 = (x3 + x7) & m;
            x15 = _tlsrec_rotl32(x15 ^ x3, 8);
            x11 = (x11 + x15) & m;
            x7 = _tlsrec_rotl32(x7 ^ x11, 7);

            // Diagonal round: QR(0,5,10,15) QR(1,6,11,12) QR(2,7,8,13) QR(3,4,9,14)
            x0 = (x0 + x5) & m;
            x15 = _tlsrec_rotl32(x15 ^ x0, 16);
            x10 = (x10 + x15) & m;
            x5 = _tlsrec_rotl32(x5 ^ x10, 12);
            x0 = (x0 + x5) & m;
            x15 = _tlsrec_rotl32(x15 ^ x0, 8);
            x10 = (x10 + x15) & m;
            x5 = _tlsrec_rotl32(x5 ^ x10, 7);

            x1 = (x1 + x6) & m;
            x12 = _tlsrec_rotl32(x12 ^ x1, 16);
            x11 = (x11 + x12) & m;
            x6 = _tlsrec_rotl32(x6 ^ x11, 12);
            x1 = (x1 + x6) & m;
            x12 = _tlsrec_rotl32(x12 ^ x1, 8);
            x11 = (x11 + x12) & m;
            x6 = _tlsrec_rotl32(x6 ^ x11, 7);

            x2 = (x2 + x7) & m;
            x13 = _tlsrec_rotl32(x13 ^ x2, 16);
            x8 = (x8 + x13) & m;
            x7 = _tlsrec_rotl32(x7 ^ x8, 12);
            x2 = (x2 + x7) & m;
            x13 = _tlsrec_rotl32(x13 ^ x2, 8);
            x8 = (x8 + x13) & m;
            x7 = _tlsrec_rotl32(x7 ^ x8, 7);

            x3 = (x3 + x4) & m;
            x14 = _tlsrec_rotl32(x14 ^ x3, 16);
            x9 = (x9 + x14) & m;
            x4 = _tlsrec_rotl32(x4 ^ x9, 12);
            x3 = (x3 + x4) & m;
            x14 = _tlsrec_rotl32(x14 ^ x3, 8);
            x9 = (x9 + x14) & m;
            x4 = _tlsrec_rotl32(x4 ^ x9, 7);
            r = r + 1;
        }
        _tlsrec_xor4(src, dst, off, len, (x0 + c0) & m);
        _tlsrec_xor4(src, dst, off + 4, len, (x1 + c1) & m);
        _tlsrec_xor4(src, dst, off + 8, len, (x2 + c2) & m);
        _tlsrec_xor4(src, dst, off + 12, len, (x3 + c3) & m);
        _tlsrec_xor4(src, dst, off + 16, len, (x4 + k0) & m);
        _tlsrec_xor4(src, dst, off + 20, len, (x5 + k1) & m);
        _tlsrec_xor4(src, dst, off + 24, len, (x6 + k2) & m);
        _tlsrec_xor4(src, dst, off + 28, len, (x7 + k3) & m);
        _tlsrec_xor4(src, dst, off + 32, len, (x8 + k4) & m);
        _tlsrec_xor4(src, dst, off + 36, len, (x9 + k5) & m);
        _tlsrec_xor4(src, dst, off + 40, len, (x10 + k6) & m);
        _tlsrec_xor4(src, dst, off + 44, len, (x11 + k7) & m);
        _tlsrec_xor4(src, dst, off + 48, len, (x12 + ctr) & m);
        _tlsrec_xor4(src, dst, off + 52, len, (x13 + n0) & m);
        _tlsrec_xor4(src, dst, off + 56, len, (x14 + n1) & m);
        _tlsrec_xor4(src, dst, off + 60, len, (x15 + n2) & m);
        off = off + 64;
        ctr = (ctr + 1) & m;
    }
}

// ── Poly1305 (RFC 8439 §2.5) over the AEAD construction (§2.8) ────
// Compute the 16-byte tag of `aad ‖ pad16(aad) ‖ ct ‖ pad16(ct) ‖ le64(|aad|)
// ‖ le64(|ct|)` under the 32-byte one-time key `otk`, writing it to
// `tag_out[0..16)`.
//
// The padded construction is a whole number of 16-byte blocks by definition,
// so every block is a "full" block and the 2^128 bit always lands as `+2^24`
// in limb 4 — the `int[]` oracle's general `bit_pos / 26` case collapses away.
// That lets the bulk of the message stream straight off the `ct` pointer with
// no concatenation buffer: only the two short region tails and the length
// trailer are staged, in the caller-owned 48-byte `scratch`.
//
// `scratch` layout: [0,16) padded aad tail, [16,32) padded ct tail,
// [32,48) the le64 length trailer.
//
// Limb magnitudes: h_i < 2^27 after a block add and r_i < 2^26 after clamping,
// so each of the five products d_i sums to under 5 * 2^27 * 2^29 < 2^59 and
// stays well inside i64.
fn _tlsrec_poly1305_tag(otk: *u8, aad: *u8, aad_len: i64, ct: *u8, ct_len: i64, scratch: *u8, tag_out: *u8) -> void {
    let mask: i64 = 67108863;  // 2^26 - 1, the limb mask
    memset(scratch, 0, 48 as usize);
    let aad_full: i64 = aad_len / 16;
    let aad_rem: i64 = aad_len - aad_full * 16;
    if aad_rem > 0 {
        memcpy(scratch, _tlsrec_ptr_off(aad, aad_full * 16), aad_rem as usize);
    }
    let ct_full: i64 = ct_len / 16;
    let ct_rem: i64 = ct_len - ct_full * 16;
    if ct_rem > 0 {
        memcpy(_tlsrec_ptr_off(scratch, 16), _tlsrec_ptr_off(ct, ct_full * 16), ct_rem as usize);
    }
    _tlsrec_put_le64(scratch, 32, aad_len);
    _tlsrec_put_le64(scratch, 40, ct_len);

    // Clamp r per RFC 8439 §2.5.1, then split the clamped words into limbs.
    let t0: i64 = _tlsrec_le32(otk, 0) & 268435455;
    let t1: i64 = _tlsrec_le32(otk, 4) & 268435452;
    let t2: i64 = _tlsrec_le32(otk, 8) & 268435452;
    let t3: i64 = _tlsrec_le32(otk, 12) & 268435452;
    let r0: i64 = t0 & mask;
    let r1: i64 = ((t0 >> 26) | (t1 << 6)) & mask;
    let r2: i64 = ((t1 >> 20) | (t2 << 12)) & mask;
    let r3: i64 = ((t2 >> 14) | (t3 << 18)) & mask;
    let r4: i64 = (t3 >> 8) & mask;
    let v1: i64 = r1 * 5;
    let v2: i64 = r2 * 5;
    let v3: i64 = r3 * 5;
    let v4: i64 = r4 * 5;

    let mut h0: i64 = 0;
    let mut h1: i64 = 0;
    let mut h2: i64 = 0;
    let mut h3: i64 = 0;
    let mut h4: i64 = 0;

    // Five regions, in AEAD order. Each contributes whole 16-byte blocks, so
    // the accumulate below is written exactly once.
    let mut region: i64 = 0;
    loop {
        if region >= 5 { break; }
        let mut rp: i64 = 0;
        let mut rn: i64 = 0;
        if region == 0 {
            rp = aad as i64;
            rn = aad_full;
        } else if region == 1 {
            rp = scratch as i64;
            if aad_rem > 0 { rn = 1; }
        } else if region == 2 {
            rp = ct as i64;
            rn = ct_full;
        } else if region == 3 {
            rp = (scratch as i64) + 16;
            if ct_rem > 0 { rn = 1; }
        } else {
            rp = (scratch as i64) + 32;
            rn = 1;
        }
        let base: *u8 = rp as *u8;
        let mut b: i64 = 0;
        loop {
            if b >= rn { break; }
            let o: i64 = b * 16;
            let w0: i64 = _tlsrec_le32(base, o);
            let w1: i64 = _tlsrec_le32(base, o + 4);
            let w2: i64 = _tlsrec_le32(base, o + 8);
            let w3: i64 = _tlsrec_le32(base, o + 12);
            // Add the block, with the 2^128 bit as +2^24 in limb 4.
            h0 = h0 + (w0 & mask);
            h1 = h1 + (((w0 >> 26) | (w1 << 6)) & mask);
            h2 = h2 + (((w1 >> 20) | (w2 << 12)) & mask);
            h3 = h3 + (((w2 >> 14) | (w3 << 18)) & mask);
            h4 = h4 + ((w3 >> 8) & mask) + 16777216;
            // h = (h * r) mod (2^130 - 5)
            let d0: i64 = h0 * r0 + h1 * v4 + h2 * v3 + h3 * v2 + h4 * v1;
            let d1: i64 = h0 * r1 + h1 * r0 + h2 * v4 + h3 * v3 + h4 * v2;
            let d2: i64 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * v4 + h4 * v3;
            let d3: i64 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * v4;
            let d4: i64 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0;
            let mut c: i64 = d0 >> 26;
            h0 = d0 & mask;
            let e1: i64 = d1 + c;
            c = e1 >> 26;
            h1 = e1 & mask;
            let e2: i64 = d2 + c;
            c = e2 >> 26;
            h2 = e2 & mask;
            let e3: i64 = d3 + c;
            c = e3 >> 26;
            h3 = e3 & mask;
            let e4: i64 = d4 + c;
            c = e4 >> 26;
            h4 = e4 & mask;
            h0 = h0 + c * 5;
            c = h0 >> 26;
            h0 = h0 & mask;
            h1 = h1 + c;
            b = b + 1;
        }
        region = region + 1;
    }

    // Fully carry h.
    let mut c: i64 = h1 >> 26;
    h1 = h1 & mask;
    h2 = h2 + c;
    c = h2 >> 26;
    h2 = h2 & mask;
    h3 = h3 + c;
    c = h3 >> 26;
    h3 = h3 & mask;
    h4 = h4 + c;
    c = h4 >> 26;
    h4 = h4 & mask;
    h0 = h0 + c * 5;
    c = h0 >> 26;
    h0 = h0 & mask;
    h1 = h1 + c;

    // g = h + 5; if g overflows 2^130 then h >= p and g is the reduced value.
    let g0: i64 = h0 + 5;
    let mut gc: i64 = g0 >> 26;
    let g0m: i64 = g0 & mask;
    let g1: i64 = h1 + gc;
    gc = g1 >> 26;
    let g1m: i64 = g1 & mask;
    let g2: i64 = h2 + gc;
    gc = g2 >> 26;
    let g2m: i64 = g2 & mask;
    let g3: i64 = h3 + gc;
    gc = g3 >> 26;
    let g3m: i64 = g3 & mask;
    let g4: i64 = h4 + gc - 67108864;

    // Branch-free select: `g4 < 0` means h < p, so keep h; otherwise take g.
    // `g4` is the one value in this file that reaches a `>>` while possibly
    // negative, so the sign bit is extracted with `& 1` and re-expanded into a
    // mask. That spelling is correct whether `>>` lowers to `ashr` or `lshr`,
    // matching the oracle's rationale in `poly1305.sfn`. This branch is taken
    // only when the accumulator lands in [2^130 - 5, 2^130), which no test can
    // reach, so it must be right by construction rather than by coverage.
    let keep_h: i64 = 0 - ((g4 >> 63) & 1);
    let take_g: i64 = 0 - 1 - keep_h;
    h0 = (h0 & keep_h) | (g0m & take_g);
    h1 = (h1 & keep_h) | (g1m & take_g);
    h2 = (h2 & keep_h) | (g2m & take_g);
    h3 = (h3 & keep_h) | (g3m & take_g);
    h4 = (h4 & keep_h) | ((g4 & mask) & take_g);

    // Repack the limbs into four 32-bit words, then add s and serialize.
    let w32: i64 = 4294967295;
    let p0: i64 = (h0 | (h1 << 26)) & w32;
    let p1: i64 = ((h1 >> 6) | (h2 << 20)) & w32;
    let p2: i64 = ((h2 >> 12) | (h3 << 14)) & w32;
    let p3: i64 = ((h3 >> 18) | (h4 << 8)) & w32;
    let mut f: i64 = p0 + _tlsrec_le32(otk, 16);
    _tlsrec_put_le32(tag_out, 0, f & w32);
    f = p1 + _tlsrec_le32(otk, 20) + (f >> 32);
    _tlsrec_put_le32(tag_out, 4, f & w32);
    f = p2 + _tlsrec_le32(otk, 24) + (f >> 32);
    _tlsrec_put_le32(tag_out, 8, f & w32);
    f = p3 + _tlsrec_le32(otk, 28) + (f >> 32);
    _tlsrec_put_le32(tag_out, 12, f & w32);
}

// ── AEAD algorithm selector (SFN-817) ────────────────────────────
// Local identifiers, matching `capsules/sfn/crypto/src/aead.sfn`'s registry
// value-for-value so a caller can pass `aead_chacha20_poly1305()` /
// `aead_aes_128_gcm()` / `aead_aes_256_gcm()` straight through — `int` and
// `i64` are the same type (`docs/style-guide.md`), so no cast is needed.
//
// Why this dispatch has to reach the cipher core rather than stopping at a
// key-length check: AES-256-GCM's key is also 32 bytes, the same length
// ChaCha20-Poly1305 uses. SFN-814 left `key_len != 32` as the sole guard
// deliberately, because loosening it alone would let a 32-byte AES-256-GCM
// key pass length validation and then run through ChaCha20 — a mismatch
// that fails at the peer as a bad tag, not here. Deriving the required key
// length from `alg`, and branching on `alg` again at the point the cipher is
// actually chosen, is what SFN-339 fixed in `aead.sfn` for the same class of
// bug; this mirrors it in the pointer layer.
fn _tlsrec_alg_chacha20_poly1305() -> i64 { return 1; }

fn _tlsrec_alg_aes_128_gcm() -> i64 { return 2; }

fn _tlsrec_alg_aes_256_gcm() -> i64 { return 3; }

// The key length an algorithm identifier requires, or 0 for an unknown one.
fn _tlsrec_alg_key_len(alg: i64) -> i64 {
    if alg == _tlsrec_alg_chacha20_poly1305() { return 32; }
    if alg == _tlsrec_alg_aes_128_gcm() { return 16; }
    if alg == _tlsrec_alg_aes_256_gcm() { return 32; }
    return 0;
}

// ── AES (FIPS-197), bitsliced over registers ──────────────────────
// Table-free forward AES-128/256, ported from the `int[]` reference in
// `capsules/sfn/crypto/src/aes_sbox.sfn` / `aes.sfn` (SFN-339 design gate,
// `docs/proposals/design-notes/sfn-339-aes-gcm-strategy.md`) into this file's
// `*u8` scratch-buffer idiom. GCM only ever runs AES forward (CTR mode), so
// InvSubBytes/InvMixColumns stay absent by design, same as the oracle.
//
// Representation is unchanged from the oracle: 8 words, word j bit k holding
// bit j of state byte k, bytes 0..15 the first of two packed 16-byte blocks
// and 16..31 the second — every AES core call processes two blocks, which is
// what amortizes the bitsliced S-box's cost. A "word" here is a 32-bit value
// held in an `i64` and stored/loaded 4 bytes little-endian at a time via
// `_tlsrec_le32`/`_tlsrec_put_le32`, so the oracle's `int[]` slot indices
// become byte offsets into one caller-owned scratch buffer (`_tlsrec_gw`/
// `_tlsrec_pw` below) instead of array pushes — the allocation pattern the
// oracle's header names as the reason a returning, array-per-step form
// measured 0.2 MB/s / 5.4 GB RSS before that fix.
//
// Workspace layout (byte offsets into one `*u8` buffer, `_tlsrec_aesws_bytes()`
// long): the 8-word cipher state, a 32-byte key-schedule/single-block-encrypt
// scratch, and the three regions CTR streaming needs (running counter, the
// two-block counter pair fed to the cipher core, and its keystream output).
// There is deliberately no separate GF-operation scratch slot: the S-box
// below computes entirely in local scalars (see its header comment).
fn _tlsrec_aes_state() -> i64 { return 0; }

fn _tlsrec_aes_dup() -> i64 { return 32; }

fn _tlsrec_aes_ctrw() -> i64 { return 64; }

fn _tlsrec_aes_pair() -> i64 { return 80; }

fn _tlsrec_aes_ks() -> i64 { return 112; }

fn _tlsrec_aesws_bytes() -> i64 { return 144; }

// Load/store word `j` of slot `slot` in workspace `ws` as a little-endian
// 32-bit value. The endianness is an internal convention private to this
// workspace — GCM's bit-sliced state carries no wire meaning of its own —
// so any consistent choice is correct; little-endian matches the rest of
// this file's word helpers.
fn _tlsrec_gw(ws: *u8, slot: i64, j: i64) -> i64 {
    return _tlsrec_le32(ws, slot + 4 * j);
}

fn _tlsrec_pw(ws: *u8, slot: i64, j: i64, v: i64) -> void {
    _tlsrec_put_le32(ws, slot + 4 * j, v);
}

// Apply the S-box to all 32 lanes of `state`, in place: `sbox(x) =
// affine(x^254)` over GF(2^8), the same inversion chain as
// `aes_sbox.sfn::_gf_inv_a` (7 squarings, 4 multiplies) plus its affine map,
// but with every intermediate GF(2^8) value held in a local `i64` rather
// than a workspace slot.
//
// `aes_sbox.sfn`'s buffer form (`_gf_mul`/`_gf_sqr`/`_gf_reduce` reading and
// writing `ws` through `_tlsrec_gw`/`_tlsrec_pw`) is a faithful port of the
// `int[]` oracle, but every one of those buffer accesses is real memory
// traffic: `ws` is heap memory from `malloc`, never a stack `alloca`, so
// LLVM's SROA/mem2reg cannot promote it to registers the way it promotes a
// stack local, which is why ChaCha20's round function (`_tlsrec_chacha_apply`
// above) stays register-resident for its whole 20-round core. A first cut wired that
// buffer form directly into this file and measured *slower* than the
// capsule's own `int[]` throughput ceiling despite the pointer idiom —
// the S-box's ~300 buffer operations per call (one 8x8 multiply alone
// zeroes and re-touches 15 words, twice per multiply, four multiplies and
// seven squarings per inversion) dominated everything else. Multiplication
// and squaring are exactly the fixed formulas `_gf_mul`/`_gf_sqr` compute —
// XOR-linear for squaring, XOR of 8x8 AND terms for multiplication, per
// `aes_sbox.sfn`'s own algebra — so the chain below inlines each step as a
// closed-form scalar expression instead of a function call over a buffer.
// The formulas were generated from the buffer-form algebra rather than
// re-derived by hand; their correctness rests on this file's byte-identity
// differential against the capsule oracle
// (`compiler/tests/e2e/tls_record_pointer_differential_test.sfn`'s
// AES-128-GCM sweep), which is itself anchored to SP 800-38D GCM test cases
// 1-4/13/14/16 for both key sizes
// (`capsules/sfn/crypto/tests/aead_aes_gcm_test.sfn`) — not on a script kept
// outside this tree. Only the entry (8 reads) and exit (8 writes) touch
// `ws` at all, replacing on the order of 700 buffer operations with 16.
fn _tlsrec_bs_sbox(ws: *u8, state: i64) -> void {
    let a0: i64 = _tlsrec_gw(ws, state, 0);
    let a1: i64 = _tlsrec_gw(ws, state, 1);
    let a2: i64 = _tlsrec_gw(ws, state, 2);
    let a3: i64 = _tlsrec_gw(ws, state, 3);
    let a4: i64 = _tlsrec_gw(ws, state, 4);
    let a5: i64 = _tlsrec_gw(ws, state, 5);
    let a6: i64 = _tlsrec_gw(ws, state, 6);
    let a7: i64 = _tlsrec_gw(ws, state, 7);

    let x2_0: i64 = a0 ^ a4 ^ a6;
    let x2_1: i64 = a4 ^ a6 ^ a7;
    let x2_2: i64 = a1 ^ a5;
    let x2_3: i64 = a4 ^ a5 ^ a6 ^ a7;
    let x2_4: i64 = a2 ^ a4 ^ a7;
    let x2_5: i64 = a5 ^ a6;
    let x2_6: i64 = a3 ^ a5;
    let x2_7: i64 = a6 ^ a7;

    let x3_0: i64 = (x2_0 & a0) ^ (x2_1 & a7) ^ (x2_2 & a6) ^ (x2_3 & a5) ^ (x2_4 & a4) ^ (x2_5 & a3) ^ (x2_5 & a7) ^ (x2_6 & a2) ^ (x2_6 & a6) ^ (x2_6 & a7) ^ (x2_7 & a1) ^ (x2_7 & a5) ^ (x2_7 & a6);
    let x3_1: i64 = (x2_0 & a1) ^ (x2_1 & a0) ^ (x2_1 & a7) ^ (x2_2 & a6) ^ (x2_2 & a7) ^ (x2_3 & a5) ^ (x2_3 & a6) ^ (x2_4 & a4) ^ (x2_4 & a5) ^ (x2_5 & a3) ^ (x2_5 & a4) ^ (x2_5 & a7) ^ (x2_6 & a2) ^ (x2_6 & a3) ^ (x2_6 & a6) ^ (x2_7 & a1) ^ (x2_7 & a2) ^ (x2_7 & a5) ^ (x2_7 & a7);
    let x3_2: i64 = (x2_0 & a2) ^ (x2_1 & a1) ^ (x2_2 & a0) ^ (x2_2 & a7) ^ (x2_3 & a6) ^ (x2_3 & a7) ^ (x2_4 & a5) ^ (x2_4 & a6) ^ (x2_5 & a4) ^ (x2_5 & a5) ^ (x2_6 & a3) ^ (x2_6 & a4) ^ (x2_6 & a7) ^ (x2_7 & a2) ^ (x2_7 & a3) ^ (x2_7 & a6);
    let x3_3: i64 = (x2_0 & a3) ^ (x2_1 & a2) ^ (x2_1 & a7) ^ (x2_2 & a1) ^ (x2_2 & a6) ^ (x2_3 & a0) ^ (x2_3 & a5) ^ (x2_3 & a7) ^ (x2_4 & a4) ^ (x2_4 & a6) ^ (x2_4 & a7) ^ (x2_5 & a3) ^ (x2_5 & a5) ^ (x2_5 & a6) ^ (x2_5 & a7) ^ (x2_6 & a2) ^ (x2_6 & a4) ^ (x2_6 & a5) ^ (x2_6 & a6) ^ (x2_6 & a7) ^ (x2_7 & a1) ^ (x2_7 & a3) ^ (x2_7 & a4) ^ (x2_7 & a5) ^ (x2_7 & a6) ^ (x2_7 & a7);
    let x3_4: i64 = (x2_0 & a4) ^ (x2_1 & a3) ^ (x2_1 & a7) ^ (x2_2 & a2) ^ (x2_2 & a6) ^ (x2_2 & a7) ^ (x2_3 & a1) ^ (x2_3 & a5) ^ (x2_3 & a6) ^ (x2_4 & a0) ^ (x2_4 & a4) ^ (x2_4 & a5) ^ (x2_4 & a7) ^ (x2_5 & a3) ^ (x2_5 & a4) ^ (x2_5 & a6) ^ (x2_6 & a2) ^ (x2_6 & a3) ^ (x2_6 & a5) ^ (x2_7 & a1) ^ (x2_7 & a2) ^ (x2_7 & a4) ^ (x2_7 & a7);
    let x3_5: i64 = (x2_0 & a5) ^ (x2_1 & a4) ^ (x2_2 & a3) ^ (x2_2 & a7) ^ (x2_3 & a2) ^ (x2_3 & a6) ^ (x2_3 & a7) ^ (x2_4 & a1) ^ (x2_4 & a5) ^ (x2_4 & a6) ^ (x2_5 & a0) ^ (x2_5 & a4) ^ (x2_5 & a5) ^ (x2_5 & a7) ^ (x2_6 & a3) ^ (x2_6 & a4) ^ (x2_6 & a6) ^ (x2_7 & a2) ^ (x2_7 & a3) ^ (x2_7 & a5);
    let x3_6: i64 = (x2_0 & a6) ^ (x2_1 & a5) ^ (x2_2 & a4) ^ (x2_3 & a3) ^ (x2_3 & a7) ^ (x2_4 & a2) ^ (x2_4 & a6) ^ (x2_4 & a7) ^ (x2_5 & a1) ^ (x2_5 & a5) ^ (x2_5 & a6) ^ (x2_6 & a0) ^ (x2_6 & a4) ^ (x2_6 & a5) ^ (x2_6 & a7) ^ (x2_7 & a3) ^ (x2_7 & a4) ^ (x2_7 & a6);
    let x3_7: i64 = (x2_0 & a7) ^ (x2_1 & a6) ^ (x2_2 & a5) ^ (x2_3 & a4) ^ (x2_4 & a3) ^ (x2_4 & a7) ^ (x2_5 & a2) ^ (x2_5 & a6) ^ (x2_5 & a7) ^ (x2_6 & a1) ^ (x2_6 & a5) ^ (x2_6 & a6) ^ (x2_7 & a0) ^ (x2_7 & a4) ^ (x2_7 & a5) ^ (x2_7 & a7);

    let t_0: i64 = x3_0 ^ x3_4 ^ x3_6;
    let t_1: i64 = x3_4 ^ x3_6 ^ x3_7;
    let t_2: i64 = x3_1 ^ x3_5;
    let t_3: i64 = x3_4 ^ x3_5 ^ x3_6 ^ x3_7;
    let t_4: i64 = x3_2 ^ x3_4 ^ x3_7;
    let t_5: i64 = x3_5 ^ x3_6;
    let t_6: i64 = x3_3 ^ x3_5;
    let t_7: i64 = x3_6 ^ x3_7;

    let x12_0: i64 = t_0 ^ t_4 ^ t_6;
    let x12_1: i64 = t_4 ^ t_6 ^ t_7;
    let x12_2: i64 = t_1 ^ t_5;
    let x12_3: i64 = t_4 ^ t_5 ^ t_6 ^ t_7;
    let x12_4: i64 = t_2 ^ t_4 ^ t_7;
    let x12_5: i64 = t_5 ^ t_6;
    let x12_6: i64 = t_3 ^ t_5;
    let x12_7: i64 = t_6 ^ t_7;

    let x14_0: i64 = (x12_0 & x2_0) ^ (x12_1 & x2_7) ^ (x12_2 & x2_6) ^ (x12_3 & x2_5) ^ (x12_4 & x2_4) ^ (x12_5 & x2_3) ^ (x12_5 & x2_7) ^ (x12_6 & x2_2) ^ (x12_6 & x2_6) ^ (x12_6 & x2_7) ^ (x12_7 & x2_1) ^ (x12_7 & x2_5) ^ (x12_7 & x2_6);
    let x14_1: i64 = (x12_0 & x2_1) ^ (x12_1 & x2_0) ^ (x12_1 & x2_7) ^ (x12_2 & x2_6) ^ (x12_2 & x2_7) ^ (x12_3 & x2_5) ^ (x12_3 & x2_6) ^ (x12_4 & x2_4) ^ (x12_4 & x2_5) ^ (x12_5 & x2_3) ^ (x12_5 & x2_4) ^ (x12_5 & x2_7) ^ (x12_6 & x2_2) ^ (x12_6 & x2_3) ^ (x12_6 & x2_6) ^ (x12_7 & x2_1) ^ (x12_7 & x2_2) ^ (x12_7 & x2_5) ^ (x12_7 & x2_7);
    let x14_2: i64 = (x12_0 & x2_2) ^ (x12_1 & x2_1) ^ (x12_2 & x2_0) ^ (x12_2 & x2_7) ^ (x12_3 & x2_6) ^ (x12_3 & x2_7) ^ (x12_4 & x2_5) ^ (x12_4 & x2_6) ^ (x12_5 & x2_4) ^ (x12_5 & x2_5) ^ (x12_6 & x2_3) ^ (x12_6 & x2_4) ^ (x12_6 & x2_7) ^ (x12_7 & x2_2) ^ (x12_7 & x2_3) ^ (x12_7 & x2_6);
    let x14_3: i64 = (x12_0 & x2_3) ^ (x12_1 & x2_2) ^ (x12_1 & x2_7) ^ (x12_2 & x2_1) ^ (x12_2 & x2_6) ^ (x12_3 & x2_0) ^ (x12_3 & x2_5) ^ (x12_3 & x2_7) ^ (x12_4 & x2_4) ^ (x12_4 & x2_6) ^ (x12_4 & x2_7) ^ (x12_5 & x2_3) ^ (x12_5 & x2_5) ^ (x12_5 & x2_6) ^ (x12_5 & x2_7) ^ (x12_6 & x2_2) ^ (x12_6 & x2_4) ^ (x12_6 & x2_5) ^ (x12_6 & x2_6) ^ (x12_6 & x2_7) ^ (x12_7 & x2_1) ^ (x12_7 & x2_3) ^ (x12_7 & x2_4) ^ (x12_7 & x2_5) ^ (x12_7 & x2_6) ^ (x12_7 & x2_7);
    let x14_4: i64 = (x12_0 & x2_4) ^ (x12_1 & x2_3) ^ (x12_1 & x2_7) ^ (x12_2 & x2_2) ^ (x12_2 & x2_6) ^ (x12_2 & x2_7) ^ (x12_3 & x2_1) ^ (x12_3 & x2_5) ^ (x12_3 & x2_6) ^ (x12_4 & x2_0) ^ (x12_4 & x2_4) ^ (x12_4 & x2_5) ^ (x12_4 & x2_7) ^ (x12_5 & x2_3) ^ (x12_5 & x2_4) ^ (x12_5 & x2_6) ^ (x12_6 & x2_2) ^ (x12_6 & x2_3) ^ (x12_6 & x2_5) ^ (x12_7 & x2_1) ^ (x12_7 & x2_2) ^ (x12_7 & x2_4) ^ (x12_7 & x2_7);
    let x14_5: i64 = (x12_0 & x2_5) ^ (x12_1 & x2_4) ^ (x12_2 & x2_3) ^ (x12_2 & x2_7) ^ (x12_3 & x2_2) ^ (x12_3 & x2_6) ^ (x12_3 & x2_7) ^ (x12_4 & x2_1) ^ (x12_4 & x2_5) ^ (x12_4 & x2_6) ^ (x12_5 & x2_0) ^ (x12_5 & x2_4) ^ (x12_5 & x2_5) ^ (x12_5 & x2_7) ^ (x12_6 & x2_3) ^ (x12_6 & x2_4) ^ (x12_6 & x2_6) ^ (x12_7 & x2_2) ^ (x12_7 & x2_3) ^ (x12_7 & x2_5);
    let x14_6: i64 = (x12_0 & x2_6) ^ (x12_1 & x2_5) ^ (x12_2 & x2_4) ^ (x12_3 & x2_3) ^ (x12_3 & x2_7) ^ (x12_4 & x2_2) ^ (x12_4 & x2_6) ^ (x12_4 & x2_7) ^ (x12_5 & x2_1) ^ (x12_5 & x2_5) ^ (x12_5 & x2_6) ^ (x12_6 & x2_0) ^ (x12_6 & x2_4) ^ (x12_6 & x2_5) ^ (x12_6 & x2_7) ^ (x12_7 & x2_3) ^ (x12_7 & x2_4) ^ (x12_7 & x2_6);
    let x14_7: i64 = (x12_0 & x2_7) ^ (x12_1 & x2_6) ^ (x12_2 & x2_5) ^ (x12_3 & x2_4) ^ (x12_4 & x2_3) ^ (x12_4 & x2_7) ^ (x12_5 & x2_2) ^ (x12_5 & x2_6) ^ (x12_5 & x2_7) ^ (x12_6 & x2_1) ^ (x12_6 & x2_5) ^ (x12_6 & x2_6) ^ (x12_7 & x2_0) ^ (x12_7 & x2_4) ^ (x12_7 & x2_5) ^ (x12_7 & x2_7);

    let x15_0: i64 = (x12_0 & x3_0) ^ (x12_1 & x3_7) ^ (x12_2 & x3_6) ^ (x12_3 & x3_5) ^ (x12_4 & x3_4) ^ (x12_5 & x3_3) ^ (x12_5 & x3_7) ^ (x12_6 & x3_2) ^ (x12_6 & x3_6) ^ (x12_6 & x3_7) ^ (x12_7 & x3_1) ^ (x12_7 & x3_5) ^ (x12_7 & x3_6);
    let x15_1: i64 = (x12_0 & x3_1) ^ (x12_1 & x3_0) ^ (x12_1 & x3_7) ^ (x12_2 & x3_6) ^ (x12_2 & x3_7) ^ (x12_3 & x3_5) ^ (x12_3 & x3_6) ^ (x12_4 & x3_4) ^ (x12_4 & x3_5) ^ (x12_5 & x3_3) ^ (x12_5 & x3_4) ^ (x12_5 & x3_7) ^ (x12_6 & x3_2) ^ (x12_6 & x3_3) ^ (x12_6 & x3_6) ^ (x12_7 & x3_1) ^ (x12_7 & x3_2) ^ (x12_7 & x3_5) ^ (x12_7 & x3_7);
    let x15_2: i64 = (x12_0 & x3_2) ^ (x12_1 & x3_1) ^ (x12_2 & x3_0) ^ (x12_2 & x3_7) ^ (x12_3 & x3_6) ^ (x12_3 & x3_7) ^ (x12_4 & x3_5) ^ (x12_4 & x3_6) ^ (x12_5 & x3_4) ^ (x12_5 & x3_5) ^ (x12_6 & x3_3) ^ (x12_6 & x3_4) ^ (x12_6 & x3_7) ^ (x12_7 & x3_2) ^ (x12_7 & x3_3) ^ (x12_7 & x3_6);
    let x15_3: i64 = (x12_0 & x3_3) ^ (x12_1 & x3_2) ^ (x12_1 & x3_7) ^ (x12_2 & x3_1) ^ (x12_2 & x3_6) ^ (x12_3 & x3_0) ^ (x12_3 & x3_5) ^ (x12_3 & x3_7) ^ (x12_4 & x3_4) ^ (x12_4 & x3_6) ^ (x12_4 & x3_7) ^ (x12_5 & x3_3) ^ (x12_5 & x3_5) ^ (x12_5 & x3_6) ^ (x12_5 & x3_7) ^ (x12_6 & x3_2) ^ (x12_6 & x3_4) ^ (x12_6 & x3_5) ^ (x12_6 & x3_6) ^ (x12_6 & x3_7) ^ (x12_7 & x3_1) ^ (x12_7 & x3_3) ^ (x12_7 & x3_4) ^ (x12_7 & x3_5) ^ (x12_7 & x3_6) ^ (x12_7 & x3_7);
    let x15_4: i64 = (x12_0 & x3_4) ^ (x12_1 & x3_3) ^ (x12_1 & x3_7) ^ (x12_2 & x3_2) ^ (x12_2 & x3_6) ^ (x12_2 & x3_7) ^ (x12_3 & x3_1) ^ (x12_3 & x3_5) ^ (x12_3 & x3_6) ^ (x12_4 & x3_0) ^ (x12_4 & x3_4) ^ (x12_4 & x3_5) ^ (x12_4 & x3_7) ^ (x12_5 & x3_3) ^ (x12_5 & x3_4) ^ (x12_5 & x3_6) ^ (x12_6 & x3_2) ^ (x12_6 & x3_3) ^ (x12_6 & x3_5) ^ (x12_7 & x3_1) ^ (x12_7 & x3_2) ^ (x12_7 & x3_4) ^ (x12_7 & x3_7);
    let x15_5: i64 = (x12_0 & x3_5) ^ (x12_1 & x3_4) ^ (x12_2 & x3_3) ^ (x12_2 & x3_7) ^ (x12_3 & x3_2) ^ (x12_3 & x3_6) ^ (x12_3 & x3_7) ^ (x12_4 & x3_1) ^ (x12_4 & x3_5) ^ (x12_4 & x3_6) ^ (x12_5 & x3_0) ^ (x12_5 & x3_4) ^ (x12_5 & x3_5) ^ (x12_5 & x3_7) ^ (x12_6 & x3_3) ^ (x12_6 & x3_4) ^ (x12_6 & x3_6) ^ (x12_7 & x3_2) ^ (x12_7 & x3_3) ^ (x12_7 & x3_5);
    let x15_6: i64 = (x12_0 & x3_6) ^ (x12_1 & x3_5) ^ (x12_2 & x3_4) ^ (x12_3 & x3_3) ^ (x12_3 & x3_7) ^ (x12_4 & x3_2) ^ (x12_4 & x3_6) ^ (x12_4 & x3_7) ^ (x12_5 & x3_1) ^ (x12_5 & x3_5) ^ (x12_5 & x3_6) ^ (x12_6 & x3_0) ^ (x12_6 & x3_4) ^ (x12_6 & x3_5) ^ (x12_6 & x3_7) ^ (x12_7 & x3_3) ^ (x12_7 & x3_4) ^ (x12_7 & x3_6);
    let x15_7: i64 = (x12_0 & x3_7) ^ (x12_1 & x3_6) ^ (x12_2 & x3_5) ^ (x12_3 & x3_4) ^ (x12_4 & x3_3) ^ (x12_4 & x3_7) ^ (x12_5 & x3_2) ^ (x12_5 & x3_6) ^ (x12_5 & x3_7) ^ (x12_6 & x3_1) ^ (x12_6 & x3_5) ^ (x12_6 & x3_6) ^ (x12_7 & x3_0) ^ (x12_7 & x3_4) ^ (x12_7 & x3_5) ^ (x12_7 & x3_7);

    let t2_0: i64 = x15_0 ^ x15_4 ^ x15_6;
    let t2_1: i64 = x15_4 ^ x15_6 ^ x15_7;
    let t2_2: i64 = x15_1 ^ x15_5;
    let t2_3: i64 = x15_4 ^ x15_5 ^ x15_6 ^ x15_7;
    let t2_4: i64 = x15_2 ^ x15_4 ^ x15_7;
    let t2_5: i64 = x15_5 ^ x15_6;
    let t2_6: i64 = x15_3 ^ x15_5;
    let t2_7: i64 = x15_6 ^ x15_7;

    let t3_0: i64 = t2_0 ^ t2_4 ^ t2_6;
    let t3_1: i64 = t2_4 ^ t2_6 ^ t2_7;
    let t3_2: i64 = t2_1 ^ t2_5;
    let t3_3: i64 = t2_4 ^ t2_5 ^ t2_6 ^ t2_7;
    let t3_4: i64 = t2_2 ^ t2_4 ^ t2_7;
    let t3_5: i64 = t2_5 ^ t2_6;
    let t3_6: i64 = t2_3 ^ t2_5;
    let t3_7: i64 = t2_6 ^ t2_7;

    let t4_0: i64 = t3_0 ^ t3_4 ^ t3_6;
    let t4_1: i64 = t3_4 ^ t3_6 ^ t3_7;
    let t4_2: i64 = t3_1 ^ t3_5;
    let t4_3: i64 = t3_4 ^ t3_5 ^ t3_6 ^ t3_7;
    let t4_4: i64 = t3_2 ^ t3_4 ^ t3_7;
    let t4_5: i64 = t3_5 ^ t3_6;
    let t4_6: i64 = t3_3 ^ t3_5;
    let t4_7: i64 = t3_6 ^ t3_7;

    let t5_0: i64 = t4_0 ^ t4_4 ^ t4_6;
    let t5_1: i64 = t4_4 ^ t4_6 ^ t4_7;
    let t5_2: i64 = t4_1 ^ t4_5;
    let t5_3: i64 = t4_4 ^ t4_5 ^ t4_6 ^ t4_7;
    let t5_4: i64 = t4_2 ^ t4_4 ^ t4_7;
    let t5_5: i64 = t4_5 ^ t4_6;
    let t5_6: i64 = t4_3 ^ t4_5;
    let t5_7: i64 = t4_6 ^ t4_7;

    let r_0: i64 = (t5_0 & x14_0) ^ (t5_1 & x14_7) ^ (t5_2 & x14_6) ^ (t5_3 & x14_5) ^ (t5_4 & x14_4) ^ (t5_5 & x14_3) ^ (t5_5 & x14_7) ^ (t5_6 & x14_2) ^ (t5_6 & x14_6) ^ (t5_6 & x14_7) ^ (t5_7 & x14_1) ^ (t5_7 & x14_5) ^ (t5_7 & x14_6);
    let r_1: i64 = (t5_0 & x14_1) ^ (t5_1 & x14_0) ^ (t5_1 & x14_7) ^ (t5_2 & x14_6) ^ (t5_2 & x14_7) ^ (t5_3 & x14_5) ^ (t5_3 & x14_6) ^ (t5_4 & x14_4) ^ (t5_4 & x14_5) ^ (t5_5 & x14_3) ^ (t5_5 & x14_4) ^ (t5_5 & x14_7) ^ (t5_6 & x14_2) ^ (t5_6 & x14_3) ^ (t5_6 & x14_6) ^ (t5_7 & x14_1) ^ (t5_7 & x14_2) ^ (t5_7 & x14_5) ^ (t5_7 & x14_7);
    let r_2: i64 = (t5_0 & x14_2) ^ (t5_1 & x14_1) ^ (t5_2 & x14_0) ^ (t5_2 & x14_7) ^ (t5_3 & x14_6) ^ (t5_3 & x14_7) ^ (t5_4 & x14_5) ^ (t5_4 & x14_6) ^ (t5_5 & x14_4) ^ (t5_5 & x14_5) ^ (t5_6 & x14_3) ^ (t5_6 & x14_4) ^ (t5_6 & x14_7) ^ (t5_7 & x14_2) ^ (t5_7 & x14_3) ^ (t5_7 & x14_6);
    let r_3: i64 = (t5_0 & x14_3) ^ (t5_1 & x14_2) ^ (t5_1 & x14_7) ^ (t5_2 & x14_1) ^ (t5_2 & x14_6) ^ (t5_3 & x14_0) ^ (t5_3 & x14_5) ^ (t5_3 & x14_7) ^ (t5_4 & x14_4) ^ (t5_4 & x14_6) ^ (t5_4 & x14_7) ^ (t5_5 & x14_3) ^ (t5_5 & x14_5) ^ (t5_5 & x14_6) ^ (t5_5 & x14_7) ^ (t5_6 & x14_2) ^ (t5_6 & x14_4) ^ (t5_6 & x14_5) ^ (t5_6 & x14_6) ^ (t5_6 & x14_7) ^ (t5_7 & x14_1) ^ (t5_7 & x14_3) ^ (t5_7 & x14_4) ^ (t5_7 & x14_5) ^ (t5_7 & x14_6) ^ (t5_7 & x14_7);
    let r_4: i64 = (t5_0 & x14_4) ^ (t5_1 & x14_3) ^ (t5_1 & x14_7) ^ (t5_2 & x14_2) ^ (t5_2 & x14_6) ^ (t5_2 & x14_7) ^ (t5_3 & x14_1) ^ (t5_3 & x14_5) ^ (t5_3 & x14_6) ^ (t5_4 & x14_0) ^ (t5_4 & x14_4) ^ (t5_4 & x14_5) ^ (t5_4 & x14_7) ^ (t5_5 & x14_3) ^ (t5_5 & x14_4) ^ (t5_5 & x14_6) ^ (t5_6 & x14_2) ^ (t5_6 & x14_3) ^ (t5_6 & x14_5) ^ (t5_7 & x14_1) ^ (t5_7 & x14_2) ^ (t5_7 & x14_4) ^ (t5_7 & x14_7);
    let r_5: i64 = (t5_0 & x14_5) ^ (t5_1 & x14_4) ^ (t5_2 & x14_3) ^ (t5_2 & x14_7) ^ (t5_3 & x14_2) ^ (t5_3 & x14_6) ^ (t5_3 & x14_7) ^ (t5_4 & x14_1) ^ (t5_4 & x14_5) ^ (t5_4 & x14_6) ^ (t5_5 & x14_0) ^ (t5_5 & x14_4) ^ (t5_5 & x14_5) ^ (t5_5 & x14_7) ^ (t5_6 & x14_3) ^ (t5_6 & x14_4) ^ (t5_6 & x14_6) ^ (t5_7 & x14_2) ^ (t5_7 & x14_3) ^ (t5_7 & x14_5);
    let r_6: i64 = (t5_0 & x14_6) ^ (t5_1 & x14_5) ^ (t5_2 & x14_4) ^ (t5_3 & x14_3) ^ (t5_3 & x14_7) ^ (t5_4 & x14_2) ^ (t5_4 & x14_6) ^ (t5_4 & x14_7) ^ (t5_5 & x14_1) ^ (t5_5 & x14_5) ^ (t5_5 & x14_6) ^ (t5_6 & x14_0) ^ (t5_6 & x14_4) ^ (t5_6 & x14_5) ^ (t5_6 & x14_7) ^ (t5_7 & x14_3) ^ (t5_7 & x14_4) ^ (t5_7 & x14_6);
    let r_7: i64 = (t5_0 & x14_7) ^ (t5_1 & x14_6) ^ (t5_2 & x14_5) ^ (t5_3 & x14_4) ^ (t5_4 & x14_3) ^ (t5_4 & x14_7) ^ (t5_5 & x14_2) ^ (t5_5 & x14_6) ^ (t5_5 & x14_7) ^ (t5_6 & x14_1) ^ (t5_6 & x14_5) ^ (t5_6 & x14_6) ^ (t5_7 & x14_0) ^ (t5_7 & x14_4) ^ (t5_7 & x14_5) ^ (t5_7 & x14_7);

    let ones: i64 = 4294967295;
    _tlsrec_pw(ws, state, 0, r_0 ^ r_4 ^ r_5 ^ r_6 ^ r_7 ^ ones);
    _tlsrec_pw(ws, state, 1, r_1 ^ r_5 ^ r_6 ^ r_7 ^ r_0 ^ ones);
    _tlsrec_pw(ws, state, 2, r_2 ^ r_6 ^ r_7 ^ r_0 ^ r_1);
    _tlsrec_pw(ws, state, 3, r_3 ^ r_7 ^ r_0 ^ r_1 ^ r_2);
    _tlsrec_pw(ws, state, 4, r_4 ^ r_0 ^ r_1 ^ r_2 ^ r_3);
    _tlsrec_pw(ws, state, 5, r_5 ^ r_1 ^ r_2 ^ r_3 ^ r_4 ^ ones);
    _tlsrec_pw(ws, state, 6, r_6 ^ r_2 ^ r_3 ^ r_4 ^ r_5 ^ ones);
    _tlsrec_pw(ws, state, 7, r_7 ^ r_3 ^ r_4 ^ r_5 ^ r_6);
}

// Bitslice `n` (<= 32) bytes at `bytes[off..off+n)` into the 8-word slot
// `dest`. Port of `bs_slice`; lanes at or above `n` stay zero.
fn _tlsrec_bs_slice(bytes: *u8, off: i64, n: i64, ws: *u8, dest: i64) -> void {
    let mut w0: i64 = 0;
    let mut w1: i64 = 0;
    let mut w2: i64 = 0;
    let mut w3: i64 = 0;
    let mut w4: i64 = 0;
    let mut w5: i64 = 0;
    let mut w6: i64 = 0;
    let mut w7: i64 = 0;
    let mut k: i64 = 0;
    loop {
        if k >= n { break; }
        let b: i64 = _tlsrec_at(bytes, off + k);
        w0 = w0 | (((b >> 0) & 1) << k);
        w1 = w1 | (((b >> 1) & 1) << k);
        w2 = w2 | (((b >> 2) & 1) << k);
        w3 = w3 | (((b >> 3) & 1) << k);
        w4 = w4 | (((b >> 4) & 1) << k);
        w5 = w5 | (((b >> 5) & 1) << k);
        w6 = w6 | (((b >> 6) & 1) << k);
        w7 = w7 | (((b >> 7) & 1) << k);
        k = k + 1;
    }
    _tlsrec_pw(ws, dest, 0, w0);
    _tlsrec_pw(ws, dest, 1, w1);
    _tlsrec_pw(ws, dest, 2, w2);
    _tlsrec_pw(ws, dest, 3, w3);
    _tlsrec_pw(ws, dest, 4, w4);
    _tlsrec_pw(ws, dest, 5, w5);
    _tlsrec_pw(ws, dest, 6, w6);
    _tlsrec_pw(ws, dest, 7, w7);
}

// Inverse of `_tlsrec_bs_slice`: write lanes 0..n-1 of 8-word slot `src` to
// `out[out_off..out_off+n)`. Port of `bs_unslice`.
fn _tlsrec_bs_unslice(ws: *u8, src: i64, out: *u8, out_off: i64, n: i64) -> void {
    let w0: i64 = _tlsrec_gw(ws, src, 0);
    let w1: i64 = _tlsrec_gw(ws, src, 1);
    let w2: i64 = _tlsrec_gw(ws, src, 2);
    let w3: i64 = _tlsrec_gw(ws, src, 3);
    let w4: i64 = _tlsrec_gw(ws, src, 4);
    let w5: i64 = _tlsrec_gw(ws, src, 5);
    let w6: i64 = _tlsrec_gw(ws, src, 6);
    let w7: i64 = _tlsrec_gw(ws, src, 7);
    let mut k: i64 = 0;
    loop {
        if k >= n { break; }
        let b: i64 = ((w0 >> k) & 1) | (((w1 >> k) & 1) << 1) | (((w2 >> k) & 1) << 2) | (((w3 >> k) & 1) << 3) | (((w4 >> k) & 1) << 4) | (((w5 >> k) & 1) << 5) | (((w6 >> k) & 1) << 6) | (((w7 >> k) & 1) << 7);
        _tlsrec_put(out, out_off + k, b);
        k = k + 1;
    }
}

// Row masks for ShiftRows and nibble masks for MixColumns' column
// rotations, in the bitsliced layout — unchanged from `aes.sfn`.
fn _tlsrec_row0_mask() -> i64 { return 286331153; }

fn _tlsrec_row1_mask() -> i64 { return 572662306; }

fn _tlsrec_row2_mask() -> i64 { return 1145324612; }

fn _tlsrec_row3_mask() -> i64 { return 2290649224; }

fn _tlsrec_nib_lo3_mask() -> i64 { return 2004318071; }

fn _tlsrec_nib_hi1_mask() -> i64 { return 2290649224; }

// Rotate `v` right by `n` (1 <= n <= 15) independently within each 16-bit
// block half. Port of `_rot16r`.
fn _tlsrec_rot16r(v: i64, n: i64) -> i64 {
    let lo: i64 = v & 65535;
    let hi: i64 = (v >> 16) & 65535;
    let lo2: i64 = ((lo >> n) | (lo << (16 - n))) & 65535;
    let hi2: i64 = ((hi >> n) | (hi << (16 - n))) & 65535;
    return lo2 | (hi2 << 16);
}

// ShiftRows (FIPS-197 §5.1.2) and MixColumns (§5.1.3) row/column formulas.
// `_tlsrec_aes_encrypt2` below inlines both directly on local scalars rather
// than calling a `(ws, state)` buffer-based round function — see its header
// comment — so only the masks and these two rotations survive as shared
// helpers.
fn _tlsrec_rot_col1(v: i64) -> i64 {
    return ((v >> 1) & _tlsrec_nib_lo3_mask()) | ((v << 3) & _tlsrec_nib_hi1_mask());
}

fn _tlsrec_rot_col2(v: i64) -> i64 {
    return ((v >> 2) & 858993459) | ((v << 2) & 3435973836);
}

// Round constant for key-schedule word `i / Nk`. Port of `_rcon`.
fn _tlsrec_rcon(n: i64) -> i64 {
    let mut r: i64 = 1;
    let mut i: i64 = 1;
    loop {
        if i >= n { break; }
        let hi: i64 = (r >> 7) & 1;
        r = ((r << 1) & 255) ^ (27 * hi);
        i = i + 1;
    }
    return r;
}

// FIPS-197 §5.2 key expansion for Nk = 4 (AES-128) and Nk = 8 (AES-256),
// writing `16 * (Nr + 1)` bytes to caller-owned `ek_out` (must hold at least
// 240 bytes) and returning that count, or 0 for any other `key_len`
// (fail-closed, matching `aes_key_expand`). SubWord reuses the same
// bitsliced S-box as the cipher core, on 4 of its 32 lanes — wasteful, paid
// once per key rather than per block, exactly as the oracle notes.
fn _tlsrec_aes_key_expand(ws: *u8, key: *u8, key_len: i64, ek_out: *u8) -> i64 {
    if key_len != 16 && key_len != 32 { return 0; }
    let nk: i64 = key_len / 4;
    let nr: i64 = nk + 6;
    let total_words: i64 = 4 * (nr + 1);
    let dup: i64 = _tlsrec_aes_dup();
    let state: i64 = _tlsrec_aes_state();

    let mut i: i64 = 0;
    loop {
        if i >= key_len { break; }
        _tlsrec_put(ek_out, i, _tlsrec_at(key, i));
        i = i + 1;
    }

    i = nk;
    loop {
        if i >= total_words { break; }
        let p: i64 = (i - 1) * 4;
        let mut t0: i64 = _tlsrec_at(ek_out, p);
        let mut t1: i64 = _tlsrec_at(ek_out, p + 1);
        let mut t2: i64 = _tlsrec_at(ek_out, p + 2);
        let mut t3: i64 = _tlsrec_at(ek_out, p + 3);
        if i % nk == 0 {
            _tlsrec_put(ws, dup, t1);
            _tlsrec_put(ws, dup + 1, t2);
            _tlsrec_put(ws, dup + 2, t3);
            _tlsrec_put(ws, dup + 3, t0);
            _tlsrec_bs_slice(ws, dup, 4, ws, state);
            _tlsrec_bs_sbox(ws, state);
            _tlsrec_bs_unslice(ws, state, ws, dup, 4);
            t0 = _tlsrec_at(ws, dup) ^ _tlsrec_rcon(i / nk);
            t1 = _tlsrec_at(ws, dup + 1);
            t2 = _tlsrec_at(ws, dup + 2);
            t3 = _tlsrec_at(ws, dup + 3);
        } else if nk == 8 && i % nk == 4 {
            _tlsrec_put(ws, dup, t0);
            _tlsrec_put(ws, dup + 1, t1);
            _tlsrec_put(ws, dup + 2, t2);
            _tlsrec_put(ws, dup + 3, t3);
            _tlsrec_bs_slice(ws, dup, 4, ws, state);
            _tlsrec_bs_sbox(ws, state);
            _tlsrec_bs_unslice(ws, state, ws, dup, 4);
            t0 = _tlsrec_at(ws, dup);
            t1 = _tlsrec_at(ws, dup + 1);
            t2 = _tlsrec_at(ws, dup + 2);
            t3 = _tlsrec_at(ws, dup + 3);
        }
        let q: i64 = (i - nk) * 4;
        _tlsrec_put(ek_out, i * 4, _tlsrec_at(ek_out, q) ^ t0);
        _tlsrec_put(ek_out, i * 4 + 1, _tlsrec_at(ek_out, q + 1) ^ t1);
        _tlsrec_put(ek_out, i * 4 + 2, _tlsrec_at(ek_out, q + 2) ^ t2);
        _tlsrec_put(ek_out, i * 4 + 3, _tlsrec_at(ek_out, q + 3) ^ t3);
        i = i + 1;
    }
    return total_words * 4;
}

// Pre-bitslice the round keys from `ek` (`ek_len` bytes, 176 or 240) into
// `bk_out`: 8 little-endian words per round, the 16 key bytes replicated
// into both block halves. Returns the byte count written, or 0 for any
// other `ek_len` (fail-closed, matching `aes_bs_keys`).
fn _tlsrec_aes_bs_keys(ws: *u8, ek: *u8, ek_len: i64, bk_out: *u8) -> i64 {
    if ek_len != 176 && ek_len != 240 { return 0; }
    let rounds: i64 = ek_len / 16;
    let dup: i64 = _tlsrec_aes_dup();
    let state: i64 = _tlsrec_aes_state();
    let mut r: i64 = 0;
    loop {
        if r >= rounds { break; }
        let off: i64 = r * 16;
        let mut i: i64 = 0;
        loop {
            if i >= 16 { break; }
            let b: i64 = _tlsrec_at(ek, off + i);
            _tlsrec_put(ws, dup + i, b);
            _tlsrec_put(ws, dup + 16 + i, b);
            i = i + 1;
        }
        _tlsrec_bs_slice(ws, dup, 32, ws, state);
        let mut j: i64 = 0;
        loop {
            if j >= 8 { break; }
            _tlsrec_put_le32(bk_out, r * 32 + 4 * j, _tlsrec_gw(ws, state, j));
            j = j + 1;
        }
        r = r + 1;
    }
    return rounds * 32;
}

// Encrypt the two 16-byte blocks at `blocks[blocks_off..blocks_off+32)`
// under pre-bitsliced round keys `bk` (`nr` rounds after the initial
// whitening), writing 32 bytes to `out[out_off..out_off+32)`. `blocks`/
// `blocks_off` may alias `out`/`out_off` — the whole 32-byte input is
// bitsliced into `state` before anything is written back.
//
// The whole per-round pipeline (S-box, ShiftRows, MixColumns, AddRoundKey)
// runs on local `w0..w7` scalars for the entire round loop — `state` is
// touched only once at entry (`_tlsrec_bs_slice`) and once at exit
// (`_tlsrec_bs_unslice`). ShiftRows/MixColumns/AddRoundKey were themselves
// buffer-based round-function ports (mirroring `_shift_rows`/
// `_mix_columns`/`_add_round_key`) before SFN-817's throughput pass folded
// them in here alongside the S-box, for the same reason recorded on
// `_tlsrec_bs_sbox`: a `ws` buffer round-trip per word, per sub-step, per
// round is real heap memory traffic malloc'd `ws` can never be promoted out
// of. ShiftRows is still expressed with `_tlsrec_rot16r`/the row masks and
// MixColumns with `_tlsrec_rot_col1`/`_tlsrec_rot_col2` — only the *state*
// moved out of the buffer, not those formulas. Round keys are read directly
// from `bk` (a different, read-only buffer, necessarily touched once per
// round) via `_tlsrec_le32`. Correctness rests on the same byte-identity
// differential named on `_tlsrec_bs_sbox` above, run over the full round
// count for both AES-128 and AES-256.
fn _tlsrec_aes_encrypt2(ws: *u8, bk: *u8, nr: i64, blocks: *u8, blocks_off: i64, out: *u8, out_off: i64) -> void {
