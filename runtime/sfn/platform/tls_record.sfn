    let x15_2: i64 = (x12_0 & x3_2) ^ (x12_1 & x3_1) ^ (x12_2 & x3_0) ^ (x12_2 & x3_7) ^ (x12_3 & x3_6) ^ (x12_3 & x3_7) ^ (x12_4 & x3_5) ^ (x12_4 & x3_6) ^ (x12_5 & x3_4) ^ (x12_5 & x3_5) ^ (x12_6 & x3_3) ^ (x12_6 & x3_4) ^ (x12_6 & x3_7) ^ (x12_7 & x3_2) ^ (x12_7 & x3_3) ^ (x12_7 & x3_6);
    let x15_3: i64 = (x12_0 & x3_3) ^ (x12_1 & x3_2) ^ (x12_1 & x3_7) ^ (x12_2 & x3_1) ^ (x12_2 & x3_6) ^ (x12_3 & x3_0) ^ (x12_3 & x3_5) ^ (x12_3 & x3_7) ^ (x12_4 & x3_4) ^ (x12_4 & x3_6) ^ (x12_4 & x3_7) ^ (x12_5 & x3_3) ^ (x12_5 & x3_5) ^ (x12_5 & x3_6) ^ (x12_5 & x3_7) ^ (x12_6 & x3_2) ^ (x12_6 & x3_4) ^ (x12_6 & x3_5) ^ (x12_6 & x3_6) ^ (x12_6 & x3_7) ^ (x12_7 & x3_1) ^ (x12_7 & x3_3) ^ (x12_7 & x3_4) ^ (x12_7 & x3_5) ^ (x12_7 & x3_6) ^ (x12_7 & x3_7);
    let x15_4: i64 = (x12_0 & x3_4) ^ (x12_1 & x3_3) ^ (x12_1 & x3_7) ^ (x12_2 & x3_2) ^ (x12_2 & x3_6) ^ (x12_2 & x3_7) ^ (x12_3 & x3_1) ^ (x12_3 & x3_5) ^ (x12_3 & x3_6) ^ (x12_4 & x3_0) ^ (x12_4 & x3_4) ^ (x12_4 & x3_5) ^ (x12_4 & x3_7) ^ (x12_5 & x3_3) ^ (x12_5 & x3_4) ^ (x12_5 & x3_6) ^ (x12_6 & x3_2) ^ (x12_6 & x3_3) ^ (x12_6 & x3_5) ^ (x12_7 & x3_1) ^ (x12_7 & x3_2) ^ (x12_7 & x3_4) ^ (x12_7 & x3_7);
    let x15_5: i64 = (x12_0 & x3_5) ^ (x12_1 & x3_4) ^ (x12_2 & x3_3) ^ (x12_2 & x3_7) ^ (x12_3 & x3_2) ^ (x12_3 & x3_6) ^ (x12_3 & x3_7) ^ (x12_4 & x3_1) ^ (x12_4 & x3_5) ^ (x12_4 & x3_6) ^ (x12_5 & x3_0) ^ (x12_5 & x3_4) ^ (x12_5 & x3_5) ^ (x12_5 & x3_7) ^ (x12_6 & x3_3) ^ (x12_6 & x3_4) ^ (x12_6 & x3_6) ^ (x12_7 & x3_2) ^ (x12_7 & x3_3) ^ (x12_7 & x3_5);
    let x15_6: i64 = (x12_0 & x3_6) ^ (x12_1 & x3_5) ^ (x12_2 & x3_4) ^ (x12_3 & x3_3) ^ (x12_3 & x3_7) ^ (x12_4 & x3_2) ^ (x12_4 & x3_6) ^ (x12_4 & x3_7) ^ (x12_5 & x3_1) ^ (x12_5 & x3_5) ^ (x12_5 & x3_6) ^ (x12_6 & x3_0) ^ (x12_6 & x3_4) ^ (x12_6 & x3_5) ^ (x12_6 & x3_7) ^ (x12_7 & x3_3) ^ (x12_7 & x3_4) ^ (x12_7 & x3_6);
    let x15_7: i64 = (x12_0 & x3_7) ^ (x12_1 & x3_6) ^ (x12_2 & x3_5) ^ (x12_3 & x3_4) ^ (x12_4 & x3_3) ^ (x12_4 & x3_7) ^ (x12_5 & x3_2) ^ (x12_5 & x3_6) ^ (x12_5 & x3_7) ^ (x12_6 & x3_1) ^ (x12_6 & x3_5) ^ (x12_6 & x3_6) ^ (x12_7 & x3_0) ^ (x12_7 & x3_4) ^ (x12_7 & x3_5) ^ (x12_7 & x3_7);

    let t2_0: i64 = x15_0 ^ x15_4 ^ x15_6;
    let t2_1: i64 = x15_4 ^ x15_6 ^ x15_7;
    let t2_2: i64 = x15_1 ^ x15_5;
    let t2_3: i64 = x15_4 ^ x15_5 ^ x15_6 ^ x15_7;
    let t2_4: i64 = x15_2 ^ x15_4 ^ x15_7;
    let t2_5: i64 = x15_5 ^ x15_6;
    let t2_6: i64 = x15_3 ^ x15_5;
    let t2_7: i64 = x15_6 ^ x15_7;

    let t3_0: i64 = t2_0 ^ t2_4 ^ t2_6;
    let t3_1: i64 = t2_4 ^ t2_6 ^ t2_7;
    let t3_2: i64 = t2_1 ^ t2_5;
    let t3_3: i64 = t2_4 ^ t2_5 ^ t2_6 ^ t2_7;
    let t3_4: i64 = t2_2 ^ t2_4 ^ t2_7;
    let t3_5: i64 = t2_5 ^ t2_6;
    let t3_6: i64 = t2_3 ^ t2_5;
    let t3_7: i64 = t2_6 ^ t2_7;

    let t4_0: i64 = t3_0 ^ t3_4 ^ t3_6;
    let t4_1: i64 = t3_4 ^ t3_6 ^ t3_7;
    let t4_2: i64 = t3_1 ^ t3_5;
    let t4_3: i64 = t3_4 ^ t3_5 ^ t3_6 ^ t3_7;
    let t4_4: i64 = t3_2 ^ t3_4 ^ t3_7;
    let t4_5: i64 = t3_5 ^ t3_6;
    let t4_6: i64 = t3_3 ^ t3_5;
    let t4_7: i64 = t3_6 ^ t3_7;

    let t5_0: i64 = t4_0 ^ t4_4 ^ t4_6;
    let t5_1: i64 = t4_4 ^ t4_6 ^ t4_7;
    let t5_2: i64 = t4_1 ^ t4_5;
    let t5_3: i64 = t4_4 ^ t4_5 ^ t4_6 ^ t4_7;
    let t5_4: i64 = t4_2 ^ t4_4 ^ t4_7;
    let t5_5: i64 = t4_5 ^ t4_6;
    let t5_6: i64 = t4_3 ^ t4_5;
    let t5_7: i64 = t4_6 ^ t4_7;

    let r_0: i64 = (t5_0 & x14_0) ^ (t5_1 & x14_7) ^ (t5_2 & x14_6) ^ (t5_3 & x14_5) ^ (t5_4 & x14_4) ^ (t5_5 & x14_3) ^ (t5_5 & x14_7) ^ (t5_6 & x14_2) ^ (t5_6 & x14_6) ^ (t5_6 & x14_7) ^ (t5_7 & x14_1) ^ (t5_7 & x14_5) ^ (t5_7 & x14_6);
    let r_1: i64 = (t5_0 & x14_1) ^ (t5_1 & x14_0) ^ (t5_1 & x14_7) ^ (t5_2 & x14_6) ^ (t5_2 & x14_7) ^ (t5_3 & x14_5) ^ (t5_3 & x14_6) ^ (t5_4 & x14_4) ^ (t5_4 & x14_5) ^ (t5_5 & x14_3) ^ (t5_5 & x14_4) ^ (t5_5 & x14_7) ^ (t5_6 & x14_2) ^ (t5_6 & x14_3) ^ (t5_6 & x14_6) ^ (t5_7 & x14_1) ^ (t5_7 & x14_2) ^ (t5_7 & x14_5) ^ (t5_7 & x14_7);
    let r_2: i64 = (t5_0 & x14_2) ^ (t5_1 & x14_1) ^ (t5_2 & x14_0) ^ (t5_2 & x14_7) ^ (t5_3 & x14_6) ^ (t5_3 & x14_7) ^ (t5_4 & x14_5) ^ (t5_4 & x14_6) ^ (t5_5 & x14_4) ^ (t5_5 & x14_5) ^ (t5_6 & x14_3) ^ (t5_6 & x14_4) ^ (t5_6 & x14_7) ^ (t5_7 & x14_2) ^ (t5_7 & x14_3) ^ (t5_7 & x14_6);
    let r_3: i64 = (t5_0 & x14_3) ^ (t5_1 & x14_2) ^ (t5_1 & x14_7) ^ (t5_2 & x14_1) ^ (t5_2 & x14_6) ^ (t5_3 & x14_0) ^ (t5_3 & x14_5) ^ (t5_3 & x14_7) ^ (t5_4 & x14_4) ^ (t5_4 & x14_6) ^ (t5_4 & x14_7) ^ (t5_5 & x14_3) ^ (t5_5 & x14_5) ^ (t5_5 & x14_6) ^ (t5_5 & x14_7) ^ (t5_6 & x14_2) ^ (t5_6 & x14_4) ^ (t5_6 & x14_5) ^ (t5_6 & x14_6) ^ (t5_6 & x14_7) ^ (t5_7 & x14_1) ^ (t5_7 & x14_3) ^ (t5_7 & x14_4) ^ (t5_7 & x14_5) ^ (t5_7 & x14_6) ^ (t5_7 & x14_7);
    let r_4: i64 = (t5_0 & x14_4) ^ (t5_1 & x14_3) ^ (t5_1 & x14_7) ^ (t5_2 & x14_2) ^ (t5_2 & x14_6) ^ (t5_2 & x14_7) ^ (t5_3 & x14_1) ^ (t5_3 & x14_5) ^ (t5_3 & x14_6) ^ (t5_4 & x14_0) ^ (t5_4 & x14_4) ^ (t5_4 & x14_5) ^ (t5_4 & x14_7) ^ (t5_5 & x14_3) ^ (t5_5 & x14_4) ^ (t5_5 & x14_6) ^ (t5_6 & x14_2) ^ (t5_6 & x14_3) ^ (t5_6 & x14_5) ^ (t5_7 & x14_1) ^ (t5_7 & x14_2) ^ (t5_7 & x14_4) ^ (t5_7 & x14_7);
    let r_5: i64 = (t5_0 & x14_5) ^ (t5_1 & x14_4) ^ (t5_2 & x14_3) ^ (t5_2 & x14_7) ^ (t5_3 & x14_2) ^ (t5_3 & x14_6) ^ (t5_3 & x14_7) ^ (t5_4 & x14_1) ^ (t5_4 & x14_5) ^ (t5_4 & x14_6) ^ (t5_5 & x14_0) ^ (t5_5 & x14_4) ^ (t5_5 & x14_5) ^ (t5_5 & x14_7) ^ (t5_6 & x14_3) ^ (t5_6 & x14_4) ^ (t5_6 & x14_6) ^ (t5_7 & x14_2) ^ (t5_7 & x14_3) ^ (t5_7 & x14_5);
    let r_6: i64 = (t5_0 & x14_6) ^ (t5_1 & x14_5) ^ (t5_2 & x14_4) ^ (t5_3 & x14_3) ^ (t5_3 & x14_7) ^ (t5_4 & x14_2) ^ (t5_4 & x14_6) ^ (t5_4 & x14_7) ^ (t5_5 & x14_1) ^ (t5_5 & x14_5) ^ (t5_5 & x14_6) ^ (t5_6 & x14_0) ^ (t5_6 & x14_4) ^ (t5_6 & x14_5) ^ (t5_6 & x14_7) ^ (t5_7 & x14_3) ^ (t5_7 & x14_4) ^ (t5_7 & x14_6);
    let r_7: i64 = (t5_0 & x14_7) ^ (t5_1 & x14_6) ^ (t5_2 & x14_5) ^ (t5_3 & x14_4) ^ (t5_4 & x14_3) ^ (t5_4 & x14_7) ^ (t5_5 & x14_2) ^ (t5_5 & x14_6) ^ (t5_5 & x14_7) ^ (t5_6 & x14_1) ^ (t5_6 & x14_5) ^ (t5_6 & x14_6) ^ (t5_7 & x14_0) ^ (t5_7 & x14_4) ^ (t5_7 & x14_5) ^ (t5_7 & x14_7);

    let ones: i64 = 4294967295;
    let sb0: i64 = r_0 ^ r_4 ^ r_5 ^ r_6 ^ r_7 ^ ones;
    let sb1: i64 = r_1 ^ r_5 ^ r_6 ^ r_7 ^ r_0 ^ ones;
    let sb2: i64 = r_2 ^ r_6 ^ r_7 ^ r_0 ^ r_1;
    let sb3: i64 = r_3 ^ r_7 ^ r_0 ^ r_1 ^ r_2;
    let sb4: i64 = r_4 ^ r_0 ^ r_1 ^ r_2 ^ r_3;
    let sb5: i64 = r_5 ^ r_1 ^ r_2 ^ r_3 ^ r_4 ^ ones;
    let sb6: i64 = r_6 ^ r_2 ^ r_3 ^ r_4 ^ r_5 ^ ones;
    let sb7: i64 = r_7 ^ r_3 ^ r_4 ^ r_5 ^ r_6;

    let sr0: i64 = (sb0 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb0 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb0 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb0 & _tlsrec_row3_mask(), 12);
    let sr1: i64 = (sb1 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb1 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb1 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb1 & _tlsrec_row3_mask(), 12);
    let sr2: i64 = (sb2 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb2 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb2 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb2 & _tlsrec_row3_mask(), 12);
    let sr3: i64 = (sb3 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb3 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb3 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb3 & _tlsrec_row3_mask(), 12);
    let sr4: i64 = (sb4 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb4 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb4 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb4 & _tlsrec_row3_mask(), 12);
    let sr5: i64 = (sb5 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb5 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb5 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb5 & _tlsrec_row3_mask(), 12);
    let sr6: i64 = (sb6 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb6 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb6 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb6 & _tlsrec_row3_mask(), 12);
    let sr7: i64 = (sb7 & _tlsrec_row0_mask()) | _tlsrec_rot16r(sb7 & _tlsrec_row1_mask(), 4) | _tlsrec_rot16r(sb7 & _tlsrec_row2_mask(), 8) | _tlsrec_rot16r(sb7 & _tlsrec_row3_mask(), 12);

    let nw0: i64 = sr0 ^ _tlsrec_le32(bk, nr * 32 + 0);
    let nw1: i64 = sr1 ^ _tlsrec_le32(bk, nr * 32 + 4);
    let nw2: i64 = sr2 ^ _tlsrec_le32(bk, nr * 32 + 8);
    let nw3: i64 = sr3 ^ _tlsrec_le32(bk, nr * 32 + 12);
    let nw4: i64 = sr4 ^ _tlsrec_le32(bk, nr * 32 + 16);
    let nw5: i64 = sr5 ^ _tlsrec_le32(bk, nr * 32 + 20);
    let nw6: i64 = sr6 ^ _tlsrec_le32(bk, nr * 32 + 24);
    let nw7: i64 = sr7 ^ _tlsrec_le32(bk, nr * 32 + 28);
    _tlsrec_pw(ws, state, 0, nw0);
    _tlsrec_pw(ws, state, 1, nw1);
    _tlsrec_pw(ws, state, 2, nw2);
    _tlsrec_pw(ws, state, 3, nw3);
    _tlsrec_pw(ws, state, 4, nw4);
    _tlsrec_pw(ws, state, 5, nw5);
    _tlsrec_pw(ws, state, 6, nw6);
    _tlsrec_pw(ws, state, 7, nw7);
    _tlsrec_bs_unslice(ws, state, out, out_off, 32);
}

// Encrypt one 16-byte block, duplicating it into both cipher-core lanes (the
// second copy is discarded) — GCM needs exactly two of these per record, for
// H and E(K, J0), and streams everything else through CTR. Port of
// `aes_encrypt_block_bs`.
fn _tlsrec_aes_encrypt_block(ws: *u8, bk: *u8, nr: i64, in16: *u8, out16: *u8) -> void {
    let dup: i64 = _tlsrec_aes_dup();
    let mut i: i64 = 0;
    loop {
        if i >= 16 { break; }
        let b: i64 = _tlsrec_at(in16, i);
        _tlsrec_put(ws, dup + i, b);
        _tlsrec_put(ws, dup + 16 + i, b);
        i = i + 1;
    }
    _tlsrec_aes_encrypt2(ws, bk, nr, ws, dup, ws, dup);
    memcpy(out16, _tlsrec_ptr_off(ws, dup), 16 as usize);
}

// Increment the low 32 bits of the 16-byte counter block at `block + off`,
// big-endian, wrapping at 2^32 (GCM's inc32, SP 800-38D §6.2). Port of
// `_inc32`; the early-return iteration count depends on the counter's
// bytes, sound for the same reason recorded there — this file's GCM path
// accepts 96-bit nonces only, so the counter is public.
fn _tlsrec_inc32(block: *u8, off: i64) -> void {
    let mut i: i64 = 15;
    loop {
        if i < 12 { break; }
        let v: i64 = _tlsrec_at(block, off + i) + 1;
        _tlsrec_put(block, off + i, v & 255);
        if v < 256 { return; }
        i = i - 1;
    }
}

// CTR-mode XOR of `len` bytes from `src` into `dst` (may alias) starting at
// counter block `ctr16`, advancing by inc32 per block, two blocks per cipher
// call. `ctr16` is read into a local copy and never written back — matching
// `aes_ctr_xor_bs`'s single-shot contract, the caller advances its own
// counter between calls.
fn _tlsrec_aes_ctr_xor(ws: *u8, bk: *u8, nr: i64, ctr16: *u8, src: *u8, dst: *u8, len: i64) -> void {
    let ctrw: i64 = _tlsrec_aes_ctrw();
    let pair: i64 = _tlsrec_aes_pair();
    let ks: i64 = _tlsrec_aes_ks();
    memcpy(_tlsrec_ptr_off(ws, ctrw), ctr16, 16 as usize);
    let mut off: i64 = 0;
    loop {
        if off >= len { break; }
        memcpy(_tlsrec_ptr_off(ws, pair), _tlsrec_ptr_off(ws, ctrw), 16 as usize);
        _tlsrec_inc32(ws, ctrw);
        memcpy(_tlsrec_ptr_off(ws, pair + 16), _tlsrec_ptr_off(ws, ctrw), 16 as usize);
        _tlsrec_inc32(ws, ctrw);
        _tlsrec_aes_encrypt2(ws, bk, nr, ws, pair, ws, ks);
        let mut n: i64 = 0;
        loop {
            if n >= 32 { break; }
            if off + n >= len { break; }
            _tlsrec_put(dst, off + n, _tlsrec_at(src, off + n) ^ _tlsrec_at(ws, ks
                + n));
            n = n + 1;
        }
        off = off + 32;
    }
}

// ── GHASH (SP 800-38D §6.4) over GF(2^128) ────────────────────────
// Direct port of `ghash.sfn`'s masked-integer carryless multiplication —
// see that file for the correctness argument (worst-case intermediate
// 2^62.19, 0.813 bits under the i64 ceiling, independent of message length)
// and why there is no window table: one is indexed by values derived from
// the secret subkey H, and recovering H forges tags.
//
// Reverse the bits of a byte, branch-free and table-free (SP 800-38D numbers
// a block's bits MSB-first, so this converts to this module's word
// convention and back). Port of `_rev8`.
fn _tlsrec_ghash_rev8(b: i64) -> i64 {
    let mut x: i64 = b & 255;
    x = ((x & 85) << 1) | ((x >> 1) & 85);
    x = ((x & 51) << 2) | ((x >> 2) & 51);
    x = ((x & 15) << 4) | ((x >> 4) & 15);
    return x & 255;
}

// Carryless 32x32 -> 63-bit multiply. Port of `_clmul32`; see that file's
// header for the masked-integer argument.
fn _tlsrec_clmul32(x: i64, y: i64) -> i64 {
    let x0: i64 = x & 286331153;
    let x1: i64 = x & 572662306;
    let x2: i64 = x & 1145324612;
    let x3: i64 = x & 2290649224;
    let y0: i64 = y & 286331153;
    let y1: i64 = y & 572662306;
    let y2: i64 = y & 1145324612;
    let y3: i64 = y & 2290649224;
    let z0: i64 = (x0 * y0) ^ (x1 * y3) ^ (x2 * y2) ^ (x3 * y1);
    let z1: i64 = (x0 * y1) ^ (x1 * y0) ^ (x2 * y3) ^ (x3 * y2);
    let z2: i64 = (x0 * y2) ^ (x1 * y1) ^ (x2 * y0) ^ (x3 * y3);
    let z3: i64 = (x0 * y3) ^ (x1 * y2) ^ (x2 * y1) ^ (x3 * y0);
    return (z0 & 1229782938247303441) | (z1 & 2459565876494606882) | (z2 & 4919131752989213764) | (z3 & 614891469123651720);
}

// Convert the 4 bytes at `base[off + 4*k .. off + 4*k + 4)` into one
// coefficient word (bit `j` holding `x^(32k + j)`), per-byte bit-reversed.
// Port of one column of `_to_words`.
fn _tlsrec_ghash_word(base: *u8, off: i64, k: i64) -> i64 {
    let b0: i64 = _tlsrec_ghash_rev8(_tlsrec_at(base, off + 4 * k));
    let b1: i64 = _tlsrec_ghash_rev8(_tlsrec_at(base, off + 4 * k + 1));
    let b2: i64 = _tlsrec_ghash_rev8(_tlsrec_at(base, off + 4 * k + 2));
    let b3: i64 = _tlsrec_ghash_rev8(_tlsrec_at(base, off + 4 * k + 3));
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 4294967295;
}

// Inverse of `_tlsrec_ghash_word`: write the bit-reversed bytes of
// coefficient word `w` to `out[off..off+4)`. Port of one column of
// `_from_words`.
fn _tlsrec_ghash_put_word(out: *u8, off: i64, w: i64) -> void {
    _tlsrec_put(out, off, _tlsrec_ghash_rev8(w & 255));
    _tlsrec_put(out, off + 1, _tlsrec_ghash_rev8((w >> 8) & 255));
    _tlsrec_put(out, off + 2, _tlsrec_ghash_rev8((w >> 16) & 255));
    _tlsrec_put(out, off + 3, _tlsrec_ghash_rev8((w >> 24) & 255));
}

// Multiply coefficient-word values `(x0,x1,x2,x3)` by `(h0,h1,h2,h3)` in
// GF(2^128) (16 `_clmul32` calls accumulated, then reduced mod
// x^128 + x^7 + x^2 + x + 1), writing the 4-word result to `out4` (16
// bytes, little-endian words via `_tlsrec_put_le32`). Port of
// `_gf128_mul` + `_reduce`, algebraically inlined since this file has no
// multi-value return.
fn _tlsrec_gf128_mul(x0: i64, x1: i64, x2: i64, x3: i64, h0: i64, h1: i64, h2: i64, h3: i64, out4: *u8) -> void {
    let m: i64 = 4294967295;
    let c00: i64 = _tlsrec_clmul32(x0, h0);
    let c01: i64 = _tlsrec_clmul32(x0, h1);
    let c02: i64 = _tlsrec_clmul32(x0, h2);
    let c03: i64 = _tlsrec_clmul32(x0, h3);
    let c10: i64 = _tlsrec_clmul32(x1, h0);
    let c11: i64 = _tlsrec_clmul32(x1, h1);
    let c12: i64 = _tlsrec_clmul32(x1, h2);
    let c13: i64 = _tlsrec_clmul32(x1, h3);
    let c20: i64 = _tlsrec_clmul32(x2, h0);
    let c21: i64 = _tlsrec_clmul32(x2, h1);
    let c22: i64 = _tlsrec_clmul32(x2, h2);
    let c23: i64 = _tlsrec_clmul32(x2, h3);
    let c30: i64 = _tlsrec_clmul32(x3, h0);
    let c31: i64 = _tlsrec_clmul32(x3, h1);
    let c32: i64 = _tlsrec_clmul32(x3, h2);
    let c33: i64 = _tlsrec_clmul32(x3, h3);

    let p0: i64 = c00 & m;
    let p1: i64 = ((c00 >> 32) & m) ^ (c01 & m) ^ (c10 & m);
    let p2: i64 = ((c01 >> 32) & m) ^ ((c10 >> 32) & m) ^ (c02 & m) ^ (c11 & m) ^ (c20 & m);
    let p3: i64 = ((c02 >> 32) & m) ^ ((c11 >> 32) & m) ^ ((c20 >> 32) & m) ^ (c03 & m) ^ (c12 & m) ^ (c21 & m) ^ (c30 & m);
    let p4: i64 = ((c03 >> 32) & m) ^ ((c12 >> 32) & m) ^ ((c21 >> 32) & m) ^ ((c30 >> 32) & m) ^ (c13 & m) ^ (c22 & m) ^ (c31 & m);
    let p5: i64 = ((c13 >> 32) & m) ^ ((c22 >> 32) & m) ^ ((c31 >> 32) & m) ^ (c23 & m) ^ (c32 & m);
    let p6: i64 = ((c23 >> 32) & m) ^ ((c32 >> 32) & m) ^ (c33 & m);
    let p7: i64 = (c33 >> 32) & m;

    // Reduce: the high half (p4..p7) contributes hi * (x^7 + x^2 + x + 1),
    // which overruns 128 bits by at most 6 positions and folds entirely
    // into word 0 — one extra step suffices. Port of `_reduce`.
    let s7_0: i64 = (p4 << 7) & m;
    let s7_1: i64 = ((p5 << 7) | (p4 >> 25)) & m;
    let s7_2: i64 = ((p6 << 7) | (p5 >> 25)) & m;
    let s7_3: i64 = ((p7 << 7) | (p6 >> 25)) & m;
    let s7_4: i64 = (p7 >> 25) & m;

    let s2_0: i64 = (p4 << 2) & m;
    let s2_1: i64 = ((p5 << 2) | (p4 >> 30)) & m;
    let s2_2: i64 = ((p6 << 2) | (p5 >> 30)) & m;
    let s2_3: i64 = ((p7 << 2) | (p6 >> 30)) & m;
    let s2_4: i64 = (p7 >> 30) & m;

    let s1_0: i64 = (p4 << 1) & m;
    let s1_1: i64 = ((p5 << 1) | (p4 >> 31)) & m;
    let s1_2: i64 = ((p6 << 1) | (p5 >> 31)) & m;
    let s1_3: i64 = ((p7 << 1) | (p6 >> 31)) & m;
    let s1_4: i64 = (p7 >> 31) & m;

    let o: i64 = s7_4 ^ s2_4 ^ s1_4;
    let r0: i64 = (p0 ^ s7_0 ^ s2_0 ^ s1_0 ^ p4 ^ (((o << 7) ^ (o << 2) ^ (o << 1) ^ o) & m)) & m;
    let r1: i64 = (p1 ^ s7_1 ^ s2_1 ^ s1_1 ^ p5) & m;
    let r2: i64 = (p2 ^ s7_2 ^ s2_2 ^ s1_2 ^ p6) & m;
    let r3: i64 = (p3 ^ s7_3 ^ s2_3 ^ s1_3 ^ p7) & m;

    _tlsrec_put_le32(out4, 0, r0);
    _tlsrec_put_le32(out4, 4, r1);
    _tlsrec_put_le32(out4, 8, r2);
    _tlsrec_put_le32(out4, 12, r3);
}

// GHASH the AEAD input A ‖ pad16(A) ‖ C ‖ pad16(C) ‖ [len(A)]_64 ‖ [len(C)]_64
// (bit lengths, big-endian; SP 800-38D §7.1 step 5) under subkey `h` (16
// bytes), writing the 16-byte result to `out16`. `gtmp` is a caller-owned
// 16-byte scratch for `_tlsrec_gf128_mul`'s output and `tail` a caller-owned
// 48-byte scratch: [0,16) the padded AAD tail, [16,32) the padded ciphertext
// tail, [32,48) the length block — the same region-streaming technique
// `_tlsrec_poly1305_tag` above uses, so neither `aad` nor `ct` is ever
// concatenated into an intermediate buffer.
fn _tlsrec_ghash_tag(h: *u8, aad: *u8, aad_len: i64, ct: *u8, ct_len: i64, tail: *u8, out16: *u8, gtmp: *u8) -> void {
    memset(tail, 0, 48 as usize);
    let aad_full: i64 = aad_len / 16;
    let aad_rem: i64 = aad_len - aad_full * 16;
    if aad_rem > 0 {
        memcpy(tail, _tlsrec_ptr_off(aad, aad_full * 16), aad_rem as usize);
    }
    let ct_full: i64 = ct_len / 16;
    let ct_rem: i64 = ct_len - ct_full * 16;
    if ct_rem > 0 {
        memcpy(_tlsrec_ptr_off(tail, 16), _tlsrec_ptr_off(ct, ct_full * 16), ct_rem as usize);
    }
    let mut li: i64 = 0;
    loop {
        if li >= 8 { break; }
        _tlsrec_put(tail, 32 + li, (aad_len * 8) >> (8 * (7 - li)));
        _tlsrec_put(tail, 40 + li, (ct_len * 8) >> (8 * (7 - li)));
        li = li + 1;
    }

    let h0: i64 = _tlsrec_ghash_word(h, 0, 0);
    let h1: i64 = _tlsrec_ghash_word(h, 0, 1);
    let h2: i64 = _tlsrec_ghash_word(h, 0, 2);
    let h3: i64 = _tlsrec_ghash_word(h, 0, 3);

    let mut x0: i64 = 0;
    let mut x1: i64 = 0;
    let mut x2: i64 = 0;
    let mut x3: i64 = 0;

    let mut region: i64 = 0;
    loop {
        if region >= 5 { break; }
        let mut rp: i64 = 0;
        let mut rn: i64 = 0;
        if region == 0 {
            rp = aad as i64;
            rn = aad_full;
        } else if region == 1 {
            rp = tail as i64;
            if aad_rem > 0 { rn = 1; }
        } else if region == 2 {
            rp = ct as i64;
            rn = ct_full;
        } else if region == 3 {
            rp = (tail as i64) + 16;
            if ct_rem > 0 { rn = 1; }
        } else {
            rp = (tail as i64) + 32;
            rn = 1;
        }
        let base: *u8 = rp as *u8;
        let mut b: i64 = 0;
        loop {
            if b >= rn { break; }
            let o: i64 = b * 16;
            x0 = x0 ^ _tlsrec_ghash_word(base, o, 0);
            x1 = x1 ^ _tlsrec_ghash_word(base, o, 1);
            x2 = x2 ^ _tlsrec_ghash_word(base, o, 2);
            x3 = x3 ^ _tlsrec_ghash_word(base, o, 3);
            _tlsrec_gf128_mul(x0, x1, x2, x3, h0, h1, h2, h3, gtmp);
            x0 = _tlsrec_le32(gtmp, 0);
            x1 = _tlsrec_le32(gtmp, 4);
            x2 = _tlsrec_le32(gtmp, 8);
            x3 = _tlsrec_le32(gtmp, 12);
            b = b + 1;
        }
        region = region + 1;
    }

    _tlsrec_ghash_put_word(out16, 0, x0);
    _tlsrec_ghash_put_word(out16, 4, x1);
    _tlsrec_ghash_put_word(out16, 8, x2);
    _tlsrec_ghash_put_word(out16, 12, x3);
}

// ── AES-GCM (SP 800-38D) record-layer plumbing ────────────────────
// One malloc per record (never per byte), holding the S-box/cipher-core
// workspace, the raw and pre-bitsliced round keys, H, E(K, J0), the running
// J0/counter block, GHASH's region scratch, and its per-block product
// output. 96-bit nonces only — the shape RFC 8446 §5.3 uses — so
// J0 = nonce ‖ 0x00000001 and CTR data starts at inc32(J0), same as
// `aead_aes_gcm.sfn`.
//
// Region sizes, packed with no padding: ws `_tlsrec_aesws_bytes()` (144),
// ek 240 (the max FIPS-197 §5.2 expansion, AES-256's 15 * 16 bytes), bk 480
// (15 rounds * 32 bytes, the pre-bitsliced-round-key max), h/ekj0/j0/zero 16
// each, tail 48 (`_tlsrec_ghash_tag`'s region scratch), gtmp/s 16 each.
fn _tlsrec_ag_ws_off() -> i64 { return 0; }

fn _tlsrec_ag_ek_off() -> i64 { return 144; }

fn _tlsrec_ag_bk_off() -> i64 { return 384; }

fn _tlsrec_ag_h_off() -> i64 { return 864; }

fn _tlsrec_ag_ekj0_off() -> i64 { return 880; }

fn _tlsrec_ag_j0_off() -> i64 { return 896; }

fn _tlsrec_ag_zero_off() -> i64 { return 912; }

fn _tlsrec_ag_tail_off() -> i64 { return 928; }

fn _tlsrec_ag_gtmp_off() -> i64 { return 976; }

fn _tlsrec_ag_s_off() -> i64 { return 992; }

fn _tlsrec_ag_scratch_bytes() -> i64 { return 1008; }

// Key-schedule + H + E(K, J0) setup shared by seal and open. `scratch` must
// already be zeroed (so `_tlsrec_ag_zero_off()` is a real 16-byte zero
// block). `seq` is the record sequence number: J0 is derived from the
// **per-record** nonce (RFC 8446 §5.3 — the static write/read IV XORed with
// the big-endian sequence number, the same derivation
// `_tlsrec_derive_nonce` performs for ChaCha20), not the raw static IV; using
// the static IV for every record here reused one nonce across a whole
// connection, breaking GCM's confidentiality and authentication both.
// Returns the AES round count (10 or 14) or 0 on a bad key length.
fn _tlsrec_aesgcm_setup(scratch: *u8, key: *u8, key_len: i64, iv: *u8, seq: i64) -> i64 {
    let ws: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_ws_off());
    let ek: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_ek_off());
    let bk: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_bk_off());
    let ek_len: i64 = _tlsrec_aes_key_expand(ws, key, key_len, ek);
    if ek_len == 0 { return 0; }
    let bk_len: i64 = _tlsrec_aes_bs_keys(ws, ek, ek_len, bk);
    if bk_len == 0 { return 0; }
    let nr: i64 = bk_len / 32 - 1;

    let zero16: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_zero_off());
    let h: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_h_off());
    _tlsrec_aes_encrypt_block(ws, bk, nr, zero16, h);

    let j0: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_j0_off());
    let mut i: i64 = 0;
    loop {
        if i >= 12 { break; }
        let mut sb: i64 = 0;
        if i >= 4 { sb = (seq >> (8 * (11 - i))) & 255; }
        _tlsrec_put(j0, i, _tlsrec_at(iv, i) ^ sb);
        i = i + 1;
    }
    _tlsrec_put(j0, 12, 0);
    _tlsrec_put(j0, 13, 0);
    _tlsrec_put(j0, 14, 0);
    _tlsrec_put(j0, 15, 1);
    let ekj0: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_ekj0_off());
    _tlsrec_aes_encrypt_block(ws, bk, nr, j0, ekj0);
    return nr;
}

// ── Per-record scratch ───────────────────────────────────────────
// One allocation per record, never per byte. Layout:
//   [0,32)    32 zero bytes — the XOR source that turns `_tlsrec_chacha_apply`
//             into a plain keystream generator for the Poly1305 one-time key
//   [32,64)   the Poly1305 one-time key (ChaCha20 block 0)
//   [64,112)  `_tlsrec_poly1305_tag`'s 48-byte region scratch
//   [112,128) unused guard gap — `open` reads the nonce *after* computing the
//             tag, so an overrun of the region above would otherwise corrupt
//             the decryption nonce silently instead of faulting
//   [128,140) the per-record AEAD nonce
//   [140,156) the recomputed tag (open only)
fn _tlsrec_scratch_bytes() -> i64 { return 160; }

// Derive the per-record nonce (RFC 8446 §5.3) into `scratch[128..140)`: the
// 64-bit sequence number big-endian, left-padded with zeros to the 12-byte IV
// length, XORed with the static write_iv.
fn _tlsrec_derive_nonce(scratch: *u8, iv: *u8, seq: i64) -> void {
    let mut i: i64 = 0;
    loop {
        if i >= 12 { break; }
        let mut sb: i64 = 0;
        if i >= 4 { sb = (seq >> (8 * (11 - i))) & 255; }
        _tlsrec_put(scratch, 128 + i, _tlsrec_at(iv, i) ^ sb);
        i = i + 1;
    }
}

// ── Seal / open ──────────────────────────────────────────────────
// Recover the true inner content type by scanning back for the last
// non-zero octet (RFC 8446 §5.2/§5.4); an all-zero plaintext carries no
// content type. Returns `(content_type << 32) | content_len` or a negative
// `tls_record_err_*` code. Shared by every algorithm's `open` path, so the
// scan logic exists exactly once.
fn _tlsrec_recover_content_type(body: *u8, ct_len: i64) -> i64 {
    let mut idx: i64 = ct_len - 1;
    loop {
        if idx < 0 { break; }
        if _tlsrec_at(body, idx) != 0 { break; }
        idx = idx - 1;
    }
    if idx < 0 { return sfn_tls_record_err_no_content_type(); }
    if idx > sfn_tls_record_max_plaintext() {
        return sfn_tls_record_err_content_overflow();
    }
    return (_tlsrec_at(body, idx) << 32) | idx;
}

// Seal `content` (of true type `content_type`, `content_len` bytes) under
// algorithm `alg` (`_tlsrec_alg_chacha20_poly1305()` /
// `_tlsrec_alg_aes_128_gcm()` / `_tlsrec_alg_aes_256_gcm()`) into a TLS 1.3
// wire record written to `out`, appending `padding` zero bytes to the
// TLSInnerPlaintext. `out` receives the full TLSCiphertext: a 5-byte header
// (opaque_type=23 ‖ 0x0303 ‖ uint16 length) ‖ ciphertext ‖ 16-byte tag, and
// must be at least `5 + content_len + 1 + padding + 16` bytes. Encryption runs
// in place in `out`, so `content` may itself be `out + 5` (the zero-copy path);
// otherwise the content is copied in once with `memcpy`.
//
// `key_len` is checked against what `alg` itself requires
// (`_tlsrec_alg_key_len`), not a standalone constant — the reason is
// recorded on that function: AES-256-GCM's key is also 32 bytes, so a
// length-only check cannot tell it apart from a ChaCha20-Poly1305 key, and
// the algorithm selector must reach the point the cipher is chosen (SFN-817).
//
// Returns the number of bytes written to `out`, or a negative
// `tls_record_err_*` code. Every guard mirrors `tls13_seal_record_aead`,
// which fails closed by returning `[]`.
fn sfn_tls_record_seal(alg: i64, key: *u8, key_len: i64, iv: *u8, iv_len: i64, seq: i64, content_type: i64, content: *u8, content_len: i64, padding: i64, out: *u8) -> i64 {
    let want_key_len: i64 = _tlsrec_alg_key_len(alg);
    if want_key_len == 0 || key_len != want_key_len {
        return sfn_tls_record_err_bad_key_length();
    }
    if iv_len != 12 { return sfn_tls_record_err_bad_iv_length(); }
    if padding < 0 { return sfn_tls_record_err_negative_padding(); }
    // A negative `content_len` has no oracle analogue — `int[].length` is
    // non-negative by construction — so the differential can never reach it.
    // Unguarded it passes every size check (`inner_len` and `enc_len` go
    // negative) and then writes the content-type byte and the tag at negative
    // offsets, corrupting the heap before the caller's buffer.
    if content_len < 0 { return sfn_tls_record_err_content_overflow(); }
    if content_len > sfn_tls_record_max_plaintext() {
        return sfn_tls_record_err_content_overflow();
    }
    let inner_len: i64 = content_len + 1 + padding;
    let enc_len: i64 = inner_len + sfn_tls_record_tag_len();
    if enc_len > sfn_tls_record_max_encrypted() {
        return sfn_tls_record_err_record_overflow();
    }

    // The 5-byte header doubles as the AEAD's additional authenticated data.
    _tlsrec_put(out, 0, sfn_tls_record_application_data());
    _tlsrec_put(out, 1, 3);  // legacy_record_version 0x0303 (TLS 1.2), high byte
    _tlsrec_put(out, 2, 3);  // low byte
    _tlsrec_put(out, 3, (enc_len >> 8) & 255);
    _tlsrec_put(out, 4, enc_len & 255);

    // TLSInnerPlaintext = content ‖ ContentType ‖ zeros[padding], framed in
    // place at `out + 5`.
    let body: *u8 = _tlsrec_ptr_off(out, 5);
    if content_len > 0 && (content as i64) != (body as i64) {
        memcpy(body, content, content_len as usize);
    }
    _tlsrec_put(body, content_len, content_type);
    if padding > 0 {
        memset(_tlsrec_ptr_off(body, content_len + 1), 0, padding as usize);
    }

    if alg == _tlsrec_alg_chacha20_poly1305() {
        let scratch: *u8 = malloc(_tlsrec_scratch_bytes() as usize);
        if scratch as i64 == 0 { return sfn_tls_record_err_oom(); }
        memset(scratch, 0, _tlsrec_scratch_bytes() as usize);
        _tlsrec_derive_nonce(scratch, iv, seq);
        let otk: *u8 = _tlsrec_ptr_off(scratch, 32);
        let nonce: *u8 = _tlsrec_ptr_off(scratch, 128);
        _tlsrec_chacha_apply(key, nonce, 0, scratch, otk, 32);
        _tlsrec_chacha_apply(key, nonce, 1, body, body, inner_len);
        _tlsrec_poly1305_tag(otk, out, 5, body, inner_len, _tlsrec_ptr_off(scratch, 64), _tlsrec_ptr_off(body, inner_len));
        free(scratch);
        return 5 + enc_len;
    }

    // AES-128-GCM / AES-256-GCM (distinguished only by `key_len`, already
    // checked above against `alg`).
    let scratch: *u8 = malloc(_tlsrec_ag_scratch_bytes() as usize);
    if scratch as i64 == 0 { return sfn_tls_record_err_oom(); }
    memset(scratch, 0, _tlsrec_ag_scratch_bytes() as usize);
    let nr: i64 = _tlsrec_aesgcm_setup(scratch, key, key_len, iv, seq);
    if nr == 0 {
        free(scratch);
        return sfn_tls_record_err_bad_key_length();
    }
    let ws: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_ws_off());
    let bk: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_bk_off());
    // CTR data starts at inc32(J0) = nonce ‖ 0x00000002; `_tlsrec_aesgcm_setup`
    // left J0 itself at this offset, already spent for E(K, J0).
    let ctr0: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_j0_off());
    _tlsrec_inc32(ctr0, 0);
    _tlsrec_aes_ctr_xor(ws, bk, nr, ctr0, body, body, inner_len);

    let h: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_h_off());
    let tail: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_tail_off());
    let gtmp: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_gtmp_off());
    let s: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_s_off());
    _tlsrec_ghash_tag(h, out, 5, body, inner_len, tail, s, gtmp);
    let ekj0: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_ekj0_off());
    let mut i: i64 = 0;
    loop {
        if i >= 16 { break; }
        _tlsrec_put(body, inner_len + i, _tlsrec_at(ekj0, i) ^ _tlsrec_at(s, i));
        i = i + 1;
    }
    free(scratch);
    return 5 + enc_len;
}

// Open a TLS 1.3 wire record (`record` = 5-byte header ‖ encrypted_record,
// `record_len` bytes total) under algorithm `alg`, `key` / `iv` at sequence
// number `seq`.
//
// Decryption is in place: on success the recovered content occupies
// `record[5 .. 5 + content_len)` and the trailing content-type byte, padding,
// and tag are left as spent bytes. Returns `(content_type << 32) | content_len`
// — always non-negative, since the all-zero-plaintext guard rules out a zero
// content type — or a negative `tls_record_err_*` code.
//
// The guards run in the same order as `tls13_open_record_aead`, so a
// malformed record is rejected at the same point by both implementations,
// and all of them run before any decryption: the work done is bounded by the
// record length. The tag is verified before the plaintext is produced —
// including for AES-GCM, where GHASH runs, then EKJ0 is XORed in and
// compared, strictly before `_tlsrec_aes_ctr_xor` touches `body`.
fn sfn_tls_record_open(alg: i64, key: *u8, key_len: i64, iv: *u8, iv_len: i64, seq: i64, record: *u8, record_len: i64) -> i64 {
    let want_key_len: i64 = _tlsrec_alg_key_len(alg);
    if want_key_len == 0 || key_len != want_key_len {
        return sfn_tls_record_err_bad_key_length();
    }
    if iv_len != 12 { return sfn_tls_record_err_bad_iv_length(); }
    if record_len < 5 { return sfn_tls_record_err_short_header(); }
    if _tlsrec_at(record, 0) != sfn_tls_record_application_data() {
        return sfn_tls_record_err_unexpected_type();
    }
    let declared: i64 = (_tlsrec_at(record, 3) << 8) | _tlsrec_at(record, 4);
    if declared != record_len - 5 {
        return sfn_tls_record_err_length_mismatch();
    }
    if declared > sfn_tls_record_max_encrypted() {
        return sfn_tls_record_err_record_overflow();
    }
    if declared < sfn_tls_record_tag_len() {
        return sfn_tls_record_err_short_encrypted_record();
    }
    let ct_len: i64 = declared - sfn_tls_record_tag_len();
    let body: *u8 = _tlsrec_ptr_off(record, 5);

    if alg == _tlsrec_alg_chacha20_poly1305() {
        let scratch: *u8 = malloc(_tlsrec_scratch_bytes() as usize);
        if scratch as i64 == 0 { return sfn_tls_record_err_oom(); }
        memset(scratch, 0, _tlsrec_scratch_bytes() as usize);
        _tlsrec_derive_nonce(scratch, iv, seq);
        let otk: *u8 = _tlsrec_ptr_off(scratch, 32);
        let nonce: *u8 = _tlsrec_ptr_off(scratch, 128);
        _tlsrec_chacha_apply(key, nonce, 0, scratch, otk, 32);
        _tlsrec_poly1305_tag(otk, record, 5, body, ct_len, _tlsrec_ptr_off(scratch, 64), _tlsrec_ptr_off(scratch, 140));
        if !_tlsrec_ct_eq16(scratch, 140, body, ct_len) {
            free(scratch);
            return sfn_tls_record_err_auth_failed();
        }
        _tlsrec_chacha_apply(key, nonce, 1, body, body, ct_len);
        free(scratch);
        return _tlsrec_recover_content_type(body, ct_len);
    }

    // AES-128-GCM / AES-256-GCM.
    let scratch: *u8 = malloc(_tlsrec_ag_scratch_bytes() as usize);
    if scratch as i64 == 0 { return sfn_tls_record_err_oom(); }
    memset(scratch, 0, _tlsrec_ag_scratch_bytes() as usize);
    let nr: i64 = _tlsrec_aesgcm_setup(scratch, key, key_len, iv, seq);
    if nr == 0 {
        free(scratch);
        return sfn_tls_record_err_bad_key_length();
    }

    let h: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_h_off());
    let tail: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_tail_off());
    let gtmp: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_gtmp_off());
    let s: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_s_off());
    _tlsrec_ghash_tag(h, record, 5, body, ct_len, tail, s, gtmp);
    let ekj0: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_ekj0_off());
    let mut i: i64 = 0;
    loop {
        if i >= 16 { break; }
        _tlsrec_put(s, i, _tlsrec_at(ekj0, i) ^ _tlsrec_at(s, i));
        i = i + 1;
    }
    if !_tlsrec_ct_eq16(s, 0, body, ct_len) {
        free(scratch);
        return sfn_tls_record_err_auth_failed();
    }

    let ws: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_ws_off());
    let bk: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_bk_off());
    let ctr0: *u8 = _tlsrec_ptr_off(scratch, _tlsrec_ag_j0_off());
    _tlsrec_inc32(ctr0, 0);
    _tlsrec_aes_ctr_xor(ws, bk, nr, ctr0, body, body, ct_len);
    free(scratch);
    return _tlsrec_recover_content_type(body, ct_len);
}
