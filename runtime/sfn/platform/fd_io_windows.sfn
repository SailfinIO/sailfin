// runtime/sfn/platform/fd_io_windows.sfn
//
// Windows sibling of `fd_io.sfn`, swapped in for a Windows target by
// `target_condition_runtime_sfn_sources`
// (`compiler/src/build/target.sfn`). See that module's header for the
// full rationale (SFN-927): the UCRT's `_read`/`_write` are `int`
// (32-bit), not POSIX's `ssize_t` (64-bit), so a raw `-> i64` extern
// against them silently promotes a `-1` error into `4294967295`.
//
// `_read`/`_write` (not `read`/`write`) — the UCRT spells the low-fd
// stdio/file/pipe primitives with a leading underscore; unlike
// `close`/`closesocket` (`socket_ops_windows.sfn`), there is no
// fastfail hazard here, only the width mismatch.
extern fn _read(fd: i32, buf: *u8, count: i32) -> i32;

extern fn _write(fd: i32, buf: *u8, count: i32) -> i32;

// Sign-extend the UCRT's 32-bit result to i64 so the `if n <= 0` /
// `if n < 0` guards throughout `io.sfn`/`assert.sfn` see the true
// negative-error signal instead of a truncated positive count
// (SFN-927).
fn sfn_fd_read(fd: i32, buf: *u8, count: usize) -> i64 {
    let n: i32 = _read(fd, buf, count as i32);
    return n as i64;
}

fn sfn_fd_write(fd: i32, buf: *u8, count: usize) -> i64 {
    let n: i32 = _write(fd, buf, count as i32);
    return n as i64;
}

export { sfn_fd_read, sfn_fd_write };
