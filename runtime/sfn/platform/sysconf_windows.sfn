// Windows provider for the scheduler's narrow `sysconf` dependency.
//
// Kept separate from `pthread_windows.sfn` because MinGW already ships
// winpthreads while MSVC does not. Both Windows ABIs lack POSIX `sysconf`, so
// they share only this CPU-count shim and select their pthread provider
// independently (SFN-775).
extern fn GetSystemInfo(info: *u8) -> void;

struct SfnWinSystemInfo {
    _opaque0: i64;
    _opaque1: i64;
    _opaque2: i64;
    _opaque3: i64;
    _opaque4: i64;
    _opaque5: i64;
}

// `dwNumberOfProcessors` is the i32 at byte offset 32 in x86_64
// `SYSTEM_INFO`. The only caller asks for `_SC_NPROCESSORS_ONLN`, so the
// request code itself is intentionally unused.
fn sysconf(name: i32) -> i64 {
    let mut info: SfnWinSystemInfo = SfnWinSystemInfo {
        _opaque0: 0,
        _opaque1: 0,
        _opaque2: 0,
        _opaque3: 0,
        _opaque4: 0,
        _opaque5: 0
    };
    let info_ptr: *SfnWinSystemInfo = & info;
    GetSystemInfo(info_ptr as *u8);
    let count_ptr: *i32 = ((info_ptr as i64) + 32) as *i32;
    let count: i32 = sailfin_intrinsic_pointer_read_i32(count_ptr);
    return count as i64;
}
