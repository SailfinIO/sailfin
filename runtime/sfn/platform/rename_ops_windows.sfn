// runtime/sfn/platform/rename_ops_windows.sfn
//
// Windows sibling of `rename_ops.sfn`, swapped in for a Windows target
// by `target_condition_runtime_sfn_sources`
// (`compiler/src/build/target.sfn`). See that module's header for why
// the operation is conditioned at all; the short version is that the
// CRT's `rename()` fails `EEXIST` on an existing destination where
// POSIX `rename(2)` atomically replaces, which broke every republish in
// the toolchain (SFN-720).
//
// `MoveFileExA` with `MOVEFILE_REPLACE_EXISTING` is the direct Win32
// equivalent and is atomic within a volume. Verified against Win32
// rather than assumed:
//
//   MOVEFILE_REPLACE_EXISTING  = 0x1
//   replace over EXISTING dst  -> ok=1, dst holds the new bytes,
//                                 src no longer exists
//   replace onto ABSENT dst    -> ok=1
//
// One call therefore covers both cases, so no "does the destination
// exist" probe is needed — and adding one would be worse than useless,
// since it would reintroduce exactly the check-then-act race the atomic
// publish exists to avoid.
//
// `ReplaceFileA` was the alternative. It preserves the destination's
// ACLs and attributes, but it REQUIRES the destination to exist, so it
// would need the caller to branch on existence — the race above — and
// the artifacts published here are build outputs with no ACLs worth
// preserving. `MoveFileExA` is the better fit.
//
// Delete-then-rename was rejected outright: it is not atomic and leaves
// a window in which neither file is present, which a concurrent reader
// (the parallel emit fan-out publishes objects this way) could observe.
//
// The direct replace above still fails when `dst` is the running
// compiler's own image: Windows locks a running image's *path* (not its
// bytes), so `MoveFileExA` onto it returns `ok=0 err=5`
// (`ERROR_ACCESS_DENIED` — the observed failure code of the direct
// replace, nothing more) even though the OS permits RENAMING a running
// image aside. Measured against a genuinely running process:
//
//   replace RUNNING exe directly                                       ok=0 err=5 (ERROR_ACCESS_DENIED)
//   MoveFileExA(RUNNING exe, EXISTING .old, MOVEFILE_REPLACE_EXISTING)  ok=1 err=0
//   MoveFileExA(RUNNING .old, original path, MOVEFILE_REPLACE_EXISTING) ok=1 err=0
//   DeleteFileA on the displaced running image                         ok=0 err=5
//
// So `sfn_rename_replace` unconditionally falls back to a
// displace-then-publish sequence whenever the direct replace fails for
// ANY reason: rename `dst` aside onto the reserved `dst + ".old"` name,
// move `src` into the now-vacant `dst`, and leave the displaced file at
// `.old` rather than deleting it. `<dst>.old` is a name this function
// owns — step 3 below overwrites it unconditionally, both sweeping the
// previous generation's `.old` and displacing a currently-locked image
// in the same `MOVEFILE_REPLACE_EXISTING` call, which is why no
// `DeleteFileA` is needed: `DeleteFileA` on a running image fails the
// same `ERROR_ACCESS_DENIED`, so a best-effort delete after a successful
// publish would be dead code on exactly the path that needs it.
//
// The fallback is unconditional rather than gated on a specific error
// code: it is only entered where the atomic form already returned
// failure, so it can only turn a failure into a success — it never
// weakens a call that succeeds today. This is also the POSIX-faithful
// behaviour: `rename(2)` displaces regardless of readers.
//
// This is a different failure mode than the delete-then-rename rejection
// above, and does not reopen it: displace-then-publish never destroys
// `dst`'s bytes (they survive at `.old`, and step 5 restores them on
// failure) and never deletes a locked file, so the concurrent-reader gap
// that rejection was about does not apply here.
extern fn MoveFileExA(existing: *u8, new_name: *u8, flags: i32) -> i32;

// `MOVEFILE_REPLACE_EXISTING`. Named rather than inlined because `1` at
// a call site says nothing, and the whole point of this module is that
// flag.
let MOVEFILE_REPLACE_EXISTING: i32 = 1;

// Move `src` onto `dst`, replacing `dst` if present. Returns 0 on
// success and non-zero on failure, matching `rename(2)`'s convention —
// note this INVERTS `MoveFileExA`, which returns non-zero for success.
fn sfn_rename_replace(src: *u8, dst: *u8) -> i32 {
    if MoveFileExA(src, dst, MOVEFILE_REPLACE_EXISTING) != 0 { return 0; }

    // Per the cast-quirk note in `exec.sfn`'s module header: route the
    // destination through a `string`-typed local before concatenating,
    // never cast a literal directly — `dst as string` extracts the
    // pointer through the alloca-backed parameter slot, which lowers
    // correctly.
    let dst_str: string = dst as string;
    let sideline_str: string = dst_str + ".old";
    let sideline: *u8 = sideline_str as *u8;

    if MoveFileExA(dst, sideline, MOVEFILE_REPLACE_EXISTING) == 0 { return -1; }
    if MoveFileExA(src, dst, MOVEFILE_REPLACE_EXISTING) != 0 { return 0; }

    // Rollback: best-effort restore of the displaced image. Its result
    // is ignored — there is no better fallback to report, and `dst`
    // being left absent (the only failure mode here) is still no worse
    // than the `-1` this returns.
    MoveFileExA(sideline, dst, MOVEFILE_REPLACE_EXISTING);
    return -1;
}

export { sfn_rename_replace };
