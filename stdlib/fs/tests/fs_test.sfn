// Tests for sfn/fs — P5 (#366) gap-fill primitives. Permission and executable
// assertions follow the host contract; temp directories, directory probes,
// symlinks, and raw link reads have native Windows behavior.
//
// Tests use `mkdtemp` itself to mint a per-test scratch dir so the
// suite is hermetic — no fixed scratch paths and no races between parallel
// test invocations.
import { find, replace } from "sfn/strings";
import { skip } from "sfn/test";

import {
    exists,
    get_perms,
    is_directory,
    is_executable,
    mkdir,
    mkdtemp,
    read,
    read_dir,
    read_link,
    remove,
    set_perms,
    symlink,
    write
} from "../src/mod";

// True when the test runner is a Windows binary. Mirrors the detection
// idiom in `compiler/tests/e2e/rename_running_image_windows_test.sfn`: the
// `OS` / `SYSTEMROOT` / `windir` environment variables Windows always sets.
fn _is_windows() -> bool ![io] {
    let os = env.get("OS");
    if find(os, "Windows", 0) >= 0 { return true; }
    if env.get("SYSTEMROOT").length > 0 { return true; }
    if env.get("windir").length > 0 { return true; }
    return false;
}

fn _require_symlink(target: string, link: string) -> void ![io] {
    if symlink(target, link) { return; }
    if _is_windows() {
        skip("SFN-1143: Windows symlink creation unavailable; remove this skip when runners guarantee Developer Mode or SeCreateSymbolicLinkPrivilege");
        return;
    }
    assert false;
}

fn _stored_link_target(target: string) -> string ![io] {
    if _is_windows() { return replace(target, "/", "\\"); }
    return target;
}

// ---------------------------------------------------------------------
// Permission constants. The seed parser doesn't yet accept octal
// literals (`0o644`); decimal is the canonical form per the issue's
// "do not block on parser changes" guidance. The comments document
// the POSIX intent so the round-trip values aren't magic.
// ---------------------------------------------------------------------
//   420 = 0o644 = rw-r--r--   (typical regular-file perms)
//   384 = 0o600 = rw-------   (private file)
//   493 = 0o755 = rwxr-xr-x   (typical executable)
//   448 = 0o700 = rwx------   (mkdtemp's documented mode)
// ---------------------------------------------------------------------
// ── set_perms / get_perms ──────────────────────────────────────────
test "fs: set_perms + get_perms round-trip on a regular file" ![io] {
    let scratch = mkdtemp("sfn-fs-test-perms-");
    assert scratch.length > 0;
    let target = scratch + "/file.txt";
    write(target, "round-trip");

    if _is_windows() {
        // SFN-1141: UCRT accepts the chmod-shaped write, but Windows has no
        // POSIX mode bits for get_perms to return. Keep both public calls
        // covered; replace this branch only if a target-neutral permission
        // model supersedes the documented -1 sentinel.
        assert set_perms(target, 420);
        assert get_perms(target) == -1;
        process.run(["rm", "-rf", scratch]);
        return;
    }

    // 420 = 0o644
    assert set_perms(target, 420);
    assert get_perms(target) == 420;

    // 384 = 0o600 — confirm we can flip an existing file's bits.
    assert set_perms(target, 384);
    assert get_perms(target) == 384;

    process.run(["rm", "-rf", scratch]);
}

test "fs: set_perms returns false on a missing path" ![io] {
    // chmod on a non-existent path must surface as `false`, not
    // silently report success. The negative path is what callers
    // rely on when they don't want to pre-check existence.
    assert set_perms("/tmp/sfn-fs-test-missing-path-XXXX", 420) == false;
}

test "fs: get_perms returns -1 on a missing path" ![io] {
    // Per the issue spec: missing files map to a sentinel error
    // value, not a permission-bit collision. -1 is unambiguous
    // because `st_mode & 07777` can never produce a negative.
    assert get_perms("/tmp/sfn-fs-test-missing-path-XXXX") == -1;
}

// ── mkdtemp ────────────────────────────────────────────────────────
test "fs: mkdtemp creates a unique directory with mode 0700" ![io] {
    let path = mkdtemp("sfn-fs-test-mkd-");
    assert path.length > 0;
    assert exists(path);
    if _is_windows() {
        // Windows has no mode bits — the directory inherits the parent
        // ACL instead of a POSIX permission mode, and `get_perms`'
        // Windows leg is a pre-existing `-1` stub (predates SFN-993,
        // which only adds this skip — mkdtemp itself is fixed there,
        // not get_perms), so the POSIX 0700 assertion below cannot
        // hold here. Skip loudly rather than silently pass or weaken
        // the POSIX assertion.
        skip("Windows has no mode bits (ACL, not 0700); get_perms is a -1 stub there");
    }
    // 448 = 0o700 — `mkdtemp(3)` is documented to create the dir
    // with this mode regardless of umask.
    assert get_perms(path) == 448;

    process.run(["rmdir", path]);
}

test "fs: mkdtemp returns distinct, existing directories across calls" ![io] {
    // Kernel-side uniqueness — two calls in quick succession must
    // never collide. This is the whole reason for using
    // `mkdtemp(3)` (or, on Windows, the `CreateDirectoryA` retry loop
    // in `runtime/sfn/platform/mkdtemp_windows.sfn`, SFN-993) instead
    // of generate-then-mkdir.
    let a = mkdtemp("sfn-fs-test-uniq-");
    let b = mkdtemp("sfn-fs-test-uniq-");
    assert a.length > 0;
    assert b.length > 0;
    assert strings_equal(a, b) == false;
    assert exists(a);
    assert exists(b);
    assert is_directory(a);
    assert is_directory(b);

    process.run(["rmdir", a]);
    process.run(["rmdir", b]);
}

// ── is_executable ──────────────────────────────────────────────────
test "fs: is_executable returns true for /bin/sh" ![io] {
    if _is_windows() {
        // SFN-1141: Windows defines this probe as accessible-path existence,
        // not an execute bit. COMSPEC is a native executable known to exist;
        // remove this branch only if Windows gains executable-mode metadata.
        assert is_executable(env.get("COMSPEC"));
        return;
    }
    // `/bin/sh` is POSIX-mandated. If a host doesn't have it, the
    // rest of the runtime's `process.run`-based tests would already
    // be broken — so this is a safe sentinel.
    assert is_executable("/bin/sh");
}

test "fs: is_executable returns false for /etc/passwd" ![io] {
    if _is_windows() {
        // The Windows contract is existence, so an ordinary existing file is
        // true rather than POSIX non-executable. SFN-1141 owns this exclusion.
        let scratch = mkdtemp("sfn-fs-test-existing-");
        let target = scratch + "/plain.txt";
        write(target, "plain");
        assert is_executable(target);
        process.run(["rm", "-rf", scratch]);
        return;
    }
    // /etc/passwd exists on every POSIX system but is never `+x`.
    assert is_executable("/etc/passwd") == false;
}

test "fs: is_executable returns false for a missing path" ![io] {
    // Missing files collapse to `false` rather than surfacing an
    // error — matches Rust's `Path::exists`-style probe APIs.
    assert is_executable("/tmp/sfn-fs-test-missing-exec-XXXX") == false;
}

test "fs: is_executable tracks set_perms flips" ![io] {
    let scratch = mkdtemp("sfn-fs-test-exec-");
    let script = scratch + "/probe.sh";
    write(script, "#!/bin/sh\nexit 0\n");

    if _is_windows() {
        // SFN-1141: chmod cannot create or clear a POSIX execute bit on
        // Windows; is_executable remains the documented existence probe.
        // Remove this branch only if that public contract changes.
        assert set_perms(script, 420);
        assert is_executable(script);
        assert set_perms(script, 493);
        assert is_executable(script);
        process.run(["rm", "-rf", scratch]);
        return;
    }

    // 420 = 0o644 — readable but not executable.
    assert set_perms(script, 420);
    assert is_executable(script) == false;

    // 493 = 0o755 — owner exec bit set.
    assert set_perms(script, 493);
    assert is_executable(script);

    process.run(["rm", "-rf", scratch]);
}

// ── is_directory ──────────────────────────────────────────────────
test "fs: is_directory returns true for a directory" ![io] {
    let scratch = mkdtemp("sfn-fs-test-isdir-");
    assert scratch.length > 0;
    assert is_directory(scratch);

    process.run(["rmdir", scratch]);
}

test "fs: is_directory returns false for a regular file" ![io] {
    let scratch = mkdtemp("sfn-fs-test-isdir-file-");
    let target = scratch + "/file.txt";
    write(target, "not a directory");

    assert is_directory(target) == false;

    process.run(["rm", "-rf", scratch]);
}

test "fs: is_directory returns false for a missing path" ![io] {
    // Missing files collapse to `false` rather than surfacing an
    // error — matches `is_executable`'s probe-style semantics.
    assert is_directory("/tmp/sfn-fs-test-missing-dir-XXXX") == false;
}

test "fs: is_directory follows a symlink to a directory" ![io] {
    // `stat` follows symlinks, so a symlink pointing at a directory
    // must read as `true`, not `false`. This deliberately matches
    // `list_directory`'s `opendir` behaviour rather than treating the
    // link itself as the answer — the case most likely to regress if
    // the implementation switched to `lstat`.
    let scratch = mkdtemp("sfn-fs-test-isdir-link-");
    let dir = scratch + "/target-dir";
    let link = scratch + "/alias";
    mkdir(dir);

    _require_symlink(dir, link);
    assert is_directory(link);

    process.run(["rm", "-rf", scratch]);
}

// ── symlink ────────────────────────────────────────────────────────
test "fs: symlink creates a link readable through the target" ![io] {
    let scratch = mkdtemp("sfn-fs-test-link-");
    let target = scratch + "/target.txt";
    let link = scratch + "/alias";
    write(target, "linked-content");

    _require_symlink(target, link);
    // Read through the symlink — exercises both `symlink(2)`
    // creating the link and the kernel resolving it on open.
    assert strings_equal(read(link), "linked-content");

    process.run(["rm", "-rf", scratch]);
}

test "fs: symlink accepts a dangling target" ![io] {
    // POSIX `symlink(2)` does not require the target to exist;
    // dangling links are valid. The C runtime preserves that.
    let scratch = mkdtemp("sfn-fs-test-dangling-");
    let link = scratch + "/dangling";
    let nonexistent = scratch + "/never-created";

    _require_symlink(nonexistent, link);
    // `read_link` observes the link node itself on both platforms. Do not
    // assert through `exists`: POSIX `stat` follows the dangling target,
    // while Windows GetFileAttributesA reports the reparse point itself.
    assert strings_equal(read_link(link), _stored_link_target(nonexistent));

    process.run(["rm", "-rf", scratch]);
}

test "fs: symlink returns false when link path already exists" ![io] {
    // POSIX rejects `symlink(2)` when the `link` path already
    // exists. The wrapper should surface that as `false`, not
    // a silent overwrite.
    let scratch = mkdtemp("sfn-fs-test-collision-");
    let link = scratch + "/already-there";
    write(link, "occupant");

    assert symlink("/tmp", link) == false;

    process.run(["rm", "-rf", scratch]);
}

// ── read_link ──────────────────────────────────────────────────────
// `read_link` is a single-hop `readlink(2)` reader (SFN-46): it returns
// the raw target text exactly as stored in the link, never canonicalized.
test "fs: read_link returns the raw target of a symlink" ![io] {
    let scratch = mkdtemp("sfn-fs-test-readlink-");
    let target = scratch + "/target.txt";
    let link = scratch + "/alias";
    write(target, "linked-content");

    _require_symlink(target, link);
    // The raw target is the stored absolute path, with Win32-native
    // separators on Windows and no resolution of the target's contents.
    assert strings_equal(read_link(link), _stored_link_target(target));

    process.run(["rm", "-rf", scratch]);
}

test "fs: read_link returns a relative target uncanonicalized" ![io] {
    // Single-hop semantics: a relative target is returned exactly as
    // stored, with Win32-native separators on Windows, NOT resolved to an absolute path the way
    // `readlink -f` would. This is the invariant the llms.txt drift
    // guard relies on.
    let scratch = mkdtemp("sfn-fs-test-readlink-rel-");
    let link = scratch + "/rel-alias";

    _require_symlink("../sibling", link);
    assert strings_equal(read_link(link), _stored_link_target("../sibling"));

    process.run(["rm", "-rf", scratch]);
}

test "fs: read_link on a non-symlink returns empty" ![io] {
    // A regular file is not a symlink, so `readlink(2)` fails
    // (EINVAL) and the wrapper collapses it to "".
    let scratch = mkdtemp("sfn-fs-test-readlink-plain-");
    let plain = scratch + "/regular.txt";
    write(plain, "not a link");

    assert read_link(plain).length == 0;

    process.run(["rm", "-rf", scratch]);
}

test "fs: read_link on a missing path returns empty" ![io] {
    // A path that does not exist (ENOENT) also collapses to "".
    let scratch = mkdtemp("sfn-fs-test-readlink-missing-");

    assert read_link(scratch + "/never-created").length == 0;

    process.run(["rm", "-rf", scratch]);
}

// ── read_dir (list_directory) ──────────────────────────────────────
// Exercises the pure-Sailfin `sfn_fs_list_dir` body (#1317): it must
// build a real `string[]` of the directory's entries, omit the `.`
// and `..` pseudo-entries, and return them sorted ascending. Files
// are written out of order to prove the sort runs.
test "fs: read_dir lists entries sorted, omitting . and .." ![io] {
    let scratch = mkdtemp("sfn-fs-test-listdir-");
    assert scratch.length > 0;
    write(scratch + "/charlie.txt", "c");
    write(scratch + "/alpha.txt", "a");
    write(scratch + "/bravo.txt", "b");

    let entries = read_dir(scratch);
    // Exactly the three files — `.`/`..` are filtered out.
    assert entries.length == 3;
    // Sorted ascending by byte order (libc `strcmp`).
    assert strings_equal(entries[0], "alpha.txt");
    assert strings_equal(entries[1], "bravo.txt");
    assert strings_equal(entries[2], "charlie.txt");

    process.run(["rm", "-rf", scratch]);
}

// An empty directory lists as a zero-length array (never null), so
// callers can iterate it unconditionally.
test "fs: read_dir on an empty directory is empty" ![io] {
    let scratch = mkdtemp("sfn-fs-test-emptydir-");
    assert scratch.length > 0;

    let entries = read_dir(scratch);
    assert entries.length == 0;

    process.run(["rm", "-rf", scratch]);
}
