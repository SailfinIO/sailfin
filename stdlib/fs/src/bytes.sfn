// sfn/fs/bytes — binary-safe file I/O.
//
// `read`/`write` in `mod.sfn` round-trip through a Sailfin `string`, whose
// length is recovered by a NUL scan at the coercion boundary, so a file
// carrying an interior NUL cannot survive the trip — `read` now aborts on
// one rather than returning a truncated result. `FileBytes` carries a raw
// heap buffer plus an explicit length instead, so binary content (interior
// NULs included) round-trips intact (SFN-1008).
//
// Externs redeclared per-module (the #306 cross-module-extern limit) —
// spelling matches `capsules/sfn/os/src/mod.sfn`.
extern fn malloc(size: usize) -> *u8;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

// Stdio externs backing `copy`'s streaming chunk loop (SFN-1008), spelled
// exactly as `capsules/sfn/archive/src/tar_read.sfn`'s chunked file-to-file
// copy.
extern fn fopen(path: *u8, mode: *u8) -> *File;

extern fn fclose(f: *File) -> i32;

extern fn fread(buf: *u8, size: usize, nmemb: usize, f: *File) -> usize;

extern fn fwrite(buf: *u8, size: usize, nmemb: usize, f: *File) -> usize;

extern fn ferror(f: *File) -> i32;

// `addr` is a libc-`malloc`'d buffer the caller owns, released via
// `free_bytes` exactly once per `status == 0` result. `length` is the true
// byte count, including interior NULs. `status`: 0 ok, 1 not found, 2
// unreadable / IO error, 3 allocation failure. A genuinely empty file is
// `status == 0`, `length == 0`, and a non-zero `addr` — that keeps it
// distinguishable from a failure (all of which report `addr == 0`), a
// distinction plain `fs.read`/`fs.readFile` collapses (SFN-659).
//
// The status codes are documented here rather than exported as named
// constants because an imported module-level `let` lowers to `internal
// global` with no cross-capsule import path (the `[capsule]` block near the
// top of `compiler/capsule.toml`).
//
// `compiler/src/build/fs.sfn`'s same-named `FileBytes` is the hardened
// compiler-internal sibling: it shares this status vocabulary for codes
// 0-3 but additionally caps the read size (`4`) and guards against
// no-progress reads (`5`). This one has no size cap or loop guard, so
// codes `4` and `5` are unused here.
struct FileBytes {
    addr: int;
    length: int;
    status: int;
}

fn read_bytes(path: string) -> FileBytes ![io] {
    if !fs.exists(path) {
        return FileBytes { addr: 0, length: 0, status: 1 };
    }

    let out: *u8 = malloc(8 as usize);
    if out as i64 == 0 {
        return FileBytes { addr: 0, length: 0, status: 3 };
    }
    memset(out, 0, 8 as usize);

    let buf: *u8 = fs.read_bytes(path, out);
    if buf as i64 == 0 {
        free(out);
        return FileBytes { addr: 0, length: 0, status: 2 };
    }

    // Decode the little-endian 8-byte out-param the adapter stored the
    // binary length into (mirrors the out-param store loop in
    // `sfn_fs_read_bytes`, `runtime/sfn/adapters/filesystem.sfn`).
    let mut len: int = 0;
    let mut k: int = 0;
    loop {
        if k >= 8 { break; }
        len = len | (load_byte((out as i64) + k) << (k * 8));
        k += 1;
    }
    free(out);

    return FileBytes { addr: buf as i64, length: len, status: 0 };
}

fn write_bytes(path: string, data: FileBytes) -> boolean ![io] {
    if data.status != 0 { return false; }
    return fs.write_bytes(path, data.addr, data.length);
}

fn byte_at(data: FileBytes, index: int) -> int {
    if index < 0 { return -1; }
    if index >= data.length { return -1; }
    return load_byte(data.addr + (index as i64)) as int;
}

fn free_bytes(data: FileBytes) -> void {
    if data.addr != 0 { free(data.addr as *u8); }
}

// Streams `src` to `dst` in 65536-byte chunks rather than buffering the
// whole file, so peak memory is bounded by the chunk size rather than the
// file size — compiled user programs carry no `RLIMIT_AS`
// (`.claude/rules/compiler-safety.md`), so a whole-file buffer-then-write
// is an unbounded transient allocation. Mirrors
// `compiler/src/build/fs.sfn`'s `_copy_file_counted`.
fn copy(src: string, dst: string) -> boolean ![io] {
    let read_mode: string = "rb";
    let f: *File = fopen(src as *u8, read_mode as *u8);
    if (f as i64) == 0 { return false; }

    let write_mode: string = "wb";
    let out: *File = fopen(dst as *u8, write_mode as *u8);
    if (out as i64) == 0 {
        fclose(f);
        return false;
    }

    let chunk: int = 65536;
    let chunk_buf: *u8 = malloc(chunk as usize);
    if (chunk_buf as i64) == 0 {
        fclose(f);
        fclose(out);
        return false;
    }

    let mut ok: boolean = true;
    let mut guard: int = 0;
    let max_iters: int = 200000;
    loop {
        guard += 1;
        if guard > max_iters {
            ok = false;
            break;
        }
        let got: int = fread(chunk_buf, 1 as usize, chunk as usize, f) as int;
        if got > 0 {
            let written: int = fwrite(chunk_buf, 1 as usize, got as usize, out) as int;
            if written != got {
                ok = false;
                break;
            }
        }
        if got < chunk { break; }
    }

    if ferror(f) != 0 { ok = false; }
    if ferror(out) != 0 { ok = false; }
    free(chunk_buf);

    let close_src: int = fclose(f) as int;
    let close_dst: int = fclose(out) as int;
    if close_src != 0 { ok = false; }
    if close_dst != 0 { ok = false; }

    return ok;
}
