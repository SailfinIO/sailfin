// sfn/archive — POSIX.1-1988 ustar header decode (SFEP-0071 §3.8).
//
// Pure: operates on an in-memory `ByteCursor` over an already-decompressed
// archive buffer and declares no effect, matching the pure-codec-layer split
// in SFEP-0071 §4. Decodes exactly one 512-byte header block; the GNU
// `L`/`K` long-name extension and the PAX `x`/`g` extended-header records
// span *multiple* blocks (an extension header plus its data blocks, applied
// to the header that follows), so gluing them together is `tar_read.sfn`'s
// job — this module only ever looks at one block at a time.
import { char_code_at, substring } from "sfn/strings";

import {
    ByteBuf,
    ByteCursor,
    _buf_store,
    _byte_at,
    bytes_append_slice,
    bytes_free,
    bytes_new
} from "./bytes";
import {
    ArchiveError,
    ArchiveErrorKind,
    archive_error,
    archive_error_at,
    archive_error_member
} from "./error";

let _BLOCK_SIZE: int = 512;

// Field byte offsets within a 512-byte ustar header block (POSIX.1-1988 /
// GNU tar's "Basic Tar Format" chapter).
let _OFF_NAME: int = 0;
let _LEN_NAME: int = 100;
let _OFF_MODE: int = 100;
let _LEN_MODE: int = 8;
let _OFF_SIZE: int = 124;
let _LEN_SIZE: int = 12;
let _OFF_CHKSUM: int = 148;
let _LEN_CHKSUM: int = 8;
let _OFF_TYPEFLAG: int = 156;
let _OFF_LINKNAME: int = 157;
let _LEN_LINKNAME: int = 100;
let _OFF_MAGIC: int = 257;
let _LEN_MAGIC: int = 6;
let _OFF_VERSION: int = 263;
let _LEN_VERSION: int = 2;
let _OFF_PREFIX: int = 345;
let _LEN_PREFIX: int = 155;

// ustar typeflag byte values, named for readability at call sites in
// `tar_read.sfn`. A NUL typeflag (old v7 tar) means regular file too —
// `ustar_decode_header` normalizes it to `typeflags().regular`.
//
// A function returning a fresh struct, not module-level `let` scalar
// globals: an imported module-level scalar `let` read from a DIFFERENT
// module compared reliably `false` against every real value at runtime
// (typeflag `'L'` never matched `TYPEFLAG_GNU_LONGNAME`, so a GNU
// long-name header silently fell through to the regular-file path and
// extracted as a literal `@LongLink` file) despite `sfn check` reporting
// clean — the same check/build-agreement gap
// `check_build_agree_module_global_test.sfn` documents for the narrower
// empty-array case (#1386/#1389), reproduced here for a cross-module
// scalar constant while implementing this file. Confirmed against a real
// GNU-tar-produced long-name fixture; the workaround stays local rather
// than being filed as a compiler fix in this capsule's scope.
struct UstarTypeflags {
    regular: int;
    hardlink: int;
    symlink: int;
    chardev: int;
    blockdev: int;
    directory: int;
    fifo: int;
    contiguous: int;
    gnu_longlink: int;
    gnu_longname: int;
    pax_global: int;
    pax_extended: int;
}

fn ustar_typeflags() -> UstarTypeflags {
    return UstarTypeflags {
        regular: 48,  // '0'
        hardlink: 49,  // '1'
        symlink: 50,  // '2'
        chardev: 51,  // '3'
        blockdev: 52,  // '4'
        directory: 53,  // '5'
        fifo: 54,  // '6'
        contiguous: 55,  // '7'
        gnu_longlink: 75,  // 'K'
        gnu_longname: 76,  // 'L'
        pax_global: 103,  // 'g'
        pax_extended: 120  // 'x'
    };
}

struct UstarHeader {
    // Fully joined name: `prefix + "/" + name` for a POSIX ustar header
    // with a non-empty prefix, else the raw `name` field. GNU headers never
    // join `prefix` (SFEP-0071 §3.8) — `tar_read.sfn` applies any pending
    // GNU `L` / PAX `path` override on top of this.
    name: string;
    linkname: string;
    typeflag: int;
    size: int;
    mode: int;
    // True when all 512 bytes of the block are NUL — the ustar end-of-
    // archive marker. Every other field is meaningless when this is true.
    is_zero_block: boolean;
}

fn _ustar_u8(cursor: ByteCursor, base: int, off: int) -> int {
    return _byte_at(cursor.addr + ((base + off) as i64));
}

fn _ustar_is_zero_block(cursor: ByteCursor, base: int) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= _BLOCK_SIZE { break; }
        if _ustar_u8(cursor, base, i) != 0 { return false; }
        i += 1;
    }
    return true;
}

// Read a NUL-terminated (or field-length-bounded) field as a string.
fn _ustar_cstr_field(cursor: ByteCursor, base: int, off: int, len: int) -> string {
    let mut out: string = "";
    let mut i: int = 0;
    loop {
        if i >= len { break; }
        let b: int = _ustar_u8(cursor, base, off + i);
        if b == 0 { break; }
        // `char_from_code` is a prelude builtin, in scope with no import
        // (established at `capsules/sfn/crypto/src/mod.sfn:524`).
        out = out + char_from_code(b);
        i += 1;
    }
    return out;
}

// Parse an ustar octal numeric field: leading spaces skipped, then octal
// digits accumulated up to the first non-digit terminator (space or NUL).
// A high bit set in the first non-space byte is a GNU base-256 field,
// which SFEP-0071 §3.8 requires we detect and reject rather than
// misinterpret as octal garbage.
fn _ustar_parse_octal(cursor: ByteCursor, base: int, off: int, len: int, field_name: string) -> Result<int, ArchiveError> {
    let mut i: int = 0;
    loop {
        if i >= len { break; }
        if _ustar_u8(cursor, base, off + i) != 32 { break; }
        i += 1;
    }
    if i < len && _ustar_u8(cursor, base, off + i) >= 128 {
        return Result.Err {
            error: archive_error(ArchiveErrorKind.UnsupportedFeature, "ustar "
                + field_name
                + " field uses GNU base-256 encoding, which this reader does not support")
        };
    }
    let mut value: int = 0;
    loop {
        if i >= len { break; }
        let b: int = _ustar_u8(cursor, base, off + i);
        if b < 48 || b > 55 { break; }
        value = (value * 8) + (b - 48);
        i += 1;
    }
    return Result.Ok { value: value };
}

fn _ustar_bytes_equal(cursor: ByteCursor, base: int, off: int, expected: int[]) -> boolean {
    let mut i: int = 0;
    loop {
        if i >= expected.length { break; }
        if _ustar_u8(cursor, base, off + i) != expected[i] { return false; }
        i += 1;
    }
    return true;
}

// The two accepted checksum conventions (SFEP-0071 §3.8): the standard
// unsigned-byte sum, and the historical signed-byte sum some writers
// produce on a platform where `char` is signed. The checksum field itself
// is treated as eight ASCII spaces while summing, per the ustar spec.
fn _ustar_verify_checksum(cursor: ByteCursor, base: int, stored: int) -> boolean {
    let mut unsigned_sum: int = 0;
    let mut signed_sum: int = 0;
    let mut i: int = 0;
    loop {
        if i >= _BLOCK_SIZE { break; }
        let mut b: int = _ustar_u8(cursor, base, i);
        if i >= _OFF_CHKSUM && i < _OFF_CHKSUM + _LEN_CHKSUM { b = 32; }
        unsigned_sum += b;
        if b >= 128 { signed_sum += b - 256; } else { signed_sum += b; }
        i += 1;
    }
    return unsigned_sum == stored || signed_sum == stored;
}

// Decode the 512-byte ustar header at `cursor.pos`. Accepts POSIX ustar
// (`magic == "ustar\0"`, `version == "00"`, with `prefix` joining), GNU
// (`magic == "ustar  "`, no `prefix` joining), and v7 old-tar (all-NUL
// magic, `prefix` ignored) per SFEP-0071 §3.8.
fn ustar_decode_header(cursor: ByteCursor) -> Result<UstarHeader, ArchiveError> {
    let base: int = cursor.pos;
    if cursor.len - base < _BLOCK_SIZE {
        return Result.Err {
            error: archive_error_at(ArchiveErrorKind.Truncated, "archive ends mid-header (fewer than 512 bytes remain)", "", base)
        };
    }

    if _ustar_is_zero_block(cursor, base) {
        return Result.Ok {
            value: UstarHeader {
                name: "",
                linkname: "",
                typeflag: 0,
                size: 0,
                mode: 0,
                is_zero_block: true
            }
        };
    }

    let posix_magic: int[] = [117, 115, 116, 97, 114, 0];  // "ustar\0"
    let posix_version: int[] = [48, 48];  // "00"
    let gnu_magic: int[] = [117, 115, 116, 97, 114, 32, 32];  // "ustar  " (7 bytes: magic[6] + version[0])

    let is_posix: boolean = _ustar_bytes_equal(cursor, base, _OFF_MAGIC, posix_magic)
        && _ustar_bytes_equal(cursor, base, _OFF_VERSION, posix_version);
    let is_gnu: boolean = !is_posix && _ustar_bytes_equal(cursor, base, _OFF_MAGIC, gnu_magic);
    let all_zero_magic: int[] = [0, 0, 0, 0, 0, 0];
    let is_v7: boolean = !is_posix && !is_gnu && _ustar_bytes_equal(cursor, base, _OFF_MAGIC, all_zero_magic);

    if !is_posix && !is_gnu && !is_v7 {
        return Result.Err {
            error: archive_error_at(ArchiveErrorKind.BadMagic, "ustar header has an unrecognized magic value", "", base)
        };
    }

    let mode: int = _ustar_parse_octal(cursor, base, _OFF_MODE, _LEN_MODE, "mode")?;
    let size: int = _ustar_parse_octal(cursor, base, _OFF_SIZE, _LEN_SIZE, "size")?;
    let chksum: int = _ustar_parse_octal(cursor, base, _OFF_CHKSUM, _LEN_CHKSUM, "chksum")?;
    if !_ustar_verify_checksum(cursor, base, chksum) {
        return Result.Err {
            error: archive_error_at(ArchiveErrorKind.BadChecksum, "ustar header checksum does not match either the unsigned or signed sum", "", base)
        };
    }

    let mut typeflag: int = _ustar_u8(cursor, base, _OFF_TYPEFLAG);
    if typeflag == 0 {
        typeflag = 48;
    }  // '0' — see `ustar_typeflags()` above.

    let raw_name: string = _ustar_cstr_field(cursor, base, _OFF_NAME, _LEN_NAME);
    let linkname: string = _ustar_cstr_field(cursor, base, _OFF_LINKNAME, _LEN_LINKNAME);

    let mut name: string = raw_name;
    if is_posix {
        let prefix: string = _ustar_cstr_field(cursor, base, _OFF_PREFIX, _LEN_PREFIX);
        if prefix.length > 0 { name = prefix + "/" + raw_name; }
    }

    return Result.Ok {
        value: UstarHeader {
            name: name,
            linkname: linkname,
            typeflag: typeflag,
            size: size,
            mode: mode,
            is_zero_block: false
        }
    };
}

// ---------------------------------------------------------------------
// Writing (SFN-899, SFEP-0071 §3.7, §3.8). ustar magic/version only,
// typeflags `0`/`5`/`2` only, GNU `L`/`K` never emitted — a name too long
// to split into `prefix`/`name` is a hard error rather than a silent
// extension. `mode` is the caller's already-computed canonical value
// (SFEP-0071 §3.7); `uid`/`gid`/`mtime`/`uname`/`gname` are not fields on
// `UstarHeader` at all because they are always zero, so there is nothing
// for a caller to vary — that omission is what makes two encodes of the
// same `UstarHeader` byte-identical on every host.
let _OFF_UID: int = 108;
let _LEN_UID: int = 8;
let _OFF_GID: int = 116;
let _LEN_GID: int = 8;
let _OFF_MTIME: int = 136;
let _LEN_MTIME: int = 12;
let _OFF_UNAME: int = 265;
let _LEN_UNAME: int = 32;
let _OFF_GNAME: int = 297;
let _LEN_GNAME: int = 32;
let _OFF_DEVMAJOR: int = 329;
let _LEN_DEVMAJOR: int = 8;
let _OFF_DEVMINOR: int = 337;
let _LEN_DEVMINOR: int = 8;

// A function returning fresh mode constants, not module-level `let` scalar
// globals — the same check/build-agreement hazard `ustar_typeflags()`
// documents above applies equally to any cross-module scalar constant.
struct UstarCanonicalModes {
    directory: int;
    file_exec: int;
    file_plain: int;
    symlink: int;
}

fn ustar_canonical_modes() -> UstarCanonicalModes {
    return UstarCanonicalModes {
        directory: 493,  // 0755
        file_exec: 493,  // 0755
        file_plain: 420,  // 0644
        symlink: 511  // 0777, what GNU tar stores
    };
}

struct _UstarNameSplit {
    prefix: string;
    name: string;
}

// Split `full` into ustar `prefix`/`name` fields when it exceeds the
// 100-byte `name` field alone. Scans from the right for the rightmost `/`
// whose prefix half fits in 155 bytes and whose name half fits in 100 —
// any valid split reconstructs `prefix + "/" + name == full`, which is all
// `ustar_decode_header`'s POSIX join path requires. A name with no such
// split point (no `/`, or every candidate too long on one side) cannot be
// represented without a GNU `L` long-name extension, which SFEP-0071 §3.8
// says we never emit — that case is a hard error, not a silent truncation.
fn _ustar_split_name(full: string) -> Result<_UstarNameSplit, ArchiveError> {
    if full.length <= _LEN_NAME {
        return Result.Ok {
            value: _UstarNameSplit { prefix: "", name: full }
        };
    }
    let mut i: int = full.length - 1;
    loop {
        if i < 0 { break; }
        if char_code_at(full, i) == 47 {
            let prefix_len: int = i;
            let name_len: int = full.length - i - 1;
            if prefix_len <= _LEN_PREFIX && name_len > 0 && name_len <= _LEN_NAME {
                return Result.Ok {
                    value: _UstarNameSplit {
                        prefix: substring(full, 0, i),
                        name: substring(full, i + 1, full.length)
                    }
                };
            }
        }
        i -= 1;
    }
    return Result.Err {
        error: archive_error_member(ArchiveErrorKind.UnsupportedFeature, "member name is too long to split into ustar prefix/name fields (100/155 bytes) and GNU long-name extensions are never emitted", full)
    };
}

// Write ASCII bytes of `text` at `off`, up to `field_len`. Any remaining
// bytes in the field stay whatever the caller's block already holds —
// callers here always start from a freshly zero-filled block
// (`bytes_new`'s `_buf_alloc` zero-fills), so an unwritten tail is NUL, the
// empty-string convention every ustar reader expects.
fn _ustar_write_str(block_addr: i64, off: int, field_len: int, text: string) -> void {
    let mut i: int = 0;
    loop {
        if i >= text.length || i >= field_len { break; }
        _buf_store(block_addr, off + i, char_code_at(text, i));
        i += 1;
    }
}

// Zero-padded octal digits filling `field_len - 1` bytes, then a trailing
// NUL — matches `tests/ustar_test.sfn`'s `_set_octal` fixture shape exactly,
// so a header this function writes and one the test suite hand-builds are
// byte-for-byte the same shape. `field_name` only appears in the error
// message on overflow.
fn _ustar_write_octal(block_addr: i64, off: int, field_len: int, value: int, field_name: string) -> Result<int, ArchiveError> {
    let digits: int = field_len - 1;
    let mut max_value: int = 0;
    let mut i: int = 0;
    loop {
        if i >= digits { break; }
        max_value = (max_value * 8) + 7;
        i += 1;
    }
    if value < 0 || value > max_value {
        return Result.Err {
            error: archive_error(ArchiveErrorKind.UnsupportedFeature, "ustar "
                + field_name
                + " field exceeds this writer's octal ceiling (GNU base-256 is never emitted)")
        };
    }
    let mut v: int = value;
    let mut d: int = digits - 1;
    loop {
        if d < 0 { break; }
        _buf_store(block_addr, off + d, 48 + (v % 8));
        v = v / 8;
        d -= 1;
    }
    return Result.Ok { value: 0 };
}

// Zero-padded octal digits for a field that is always zero (`uid`, `gid`,
// `mtime`, `devmajor`, `devminor` — SFEP-0071 §3.7). Cannot fail, so it
// skips `_ustar_write_octal`'s `Result` ceremony entirely.
fn _ustar_write_octal_zero(block_addr: i64, off: int, field_len: int) -> void {
    let digits: int = field_len - 1;
    let mut d: int = 0;
    loop {
        if d >= digits { break; }
        _buf_store(block_addr, off + d, 48);  // '0'
        d += 1;
    }
}

// Unsigned-byte checksum sum (SFEP-0071 §3.8: we write only the unsigned
// convention), with the `chksum` field itself treated as eight ASCII
// spaces regardless of what bytes are actually stored there — mirrors
// `_ustar_verify_checksum`'s read-side treatment so a header this module
// writes verifies against its own reader.
fn _ustar_compute_checksum(block_addr: i64) -> int {
    let mut sum: int = 0;
    let mut i: int = 0;
    loop {
        if i >= _BLOCK_SIZE { break; }
        if i >= _OFF_CHKSUM && i < _OFF_CHKSUM + _LEN_CHKSUM { sum += 32; } else {
            sum += _byte_at(block_addr + (i as i64));
        }
        i += 1;
    }
    return sum;
}

// Build one 512-byte header block for `h`, freshly allocated and owned by
// the caller. Every byte this function does not explicitly write stays
// NUL from the zero-filled allocation — that covers `uname`/`gname`
// (SFEP-0071 §3.7's `uname = "", gname = ""`) with no code of their own.
fn _ustar_build_block(h: UstarHeader) -> Result<ByteBuf, ArchiveError> {
    let block: ByteBuf = bytes_new(_BLOCK_SIZE)?;
    let addr: i64 = block.addr;

    let split_result = _ustar_split_name(h.name);
    let mut split: _UstarNameSplit = _UstarNameSplit { prefix: "", name: "" };
    match split_result {
        Result.Ok { value }
        : {
            split = value;
        },
        Result.Err { error }
        : {
            bytes_free(block);
            return Result.Err { error: error };
        }
    }
    _ustar_write_str(addr, _OFF_NAME, _LEN_NAME, split.name);
    _ustar_write_str(addr, _OFF_PREFIX, _LEN_PREFIX, split.prefix);

    if h.linkname.length > _LEN_LINKNAME {
        bytes_free(block);
        return Result.Err {
            error: archive_error_member(ArchiveErrorKind.LinkRejected, "link target exceeds the ustar linkname field (100 bytes) and GNU long-link extensions are never emitted", h.name)
        };
    }
    _ustar_write_str(addr, _OFF_LINKNAME, _LEN_LINKNAME, h.linkname);

    let mode_result = _ustar_write_octal(addr, _OFF_MODE, _LEN_MODE, h.mode, "mode");
    match mode_result {
        Result.Ok { value }
        : { },
        Result.Err { error }
        : {
            bytes_free(block);
            return Result.Err { error: error };
        }
    }
    let size_result = _ustar_write_octal(addr, _OFF_SIZE, _LEN_SIZE, h.size, "size");
    match size_result {
        Result.Ok { value }
        : { },
        Result.Err { error }
        : {
            bytes_free(block);
            return Result.Err { error: error };
        }
    }
    _ustar_write_octal_zero(addr, _OFF_UID, _LEN_UID);
    _ustar_write_octal_zero(addr, _OFF_GID, _LEN_GID);
    _ustar_write_octal_zero(addr, _OFF_MTIME, _LEN_MTIME);
    _ustar_write_octal_zero(addr, _OFF_DEVMAJOR, _LEN_DEVMAJOR);
    _ustar_write_octal_zero(addr, _OFF_DEVMINOR, _LEN_DEVMINOR);

    _buf_store(addr, _OFF_TYPEFLAG, h.typeflag);

    let posix_magic: int[] = [117, 115, 116, 97, 114, 0];  // "ustar\0"
    let mut mi: int = 0;
    loop {
        if mi >= 6 { break; }
        _buf_store(addr, _OFF_MAGIC + mi, posix_magic[mi]);
        mi += 1;
    }
    _buf_store(addr, _OFF_VERSION, 48);  // '0'
    _buf_store(addr, _OFF_VERSION + 1, 48);  // '0'

    // uname/gname stay NUL (the zero-filled block default) per SFEP-0071
    // §3.7 — no write call needed; listed here only so a reader does not
    // wonder whether they were forgotten.
    let sum: int = _ustar_compute_checksum(addr);
    let chksum_result = _ustar_write_octal(addr, _OFF_CHKSUM, _LEN_CHKSUM, sum, "chksum");
    match chksum_result {
        Result.Ok { value }
        : { },
        Result.Err { error }
        : {
            bytes_free(block);
            return Result.Err { error: error };
        }
    }

    return Result.Ok {
        value: ByteBuf { addr: addr, len: _BLOCK_SIZE, cap: block.cap }
    };
}

// Encode `h` and append it to `out`. Owns `out` end to end: on any failure
// (an unsplittable name, an oversized link target, a `size`/`mode` past
// the octal ceiling, or an allocation failure) `out` is freed and the
// error propagated, matching `gzip_write_all`'s append-chain discipline
// (SFEP-0071 §3.3) so every call site here can thread `out` through a flat
// sequence of `let outN = ustar_encode_header(h, outN-1)?;` calls.
fn ustar_encode_header(h: UstarHeader, out: ByteBuf) -> Result<ByteBuf, ArchiveError> {
    let built = _ustar_build_block(h);
    let mut block: ByteBuf = ByteBuf { addr: 0, len: 0, cap: 0 };
    match built {
        Result.Ok { value }
        : {
            block = value;
        },
        Result.Err { error }
        : {
            bytes_free(out);
            return Result.Err { error: error };
        }
    }
    let appended = bytes_append_slice(out, block.addr, _BLOCK_SIZE);
    bytes_free(block);
    match appended {
        Result.Ok { value }
        : {
            return Result.Ok { value: value };
        },
        Result.Err { error }
        : {
            return Result.Err { error: error };
        }
    }
}

// Append one 512-byte all-zero block to `out` — the ustar end-of-archive
// marker, written twice per member call site (SFEP-0071 §3.8: "exactly two
// zero blocks"). `bytes_new`'s zero-fill makes the freshly allocated block
// already all-NUL; no field writes are needed.
fn ustar_encode_zero_block(out: ByteBuf) -> Result<ByteBuf, ArchiveError> {
    let allocated = bytes_new(_BLOCK_SIZE);
    let mut zb: ByteBuf = ByteBuf { addr: 0, len: 0, cap: 0 };
    match allocated {
        Result.Ok { value }
        : {
            zb = value;
        },
        Result.Err { error }
        : {
            bytes_free(out);
            return Result.Err { error: error };
        }
    }
    let appended = bytes_append_slice(out, zb.addr, _BLOCK_SIZE);
    bytes_free(zb);
    match appended {
        Result.Ok { value }
        : {
            return Result.Ok { value: value };
        },
        Result.Err { error }
        : {
            return Result.Err { error: error };
        }
    }
}
