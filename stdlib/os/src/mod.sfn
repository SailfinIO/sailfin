// sfn/os — Environment, process, and OS interaction for Sailfin.
//
// Provides access to environment variables, process execution, and
// platform information. All operations require the `io` effect.
// libc allocation primitives for `handle_read_bytes_stdout`'s owned
// buffer. Redeclared per-module (the #306 cross-module-extern limit),
// matching the `sfn/http` capsule's inlined declarations.
extern fn malloc(size: usize) -> *u8;

extern fn memcpy(dst: *u8, src: *u8, n: usize) -> *u8;

extern fn memset(dst: *u8, byte: i32, n: usize) -> *u8;

extern fn free(ptr: *u8) -> void;

fn env(name: string) -> string ![io] {
    // Read an environment variable. Returns an empty string if not set.
    return env.get(name);
}

fn home() -> string ![io] {
    // Returns the current user's home directory path.
    return env.home();
}

fn exec(args: string[]) -> int ![io] {
    // Execute a subprocess and wait for it to finish.
    // Returns the exit code (0 = success).
    return process.run(args);
}

fn exit(code: int) -> void ![io] {
    // Terminate the current process with the given exit code.
    process.exit(code);
}

// ── Typed environment (issue #365) ────────────────────────────
//
// `Env` is a typed map struct over `EnvEntry { name, value }` pairs.
// Construction goes through the `env_*` helpers — callers should not
// hand-roll `string[]` of `"KEY=VALUE"` pairs at the public surface.
// The capsule flattens entries internally before passing them to the
// runtime spawn primitives.
struct EnvEntry {
    name: string;
    value: string;
}

struct Env {
    entries: EnvEntry[];
    // Windows environment names compare case-insensitively; POSIX names do
    // not. Capture that host policy when the Env is constructed so the map
    // operations below stay pure and preserve their existing effect shape.
    case_insensitive_keys: boolean;
}

// Captured output from `run_capture`. `exit` is the child's exit code
// (or 128 + signal number on signal termination, matching the
// existing `process.run` shape). `stdout` and `stderr` are the full
// captured byte streams, drained concurrently so neither side blocks
// on a full pipe buffer.
struct ProcessOutput {
    stdout: string;
    stderr: string;
    exit: int;
}

// Opaque handle to a child spawned by `spawn_with_env`. `handle_id`
// is a malloc'd C-side pointer carried as an int. Callers must reap
// the child by calling `handle_wait` exactly once; the wait reaps
// any open stdin/stdout/stderr fds and frees the handle.
struct ProcessHandle {
    handle_id: int;
}

// `OwnedBuf` — the runtime owned-buffer aggregate, inlined
// byte-identically (four `i64` fields, 32 bytes, `arena_addr == 0` =
// libc-backed). Layout MUST match `runtime/sfn/memory/ownedbuf.sfn`
// (and the sibling inlined copies in `sfn/http`). Returned by
// `handle_read_bytes_stdout` as a fresh buffer the caller owns.
struct OwnedBuf {
    ptr_addr: i64;
    len: i64;
    cap: i64;
    arena_addr: i64;
}

// Resolve the environment-key policy from already-observed host evidence.
// POSIX filesystem evidence wins over stray Windows-shaped variables: setting
// `ComSpec` in a Linux process must not change that process's key semantics.
fn _env_case_policy(is_linux: boolean, is_darwin: boolean, has_windows_env: boolean, has_nul: boolean) -> boolean {
    if is_linux || is_darwin { return false; }
    return has_windows_env || has_nul;
}

// The host environment-key policy. The variable rungs cover ordinary Windows
// processes (where getenv itself is case-insensitive); `NUL` is the backstop
// for a process launched under an explicitly empty environment.
fn _env_keys_are_case_insensitive() -> boolean ![io] {
    let has_windows_env = env.get("SystemRoot").length > 0 || env.get("windir").length > 0
        || env.get("ComSpec").length > 0;
    return _env_case_policy(fs.exists("/proc/self/status"), fs.exists("/System/Library/CoreServices"), has_windows_env, fs.exists("NUL"));
}

// Compare environment names under the policy captured by `Env`. Windows'
// ANSI environment surface is byte-oriented here, so ASCII folding matches
// the key family this capsule and the compiler manage without touching value
// bytes or changing POSIX semantics.
fn _env_key_equal(left: string, right: string, case_insensitive: boolean) -> boolean {
    if !case_insensitive { return strings_equal(left, right); }
    if left.length != right.length { return false; }
    let mut i: int = 0;
    loop {
        if i >= left.length { break; }
        let mut lc: int = char_code(left[i]);
        let mut rc: int = char_code(right[i]);
        if lc >= 65 && lc <= 90 { lc += 32; }
        if rc >= 65 && rc <= 90 { rc += 32; }
        if lc != rc { return false; }
        i += 1;
    }
    return true;
}

// Return an empty `Env`. The resulting environment passed to the runtime is
// literally empty — the child sees no inherited environment variables. The
// host read records how later `env_set`/`env_get` operations compare keys.
// Use `env_from_current` to seed entries from the parent.
fn env_empty() -> Env ![io] {
    return Env {
        entries: [],
        case_insensitive_keys: _env_keys_are_case_insensitive()
    };
}

// Return `e` with `name` set to `value`. If `name` already exists,
// the new entry replaces the old one (last write wins). The input
// `Env` is not mutated; a new value is returned.
fn env_set(e: Env, name: string, value: string) -> Env {
    let mut out: EnvEntry[] = [];
    let mut found = false;
    let mut i = 0;
    loop {
        if i >= e.entries.length { break; }
        let entry = e.entries[i];
        if _env_key_equal(entry.name, name, e.case_insensitive_keys) {
            out.push(EnvEntry { name: name, value: value });
            found = true;
        } else { out.push(entry); }
        i += 1;
    }
    if !found {
        out.push(EnvEntry { name: name, value: value });
    }
    return Env {
        entries: out,
        case_insensitive_keys: e.case_insensitive_keys
    };
}

// Look up `name`'s value. Returns the empty string if not set; use
// `env_has` to distinguish "unset" from "set to empty".
fn env_get(e: Env, name: string) -> string {
    let mut i = 0;
    loop {
        if i >= e.entries.length { break; }
        let entry = e.entries[i];
        if _env_key_equal(entry.name, name, e.case_insensitive_keys) {
            return entry.value;
        }
        i += 1;
    }
    return "";
}

// True iff `name` has an entry (regardless of value).
fn env_has(e: Env, name: string) -> boolean {
    let mut i = 0;
    loop {
        if i >= e.entries.length { break; }
        if _env_key_equal(e.entries[i].name, name, e.case_insensitive_keys) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Flatten an `Env` into a `string[]` of `"KEY=VALUE"` entries, in
// insertion order. This is the format the runtime spawn primitives
// expect.
fn env_to_flat(e: Env) -> string[] {
    let mut out: string[] = [];
    let mut i = 0;
    loop {
        if i >= e.entries.length { break; }
        let entry = e.entries[i];
        out.push(entry.name + "=" + entry.value);
        i += 1;
    }
    return out;
}

// Index of the first '=' in `text`, or -1 when absent. Drives the
// `KEY=VALUE` split in `env_from_current`: only the FIRST '='
// separates name from value, so `FOO=a=b=c` keeps "a=b=c" intact as
// the value (mirrors `sfn/cli`'s `--key=value` split).
fn _env_index_of_eq(text: string) -> int {
    let mut i: int = 0;
    loop {
        if i >= text.length { break; }
        if strings_equal(grapheme_at(text, i), "=") { return i; }
        i += 1;
    }
    return -1;
}

// Snapshot the parent process environment as a typed `Env`. Backed
// by the runtime environ-iteration primitive (`process.environ`,
// #1242), which returns the calling process's environment as a flat
// `string[]` of `"KEY=VALUE"` entries. Each entry is split on its
// FIRST '=' (values may themselves contain '='); malformed entries
// with no '=' or an empty name (e.g. Windows' hidden `=C:=...`
// drive-tracking variables) are skipped. Callers can layer overrides
// on top via `env_set`. The runtime spawn helpers accept an empty
// `Env` as "empty environment" rather than "inherit", so
// `env_from_current()` is the way to build an inheriting child env.
//
// Windows preserves the spelling returned by `GetEnvironmentStringsA`, while
// the `Env` policy makes lookups and overlays case-insensitive. POSIX keeps
// exact key comparison.
//
// `![io]` — reading the process environment is an environment read,
// the same gate as `env.get`.
fn env_from_current() -> Env ![io] {
    let flat = process.environ();
    let case_insensitive = _env_keys_are_case_insensitive();
    let mut entries: EnvEntry[] = [];
    let mut i = 0;
    loop {
        if i >= flat.length { break; }
        let entry = flat[i];
        let eq = _env_index_of_eq(entry);
        if eq > 0 {
            entries.push(EnvEntry {
                name: substring(entry, 0, eq), value: substring(entry, eq + 1, entry.length)
            });
        }
        i += 1;
    }
    return Env { entries: entries, case_insensitive_keys: case_insensitive };
}

// ── Capturing / streaming process APIs ────────────────────────────
//
// `run_capture` runs `args` to completion with the given `env`,
// piping both stdout and stderr. The two streams are drained
// concurrently by the runtime so the child never blocks on a full
// pipe buffer. Returns the captured byte streams alongside the
// exit code. `ProcessOutput.exit` is `-1` when the runtime itself
// couldn't complete the call (invalid argv, OOM, spawn failure),
// distinct from a legitimate child exit code of 127.
//
// `cwd` (#1167) is the child's working directory: `""` inherits the
// parent's cwd (the prior behaviour), a non-empty path runs the child
// in that directory via `posix_spawn_file_actions_addchdir_np` — no
// process-global `chdir`, so it is safe under the concurrent runner.
// Posix-only; ignored on Windows.
fn run_capture(args: string[], env: Env, cwd: string) -> ProcessOutput ![io] {
    let env_flat = env_to_flat(env);
    let exit_code = process.run_capture_cwd(args, env_flat, cwd);
    let captured_stdout = process.capture_take_stdout();
    let captured_stderr = process.capture_take_stderr();
    return ProcessOutput {
        stdout: captured_stdout,
        stderr: captured_stderr,
        exit: exit_code
    };
}

// `spawn_with_env` forks `args` with the given `env` and returns a
// handle the caller drives. The child inherits no fds beyond the
// three standard streams (the runtime closes the parent ends inside
// `posix_spawn_file_actions`). Callers must reap the child via
// `handle_wait`. Returns a handle whose `handle_id` is 0 on spawn
// failure — call sites can branch on that to surface a typed error.
//
// `cwd` (#1167): `""` inherits the parent's working directory; a
// non-empty path runs the child there (posix-only, no global `chdir`).
fn spawn_with_env(args: string[], env: Env, cwd: string) -> ProcessHandle ![io] {
    let env_flat = env_to_flat(env);
    let id = process.spawn_with_env_cwd(args, env_flat, cwd);
    return ProcessHandle { handle_id: id };
}

// Write `data` to the child's stdin. Returns bytes written, or -1
// on error (closed handle, child already exited).
fn handle_write(h: ProcessHandle, data: string) -> int ![io] {
    return process.handle_write(h.handle_id, data);
}

// Close the child's stdin. Children that read until EOF (e.g. `cat`)
// will then finish their work and exit.
fn handle_close_stdin(h: ProcessHandle) -> void ![io] {
    process.handle_close_stdin(h.handle_id);
}

// Read all remaining bytes from the child's stdout. Blocks until the
// child closes its stdout (typically on exit). The fd is closed when
// this returns, so the call is idempotent — a second call gives "".
fn handle_read_stdout(h: ProcessHandle) -> string ![io] {
    return process.handle_read_stdout(h.handle_id);
}

// Read all remaining bytes from the child's stderr. Same blocking /
// idempotency contract as `handle_read_stdout`.
fn handle_read_stderr(h: ProcessHandle) -> string ![io] {
    return process.handle_read_stderr(h.handle_id);
}

// Copy `s`'s bytes into a fresh libc-backed `OwnedBuf` the caller owns
// (reclaim it with `owned_buf_free`). NUL-terminated; the copy is
// independent of the string's own backing, so the free never disturbs
// capsule storage. An empty `s` (e.g. an EOF read) needs no allocation
// and returns the canonical empty `{0,0,0,0}` buffer, matching
// `runtime/sfn/memory/ownedbuf.sfn`; OOM returns the same. Mirrors
// `sfn/http`'s `_http_owned_from_str`.
fn _owned_from_str(s: string) -> OwnedBuf {
    let n: i64 = s.length;
    if n == 0 {
        return OwnedBuf {
            ptr_addr: 0,
            len: 0,
            cap: 0,
            arena_addr: 0
        };
    }
    let src: *u8 = s as *u8;
    let copy: *u8 = malloc((n + 1) as usize);
    if copy as i64 == 0 {
        return OwnedBuf {
            ptr_addr: 0,
            len: 0,
            cap: 0,
            arena_addr: 0
        };
    }
    memcpy(copy, src, n as usize);
    memset(((copy as i64) + n) as *u8, 0, 1 as usize);
    return OwnedBuf {
        ptr_addr: copy as i64,
        len: n,
        cap: n + 1,
        arena_addr: 0
    };
}

// Read one `\n`-delimited line from the child's stdout (newline
// stripped), stashing any bytes past the newline for the next call.
// Returns `null` once stdout is at end-of-stream — distinct from a
// genuine blank line, which returns `""`. Reads a live child without
// requiring its pipe to close, so a proxy can frame one line-delimited
// JSON-RPC message at a time. The final unterminated line (no trailing
// newline) is returned before EOF.
fn handle_read_line_stdout(h: ProcessHandle) -> string? ![io] {
    let line = process.handle_read_line_stdout(h.handle_id);
    if line.length > 0 { return line; }
    // Empty result: a real blank line ("") or end-of-stream (null). The
    // raw builtin cannot tell them apart, so consult the fd/stash state.
    if process.handle_stdout_at_eof(h.handle_id) { return null; }
    return line;
}

// Read at most `n` bytes from the child's stdout into a fresh
// caller-owned `OwnedBuf`, preserving any unconsumed remainder for the
// next call. A short read returns fewer than `n`. Bounded incremental
// read for a live child that never closes its pipe.
//
// A zero-length buffer means "no bytes available right now", NOT
// necessarily EOF — `handle_stdout_at_eof` is the sole EOF oracle. On
// POSIX an empty return still only occurs at EOF (or `n <= 0`); on
// Windows it also occurs for a live-but-silent child, because the read
// is bounded so a caller's wall-clock deadline stays observable
// (SFN-1092, `runtime/sfn/platform/process_windows.sfn`). A loop that
// treats empty as EOF terminates early against a slow child on Windows.
//
// The underlying builtin already returns a string, so this `OwnedBuf`
// form provides no additional byte-fidelity over
// `handle_read_chunk_stdout` — it exists for callers who want a
// libc-backed buffer to hand to C.
fn handle_read_bytes_stdout(h: ProcessHandle, n: int) -> OwnedBuf ![io] {
    let chunk = process.handle_read_bytes_stdout(h.handle_id, n);
    return _owned_from_str(chunk);
}

// Release the libc allocation backing an `OwnedBuf` returned by
// `handle_read_bytes_stdout`. Callers must free each buffer exactly once
// after use — a long-lived proxy loop that skips this leaks a buffer per
// read. A canonical empty buffer (`ptr_addr == 0`, e.g. an EOF read) owns
// no allocation, so freeing it is a no-op and is always safe.
fn owned_buf_free(buf: OwnedBuf) -> void {
    if buf.ptr_addr != 0 { free(buf.ptr_addr as *u8); }
}

// Wait for the child to exit. Closes any still-open fds, reaps the
// child, frees the handle, and returns the exit code (or 128 + signal
// on signal termination, or -1 if the handle was already invalid).
// Must be called exactly once per `spawn_with_env`.
fn handle_wait(h: ProcessHandle) -> int ![io] {
    return process.handle_wait(h.handle_id);
}

// Send SIGKILL(9) to the child. Returns 0 on success, -1 on a
// zero/dead handle or a `kill(2)` failure — including `ESRCH` when the
// child already exited, which callers must NOT treat as fatal (the
// child is gone either way). Killing does not reap: the caller MUST
// still call `handle_wait` afterward — it is the sole reaper/free
// path, and skipping it leaks the handle plus both stash buffers and
// leaves a zombie. `handle_wait` after a kill returns `128 + 9 = 137`,
// indistinguishable from an OOM kill, so `137` must never be used as a
// timeout discriminator — track a killed-on-deadline flag instead
// (`drain_to_exit` below does exactly this via `timed_out`).
fn handle_kill(h: ProcessHandle) -> int ![io] {
    return process.handle_kill(h.handle_id);
}

// True once the child's stdout fd was closed on a prior EOF/error read
// AND no read-ahead bytes remain in the stash. Reads only handle
// state — no syscall, never blocks. A zero/invalid handle reports
// true.
fn handle_stdout_at_eof(h: ProcessHandle) -> boolean ![io] {
    return process.handle_stdout_at_eof(h.handle_id);
}

// The stderr twin of `handle_stdout_at_eof`.
fn handle_stderr_at_eof(h: ProcessHandle) -> boolean ![io] {
    return process.handle_stderr_at_eof(h.handle_id);
}

// The child's raw stdout fd, for use with `io.poll_any`. `-1` once
// closed/at-EOF, and `-1` ALWAYS on Windows by design (the accessors
// are stubs there, #1540) — callers must handle an empty fd set rather
// than assume poll is available.
fn handle_stdout_fd(h: ProcessHandle) -> int ![io] {
    return process.handle_stdout_fd(h.handle_id);
}

// The stderr twin of `handle_stdout_fd`.
fn handle_stderr_fd(h: ProcessHandle) -> int ![io] {
    return process.handle_stderr_fd(h.handle_id);
}

// Read at most `n` bytes from the child's stdout, returned directly as
// a string (no `OwnedBuf`) — preserving any unconsumed remainder for
// the next call. A short read returns fewer than `n`.
//
// An empty string means "no bytes available right now", NOT necessarily
// EOF — `handle_stdout_at_eof` is the sole EOF oracle. See
// `handle_read_bytes_stdout` above for the platform detail; the same
// contract applies here.
//
// This is the recommended chunked read; `handle_read_bytes_stdout` is
// the owned-buffer form for callers that need a libc-backed allocation
// to hand to C.
fn handle_read_chunk_stdout(h: ProcessHandle, n: int) -> string ![io] {
    return process.handle_read_bytes_stdout(h.handle_id, n);
}

// The stderr twin of `handle_read_chunk_stdout` — the chunked stderr
// read the capsule previously lacked. Same contract.
fn handle_read_chunk_stderr(h: ProcessHandle, n: int) -> string ![io] {
    return process.handle_read_bytes_stderr(h.handle_id, n);
}

// Result of draining a child to completion, streams demultiplexed by
// `drain_to_exit`. `exit` is the RAW `handle_wait` result (128 +
// signal on signal termination; -1 on an invalid handle) — it is
// deliberately NOT remapped on a deadline kill. `timed_out` is the
// sole timeout discriminator: a SIGKILL wait yields 137, which is
// indistinguishable from an OOM kill, so the raw exit code alone can
// never tell the two apart. The one `exit` value that is NOT a
// `handle_wait` result is `run_bounded`'s synthetic `127`, returned
// when the spawn itself failed and there was never a child to reap.
//
// On a deadline kill the streams are PARTIAL: the loop breaks straight
// to the reap without a final drain, so `stdout`/`stderr` hold only
// what had been read when the deadline fired. `timed_out` is the flag
// that says so.
struct ProcessDrain {
    stdout: string;
    stderr: string;
    exit: int;
    timed_out: boolean;
}

// Drive a spawned child to completion, demultiplexing stdout/stderr
// via `io.poll_any` over the raw fds (mirrors `_run_test_binary` in
// `compiler/src/cli/commands/test/exec.sfn`) and enforcing an optional
// wall-clock deadline. `deadline_ms <= 0` means no deadline: the poll
// timeout is `-1` and the deadline branch never fires.
//
// CONSUMES `h`. This calls `handle_wait` exactly once on the way out,
// which reaps the child AND frees the handle. The caller must NOT call
// `handle_wait`, `handle_kill`, or any accessor on `h` afterward — the
// handle is dangling, and a second `handle_wait` is a use-after-free.
// `drain_to_exit` therefore replaces the whole spawn/pump/reap dance,
// not just the pump: pair it with `spawn_with_env` and nothing else
// (or use `run_bounded`, which pairs them for you).
//
// Closes the child's stdin first. `spawn_with_env` hands the child a
// stdin PIPE and keeps the write end open in the parent, so a filter
// (`cat`, `sort`, `wc`) would never see EOF, never exit, and never
// close its output pipes — hanging this loop forever when no deadline
// is set. `run_capture` has no such hazard: it pipes only stdout and
// stderr and lets the child inherit the parent's stdin. Closing here
// is what makes the two agree, and it is safe precisely because this
// function consumes `h`: no caller can write afterward, anything
// written before is already in the pipe, and the underlying builtin is
// idempotent on an already-closed stdin.
fn drain_to_exit(h: ProcessHandle, deadline_ms: int) -> ProcessDrain ![clock, io] {
    process.handle_close_stdin(h.handle_id);
    let mut out_buf: string = "";
    let mut err_buf: string = "";
    let mut timed_out: boolean = false;
    // Bounds a `ready < 0` spin. With a deadline that path is already
    // bounded (it re-checks the clock and the deadline eventually
    // fires), but with `deadline_ms <= 0` the poll blocks indefinitely
    // and only returns negative on a genuine error — a persistent one
    // (EBADF, or the runtime's poll-buffer allocation failing) would
    // otherwise `continue` in a hot loop with nothing to stop it. Guard
    // counter per `.claude/rules/code-style.md`; breaking out still
    // reaps, so a wedged poll surfaces as a normal exit rather than a
    // hang.
    let mut poll_errs: int = 0;
    let start_ms = monotonic_millis();
    loop {
        if process.handle_stdout_at_eof(h.handle_id) && process.handle_stderr_at_eof(h.handle_id) {
            break;
        }
        let mut poll_to: int = -1;
        if deadline_ms > 0 {
            let remaining: int = deadline_ms - ((monotonic_millis() - start_ms) as int);
            if remaining <= 0 {
                process.handle_kill(h.handle_id);
                timed_out = true;
                break;
            }
            poll_to = remaining;
        }
        let out_fd = process.handle_stdout_fd(h.handle_id);
        let err_fd = process.handle_stderr_fd(h.handle_id);
        let mut fds: int[] = [];
        if out_fd >= 0 { fds.push(out_fd); }
        if err_fd >= 0 { fds.push(err_fd); }
        let mut read_out: boolean = false;
        let mut read_err: boolean = false;
        if fds.length == 0 {
            // No fd to select on. That is Windows: the accessors are `-1`
            // by design there and `io.poll_any` is a `-1` stub (#1540).
            // POSIX cannot reach this branch — a read only clears an fd to
            // `-1` when it drained nothing, so both fds are `-1` only once
            // both stashes are empty, which the check above already broke
            // on. Drive the framed reads directly: each pumps both pipes,
            // so neither stream can wedge the other. Termination stays the
            // both-at-EOF check above.
            //
            // The deadline IS observable here (SFN-1092): each read is
            // bounded by `PW_FRAMED_POLL_BUDGET_MS`, so a live-but-silent
            // child returns empty rather than parking and this loop
            // reaches the deadline check above, making `timed_out` real on
            // Windows. That is also why an empty read must not be read as
            // EOF — `*_at_eof` is the oracle, as the chunk-read contract
            // above states.
            read_out = !process.handle_stdout_at_eof(h.handle_id);
            read_err = !process.handle_stderr_at_eof(h.handle_id);
        } else {
            // `io.poll_any` returns `-1` for a timeout AND for an error,
            // so a negative result is not by itself fatal — re-check the
            // clock and go round again.
            let ready = io.poll_any(fds, poll_to);
            if ready < 0 {
                if deadline_ms > 0 && ((monotonic_millis() - start_ms) as int) >= deadline_ms {
                    process.handle_kill(h.handle_id);
                    timed_out = true;
                    break;
                }
                poll_errs += 1;
                if poll_errs > 1024 { break; }
                continue;
            }
            poll_errs = 0;
            read_out = ready == out_fd;
            read_err = ready == err_fd;
        }
        // Concatenation, not a runtime `GrowBuf` — a capsule has no
        // access to one, so accumulation is quadratic in the number of
        // 64 KiB chunks. Fine for the command output this is aimed at;
        // `run_capture` is the better tool for a child emitting many
        // megabytes, since the runtime accumulates that side natively.
        if read_out {
            let chunk = process.handle_read_bytes_stdout(h.handle_id, 65536);
            if chunk.length > 0 { out_buf = out_buf + chunk; }
        }
        if read_err {
            let chunk = process.handle_read_bytes_stderr(h.handle_id, 65536);
            if chunk.length > 0 { err_buf = err_buf + chunk; }
        }
    }
    let rc = process.handle_wait(h.handle_id);
    return ProcessDrain {
        stdout: out_buf,
        stderr: err_buf,
        exit: rc,
        timed_out: timed_out
    };
}

// Spawn `args` and drive it to completion with a wall-clock deadline.
// `run_capture` is the unbounded form; `run_bounded` adds the deadline
// and a hard `handle_kill` when it expires. On spawn failure
// (`handle_id == 0`) returns immediately with `exit: 127` (mirroring
// `process.run`'s missing-command code) without calling `drain_to_exit`.
fn run_bounded(args: string[], env: Env, cwd: string, deadline_ms: int) -> ProcessDrain ![clock, io] {
    let h = spawn_with_env(args, env, cwd);
    if h.handle_id == 0 {
        return ProcessDrain {
            stdout: "",
            stderr: "",
            exit: 127,
            timed_out: false
        };
    }
    return drain_to_exit(h, deadline_ms);
}
