// Tests for sfn/os's process-control widening (drain_to_exit, run_bounded,
// handle_kill, the EOF/fd accessors, and the stderr chunk-read twin).
// `drain_to_exit` demultiplexes a child's stdout/stderr with an optional
// wall-clock deadline; `run_bounded` layers `spawn_with_env` on top.
// POSIX `sh`/`cat` assumed, matching the sibling `handle_framed_stdio_test`.
import { find } from "sfn/strings";
import { sfn_bin_abs_path, skip } from "sfn/test";

import {
    ProcessDrain,
    ProcessHandle,
    drain_to_exit,
    env_empty,
    handle_kill,
    handle_read_chunk_stderr,
    handle_read_chunk_stdout,
    handle_stderr_at_eof,
    handle_stdout_at_eof,
    handle_wait,
    run_bounded,
    spawn_with_env
} from "../src/mod";

// True when the test runner is a Windows binary. Mirrors the detection
// idiom in `capsules/sfn/fs/tests/fs_test.sfn:34`: the `OS` / `SYSTEMROOT` /
// `windir` environment variables Windows always sets.
fn _is_windows() -> bool ![io] {
    let os = env.get("OS");
    if find(os, "Windows", 0) >= 0 { return true; }
    if env.get("SYSTEMROOT").length > 0 { return true; }
    if env.get("windir").length > 0 { return true; }
    return false;
}

test "drain_to_exit: collects stdout from a child that exits on its own" ![clock, io] {
    let h = spawn_with_env(["sh", "-c", "printf 'hello'"], env_empty(), "");
    assert h.handle_id != 0;
    let d = drain_to_exit(h, 0);
    assert strings_equal(d.stdout, "hello");
    assert d.timed_out == false;
    assert d.exit == 0;
}

test "drain_to_exit: keeps stdout and stderr separate" ![clock, io] {
    let h = spawn_with_env(["sh", "-c", "printf 'out-side' >&1; printf 'err-side' >&2"], env_empty(), "");
    assert h.handle_id != 0;
    let d = drain_to_exit(h, 0);
    assert strings_equal(d.stdout, "out-side");
    assert strings_equal(d.stderr, "err-side");
    assert d.timed_out == false;
    assert d.exit == 0;
}

test "drain_to_exit: deadline_ms <= 0 waits indefinitely for a fast child" ![clock, io] {
    let h = spawn_with_env(["sh", "-c", "printf 'done'"], env_empty(), "");
    assert h.handle_id != 0;
    let d = drain_to_exit(h, -1);
    assert strings_equal(d.stdout, "done");
    assert d.timed_out == false;
    assert d.exit == 0;
}

test "drain_to_exit: fires the deadline on a long-sleeping child" ![clock, io] {
    let h = spawn_with_env(["sh", "-c", "sleep 30"], env_empty(), "");
    assert h.handle_id != 0;
    let start = monotonic_millis();
    let d = drain_to_exit(h, 500);
    let elapsed = monotonic_millis() - start;
    assert d.timed_out == true;
    // Killed well before the child's own 30s sleep would finish.
    assert elapsed < 10000;
    // ...but it DID wait for the deadline. Without this floor the test
    // would still pass if the deadline arithmetic regressed to firing at
    // t=0, which is the exact property it exists to protect.
    assert elapsed >= 400;
    // SIGKILL reap: 128 + 9. Pins that `handle_wait` runs on the
    // deadline exit path too, not just the normal one.
    assert d.exit == 137;
}

test "run_bounded: a stdin filter sees EOF and exits rather than hanging" ![clock, io] {
    // `spawn_with_env` gives the child a stdin PIPE whose write end the
    // parent holds; `run_capture` instead lets the child inherit the
    // parent's stdin. A filter would therefore never see EOF and this
    // would hang forever with no deadline set, unless `drain_to_exit`
    // closes stdin first. No deadline here on purpose: a deadline would
    // mask the hang as a timeout instead of failing.
    let d = run_bounded(["cat"], env_empty(), "", 0);
    assert strings_equal(d.stdout, "");
    assert d.timed_out == false;
    assert d.exit == 0;
}

test "run_bounded: normal child returns output and exit 0" ![clock, io] {
    let d = run_bounded(["sh", "-c", "printf 'ran'"], env_empty(), "", 0);
    assert strings_equal(d.stdout, "ran");
    assert d.exit == 0;
    assert d.timed_out == false;
}

test "run_bounded: nonexistent binary returns exit 127" ![clock, io] {
    let d = run_bounded(["sfn-os-test-does-not-exist-binary"], env_empty(), "", 0);
    assert d.exit == 127;
    assert d.timed_out == false;
}

test "handle_kill: kills a live child then handle_wait reaps it" ![io] {
    let h = spawn_with_env(["cat"], env_empty(), "");
    assert h.handle_id != 0;
    let rc = handle_kill(h);
    assert rc == 0;
    let exit = handle_wait(h);
    assert exit == 137;
}

test "handle_read_chunk_stdout: a live silent child yields empty rather than parking (Windows)" ![clock, io] {
    // POSIX `handle_read_bytes_stdout` still parks until byte-or-EOF —
    // unchanged by SFN-1092 design (see the contract note on
    // `handle_read_chunk_stdout` above). Only the Windows leg gained a
    // bounded pump (`_pw_h_pump_bounded`,
    // runtime/sfn/platform/process_windows.sfn), so asserting "returns
    // empty promptly" anywhere else would hang the suite forever, since
    // the child below never exits on its own.
    if !_is_windows() {
        skip("Windows-only: exercises the bounded chunk-read pump added for SFN-1092");
    }

    // `sfn login` with no `--token` prints its prompt, then blocks in
    // `io.read_line(0)` forever. Unlike `run_bounded`/`drain_to_exit`
    // (which close the child's stdin as their first act, see the note
    // above `drain_to_exit`), bare `spawn_with_env` never touches stdin,
    // so the block actually holds — this is the live, silent,
    // never-exiting child the bounded pump exists to serve.
    let h = spawn_with_env([sfn_bin_abs_path(), "login"], env_empty(), "");
    assert h.handle_id != 0;

    // Read until the prompt arrives, proving ordinary reads still work
    // end-to-end through the new pump — a regression that broke reads
    // outright would fail here rather than at the assertions below.
    // Guard counter per .claude/rules/code-style.md: each call returns
    // within the ~25ms budget even before the prompt lands, so 400
    // attempts is generous (~10s) without being unbounded.
    let mut acc: string = "";
    let mut attempts: int = 0;
    loop {
        if find(acc, "enter your registry token:", 0) >= 0 { break; }
        if attempts >= 400 { break; }
        attempts += 1;
        acc = acc + handle_read_chunk_stdout(h, 65536);
    }
    assert find(acc, "enter your registry token:", 0) >= 0;

    // The core assertion: the child is alive and now blocked on stdin, so
    // it will never write again. Before SFN-1092 this single call parked
    // forever on Windows; the bounded pump now returns promptly with an
    // empty chunk instead.
    let start = monotonic_millis();
    let chunk = handle_read_chunk_stdout(h, 65536);
    let elapsed = monotonic_millis() - start;
    assert strings_equal(chunk, "");
    // Budget is 25ms; 2000ms is a generous ceiling that still catches a
    // regression back to an unbounded park.
    assert elapsed < 2000;

    // Contract assertion: empty did NOT mean EOF. `*_at_eof` remains the
    // sole EOF oracle — a broken implementation that closed the pipe on
    // timeout would pass the two assertions above and fail only here.
    assert handle_stdout_at_eof(h) == false;

    // The child never exits on its own; reap it explicitly rather than
    // leak it. No `drain_to_exit` in play here, so no prior `handle_wait`
    // to conflict with — kill then wait exactly once each.
    handle_kill(h);
    handle_wait(h);
}

test "handle_read_chunk_stdout: bounded incremental read, empty string at EOF" ![io] {
    let h = spawn_with_env(["sh", "-c", "printf 'abcdefgh'"], env_empty(), "");
    assert h.handle_id != 0;
    let p1 = handle_read_chunk_stdout(h, 3);
    assert strings_equal(p1, "abc");
    let p2 = handle_read_chunk_stdout(h, 10);
    assert strings_equal(p2, "defgh");
    let p3 = handle_read_chunk_stdout(h, 4);
    assert strings_equal(p3, "");
    let exit = handle_wait(h);
    assert exit == 0;
}

test "handle_read_chunk_stderr: reads the stderr twin" ![io] {
    let h = spawn_with_env(["sh", "-c", "printf 'oops' >&2"], env_empty(), "");
    assert h.handle_id != 0;
    let p1 = handle_read_chunk_stderr(h, 4);
    assert strings_equal(p1, "oops");
    let p2 = handle_read_chunk_stderr(h, 4);
    assert strings_equal(p2, "");
    let exit = handle_wait(h);
    assert exit == 0;
}

test "handle_stdout_at_eof / handle_stderr_at_eof: false mid-stream, true after drain" ![io] {
    let h = spawn_with_env(["sh", "-c", "printf 'x' >&1; printf 'y' >&2"], env_empty(), "");
    assert h.handle_id != 0;
    // Mid-stream: neither pipe has been drained to EOF yet.
    assert handle_stdout_at_eof(h) == false;
    assert handle_stderr_at_eof(h) == false;
    // Drain both to EOF before reaping — `handle_wait` frees the handle.
    // A read with content does not itself flip the EOF flag; the
    // following empty read is what observes the closed fd.
    handle_read_chunk_stdout(h, 65536);
    handle_read_chunk_stdout(h, 65536);
    handle_read_chunk_stderr(h, 65536);
    handle_read_chunk_stderr(h, 65536);
    assert handle_stdout_at_eof(h) == true;
    assert handle_stderr_at_eof(h) == true;
    let exit = handle_wait(h);
    assert exit == 0;
}
