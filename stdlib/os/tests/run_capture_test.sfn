// Tests for sfn/os process.run_capture — typed stdout/stderr capture
// over the runtime fork+pipe+poll scaffolding (issue #365).
import { process_fixture_bin } from "sfn/test";

import {
    Env,
    EnvEntry,
    ProcessOutput,
    env_empty,
    env_set,
    run_capture
} from "../src/mod";

test "run_capture: captures stdout from a simple command" ![io] {
    let result = run_capture([process_fixture_bin(), "emit", "hello", "", "0"], env_empty(), "");
    assert result.exit == 0;
    assert strings_equal(result.stdout, "hello");
    assert strings_equal(result.stderr, "");
}

test "run_capture: captures stderr separately from stdout" ![io] {
    let result = run_capture([process_fixture_bin(), "emit", "", "err", "0"], env_empty(), "");
    assert result.exit == 0;
    assert strings_equal(result.stdout, "");
    assert strings_equal(result.stderr, "err");
}

test "run_capture: captures both stdout and stderr from one child" ![io] {
    // Interleaved writes — concurrent drain must keep both streams
    // intact regardless of timing.
    let result = run_capture([process_fixture_bin(), "emit", "out", "err", "0"], env_empty(), "");
    assert result.exit == 0;
    assert strings_equal(result.stdout, "out");
    assert strings_equal(result.stderr, "err");
}

test "run_capture: non-zero exit code surfaces in ProcessOutput.exit" ![io] {
    let result = run_capture([process_fixture_bin(), "emit", "", "", "7"], env_empty(), "");
    assert result.exit == 7;
}

test "run_capture: env overrides propagate to the child" ![io] {
    // `env` contains a single KEY=VALUE entry; the fixture prints its value.
    let env = env_set(env_empty(), "FOO", "bar");
    let result = run_capture([process_fixture_bin(), "env", "FOO"], env, "");
    assert result.exit == 0;
    assert strings_equal(result.stdout, "bar");
}

test "run_capture: env_set replaces existing entries (last write wins)" ![io] {
    let env = env_set(env_set(env_empty(), "FOO", "first"), "FOO", "second");
    let result = run_capture([process_fixture_bin(), "env", "FOO"], env, "");
    assert result.exit == 0;
    assert strings_equal(result.stdout, "second");
}

test "run_capture: drains output larger than the pipe buffer" ![io] {
    // POSIX pipe buffer is typically 64 KiB. Generating >128 KiB on
    // stdout forces the runtime's poll-driven drain to actually
    // round-trip rather than slurp in one read. If concurrent draining
    // is broken (e.g. blocked on stderr while stdout fills), this
    // test deadlocks.
    //
    let result = run_capture([process_fixture_bin(), "fill", "x", "200000", "E", "0"], env_empty(), "");
    assert result.exit == 0;
    assert result.stdout.length == 200000;
    assert strings_equal(result.stderr, "");
}

test "run_capture: spawn failure surfaces as exit == -1" ![io] {
    // Distinguishable from a legitimate child exit code of 127
    // ("command not found" in the shell convention) — a non-existent
    // binary makes posix_spawnp fail before the child is ever born.
    let result = run_capture(["sfn-no-such-binary-12345"], env_empty(), "");
    assert result.exit == -1;
}

test "run_capture: cwd runs the child in the given directory (#1167)" ![io] {
    // This marker exists only in the requested directory.
    let dir = "build/sailfin/run-capture-cwd-probe";
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/cwd-probe", "present\n");
    let child_env = env_set(env_empty(), "PWD", "/stale-parent-cwd");
    let result = run_capture([process_fixture_bin(), "exists", "cwd-probe"], child_env, dir);
    assert result.exit == 0;
    assert strings_equal(result.stdout, "");
    assert strings_equal(result.stderr, "");
}

test "run_capture: empty cwd inherits parent cwd and leaves it unchanged (#1167)" ![io] {
    let dir = "build/sailfin/run-capture-cwd-isolation";
    fs.createDirectory(dir, true);
    fs.writeFile(dir + "/cwd-probe", "present\n");
    let child_env = env_set(env_empty(), "PWD", "/stale-parent-cwd");

    // The inherited parent cwd is the repository root, where the compiler
    // manifest exists. A stale `PWD` must not affect that real cwd.
    let before = run_capture([process_fixture_bin(), "exists", "compiler/capsule.toml"], child_env, "");
    assert before.exit == 0;

    // The marker is visible only after the per-child cwd is applied.
    let moved = run_capture([process_fixture_bin(), "exists", "cwd-probe"], child_env, dir);
    assert moved.exit == 0;

    // A subsequent inherit-cwd child still sees the repository root, proving
    // the parent process was never moved.
    let after = run_capture([process_fixture_bin(), "exists", "compiler/capsule.toml"], child_env, "");
    assert after.exit == 0;
}
