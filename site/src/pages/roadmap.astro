---
import BaseLayout from "../layouts/BaseLayout.astro";
import roadmapSnapshot from "../data/roadmap.json";

type Horizon = "1.0" | "later" | "exploration";
type ProjectStatus = "completed" | "in-progress" | "planned" | "paused";

interface PublicRoadmapProject {
  name: string;
  summary: string;
  initiative: string;
  horizon: Horizon;
  status: ProjectStatus;
}

interface HorizonConfig {
  title: string;
  description: string;
}

interface InitiativeGroup {
  name: string;
  projects: PublicRoadmapProject[];
}

const horizonConfig: Record<Horizon, HorizonConfig> = {
  "1.0": {
    title: "Toward 1.0",
    description:
      "Work that currently defines Sailfin's stable 1.0 maturity boundary. This is direction, not a launch deadline or an immutable checklist.",
  },
  later: {
    title: "Later",
    description:
      "Important approved directions that are not currently inside the 1.0 boundary. Later does not mean rejected, and work may move as the language evolves.",
  },
  exploration: {
    title: "Exploration",
    description:
      "Concepts worth preserving while their design, sequencing, or fit remains open. These are not delivery promises.",
  },
};

function isHorizon(value: unknown): value is Horizon {
  return (
    value === "1.0" || value === "later" || value === "exploration"
  );
}

function isProjectStatus(value: unknown): value is ProjectStatus {
  return (
    value === "completed" ||
    value === "in-progress" ||
    value === "planned" ||
    value === "paused"
  );
}

function isPublicProject(value: unknown): value is PublicRoadmapProject {
  if (!value || typeof value !== "object") return false;
  const project = value as Record<string, unknown>;
  return (
    typeof project.name === "string" &&
    project.name.trim().length > 0 &&
    typeof project.summary === "string" &&
    project.summary.trim().length > 0 &&
    typeof project.initiative === "string" &&
    project.initiative.trim().length > 0 &&
    isHorizon(project.horizon) &&
    isProjectStatus(project.status)
  );
}

if (roadmapSnapshot.schemaVersion !== 1) {
  throw new Error(
    `[roadmap] unsupported snapshot schema ${roadmapSnapshot.schemaVersion}`,
  );
}

if (!roadmapSnapshot.projects.every(isPublicProject)) {
  throw new Error("[roadmap] snapshot contains an invalid public project");
}

const projects = roadmapSnapshot.projects as PublicRoadmapProject[];

function groupByInitiative(
  horizonProjects: PublicRoadmapProject[],
): InitiativeGroup[] {
  const groups = new Map<string, PublicRoadmapProject[]>();

  for (const project of horizonProjects) {
    const group = groups.get(project.initiative) ?? [];
    group.push(project);
    groups.set(project.initiative, group);
  }

  return [...groups.entries()]
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([name, groupedProjects]) => ({
      name,
      projects: groupedProjects.sort((a, b) => a.name.localeCompare(b.name)),
    }));
}

const sections = [
  {
    key: "delivered",
    title: "Delivered Foundations",
    description:
      "Completed projects that the rest of the roadmap builds on. Shipped behavior remains documented in the language reference and status matrix.",
    projects: projects.filter((project) => project.status === "completed"),
  },
  ...(["1.0", "later", "exploration"] as const).map((horizon) => ({
    key: horizon,
    ...horizonConfig[horizon],
    projects: projects.filter(
      (project) =>
        project.horizon === horizon && project.status !== "completed",
    ),
  })),
]
  .map(({ projects: sectionProjects, ...section }) => ({
    ...section,
    groups: groupByInitiative(sectionProjects),
  }))
  .filter((section) => section.groups.length > 0);

const statusLabel: Record<ProjectStatus, string> = {
  completed: "Completed",
  "in-progress": "In progress",
  planned: "Planned",
  paused: "Paused",
};

const reviewedAt = roadmapSnapshot.syncedAt
  ? new Date(roadmapSnapshot.syncedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BaseLayout
  title="Roadmap"
  description="Sailfin's reviewed public roadmap and current maturity horizons."
>
  <div class="page">
    <div class="container roadmap-container">
      <header class="roadmap-header">
        <p class="eyebrow">Public roadmap</p>
        <h1>Where Sailfin is heading</h1>
        <p class="lead">
          Sailfin is young, moving quickly, and not being driven toward an
          arbitrary launch date. This is a reviewed view of the work and ideas
          that matter—not a promise that every item will land in a fixed order.
        </p>
        {
          reviewedAt && (
            <p class="meta">Public roadmap last synchronized {reviewedAt}.</p>
          )
        }
      </header>

      {
        projects.length === 0 ? (
          <section class="review-state" aria-labelledby="scope-review-heading">
            <div class="review-marker" aria-hidden="true">01</div>
            <div>
              <p class="section-kicker">Scope review</p>
              <h2 id="scope-review-heading">
                The public roadmap is being reviewed
              </h2>
              <p>
                We are reviewing the boundary between work toward 1.0, later
                directions, and open-ended exploration. Until that review is
                signed off, we would rather publish no list than invent
                priorities from internal planning data.
              </p>
              <p>
                Shipped behavior remains documented in the language reference,
                while accepted and draft designs remain visible in the SFEP
                registry.
              </p>
              <div class="review-actions">
                <a class="btn btn-primary" href="/docs/reference/">
                  Language reference
                </a>
                <a class="btn btn-secondary" href="/sfep/">
                  Browse SFEPs
                </a>
              </div>
            </div>
          </section>
        ) : (
          <>
            <div class="legend" aria-label="Project status legend">
              {(["completed", "in-progress", "planned", "paused"] as const).map(
                (status) => (
                  <span class="legend-item">
                    <span
                      class:list={["status-dot", status]}
                      aria-hidden="true"
                    />
                    {statusLabel[status]}
                  </span>
                ),
              )}
            </div>

            {sections.map((section, index) => (
              <section
                class:list={["roadmap-section", `horizon-${section.key}`]}
                aria-labelledby={`horizon-${section.key}`}
              >
                <div class="section-heading">
                  <span class="section-number" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h2 id={`horizon-${section.key}`}>{section.title}</h2>
                    <p>{section.description}</p>
                  </div>
                </div>

                <div class="initiative-grid">
                  {section.groups.map((group) => (
                    <article class="initiative-card">
                      <header>
                        <p class="section-kicker">Initiative</p>
                        <h3>{group.name}</h3>
                      </header>
                      <ul class="project-list">
                        {group.projects.map((project) => (
                          <li class="project">
                            <span
                              class:list={["status-dot", project.status]}
                              aria-label={statusLabel[project.status]}
                            />
                            <div>
                              <h4>{project.name}</h4>
                              <p>{project.summary}</p>
                            </div>
                          </li>
                        ))}
                      </ul>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </>
        )
      }

      <section class="publication-note" aria-labelledby="publication-heading">
        <p class="section-kicker">How this page works</p>
        <h2 id="publication-heading">Linear plans the work; this page explains the direction</h2>
        <p>
          Maintainers plan Initiatives and Projects in Linear. A Project appears
          here only after it has been deliberately marked for public publication
          and assigned a reviewed horizon. Horizons can change as designs mature,
          dependencies move, or development accelerates. Linear links and private
          planning context are never exposed on this page.
        </p>
      </section>

      <section class="contribute" aria-labelledby="contribute-heading">
        <div>
          <p class="section-kicker">Contributing</p>
          <h2 id="contribute-heading">Help improve Sailfin</h2>
          <p>
            Public GitHub issues are the right place for bug reports and concrete
            proposals. Significant language, runtime, ABI, or toolchain changes
            should be grounded in an SFEP before implementation.
          </p>
        </div>
        <a
          href="https://github.com/SailfinIO/sailfin/issues"
          class="btn btn-primary">Open an issue</a
        >
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding: 4rem 0 5rem;
  }

  .roadmap-container {
    max-width: 72rem;
  }

  .roadmap-header {
    max-width: 51rem;
    margin-bottom: 3rem;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 0.6rem;
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .roadmap-header h1 {
    max-width: 46rem;
    margin: 0 0 1rem;
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .lead {
    max-width: 45rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.65;
  }

  .meta {
    margin-top: 1rem;
    color: var(--color-text-tertiary);
    font-size: 0.85rem;
  }

  .review-state {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-primary) 8%, transparent),
        transparent 48%
      ),
      var(--color-bg-alt);
  }

  .review-marker,
  .section-number {
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .review-state h2,
  .publication-note h2,
  .contribute h2,
  .section-heading h2 {
    margin: 0;
    letter-spacing: -0.025em;
  }

  .review-state h2 {
    max-width: 40rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  .review-state p:not(.section-kicker) {
    max-width: 43rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .review-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0 0 3rem;
    padding: 1rem 0;
    border-block: 1px solid var(--color-border);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .roadmap-section {
    padding: 3.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    max-width: 50rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .section-heading p {
    margin: 0.5rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .initiative-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .initiative-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg-alt);
  }

  .initiative-card > header {
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .initiative-card h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    padding: 1.3rem 1.5rem;
  }

  .project + .project {
    border-top: 1px solid var(--color-border);
  }

  .project h4 {
    margin: 0 0 0.35rem;
    font-size: 0.98rem;
  }

  .project p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .status-dot {
    display: inline-block;
    flex: 0 0 auto;
    width: 0.58rem;
    height: 0.58rem;
    margin-top: 0.34rem;
    border: 1.5px solid var(--color-text-tertiary);
    border-radius: 50%;
  }

  .status-dot.completed {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }

  .status-dot.in-progress {
    border-color: var(--color-primary);
    box-shadow: inset 0.22rem 0 0 var(--color-primary);
  }

  .status-dot.paused {
    border-color: var(--color-text-tertiary);
    background: color-mix(in srgb, var(--color-text-tertiary) 28%, transparent);
  }

  .publication-note,
  .contribute {
    margin-top: 3rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .publication-note p:not(.section-kicker),
  .contribute p:not(.section-kicker) {
    max-width: 48rem;
    margin-bottom: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .contribute {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .contribute .btn {
    flex: 0 0 auto;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .btn-primary {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    color: var(--color-bg);
  }

  .btn-secondary {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  @media (max-width: 700px) {
    .page {
      padding-top: 2.5rem;
    }

    .review-state {
      grid-template-columns: 1fr;
    }

    .initiative-grid {
      grid-template-columns: 1fr;
    }

    .contribute {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
