// Credential-injection seam. No test in this file reads the environment or
// holds a real token — that is the property, not a limitation: it is what
// makes "tests run without real network access or credentials" structural.
import {
    REDACTED,
    credential_present,
    credential_value,
    credentials_empty,
    credentials_missing,
    credentials_with,
    redact
} from "../src/credentials";

test "repo-tooling credentials: an injected value reads back" {
    let creds = credentials_with(credentials_empty(), "GITHUB_TOKEN", "ghp_example");
    assert credential_present(creds, "GITHUB_TOKEN");
    assert credential_value(creds, "GITHUB_TOKEN") == "ghp_example";
}

test "repo-tooling credentials: an absent name is empty and not present" {
    let creds = credentials_empty();
    assert ! credential_present(creds, "LINEAR_API_KEY");
    assert credential_value(creds, "LINEAR_API_KEY") == "";
}

test "repo-tooling credentials: an empty value counts as unset" {
    // An env var exported as "" must not produce an empty Authorization
    // header downstream, so it never becomes an entry.
    let creds = credentials_with(credentials_empty(), "GITHUB_TOKEN", "");
    assert ! credential_present(creds, "GITHUB_TOKEN");
    assert credentials_missing(creds, ["GITHUB_TOKEN"]).length == 1;
}

test "repo-tooling credentials: a re-injected name replaces rather than shadows" {
    let mut creds = credentials_with(credentials_empty(), "TOKEN", "old");
    creds = credentials_with(creds, "TOKEN", "new");
    assert creds.entries.length == 1;
    assert credential_value(creds, "TOKEN") == "new";
}

test "repo-tooling credentials: clearing a name removes the entry" {
    let mut creds = credentials_with(credentials_empty(), "TOKEN", "value");
    creds = credentials_with(creds, "TOKEN", "");
    assert creds.entries.length == 0;
    assert ! credential_present(creds, "TOKEN");
}

test "repo-tooling credentials: missing names come back in request order" {
    let creds = credentials_with(credentials_empty(), "PRESENT", "yes");
    let missing = credentials_missing(creds, ["B_MISSING", "PRESENT", "A_MISSING"]);
    assert missing.length == 2;
    assert missing[0] == "B_MISSING";
    assert missing[1] == "A_MISSING";
}

test "repo-tooling credentials: redaction removes a secret with no word boundary" {
    let creds = credentials_with(credentials_empty(), "TOKEN", "s3cr3t");
    let url = "https://x:s3cr3t@api.github.com/repos";
    let cleaned = redact(url, creds);
    assert cleaned == "https://x:" + REDACTED + "@api.github.com/repos";
}

test "repo-tooling credentials: redaction removes every occurrence" {
    let creds = credentials_with(credentials_empty(), "TOKEN", "abc");
    assert redact("abc and abc", creds) == REDACTED + " and " + REDACTED;
}

test "repo-tooling credentials: redaction covers every injected secret" {
    let mut creds = credentials_with(credentials_empty(), "A", "aaa");
    creds = credentials_with(creds, "B", "bbb");
    assert redact("aaa/bbb", creds) == REDACTED + "/" + REDACTED;
}

test "repo-tooling credentials: the placeholder does not leak secret length" {
    let short = credentials_with(credentials_empty(), "T", "ab");
    let long = credentials_with(credentials_empty(), "T", "abcdefghijklmnop");
    assert redact("ab", short) == redact("abcdefghijklmnop", long);
}

test "repo-tooling credentials: redaction leaves unrelated text alone" {
    let creds = credentials_with(credentials_empty(), "TOKEN", "s3cr3t");
    assert redact("nothing to hide", creds) == "nothing to hide";
}
