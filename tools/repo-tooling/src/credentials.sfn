// tools/repo-tooling/src/credentials.sfn
//
// Credential-injection seam (SFEP-0074 §3 Tier 2, §4). The reason repo
// tooling is not a compiler concern at all is that it handles GitHub and
// Linear tokens; shipping that in the compiler binary would put credential
// discovery in every end user's toolchain. Having moved it here, the same
// hazard has to be contained inside this capsule, which is what this module
// is for.
//
// The rule is one-way: `credentials_from_env` is the ONLY `![io]` function in
// this file, and it is the only place a secret enters the program. Everything
// downstream — the leaves that reconcile labels (SFN-1185) or sign manifests
// (SFN-1186) — takes a `Credentials` value as a parameter and stays pure. A
// test constructs one with `credentials_with` and never touches the
// environment, which is how the acceptance bar "tests run without real
// network access or credentials" is met structurally rather than by
// convention.
import { replace } from "sfn/strings";

// The placeholder a redacted secret collapses to. Fixed rather than
// length-preserving on purpose: a run of asterisks matching the token length
// leaks the length, and length is a meaningful hint for a token format.
let REDACTED: string = "***";

struct Credential {
    name: string;
    value: string;
}

struct Credentials {
    entries: Credential[];
}

fn credentials_empty() -> Credentials {
    return Credentials { entries: [] };
}

// A duplicate name replaces the existing entry, so `credential_value` cannot
// depend on scan direction.
//
// An empty value is stored as absent: an env var exported as "" is
// indistinguishable from unset for a token. That protects a caller that
// checks `credential_present` / `credentials_missing` first — it does not
// protect one that calls `credential_value` unconditionally, which still gets
// "" and can still build `Authorization: Bearer `. Check presence.
fn credentials_with(current: Credentials, name: string, value: string) -> Credentials {
    let mut out = credentials_empty();
    let mut i: int = 0;
    loop {
        if i >= current.entries.length { break; }
        let entry = current.entries[i];
        i += 1;
        if entry.name != name { out.entries.push(entry); }
    }
    if value.length > 0 {
        out.entries.push(Credential { name: name, value: value });
    }
    return out;
}

fn credential_value(current: Credentials, name: string) -> string {
    let mut i: int = 0;
    loop {
        if i >= current.entries.length { break; }
        let entry = current.entries[i];
        i += 1;
        if entry.name == name { return entry.value; }
    }
    return "";
}

fn credential_present(current: Credentials, name: string) -> boolean {
    return credential_value(current, name).length > 0;
}

// Which names are missing, in the order the caller asked for them. The caller
// decides whether that is fatal; this module does not exit.
fn credentials_missing(current: Credentials, names: string[]) -> string[] {
    let mut out: string[] = [];
    let mut i: int = 0;
    loop {
        if i >= names.length { break; }
        let name = names[i];
        i += 1;
        if !credential_present(current, name) { out.push(name); }
    }
    return out;
}

// The one boundary crossing. `env.get` returns "" for an unset variable, and
// `credentials_with` drops empty values, so an unset name simply never
// becomes an entry.
fn credentials_from_env(names: string[]) -> Credentials ![io] {
    let mut out = credentials_empty();
    let mut i: int = 0;
    loop {
        if i >= names.length { break; }
        let name = names[i];
        i += 1;
        out = credentials_with(out, name, env.get(name));
    }
    return out;
}

// Redaction makes the deterministic-output seam safer to point at an API
// response or a subprocess transcript. It is pure, so a test can prove a
// given secret does not survive a given rendering without ever holding a real
// one.
//
// Substring replacement, not token-boundary replacement: a secret embedded in
// a URL (`https://x:TOKEN@host`) or a JSON body has no word boundary around
// it, and those are exactly the strings a leaf will want to log.
//
// The guarantee is exactly "every verbatim occurrence of an injected value is
// replaced", and a leaf must not read more into it. Two shapes it does not
// cover, both of which a Tier 2 leaf will meet: a secret re-encoded before
// rendering (`Authorization: Basic <base64(user:token)>`, or percent-encoded
// in a query string) is not a verbatim occurrence, and a secret split across
// two records is never seen by one call. Redact at the boundary, on the whole
// string, before any encoding — not after.
fn redact(text: string, current: Credentials) -> string {
    let mut out = text;
    let mut i: int = 0;
    loop {
        if i >= current.entries.length { break; }
        let entry = current.entries[i];
        i += 1;
        if entry.value.length > 0 {
            out = replace(out, entry.value, REDACTED);
        }
    }
    return out;
}

export {
    Credential,
    Credentials,
    REDACTED,
    credential_present,
    credential_value,
    credentials_empty,
    credentials_from_env,
    credentials_missing,
    credentials_with,
    redact
};
